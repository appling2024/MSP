
ldt <- read.csv(file.choose(), sep="\t")
pym_l <- read.csv(file.choose(), sep="\t")
pym_h <- read.csv(file.choose(), sep="\t")

print(ldt)
print(pym_l)
print(pym_h)

hist(ldt$Freq, main="Гистограмма по Freq", xlab="Freq", ylab="Частота")

hist(log1p(ldt$Freq), main="Логарифмированная гистограмма по Freq", xlab="log(1+Freq)", ylab="Частота")

shapiro.test(log1p(ldt$Freq))

plot(ldt$Freq, main="График Freq", xlab="Наблюдения", ylab="Частота")
plot(density(ldt$Freq), main="Плотность Freq", xlab="Freq", ylab="Плотность")

plot(sort(ldt$Freq), type="l", main="График сортированного Freq (по возрастанию)", xlab="Наблюдения", ylab="Частота")
plot(sort(ldt$Freq, decreasing=TRUE), type="l", main="График сортированного Freq (по убыванию)", xlab="Наблюдения", ylab="Частота")

summary(pym_h)
summary(pym_l)

summary(pym_h$syl.)
summary(pym_h$imag.)
summary(pym_h$let.)
summary(pym_h$conc.)
summary(pym_h$assoc.)


