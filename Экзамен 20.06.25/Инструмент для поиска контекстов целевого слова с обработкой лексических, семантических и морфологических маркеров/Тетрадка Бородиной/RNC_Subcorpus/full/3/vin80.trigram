<p class="h3"><se>§ <w><ana lex="6" gr="NUM,ciph"/>6</w>.</se></p>

<p><se><w><ana lex="чтобы" gr="CONJ,norm" sem="" sem2=""/>Чтобы</w> <w>лучше</w> <w><ana lex="осветить" gr="V,act,inf,norm,pf" sem="der:v ca:caus d:pref t:light" sem2="der:v d:pref"/>осветить</w> <w><ana lex="поставить" gr="V,acc,f,norm,partcp,pass,pf,plen,praet,sg" sem="der:v d:pref" sem2=""/>поставленную</w> <w><ana lex="проблема" gr="S,acc,f,inan,norm,sg" sem="t:ment r:abstr" sem2="ev r:abstr"/>проблему</w>, <w><ana lex="позволить" gr="V,1p,act,fut,indic,norm,pf,sg" sem="d:pref" sem2="d:pref"/>позволю</w> <w><ana lex="себе" gr="SPRO,dat,norm" sem="" sem2=""/>себе</w> <w><ana lex="привести" gr="V,act,inf,norm,pf" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref ca:bgr aux:caus"/>привести</w> <w><ana lex="несколько" gr="NUM,acc,inan,norm" sem="" sem2=""/>несколько</w> <w><ana lex="пример" gr="S,gen,inan,m,norm,pl" sem="t:ment r:abstr" sem2="ev:posit r:concr r:abstr der:shift t:text"/>примеров</w>.</se><se> <w><ana lex="художественный" gr="A,f,nom,norm,plen,sg" sem="r:rel der:s" sem2="ev:posit r:rel"/>Художественная</w> <w><ana lex="проза" gr="S,f,inan,nom,norm,sg" sem="pt:aggr r:concr r:abstr sc:text" sem2="r:abstr ev:neg"/>проза</w>, <w><ana lex="являть" gr="V,act,ger,ipf,norm,praes,tran" sem="der:v d:root" sem2=""/>являя</w> <w><ana lex="монологический" gr="A,acc,f,norm,plen,sg" sem="dt:text r:rel der:s" sem2=""/>монологическую</w> <w><ana lex="речь" gr="S,acc,f,inan,norm,sg" sem="t:speech r:abstr" sem2="t:speech r:concr r:abstr"/>речь</w>, <w><ana lex="перерезать" gr="V,acc,f,norm,partcp,pass,pf,plen,praet,sg,tran" sem="t:impact ca:caus d:pref" sem2="t:impact ca:caus t:be:disapp d:pref"/>перерезанную</w> <w><ana lex="диалог" gr="S,inan,ins,m,norm,pl" sem="t:speech r:abstr" sem2="t:speech r:abstr"/>диалогами</w>, <w><ana lex="представлять" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="der:v d:pref" sem2="der:v d:pref"/>представляет</w> <w><ana lex="сложный" gr="A,n,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>сложное</w> <w><ana lex="типологический