	</p>
<p><se><w><ana lex="такой" gr="APRO,ins,m,norm,sg" sem="r:dem" sem2="r:indet r:spec t:degr:max"/>Таким</w> <w><ana lex="образ" gr="S,inan,ins,m,norm,sg" sem="t:ment r:concr r:abstr t:workart" sem2="t:asp r:abstr"/>образом</w>, <w><ana lex="проблема" gr="S,f,inan,nom,norm,pl" sem="t:ment r:abstr" sem2="ev r:abstr"/>проблемы</w> <w><ana lex="морфология" gr="S,f,gen,inan,norm,sg" sem="r:abstr" sem2="r:abstr"/>морфологии</w> <w><ana lex="символ" gr="S,gen,inan,m,norm,pl" sem="t:sign r:concr" sem2="t:sign r:concr r:abstr"/>символов</w> -- <w><ana lex="это" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>это</w> <w><ana lex="прежде" gr="PR,norm" sem="" sem2=""/>прежде</w> <w><ana lex="все" gr="SPRO,gen,inan,n,norm,sg" sem="" sem2=""/>всего</w> <w><ana lex="проблема" gr="S,f,inan,nom,norm,pl" sem="t:ment r:abstr" sem2="ev r:abstr"/>проблемы</w> <w><ana lex="их" gr="APRO,norm" sem="r:poss" sem2=""/>их</w> <w><ana lex="функциональный" gr="A,gen,norm,pl,plen" sem="r:rel der:s" sem2="der:v r:rel"/>функциональных</w> <w><ana lex="соотношение" gr="S,gen,inan,n,norm,pl" sem="r:abstr" sem2=""/>соотношений</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="состав" gr="S,inan,loc,m,norm,sg" sem="sc:hum pt:aggr r:concr" sem2="der:v t:tool:transp t:stuff r:concr sc:tool:transp"/>составе</w> <w>данного</w> <w><ana lex="художественный" gr="A,gen,n,norm,plen,sg" sem="r:rel der:s" sem2="ev:posit r:rel"/>художественного</w> <w><ana lex="единство" gr="S,gen,inan,n,norm,sg" sem="r:abstr" sem2="r:abstr"/>единства</w>.</se></p>
