ь" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>есть</w> <w><ana lex="данность" gr="S,acc,f,inan,norm,sg" sem="r:abstr der:a" sem2=""/>данность</w>; <w><ana lex="они" gr="SPRO,acc,anim,norm,pl" sem="r:pers" sem2=""/>их</w> <w>необходимо</w> <w><ana lex="отыскивать" gr="V,act,inf,ipf,norm,tran" sem="der:v d:pref d:impf" sem2=""/>отыскивать</w> <w><ana lex="путем" gr="PR,norm" sem="" sem2=""/>путем</w> <w><ana lex="анализ" gr="S,gen,inan,m,norm,sg" sem="r:abstr" sem2="t:ment r:abstr"/>анализа</w> <w><ana lex="художественный" gr="A,gen,n,norm,plen,sg" sem="r:rel der:s" sem2="ev:posit r:rel"/>художественного</w> <w><ana lex="произведение" gr="S,gen,inan,n,norm,sg" sem="t:text t:workdram t:workmus t:workart der:v t:workcin r:concr" sem2="r:abstr"/>произведения</w>.</se><se> <w><ana lex="они" gr="SPRO,3p,acc,norm,pl" sem="r:pers" sem2=""/>Их</w> <w>нельзя</w> <w><ana lex="вырезать" gr="V,act,inf,norm,pf" sem="t:impact ca:caus der:v d:pref" sem2="der:v d:pref"/>вырезать</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="художественный" gr="A,gen,n,norm,plen,sg" sem="r:rel der:s" sem2="ev:posit r:rel"/>художественного</w> <w><ana lex="произведение" gr="S,gen,inan,n,norm,sg" sem="t:text t:workdram t:workmus t:workart der:v t:workcin r:concr" sem2="r:abstr"/>произведения</w> <w><ana lex="механически" gr="ADV,norm" sem="ev der:a" sem2=""/>механически</w>, <w><ana lex="аналогично" gr="ADV,norm" sem="" sem2=""/>аналогично</w> <w><ana lex="слово" gr="S,dat,inan,n,norm,pl" sem="t:word r:concr r:abstr" sem2="pt:aggr:aggrpl t:text sc:word r:abstr t:speech r:concr"/>словам</w> <w><ana lex="язык" gr="S,anim,gen,m,norm,sg" sem="" sem2="t:hum r:concr"/><ana lex="язык" gr="S,gen,inan,m,norm,sg" sem="pt:partb pc:animal r:concr r:abstr pc:hum" sem2="t:food sc:hum t:form sc:word r:abstr der:shift pt:set pt:aggr pc:tool:mus pt:part top:rod r:concr pc:tool"/>языка</w>: <w><ana lex="это" gr="SPRO,inan,n,nom,norm,sg" 