<p class="h3"><se>§ <w><ana lex="9" gr="NUM,ciph"/>9</w>.</se></p>

<p><se><w><ana lex="теория" gr="S,f,inan,nom,norm,sg" sem="r:abstr" sem2="t:ment pt:aggr r:abstr"/>Теория</w> <w><ana lex="литературный" gr="A,gen,norm,pl,plen" sem="r:rel der:s" sem2="r:rel der:s"/>литературных</w> <w><ana lex="стиль" gr="S,gen,inan,m,norm,pl" sem="pt:aggr r:abstr" sem2="pt:aggr r:abstr"/>стилей</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="качество" gr="S,inan,loc,n,norm,sg" sem="r:abstr" sem2="r:abstr"/>качестве</w> <w><ana lex="предельный" gr="A,f,gen,norm,plen,sg" sem="dt:space r:rel der:s" sem2="t:degr:max:magn dt:space der:s r:qual"/>предельной</w> <w><ana lex="единица" gr="S,anim,f,gen,norm,sg" sem="" sem2=""/><ana lex="единица" gr="S,f,gen,inan,norm,sg" sem="t:ciph r:concr der:num" sem2="t:schoolmark pt:element hi:class der:num r:abstr pc:set t:unit r:concr"/>единицы</w> <w><ana lex="мочь" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="d:root" sem2=""/>может</w> <w><ana lex="взять" gr="V,act,inf,norm,pf,tran" sem="ca:caus t:poss" sem2="ca:noncaus"/>взять</w> <w><ana lex="только" gr="PART,norm" sem="" sem2=""/>только</w> <w><ana lex="такой" gr="APRO,acc,inan,norm,pl" sem="r:dem" sem2="r:indet r:spec t:degr:max"/>такие</w> <w><ana lex="словесный" gr="A,acc,inan,norm,pl,plen" sem="dt:word r:rel der:s" sem2="dt:word r:rel der:s"/>словесные</w> <w><ana lex="объединение" gr="S,acc,inan,n,norm,pl" sem="der:v r:abstr der:s0" sem2="sc:org sc:hum der:v t:org pt:set pt:part r:concr"/>объединения</w>, <w><ana lex="который" gr="APRO,nom,norm,pl" sem="r:rel t:ord" sem2=""/>которые</w> <w><ana lex="представлять" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="der:v d:pref" sem2="der:v d:pref"/>представляют</w> <w><ana lex="себе" gr="SPRO,ins,norm" sem="" sem2=""/>собой</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="непосредственный" gr="A,acc,f,norm,plen,sg" sem="d:neg r:rel" sem2="t:humq r:qual"/>непосредственную</w> «<w><ana lex="данность" gr="S,acc,f,inan,norm,sg" sem="r:abstr der:a" sem2=""/>данность</w>