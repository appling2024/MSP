<p><se><w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>И</w> <w><ana lex="тогда" gr="ADVPRO,norm" sem="t:time r:dem" sem2="r:dem"/>тогда</w> <w><ana lex="возникнуть" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="ca:noncaus d:pref t:be:appear" sem2="ca:noncaus d:pref"/>возникнет</w> <w><ana lex="наука" gr="S,f,inan,nom,norm,sg" sem="r:abstr" sem2="ev:posit r:abstr"/>наука</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="поэтический" gr="A,f,gen,norm,plen,sg" sem="dt:abstr r:rel der:s" sem2="dt:abstr r:rel der:s"/>поэтической</w> <w><ana lex="речь" gr="S,f,gen,inan,norm,sg" sem="t:speech r:abstr" sem2="t:speech r:concr r:abstr"/>речи</w>, <w><ana lex="наука" gr="S,f,inan,nom,norm,sg" sem="r:abstr" sem2="ev:posit r:abstr"/>наука</w>, <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="который" gr="APRO,f,loc,norm,sg" sem="r:rel t:ord" sem2=""/>которой</w> <w><ana lex="путь" gr="S,inan,m,nom,norm,sg" sem="top:stripe t:space r:concr" sem2="ev:posit t:space t:asp r:abstr sc:space pt:aggr:aggrpl pt:aggr top:stripe r:concr der:shift"/>путь</w> -- <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="иной" gr="APRO,0,norm" sem="r:spec" sem2="r:spec"/>иной</w> <w><ana lex="сторона" gr="S,f,gen,inan,norm,sg" sem="t:space r:concr pt:part pc:space" sem2="sc:hum t:space t:asp:ment r:abstr pt:set pc:x pt:part pc:space r:concr pc:form:geom"/>стороны</w> -- <w><ana lex="расчищать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="t:impact der:v d:pref" sem2=""/>расчищает</w> <w><ana lex="эстетика" gr="S,f,inan,nom,norm,sg" sem="r:abstr" sem2="t:ment ev:posit r:abstr"/>эстетика</w> <w><ana lex="слово" gr="S,gen,inan,n,norm,sg" sem="t:word r:concr r:abstr" sem2="pt:aggr:aggrpl t:text sc:word r:abstr t:speech r:concr"/>слова</w>.</se></p>

