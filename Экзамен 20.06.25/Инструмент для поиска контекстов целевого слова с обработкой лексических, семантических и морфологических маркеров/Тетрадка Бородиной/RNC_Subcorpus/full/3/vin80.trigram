" sem="t:text t:workdram t:workmus t:workart der:v t:workcin r:concr" sem2="r:abstr"/>произведения</w>.</se><se> <w>Например</w>: «<w><ana lex="миллион" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:card" sem2=""/>миллион</w> <w><ana lex="терзание" gr="S,gen,inan,n,norm,pl" sem="t:impact der:v r:abstr der:s0" sem2="t:psych:emot r:abstr"/>терзаний</w>»,</se></p>
	<p class="verse"><se><w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>Но</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="другой" gr="APRO,dat,m,norm,sg" sem="r:spec" sem2="r:ord r:spec r:indet"/>другому</w> <w><ana lex="отдать" gr="V,brev,f,norm,partcp,pass,pf,praet,sg" sem="ca:noncaus d:pref t:poss" sem2="ca:noncaus d:pref t:poss"/>отдана</w><br/> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>И</w> <w><ana lex="быть" gr="V,1p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>буду</w> <w><ana lex="век" gr="S,acc,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period r:abstr t:time"/>век</w> <w><ana lex="он" gr="SPRO,3p,dat,m,norm,sg" sem="r:pers" sem2=""/>ему</w> <w><ana lex="верный" gr="A,brev,f,norm,sg" sem="t:ver r:qual" sem2="ev:posit t:mod t:humq r:qual"/>верна</w>... <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w>т</w>.<w>д</w>.</se><br></br>
	</p>
<p><se><w><ana lex="при" gr="PR,norm" sem="" sem2=""/>При</w> <w><ana lex="это" gr="SPRO,inan,loc,n,norm,sg" sem="r:dem" sem2=""/>этом</w> <w><ana lex="следовать" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="ca:noncaus t:move der:s" sem2="ca:noncaus t:move der:s"/>следует</w> <w><ana lex="оговориться" gr="V,act,inf,intr,norm,pf" sem="t:speech ca:noncaus der:v d:pref" sem2="t:speech ca:noncaus der:v d:pref"/>оговориться</w>: <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="всегда" gr="ADVPRO,norm" sem="r:spec t:time" sem2=""/>всегда</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="весь" gr="APRO,nom,norm,pl" sem="r:spec" sem2=""/>все</w> <w><ana lex="символ" gr="S,inan,m,nom,norm,pl" sem="t:sign r:concr" sem2="t:sign r:concr r:abstr"/>символы</w> <w><ana lex="сковать" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="t:impact ca:caus der:v d:pref" sem2="der:v d:pref"/>скованы</w> <w><ana lex="неразрывный" gr="A,f,ins,norm,plen,sg" sem="d:neg r:rel" sem2=""/>неразрывной</w> <w><ana lex="эмоционально" gr="ADV,norm" sem="" sem2=""/>эмоционально-смысловой</w> <w><ana lex="цепь" gr="S,f,inan,ins,norm,sg" sem="sc:thing top:rope t:tool r:concr" sem2="sc:x top:rope t:form r:abstr pt:set der:shift sc:hum r:concr"/>цепью</w> <w><ana lex="со" gr="PR,norm" sem="" sem2=""/>со</w> <w><ana lex="весь" gr="APRO,f,ins,norm,sg" sem="r:spec" sem2=""/>всей</w> <w><ana lex="структура" gr="S,f,inan,ins,norm,sg" sem="r:abstr" sem2="r:concr t:org"/>структурой</w> <w><ana lex="художественный" gr="A,gen,n,norm,plen,sg" sem="r:rel der:s" sem2="ev:posit r:rel"/>художественного</w> <w><ana lex="произведение" gr="S,gen,inan,n,norm,sg" sem="t:text t:workdram t:workmus t:workart der:v t:workcin r:concr" sem2="r:abstr"/>произведения</w>; <w><ana lex="ведь" gr="CONJ,norm" sem="" sem2=""/>ведь</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="принцип" gr="S,inan,m,nom,norm,pl" sem="r:abstr pt:pa