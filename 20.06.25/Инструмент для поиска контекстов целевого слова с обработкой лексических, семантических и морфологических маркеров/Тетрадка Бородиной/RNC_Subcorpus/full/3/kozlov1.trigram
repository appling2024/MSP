concr der:a"/>святыни</w>.</se><se> <w><ana lex="что" gr="SPRO,inan,n,nom,norm,sg" sem="r:rel" sem2=""/>Что</w> <w><ana lex="там" gr="ADVPRO,norm" sem="t:place r:dem" sem2=""/>там</w> <w><ana lex="находиться" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="ca:noncaus t:move d:pref" sem2="t:loc d:pref ca:noncaus"/><ana lex="находиться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:move d:pref" sem2="t:loc d:pref ca:noncaus"/><ana lex="находиться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:move d:pref" sem2="t:loc d:pref ca:noncaus"/>находится</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="растительный" gr="A,f,gen,norm,plen,sg" sem="dt:plant r:rel der:s" sem2="t:humq ev:neg r:qual"/>растительной</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="животный" gr="A,f,gen,norm,plen,sg" sem="r:rel" sem2="r:rel"/>животной</w> <w><ana lex="жизнь" gr="S,f,gen,inan,norm,sg" sem="t:be:exist r:abstr" sem2="t:be:exist r:abstr t:time"/>жизни</w>?</se><se> <w><ana lex="никто" gr="SPRO,anim,m,nom,norm,sg" sem="r:neg" sem2=""/>Никто</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="ничто" gr="SPRO,n,nom,norm,sg" sem="r:neg" sem2=""/><ana lex="ничто" gr="SPRO,inan,n,nom,norm,sg" sem="r:neg" sem2=""/>ничто</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="нарушать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="der:v d:pref" sem2="der:v d:pref"/>нарушает</w> <w><ana lex="местный" gr="A,f,gen,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s"/>местной</w> <w><ana lex="святыня" gr="S,f,gen,inan,norm,sg" sem="ev:posit r:concr r:abstr der:a" sem2="t:thing r:concr der:a"/>святыни</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="только" gr="PART,norm" sem="" sem2=""/>только</w> <w><ana lex="один" gr="S,anim,m,nom,norm,sg" sem="" sem2=""/>один-два</w> <w><ana lex="отшельник" gr="S,anim,gen,m,norm,sg" sem="der:v t:hum r:concr d:nag" sem2="t: