<p><se><w><ana lex="вечер" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечером</w> <w><ana lex="заходить" gr="V,act,f,indic,norm,pf,praet,sg,tran" sem="ca:noncaus t:move d:pref" sem2=""/><ana lex="заходить" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2=""/><ana lex="заходить" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2=""/><ana lex="зайти" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/><ana lex="заходить" gr="V,act,f,indic,intr,ipf,norm,praet,sg" sem="ca:noncaus t:move d:pref" sem2=""/><ana lex="заходить" gr="V,act,f,indic,intr,ipf,norm,praet,sg" sem="ca:noncaus t:move d:pref" sem2=""/>заходила</w> <w><ana lex="леночка" gr="S,anim,f,nom,norm,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Леночка</w>, <w><ana lex="сидеть" gr="V,act,f,indic,intr,ipf,norm,praet,sg" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:noncaus"/>сидела</w>, <w><ana lex="беседовать" gr="V,act,f,indic,intr,ipf,norm,praet,sg" sem="t:speech ca:noncaus der:s" sem2=""/>беседовала</w>, <w><ana lex="нащупывать" gr="V,act,f,indic,ipf,norm,praet,sg,tran" sem="t:impact der:v d:pref d:impf" sem2=""/>нащупывала</w> <w><ana lex="мой" gr="APRO,acc,n,norm,sg" sem="r:poss" sem2=""/>мое</w> <w><ana lex="настроение" gr="S,acc,inan,n,norm,sg" sem="t:psych r:abstr" sem2="t:psych r:abstr"/>настроение</w>.</se><se> <w><ana lex="заметить" gr="V,act,ger,norm,pf,praet" sem="ca:noncaus d:pref t:perc" sem2="d:pref"/>Заметив</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="мой" gr="APRO,f,gen,norm,sg" sem="r:poss" sem2=""/>моей</w> <w><ana lex="сторона" gr="S,f,gen,inan,norm,sg" sem="t:space r:concr pt:part pc:space" sem2="sc:hum t:space t:asp:ment r:abstr pt:set pc:x pt:part pc:space r:concr pc:form:geom"/>стороны</w> <w><ana lex="внимательный" gr="A,acc,n,norm,plen,sg" sem="t:humq r:qual" sem2="t:humq r:qual"/>внимате