<p><se><b/><w><b>24</b></w><b>/</b><w><ana lex="xi" gr="bastard" sem="" sem2=""/><b>XI</b></w><b>, </b><w><ana lex="w" gr="bastard" sem="" sem2=""/><b>W</b></w><b/>. <w><ana lex="опять" gr="ADV,norm" sem="" sem2=""/>Опять</w> <w><ana lex="ясный" gr="A,brev,n,norm,sg" sem="r:qual" sem2="r:qual"/>ясно</w>, <w><ana lex="тихий" gr="A,brev,n,norm,sg" sem="d:neg t:sound r:qual" sem2="d:neg t:humq t:speed:min der:shift t:sound r:qual"/>тихо</w>, <w><ana lex="чувствительный" gr="A,brev,n,norm,sg" sem="der:v dt:perc t:humq d:habit r:qual" sem2="dt:perc t:degr t:humq d:potent der:v r:qual"/>чувствительно</w> <w>морозно</w>, -<w><ana lex="32" gr="NUM,ciph"/>32</w>°<w>С</w>. <w><ana lex="окрестность" gr="S,f,inan,nom,norm,sg" sem="der:a t:space r:concr sc:space pc:space" sem2=""/>Окрестность</w> <w><ana lex="весь" gr="APRO,f,nom,norm,sg" sem="r:spec" sem2=""/>вся</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="долина" gr="S,anim,f,famn,nom,norm,sg" sem="" sem2=""/><ana lex="долина" gr="S,f,inan,nom,norm,sg" sem="t:space r:concr der:s t:fam" sem2=""/>долина</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="гора" gr="S,f,inan,nom,norm,pl" sem="top:hill t:space r:concr" sem2="sc:x pt:set t:space t:form r:abstr t:quant:max r:concr"/>горы</w>, <w><ana lex="спрятать" gr="V,brev,norm,partcp,pass,pf,pl,praet,tran" sem="t:put ca:caus d:pref" sem2=""/>спрятаны</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="снег" gr="S,inan,loc2,m,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2=""/>снегу</w>.</se><se> <w><ana lex="солнце" gr="S,inan,loc,n,norm,sg" sem="top:horiz top:spher t:astr t:space r:concr" sem2="ev:posit t:space r:concr r:abstr t:light"/>Солнце</w> <w><ana lex="только" gr="PART,norm" sem="" sem2=""/>только</w> <w><ana lex="светить" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:light" sem2=""/>светит</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="не" gr="PART,norm" sem="" s