<p><se><b/><w><b>8</b></w><b>/</b><w><ana lex="viii" gr="bastard" sem="" sem2=""/><b>VIII</b></w><b>,</b> <b/><w><ana lex="s" gr="bastard" sem="" sem2=""/><b>S</b></w><b/>. <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="должный" gr="A,brev,norm,pl" sem="" sem2=""/>должны</w> <w><ana lex="прийти" gr="V,act,inf,intr,norm,pf" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/><ana lex="придти" gr="V,act,inf,intr,norm,pf" sem="" sem2=""/>прийти</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="иркутск" gr="S,acc,inan,m,norm,sg" sem="r:propn t:topon" sem2=""/>Иркутск</w>.</se><se> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>До</w> <w>Черемхово</w> <w><ana lex="поезд" gr="S,inan,m,nom,norm,sg" sem="sc:tool:transp t:tool:transp r:concr" sem2="pt:set sc:tool:transp r:concr"/>поезд</w> <w><ana lex="почти" gr="ADV,norm" sem="" sem2=""/>почти</w> <w><ana lex="весь" gr="APRO,acc,f,norm,sg" sem="r:spec" sem2=""/>всю</w> <w><ana lex="дистанция" gr="S,acc,f,inan,norm,sg" sem="t:dist t:space r:concr r:abstr" sem2="t:dist pc:space r:concr r:abstr pt:part"/>дистанцию</w> <w><ana lex="подниматься" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="ca:noncaus t:move d:pref" sem2=""/><ana lex="подниматься" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="ca:noncaus t:move d:pref" sem2=""/><ana lex="подыматься" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2=""/>поднимался</w> <w><ana lex="медленно" gr="ADV,norm" sem="ev dt:speed:min t:speed:min der:a" sem2=""/>медленно</w> <w><ana lex="вверх" gr="ADV,norm" sem="der:s t:dir" sem2="der:s"/>вверх</w>.</se><se> <w><ana lex="местность" gr="S,f,inan,nom,norm,sg" sem="t:space r:concr der:s" sem2="t:space r:concr der:s sc:space"/>Местность</w> <w><ana lex="изменить" gr="V,act,f,indic,norm,pf,praet,sg" sem="der:v d:pref" sem2="der:v d:pref"/><ana lex="изменить" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v d:pref" sem2="der:v d: