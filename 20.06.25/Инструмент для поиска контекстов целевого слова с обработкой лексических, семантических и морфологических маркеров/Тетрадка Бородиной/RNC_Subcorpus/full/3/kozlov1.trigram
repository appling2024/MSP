<p><se><b/><w><b>5</b></w><b>/</b><w><ana lex="ii" gr="bastard" sem="" sem2=""/><b>II</b></w><b>, </b><w><ana lex="u" gr="bastard" sem="" sem2=""/><b>U</b></w><b/>. <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w> <w><ana lex="облачный" gr="A,n,nom,norm,plen,sg" sem="r:rel der:s" sem2="t:physq r:rel der:s"/>облачное</w>, <w><ana lex="небо" gr="S,inan,n,nom,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/><ana lex="небо" gr="S,inan,n,nom,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/>небо</w> <w><ana lex="наполовину" gr="ADV,norm" sem="t:quant:abs der:s" sem2="der:s"/>наполовину</w> <w><ana lex="покрыть" gr="V,brev,n,norm,partcp,pass,pf,praet,sg" sem="d:pref" sem2="d:pref"/>покрыто</w> <w><ana lex="слоистый" gr="A,ins,norm,pl,plen" sem="t:physq d:habit der:s r:qual" sem2=""/>слоистыми</w> <w><ana lex="облако" gr="S,inan,ins,n,norm,pl" sem="qc:stuff r:concr" sem2="qc:stuff pt:qtm top:form r:concr"/>облаками</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="промежуток" gr="S,inan,loc,m,norm,pl" sem="t:dist t:space r:concr der:adv" sem2="der:shift t:dist r:abstr"/>промежутках</w> <w><ana lex="облако" gr="S,gen,inan,n,norm,pl" sem="qc:stuff r:concr" sem2="qc:stuff pt:qtm top:form r:concr"/>облаков</w> <w><ana lex="залегать" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v d:pref" sem2=""/>залегают</w> <w><ana lex="чудный" gr="A,nom,norm,pl,plen" sem="dt:abstr ev:posit r:rel" sem2="dt:abstr ev:posit t:quality der:s r:qual"/><ana lex="чудной" gr="A,nom,norm,pl,plen" sem="dt:abstr t:humq ev:neg r:qual" sem2=""/>чудные</w> <w><ana lex="лазоревый" gr="A,nom,norm,pl,plen" sem="t:physq:color r:qual" sem2=""/>лазоревые</w> <w><ana lex="пространство" gr="S,inan,n,nom,norm,pl" sem="t:space r:concr hi:class" sem2="top:gape t:space r:concr r:abstr hi: