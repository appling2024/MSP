<p><se><w><ana lex="котик" gr="S,anim,m,nom,norm,sg" sem="d:dim t:animal r:concr der:s" sem2=""/><ana lex="котик" gr="S,inan,m,nom,norm,sg" sem="" sem2="der:shift t:stuff r:concr t:fam"/>Котик</w> <w><ana lex="понемногу" gr="ADV,norm" sem="t:quant:min der:adv" sem2="der:adv"/>понемногу</w> <w><ana lex="поправляться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v d:pref" sem2=""/>поправляется</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="зато" gr="CONJ,norm" sem="" sem2=""/>зато</w> <w><ana lex="павлов" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Павлов</w> <w><ana lex="совершенно" gr="ADV,norm" sem="dt:degr:max t:degr:max der:a" sem2=""/>совершенно</w> <w><ana lex="слечь" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="d:pref" sem2=""/><ana lex="слечь" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="d:pref" sem2=""/>слег</w>, <w><ana lex="он" gr="SPRO,3p,m,nom,norm,sg" sem="r:pers" sem2=""/>он</w> <w><ana lex="давно" gr="ADV,norm" sem="t:time" sem2=""/>давно</w> <w><ana lex="недомогать" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="der:v d:pref" sem2=""/>недомогал</w>.</se></p>
<p><se><w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>Так</w> <w><ana lex="третий" gr="ANUM,acc,inan,m,norm,sg" sem="r:ord der:num r:rel t:ord" sem2="t:share r:rel der:num"/>третий</w> <w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="мочь" gr="V,1p,act,indic,intr,ipf,norm,praes,sg" sem="d:root" sem2=""/>могу</w> <w><ana lex="получить" gr="V,act,inf,norm,pf" sem="ca:noncaus t:poss" sem2=""/>получить</w> <w><ana lex="письмо" gr="S,acc,inan,n,norm,pl" sem="r:concr t:text" sem2="pt:aggr t:asp r:concr r:abstr sc:letter"/>письма</w> -- <w><ana lex="черт" gr="S,anim,m,nom,norm,sg" sem="" sem2="t:hum ev r:concr"/>черт</w> <w><ana lex="знать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/>знает</w> <w><ana lex="что" gr="SPRO,inan,n,nom,norm,sg" sem="r:rel" sem2=""/>что</w> <w><ana lex="такой" gr="APRO,n,nom,norm,sg" sem="r:dem" sem2="r:indet r:spec t:degr:max"/>такое</w>.</se><se> <w><ana lex="ужели" gr="PART,norm" sem="" sem2=""/>Ужели</w> <w><ana lex="прийтись" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="der:v d:pref" sem2="der:v d:pref"/><ana lex="придтись" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="der:v t:move d:pref" sem2=""/>придется</w> <w><ana lex="обращаться" gr="V,act,inf,intr,ipf,norm" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref"/>обращаться</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="содействие" gr="S,inan,ins,n,norm,sg" sem="r:abstr t:inter" sem2=""/>содействием</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="самый" gr="APRO,dat,m,norm,sg" sem="r:spec" sem2="r:spec"/><ana lex="сам" gr="APRO,dat,m,norm,sg" sem="r:spec" sem2=""/>самому</w> <w>А</w>. <w>Н</w>. <w><ana lex="васи