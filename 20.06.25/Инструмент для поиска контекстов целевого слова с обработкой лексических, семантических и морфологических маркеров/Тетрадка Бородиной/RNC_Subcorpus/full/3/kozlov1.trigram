<p><se><b/><w><b>19</b></w><b>/</b><w><ana lex="xii" gr="bastard" sem="" sem2=""/><b>XII</b></w><b>, </b><w><ana lex="s" gr="bastard" sem="" sem2=""/><b>S</b></w><b/>. <w><ana lex="сказать" gr="V,brev,n,norm,partcp,pass,pf,praet,sg,tran" sem="t:speech ca:noncaus" sem2=""/>Сказано</w> -- <w><ana lex="сделать" gr="V,brev,n,norm,partcp,pass,pf,praet,sg,tran" sem="d:pref" sem2=""/>сделано</w>.</se><se> <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="утро" gr="S,gen,inan,n,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утра</w> <w><ana lex="я" gr="SPRO,1p,acc,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="собирать" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="der:v d:pref t:poss" sem2=""/>собирают</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="экскурсия" gr="S,acc,f,inan,norm,sg" sem="t:action t:move r:abstr" sem2="t:group pt:set r:concr sc:hum"/>экскурсию</w> <w><ana lex="зоологический" gr="A,acc,f,norm,plen,sg" sem="r:rel der:s" sem2="r:rel der:s"/>зоологическую</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="несколько" gr="NUM,acc,inan,norm" sem="" sem2=""/>несколько</w> <w><ana lex="день" gr="S,gen,inan,m,norm,pl" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дней</w>.</se><se> <w><ana lex="хотеть" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="ca:noncaus t:psych:volit d:root" sem2="d:root"/>Хочу</w> <w><ana lex="насладиться" gr="V,act,inf,intr,norm,pf" sem="der:v ca:noncaus d:pref t:psych:emot" sem2=""/>насладиться</w> <w><ana lex="тишина" gr="S,anim,f,famn,ins,norm,sg" sem="" sem2=""/><ana lex="тишина" gr="S,f,inan,ins,norm,sg" sem="t:neg t:sound r:abstr t:fam" sem2="r:abstr"/>тишиной</w>, <w><ana lex="вид" gr="S,anim,famn,ins,m,norm,sg" sem="" sem2=""/><ana lex="вид" gr="S,inan,ins,m,norm,sg" sem="der:v r:abstr" sem2="t:ment t:space r:abstr t:workart der:v t:pe