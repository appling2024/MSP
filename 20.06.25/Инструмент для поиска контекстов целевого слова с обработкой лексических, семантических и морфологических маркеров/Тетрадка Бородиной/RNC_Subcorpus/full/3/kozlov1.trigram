<p><se><w><ana lex="когда" gr="CONJ,norm" sem="" sem2=""/>Когда</w> <w><ana lex="стоять" gr="V,2p,act,indic,intr,ipf,norm,praes,sg" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:noncaus"/><ana lex="стоить" gr="V,2p,act,indic,ipf,norm,praes,sg" sem="d:root" sem2="d:root"/>стоишь</w> <w><ana lex="долгий" gr="A,acc,n,norm,plen,sg" sem="t:time:dur:max r:qual" sem2="t:size:max r:qual"/>долгое</w> <w><ana lex="время" gr="S,acc,inan,n,norm,sg" sem="r:abstr t:param t:time" sem2="t:time:period r:abstr t:time"/>время</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="место" gr="S,inan,loc,n,norm,sg" sem="qc:space t:space r:concr" sem2="qc:space sc:org t:tool t:space pt:element r:abstr pt:aggr:aggrpl pt:part pc:text r:concr"/>месте</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="видеть" gr="V,2p,act,indic,ipf,norm,praes,sg,tran" sem="ca:noncaus t:perc d:root" sem2="t:ment ca:noncaus d:root"/>видишь</w> <w><ana lex="мимо" gr="PR,norm" sem="" sem2=""/>мимо</w> <w><ana lex="проходящий" gr="V,acc,act,inan,ipf,norm,partcp,pl,plen,praes,tran" sem="" sem2=""/><ana lex="проходить" gr="V,acc,act,inan,intr,ipf,norm,partcp,pl,plen,praes" sem="der:v ca:noncaus t:move d:pref" sem2=""/><ana lex="проходить" gr="V,acc,act,inan,ipf,norm,partcp,pl,plen,praes,tran" sem="der:v ca:noncaus t:move d:pref" sem2=""/>проходящие</w> <w><ana lex="караван" gr="S,acc,inan,m,norm,pl" sem="pt:set r:concr sc:animal" sem2="pt:set sc:tool:transp sc:stuff r:concr sc:aggr"/>караваны</w>, <w><ana lex="невольно" gr="ADV,norm" sem="der:a" sem2=""/>невольно</w> <w><ana lex="завидовать" gr="V,2p,act,indic,intr,ipf,norm,praes,sg" sem="der:v d:pref" sem2=""/>завидуешь</w> <w><ana lex="они" gr="SPRO,3p,dat,norm,pl" sem="r:pers" sem2=""/>им</w>.</se><se> <w><ana lex="тогда" gr="ADVPRO,norm" sem="t:time r:dem" sem2="r:dem"/>Тогда</w> <w><ana lex="даль" gr="S,f,inan,nom,norm,sg" sem="t:space der:a sc:space pc:space r:concr t:fam" sem2="t:space der:a sc:space pt:aggr:aggrpl