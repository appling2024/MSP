sem2=""/>поблагодарил</w> <w><ana lex="он" gr="SPRO,3p,acc,m,norm,sg" sem="r:pers" sem2=""/>его</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="нанять" gr="V,act,indic,m,norm,pf,praet,sg" sem="d:pref" sem2=""/>нанял</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="мы" gr="SPRO,1p,dat,norm,pl" sem="r:pers" sem2=""/>нам</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="служба" gr="S,acc,f,inan,norm,sg" sem="der:v r:abstr der:s0" sem2="sc:org der:v r:abstr t:org sc:hum pt:aggr sc:constr pt:aggr:aggrpl r:concr"/>службу</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="качество" gr="S,inan,loc,n,norm,sg" sem="r:abstr" sem2="r:abstr"/>качестве</w> <w><ana lex="разыскиватель" gr="S,bastard,gen,inan,m,sg" sem="" sem2=""/>разыскивателя</w> <w><ana lex="подобный" gr="A,gen,norm,pl,plen" sem="t:qual" sem2="der:s t:like r:qual"/>подобных</w> <w><ana lex="интересный" gr="A,gen,norm,pl,plen" sem="dt:abstr der:s dt:ment r:qual" sem2="dt:abstr ev:posit der:s dt:ment r:qual"/>интересных</w> <w><ana lex="место" gr="S,gen,inan,n,norm,pl" sem="qc:space t:space r:concr" sem2="qc:space sc:org t:tool t:space pt:element r:abstr pt:aggr:aggrpl pt:part pc:text r:concr"/>мест</w>!</se><se> <w><ana lex="пока" gr="CONJ,norm" sem="" sem2=""/>Пока</w> <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="этот" gr="APRO,m,nom,norm,sg" sem="r:dem" sem2=""/>этот</w> <w><ana lex="бурят" gr="S,anim,m,nom,norm,sg" sem="" sem2=""/>бурят</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="сергей" gr="S,anim,ins,m,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Сергеем</w> <w><ana lex="александрович" gr="S,anim,ins,m,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2="t:hum r:propn t:famn"/><ana lex="александрович" gr="S,anim,famn,ins,m,norm,sg" sem="t:hum t:patrn r:propn der:s" sem2="t:hum r:propn t:famn"/>Александровичем</w> <w><ana lex="отправиться" gr="V,act,indic,intr,m,norm,pf,praet,