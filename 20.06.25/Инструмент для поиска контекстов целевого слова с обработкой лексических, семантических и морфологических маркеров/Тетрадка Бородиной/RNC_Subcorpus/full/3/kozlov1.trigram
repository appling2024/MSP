<p><se><w><ana lex="пока" gr="ADV,norm" sem="t:time" sem2=""/>Пока</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w> <w>надо</w> <w><ana lex="написать" gr="V,act,inf,norm,pf,tran" sem="der:v d:pref" sem2=""/>написать</w> <w>П</w>. <w>С</w>. <w><ana lex="михно" gr="S,0,anim,bastard,famn" sem="t:hum r:propn t:famn" sem2=""/><ana lex="михно" gr="S,0,anim,bastard,persn" sem="t:hum r:propn t:famn" sem2=""/>Михно</w>, <w><ana lex="успокоить" gr="V,act,inf,norm,pf" sem="der:v ca:caus d:pref" sem2="der:v ca:caus d:pref"/>успокоить</w> <w><ana lex="он" gr="SPRO,3p,acc,m,norm,sg" sem="r:pers" sem2=""/>его</w> <w><ana lex="хотя" gr="CONJ,norm" sem="" sem2=""/>хотя</w> <w><ana lex="бы" gr="PART,norm" sem="" sem2=""/>бы</w> <w><ana lex="немножечко" gr="ADV,norm" sem="t:degr:min d:dim ev der:adv" sem2="d:dim ev t:time:dur:min t:quant:min der:adv"/>немножечко</w>.</se></p>
<p><se><b/><w><b>2</b></w><b>/</b><w><ana lex="i" gr="bastard" sem="" sem2=""/><b>I</b></w><b>, </b><w><ana lex="s" gr="bastard" sem="" sem2=""/><b>S</b></w><b/>. <w><ana lex="ясный" gr="A,n,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>Ясное</w>, <w><ana lex="прозрачный" gr="A,n,nom,norm,plen,sg" sem="t:physq r:rel" sem2="t:physq r:rel r:qual"/>прозрачное</w>, <w><ana lex="холодный" gr="A,n,nom,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодное</w> <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утро</w>!</se><se> <w><ana lex="зима" gr="S,f,inan,nom,norm,sg" sem="t:time:season r:abstr t:time" sem2="t:fam"/>Зима</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="апогей" gr="S,inan,loc,m,norm,sg" sem="pt:element t:space r:concr" sem2="pt:phase r:abstr"/>апогее</w> <w><ana lex="свой" gr="APRO,gen,n,norm,sg" sem="r:poss" sem2="t:social r:poss"/>своего</w> <w><ana lex="могущество" gr="S,gen,inan,n,norm,sg" sem="r:abstr" sem2=""/>могущества</w>.</se><se> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>Не</w> <w><ana lex="знать" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/>знаю</w>, <w><ana lex="где" gr="ADVPRO,norm" sem="t:place r:rel" sem2="t:place r:indet"/>где</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="сильно" gr="ADV,norm" sem="dt:physq t:degr:max der:a" sem2="dt:physq der:a"/>сильно</w> <w><ana lex="простудиться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus t:physiol d:pref" sem2=""/>простудился</w>, <w><ana lex="немного" gr="ADV,norm" sem="t:degr:min ev der:adv" sem2="ev t:time:dur:min t:quant:min der:adv"/>немного</w> <w><ana lex="нехороший" gr="A,brev,n,norm,sg" sem="d:neg ev:neg t:quality der:a r:qual" sem2=""/>нехорошо</w> <w><ana lex="самочувствие" gr="S,inan,n,nom,norm,sg" sem="t:physiol t:psych r:abstr" sem2=""/>самочувствие</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="кашель" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:disease" sem2=""/>кашель</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="особенность" gr="S,f,inan,loc,norm,sg" sem="r:abstr der:a" sem2="r:abstr der:a"/>особенности</w> <w><ana lex="сильный" gr="A,m,nom,norm,plen,sg" sem="t:physq d:habit r:qual" sem2="ev:posit t:humq:char der:s t:degr:max r:qual r:rel"/>сильный</w>, <w><ana lex="почти" gr="ADV,norm" sem="" sem2=""/>почти</w> <w><ana lex="непрерывный" gr="A,m,nom,norm,plen,sg" sem="d:neg r:rel" sem2=""/>непрерывный</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="постель" gr="S,f,inan,loc,norm,sg" sem="t:space r:concr t:tool:furn" sem2="sc:linen pt:aggr sc:bedding r:concr t:tool:bedding"/>постели</w>.</se></p>
<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="получить" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:noncaus t:poss" sem2=""/>получил</w> <w><ana lex="подарок" gr="S,acc,inan,m,norm,sg" sem="der:v t:thing r:concr" sem2="t:thing ev:posit r:concr r:abstr"/>подарок</w> -- <w><ana lex="карточка" gr="S,f,gen,inan,norm,sg" sem="qc:stuff r:concr" sem2="der:s t:doc r:concr t:workart d:dim"/>карточки</w> (<w><ana lex="фото" gr="S,0,inan,n,norm" sem="r:concr t:workart" sem2=""/>фото</w>) <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="супруг" gr="S,anim,gen,m,norm,pl" sem="" sem2=""/>супругов</w> <w><ana lex="цецен" gr="S,bastard,inan,m,nom,sg" sem="" sem2=""/>Цецен-ванов</w> (<w><ana lex="обеднеть" gr="V,act,gen,intr,norm,partcp,pf,pl,plen,praet" sem="der:a dt:qual der:v t:changest ca:noncaus d:pref" sem2=""/>обедневших</w>).</se></p>
<p><se><w>Удивительно</w>, <w><ana lex="как" gr="CONJ,norm" sem="" sem2=""/>как</w> <w><ana lex="деликатный" gr="A,brev,norm,pl" sem="ev:posit t:humq r:qual" sem2="r:qual"/>деликатны</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="честный" gr="A,brev,norm,pl" sem="ev:posit t:humq der:s r:qual" sem2="ev:posit t:humq r:qual"/>честны</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w>данном</w> <w><ana lex="слово" gr="S,inan,loc,n,norm,sg" sem="t:word r:concr r:abstr" sem2="pt:aggr:aggrpl t:text sc:word r:abstr t:speech r:concr"/>слове</w> <w><ana lex="культурный" gr="A,acc,inan,norm,pl,plen" sem="r:rel der:s" sem2="ev:posit t:humq r:rel der:s r:qual"/>культурные</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="верхний" gr="A,acc,inan,norm,pl,plen" sem="t:place dt:space der:s r:qual" sem2="dt:space der:s r:qual t:place t:species r:rel"/>верхние</w> <w><ana lex="слой" gr="S,acc,inan,m,norm,pl" sem="qc:stuff pt:qtm r:concr" sem2="pt:set hi:class t:group sc:hum pt:part r:concr"/>слои</w> <w><ana lex="монгольский" gr="A,gen,norm,pl,plen" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>монгольских</w> <w><ana lex="представитель" gr="S,anim,gen,m,norm,pl" sem="der:v t:hum r:concr d:nag" sem2="der:v t:hum r:concr d:nag"/>представителей</w>.</se><se> <w><ana lex="ведь" gr="CONJ,norm" sem="" sem2=""/>Ведь</w> <w><ana lex="они" gr="SPRO,3p,nom,norm,pl" sem="r:pers" sem2=""/>они</w> <w><ana lex="нести" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="ca:caus t:move d:root" sem2="t:move d:root ca:caus t:speech ev:neg ca:noncaus"/>несут</w> <w><ana lex="традиция" gr="S,acc,f,inan,norm,pl" sem="r:abstr" sem2="r:abstr"/>традиции</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="благородство" gr="S,acc,inan,n,norm,sg" sem="ev:posit t:humq r:abstr der:a" sem2="ev:posit r:abstr der:shift der:a"/>благородство</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="дородство" gr="S,inan,ins,n,norm,sg" sem="r:abstr" sem2=""/>дородством</w>.</se></p>
<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="двое" gr="NUM,nom,norm" sem="r:coll:pauc" sem2=""/>двое</w> <w><ana lex="мой" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/>моих</w> <w><ana lex="спутник" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,gen,inan,m,norm,pl" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутников</w>, <w><ana lex="телешов" gr="S,anim,bastard,famn,m,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Телешов</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="степанов" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Степанов</w>, <w><ana lex="отбыть" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:noncaus t:move d:pref" sem2="der:v d:pref"/>отбыли</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="экспедиция" gr="S,dat,f,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w> <w><ana lex="домой" gr="ADV,norm" sem="der:s t:dir" sem2=""/>домой</w>.</se><se> <w><ana lex="первый" gr="ANUM,m,nom,norm,sg" sem="r:ord der:num t:ord r:qual" sem2="ev:posit t:hier t:qual r:qual"/>Первый</w>, <w>вероятно</w>, <w><ana lex="навсегда" gr="ADV,norm" sem="der:advpro t:time" sem2=""/>навсегда</w>, <w><ana lex="второй" gr="ANUM,0,norm" sem="r:ord der:num r:rel t:ord" sem2="t:hier t:share r:rel der:num"/>второй</w> -- <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="указание" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0" sem2="t:speech r:abstr"/>указания</w> <w><ana lex="он" gr="SPRO,3p,dat,m,norm,sg" sem="r:pers" sem2=""/>ему</w> <w><ana lex="срок" gr="S,gen,inan,m,norm,sg" sem="t:time:period r:abstr t:param" sem2="t:time:moment r:abstr"/>срока</w> «<w><ana lex="явиться" gr="V,act,inf,intr,norm,pf" sem="ca:noncaus" sem2="ca:noncaus t:move"/>явиться</w>» <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w