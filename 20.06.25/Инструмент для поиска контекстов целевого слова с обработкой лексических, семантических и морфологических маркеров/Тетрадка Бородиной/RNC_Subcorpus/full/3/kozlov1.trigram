pref" sem2=""/><ana lex="выйти" gr="V,3p,act,fut,indic,norm,pf,sg" sem="der:v t:move d:pref" sem2=""/><ana lex="выходить" gr="V,3p,act,fut,indic,norm,pf,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v d:pref"/>выйдет</w>.</se><se> <w><ana lex="ужели" gr="PART,norm" sem="" sem2=""/>Ужели</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="получить" gr="V,1p,act,fut,indic,norm,pf,pl" sem="ca:noncaus t:poss" sem2=""/><ana lex="получить" gr="V,1p,act,imper,norm,pf,pl" sem="ca:noncaus t:poss" sem2=""/>получим</w> <w><ana lex="ни" gr="PART,norm" sem="" sem2=""/>ни</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="кто" gr="SPRO,anim,gen,m,norm,sg" sem="r:rel" sem2=""/>кого</w> <w><ana lex="ничто" gr="SPRO,gen,n,norm,sg" sem="r:neg" sem2=""/>ничего</w>?</se><se> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>Так</w> <w><ana lex="наш" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>наш</w> <w><ana lex="вопль" gr="S,inan,m,nom,norm,sg" sem="t:sound r:abstr" sem2=""/>вопль</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="остаться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="t:loc d:pref ca:noncaus" sem2="t:be:exist ca:noncaus d:pref"/>остался</w> <w><ana lex="неуслышанный" gr="A,ins,m,norm,plen,sg" sem="d:neg r:rel der:a" sem2=""/>неуслышанным</w>.</se><se> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>Для</w> <w><ana lex="что" gr="SPRO,gen,inan,n,norm,sg" sem="r:rel" sem2=""/>чего</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w> <w><ana lex="тогда" gr="ADVPRO,norm" sem="t:time r:dem" sem2="r:dem"/>тогда</w> <w><ana lex="наш" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>наш</w> <w><ana lex="посредник" gr="S,anim,m,nom,norm,sg" sem="der:v t:hum r:concr d:nag" sem2=""/>посредник</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="москва" gr="S,f,inan,loc,norm,sg" sem="r:propn t:topon" sem2="r:propn t:topon"/>Москве</w> -- <w><ana lex="горбунов" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Горбунов</w>?</se>!</p>
<p><se><b/><w><b>11</b></w><b>/</b><w><ana lex="xi" gr="bastard" sem="" sem2=""/><b>XI</b></w><b>, </b><w><ana lex="q" gr="bastard" sem="" sem2=""/><b>Q</b></w><b/>. <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="11" gr="NUM,ciph"/>11</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w> <w><ana lex="утро" gr="S,gen,inan,n,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утра</w> <w><ana lex="назначить" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="d:pref" sem2="d:pref"/>назначены</w> <w><ana lex="переговоры" gr="S,inan,nom,norm,pl" sem="t:speech t:action r:abstr" sem2="t:speech r:abstr"/>переговоры</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="представительство" gr="S,inan,ins,n,norm,sg" sem="der:v r:abstr der:s0" sem2="der:v r:concr t:org r:abstr"/>Представительством</w> (<w><ana lex="кондратьев" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Кондратьев</w>).</se><se> <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w> <w><ana lex="полуясный" gr="A,bastard,n,nom,plen,sg" sem="" sem2=""/>полуясное</w>, <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="холодный" gr="A,n,nom,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодное</w> (-<w><ana lex="8" gr="NUM,ciph"/>8</w>°<w><ana lex="r" gr="bastard" sem="" sem2=""/>R</w>).</se><se> <w>Надо</w> <w><ana lex="собирать" gr="V,act,inf,ipf,norm,tran" sem="der:v d:pref t:poss" sem2=""/>собирать</w> <w><ana lex="спутник" gr="S,acc,anim,m,norm,pl" sem="t:hum r:concr der:s" sem2=""/>спутников</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="дорога" gr="S,acc,f,inan,norm,sg" sem="top:stripe t:space r:concr t:fam" sem2="t:move dt:space r:abstr der:shift t:space r:concr"/>дорогу</w>!</se><se> <w><ana lex="решить" gr="V,act,indic,m,norm,pf,praet,sg" sem="t:ment ca:noncaus" sem2="t:ment ca:noncaus t:psych:volit"/>Решил</w> <w><ana lex="отправить" gr="V,act,inf,norm,pf" sem="ca:caus t:move d:pref" sem2="d:pref"/>отправить</w> <w><ana lex="они" gr="SPRO,acc,anim,norm,pl" sem="r:pers" sem2=""/>их</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="четверг" gr="S,acc,inan,m,norm,sg" sem="t:time:week r:abstr" sem2=""/>четверг</w>, <w><ana lex="15" gr="NUM,ciph"/>15</w> <w><ana lex="ноябрь" gr="S,gen,inan,m,norm,sg" sem="t:time:month r:abstr" sem2=""/>ноября</w>.</se><se> <w><ana lex="какой" gr="APRO,f,nom,norm,sg" sem="t:neg r:rel ev:neg" sem2=""/>Какая</w> <w><ana lex="ждать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="d:root" sem2="d:root"/>ждет</w> <w><ana lex="страшный" gr="A,f,nom,norm,plen,sg" sem="dt:abstr dt:psych:emot der:s r:qual" sem2="dt:psych:emot dt:abstr r:qual t:degr:max:magn der:shift t:degr:max ev:neg"/>страшная</w> <w><ana lex="минута" gr="S,f,inan,nom,norm,sg" sem="t:unit t:time:moment r:abstr pc:time" sem2="t:unit der:shift t:time:period r:abstr pc:time"/>минута</w>!</se><se> <w><ana lex="многое" gr="SPRO,acc,n,norm,sg" sem="der:subst r:spec der:apro" sem2=""/>Многое</w> <w>нужно</w> <w><ana lex="подготовить" gr="V,act,inf,norm,pf" sem="d:pref der:s" sem2="d:pref der:s"/>подготовить</w>: <w><ana lex="деньги" gr="S,inan,nom,norm,pl" sem="pt:aggr:aggrpl t:money r:concr sc:money:banknote hi:class" sem2="pt:aggr:aggrpl sc:money r:concr hi:class"/>деньги</w>, <w><ana lex="бумага" gr="S,f,inan,nom,norm,pl" sem="t:stuff r:concr" sem2="t:stuff r:concr t:text"/>бумаги</w>, <w><ana lex="предмет" gr="S,inan,m,nom,norm,pl" sem="t:thing r:concr" sem2="t:ment t:thing r:concr r:abstr"/>предметы</w> <w><ana lex="снаряжение" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0 t:poss" sem2="der:v t:tool r:concr pt:aggr sc:tool"/>снаряжения</w>, <w><ana lex="продовольствие" gr="S,inan,n,nom,norm,sg" sem="t:food pt:aggr hi:class r:concr sc:food" sem2=""/>продовольствие</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="проч" gr="S,anim,bastard,m,nom,sg" sem="" sem2=""/><ana lex="проча" gr="S,bastard,f,gen,inan,pl" sem="" sem2=""/>проч</w>.</se><se> <w>Необходимо</w> <w><ana lex="телеграфировать" gr="V,act,inf,norm,pf,tran" sem="der:s" sem2=""/><ana lex="телеграфировать" gr="V,act,inf,ipf,norm,tran" sem="der:s" sem2=""/>телеграфировать</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="центр" gr="S,acc,inan,m,norm,sg" sem="t:space r:concr pc:form:geom pt:part" sem2="pc:org t:space pc:hum pc:animal t:org pt:set pt:partb:organ pc:x pt:part sc:cell2 r:concr"/>Центр</w>, <w><ana lex="попросить" gr="V,act,inf,norm,pf,tran" sem="t:speech ca:caus d:pref" sem2=""/>попросить</w> <w><ana lex="разрешение" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0" sem2="der:v t:doc r:concr r:abstr t:param"/>разрешения</w> <w><ana lex="хотя" gr="PART,norm" sem="" sem2=""/>хотя</w> <w><ana lex="бы" gr="PART,norm" sem="" sem2=""/>бы</w> <w><ana lex="перенести" gr="V,act,inf,norm,pf" sem="der:v ca:caus t:move d:pref" sem2="der:v d:pref"/><ana lex="перенести" gr="V,act,inf,norm,pf" sem="der:v ca:caus t:move d:pref" sem2="der:v d:pref"/><ana lex="переносить" gr="V,act,inf,norm,pf" sem="ca:caus t:move d:pref" sem2="d:pref"/>перенести</w> <w><ana lex="бивак" gr="S,acc,inan,m,norm,sg" sem="t:space r:concr" sem2="t:space r:concr"/>бивак</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="город" gr="S,gen,inan,m,norm,sg" sem="sc:constr:build t:space r:concr" sem2="t:space r:concr"/>города</w> <w><ana lex="урга" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Урги</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="долина" gr="S,acc,anim,f,famn,norm,sg" sem="" sem2=""/><ana lex="долина" gr="S,acc,f,inan,norm,sg" sem="t:space r:concr der:s t:fam" sem2=""/>долину</w> <w><ana lex="река" gr="S,f,gen,inan,norm,sg" sem="top:contain t:reservoir t:space r:concr" sem2="t:quant:max pt:qtm r:abstr"/>реки</w> <w><ana lex="тола" gr="S,f,gen,inan,norm,sg" sem="" sem2=""/>Толы</w>, <w><ana lex="чтобы" gr="CONJ,norm" sem="" sem2=""/>чтобы</w> <w><ana lex="наконец" gr="ADV,PARENTH,norm" sem="der:s t:time" sem2=""/>наконец</w> <w><ana lex="бездействие" gr="S,acc,inan,n,norm,sg" sem="r:abstr" sem2=""/>бездействие</w> <w><ana lex="превратить" gr="V,act,inf,norm,pf" sem="der:v d:pref" sem2=""/>превратить</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="интересный" gr="A,n,nom,norm,plen,sg" sem="dt:abstr der:s dt:ment r:qual" sem2="dt:abstr ev:posit der:s dt:ment r:qual"/>интересное</w>, <w><ana lex="полезный" gr="A,n,nom,norm,plen,sg" sem="ev:posit der:s r:qual" sem2="der:s r:qual"/>полезное</w> <w><ana lex="времяпрепровождение" gr="S,inan,n,nom,norm,sg" sem="der:comp r:abstr" sem2=""/>времяпрепровождение</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="недра" gr="S,inan,loc,norm,pl" sem="t:space sc:space pt:aggr:aggrpl pt:part pc:space r:concr" sem2="pt:aggr:aggrpl t:space r:concr sc:space"/>недрах</w> <w><ana lex="монголия" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Монголии</w>.</se><se> <w><ana lex="там" gr="ADVPRO,norm" sem="t:place r:dem" sem2=""/>Там</w> <w><ana lex="все" gr="SPRO,nom,norm,pl" sem="" sem2=""/>все</w> <w><ana lex="объединиться" gr="V,1p,act,fut,indic,intr,norm,pf,pl" sem="ca:noncaus d:pref" sem2="ca:noncaus d:pref"/><ana lex="объединиться" gr="V,1p,act,imper,intr,norm,pf,pl" sem="ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>объединимся</w> -- <w><ana lex="один" gr="APRO,ins,m,norm,sg" sem="" sem2="r:indet"/>одним</w> <w><ana lex="дух" gr="S,anim,ins,m,norm,sg" sem="" sem2=""/><ana lex="дух" gr="S,inan,ins,m,norm,sg" sem="r:abstr" sem2="t:ment t:stuff t:hum:supernat t:smell r:abstr r:phras t:physiol r:concr"/>духом</w>, <w><ana lex="один" gr="APRO,ins,n,norm,sg" sem="" sem2="r:indet"/>одним</w> <w><ana lex="желание" gr="S,inan,ins,n,norm,sg" sem="t:psych:volit r:abstr" sem2="r:abstr"/>желанием</w>, <w><ana lex="интерес" gr="S,inan,ins,m,norm,sg" sem="t:ment r:abstr" sem2="r:abstr ev:neg"/>интересом</w>.</se><se> <w><ana lex="там" gr="ADVPRO,norm" sem="t:place r:dem" sem2=""/>Там</w> <w><ana lex="быть" gr="V,1p,act,fut,indic,intr,norm,pf,pl" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/><ana lex="быть" gr="V,1p,act,imper,intr,norm,pf,pl" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>будем</w> <w><ana lex="жить" gr="V,act,inf,intr,ipf,norm" sem="t:be:exist ca:noncaus d:root" sem2="d:root"/>жить</w> <w><ana lex="жизнь" gr="S,f,inan,ins,norm,sg" sem="t:be:exist r:abstr" sem2="t:be:exist r:abstr t:time"/>жизнью</w> <w><ana lex="путешественник" gr="S,anim,gen,m,norm,pl" sem="der:v t:hum r:concr d:nag" sem2=""/>путешественников</w>.</se></p>
<p><se><w><ana lex="спутник" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,inan,m,nom,norm,pl" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>Спутники</w> <w><ana lex="мой" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>мои</w>, <w><ana lex="обречь" gr="V,nom,norm,partcp,pass,pf,pl,plen,praet" sem="der:v d:pref" sem2=""/>обреченные</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="отъезд" gr="S,acc,inan,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="t:move r:abstr"/>отъезд</w>, <w><ana lex="усиленно" gr="ADV,norm" sem="ev der:aprt dt:degr" sem2=""/>усиленно</w> <w><ana lex="собираться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref t:psych:volit"/>собираются</w>.</se><se> <w>Нельзя</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="дать" gr="V,act,inf,norm,pf" sem="ca:caus d:root t:poss" sem2="d:root"/>дать</w> <w><ana lex="они" gr="SPRO,3p,dat,norm,pl" sem="r:pers" sem2=""/>им</w> <w><ana lex="весь" gr="APRO,gen,n,norm,sg" sem="r:spec" sem2=""/>всего</w> <w><ana lex="то" gr="SPRO,gen,inan,n,norm,sg" sem="r:dem" sem2=""/>того</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="они" gr="SPRO,3p,nom,norm,pl" sem="r:pers" sem2=""/>они</w> <w><ana lex="иметь" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="ca:noncaus d:root t:poss" sem2="d:root"/>имели</w> <w><ana lex="ранний" gr="A,comp,norm,plen" sem="t:time r:qual" sem2="t:time r:qual"/>раньше</w>.</se><se> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>С</w> <w><ana lex="особенный" gr="A,ins,n,norm,plen,sg" sem="r:rel" sem2=""/>особенным</w> <w><ana lex="удовольствие" gr="S,inan,ins,n,norm,sg" sem="t:psych:emot r:abstr" sem2="ev:posit r:abstr"/>удовольствием</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="снаряжать" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="der:v d:pref" sem2=""/>снаряжаю</w> <w><ana lex="мой" gr="APRO,acc,anim,m,norm,sg" sem="r:poss" sem2=""/>моего</w> <w><ana lex="незаменимый" gr="A,acc,anim,m,norm,plen,sg" sem="der:v d:neg d:impot r:rel" sem2=""/>незаменимого</w> <w><ana lex="сергей" gr="S,acc,anim,m,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Сергея</w> <w><ana lex="анатольевич" gr="S,acc,anim,m,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Анатольевича</w>, <w><ana lex="хотя" gr="CONJ,norm" sem="" sem2=""/>хотя</w> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="грустный" gr="A,brev,n,norm,sg" sem="dt:abstr dt:psych:emot t:psych:emot der:s r:qual" sem2="dt:abstr dt:psych:emot ev:neg der:s r:qual"/>грустно</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="делать" gr="V,act,inf,ipf,norm,tran" sem="d:root" sem2="d:root"/>делать</w> <w>нечего</w>.</se><se> <w><ana lex="хотеться" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="ca:noncaus t:psych:volit" sem2=""/>Хотелось</w> <w><ana lex="бы" gr="PART,norm" sem="" sem2=""/>бы</w> <w><ana lex="видеть" gr="V,act,inf,ipf,norm,tran" sem="ca:noncaus t:perc d:root" sem2="t:ment ca:noncaus d:root"/>видеть</w> <w><ana lex="мой" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/>моего</w> <w><ana lex="достойный" gr="A,gen,m,norm,plen,sg" sem="ev r:qual" sem2="ev r:qual"/>достойного</w> <w><ana lex="помощник" gr="S,anim,gen,m,norm,sg" sem="der:v t:hum r:concr d:nag" sem2="der:v t:hum r:concr d:nag"/>помощника</w> <w><ana lex="при" gr="PR,norm" sem="" sem2=""/>при</w> <w><ana lex="отличный" gr="A,loc,n,norm,plen,sg" sem="der:v r:rel" sem2="ev:posit t:quality r:qual"/>отличном</w> <w><ana lex="занятие" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr der:s0 t:poss" sem2="pt:qtm r:abstr"/>занятии</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="область" gr="S,f,inan,loc,norm,sg" sem="t:space r:concr