<p><se><w><ana lex="когда" gr="ADVPRO,norm" sem="r:rel t:time" sem2="t:time"/><ana form="Когда-то" lex="когда-то" gr="ADVPRO,norm" sem="der:advpro r:indet t:time" sem2=""/>Когда-то</w> <w><ana lex="возвратиться" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="der:v ca:noncaus t:move d:pref" sem2=""/>возвратится</w> <w><ana lex="мой" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>мой</w> <w><ana lex="канаич" gr="S,anim,bastard,m,nom,patrn,sg" sem="" sem2=""/>Канаич</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="прибыть" gr="V,3p,act,fut,indic,intr,norm,pf,pl" sem="ca:noncaus t:move d:pref" sem2="d:pref"/>прибудут</w> <w><ana lex="мой" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>мои</w> <w><ana lex="суга" gr="S,acc,bastard,f,inan,sg" sem="" sem2=""/>сугу-нурские</w> <w><ana lex="охотник" gr="S,anim,m,nom,norm,pl" sem="der:v t:hum r:concr d:nag t:prof" sem2="der:praedic t:hum ev r:concr d:nag"/>охотники</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="какой" gr="APRO,0,norm" sem="t:neg r:rel ev:neg" sem2=""/>какой</w> <w><ana lex="добыча" gr="S,f,inan,ins,norm,sg" sem="der:v r:abstr der:s0 t:poss" sem2="sc:thing r:abstr pt:ind der:v t:poss pt:aggr r:concr"/>добычей</w>?</se></p>
<p><se><w>Приятно</w> <w><ana lex="видеть" gr="V,act,inf,ipf,norm,tran" sem="ca:noncaus t:perc d:root" sem2="t:ment ca:noncaus d:root"/>видеть</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="чувствовать" gr="V,act,inf,ipf,norm,tran" sem="ca:noncaus t:perc der:s" sem2="der:s"/>чувствовать</w> <w><ana lex="приближение" gr="S,acc,inan,n,norm,sg" sem="der:v t:move r:abstr" sem2=""/>приближение</w> <w><ana lex="весна" gr="S,f,gen,inan,norm,sg" sem="t:time:season r:abstr t:time" sem2=""/>весны</w> -- <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>сегодня</w> <w><ana lex="таять" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:changest d:root ca:noncaus" sem2="d:root"/>тает</w> <w><ana lex="как" gr="CONJ,norm" sem="" sem2=""/>как</w> <w><ana lex="никогда" gr="ADVPRO,norm" sem="der:advpro r:neg t:time" sem2=""/>никогда</w>, <w><ana lex="солнце" gr="S,inan,n,nom,norm,sg" sem="top:horiz top:spher t:astr t:space r:concr" sem2="ev:posit t:space r:concr r:abstr t:light"/>солнце</w>, <w><ana lex="подниматься" gr="V,act,ger,intr,ipf,norm,praes" sem="ca:noncaus t:move d:pref" sem2=""/><ana lex="подыматься" gr="V,act,ger,intr,ipf,norm,praes" sem="der:v ca:noncaus t:move d:pref" sem2=""/>поднимаясь</w> <w><ana lex="высокий" gr="A,comp,norm,plen" sem="t:size:max r:qual" sem2="ev:posit der:shift t:size:max t:sound t:degr:max r:qual t:interpretation"/>выше</w>, <w><ana lex="давать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="der:v ca:caus d:impf t:poss d:root" sem2="der:v d:root d:impf"/>дает</w> <w><ana lex="себе" gr="SPRO,acc,norm" sem="" sem2=""/>себя</w> <w><ana lex="знать" gr="V,act,inf,ipf,norm,tran" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/>знать</w>.</se></p>
