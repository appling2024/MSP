n,sg" sem="" sem2=""/><ana lex="ибиунк" gr="S,anim,bastard,famn,m,nom,sg" sem="" sem2=""/><ana lex="ибиунк" gr="S,anim,bastard,m,nom,sg" sem="" sem2=""/><ana lex="ибиунк" gr="S,anim,bastard,m,nom,persn,sg" sem="" sem2=""/><ana lex="ибиунк" gr="S,bastard,inan,m,nom,sg" sem="" sem2=""/>Ибиунк</w>, <w><ana lex="иро" gr="S,0,anim,bastard,m,persn,sg" sem="" sem2=""/><ana lex="иро" gr="S,0,bastard,inan,m,sg" sem="" sem2=""/>Иро</w>, <w><ana lex="баин" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Баин-гол</w>, <w><ana lex="хара" gr="S,anim,nom,norm,persn,sg" sem="t:hum r:propn t:famn" sem2=""/>Хара</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="проч" gr="S,anim,bastard,m,nom,sg" sem="" sem2=""/><ana lex="проча" gr="S,bastard,f,gen,inan,pl" sem="" sem2=""/>проч</w>.</se><se> <w><ana lex="один" gr="APRO,nom,norm,pl" sem="" sem2="r:indet"/>Одни</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="они" gr="SPRO,3p,gen,norm,pl" sem="r:pers" sem2=""/>них</w> <w><ana lex="широкий" gr="A,comp,norm,plen" sem="t:size:max r:qual" sem2="der:shift t:size:max r:qual"/>шире</w>, <w><ana lex="многоводный" gr="A,comp,norm,plen" sem="" sem2=""/>многоводнее</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="хороший" gr="A,ins,norm,pl,plen" sem="ev:posit t:quality r:qual" sem2="ev:posit ev t:degr:max r:qual"/>хорошими</w> <w><ana lex="долина" gr="S,f,inan,ins,norm,pl" sem="t:space r:concr der:s t:fam" sem2=""/>долинами</w>, <w><ana lex="давать" gr="V,act,ins,ipf,norm,partcp,pl,plen,praes,tran" sem="der:v ca:caus d:impf t:poss d:root" sem2="der:v d:root d:impf"/>дающими</w> <w><ana lex="простор" gr="S,acc,inan,m,norm,sg" sem="t:space r:concr" sem2="ev:posit r:abstr"/>простор</w> <w><ana lex="тысяча" gr="S,dat,f,inan,norm,pl" sem="r:abstr t:card" sem2=""/>тысячам</w> <w><ana lex="животное" gr="S,anim,gen,n,norm,pl" sem="der:subst t:animal der:a r:concr hi:class" sem2="der:subst t:animal r:concr der:a"/>животных</w>, <w><ana lex="другой" gr="APRO,nom,norm,pl" sem="r:spec" sem2="r:ord r:spec r:indet"/>другие</w>, <w><ana lex="меньший" gr="A,nom,norm,pl,plen" sem="r:qual" sem2="r:rel t:ord"/><ana lex="меньшой" gr="A,nom,norm,pl,plen" sem="r:rel t:ord" sem2=""/>меньшие</w> <w><ana lex="размер" gr="S,inan,ins,m,norm,sg" sem="r:abstr t:param t:size" sem2="t:degr r:abstr"/>размером</w>, <w><ana lex="узкий" gr="A,nom,norm,pl,plen" sem="t:size:min r:qual" sem2="ev:neg t:size:min r:qual"/>узкие</w>, <w><ana lex="извиваться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v d:pref d:impf" sem2=""/>извиваются</w> <w><ana lex="среди" gr="PR,norm" sem="" sem2=""/>среди</w> <w><ana lex="отрог" gr="S,gen,inan,m,norm,pl" sem="t:space r:concr top:dam pt:part pc:space" sem2=""/>отрогов</w>.</se><se> <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>А</w> <w><ana lex="корм" gr="S,gen,inan,m,norm,sg" sem="der:v t:physiol r:abstr der:s0" sem2="hi:class sc:food der:v t:food:fodder pt:aggr r:concr"/>корма</w> <w><ana lex="скольким" gr="NUM,norm" sem="" sem2=""/>сколько</w> -- <w><ana lex="ужасно" gr="ADV,norm" sem="dt:quality der:a t:degr:max ev:neg" sem2="dt:quality der:a ev:neg"/>ужасно</w>!</se><se> <w><ana lex="иногда" gr="ADV,norm" sem="r:spec t:time" sem2=""/>Иногда</w> <w><ana lex="попадать" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v d:pref" sem2=""/><ana lex="попасть" gr="V,3p,act,fut,indic,intr,norm,pf,pl" sem="d:pref" sem2="d:pref"/><ana lex="попадать" gr="V,3p,act,fut,indic,intr,norm,pf,pl" sem="der:v d:pref" sem2=""/><ana lex="попадать" gr="V,3p,act,indic,ipf,norm,pl,praes" sem="der:v d:pref" sem2=""/><ana lex="попадать" gr="V,3p,act,fut,indic,norm,pf,pl" sem="der:v d:pref" sem2=""/>попадают</w> <w><ana lex="чудный" gr="A,nom,norm,pl,plen" sem="dt:abstr ev:posit r:rel" sem2="dt:abstr ev:posit t:quality der:s r:qual"/><ana lex="чудной" gr="A,nom,norm,pl,plen" sem="dt:abstr t:humq ev:neg r:qual" sem2=""/>чудные</w> <w><ana lex="картина" gr="S,anim,f,famn,nom,norm,pl" sem="" sem2