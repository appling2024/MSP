<p><se><w>Надо</w> <w><ana lex="стараться" gr="V,act,inf,intr,ipf,norm" sem="ca:noncaus d:root" sem2="ca:noncaus d:root"/>стараться</w> <w><ana lex="добыть" gr="V,act,inf,norm,pf" sem="der:v ca:caus d:pref t:poss" sem2="der:v d:pref"/>добыть</w> <w><ana lex="грамота" gr="S,acc,f,inan,norm,sg" sem="r:abstr" sem2="t:doc r:concr t:text"/>грамоту</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="посещение" gr="S,acc,inan,n,norm,sg" sem="der:v r:abstr" sem2=""/>посещение</w> <w><ana lex="страна" gr="S,f,gen,inan,norm,pl" sem="t:space r:concr" sem2="t:space r:concr"/>стран</w> <w><ana lex="сопредельный" gr="A,gen,norm,pl,plen" sem="dt:space t:dist r:rel der:s" sem2=""/>сопредельных</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="тибет" gr="S,inan,ins,m,norm,sg" sem="r:propn t:topon" sem2=""/>Тибетом</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="китайский" gr="A,gen,n,norm,plen,sg" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>Китайского</w> <w><ana lex="правительство" gr="S,gen,inan,n,norm,sg" sem="pc:org pt:set t:org der:v t:group sc:hum pt:part r:concr" sem2=""/>правительства</w>, <w>иначе</w> <w><ana lex="мочь" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="d:root" sem2=""/>могут</w> <w><ana lex="встретиться" gr="V,act,inf,intr,norm,pf" sem="ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>встретиться</w> <w><ana lex="больший" gr="A,acc,inan,norm,pl,plen" sem="d:compar t:size:max der:a dt:size:max r:qual" sem2=""/><ana lex="большой" gr="A,acc,inan,norm,pl,plen" sem="t:size:max r:qual" sem2="t:quant:max t:time:age t:degr:max r:qual"/>большие</w> <w><ana lex="недоразумение" gr="S,acc,inan,n,norm,pl" sem="r:abstr" sem2="r:abstr t:inter"/>недоразумения</w>.</se><se> <w><ana lex="только" gr="PART,norm" sem="" sem2=""/>Только</w> <w>теперь</w> <w><ana lex="во" gr="PR,norm" sem="" sem2=""/>во</w> <w><ana lex="весь" gr="APRO,f,loc,norm,sg" sem="r:spec" sem2=""/>всей</w> <w><ana lex="полнота" gr="S,f,inan,loc