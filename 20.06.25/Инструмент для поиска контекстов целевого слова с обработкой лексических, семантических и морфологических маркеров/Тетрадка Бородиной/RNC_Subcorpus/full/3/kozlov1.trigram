<p><se><w><ana lex="вот" gr="PART,norm" sem="" sem2="r:dem"/>Вот</w> <w><ana lex="как" gr="ADVPRO,norm" sem="r:rel t:manner" sem2=""/>как</w> <w><ana lex="бывать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:be:exist ca:noncaus der:v d:impf" sem2="der:v t:loc der:shift d:impf ca:noncaus"/>бывает</w>: <w><ana lex="завтра" gr="ADV,norm" sem="t:time" sem2=""/>завтра</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="этот" gr="APRO,acc,n,norm,sg" sem="r:dem" sem2=""/>это</w> <w><ana lex="время" gr="S,acc,inan,n,norm,sg" sem="r:abstr t:param t:time" sem2="t:time:period r:abstr t:time"/>время</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="8" gr="NUM,ciph"/>8</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w> <w><ana lex="вечер" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>вечера</w>, <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w>много</w> <w><ana lex="быть" gr="V,1p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>буду</w> <w><ana lex="знать" gr="V,act,inf,ipf,norm,tran" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/>знать</w>, <w><ana lex="кто" gr="SPRO,anim,m,nom,norm,sg" sem="r:rel" sem2=""/>кто</w> <w><ana lex="знать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/>знает</w>, <w><ana lex="мочь" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="d:root" sem2=""/>может</w> <w><ana lex="быть" gr="V,act,inf,intr,ipf,norm" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>быть</w>, <w><ana lex="быть" gr="V,1p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>буду</w> <w><ana lex="узко" gr="ADV,comp,norm" sem="dt:size:min der:a" sem2="dt:size:min der:a"/><ana lex="уже" gr="ADV,norm" sem="t:time" sem2=""/>уже</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> «<w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="поле" gr="S,inan,ins,n,norm,sg" sem="top:horiz t:space r:concr" sem2="t:plot t:space dt:space pc:workart pc:tool:cloth r:abstr top:surface der:shift top:stripe pt:part r:concr"/>полем</w>» -- <w><ana lex="результат" gr="S,inan,m,nom,norm,sg" sem="r:abstr" sem2="r:abstr"/>результат</w> <w><ana lex="охота" gr="S,f,gen,inan,norm,sg" sem="t:action t:psych:volit r:abstr" sem2="der:v d:nag r:abstr sc:hum pt:aggr r:concr"/>охоты</w> <w><ana lex="положительный" gr="A,m,nom,norm,plen,sg" sem="ev:posit r:rel" sem2="t:degr:max:magn ev:posit t:humq r:rel r:qual"/>положительный</w>.</se><se> <w><ana lex="только" gr="PART,norm" sem="" sem2=""/>Только</w> <w><ana lex="бы" gr="PART,norm" sem="" sem2=""/>бы</w> <w><ana lex="быть" gr="V,act,f,indic,intr,ipf,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>была</w> <w><ana lex="отличный" gr="A,f,nom,norm,plen,sg" sem="der:v r:rel" sem2="ev:posit t:quality r:qual"/>отличная</w> <w><ana lex="погода" gr="S,f,inan,nom,norm,sg" sem="r:abstr t:weather" sem2=""/>погода</w> -- <w><ana lex="тихий" gr="A,f,nom,norm,plen,sg" sem="d:neg t:sound r:qual" sem2="d:neg t:humq t:speed:min der:shift t:sound r:qual"/>тихая</w>, <w><ana lex="ясный" gr="A,f,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясная</w>, <w><ana lex="тогда" gr="ADVPRO,norm" sem="t:time r:dem" sem2="r:dem"/>тогда</w> <w>хорошо</w>!</se></p>
<p><se><b/><w><b>21</b></w><b>/</b><w><ana lex="x" gr="bastard" sem="" sem2=""/><b>X</b></w><b>, </b><w><ana lex="q" gr="bastard" sem="" sem2=""/><b>Q</b></w><b/>. <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w> <w><ana lex="серый" gr="A,n,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>серое</w>, <w><ana lex="облачный" gr="A,n,nom,norm,plen,sg" sem="r:rel der:s" sem2="t:physq r:rel der:s"/>облачное</w>, <w><ana lex="луч" gr="S,inan,m,nom,norm,pl" sem="r:abstr t:light" sem2="t:space top:line pt:qtm r:abstr qc:light r:concr"/>лучи</w> <w><ana lex="солнце" gr="S,gen,inan,n,norm,sg" sem="top:horiz top:spher t:astr t:space r:concr" sem2="ev:posit t:space r:concr r:abstr t:light"/>солнца</w> <w><ana lex="силиться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus" sem2=""/>силятся</w> <w><ana lex="прорваться" gr="V,act,inf,intr,norm,pf" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref"/>прорваться</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="земля" gr="S,acc,f,inan,norm,sg" sem="top:spher t:astr t:space r:concr" sem2="t:space sc:space top:horiz t:stuff pt:part pc:space r:concr"/>землю</w>.</se><se> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>Мы</w> <w><ana lex="готовый" gr="A,brev,norm,pl" sem="" sem2=""/>готовы</w> <w><ana lex="ехать" gr="V,act,inf,intr,ipf,norm" sem="ca:noncaus t:move d:root" sem2="d:root"/>ехать</w>, <w><ana lex="собирать" gr="V,1p,act,indic,ipf,norm,pl,praes,tran" sem="der:v d:pref t:poss" sem2=""/>собираем</w> <w><ana lex="последний" gr="A,acc,n,norm,plen,sg" sem="r:rel t:ord" sem2="t:degr:max:magn r:qual r:rel ev:neg t:time"/>последнее</w>, <w><ana lex="пить" gr="V,1p,act,indic,ipf,norm,pl,praes,tran" sem="ca:caus t:physiol d:root" sem2="d:root"/>пьем</w> <w><ana lex="чай" gr="S,acc,inan,m,norm,sg" sem="t:plant:bush r:concr" sem2="t:food t:stuff r: