<p><se><w><ana lex="погода" gr="S,f,inan,nom,norm,sg" sem="r:abstr t:weather" sem2=""/>Погода</w> <w><ana lex="стать" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="aux:phase d:root t:move:body" sem2="ca:noncaus t:move d:root t:loc"/>стала</w> <w><ana lex="серенький" gr="A,f,nom,norm,plen,sg" sem="d:dim dt:physq:color der:a t:physq:color r:qual" sem2=""/>серенькая</w>, <w><ana lex="прохладный" gr="A,f,nom,norm,plen,sg" sem="t:physq:temper r:qual" sem2="dt:temper dt:abstr ev der:s r:qual"/>прохладная</w>, <w><ana lex="вчера" gr="ADV,norm" sem="t:time" sem2=""/>вчера</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>сегодня</w> <b/><w><b>22</b></w><b>/</b><w><ana lex="iii" gr="bastard" sem="" sem2=""/><b>III</b></w><b>, </b><w><ana lex="w" gr="bastard" sem="" sem2=""/><b>W</b></w><b/>, <w><ana lex="горизонт" gr="S,inan,m,nom,norm,sg" sem="t:space r:concr" sem2="t:ment t:space qc:stuff pt:qtm r:abstr pt:aggr r:concr"/>горизонт</w> <w><ana lex="сократиться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="dt:size:min der:a der:v t:changest ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref"/>сократился</w> <w><ana lex="значительно" gr="ADV,norm" sem="dt:size:max t:degr:max der:a" sem2="dt:size:max der:a"/>значительно</w>, <w><ana lex="хотя" gr="CONJ,norm" sem="" sem2=""/>хотя</w> <w><ana lex="темный" gr="A,gen,norm,pl,plen" sem="t:physq:color r:qual" sem2="t:humq t:physq:color ev:neg r:qual"/>темных</w> <w><ana lex="пространство" gr="S,gen,inan,n,norm,pl" sem="t:space r:concr hi:class" sem2="top:gape t:space r:concr r:abstr hi:class"/>пространств</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="пятно" gr="S,gen,inan,n,norm,pl" sem="r:concr" sem2="der:shift ev:neg"/>пятен</w> <w><ana lex="прибавиться" gr="V,act,indic,intr,n,norm,pf,praet,sg" sem="ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>прибавилось</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w>много</w>, <w><ana lex="южный" gr="A,nom,norm,pl,plen" sem="t:place dt:space r:rel der:s" sem2=""/>южные</w> <w><ana lex="скат" gr="S,inan,m,nom,norm,pl" sem="t:animal:fish der:v pc:constr pt:part pc:part pc:space r:concr" sem2="pc:tool:transp r:concr pt:part"/><ana lex="скат" gr="S,anim,m,nom,norm,pl" sem="" sem2=""/>скаты</w> <w><ana lex="гора" gr="S,f,gen,inan,norm,pl" sem="top:hill t:space r:concr" sem2="sc:x pt:set t:space t:form r:abstr t:quant:max r:concr"/>гор</w> <w><ana lex="выглядеть" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v d:pref" sem2=""/><ana lex="выглядеть" gr="V,3p,act,fut,indic,norm,pf,pl,tran" sem="der:v d:pref" sem2=""/>выглядят</w> <w><ana lex="пестрый" gr="A,ins,norm,pl,plen" sem="t:physq:color r:qual" sem2="der:shift r:qual"/>пестрыми</w>.</se><se> <w><ana lex="лететь" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus t:move" sem2=""/>Летят</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="держаться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v ca:noncaus" sem2="der:v ca:noncaus"/>держатся</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="место" gr="S,inan,loc,n,norm,sg" sem="qc:space t:space r:concr" sem2="qc:space sc:org t:tool t:space pt:element r:abstr pt:aggr:aggrpl pt:part pc:text r:concr"/>месте</w> <w><ana lex="даурский" gr="A,nom,norm,pl,plen" sem="r:rel der:s" sem2=""/>даурские</w> <w><ana lex="галочка" gr="S,f,inan,nom,norm,pl" sem="" sem2="d:dim t:form t:sign r:concr der:s"/><ana lex="галочка" gr="S,anim,f,nom,norm,persn,pl" sem="d:dim t:animal r:concr der:s" sem2=""/>галочки</w> -- <w><ana lex="отдыхать" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v d:pref" sem2=""/>отдыхают</w>!</se><se> <w><ana lex="выйти" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v t:move d:pref" sem2=""/><ana lex="выйти" gr="V,act,f,indic,norm,pf,praet,sg" sem="der:v t:move d:pref" sem2=""/><ana lex="выходить" gr="V,act,f,indic,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v d:pref"/>Вышла</w> <w><ana lex="маленький" gr="A,f,nom,norm,plen,sg" sem="t:size:min r:qual" sem2="t:time:age t:size:min r:qual"/>маленькая</w> <w><ana lex="задержка" gr="S,f,inan,nom,norm,sg" sem="der:v r:abstr" sem2=""/>задержка</w> <w><ana lex="развитие" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0" sem2="t:humq r:abstr"/>развития</w> <w><ana lex="весна" gr="S,f,gen,inan,norm,sg" sem="t:time:season r:abstr t:time" sem2=""/>весны</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="зато" gr="CONJ,norm" sem="" sem2=""/>зато</w> <w><ana lex="после" gr="PR,norm" sem="" sem2=""/>после</w> <w><ana lex="равноденствие" gr="S,gen,inan,n,norm,sg" sem="r:abstr t:time" sem2=""/>равноденствия</w> <w><ana lex="атмосфера" gr="S,f,inan,nom,norm,sg" sem="t:space r:concr t:stuff pt:part pc:space" sem2="t:unit r:abstr"/>атмосфера</w> <w><ana lex="успокоиться" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="der:v ca:noncaus d:pref t:psych" sem2="der:v ca:noncaus d:pref"/>успокоится</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="весна" gr="S,f,inan,nom,norm,sg" sem="t:time:season r:abstr t:time" sem2=""/>весна</w> <w><ana lex="пойти" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/>пойдет</w> <w><ana lex="вперед" gr="ADV,norm" sem="der:s t:dir" sem2=""/>вперед</w> <w><ana lex="много" gr="ADV,comp,norm" sem="t:quant:max r:spec" sem2="t:degr:max"/><ana lex="более" gr="ADV,norm" sem="t:degr:max der:adv" sem2="t:degr:max"/>более</w> <w><ana lex="быстрый" gr="A,ins,norm,pl,plen" sem="t:speed:max r:qual" sem2=""/>быстрыми</w> <w><ana lex="шаг" gr="S,inan,ins,m,norm,pl" sem="t:move pt:qtm r:abstr pc:move" sem2="t:move pt:phase r:abstr der:v t:asp:move t:param"/>шагами</w>.</se></p>
<p><se><w><ana lex="весна" gr="S,f,inan,nom,norm,sg" sem="t:time:season r:abstr t:time" sem2=""/>Весна</w>, <w><ana lex="весна" gr="S,f,inan,nom,norm,sg" sem="t:time:season r:abstr t:time" sem2=""/>весна</w>!</se><se> <w><ana lex="любить" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="ca:noncaus t:psych:emot d:root" sem2="d:root"/>Люблю</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="бесконечно" gr="ADV,norm" sem="dt:time:dur t:degr:max der:a" sem2=""/>бесконечно</w> <w><ana lex="твой" gr="APRO,acc,f,norm,sg" sem="r:poss" sem2=""/>твою</w> <w><ana lex="молодой" gr="A,acc,f,norm,plen,sg" sem="t:time:age r:qual" sem2="t:time:age r:qual"/>молодую</w> <w><ana lex="прелесть" gr="S,acc,f,inan,norm,sg" sem="ev:posit r:abstr" sem2="ev:posit sc:partb r:abstr pt:aggr:aggrpl ev r:concr"/>прелесть</w>!</se><se> <w><ana lex="идти" gr="V,2p,act,imper,intr,ipf,norm,sg" sem="ca:noncaus t:move d:root" sem2="ca:noncaus t:move d:root"/>Иди</w> <w><ana lex="скорый" gr="A,comp,norm,plen" sem="t:speed:max r:qual" sem2="r:qual"/>скорее</w>!</se><se> <w><ana lex="богдо" gr="ADV,bastard" sem="" sem2=""/>Богдо-ула</w> <w><ana lex="сумрачный" gr="A,brev,f,norm,sg" sem="der:s t:physq:color dt:light r:qual" sem2="dt:light t:humq der:s ev:neg r:qual"/>сумрачна</w>, <w><ana lex="вершина" gr="S,f,inan,nom,norm,sg" sem="t:fam r:concr pc:x pt:part der:s" sem2=""/>вершина</w> <w><ana lex="покрыть" gr="V,brev,f,norm,partcp,pass,pf,praet,sg" sem="d:pref" sem2="d:pref"/>покрыта</w> <w><ana lex="кочевой" gr="A,ins,n,norm,plen,sg" sem="der:v r:rel dt:move" sem2=""/>кочевым</w> <w><ana lex="облако" gr="S,inan,ins,n,norm,sg" sem="qc:stuff r:concr" sem2="qc:stuff pt:qtm top:form r:concr"/>облаком</w>, <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="скат" gr="S,inan,loc,m,norm,pl" sem="t:animal:fish der:v pc:constr pt:part pc:part pc:space r:concr" sem2="pc:tool:transp r:concr pt:part"/><ana lex="скат" gr="S,anim,loc,m,norm,pl" sem="" sem2=""/>скатах</w> <w><ana lex="крутить" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="ca:caus t:move d:root" sem2="d:root"/>крутит</w> <w><ana lex="пурга" gr="S,f,inan,nom,norm,sg" sem="r:abstr t:weather" sem2=""/>пурга</w>, <w><ana lex="ветер" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>ветер</w>, <w>конечно</w>, <w><ana form="юго-восточный" lex="юго-восточный" gr="A,m,nom,norm,plen,sg" sem="t:place der:comp r:rel dt:space" sem2=""/>юго-восточный</w>, <w><ana lex="нести" gr="V,act,ipf,m,nom,norm,partcp,plen,praes,sg,tran" sem="ca:caus t:move d:root" sem2="t:move d:root ca:caus t:speech ev:neg ca:noncaus"/>несущий</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="течение" gr="S,acc,inan,n,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="qc:stuff der:v t:move r:concr r:abstr"/>течение</w> <w><ana lex="весь" gr="APRO,gen,m,norm,sg" sem="r:spec" sem2=""/>всего</w> <w><ana lex="год" gr="S,gen,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:age r:abstr"/>года</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="урга" gr="S,acc,f,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Ургу</w> <w><ana lex="осадка" gr="S,f,gen,inan,norm,sg" sem="t:move r:abstr" sem2="r:abstr t:param"/>осадки</w>.</se></p>
<p><se><w><ana lex="для" gr="PR,norm" sem="" sem2=""/>Для</w> <w><ana lex="равноденствие" gr="S,gen,inan,n,norm,sg" sem="r:abstr t:time" sem2=""/>равноденствия</w>, <w><ana lex="как" gr="ADVPRO,norm" sem="r:rel t:manner" sem2=""/>как</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="следовать" gr="V,act,indic,ipf,n,norm,praet,sg" sem="ca:noncaus t:move der:s" sem2="ca:noncaus t:move der:s"/>следовало</w> <w><ana lex="ожидать" gr="V,act,inf,ipf,norm,tran" sem="der:v d:pref" sem2=""/>ожидать</w>, <w><ana lex="день" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w> <w><ana lex="плохой" gr="A,0,norm,plen" sem="ev:neg t:quality r:qual" sem2="t:degr:min ev:neg t:quality r:qual"/>плохой</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="холодный" gr="A,ins,m,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодным</w> <w><ana lex="северный" gr="A,ins,m,norm,plen,sg" sem="t:place dt:space r:rel der:s" sem2=""/>северным</w> <w><ana lex="ветер" gr="S,inan,ins,m,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>ветром</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="гора" gr="S,f,inan,loc,norm,pl" sem="top:hill t:space r:concr" sem2="sc:x pt:set t:space t:form r:abstr t:quant:max r:concr"/>горах</w> <w><ana lex="что" gr="SPRO,acc,inan,n,norm,sg" sem="r:rel" sem2=""/><ana form="что-то" lex="что-то" gr="SPRO,acc,inan,n,norm,sg" sem="r:indet" sem2=""/>что-то</w> <w><ana lex="ужасный" gr="A,acc,n,norm,plen,sg" sem="dt:abstr dt:psych:emot der:s r:qual" sem2="dt:psych:emot dt:abstr r:qual t:degr:max:magn der:s ev:neg t:quality"/>ужасное</w>: <w><ana lex="дуть" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="ca:noncaus d:root t:weather" sem2="d:root"/>дует</w>, <w><ana lex="плевать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:physiol d:root" sem2="d:root"/>плюет</w>, <w><ana lex="горизонт" gr="S,inan,m,nom,norm,sg" sem="t:space r:concr" sem2="t:ment t:space qc:stuff pt:qtm r:abstr pt:aggr r:concr"/>горизонт</w> <w><ana lex="короткий" gr="A,m,nom,norm,plen,sg" sem="t:size:min r:qual" sem2="t:behav ev:posit t:size:min t:time:dur:min r:qual"/>короткий</w>.</se></p>
<p><se><w><ana lex="мой" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>Мой</w> <w><ana lex="пшевик" gr="S,anim,bastard,m,nom,sg" sem="" sem2=""/>Пшевик</w> <w><ana lex="укатить" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="укатить" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/>укатил</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="сангина" gr="S,f,gen,inan,norm,pl" sem="" sem2=""/>Сангин</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="три" gr="NUM,acc,inan,norm" sem="r:card:pauc" sem2=""/>три</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дня</w> <w><ana lex="понаблюдать" gr="V,act,inf,norm,pf,tran" sem="d:pref t:perc" sem2=""/>понаблюдать</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="птичка" gr="S,f,inan,ins,norm,pl" sem="" sem2="t:sign r:concr"/><ana lex="птичка" gr="S,anim,f,ins,norm,pl" sem="t:hum ev r:concr der:s d:dim" sem2=""/>птичками</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="проч" gr="S,anim,bastard,m,nom,sg" sem="" sem2=""/><ana lex="проча" gr="S,bastard,f,gen,inan,pl" sem="" sem2=""/>проч</w>.</se><se> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>Я</w> <w><ana lex="гулять" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="ca:noncaus t:move d:root" sem2="d:root"/>гулял</w> <w><ana lex="вдоль" gr="PR,norm" sem="" sem2=""/>вдоль</w> <w><ana lex="еще" gr="ADV,norm" sem="" sem2=""/>еще</w> <w><ana lex="спящий" gr="A,f,gen,norm,plen,sg" sem="" sem2=""/>спящей</w> <w><ana lex="долина" gr="S,f,gen,inan,norm,sg" sem="t:space r:concr der:s t:fam" sem2=""/>долины</w> <w><ana lex="тола" gr="S,f,gen,inan,norm,sg" sem="" sem2=""/>Толы</w>.</se><se> <w><ana lex="ветер" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>Ветер</w>, <w>неприятно</w>.</se><se> <w><ana lex="вечер" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечером</w> <w><ana lex="долго" gr="ADV,norm" sem="t:time:dur:max dt:time:dur:max der:a" sem2=""/>долго</w> <w><ana lex="читать" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="d:root" sem2="d:root"/>читал</w> «<w><ana lex="архив" gr="S,inan,m,nom,norm,sg" sem="r:concr t:org" sem2="pc:org t:org pt:set pt:part r:concr sc:text"/>Архив</w> <w><ana lex="революция" gr="S,f,gen,inan,norm,sg" sem="r:abstr" sem2="r:abstr"/>революции</w>».</se><se> <w><ana lex="опять" gr="ADV,norm" sem="" sem2=""/>Опять</w> <w><ana lex="вставать" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v d:pref d:impf t:move:body" sem2=""/>встают</w> <w><ana lex="мрачный" gr="A,nom,norm,pl,plen" sem="dt:light dt:neg t:physq:light dt:abstr der:s r:qual" sem2="dt:light dt:neg dt:abstr ev:neg der:s r:qual t:psych:emot"/>мрачные</w>, <w><ana lex="кошмарный" gr="A,nom,norm,pl,plen" sem="ev r:rel der:s" sem2="ev:neg t:quality der:s r:qual"/>кошмарные</w> <w><ana lex="картина" gr="S,anim,f,famn,nom,norm,pl" sem="" sem2=""/><ana lex="картина" gr="S,f,inan,nom,norm,pl" sem="r:concr t:workart" sem2="pc:workdram t:text r:abstr t:workart t:perc pt:part t:workcin r:concr"/>картины</w>, <w><ana lex="словно" gr="CONJ,norm" sem="" sem2=""/>словно</w> <w><ana lex="вчера" gr="ADV,norm" sem="t:time" sem2=""/>вчера</w> <w><ana lex="весь" gr="APRO,n,nom,norm,sg" sem="r:spec" sem2=""/>все</w> <w><ana lex="это" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>это</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w>.</se></p>
<p><se><w><ana lex="мой" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>Мои</w> <w><ana lex="друг" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr" sem2="t:hum r:concr"/>друзья</w> <w><ana lex="бадмажапов" gr="S,anim,bastard,famn,m,nom,pl" sem="t:hum r:propn t:famn" sem2=""/>Бадмажаповы</w> <w><ana lex="все" gr="ADV,norm" sem="" sem2=""/>все</w> <w><ana lex="разъезжать" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="разъезжать" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/>разъезжают</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="гость" gr="S,anim,dat,m,norm,pl" sem="t:hum r:concr" sem2="t:hum der:shift r:concr"/>гостям</w>.</se><se> <w><ana lex="вечер" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечером</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>были</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="чудный" gr="A,loc,m,norm,plen,sg" sem="dt:abstr ev:posit r:rel" sem2="dt:abstr ev:posit t:quality der:s r:qual"/><ana lex="чудной" gr="A,loc,m,norm,plen,sg" sem="dt:abstr t:humq ev:neg r:qual" sem2=""/>чудном</w> <w><ana lex="китайский" gr="A,loc,m,norm,plen,sg" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>китайском</w> <w><ana lex="обед" gr="S,inan,loc,m,norm,sg" sem="r:abstr" sem2="t:food sc:food r:abstr pt:aggr t:time r:concr"/>обеде</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="который" gr="APRO,gen,m,norm,sg" sem="r:rel t:ord" sem2=""/>которого</w> <w><ana lex="ида" gr="S,anim,f,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Ида</w> <w><ana lex="павловна" gr="S,anim,f,nom,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Павловна</w> <w><ana lex="привезти" gr="V,act,f,indic,norm,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2=""/>привезла</w> <w><ana lex="мы" gr="SPRO,1p,dat,norm,pl" sem="r:pers" sem2=""/>нам</w>, <w><ana lex="остаться" gr="V,act,ins,intr,m,norm,partcp,pf,plen,praet,sg" sem="t:loc d:pref ca:noncaus" sem2="t:be:exist ca:noncaus d:pref"/>оставшимся</w>, <w><ana lex="усладенька" gr="S,anim,bastard,f,gen,persn,pl" sem="" sem2=""/>усладенек</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="запивочка" gr="S,bastard,f,gen,inan,pl" sem="" sem2=""/>запивочек</w>.</se><se> <w><ana lex="чуткий" gr="A,f,nom,norm,plen,sg" sem="r:rel" sem2="ev:posit t:humq r:qual"/>Чуткая</w> <w><ana lex="женщина" gr="S,anim,f,nom,norm,sg" sem="t:hum r:concr" sem2=""/>женщина</w>!</se></p>
<p><se><b/><w><b>23</b></w><b>/</b><w><ana lex="iii" gr="bastard" sem="" sem2=""/><b>III</b></w><b>, </b><w><ana lex="q" gr="bastard" sem="" sem2=""/><b>Q</b></w><b/>. <w><ana lex="картина" gr="S,anim,f,famn,nom,norm,sg" sem="" sem2=""/><ana lex="картина" gr="S,f,inan,nom,norm,sg" sem="r:concr t:workart" sem2="pc:workdram t:text r:abstr t:workart t:perc pt:part t:workcin r:concr"/>Картина</w> <w><ana lex="словно" gr="CONJ,norm" sem="" sem2=""/>словно</w> <w><ana lex="зимний" gr="A,f,nom,norm,plen,sg" sem="dt:time dt:abstr dt:time:season der:s t:time r:rel" sem2=""/>зимняя</w>: <w>холодно</w>, <w>бело</w>, <w><ana lex="идти" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:move d:root" sem2="ca:noncaus t:move d:root"/>идет</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="падать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:move d:root" sem2="d:root"/>падает</w> <w><ana lex="снег" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2=""/>снег</w>, <w><ana lex="гонимый" gr="A,m,nom,norm,plen,sg" sem="der:v r:rel" sem2=""/>гонимый</w> <w>северо-северо-западным</w> <w><ana lex="ветер" gr="S,inan,ins,m,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>ветром</w>.</se><se> <w><ana lex="однако" gr="CONJ,norm" sem="" sem2=""/>Однако</w> <w><ana lex="весенний" gr="A,n,nom,norm,plen,sg" sem="dt:time dt:abstr dt:time:season der:s t:time r:rel" sem2=""/>весеннее</w> <w><ana lex="равноденствие" gr="S,inan,n,nom,norm,sg" sem="r:abstr t:time" sem2=""/>равноденствие</w> <w><ana lex="високосный" gr="A,gen,m,norm,plen,sg" sem="r:rel" sem2=""/>високосного</w> <w><ana lex="год" gr="S,gen,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:age r:abstr"/>года</w> <w><ana lex="давать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="der:v ca:caus d:impf t:poss d:root" sem2="der:v d:root d:impf"/>дает</w> <w><ana lex="себе" gr="SPRO,acc,norm" sem="" sem2=""/>себя</w> <w><ana lex="чувствовать" gr="V,act,inf,ipf,norm,tran" sem="ca:noncaus t:perc der:s" sem2="der:s"/>чувствовать</w>!</se></p>
<p><se><w><ana lex="бедный" gr="A,nom,norm,pl,plen" sem="r:qual" sem2="r:qual"/>Бедные</w> <w><ana lex="мой" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>мои</w> <w><ana lex="археолог" gr="S,anim,m,nom,norm,pl" sem="der:comp t:hum r:concr t:prof" sem2=""/>археологи</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="бедный" gr="A,m,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>бедный</w> <w><ana lex="пшевик" gr="S,anim,bastard,m,nom,sg" sem="" sem2=""/>Пшевик</w>: <w><ana lex="ни" gr="PART,norm" sem="" sem2=""/>ни</w> <w><ana lex="копать" gr="V,act,inf,ipf,norm,tran" sem="t:impact ca:caus d:root" sem2="d:root"/>копать</w>, <w><ana lex="ни" gr="CONJ,norm" sem="" sem2=""/>ни</w> <w><ana lex="наблюдать" gr="V,act,inf,ipf,norm,tran" sem="ca:noncaus d:pref t:perc" sem2="d:pref"/>наблюдать</w>.</se><se> <w>Вероятно</w>, <w><ana lex="денек" gr="S,inan,m,nom,norm,sg" sem="d:dim t:time:period r:abstr der:s" sem2=""/>денек-другой</w> <w><ana lex="постоять" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="d:pref" sem2="t:loc:body ca:noncaus d:pref"/>постоит</w> <w><ana lex="мразь" gr="S,f,inan,nom,norm,sg" sem="" sem2="t:thing r:concr ev:neg"/><ana lex="мразь" gr="S,anim,f,nom,norm,sg" sem="pt:ind sc:hum pt:aggr ev:neg t:hum r:concr" sem2=""/>мразь</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="затем" gr="ADV,norm" sem="der:apro t:time r:dem" sem2=""/>затем</w> <w><ana lex="настать" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="d:pref" sem2=""/>настанет</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="приятный" gr="A,acc,n,norm,plen,sg" sem="ev:posit r:qual" sem2="ev:posit t:humq r:qual"/>приятное</w>, <w><ana lex="радостный" gr="A,acc,n,norm,plen,sg" sem="dt:psych:emot ev:posit t:psych:emot der:s r:qual" sem2="dt:psych:emot ev:posit t:psych:emot der:s r:qual"/>радостное</w> <w><ana lex="просветление" gr="S,acc,inan,n,norm,sg" sem="der:v t:changest r:abstr der:s0 t:light" sem2="t:ment ev:posit r:abstr"/>просветление</w>.</se></p>
<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="иметься" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="ca:noncaus t:poss" sem2=""/>имелось</w> <w><ana lex="большой" gr="A,n,nom,norm,plen,sg" sem="t:size:max r:qual" sem2="t:quant:max t:time:age t:degr:max r:qual"/>большое</w> <w><ana lex="желание" gr="S,inan,n,nom,norm,sg" sem="t:psych:volit r:abstr" sem2="r:abstr"/>желание</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="оба" gr="NUM,f,gen,norm" sem="r:card:pauc" sem2=""/>обеих</w> <w><ana lex="сторона" gr="S,f,gen,inan,norm,pl" sem="t:space r:concr pt:part pc:space" sem2="sc:hum t:space t:asp:ment r:abstr pt:set pc:x pt:part pc:space r:concr pc:form:geom"/>сторон</w>, <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="я" gr="SPRO,1p,gen,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="кондратьев" gr="S,anim,famn,gen,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Кондратьева</w>, <w><ana lex="поговорить" gr="V,act,inf,intr,norm,pf" sem="t:speech ca:noncaus d:pref" sem2=""/>поговорить</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="никак" gr="ADVPRO,PARENTH,norm" sem="der:advpro r:neg t:manner" sem2="der:advpro r:neg"/>никак</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="мочь" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="d:root" sem2=""/>мог</w> <w><ana lex="добиться" gr="V,act,inf,intr,norm,pf" sem="ca:noncaus d:pref" sem2=""/>добиться</w>, <w>несмотря</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="любезность" gr="S,acc,f,inan,norm,sg" sem="t:humq r:abstr der:a" sem2="t:speech ev:posit r:abstr der:a"/>любезность</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="предупредительность" gr="S,acc,f,inan,norm,sg" sem="r:abstr der:a" sem2=""/>предупредительность</w> <w>г</w