<p><se><w><ana lex="под" gr="PR,norm" sem="" sem2=""/>Под</w> <w><ana lex="вечер" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>вечер</w> <w><ana lex="впервые" gr="ADV,norm" sem="dt:ord der:anum" sem2=""/>впервые</w> <w><ana lex="наблюдаться" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref"/>наблюдались</w> <w><ana lex="пролетный" gr="A,ins,norm,pl,plen" sem="der:v r:rel dt:move" sem2="dt:move dt:space der:v der:s:deverb t:place r:rel"/>пролетными</w> <w><ana lex="даурский" gr="A,nom,norm,pl,plen" sem="r:rel der:s" sem2=""/>даурские</w> <w><ana lex="галка" gr="S,anim,f,nom,norm,pl" sem="t:animal t:persn d:dimb r:propn der:s t:hum r:concr" sem2=""/><ana lex="галка" gr="S,anim,f,nom,norm,persn,pl" sem="t:animal t:persn d:dimb r:propn der:s t:hum r:concr" sem2=""/>галки</w>, <w><ana lex="большой" gr="A,0,norm,plen" sem="t:size:max r:qual" sem2="t:quant:max t:time:age t:degr:max r:qual"/>большой</w> <w><ana lex="стая" gr="S,f,inan,ins,norm,sg" sem="pt:set r:concr sc:animal" sem2=""/>стаей</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="500" gr="NUM,ciph"/>500</w> <w><ana lex="особь" gr="S,anim,f,gen,norm,pl" sem="" sem2=""/>особей</w>, <w><ana lex="направляться" gr="V,act,intr,ipf,nom,norm,partcp,pl,plen,praet" sem="der:v d:pref" sem2=""/><ana lex="направлявшийся" gr="V,act,intr,ipf,nom,norm,partcp,pl,plen,praet" sem="" sem2=""/>направлявшиеся</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="восток" gr="S,gen,inan,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr pt:part pc:space"/>востока</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="запад" gr="S,dat,inan,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr pt:part pc:space"/>западу</w> <w><ana lex="вдоль" gr="PR,norm" sem="" sem2=""/>вдоль</w> <w><ana lex="долина" gr="S,f,gen,inan,norm,sg" sem="t:space r:concr der:s t:fam" sem2="