<p><se><w><ana lex="вечер" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечер</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="мы" gr="SPRO,1p,ins,norm,pl" sem="r:pers" sem2=""/>нами</w> <w><ana lex="провести" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="провести" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="проводить" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:caus t:move d:pref" sem2="d:pref"/>провел</w> <w>И</w>. <w>Г</w>. <w><ana lex="салтыков" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Салтыков</w>, <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="милый" gr="A,brev,n,norm,sg" sem="t:humq r:qual" sem2="ev:posit t:social:emot r:qual"/>мило</w>, <w>непринужденно</w>, <w><ana lex="играть" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="d:root" sem2="d:root"/>играли</w>, <w><ana lex="танцевать" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="der:s" sem2=""/>танцевали</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="даже" gr="PART,norm" sem="" sem2=""/>даже</w> <w><ana lex="выпить" gr="V,act,indic,norm,pf,pl,praet" sem="ca:caus t:physiol d:pref" sem2="d:pref"/><ana lex="выпить" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:caus t:physiol d:pref" sem2="d:pref"/>выпили</w> <w><ana lex="шампанское" gr="S,gen,inan,n,norm,sg" sem="t:food der:subst t:stuff der:a t:liq hi:sort r:concr" sem2=""/>шампанского</w>.</se><se> <w><ana lex="лично" gr="ADV,norm" sem="der:a" sem2=""/>Лично</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="всегда" gr="ADVPRO,norm" sem="r:spec t:time" sem2=""/>всегда</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="удовольствие" gr="S,inan,ins,n,norm,sg" sem="t:psych:emot r:abstr