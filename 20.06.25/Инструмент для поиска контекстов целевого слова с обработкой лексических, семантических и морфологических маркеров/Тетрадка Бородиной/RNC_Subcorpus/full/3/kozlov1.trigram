em2=""/>или</w> <w><ana lex="косуля" gr="S,acc,anim,f,norm,pl" sem="t:animal r:concr" sem2=""/>косуль</w>, <w><ana lex="волк" gr="S,acc,anim,m,norm,pl" sem="t:animal r:concr" sem2=""/>волков</w>, <w><ana lex="лисица" gr="S,acc,anim,f,norm,pl" sem="t:animal d:fem r:concr der:s" sem2="t:hum r:concr der:s ev:neg"/>лисиц</w>, <w><ana lex="заяц" gr="S,acc,anim,m,norm,pl" sem="t:animal r:concr" sem2="t:hum r:concr ev:neg"/>зайцев</w>, <w>говорят</w>, <w><ana lex="бывать" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="t:be:exist ca:noncaus der:v d:impf" sem2="der:v t:loc der:shift d:impf ca:noncaus"/>бывают</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="медведь" gr="S,anim,m,nom,norm,pl" sem="t:animal r:concr" sem2=""/>медведи</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="птица" gr="S,anim,f,gen,norm,pl" sem="t:animal r:concr hi:class" sem2=""/>птиц</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="редкий" gr="A,brev,m,norm,sg" sem="t:physq r:qual" sem2="t:time t:dist r:qual"/>редок</w> <w><ana lex="интересный" gr="A,m,nom,norm,plen,sg" sem="dt:abstr der:s dt:ment r:qual" sem2="dt:abstr ev:posit der:s dt:ment r:qual"/>интересный</w> <w><ana lex="алтайский" gr="A,m,nom,norm,plen,sg" sem="dt:topon r:rel der:s t:topon" sem2=""/>алтайский</w> <w><ana lex="улар" gr="S,anim,m,nom,norm,sg" sem="" sem2=""/>улар</w> (<w><ana lex="tetraogallus" gr="bastard" sem="" sem2=""/>Tetraogallus</w> <w><ana lex="altaicus" gr="bastard" sem="" sem2=""/>altaicus</w>).</se><se> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>Я</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="радостно" gr="ADV,norm" sem="dt:psych:emot ev:posit der:a" sem2=""/>радостно</w> <w><ana lex="приветствовать" gr="V,1p,act,fut,indic,norm,pf,sg,tran" sem="d:pref der:s" sem2="d:pref der:s"/><ana lex="приветствовать" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="d:pref der:s" sem2="d:pref der:s"/>приветствую</w> <w><ana lex="этот" gr="APRO,acc,inan,m,norm,sg" sem="r:dem" sem2=""/>этот</w> <w><ana lex="проект" gr="S,acc,inan,m,norm,sg" sem="t:ment r:abstr" sem2="t:ment t:pattern r:concr t:text r:abstr"/>проект</w>.</se><se> <w><ana lex="основаться" gr="V,act,ger,intr,norm,pf,praet" sem="der:v ca:noncaus d:pref t:be:appear" sem2="der:v ca:noncaus d:pref"/>Основавшись</w> <w><ana lex="база" gr="S,f,inan,ins,norm,sg" sem="pc:constr r:concr pt:part" sem2="r:concr r:abstr pt:part t:org"/>базою</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="долина" gr="S,f,inan,loc,norm,sg" sem="t:space r:concr der:s t:fam" sem2=""/>долине</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="лучший" gr="A,loc,m,norm,sg,supr" sem="d:super ev:posit der:a t:quality r:qual" sem2=""/>лучшем</w> <w><ana lex="кормный" gr="A,loc,m,norm,plen,sg" sem="r:rel der:s" sem2=""/>кормном</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="защитить" gr="V,loc,m,norm,partcp,pass,pf,plen,praet,sg" sem="d:pref" sem2="d:pref"/>защищенном</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="ветер" gr="S,gen,inan,m,norm,pl" sem="r:abstr t:weather" sem2="t:fam"/>ветров</w> <w><ana lex="место" gr="S,inan,loc,n,norm,sg" sem="qc:space t:space r:concr" sem2="qc:space sc:org t:tool t:space pt:element r:abstr pt:aggr:aggrpl pt:part pc:text r:concr"/>месте</w>, <w>можно</w> <w><ana lex="совершить" gr="V,act,inf,norm,pf" sem="d:pref" sem2="d:pref"/>совершить</w> <w><ana lex="ряд" gr="S,acc,inan,m,norm,sg" sem="pt:set sc:x r:concr r:abstr" sem2="sc:x sc:hum t:form r:abstr pt:set pt:aggr sc:constr r:concr"/>ряд</w> <w><ana lex="географический" gr="A,gen,norm,pl,plen" sem="r:rel der:s" sem2=""/>географических</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="зоологический" gr="A,gen,norm,pl,plen" sem="r:rel der:s" sem2="r:rel der:s"/>зоологических</w> <w><ana lex="экскурсия" gr="S