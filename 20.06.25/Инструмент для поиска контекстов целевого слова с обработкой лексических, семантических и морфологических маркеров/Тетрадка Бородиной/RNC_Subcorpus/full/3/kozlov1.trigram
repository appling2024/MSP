<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="рука" gr="S,f,gen,inan,norm,pl" sem="pt:partb r:concr pc:hum" sem2="sc:hum t:asp r:abstr pt:aggr:aggrpl t:dir r:concr"/>рук</w> <w><ana lex="вон" gr="PART,norm" sem="" sem2=""/>вон</w> <w><ana lex="бурный" gr="A,f,nom,norm,plen,sg" sem="dt:weather dt:abstr der:s r:qual" sem2="dt:weather dt:abstr t:degr:max:magn der:s t:degr:max r:qual"/>бурная</w> <w><ana lex="погода" gr="S,f,inan,nom,norm,sg" sem="r:abstr t:weather" sem2=""/>погода</w>, <w><ana lex="ветреный" gr="A,f,nom,norm,plen,sg" sem="r:rel der:s d:habit" sem2="t:humq der:s ev:neg r:qual"/>ветреная</w>, <w><ana lex="облачный" gr="A,f,nom,norm,plen,sg" sem="r:rel der:s" sem2="t:physq r:rel der:s"/>облачная</w>, <w><ana lex="мрачный" gr="A,nom,norm,pl,plen" sem="dt:light dt:neg t:physq:light dt:abstr der:s r:qual" sem2="dt:light dt:neg dt:abstr ev:neg der:s r:qual t:psych:emot"/>мрачные</w> <w><ana lex="туча" gr="S,f,inan,nom,norm,pl" sem="qc:stuff top:form r:concr" sem2="t:quant:max pt:qtm r:concr r:abstr"/>тучи</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="отдельный" gr="A,nom,norm,pl,plen" sem="r:rel" sem2="r:rel"/>отдельные</w> <w><ana lex="слоистый" gr="A,nom,norm,pl,plen" sem="t:physq d:habit der:s r:qual" sem2=""/>слоистые</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="кучевой" gr="A,nom,norm,pl,plen" sem="r:rel der:s" sem2=""/>кучевые</w> <w><ana lex="облако" gr="S,inan,n,nom,norm,pl" sem="qc:stuff r:concr" sem2="qc:stuff pt:qtm top:form r:concr"/>облака</w> <w><ana lex="напоминать" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="t:ment ca:caus der:v d:pref" sem2="der:v d:pref"/>напоминали</w> <w>таковые</w> <w><ana lex="лето" gr="S,inan,ins,n,norm,sg" sem="t:time:season r:abstr t:time" sem2=""/>летом</w>, <w><ana lex="во" gr="PR,norm" sem="" sem2=""/>во</w> <w><ana lex="время" gr="S,acc,inan,n,norm,sg" sem=