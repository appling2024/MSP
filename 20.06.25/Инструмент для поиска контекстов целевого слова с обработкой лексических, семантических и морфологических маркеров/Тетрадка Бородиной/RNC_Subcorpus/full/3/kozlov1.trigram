<p><se><w><ana lex="последний" gr="A,ins,m,norm,plen,sg" sem="r:rel t:ord" sem2="t:degr:max:magn r:qual r:rel ev:neg t:time"/>Последним</w> <w><ana lex="попутный" gr="A,ins,m,norm,plen,sg" sem="dt:space r:rel der:s t:dir" sem2="dt:space r:rel der:s t:time"/>попутным</w> <w><ana lex="предложение" gr="S,inan,ins,n,norm,sg" sem="t:speech der:v r:abstr der:s0" sem2="t:speech r:abstr"/>предложением</w> <w><ana lex="мой" gr="APRO,dat,norm,pl" sem="r:poss" sem2=""/>моим</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w>: «<w><ana lex="скорейший" gr="A,gen,n,norm,sg,supr" sem="t:speed:max dt:speed:max der:a d:super r:qual" sem2=""/>Скорейшего</w> <w><ana lex="создание" gr="S,gen,n,norm,sg" sem="der:v r:abstr der:s0 t:impact:creat" sem2="t:text t:hum:supernat t:workdram t:workmus t:workart der:v t:workcin r:concr"/><ana lex="создание" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0 t:impact:creat" sem2="t:text t:hum:supernat t:workdram t:workmus t:workart der:v t:workcin r:concr"/><ana lex="создание" gr="S,anim,gen,n,norm,sg" sem="" sem2=""/>создания</w> <w><ana lex="национальный" gr="A,gen,n,norm,plen,sg" sem="dt:set r:rel der:s" sem2="dt:set r:rel der:s"/>национального</w> <w><ana lex="художественный" gr="A,gen,n,norm,plen,sg" sem="r:rel der:s" sem2="ev:posit r:rel"/>художественного</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="потом" gr="ADVPRO,norm" sem="t:time" sem2=""/>потом</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="естественно" gr="PART,norm" sem="" sem2=""/>естественно-исторического</w> <w><ana lex="музей" gr="S,gen,inan,m,norm,sg" sem="r:concr t:org" sem2=""/>музея</w>».</se><se> <w><ana lex="ведь" gr="PART,norm" sem="" sem2=""/>Ведь</w> <w><ana form="как-никак" lex="как-никак" gr="ADV,norm" sem="" sem2=""/>как-никак</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="человек" gr="S,anim,m,nom,norm,sg" sem="t