<p><se> <b/><w><b>18</b></w><b>/</b><w><ana lex="x" gr="bastard" sem="" sem2=""/><b>X</b></w><b>, </b><w><ana lex="v" gr="bastard" sem="" sem2=""/><b>V</b></w><b/>. <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w> <w><ana lex="серый" gr="A,n,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>серое</w>, <w><ana lex="сплошь" gr="ADV,norm" sem="dt:degr:max der:a" sem2=""/>сплошь</w> <w><ana lex="облачный" gr="A,n,nom,norm,plen,sg" sem="r:rel der:s" sem2="t:physq r:rel der:s"/>облачное</w>.</se><se> <w><ana lex="воздух" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>Воздух</w> <w><ana lex="то" gr="SPRO,inan,ins,n,norm,sg" sem="r:dem" sem2=""/>тем</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="менее" gr="ADV,norm" sem="t:degr:min der:adv" sem2="t:degr:min der:adv"/>менее</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="холодный" gr="A,m,nom,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодный</w>; <w><ana lex="серый" gr="A,f,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>серая</w> <w><ana lex="обстановка" gr="S,f,inan,nom,norm,sg" sem="der:v pt:aggr sc:tool:furn r:concr" sem2="r:abstr"/>обстановка</w> <w><ana lex="удручать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="d:pref" sem2=""/>удручает</w>.</se><se> <w><ana lex="получить" gr="V,brev,n,norm,partcp,pass,pf,praet,sg" sem="ca:noncaus t:poss" sem2=""/>Получено</w> <w><ana lex="сведение" gr="S,inan,n,nom,norm,sg" sem="t:ment r:abstr" sem2="t:speech t:ment r:abstr"/>сведение</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="около" gr="PR,norm" sem="" sem2=""/>около</w