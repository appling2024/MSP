<p><se><w>Тяжело</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="прощание" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr der:s0" sem2="t:speech r:abstr"/>прощание</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="дочь" gr="S,anim,f,ins,norm,sg" sem="" sem2="t:hum r:concr"/>дочерью</w> <w><ana lex="олечка" gr="S,anim,f,ins,norm,persn,sg" sem="dt:persn t:persn d:dimb r:propn der:s t:hum" sem2=""/>Олечкой</w>, <w><ana lex="который" gr="APRO,f,nom,norm,sg" sem="r:rel t:ord" sem2=""/>которая</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="расплакаться" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v ca:noncaus t:physiol d:pref" sem2=""/>расплакалась</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="заставить" gr="V,act,f,indic,norm,pf,praet,sg" sem="d:pref" sem2="d:pref"/>заставила</w> <w><ana lex="то" gr="SPRO,acc,inan,n,norm,sg" sem="r:dem" sem2=""/>то</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w> <w><ana lex="сделать" gr="V,act,inf,norm,pf,tran" sem="d:pref" sem2=""/>сделать</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="я" gr="SPRO,1p,acc,norm,sg" sem="r:pers" sem2=""/>меня</w>!</se><se> <w><ana lex="она" gr="SPRO,3p,f,nom,norm,sg" sem="r:pers" sem2=""/>Она</w>, <w><ana lex="как" gr="ADVPRO,norm" sem="r:rel t:manner" sem2=""/>как</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w>, <w><ana lex="как" gr="CONJ,norm" sem="" sem2=""/>как</w> <w><ana lex="она" gr="SPRO,3p,f,nom,norm,sg" sem="r:pers" sem2=""/>она</w>, <w><ana lex="впечатлительный" gr="A,brev,norm,pl" sem="der:v t:humq r:qual" sem2=""/>впечатлительны</w>!</se></p>
<p><se><w><ana lex="на" gr="PR,norm" sem="" sem2=""/>На</w> <w><ana lex="вокзал" gr="S,inan,loc,m,norm,sg" sem="top:contain t:constr r:concr" sem2=""/>вокзале</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="вагон" gr="S,gen,inan,m,norm,sg" sem="t:tool:transp r:concr pt:part pc:tool:transp" sem2=""/>вагона</w> <w><ana lex="узко" gr="ADV,comp,norm" sem="dt:size:min der:a" sem2="dt:size:min der:a"/><ana lex="уже" gr="ADV,norm" sem="t:time" sem2=""/>уже</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>были</w>, <w><ana lex="главный" gr="A,ins,m,norm,plen,sg" sem="t:hier r:qual" sem2="t:hier r:qual"/>главным</w> <w><ana lex="образ" gr="S,inan,ins,m,norm,sg" sem="t:ment r:concr r:abstr t:workart" sem2="t:asp r:abstr"/>образом</w>, <w><ana lex="вчерашний" gr="A,nom,norm,pl,plen" sem="der:adv r:rel t:time" sem2="der:adv r:rel t:time"/>вчерашние</w> (<w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="географический" gr="A,dat,n,norm,plen,sg" sem="r:rel der:s" sem2=""/>Географическому</w> <w><ana lex="общество" gr="S,dat,inan,n,norm,sg" sem="sc:hum pt:aggr r:concr" sem2="sc:hum pt:aggr r:concr t:org r:abstr"/>обществу</w>), <w><ana lex="плюс" gr="CONJ,norm" sem="" sem2=""/>плюс</w> <w><ana lex="новый" gr="A,nom,norm,pl,plen" sem="t:time r:qual" sem2="t:time r:qual"/>новые</w> <w><ana lex="наш" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>наши</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="пшевочка" gr="S,anim,bastard,f,ins,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/><ana lex="пшевочка" gr="S,anim,bastard,f,ins,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/><ana lex="пшевочка" gr="S,bastard,f,inan,ins,sg" sem="" sem2=""/>Пшевочкой</w> <w><ana lex="друг" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr" sem2="t:hum r:concr"/>друзья</w>, <w><ana lex="родные" gr="S,anim,nom,norm,pl" sem="" sem2=""/>родные</w> <w><ana lex="мой" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/>моих</w> <w><ana lex="спутник" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,gen,inan,m,norm,pl" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутников</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="проч" gr="S,anim,bastard,m,nom,sg" sem="" sem2=""/><ana lex="проча" gr="S,bastard,f,gen,inan,pl" sem="" sem2=""/>проч</w>.</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w>общем</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="весьма" gr="ADV,norm" sem="t:degr:max" sem2=""/>весьма</w> <w><ana lex="симпатичный" gr="A,brev,n,norm,sg" sem="ev:posit t:appearance der:s dt:hum r:qual" sem2=""/>симпатично</w>.</se><se> <w><ana lex="цветок" gr="S,inan,m,nom,norm,pl" sem="der:v pc:plant r:concr pt:part" sem2="der:v d:dim t:plant r:concr hi:class"/>Цветы</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w>проч</w>.</se><se> <w><ana lex="чудный" gr="A,m,nom,norm,plen,sg" sem="dt:abstr ev:posit r:rel" sem2="dt:abstr ev:posit t:quality der:s r:qual"/>Чудный</w> <w><ana lex="букет" gr="S,inan,m,nom,norm,sg" sem="pt:set sc:plant r:concr" sem2="pt:set pt:qtm sc:workmus r:concr r:abstr"/>букет</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>был</w> <w><ana lex="поднести" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus t:move d:pref"/><ana lex="поднести" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus t:move d:pref"/>поднесен</w> <w><ana lex="пшевочка" gr="S,anim,bastard,dat,m,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Пшевочке</w> <w><ana lex="главный" gr="A,ins,m,norm,plen,sg" sem="t:hier r:qual" sem2="t:hier r:qual"/>Главным</w> <w><ana lex="ботанический" gr="A,ins,m,norm,plen,sg" sem="r:rel der:s" sem2=""/>ботаническим</w> <w><ana lex="сад" gr="S,inan,ins,m,norm,sg" sem="pt:set t:plot t:space r:concr sc:plant" sem2="t:space r:concr t:org t:fam"/>садом</w>.</se><se> <w><ana lex="мы" gr="SPRO,1p,acc,norm,pl" sem="r:pers" sem2=""/>Нас</w> <w><ana lex="фотографировать" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="der:s" sem2=""/>фотографировали</w>.</se><se> <w><ana lex="мы" gr="SPRO,1p,acc,norm,pl" sem="r:pers" sem2=""/>Нас</w> <w><ana lex="снимать" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="d:pref" sem2=""/>снимал</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="кинематограф" gr="S,inan,m,nom,norm,sg" sem="r:abstr" sem2="der:comp r:concr t:org"/>кинематограф</w>.</se><se> <w><ana lex="некоторые" gr="SPRO,nom,norm,pl" sem="r:indet" sem2=""/>Некоторые</w> <w><ana lex="плакать" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="ca:noncaus t:physiol d:root" sem2="ca:noncaus d:root"/>плакали</w>, <w><ana lex="некоторый" gr="APRO,nom,norm,pl" sem="r:indet" sem2=""/>некоторые</w> <w><ana lex="истый" gr="A,nom,norm,pl,plen" sem="t:degr r:qual" sem2=""/>истые</w> <w><ana lex="друг" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr" sem2="t:hum r:concr"/>друзья</w> <w><ana lex="бежать" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus t:move d:root" sem2="d:root"/><ana lex="бежать" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="ca:noncaus t:move d:root" sem2="d:root"/>бежали</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="поезд" gr="S,inan,ins,m,norm,sg" sem="sc:tool:transp t:tool:transp r:concr" sem2="pt:set sc:tool:transp r:concr"/>поездом</w>.</se><se> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>Я</w> <w><ana lex="успеть" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="d:pref" sem2="d:pref"/>успел</w> <w><ana lex="свидеться" gr="V,act,inf,intr,norm,pf" sem="ca:noncaus d:pref t:perc" sem2=""/>свидеться</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="мило" gr="ADV,norm" sem="ev:posit dt:humq der:a" sem2="ev:posit dt:humq der:a"/>мило</w> <w><ana lex="попрощаться" gr="V,act,inf,intr,norm,pf" sem="ca:noncaus d:pref" sem2=""/>попрощаться</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="женя" gr="S,anim,ins,norm,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Женей</w>.</se><se> <w><ana lex="быть" gr="V,act,f,indic,intr,ipf,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>Была</w> <w><ana lex="также" gr="PART,norm" sem="" sem2=""/>также</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w>В</w>. <w>А</w>. <w><ana lex="глищинский" gr="A,bastard,f,nom,plen,sg" sem="" sem2=""/><ana lex="глищинский" gr="A,bastard,f,nom,plen,sg" sem="" sem2=""/>Глищинская</w> -- <w><ana lex="мой" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/>моя</w> <w><ana lex="способнейший" gr="A,f,nom,norm,sg,supr" sem="der:a d:super r:qual" sem2=""/>способнейшая</w> <w><ana lex="ученица" gr="S,anim,f,nom,norm,sg" sem="t:hum d:fem r:concr der:s" sem2=""/>ученица</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="буддизм" gr="S,dat,inan,m,norm,sg" sem="r:abstr" sem2=""/>буддизму</w>!</se><se> <w><ana lex="весь" gr="APRO,nom,norm,pl" sem="r:spec" sem2=""/>Все</w> <w><ana lex="этот" gr="APRO,nom,norm,pl" sem="r:dem" sem2=""/>эти</w> <w><ana lex="чуткий" gr="A,nom,norm,pl,plen" sem="r:rel" sem2="ev:posit t:humq r:qual"/>чуткие</w> <w><ana lex="милый" gr="A,nom,norm,pl,plen" sem="t:humq r:qual" sem2="ev:posit t:social:emot r:qual"/>милые</w> <w><ana lex="человек" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr" sem2="t:hum ev:posit r:concr"/>люди</w>, <w><ana lex="близкий" gr="A,nom,norm,pl,plen" sem="t:dist:min r:qual" sem2="t:social:emot r:qual der:shift t:like t:time t:social"/>близкие</w> <w><ana lex="сердце" gr="S,dat,inan,n,norm,sg" sem="pc:hum pt:partb:organ r:concr pc:animal" sem2="t:sign pc:hum der:shift pt:partb:organ t:psych:emot r:concr"/>сердцу</w>, <w><ana lex="проводить" gr="V,act,i