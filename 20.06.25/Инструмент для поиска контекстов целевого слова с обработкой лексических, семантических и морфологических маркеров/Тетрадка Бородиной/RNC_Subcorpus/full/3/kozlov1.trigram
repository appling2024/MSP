<p><se><b/><w><b>16</b></w><b>/</b><w><ana lex="iii" gr="bastard" sem="" sem2=""/><b>III</b></w><b>, </b><w><ana lex="q" gr="bastard" sem="" sem2=""/><b>Q</b></w><b/>. <w><ana lex="прежний" gr="A,f,nom,norm,plen,sg" sem="r:rel t:time" sem2="r:rel t:time"/>Прежняя</w> <w><ana lex="отличный" gr="A,f,nom,norm,plen,sg" sem="der:v r:rel" sem2="ev:posit t:quality r:qual"/>отличная</w> <w><ana lex="погода" gr="S,f,inan,nom,norm,sg" sem="r:abstr t:weather" sem2=""/>погода</w> -- <w><ana lex="ясный" gr="A,f,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясная</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="нехолодный" gr="A,bastard,f,nom,plen,sg" sem="" sem2=""/>нехолодная</w>, <w><ana lex="ветер" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>ветер</w> <w><ana lex="переменный" gr="A,m,nom,norm,plen,sg" sem="der:s:deverb dt:abstr r:rel" sem2=""/>переменный</w>.</se><se> <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="предстоять" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="d:pref" sem2=""/>предстоит</w> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w> <w><ana lex="писательский" gr="A,f,nom,norm,plen,sg" sem="r:rel der:s dt:hum" sem2=""/>писательская</w> <w><ana lex="работа" gr="S,f,inan,nom,norm,sg" sem="der:v r:abstr" sem2="sc:x t:text t:workdram t:workmus r:abstr t:workart der:v pt:aggr t:workcin r:concr"/>работа</w>: <w><ana lex="комаров" gr="S,anim,dat,famn,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Комарову</w>, <w><ana lex="бялыницкий" gr="S,bastard,dat,inan,m,sg" sem="" sem2=""/>Бялыницкому-Бируле</w>, <w><ana lex="володя" gr="S,anim,dat,m,norm,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Володе</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="ор" gr="S,anim,dat,m,norm,persn,sg" sem="" sem2=""/><ana lex="ор" gr="S,dat,inan,m,norm,sg" sem="t:sound r:abstr" sem2=""/>Ору</w> <w><ana lex="собенников" gr="S,anim,bastard,dat,famn,m,sg"