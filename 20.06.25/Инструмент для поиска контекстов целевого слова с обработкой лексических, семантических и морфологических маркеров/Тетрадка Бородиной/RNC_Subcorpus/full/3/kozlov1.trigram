<p><se><w><ana lex="после" gr="PR,norm" sem="" sem2=""/>После</w> <w><ana lex="четыре" gr="NUM,gen,norm" sem="r:card:pauc" sem2=""/>четырех</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дня</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> (<w><ana lex="ида" gr="S,anim,f,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Ида</w> <w><ana lex="павловна" gr="S,anim,f,nom,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Павловна</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w>) <w><ana lex="все" gr="SPRO,nom,norm,pl" sem="" sem2=""/>все</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w> <w><ana lex="успеть" gr="V,act,indic,intr,norm,pf,pl,praet" sem="d:pref" sem2="d:pref"/>успели</w> <w><ana lex="сделать" gr="V,act,inf,norm,pf,tran" sem="d:pref" sem2=""/>сделать</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>сегодня</w> <w><ana lex="три" gr="NUM,acc,inan,norm" sem="r:card:pauc" sem2=""/>три</w> <w><ana lex="визит" gr="S,gen,inan,m,norm,sg" sem="t:action r:abstr" sem2=""/>визита</w>.</se><se> <w><ana lex="продолжительный" gr="A,m,nom,norm,plen,sg" sem="t:time:dur:max der:v dt:be:exist r:qual" sem2=""/>Продолжительный</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="первый" gr="ANUM,m,nom,norm,sg" sem="r:ord der:num t:ord r:qual" sem2="ev:posit t:hier t:qual r:qual"/>первый</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="ринчина" gr="S,acc,bastard,inan,m,sg" sem="" sem2=""/>Ринчино</w>, <w><ana lex="где" gr="ADVPRO,norm" sem="t:place r:rel" sem2="t:place r:indet"/>где</w> <w><ana lex="закусить" gr="V,act,indic,norm,pf,pl