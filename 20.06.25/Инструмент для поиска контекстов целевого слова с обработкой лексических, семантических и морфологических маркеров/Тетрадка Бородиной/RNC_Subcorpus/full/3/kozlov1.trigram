льшой" gr="A,0,norm,plen" sem="t:size:max r:qual" sem2="t:quant:max t:time:age t:degr:max r:qual"/>большой</w> <w><ana lex="неохота" gr="S,f,inan,ins,norm,sg" sem="r:abstr" sem2="r:abstr"/>неохотой</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="злоба" gr="S,f,inan,ins,norm,sg" sem="t:psych:emot r:abstr" sem2=""/>злобой</w> <w><ana lex="взмахнуть" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2=""/>взмахнул</w> <w><ana lex="крыло" gr="S,inan,ins,n,norm,pl" sem="pt:partb pc:animal r:concr" sem2="pc:org pc:constr:build pc:tool:transp pt:part pc:part r:concr"/>крылами</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="полететь" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2="ca:noncaus t:move d:pref"/>полетел</w> <w><ana lex="вверх" gr="ADV,norm" sem="der:s t:dir" sem2="der:s"/>вверх</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="потом" gr="ADVPRO,norm" sem="t:time" sem2=""/>потом</w> <w><ana lex="вскоре" gr="ADV,norm" sem="der:adv t:time" sem2=""/>вскоре</w> <w><ana lex="скрыться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus d:pref" sem2="ca:noncaus t:move d:pref"/>скрылся</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="глаз" gr="S,acc,inan,m,norm,sg" sem="pt:partb pc:animal r:concr top:disk pc:hum" sem2=""/>глаз</w> <w><ana lex="наблюдатель" gr="S,anim,gen,m,norm,sg" sem="der:v t:hum r:concr d:nag" sem2=""/>наблюдателя</w>.</se></p>
<p><se><w><ana lex="наш" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>Наш</w> <w><ana lex="полпред" gr="S,anim,m,nom,norm,sg" sem="der:comp t:hum r:concr der:abbr" sem2=""/>полпред</w> <w><ana lex="дипломатически" gr="ADV,norm" sem="der:a" sem2=""/>дипломатически</w> <w><ana lex="избегать" gr="V,3p,act,fut,indic,norm,pf,sg,tran" sem="der:v d:pref" sem2="der:v d:pref"/><ana lex="избегать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v d:pref" sem2="der:v d:pref"/>избегает</w> <w><ana lex="приглашать" gr="V,act,inf,ipf,norm,tran" sem="der:v d:pref" sem2=""/>приглашать</w> <w><ana lex="я" gr="SPRO,1p,acc,norm,sg" sem="r:pers" sem2=""/>меня</w>, <w><ana lex="что" gr="SPRO,inan,n,nom,norm,sg" sem="r:rel" sem2=""/>что</w> <w><ana lex="называться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v ca:noncaus d:pref d:impf" sem2="der:v ca:noncaus d:pref d:impf"/>называется</w>, <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="вечеринка" gr="S,acc,f,inan,norm,sg" sem="t:action r:abstr" sem2=""/>вечеринку</w>, -- <w><ana lex="он" gr="SPRO,3p,dat,m,norm,sg" sem="r:pers" sem2=""/>ему</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="приятный" gr="A,brev,f,norm,sg" sem="ev:posit r:qual" sem2="ev:posit t:humq r:qual"/>приятна</w> <w><ana lex="мой" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/>моя</w> <w><ana lex="нелюбовь" gr="S,f,inan,nom,norm,sg" sem="r:abstr" sem2=""/>нелюбовь</w> <w><ana lex="ни" gr="PART,norm" sem="" sem2=""/>ни</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="спиртной" gr="A,dat,norm,pl,plen" sem="dt:stuff r:rel der:s" sem2=""/>спиртным</w> <w><ana lex="напиток" gr="S,dat,inan,m,norm,pl" sem="t:food t:stuff hi:class t:liq der:v r:concr" sem2=""/>напиткам</w>, <w><ana lex="ни" gr="CONJ,norm" sem="" sem2=""/>ни</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="курево" gr="S,dat,inan,n,norm,sg" sem="t:stuf