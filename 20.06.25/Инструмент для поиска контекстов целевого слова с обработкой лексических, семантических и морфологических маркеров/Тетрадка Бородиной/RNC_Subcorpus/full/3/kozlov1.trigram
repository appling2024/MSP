<p><se><w><ana lex="узко" gr="ADV,comp,norm" sem="dt:size:min der:a" sem2="dt:size:min der:a"/><ana lex="уже" gr="ADV,norm" sem="t:time" sem2=""/>Уже</w> <w><ana lex="11" gr="NUM,ciph"/>11</w>-<w>й</w> <w><ana lex="час" gr="S,inan,m,nom,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>час</w> <w><ana lex="утро" gr="S,gen,inan,n,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утра</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="хозяин" gr="S,anim,gen,m,norm,sg" sem="t:hum r:concr" sem2="t:hum ev:posit ev r:concr"/>хозяина</w> <w>нет</w> <w><ana lex="дома" gr="ADV,norm" sem="t:place der:s" sem2=""/>дома</w>.</se><se> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>У</w> <w><ana lex="он" gr="SPRO,3p,gen,m,norm,sg" sem="r:pers" sem2=""/>него</w> <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>сегодня</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="случай" gr="S,dat,inan,m,norm,sg" sem="pt:qtm r:abstr" sem2="t:time:moment r:abstr"/>случаю</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дня</w> <w><ana lex="рождение" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0 t:be:appear" sem2="der:shift t:time:moment r:abstr"/>рождения</w> <w><ana lex="сын" gr="S,anim,gen,m,norm,sg" sem="" sem2="t:hum der:shift ev r:concr"/>сына</w> <w><ana lex="гавый" gr="A,bastard,brev,pl" sem="" sem2=""/>Гавы</w> <w><ana lex="елка" gr="S,f,inan,nom,norm,sg" sem="t:plant r:concr der:s" sem2="t:action t:plant r:concr der:s r:abstr"/>елка</w>, <w><ana lex="собрание" gr="S,inan,n,nom,norm,sg" sem="t:action r:abstr" sem2="sc:x pt:set hi:class t:org r:abstr der:v r:concr"/>собрание</w> <w><ana lex="ребенок" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr" sem2="t:hum ev r:concr d:fil"/>детей</w>!</se><se> <w><ana lex="гавушка" gr="S,anim,bastard,dat,f,persn,sg" sem="" sem2=""/><ana lex="гавушка" gr="