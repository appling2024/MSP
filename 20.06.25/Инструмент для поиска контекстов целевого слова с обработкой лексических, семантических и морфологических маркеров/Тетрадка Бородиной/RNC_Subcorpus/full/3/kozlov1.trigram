<p><se><w><ana lex="вечер" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечер</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="мило" gr="ADV,norm" sem="ev:posit dt:humq der:a" sem2="ev:posit dt:humq der:a"/>мило</w> <w><ana lex="провести" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="провести" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="проводить" gr="V,act,indic,norm,pf,pl,praet" sem="ca:caus t:move d:pref" sem2="d:pref"/>провели</w> <w><ana lex="среди" gr="PR,norm" sem="" sem2=""/>среди</w> <w><ana lex="кружок" gr="S,gen,inan,m,norm,sg" sem="d:dim t:form top:circle r:concr der:s" sem2="t:group pt:set sc:hum pt:aggr der:s d:dim r:concr"/>кружка</w> <w><ana lex="знакомый" gr="S,anim,gen,m,norm,pl" sem="der:v t:hum r:concr der:subst" sem2=""/>знакомых</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="сам" gr="APRO,gen,norm,pl" sem="r:spec" sem2=""/>самих</w> <w><ana lex="байков" gr="S,anim,famn,gen,m,norm,pl" sem="t:hum r:propn t:famn" sem2=""/>Байковых</w>.</se><se> <w><ana lex="возвратиться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="der:v ca:noncaus t:move d:pref" sem2=""/>Возвратились</w> <w><ana lex="домой" gr="ADV,norm" sem="der:s t:dir" sem2=""/>домой</w> <w>поздно</w>.</se><se> <w><ana lex="луна" gr="S,f,inan,nom,norm,sg" sem="top:horiz top:spher t:astr t:space r:concr" sem2="t:space r:concr t:astr top:spher top:horiz pt:addit"/>Луна</w> <w><ana lex="чудно" gr="ADV,norm" sem="ev dt:humq der:a" sem2="ev:posit dt:quality der:a"/>чудно</w> <w><ana lex="озарять" gr="V,act,f,indic,ipf,norm,praet,sg,tran" sem="der:v d:pref" sem2=""/>озаряла</w> <w><ana lex="урга" gr="S,acc,f,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Ургу</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="прилежащий" gr="A,acc,f,norm,plen,sg" sem="der:v r:r