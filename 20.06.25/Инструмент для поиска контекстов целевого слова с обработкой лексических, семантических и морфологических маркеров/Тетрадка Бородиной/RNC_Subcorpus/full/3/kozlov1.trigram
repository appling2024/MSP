<p><se><w>Сейчас</w> <w><ana lex="4" gr="NUM,ciph"/>4</w> <w><ana lex="час" gr="S,gen,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часа</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дня</w>, <w><ana lex="через" gr="PR,norm" sem="" sem2=""/>через</w> <w><ana lex="2" gr="NUM,ciph"/>2</w> <w><ana lex="час" gr="S,gen,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часа</w> -- <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="6" gr="NUM,ciph"/>6</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w> <w><ana lex="ровно" gr="ADV,norm" sem="ev:posit dt:physq:form der:a" sem2="dt:physq:form der:a"/>ровно</w> -- <w><ana lex="мы" gr="SPRO,1p,dat,norm,pl" sem="r:pers" sem2=""/>нам</w>, <w><ana lex="весь" gr="APRO,dat,norm,pl" sem="r:spec" sem2=""/>всем</w> <w><ana lex="пассажир" gr="S,anim,dat,m,norm,pl" sem="t:hum r:concr" sem2=""/>пассажирам</w>, <w><ana lex="обещать" gr="V,act,indic,norm,pf,pl,praet,tran" sem="t:speech ca:noncaus d:pref der:s" sem2="d:pref der:s"/><ana lex="обещать" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="t:speech ca:noncaus d:pref der:s" sem2="d:pref der:s"/>обещали</w> <w><ana lex="обед" gr="S,acc,inan,m,norm,sg" sem="r:abstr" sem2="t:food sc:food r:abstr pt:aggr t:time r:concr"/>обед</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="9" gr="NUM,ciph"/>9</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w> -- <w><ana lex="ужин" gr="S,acc,inan,m,norm,sg" sem="r:abstr" sem2="t:food pt:aggr r:concr sc:food"/>ужин</w> (<w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="один" gr="APRO,gen,n,norm,sg" sem="" sem2="r:indet"/>одного</w> <w><ana lex="блюдо" gr="S,gen,inan,n,norm,sg" sem="top:horiz r:concr t:tool:dish" sem2="t:food r:concr hi:class"/>блюда</w>).</se><se> <w><ana form="Темно-синие" lex="темно-синий" gr="A,nom,norm,pl,plen" sem="der:comp dt:physq:color r:rel t:physq:color" sem2=""/>Темно-синие</w> <w><ana lex="даль" gr="S,f,inan,nom,norm,pl" sem="t:space der:a sc:space pc:space r:concr t:fam" sem2="t:space der:a sc:space pt:aggr:aggrpl pt:aggr r:concr"/><ana lex="даль" gr="S,anim,f,famn,nom,norm,pl" sem="" sem2=""/>дали</w> <w><ana lex="открыться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="der:v t:changest d:pref ca:noncaus" sem2="t:speech ca:noncaus d:pref"/>открылись</w> <w><ana lex="вовсю" gr="ADV,norm" sem="t:degr:max der:apro" sem2=""/>вовсю</w>, <w><ana lex="солнце" gr="S,inan,n,nom,norm,sg" sem="top:horiz top:spher t:astr t:space r:concr" sem2="ev:posit t:space r:concr r:abstr t:light"/>солнце</w> <w><ana lex="ярко" gr="ADV,norm" sem="ev:posit dt:physq:color der:a" sem2="dt:physq:color ev der:a"/>ярко</w>, <w><ana lex="ослепительно" gr="ADV,norm" sem="ev:posit dt:degr:max t:degr:max der:a" sem2="dt:degr:max der:a"/>ослепительно</w> <w><ana lex="блестеть" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus d:root t:light" sem2="d:root"/>блестит</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="греть" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="d:root" sem2="t:changest dt:physq:temper d:root ca:caus"/>греет</w> <w><ana lex="изрядно" gr="ADV,norm" sem="t:quant:max dt:quant:max der:a" sem2=""/>изрядно</w>!</se></p>
<p><se><w><ana lex="береговой" gr="A,acc,inan,norm,pl,plen" sem="dt:space r:rel der:s" sem2=""/>Береговые</w> <w><ana lex="терраса" gr="S,acc,f,inan,norm,pl" sem="t:space top:contain pc:constr:build pt:part:addit t:room r:concr" sem2="t:space r:concr"/>террасы</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="остров" gr="S,acc,inan,m,norm,pl" sem="t:space r:concr" sem2="t:space r:concr t:fam"/>острова</w> <w><ana lex="сплошь" gr="ADV,norm" sem="dt:degr:max der:a" sem2=""/>сплошь</w> <w><ana lex="укрыть" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="d:pref" sem2="d:pref"/>укрыты</w> <w><ana lex="зелень" gr="S,f,inan,ins,norm,sg" sem="t:color r:abstr der:a" sem2="t:food sc:fruit der:a r:concr pt:aggr sc:plant pc:food pt:addit"/>зеленью</w>, <w><ana lex="преимущественно" gr="ADV,norm" sem="dt:hier der:a" sem2=""/>преимущественно</w> <w><ana lex="кустарник" gr="S,inan,ins,m,norm,pl" sem="t:plant r:concr der:s hi:class" sem2="hi:class t:plant pt:aggr sc:plant der:s r:concr"/>кустарниками</w>, <w><ana lex="скат" gr="S,inan,m,nom,norm,pl" sem="t:animal:fish der:v pc:constr pt:part pc:part pc:space r:concr" sem2="pc:tool:transp r:concr pt:part"/><ana lex="скат" gr="S,anim,m,nom,norm,pl" sem="" sem2=""/>скаты</w> <w><ana lex="высокий" gr="A,gen,norm,pl,plen" sem="t:size:max r:qual" sem2="ev:posit der:shift t:size:max t:sound t:degr:max r:qual t:interpretation"/>высоких</w> <w><ana lex="обрывистый" gr="A,gen,norm,pl,plen" sem="t:physq der:s:deverb d:habit dt:space r:qual" sem2=""/>обрывистых</w> <w><ana lex="берег" gr="S,gen,inan,m,norm,pl" sem="pc:reservoir t:space r:concr pt:part pc:space" sem2="pt:aggr t:space r:concr sc:space"/>берегов</w> -- <w><ana lex="ель" gr="S,f,inan,ins,norm,sg" sem="t:plant r:concr" sem2=""/>елью</w>, <w><ana lex="лиственница" gr="S,f,inan,ins,norm,sg" sem="t:plant r:concr" sem2=""/>лиственницей</w>, <w><ana lex="сосна" gr="S,f,inan,ins,norm,sg" sem="t:plant r:concr" sem2=""/>сосной</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="др" gr="S,0,inan,norm,pl" sem="" sem2=""/>др</w>.</se><se> <w><ana lex="дождь" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2="pt:set sc:x r:concr"/>Дождь</w> <w><ana lex="умыть" gr="V,act,indic,m,norm,pf,praet,sg" sem="t:impact ca:caus d:pref" sem2=""/>умыл</w> <w><ana lex="воздух" gr="S,acc,inan,m,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>воздух</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="лик" gr="S,acc,inan,m,norm,sg" sem="sc:hum ev:posit pc:hum pt:set pt:aggr sc:hum:supernat pt:partb r:concr" sem2="r:abstr t:fam"/>лик</w> <w><ana lex="земля" gr="S,f,gen,inan,norm,sg" sem="top:spher t:astr t:space r:concr" sem2="t:space sc:space top:horiz t:stuff pt:part pc:space r:concr"/>земли</w>, <w><ana lex="прозрачность" gr="S,f,inan,nom,norm,sg" sem="r:abstr der:a" sem2=""/>прозрачность</w> <w><ana lex="открыть" gr="V,act,f,indic,norm,pf,praet,sg" sem="t:impact ca:caus d:pref" sem2="t:speech ca:noncaus d:pref"/>открыла</w> <w><ana lex="далекий" gr="A,acc,inan,norm,pl,plen" sem="t:dist:max r:qual" sem2="dt:dist:max der:shift t:time t:humq r:qual"/>далекие</w> <w><ana lex="горизонт" gr="S,acc,inan,m,norm,pl" sem="t:space r:concr" sem2="t:ment t:space qc:stuff pt:qtm r:abstr pt:aggr r:concr"/>горизонты</w>.</se><se> <w><ana lex="там" gr="ADVPRO,norm" sem="t:place r:dem" sem2=""/>Там</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="сям" gr="ADVPRO,norm" sem="r:dem" sem2=""/>сям</w> <w><ana lex="тянуть" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="ca:caus t:move d:root" sem2="d:root"/>тянут</w> <w><ana lex="стадо" gr="S,inan,n,nom,norm,pl" sem="pt:set r:concr sc:animal" sem2="sc:hum sc:animal pt:set pt:aggr ev:neg r:concr"/>стада</w> <w><ana lex="крупный" gr="A,gen,norm,pl,plen" sem="t:compos:size:max r:qual" sem2="ev:posit t:humq:char t:degr:max:magn der:shift t:size:max r:qual ev"/>крупных</w> <w><ana lex="утка" gr="S,f,gen,inan,norm,pl" sem="" sem2="t:tool top:contain r:abstr t:speech ev:neg r:concr"/><ana lex="утка" gr="S,anim,f,gen,norm,pl" sem="t:animal r:concr" sem2=""/>уток</w>; <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="вечер" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>вечера</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="самый" gr="APRO,f,ins,norm,sg" sem="r:spec" sem2="r:spec"/><ana lex="сам" gr="APRO,f,ins,norm,sg" sem="r:spec" sem2=""/>самою</w> <w><ana lex="ночь" gr="S,f,inan,ins,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2=""/>ночью</w> <w><ana lex="раздаваться" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="d:pref" sem2=""/>раздавались</w> <w><ana lex="свист" gr="S,inan,m,nom,norm,pl" sem="t:sound:asp r:abstr" sem2="t:sound:asp r:abstr"/>свисты</w> <w><ana lex="мелкий" gr="A,gen,norm,pl,plen" sem="t:compos:size:min r:qual" sem2="dt:size:min t:hier t:degr:min ev:neg t:size:min der:shift r:qual r:rel"/>мелких</w> <w><ana lex="кулик" gr="S,anim,gen,m,norm,pl" sem="t:animal r:concr" sem2=""/><ana lex="кулик" gr="S,anim,famn,gen,m,norm,pl" sem="t:animal r:concr" sem2=""/>куликов</w>.</se></p>
<p><se><w><ana lex="налетный" gr="A,m,nom,norm,plen,sg" sem="r:rel der:s" sem2=""/>Налетный</w> <w><ana lex="снарядить" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="ca:caus d:pref t:poss" sem2=""/>снаряжен</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="отправление" gr="S,dat,inan,n,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="der:v r:concr t:text"/>отправлению</w> <w><ana lex="через" gr="PR,norm" sem="" sem2=""/>через</w> <w><ana lex="иркутск" gr="S,acc,inan,m,norm,sg" sem="r:propn t:topon" sem2=""/>Иркутск</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="обратный" gr="A,acc,inan,m,norm,plen,sg" sem="der:v r:rel t:dir" sem2="t:place r:rel"/>обратный</w> <w><ana lex="путь" gr="S,acc,inan,m,norm,sg" sem="top:stripe t:space r:concr" sem2="ev:posit t:space t:asp r:abstr sc:space pt:aggr:aggrpl pt:aggr top:stripe r:concr der:shift"/>путь</w>!</se></p>
<p><se><b/><w><b>17</b></w><b>/</b><w><ana lex="viii" gr="bastard" sem="" sem2=""/><b>VIII</b></w><b>, </b><w><ana lex="t" gr="bastard" sem="" sem2=""/><b>T</b></w><b/>. <w><ana lex="прелестный" gr="A,f,nom,norm,plen,sg" sem="ev:posit der:s dt:hum r:qual" sem2=""/>Прелестная</w> <w><ana lex="погода" gr="S,f,inan,nom,norm,sg" sem="r:abstr t:weather" sem2=""/>погода</w>: <w><ana lex="ясный" gr="A,f,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясная</w>, <w><ana lex="теплый" gr="A,f,nom,norm,plen,sg" sem="dt:temper dt:abstr t:physq:temper der:s r:qual" sem2="ev:posit t:physq:color dt:temper t:physq:temper dt:abstr der:s r:qual r:rel"/>теплая</w>, <w><ana lex="ароматный" gr="A,m,nom,norm,plen,sg" sem="der:s dt:stuff ev:posit t:physq:smell r:qual" sem2=""/>ароматный</w> <w><ana lex="воздух" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>воздух</w> <w><ana lex="бодрить" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="" sem2=""/>бодрит</w> <w><ana lex="весь" gr="APRO,acc,f,norm,sg" sem="r:spec" sem2=""/>всю</w> <w><ana lex="ваш" gr="APRO,acc,f,norm,sg" sem="r:poss" sem2=""/>вашу</w> <w><ana lex="внутренность" gr="S,acc,f,inan,norm,sg" sem="pt:aggr:aggrpl sc:x t:space r:concr der:a" sem2="t:space der:a pc:hum pc:animal pt:aggr:aggrpl sc:partb pt:partb:inner r:concr"/>внутренность</w>, <w><ana lex="вы" gr="SPRO,2p,dat,norm,pl" sem="r:pers" sem2=""/>вам</w> <w><ana lex="чудно" gr="ADV,norm" sem="ev dt:humq der:a" sem2="ev:posit dt:quality der:a"/>чудно</w> <w>хорошо</w>.</se><se> <w><ana lex="южный" gr="A,f,nom,norm,plen,sg" sem="t:place dt:space r:rel der:s" sem2=""/>Южная</w> <w><ana lex="даль" gr="S,f,inan,nom,norm,sg" sem="t:space der:a sc:space pc:space r:concr t:fam" sem2="t:space der:a sc:space pt:aggr:aggrpl pt:aggr r:concr"/>даль</w> <w><ana lex="тянуть" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="ca:caus t:move d:root" sem2="d:root"/>тянет</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="бесконечность" gr="S,a