<p><se><b/><w><b>3</b></w><b>/</b><w><ana lex="i" gr="bastard" sem="" sem2=""/><b>I</b></w><b>, </b><w><ana lex="v" gr="bastard" sem="" sem2=""/><b>V</b></w><b/>. <w><ana lex="ясный" gr="A,n,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>Ясное</w>, <w><ana lex="холодный" gr="A,n,nom,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодное</w>, <w><ana lex="прозрачный" gr="A,n,nom,norm,plen,sg" sem="t:physq r:rel" sem2="t:physq r:rel r:qual"/>прозрачное</w> <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утро</w>.</se><se> <w><ana lex="вершина" gr="S,f,inan,nom,norm,pl" sem="t:fam r:concr pc:x pt:part der:s" sem2=""/>Вершины</w> <w><ana lex="окрестный" gr="A,gen,norm,pl,plen" sem="t:place r:rel der:adv" sem2=""/>окрестных</w> <w><ana lex="гора" gr="S,f,gen,inan,norm,pl" sem="top:hill t:space r:concr" sem2="sc:x pt:set t:space t:form r:abstr t:quant:max r:concr"/>гор</w> <w><ana lex="гореть" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="d:root" sem2="ca:noncaus der:shift d:root t:light"/>горят</w> <w><ana lex="серебристый" gr="A,ins,m,norm,plen,sg" sem="der:s dt:stuff t:physq:color r:qual" sem2="t:sound r:qual"/>серебристым</w>, <w><ana lex="искристый" gr="A,ins,m,norm,plen,sg" sem="dt:abstr d:habit der:s dt:light r:qual" sem2=""/>искристым</w> <w><ana lex="блеск" gr="S,inan,ins,m,norm,sg" sem="r:abstr t:light" sem2="ev:posit t:stuff r:abstr der:v t:manif r:concr"/>блеском</w>.</se><se> <w><ana lex="природа" gr="S,f,inan,nom,norm,sg" sem="pt:aggr t:space r:concr sc:space" sem2="pt:aggr t:space r:concr r:abstr sc:space"/>Природа</w> <w><ana lex="зимний" gr="A,f,nom,norm,plen,sg" sem="dt:time dt:abstr dt:time:season der:s t:time r:rel" sem2=""/>зимняя</w> <w><ana lex="иметь" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="ca:noncaus d:root t:poss" sem2="d:root"/>имеет</w> <w