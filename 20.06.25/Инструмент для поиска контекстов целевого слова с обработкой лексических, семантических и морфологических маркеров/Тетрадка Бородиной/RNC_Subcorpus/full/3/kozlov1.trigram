ать</w> <w><ana lex="время" gr="S,acc,inan,n,norm,sg" sem="r:abstr t:param t:time" sem2="t:time:period r:abstr t:time"/>время</w> -- «<w><ana lex="золотой" gr="A,acc,n,norm,plen,sg" sem="dt:stuff r:rel der:s" sem2="ev:posit t:social:emot der:shift r:qual r:rel t:physq:color"/>золотое</w>».</se></p>
<p><se><b/><w><b>17</b></w><b>/</b><w><ana lex="vii" gr="bastard" sem="" sem2=""/><b>VII</b></w><b>.</b></se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="11" gr="NUM,ciph"/>11</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w> <w><ana lex="утро" gr="S,gen,inan,n,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утра</w> <w><ana lex="встретить" gr="V,act,indic,m,norm,pf,praet,sg" sem="d:pref" sem2="d:pref"/>встретил</w> <w>С</w>. <w>А</w>. <w><ana lex="глаголева" gr="S,anim,f,famn,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Глаголева</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="который" gr="APRO,ins,m,norm,sg" sem="r:rel t:ord" sem2=""/>которым</w> <w><ana lex="дойти" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/><ana lex="доходить" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2=""/>дошел</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="заячий" gr="A,gen,m,norm,plen,sg" sem="r:poss der:s dt:animal" sem2=""/>Заячьего</w> <w><ana lex="переулок" gr="S,gen,inan,m,norm,sg" sem="top:stripe t:space r:concr der:s" sem2=""/>переулка</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="разговор" gr="S,inan,loc,m,norm,sg" sem="t:speech r:abstr" sem2="t:speech der:shift r:abstr"/>разговоре</w> <w><ana lex="об" gr="PR,norm" sem="" sem2=""/>об</w> <w><ana lex="экспедиция" gr="S,f,inan,loc,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w>.</se><se> <w><ana lex="потом" gr="ADVPRO,norm" sem="t:time" sem2=""/>Потом</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="поехать" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref