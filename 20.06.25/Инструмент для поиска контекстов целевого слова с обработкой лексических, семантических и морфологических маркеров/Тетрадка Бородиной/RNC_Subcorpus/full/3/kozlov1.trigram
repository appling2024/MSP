<p><se><w><ana lex="время" gr="S,inan,n,nom,norm,sg" sem="r:abstr t:param t:time" sem2="t:time:period r:abstr t:time"/>Время</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="только" gr="PART,norm" sem="" sem2=""/>только</w> <w><ana lex="идти" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:move d:root" sem2="ca:noncaus t:move d:root"/>идет</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="даже" gr="PART,norm" sem="" sem2=""/>даже</w> <w><ana lex="бежать" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="ca:noncaus t:move d:root" sem2="d:root"/><ana lex="бежать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:move d:root" sem2="d:root"/>бежит</w>, <w><ana lex="двигаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v ca:noncaus t:move" sem2="der:v ca:noncaus"/>движется</w>, <w><ana lex="двигаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v ca:noncaus t:move" sem2="der:v ca:noncaus"/>движется</w>.</se><se> <w><ana lex="как" gr="ADVPRO,norm" sem="r:rel t:manner" sem2=""/>Как</w> <w><ana lex="великий" gr="A,f,nom,norm,plen,sg" sem="t:degr:max r:qual" sem2="t:size:max t:degr:max r:qual"/>великая</w> <w><ana lex="вселенная" gr="S,f,inan,nom,norm,sg" sem="t:space r:concr" sem2="t:space r:concr sc:space"/>Вселенная</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="мочь" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="d:root" sem2=""/>может</w> <w><ana lex="быть" gr="V,act,inf,intr,ipf,norm" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>быть</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="покой" gr="S,inan,loc,m,norm,sg" sem="t:letter t:move r:abstr t:room t:neg r:concr" sem2="t:neg t:psych r:abstr"/>покое</w>, <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="сердце" gr="S,inan,n,nom,norm,sg" sem="pc:hum pt:partb:organ r:concr pc:animal" sem2="t:sign pc:hum der:shift pt:partb:organ t:psych:emot r:concr"/>сердце</w> <w><ana lex="человек" gr="S,anim,gen,m,norm,sg" sem="t:hum r:concr" sem2="t:hum ev:posit r:concr"/>человека</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="мочь" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="d:root" sem2=""/>может</w> <w><ana lex="жить" gr="V,act,inf,intr,ipf,norm" sem="t:be:exist ca:noncaus d:root" sem2="d:root"/>жить</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="покой" gr="S,inan,loc,m,norm,sg" sem="t:letter t:move r:abstr t:room t:neg r:concr" sem2="t:neg t:psych r:abstr"/>покое</w>.</se><se> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>И</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="первый" gr="ANUM,loc,m,norm,sg" sem="r:ord der:num t:ord r:qual" sem2="ev:posit t:hier t:qual r:qual"/>первом</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="во" gr="PR,norm" sem="" sem2=""/>во</w> <w><ana lex="второй" gr="ANUM,loc,m,norm,sg" sem="r:ord der:num r:rel t:ord" sem2="t:hier t:share r:rel der:num"/>втором</w> <w><ana lex="случай" gr="S,inan,loc,m,norm,pl" sem="pt:qtm r:abstr" sem2="t:time:moment r:abstr"/>случаях</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="приостановление" gr="S,inan,ins,n,norm,sg" sem="der:v r:abstr" sem2=""/>приостановлением</w> <w><ana lex="движение" gr="S,gen,inan,n,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="t:move r:abstr t:behav"/>движения</w> <w><ana lex="происходить" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:be:exist ca:noncaus d:pref" sem2="t:be:exist ca:noncaus d:pref"/>происходит</w> <w><ana lex="катастрофа" gr="S,f,inan,nom,norm,sg" sem="r:abstr" sem2="r:abstr"/>катастрофа</w>.</se><se> <w><ana lex="да" gr="CONJ,norm" sem="" sem2=""/>Да</w>, <w>вероятно</w>, <w><ana lex="пройти" gr="V,3p,act,fut,indic,norm,pf,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="пройти" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="проходить" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="der:v ca:noncaus t:move d:pref" sem2=""/>пройдет</w> <w><ana lex="еще" gr="ADV,norm" sem="" sem2=""/>еще</w> <w><ana lex="целый" gr="A,acc,inan,m,norm,plen,sg" sem="t:degr r:qual" sem2="t:degr r:spec r:qual"/>целый</w> <w><ana lex="месяц" gr="S,acc,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:space t:astr t:time:period r:abstr top:form r:concr t:fam"/>месяц</w>, <w><ana lex="прежде" gr="ADV,norm" sem="dt:time der:a t:time" sem2="dt:time der:a t:time"/>прежде</w> <w><ana lex="нежели" gr="CONJ,norm" sem="" sem2=""/>нежели</w> <w><ana lex="проснуться" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="der:v ca:noncaus t:physiol d:pref" sem2="der:v ca:noncaus d:pref"/>проснется</w> <w><ana lex="зима" gr="S,f,inan,nom,norm,sg" sem="t:time:season r:abstr t:time" sem2="t:fam"/>зима</w> <w><ana lex="навстречу" gr="ADV,norm" sem="der:s t:dir" sem2=""/>навстречу</w> <w><ana lex="грядущий" gr="A,dat,f,norm,plen,sg" sem="der:v r:rel t:time" sem2=""/>грядущей</w> <w><ana lex="весна" gr="S,dat,f,inan,norm,sg" sem="t:time:season r:abstr t:time" sem2=""/>весне</w>.</se><se> <w><ana lex="снег" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2=""/>Снега</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w>много</w>, <w><ana lex="холод" gr="S,inan,m,nom,norm,sg" sem="t:temper r:abstr t:weather" sem2="t:manif:emot r:abstr t:temper t:physiol t:manif:disease t:fam"/>холод</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="упорно" gr="ADV,norm" sem="ev dt:humq der:a" sem2=""/>упорно</w> <w><ana lex="держаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v ca:noncaus" sem2="der:v ca:noncaus"/>держится</w>, <w><ana lex="что" gr="SPRO,acc,inan,n,norm,sg" sem="r:rel" sem2=""/>что</w> <w>трудно</w> <w><ana lex="ожидать" gr="V,act,inf,ipf,norm,tran" sem="der:v d:pref" sem2=""/>ожидать</w> <w><ana lex="скорый" gr="A,f,gen,norm,plen,sg" sem="t:speed:max r:qual" sem2="t:time r:rel r:qual"/>скорой</w> <w><ana lex="теплый" gr="A,f,gen,norm,plen,sg" sem="dt:temper dt:abstr t:physq:temper der:s r:qual" sem2="ev:posit t:physq:color dt:temper t:physq:temper dt:abstr der:s r:qual r:rel"/>теплой</w> <w><ana lex="весна" gr="S,f,gen,inan,norm,sg" sem="t:time:season r:abstr t:time" sem2=""/>весны</w>.</se></p>
<p><se><w><ana lex="вечер" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечер</w> <w><ana lex="праздничный" gr="A,m,nom,norm,plen,sg" sem="dt:abstr ev r:rel der:s dt:action" sem2=""/>праздничный</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> (<w><ana lex="ида" gr="S,anim,f,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Ида</w> <w><ana lex="павловна" gr="S,anim,f,nom,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Павловна</w>, <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w>, <w><ana lex="сергей" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Сергей</w> <w><ana lex="александрович" gr="S,anim,m,nom,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2="t:hum r:propn t:famn"/><ana lex="александрович" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum t:patrn r:propn der:s" sem2="t:hum r:propn t:famn"/>Александрович</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="верочка" gr="S,anim,f,nom,norm,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Верочка</w>) <w><ana lex="провести" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="провести" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="проводить" gr="V,act,indic,norm,pf,pl,praet" sem="ca:caus t:move d:pref" sem2="d:pref"/>провели</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="провизор" gr="S,anim,gen,m,norm,sg" sem="t:hum r:concr" sem2=""/>провизора</w>, <w><ana lex="кушать" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="ca:caus t:physiol d:root" sem2=""/>кушали</w> <w><ana lex="блин" gr="S,acc,inan,m,norm,pl" sem="t:food r:concr top:disk" sem2=""/>блины</w>.</se><se> <w><ana lex="вечер" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечер</w> <w><ana lex="прекрасный" gr="A,m,nom,norm,plen,sg" sem="ev:po