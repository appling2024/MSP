"PR,norm" sem="" sem2=""/>на</w> <w><ana lex="восток" gr="S,acc,inan,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr pt:part pc:space"/>восток</w>) <w><ana lex="поезд" gr="S,gen,inan,m,norm,sg" sem="sc:tool:transp t:tool:transp r:concr" sem2="pt:set sc:tool:transp r:concr"/>поезда</w>.</se><se> <w>Надо</w> <w><ana lex="надеяться" gr="V,act,inf,intr,ipf,norm" sem="t:ment ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>надеяться</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="именно" gr="PART,norm" sem="" sem2=""/>именно</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="быть" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>будет</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="поехать" gr="V,1p,act,fut,indic,intr,norm,pf,pl" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="поехать" gr="V,1p,act,imper,intr,norm,pf,pl" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/>поедем</w> <w><ana lex="далеко" gr="ADV,comp,norm" sem="t:dist:max" sem2=""/>дальше</w> <w><ana lex="много" gr="ADV,comp,norm" sem="t:quant:max r:spec" sem2="t:degr:max"/><ana lex="более" gr="ADV,norm" sem="t:degr:max der:adv" sem2="t:degr:max"/>более</w> <w><ana lex="успешно" gr="ADV,norm" sem="ev:posit der:a" sem2=""/>успешно</w>, <w><ana lex="нежели" gr="CONJ,norm" sem="" sem2=""/>нежели</w> <w><ana lex="то" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>то</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="этот" gr="APRO,gen,n,norm,sg" sem="r:dem" sem2=""/>этого</w> <w><ana lex="время" gr="S,gen,inan,n,norm,sg" sem="r:abstr t:param t:time" sem2="t:time:period r:abstr t:time"/>времени</w>.</se></p>
<p><se><w><ana lex="какой" gr="APRO,acc,f,norm,sg" sem="t:neg r:rel ev:neg" sem2=""/>Какую</w> <w><ana lex="мрачный" gr="A,acc,f,norm,plen,sg" sem="dt:light dt:neg t:physq:light dt:abstr der:s r:qual" sem2="dt:light dt:neg dt:abstr ev:neg der:s r:qual t:psych:emot"/>мрачную</w> <w><ana lex="картина" gr="S,acc,anim,f,famn,norm,sg" sem="" sem2=""/><ana lex="картина" gr="S,acc,f,inan,norm,sg" sem="r:concr t:workart" sem2="pc:workdram t:text r:abstr t:workart t:perc pt:part t:workcin r:concr"/>картину</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="себе" gr="SPRO,acc,norm" sem="" sem2=""/>себя</w> <w><ana lex="представлять" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="der:v d:pref" sem2="der:v d:pref"/>представляет</w> <w><ana lex="окрестность" gr="S,f,inan,nom,norm,sg" sem="der:a t:space r:concr sc:space pc:space" sem2=""/>окрестность</w>, <w><ana lex="заволочь" gr="V,f,nom,norm,partcp,pass,pf,plen,praet,sg" sem="der:v d:pref" sem2="der:v ca:caus t:move d:pref"/>заволоченная</w> <w><ana lex="дождливый" gr="A,ins,m,norm,plen,sg" sem="dt:stuff der:s r:qual" sem2=""/>дождливым</w> <w><ana lex="туман" gr="S,inan,ins,m,norm,sg" sem="r:abstr t:weather" sem2="ev:neg r:abstr t:weather"/>туманом</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="сырость" gr="S,f,inan,ins,norm,sg" sem="r:abstr der:a" sem2="r:abstr der:a"/>сыростью</w>; <w><ana lex="грязь" gr="S,f,inan,nom,norm,sg" sem="t:stuff r:concr" sem2="t:stuff r:concr r:abstr"/>грязь</w> <w><ana lex="непролазный" gr="A,f,nom,norm,plen,sg" sem="t:physq d:neg r:rel" sem2=""/>непролазная</w>, <w><ana lex="свежий" gr="A,brev,n,norm,sg" sem="r:qual" sem2="t:time t:physq:temper ev der:shift r:qual"/>свежо</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="даже" gr="PART,norm" sem="" sem2=""/>даже</w> <w>холодно</w>.</se><se> <w>Правда</w>, <w>нет</w> <w><ana lex="пыль" gr="S,f,gen,inan,norm,sg" sem="t:stuff r:concr" sem2=""/>пыли</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="докучливый" gr="A,gen,norm,pl,plen" sem="der:v t:humq ev:neg r:qual" sem2=""/>докучливых</w> <w><ana lex="насекомое" gr="S,anim,gen,n,norm,pl" sem="t:animal r:concr hi:class" sem2=""/>насекомых</w>.</se><se> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>За</w> <w><ana lex="урал" gr="S,inan,ins,m,norm,sg" sem="r:propn t:topon" sem2="r:propn t:topon"/>Уралом</w>, <w>вероятно</w>, <w><ana lex="все" gr="SPRO,inan,n,nom,norm,sg" sem="" sem2=""/>все</w> <w><ana lex="измениться" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="ca:noncaus d:pref" sem2=""/>изменится</w>: <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="природа" gr="S,f,inan,nom,norm,sg" sem="pt:aggr t:space r:concr sc:space" sem2="pt:aggr t:space r:concr r:abstr sc:space"/>природа</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="климат" gr="S,inan,m,nom,norm,sg" sem="t:asp:weather r:abstr" sem2="r:abstr"/>климат</w>.</se></p>
<p><se><b/><w><b>30</b></w><b>/</b><w><ana lex="vii" gr="bastard" sem="" sem2=""/><b>VII</b></w><b>, </b><w><ana lex="r" gr="bastard" sem="" sem2=""/><b>R</b></w><b/>. <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="конец" gr="S,inan,loc,m,norm,sg" sem="pt:phase r:concr r:abstr pt:part pc:x" sem2="top:rope t:tool t:space t:be:disapp r:abstr ev:neg r:concr"/>конце</w> <w><ana lex="конец" gr="S,gen,inan,m,norm,pl" sem="pt:phase r:concr r:abstr pt:part pc:x" sem2="top:rope t:tool t:space t:be:disapp r:abstr ev:neg r:concr"/>концов</w> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w> <w><ana lex="удаться" gr="V,act,indic,intr,n,norm,pf,praet,sg" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref"/>удалось</w> <w><ana lex="убедить" gr="V,act,inf,norm,pf" sem="t:speech t:ment d:pref ca:caus" sem2="t:speech ca:caus d:pref"/>убедить</w> <w><ana lex="начальник" gr="S,acc,anim,m,norm,sg" sem="t:hum r:concr" sem2=""/>начальника</w> <w><ana lex="отделение" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0" sem2="pc:org pt:set pc:contain t:org r:abstr der:v sc:hum pt:part pc:action r:concr"/>отделения</w>, <w><ana lex="чтобы" gr="CONJ,norm" sem="" sem2=""/>чтобы</w> <w><ana lex="два" gr="NUM,m,nom,norm" sem="r:card:pauc" sem2=""/>два</w> <w><ana lex="экспедиционный" gr="A,gen,norm,pl,plen" sem="r:rel der:s" sem2=""/>экспедиционных</w> <w><ana lex="вагон" gr="S,gen,inan,m,norm,sg" sem="t:tool:transp r:concr pt:part pc:tool:transp" sem2=""/>вагона</w> <w><ana lex="прицепить" gr="V,act,indic,norm,pf,pl,praet" sem="t:impact ca:caus d:pref" sem2="d:pref"/>прицепили</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="почтовый" gr="A,dat,m,norm,plen,sg" sem="dt:org r:rel der:s" sem2=""/>почтовому</w> <w><ana lex="петроград" gr="S,inan,m,nom,norm,sg" sem="r:propn t:topon" sem2=""/>Петроград</w> -- <w><ana lex="екатеринбург" gr="S,inan,m,nom,norm,sg" sem="r:propn t:topon" sem2=""/>Екатеринбург</w>.</se><se> <w><ana lex="пос