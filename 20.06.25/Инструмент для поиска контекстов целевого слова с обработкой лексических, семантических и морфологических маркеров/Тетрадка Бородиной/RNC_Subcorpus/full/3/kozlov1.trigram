<p><se><w><ana lex="горный" gr="A,m,nom,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s"/>Горный</w> <w><ana lex="рельеф" gr="S,inan,m,nom,norm,sg" sem="t:form r:concr r:abstr" sem2="r:concr t:workart"/>рельеф</w> <w><ana lex="ясно" gr="ADV,norm" sem="ev:posit dt:light der:a" sem2="ev:posit dt:light der:a"/>ясно</w> <w><ana lex="выражаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v ca:noncaus d:pref" sem2="t:speech ca:noncaus der:v d:pref"/>выражается</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="весь" gr="APRO,loc,n,norm,sg" sem="r:spec" sem2=""/>всем</w> <w><ana lex="пространство" gr="S,inan,loc,n,norm,sg" sem="t:space r:concr hi:class" sem2="top:gape t:space r:concr r:abstr hi:class"/>пространстве</w>, <w><ana lex="он" gr="SPRO,3p,acc,m,norm,sg" sem="r:pers" sem2=""/>его</w> <w>можно</w> <w><ana lex="характеризовать" gr="V,act,inf,norm,pf,tran" sem="" sem2=""/><ana lex="характеризовать" gr="V,act,inf,ipf,norm,tran" sem="" sem2=""/>характеризовать</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w>.</se><se> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>С</w> <w><ana lex="север" gr="S,gen,inan,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr t:fam pt:part pc:space"/><ana lex="север" gr="S,anim,gen,m,norm,persn,sg" sem="" sem2=""/>севера</w> <w><ana lex="вставать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v d:pref d:impf t:move:body" sem2=""/>встает</w> <w><ana lex="горный" gr="A,f,nom,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s"/>горная</w> <w><ana lex="цепь" gr="S,f,inan,nom,norm,sg" sem="sc:thing top:rope t:tool r:concr" sem2="sc:x top:rope t:form r:abstr pt:set der:shift sc:hum r:concr"/>цепь</w>, <w><ana lex="заметный" gr="A,f,nom,norm,plen,sg" sem="der:v r:qual" sem2="der:v t:humq:char r:qual"/>заметная</w> <w><ana lex="издали" gr="ADV,norm" sem="t:place dt:dist:max der:s" sem2=""/>издали</w>, <w><ana