<p><se><b/><w><b>6</b></w><b>/</b><w><ana lex="xi" gr="bastard" sem="" sem2=""/><b>XI</b></w><b>, </b><w><ana lex="u" gr="bastard" sem="" sem2=""/><b>U</b></w><b/>. <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>И</w> <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>сегодня</w> <w><ana lex="небо" gr="S,inan,n,nom,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/><ana lex="небо" gr="S,inan,n,nom,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/>небо</w> <w><ana lex="серый" gr="A,n,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>серое</w>, <w><ana lex="короткий" gr="A,acc,inan,m,norm,plen,sg" sem="t:size:min r:qual" sem2="t:behav ev:posit t:size:min t:time:dur:min r:qual"/>короткий</w> <w><ana lex="горизонт" gr="S,acc,inan,m,norm,sg" sem="t:space r:concr" sem2="t:ment t:space qc:stuff pt:qtm r:abstr pt:aggr r:concr"/>горизонт</w>; <w><ana lex="богдо" gr="ADV,bastard" sem="" sem2=""/>Богдо-ула</w> <w><ana lex="тонуть" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:move d:root" sem2="d:root"/>тонет</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="серый" gr="A,loc,norm,pl,plen" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>серых</w> <w><ana lex="облако" gr="S,inan,loc,n,norm,pl" sem="qc:stuff r:concr" sem2="qc:stuff pt:qtm top:form r:concr"/>облаках</w>, <w><ana lex="воздух" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>воздух</w> <w><ana lex="холодный" gr="A,m,nom,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодный</w>, <w><ana lex="тихий" gr="A,m,nom,norm,plen,sg" sem="d:neg t:s