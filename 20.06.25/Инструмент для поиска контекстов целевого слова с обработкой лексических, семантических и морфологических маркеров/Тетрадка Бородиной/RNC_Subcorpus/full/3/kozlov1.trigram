<p><se> <b/><w><b>14</b></w><b>/</b><w><ana lex="x" gr="bastard" sem="" sem2=""/><b>X</b></w><b>,</b> <b/><w><ana lex="q" gr="bastard" sem="" sem2=""/><b>Q</b></w><b/>. <w><ana lex="ясный" gr="A,n,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>Ясное</w> <w><ana lex="тихий" gr="A,n,nom,norm,plen,sg" sem="d:neg t:sound r:qual" sem2="d:neg t:humq t:speed:min der:shift t:sound r:qual"/>тихое</w> <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утро</w>, <w>морозно</w>.</se><se> <w><ana lex="один" gr="APRO,n,nom,norm,sg" sem="" sem2="r:indet"/>Одно</w> <w><ana lex="тонкий" gr="A,n,nom,norm,plen,sg" sem="t:size:min r:qual" sem2="t:physq:form t:humq der:shift t:sound r:qual ev"/>тонкое-тонкое</w>, <w><ana lex="словно" gr="CONJ,norm" sem="" sem2=""/>словно</w> <w><ana lex="перышко" gr="S,inan,n,nom,norm,sg" sem="d:dim r:concr der:s" sem2=""/>перышко</w>, <w><ana lex="облачко" gr="S,inan,n,nom,norm,sg" sem="d:dim r:concr der:s" sem2=""/>облачко</w> <w><ana lex="едва" gr="ADV,norm" sem="t:degr:min" sem2=""/>едва</w> <w><ana lex="проноситься" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/><ana lex="проноситься" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/><ana lex="проноситься" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/><ana lex="проноситься" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/><ana lex="пронестись" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v d:pref"/>проносится</w> <w><ana lex="над" gr="PR,norm" sem="" sem2=""/>над</w> <w><ana lex="могучий" gr="A,f,ins,norm,plen,sg" sem="ev:posit r:qual" sem2=""/>могучей</w> <w><ana lex="вершина" gr="S,f,inan,ins,norm,sg" sem="t:fam r:concr pc:x pt:part der:s" sem2=""/>вершиной