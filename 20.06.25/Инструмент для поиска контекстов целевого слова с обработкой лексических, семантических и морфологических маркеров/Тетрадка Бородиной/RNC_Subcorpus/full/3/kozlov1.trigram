я</w> <w><ana lex="быстро" gr="ADV,norm" sem="dt:speed:max ev der:a" sem2="t:speed:max dt:speed:max ev der:a"/>быстро</w>!</se><se> <w><ana lex="подле" gr="PR,norm" sem="" sem2=""/>Подле</w> <w><ana lex="я" gr="SPRO,1p,gen,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="прекрасный" gr="A,m,nom,norm,plen,sg" sem="ev:posit t:appearance r:qual" sem2="ev:posit t:quality r:qual"/>прекрасный</w> <w><ana lex="юноша" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr der:a" sem2=""/>юноша</w> -- <w><ana lex="мой" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>мой</w> <w><ana lex="любимый" gr="A,m,nom,norm,plen,sg" sem="der:v dt:psych:emot ev:posit t:social:emot r:qual" sem2="der:v dt:psych:emot"/>любимый</w> <w><ana lex="спутник" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,inan,m,nom,norm,sg" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутник</w> <w><ana lex="котик" gr="S,anim,m,nom,norm,sg" sem="d:dim t:animal r:concr der:s" sem2=""/><ana lex="котик" gr="S,inan,m,nom,norm,sg" sem="" sem2="der:shift t:stuff r:concr t:fam"/>Котик</w>, <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w> <w><ana lex="хорошо" gr="ADV,PARENTH,comp,norm" sem="ev:posit dt:quality der:a" sem2=""/>лучше</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="он" gr="SPRO,3p,ins,m,norm,sg" sem="r:pers" sem2=""/>ним</w>.</se><se> <w><ana lex="маленький" gr="A,n,nom,norm,plen,sg" sem="t:size:min r:qual" sem2="t:time:age t:size:min r:qual"/>Маленькое</w> <w><ana lex="развлечение" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr der:s0" sem2="r:abstr"/>развлечение</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="один" gr="APRO,f,gen,norm,sg" sem="" sem2="r:indet"/>одной</w> <w><ana lex="сторона" gr="S,f,gen,inan,norm,sg" sem="t:space r:concr pt:part pc:space" sem2="sc:hum t:space t:asp:ment r:abstr pt:set pc:x pt:part pc:space r:concr pc:form:geom"/>стороны</w>, <w><ana lex="с" gr="PR,norm" s