<p><se><b/><w><b>17</b></w><b>/</b><w><ana lex="i" gr="bastard" sem="" sem2=""/><b>I</b></w><b>, </b><w><ana lex="v" gr="bastard" sem="" sem2=""/><b>V</b></w><b/>. <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w> <w><ana lex="ясный" gr="A,n,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясное</w>, <w><ana lex="барометр" gr="S,inan,m,nom,norm,sg" sem="der:comp t:tool:device:measur:metr r:concr" sem2="r:abstr"/>барометр</w> <w><ana lex="начать" gr="V,act,indic,m,norm,pf,praet,sg" sem="aux:phase d:pref" sem2="aux:phase d:pref"/>начал</w> <w><ana lex="сильно" gr="ADV,norm" sem="dt:physq t:degr:max der:a" sem2="dt:physq der:a"/>сильно</w> <w><ana lex="падать" gr="V,act,inf,intr,ipf,norm" sem="ca:noncaus t:move d:root" sem2="d:root"/>падать</w>.</se><se> <w><ana lex="вечер" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечером</w> <w><ana lex="запад" gr="S,inan,m,nom,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr pt:part pc:space"/>запад</w> <w><ana lex="покрыть" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="d:pref" sem2="d:pref"/>покрыт</w> <w><ana lex="облако" gr="S,inan,ins,n,norm,pl" sem="qc:stuff r:concr" sem2="qc:stuff pt:qtm top:form r:concr"/>облаками</w>.</se><se> <w><ana lex="давно" gr="ADV,norm" sem="t:time" sem2=""/>Давно</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="ветреный" gr="A,f,gen,norm,plen,sg" sem="r:rel der:s d:habit" sem2="t:humq der:s ev:neg r:qual"/>ветреной</w> <w><ana lex="погода" gr="S,f,gen,inan,norm,sg" sem="r:abstr t:weather" sem2=""/>погоды</w>.</se><se> <w><ana lex="наш" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/>Наша</w> <w><ana lex="жизнь" gr="S,f,inan,nom,norm,sg" sem="t:be:exist r:abstr" sem2="t:be:exist r:abstr t:time"/>жизнь</w> <w><ana lex="монотонны