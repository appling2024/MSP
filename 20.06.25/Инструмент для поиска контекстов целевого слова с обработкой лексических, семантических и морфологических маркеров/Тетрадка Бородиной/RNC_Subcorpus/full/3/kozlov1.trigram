<p><se><w><ana lex="к" gr="PR,norm" sem="" sem2=""/>К</w> <w><ana lex="обед" gr="S,dat,inan,m,norm,sg" sem="r:abstr" sem2="t:food sc:food r:abstr pt:aggr t:time r:concr"/>обеду</w> <w><ana lex="прибыть" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2="d:pref"/>прибыл</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="мы" gr="SPRO,1p,dat,norm,pl" sem="r:pers" sem2=""/>нам</w> <w><ana lex="пан" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr" sem2=""/>пан</w> <w>Ежо</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w>, <w><ana lex="между" gr="PR,norm" sem="" sem2=""/>между</w> <w><ana lex="прочее" gr="SPRO,ins,n,norm,sg" sem="" sem2=""/>прочим</w>, <w><ana lex="сообщить" gr="V,act,indic,m,norm,pf,praet,sg" sem="t:speech ca:noncaus d:pref" sem2="d:pref"/>сообщил</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="интересный" gr="A,acc,inan,norm,pl,plen" sem="dt:abstr der:s dt:ment r:qual" sem2="dt:abstr ev:posit der:s dt:ment r:qual"/>интересные</w> <w><ana lex="данные" gr="S,acc,inan,norm,pl" sem="t:ment der:v pt:aggr:aggr_pl r:abstr" sem2="der:v pt:aggr:aggr_pl t:humq r:abstr"/>данные</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="развалины" gr="S,inan,loc,norm,pl" sem="" sem2=""/>развалинах</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="гора" gr="S,f,inan,loc,norm,pl" sem="top:hill t:space r:concr" sem2="sc:x pt:set t:space t:form r:abstr t:quant:max r:concr"/>горах</w>, <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="восток" gr="S,dat,inan,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr pt:part pc:space"/>востоку</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="борот" gr="S,acc,bastard,inan,m,pl" sem="" sem2=""/>Бороты</w>.</se><se> <w><ana lex="постройка" gr="S,acc,f,inan,norm,pl" sem="der:v r:abstr der:s0 t:impact:creat" sem2="der:v top:contain t:constr:hut r:concr"/>Постройки</w> -- <w><ana lex="пещера" gr="S,acc,f,inan,norm,pl" sem="t:space r:concr top:niche" sem2=""/>пещеры</w>, <w><ana lex="ряд" gr="S,acc,inan,m,norm,sg" sem="pt:set sc:x r:concr r:abstr" sem2="sc:x sc:hum t:form r:abstr pt:set pt:aggr sc:constr r:concr"/>ряд</w> <w><ana lex="комната" gr="S,f,gen,inan,norm,pl" sem="top:contain pc:constr:build t:room pt:part pc:room:appart r:concr" sem2="top:contain pc:constr:build r:concr t:room pt:part"/>комнат</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="который" gr="APRO,loc,norm,pl" sem="r:rel t:ord" sem2=""/>которых</w> <w><ana lex="найти" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="der:v ca:noncaus t:move t:poss" sem2="der:v ca:noncaus t:move"/>найдены</w>: <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="стена" gr="S,f,inan,loc,norm,pl" sem="pc:constr r:concr pc:room pt:part" sem2="pt:set t:quant:max dt:constr dt:form qc:stuff t:form pt:qtm r:abstr qc:aggr t:constr der:shift pc:constr sc:hum pt:part top:vertical r:concr"/>стенах</w> <w><ana lex="шелковый" gr="A,nom,norm,pl,plen" sem="dt:stuff r:rel der:s" sem2="dt:stuff t:humq ev der:s r:qual"/>шелковые</w> <w><ana lex="обои" gr="S,inan,nom,norm,pl" sem="der:v t:stuff r:concr" sem2=""/>обои</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="сам" gr="APRO,loc,norm,pl" sem="r:spec" sem2=""/>самих</w> <w><ana lex="комната" gr="S,f,inan,loc,norm,pl" sem="top:contain pc:constr:build t:room pt:part pc:room:appart r:concr" sem2="top:contain pc:constr:build r:concr t:room pt:part"/>комнатах</w> <w><ana lex="золотой" gr="A,nom,norm,pl,plen" sem="dt:stuff r:rel der:s" sem2="ev:posit t:social:emot der:shift r:qual r:rel t:physq:color"/>золотые</w> <w><ana lex="предмет" gr="S,inan,m,nom,norm,pl" sem="t:thing r:concr" sem2="t:ment t:thing r:concr r:abstr"/>предметы</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="ваза" gr="S,f,gen,inan,norm,sg" sem="top:contain t:tool r:concr t:tool:dish" sem2=""/>вазы</w> <w><ana lex