<p><se> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>Мы</w> <w><ana lex="беседовать" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:speech ca:noncaus der:s" sem2=""/>беседовали</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="горячий" gr="A,ins,m,norm,plen,sg" sem="t:physq:temper r:qual" sem2="der:shift t:humq t:physq:temper r:qual"/>горячим</w> <w><ana lex="интерес" gr="S,inan,ins,m,norm,sg" sem="t:ment r:abstr" sem2="r:abstr ev:neg"/>интересом</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="предстоящий" gr="A,loc,n,norm,plen,sg" sem="der:v r:rel t:time" sem2=""/>предстоящем</w> <w><ana lex="новый" gr="A,loc,n,norm,plen,sg" sem="t:time r:qual" sem2="t:time r:qual"/>новом</w> <w><ana lex="движение" gr="S,inan,loc,n,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="t:move r:abstr t:behav"/>движении</w> <w><ana lex="наш" gr="APRO,loc,n,norm,sg" sem="r:poss" sem2=""/>нашем</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="урга" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Урги</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="запад" gr="S,acc,inan,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr pt:part pc:space"/>запад-юго-запад</w>.</se><se> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>С</w> <w><ana lex="карта" gr="S,f,inan,ins,norm,sg" sem="r:concr t:workart" sem2="t:tool t:cardgame t:game r:abstr t:tool:card r:concr"/>картою</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="рука" gr="S,f,inan,loc,norm,pl" sem="pt:partb r:concr pc:hum" sem2="sc:hum t:asp r:abstr pt:aggr:aggrpl t:dir r:concr"/>руках</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="продвигаться" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="der:v d:pref" sem2=""/>продвигались</w> <w><ana lex="вперед" gr="ADV,norm" sem="der:s t:dir" sem2=""/>вперед</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="отметить" gr="V,act,indic,norm,pf,pl,praet" sem="d:pref" sem2="d:pref"/>отметили</w> <w><ana lex="наперед" gr="ADV,norm" sem="der:s t:time" sem2=""/>наперед</w> <w><ana lex="несколько" gr="NUM,acc,inan,norm" sem="" sem2=""/>несколько</w> <w><ana lex="опорный" gr="A,gen,norm,pl,plen" sem="der:v dt:contact r:rel" sem2=""/>опорных</w> <w><ana lex="пункт" gr="S,gen,inan,m,norm,pl" sem="t:space r:concr" sem2="t:text pt:phase r:abstr t:org der:shift pt:part pc:text r:concr"/>пунктов</w>, <w><ana lex="как" gr="ADVPRO,norm" sem="r:rel t:manner" sem2=""/><ana form="как-то" lex="как-то" gr="ADVPRO,norm" sem="der:advpro r:indet t:manner" sem2=""/>как-то</w>: <w><ana lex="изгиб" gr="S,acc,inan,m,norm,sg" sem="top:arc der:v t:form r:concr" sem2=""/>изгиб</w> <w><ana lex="тола" gr="S,f,gen,inan,norm,sg" sem="" sem2=""/>Толы</w>, <w><ana lex="заворот" gr="S,acc,inan,m,norm,sg" sem="der:v t:move r:abstr der:s0 t:disease" sem2="der:v t:form r:concr r:abstr"/>заворот</w> <w><ana lex="орхон" gr="S,anim,bastard,gen,m,persn,sg" sem="" sem2=""/>Орхона</w>, <w><ana lex="водораздел" gr="S,inan,m,nom,norm,sg" sem="top:hill der:comp t:space r:concr" sem2=""/>водораздел</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="система" gr="S,f,inan,loc,norm,sg" sem="pt:set r:abstr" sem2="sc:org r:abstr pt:set t:tool:device pt:aggr r:concr"/>системе</w> <w><ana lex="хангай" gr="S,gen,inan,m,norm,sg" sem="r:propn t:topon" sem2=""/>Хангая</w> (<w><ana lex="внутренний" gr="A,gen,m,norm,plen,sg" sem="t:place r:rel" sem2="r:rel"/>внутреннего</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="внешний" gr="A,gen,m,norm,plen,sg" sem="t:place r:rel der:adv" sem2="r:rel der:adv t:appearance r:qual"/>внешнего</w>) <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="кормный" gr="A,acc,f,norm,plen,sg" sem="r:rel der:s" sem2=""/>кормную</w> <w><ana lex="долина" gr="S,acc,anim,f,famn,norm,sg" sem="" sem2=""/><ana lex="долина" gr="S,acc,f,inan,norm,sg" sem="t:space r:concr der:s t:fam" sem2=""/>долину</w>, <w><ana lex="долина" gr="S,acc,anim,f,famn,norm,sg" sem="" sem2=""/><ana lex="долина" gr="S,acc,f,inan,norm,sg" sem="t:space r:concr der:s t:fam" sem2=""/>долину</w> <w><ana lex="озеро" gr="S,gen,inan,n,norm,pl" sem="top:contain t:reservoir t:space r:concr" sem2=""/>озер</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="область" gr="S,f,inan,loc,norm,sg" sem="t:space r:concr pt:part pc:space" sem2="t:space r:concr r:abstr pt:part pc:space"/>области</w> <w><ana lex="три" gr="NUM,acc,anim,norm" sem="r:card:pauc" sem2=""/>трех</w> <w><ana lex="значительный" gr="A,gen,norm,pl,plen" sem="t:quant:max der:v t:degr:max r:qual" sem2="der:v r:rel d:habit"/>значительных</w> <w><ana lex="речка" gr="S,f,gen,inan,norm,pl" sem="t:space top:contain t:reservoir der:s d:dim r:concr" sem2=""/>речек</w>, <w><ana lex="свой" gr="APRO,ins,norm,pl" sem="r:poss" sem2="t:social r:poss"/>своими</w> <w><ana lex="устья" gr="S,f,inan,ins,norm,pl" sem="" sem2=""/>устьями</w> <w><ana lex="образовывать" gr="V,act,gen,ipf,norm,partcp,pl,plen,praes" sem="der:v d:pref d:impf" sem2=""/>образующих</w> <w><ana lex="озеро" gr="S,gen,inan,n,norm,sg" sem="top:contain t:reservoir t:space r:concr" sem2=""/>озера</w>.</se><se> <w>Кажется</w>, <w><ana lex="весь" gr="APRO,n,nom,norm,sg" sem="r:spec" sem2=""/>все</w> <w><ana lex="это" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>это</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="область" gr="S,f,inan,loc,norm,sg" sem="t:space r:concr pt:part pc:space" sem2="t:space r:concr r:abstr pt:part pc:space"/>области</w> <w><ana lex="хошун" gr="S,gen,inan,m,norm,sg" sem="" sem2=""/>хошуна</w> <w>Юм-бэйсэ</w>.</se><se> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>К</w> <w><ana lex="юг" gr="S,dat,inan,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr pt:part pc:space"/>югу</w> -- <w><ana lex="гора" gr="S,f,inan,nom,norm,pl" sem="top:hill t:space r:concr" sem2="sc:x pt:set t:spa