очно" gr="ADV,norm" sem="t:quant:max dt:humq der:a" sem2=""/>порядочно</w>!</se><se> <w><ana lex="вот" gr="PART,norm" sem="" sem2="r:dem"/>Вот</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="день" gr="S,inan,loc,m,norm,pl" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>днях</w> <w><ana lex="это" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>это</w> <w><ana lex="выясниться" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="t:ment ca:noncaus d:pref" sem2=""/>выяснится</w>.</se><se> <w><ana lex="наконец" gr="ADV,PARENTH,norm" sem="der:s t:time" sem2=""/>Наконец-то</w> <w><ana lex="узнавать" gr="V,1p,act,indic,ipf,norm,pl,praes,tran" sem="t:ment der:v d:pref d:impf" sem2=""/><ana lex="узнать" gr="V,1p,act,fut,indic,norm,pf,pl,tran" sem="d:pref" sem2="t:ment ca:noncaus d:pref"/><ana lex="узнать" gr="V,1p,act,imper,norm,pf,pl,tran" sem="d:pref" sem2="t:ment ca:noncaus d:pref"/>узнаем</w> <w><ana lex="весь" gr="APRO,acc,n,norm,sg" sem="r:spec" sem2=""/>все</w> <w><ana lex="это" gr="SPRO,acc,inan,n,norm,sg" sem="r:dem" sem2=""/>это</w>.</se><se> <w><ana lex="вот" gr="PART,norm" sem="" sem2="r:dem"/>Вот</w> <w>теперь</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="посмотреть" gr="V,2p,act,fut,indic,norm,pf,pl,tran" sem="ca:noncaus d:pref t:perc" sem2="d:pref"/><ana lex="посмотреть" gr="V,2p,act,imper,norm,pf,pl,tran" sem="ca:noncaus d:pref t:perc" sem2="d:pref"/>посмотрите</w>, <w><ana lex="какой" gr="APRO,acc,f,norm,sg" sem="t:neg r:rel ev:neg" sem2=""/>какую</w> <w><ana lex="сложный" gr="A,acc,f,norm,plen,sg" sem="r:qual" sem2="r:qual"/>сложную</w> <w><ana lex="несогласованность" gr="S,acc,f,inan,norm,sg" sem="r:abstr der:a" sem2=""/>несогласованность</w> <w><ana lex="учинить" gr="V,act,indic,m,norm,pf,praet,sg" sem="d:pref" sem2=""/>учинил</w> <w><ana lex="центр" gr="S,inan,m,nom,norm,sg" sem="t:space r:concr pc:form:geom pt:part" sem2="pc:org t:space pc:hum pc:animal t:org pt:set pt:partb:organ