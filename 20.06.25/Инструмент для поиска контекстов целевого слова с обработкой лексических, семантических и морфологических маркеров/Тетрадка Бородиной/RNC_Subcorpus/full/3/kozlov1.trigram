<p><se><w><ana lex="с" gr="PR,norm" sem="" sem2=""/>С</w> <w><ana lex="вечер" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>вечера</w> <w><ana lex="великолепный" gr="A,n,nom,norm,plen,sg" sem="ev:posit t:quality r:qual" sem2="ev:posit t:appearance r:qual"/>великолепное</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="небо" gr="S,inan,n,nom,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/><ana lex="небо" gr="S,inan,n,nom,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/>небо</w>, <w><ana lex="унизать" gr="V,n,nom,norm,partcp,pass,pf,plen,praet,sg" sem="der:v d:pref" sem2=""/>унизанное</w> <w><ana lex="ярко" gr="ADV,norm" sem="ev:posit dt:physq:color der:a" sem2="dt:physq:color ev der:a"/>ярко</w> <w><ana lex="блестеть" gr="V,act,ins,intr,ipf,norm,partcp,pl,plen,praet" sem="ca:noncaus d:root t:light" sem2="d:root"/>блестевшими</w> <w><ana lex="звезда" gr="S,f,inan,ins,norm,pl" sem="t:astr t:space r:concr" sem2="t:form t:sign r:concr"/><ana lex="звезда" gr="S,anim,f,ins,norm,pl" sem="" sem2="t:hum ev r:concr"/>звездами</w>.</se><se> <w><ana lex="поздний" gr="A,comp,norm,plen" sem="t:time r:qual" sem2="t:time r:qual"/>Позднее</w>, <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="полночь" gr="S,acc,f,inan,norm,sg" sem="ev:posit r:abstr t:time" sem2="t:space r:concr r:abstr"/>полночь</w>, <w><ana lex="тишина" gr="S,acc,anim,f,famn,norm,sg" sem="" sem2=""/><ana lex="тишина" gr="S,acc,f,inan,norm,sg" sem="t:neg t:sound r:abstr t:fam" sem2="r:abstr"/>тишину</w> <w><ana lex="воздух" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>воздуха</w> <w><ana lex="нарушить" gr="V,act,indic,m,norm,pf,praet,sg" sem="d:pref" sem2="d:pref"/>нарушил</w> <w><ana for