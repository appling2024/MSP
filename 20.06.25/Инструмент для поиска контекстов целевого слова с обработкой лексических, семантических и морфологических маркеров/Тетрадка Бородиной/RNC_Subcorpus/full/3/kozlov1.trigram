<p><se><w><ana lex="к" gr="PR,norm" sem="" sem2=""/>К</w> <w><ana lex="полдень" gr="S,dat,inan,m,norm,sg" sem="r:abstr t:time" sem2="t:space r:concr"/>полудню</w> <w><ana lex="стихнуть" gr="V,act,indic,intr,n,norm,pf,praet,sg" sem="d:pref" sem2=""/>стихло</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="t" gr="bastard" sem="" sem2=""/>t</w> <w><ana lex="подняться" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/>поднялась</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> -<w><ana lex="3-5" gr="NUM,ciph"/>3-5</w>°<w><ana lex="r" gr="bastard" sem="" sem2=""/>R</w>.</se></p>
