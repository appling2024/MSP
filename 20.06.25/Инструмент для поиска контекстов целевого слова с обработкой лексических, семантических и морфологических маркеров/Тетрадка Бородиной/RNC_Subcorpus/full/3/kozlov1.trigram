<p><se><b/><w><b>30</b></w><b>/</b><w><ana lex="i" gr="bastard" sem="" sem2=""/><b>I</b></w><b>, </b><w><ana lex="s" gr="bastard" sem="" sem2=""/><b>S</b></w><b/>. <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w> <w><ana lex="тихий" gr="A,n,nom,norm,plen,sg" sem="d:neg t:sound r:qual" sem2="d:neg t:humq t:speed:min der:shift t:sound r:qual"/>тихое</w>, <w><ana lex="облачный" gr="A,n,nom,norm,plen,sg" sem="r:rel der:s" sem2="t:physq r:rel der:s"/>облачное</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="прекрасный" gr="A,f,ins,norm,plen,sg" sem="ev:posit t:appearance r:qual" sem2="ev:posit t:quality r:qual"/>прекрасной</w> <w><ana lex="охотничий" gr="A,f,ins,norm,plen,sg" sem="r:poss der:s dt:hum" sem2=""/>охотничьей</w> <w><ana lex="пороша" gr="S,f,inan,ins,norm,sg" sem="der:v t:stuff r:concr" sem2=""/>порошей</w>.</se><se> <w><ana lex="вот" gr="PART,norm" sem="" sem2="r:dem"/>Вот</w> <w>теперь</w> <w><ana lex="бы" gr="PART,norm" sem="" sem2=""/>бы</w> <w><ana lex="быть" gr="V,act,inf,intr,ipf,norm" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>быть</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="сангина" gr="S,f,inan,loc,norm,sg" sem="" sem2=""/>Сангине</w>!</se><se> <w><ana lex="богдо" gr="ADV,bastard" sem="" sem2=""/>Богдо-ула</w> <w><ana lex="пребывать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v d:pref" sem2=""/>пребывает</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="грусть" gr="S,f,gen,inan,norm,sg" sem="t:psych:emot r:abstr" sem2=""/>грусти</w>, <w><ana lex="ее" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,n,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,f,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,m,nom,norm,pl" sem="r:poss" sem2=""/><ana lex=