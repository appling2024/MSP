<p><se><w><ana lex="незадолго" gr="ADV,norm" sem="der:adv t:time" sem2=""/>Незадолго</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="приход" gr="S,gen,inan,m,norm,sg" sem="t:group pt:set t:move der:s0 r:abstr der:v t:space sc:hum r:concr" sem2="r:abstr t:poss"/>прихода</w> <w><ana lex="лена" gr="S,anim,f,gen,norm,persn,sg" sem="d:dimb t:hum r:propn der:s t:persn" sem2=""/><ana lex="лена" gr="S,f,gen,inan,norm,sg" sem="" sem2="r:propn t:topon"/>Лены</w> <w><ana lex="явиться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus" sem2="ca:noncaus t:move"/>явился</w> <w><ana lex="посланец" gr="S,anim,m,nom,norm,sg" sem="der:v t:hum r:concr d:nag" sem2=""/>посланец</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="помощник" gr="S,anim,gen,m,norm,sg" sem="der:v t:hum r:concr d:nag" sem2="der:v t:hum r:concr d:nag"/>помощника</w> <w><ana lex="военный" gr="A,gen,m,norm,plen,sg" sem="dt:abstr dt:inter r:rel der:s" sem2="dt:abstr dt:inter r:rel der:s"/>военного</w> <w><ana lex="министр" gr="S,anim,gen,m,norm,sg" sem="t:hum r:concr" sem2=""/>министра</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="хадак" gr="S,bastard,inan,ins,m,sg" sem="" sem2=""/>хадаком</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="карточка" gr="S,f,inan,ins,norm,sg" sem="qc:stuff r:concr" sem2="der:s t:doc r:concr t:workart d:dim"/>карточкой</w>, <w><ana lex="гласить" gr="V,act,f,ins,ipf,norm,partcp,plen,praes,sg,tran" sem="" sem2=""/>гласящей</w>: «<w><ana lex="князь" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr" sem2="t:hum r:concr"/>Князь</w> <w><ana lex="максаржать" gr="V,act,bastard,ger,intr,pf,praet" sem="" sem2=""/>Максаржав</w>, <w><ana lex="товарищ" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr" sem2="t:hum r:concr"/>товарищ</w> <w><ana lex="военный" gr="A,gen,m,norm,plen,sg" sem="dt:abstr dt:inter r:rel der:s" sem2="dt:abstr dt:inter r:rel der:s"/>Военного</w> <w><ana lex="министр" gr="S,anim,gen,m,norm,sg" se