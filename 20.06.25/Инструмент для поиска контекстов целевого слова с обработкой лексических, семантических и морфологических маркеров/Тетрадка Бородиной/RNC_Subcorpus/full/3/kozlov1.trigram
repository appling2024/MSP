<p><se><w><ana lex="прибыть" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus t:move d:pref" sem2="d:pref"/>Прибыли</w> <w><ana lex="верблюд" gr="S,anim,m,nom,norm,pl" sem="t:animal r:concr" sem2=""/>верблюды</w>: <w><ana lex="все" gr="SPRO,inan,n,nom,norm,sg" sem="" sem2=""/>все</w> <w><ana lex="обстоять" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="d:pref" sem2=""/>обстоит</w> <w><ana lex="благополучный" gr="A,brev,n,norm,sg" sem="" sem2=""/>благополучно</w>.</se><se> <w><ana lex="худяков" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Худяков</w> <w><ana lex="убить" gr="V,act,indic,m,norm,pf,praet,sg" sem="t:impact ca:caus t:be:disapp d:pref" sem2="ca:caus d:pref t:be:disapp"/>убил</w> <w><ana lex="молодой" gr="A,acc,anim,m,norm,plen,sg" sem="t:time:age r:qual" sem2="t:time:age r:qual"/>молодого</w> <w><ana lex="u" gr="bastard" sem="" sem2=""/>U</w> <w><ana lex="узерек" gr="S,anim,bastard,gen,m,persn,sg" sem="" sem2=""/><ana lex="узерек" gr="S,bastard,gen,inan,m,sg" sem="" sem2=""/>узерека</w> (<w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="стадо" gr="S,gen,inan,n,norm,sg" sem="pt:set r:concr sc:animal" sem2="sc:hum sc:animal pt:set pt:aggr ev:neg r:concr"/>стада</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="четыре" gr="NUM,acc,inan,norm" sem="r:card:pauc" sem2=""/>четыре</w> <w><ana lex="голова" gr="S,f,gen,inan,norm,sg" sem="pt:partb pc:animal r:concr pc:hum" sem2="t:ment pt:qtm r:abstr qc:aggr qc:food pc:x pt:part r:concr t:fam"/>головы</w>).</se><se> <w><ana lex="обильный" gr="A,m,nom,norm,plen,sg" sem="t:quant:max r:qual" sem2="t:quant:max r:qual"/>Обильный</w> <w><ana lex="снег" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2=""/>снег</w> <w><ana lex="нарушить" gr="V,act,indic,m,norm,pf,praet,sg" sem="d:pref" sem2="d:pref"/>нарушил</w> <w><ana lex="равновесие" gr="S,acc,inan,n,norm,sg" sem="r:abstr" sem2="r:abstr"/>равновесие</w> <w><ana lex="животный" gr="A,f,gen,n