<p><se><b/><w><b>23</b></w><b>/</b><w><ana lex="viii" gr="bastard" sem="" sem2=""/><b>VIII</b></w><b>, </b><w><ana lex="v" gr="bastard" sem="" sem2=""/><b>V</b></w><b/>. <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="встать" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus d:pref t:move:body" sem2="d:pref"/>встали</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="5" gr="NUM,ciph"/>5</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w> <w><ana lex="утро" gr="S,gen,inan,n,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утра</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="тотчас" gr="ADV,norm" sem="der:comp" sem2=""/>тотчас</w> <w><ana lex="пойти" gr="V,act,indic,intr,norm,pf,pl,praet" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/>пошли</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="стрельба" gr="S,acc,f,inan,norm,sg" sem="t:impact der:v r:abstr der:s0" sem2="t:sport r:abstr"/>стрельбу</w>.</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w>общем</w>, <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="довольный" gr="A,brev,m,norm,sg" sem="t:psych:emot r:qual" sem2=""/>доволен</w>: <w><ana lex="стрелять" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="der:s" sem2="t:impact:destr ca:caus t:be:disapp t:poss ca:0 t:sound der:s ca:noncaus t:physiol"/>стреляли</w> <w><ana lex="порядочно" gr="ADV,norm" sem="t:quant:max dt:humq der:a" sem2=""/>порядочно</w>, <w><ana lex="ружье" gr="S,inan,n,nom,norm,pl" sem="t:tool:weapon r:concr" sem2=""/>ружья</w> <w><ana lex="также" gr="PART,norm" sem="" sem2=""/>также</w> <w><ana lex="порядочный" gr="A,nom,norm,pl,plen" sem="ev:posit t:humq r:qual" sem2="t:degr:max r:qual"/>порядочные</w>.</se><se> <w><ana lex="котик" gr="S,anim,m,nom,norm,sg" sem="d:dim t:animal r:concr der:s" sem2=""/><ana lex="котик" gr="S,inan,m,nom,norm,sg" sem="" sem2="der:shift t:stuff r:concr t:fam"/>Котик</w> -- <w><ana lex="молодец" gr="S,anim,m,nom,norm,sg" sem="t:hum ev:posit r:concr der:a" sem2="t:hum ev:posit r:concr"/><ana lex="молодец" gr="S,anim,m,nom,norm,sg" sem="t:hum ev:posit r:concr der:a" sem2="t:hum ev:posit r:concr"/>молодец</w>, <w><ana lex="наш" gr="APRO,n,nom,norm,sg" sem="r:poss" sem2=""/>наше</w> <w><ana lex="дело" gr="S,inan,n,nom,norm,sg" sem="r:abstr" sem2="sc:doc ev:posit r:abstr t:org der:v r:concr"/>дело</w> <w><ana lex="стрелковый" gr="A,n,nom,norm,plen,sg" sem="der:v dt:be:disapp r:rel dt:impact:destr" sem2=""/>стрелковое</w> <w><ana lex="наладиться" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="ca:noncaus d:pref" sem2=""/>наладится</w>.</se></p>
<p><se><w><ana lex="день" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>Днем</w> <w><ana lex="различный" gr="A,acc,inan,norm,pl,plen" sem="r:qual" sem2=""/>различные</w> <w><ana lex="дело" gr="S,acc,inan,n,norm,pl" sem="r:abstr" sem2="sc:doc ev:posit r:abstr t:org der:v r:concr"/>дела</w>, <w><ana lex="вечер" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>вечером</w> -- <w><ana lex="лекция" gr="S,f,inan,nom,norm,sg" sem="t:action r:abstr" sem2="r:concr t:text"/>лекция</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="отделение" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr der:s0" sem2="pc:org pt:set pc:contain t:org r:abstr der:v sc:hum pt:part pc:action r:concr"/>отделении</w> <w><ana lex="рго" gr="S,0,anim,bastard,m,sg" sem="" sem2=""/><ana lex="рго" gr="S,0,anim,bastard,m,persn,sg" sem="" sem2=""/>РГО</w> <w><ana lex="пройти" gr="V,act,f,indic,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="пройти" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="проходить" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2=""/>прошла</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="успех" gr="S,inan,ins,m,norm,sg" sem="ev:posit r:abstr" sem2="ev:posit r:abstr"/>успехом</w>, <w><ana lex="при" gr="PR,norm" sem="" sem2=""/>при</w> <w><ana lex="большой" gr="A,loc,n,norm,plen,sg" sem="t:size:max r:qual" sem2="t:quant:max t:time:age t:degr:max r:qual"/>большом</w> <w><ana lex="стечение" gr="S,inan,loc,n,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="sc:hum der:v pt:aggr r:concr r:abstr"/>стечении</w> <w><ana lex="слушатель" gr="S,anim,gen,m,norm,pl" sem="der:v t:hum r:concr d:nag" sem2="der:v t:hum r:concr d:nag"/>слушателей</w>; <w><ana lex="быть" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>были</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="старый" gr="A,nom,norm,pl,plen" sem="t:time:age:max r:qual" sem2="t:time:dur t:time r:qual"/>старые</w> <w><ana lex="знакомый" gr="S,anim,m,nom,norm,pl" sem="der:v t:hum r:concr der:subst" sem2=""/>знакомые</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="который" gr="APRO,ins,norm,pl" sem="r:rel t:ord" sem2=""/>которыми</w> <w><ana lex="встретиться" gr="V,act,inf,intr,norm,pf" sem="ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>встретиться</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="весьма" gr="ADV,norm" sem="t:degr:max" sem2=""/>весьма</w> <w>приятно</w>.</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="заключение" gr="S,acc,inan,n,norm,sg" sem="t:put der:v r:abstr der:s0" sem2="t:text t:ment:result t:put pt:phase r:abstr der:v pc:workmus pt:part pc:text r:concr"/>заключение</w> <w><ana lex="вечер" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>вечер</w> <w><ana lex="прекрасный" gr="A,m,nom,norm,plen,sg" sem="ev:posit t:appearance r:qual" sem2="ev:posit t:quality r:qual"/>прекрасный</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="милый" gr="S,acc,anim,m,norm,sg" sem="" sem2="t:hum ev:posit der:a r:concr der:subst"/>милого</w> <w>П</w>. <w>С</w>. <w><ana lex="михно" gr="S,0,anim,bastard,famn" sem="t:hum r:propn t:famn" sem2=""/><ana lex="михно" gr="S,0,anim,bastard,persn" sem="t:hum r:propn t:famn" sem2=""/>Михно</w>!</se><se> <w><ana lex="здесь" gr="ADVPRO,norm" sem="t:place r:dem" sem2="t:time r:dem"/>Здесь</w>, <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="обыкновение" gr="S,dat,inan,n,norm,sg" sem="r:abstr" sem2=""/>обыкновению</w>, <w><ana lex="засидеться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="