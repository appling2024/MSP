<p><se><w><ana lex="возвратиться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2=""/>Возвратился</w> <w><ana lex="убугунов" gr="S,anim,bastard,famn,m,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Убугунов</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="облава" gr="S,f,gen,inan,norm,sg" sem="r:abstr" sem2="r:abstr"/>облавы</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="урочище" gr="S,inan,loc,n,norm,sg" sem="t:space r:concr" sem2=""/>урочище</w> <w><ana lex="баин" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Баин-булак-гол</w>.</se><se> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>Не</w> <w><ana lex="стрелять" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="der:s" sem2="t:impact:destr ca:caus t:be:disapp t:poss ca:0 t:sound der:s ca:noncaus t:physiol"/>стрелял</w>.</se><se> <w><ana lex="видеть" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="ca:noncaus t:perc d:root" sem2="t:ment ca:noncaus d:root"/>Видели</w> <w><ana lex="немало" gr="NUM,norm" sem="" sem2=""/>немало</w> <w><ana lex="косуля" gr="S,f,gen,inan,norm,pl" sem="" sem2="t:tool:instr r:concr"/><ana lex="косуля" gr="S,anim,f,gen,norm,pl" sem="t:animal r:concr" sem2=""/>косуль</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="результат" gr="S,inan,loc,m,norm,sg" sem="r:abstr" sem2="r:abstr"/>результате</w>: <w><ana lex="монгол" gr="S,anim,m,nom,norm,sg" sem="" sem2=""/>монгол</w> <w><ana lex="убить" gr="V,act,indic,m,norm,pf,praet,sg" sem="t:impact ca:caus t:be:disapp d:pref" sem2="ca:caus d:pref t:be:disapp"/>убил</w> <w><ana lex="коза" gr="S,acc,anim,f,norm,sg" sem="t:animal r:concr" sem2=""/>козу</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w>прочие</w> <w><ana lex="промахнуться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>промахнулись</w>.</se><se> <w><ana lex="быть" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="t:be:exist ca:noncaus 