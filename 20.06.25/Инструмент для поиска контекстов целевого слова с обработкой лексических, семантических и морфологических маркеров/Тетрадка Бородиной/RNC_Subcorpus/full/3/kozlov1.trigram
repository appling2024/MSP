<p><se><w><ana lex="вечер" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечером</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="я" gr="SPRO,1p,gen,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>были</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="першин" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Першин</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="батуев" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Батуев</w> <w><ana lex="николай" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Николай</w> <w><ana lex="иванович" gr="S,anim,m,nom,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Иванович</w>.</se><se> <w><ana lex="последний" gr="A,m,nom,norm,plen,sg" sem="r:rel t:ord" sem2="t:degr:max:magn r:qual r:rel ev:neg t:time"/>Последний</w> -- <w><ana lex="восточник" gr="S,anim,m,nom,norm,sg" sem="d:masc t:hum r:concr der:s" sem2=""/>восточник</w>, <w><ana lex="знать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/>знает</w> <w><ana lex="я" gr="SPRO,1p,acc,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="мой" gr="APRO,dat,norm,pl" sem="r:poss" sem2=""/>моим</w> <w><ana lex="работа" gr="S,dat,f,inan,norm,pl" sem="der:v r:abstr" sem2="sc:x t:text t:workdram t:workmus r:abstr t:workart der:v pt:aggr t:workcin r:concr"/>работам</w>, <w><ana lex="прийти" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/><ana lex="придти" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="" sem2=""/>пришел</w> <w><ana lex="познакомиться" gr="V,act,inf,intr,norm,pf" sem="ca:noncaus d:pref" sem2=""/>познакомиться</w> <w><ana lex="и" gr="CO