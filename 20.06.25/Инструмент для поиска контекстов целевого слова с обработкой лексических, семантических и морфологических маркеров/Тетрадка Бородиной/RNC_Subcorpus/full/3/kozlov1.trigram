<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w> <w><ana lex="укатить" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="укатить" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/>укатил</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="заветный" gr="A,acc,f,norm,plen,sg" sem="der:s:deverb dt:abstr r:rel dt:speech" sem2="der:s:deverb dt:abstr r:rel dt:speech"/>заветную</w> <w><ana lex="страна" gr="S,acc,f,inan,norm,sg" sem="t:space r:concr" sem2="t:space r:concr"/>страну</w> <w><ana lex="мой" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>мой</w> <w><ana lex="буддист" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr der:s" sem2=""/>буддист-спутник</w> <w><ana lex="шакдур" gr="S,bastard,inan,m,nom,sg" sem="" sem2=""/><ana lex="шакдур" gr="S,anim,bastard,m,nom,persn,sg" sem="" sem2=""/><ana lex="шакдур" gr="S,anim,bastard,m,nom,sg" sem="" sem2=""/><ana lex="шакдур" gr="S,anim,bastard,m,nom,persn,sg" sem="" sem2=""/><ana lex="шакдур" gr="S,anim,bastard,famn,m,nom,sg" sem="" sem2=""/><ana lex="шакдур" gr="S,bastard,inan,m,nom,sg" sem="" sem2=""/>Шакдур</w> <w><ana lex="эрдэниев" gr="S,anim,bastard,famn,m,nom,sg" sem="" sem2=""/><ana lex="эрдэниев" gr="S,anim,bastard,m,nom,persn,sg" sem="" sem2=""/>Эрдэниев</w> <w><ana lex="вместе" gr="ADV,norm" sem="t:quant:abs" sem2="t:time"/>вместе</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="небольшой" gr="A,ins,m,norm,plen,sg" sem="d:neg r:rel t:size:min dt:size:max der:a" sem2="t:degr:min d:neg der:a dt:size:max r:qual"/>небольшим</w> <w><ana lex="караван" gr="S,inan,ins,m,norm,sg" sem="pt:set r:concr sc:animal" sem2="pt:set sc:tool:transp sc:stuff r:concr sc:aggr"/>караваном</w> <w><ana lex="гэгэн" gr="S,anim,bastard,gen,m,sg" sem="" sem2=""/>гэгэна-тибетца</w>.</se><se> <w><ana lex="сильно" gr="ADV,norm" sem="dt:physq t:degr:max der:a" sem2="dt:physq der:a"/>Сильно</w> <w><ana lex="порываться" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="der:v ca:noncaus d:pref d:impf" sem2="der:v ca:noncaus d:pref d:impf"/>порывался</w> <w><ana lex="уехать" gr="V,act,inf,intr,norm,pf" sem="ca:noncaus t:move d:pref" sem2=""/>уехать</w> <w><ana lex="наш" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>наш</w> <w><ana lex="галсан" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Галсан</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="он" gr="SPRO,3p,dat,m,norm,sg" sem="r:pers" sem2=""/>ему</w> <w><ana lex="подрезать" gr="V,act,indic,m,norm,pf,praet,sg,tran" sem="t:impact ca:caus d:pref" sem2="t:impact ca:caus d:pref"/>подрезал</w> <w><ana lex="крылышко" gr="S,acc,inan,n,norm,pl" sem="t:food pc:animal der:s d:dim pt:partb r:concr" sem2=""/>крылышки</w> <w><ana lex="дониро" gr="S,bastard,gen,inan,n,pl" sem="" sem2=""/>донир</w> -- <w><ana lex="представитель" gr="S,anim,m,nom,norm,sg" sem="der:v t:hum r:concr d:nag" sem2="der:v t:hum r:concr d:nag"/>представитель</w> <w><ana lex="тибетский" gr="A,f,gen,norm,plen,sg" sem="dt:topon r:rel der:s t:topon" sem2=""/>Тибетской</w> <w><ana lex="миссия" gr="S,f,gen,inan,norm,sg" sem="r:abstr" sem2="t:group pt:set sc:hum r:concr t:org"/>миссии</w> <w><ana lex="чжойня" gr="S,bastard,f,gen,inan,sg" sem="" sem2=""/>Чжойни-Лусан-Чиндэ</w>.</se><se> <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>А</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w>, <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="весь" gr="APRO,nom,norm,pl" sem="r:spec" sem2=""/>все</w> <w><ana lex="еще" gr="ADV,norm" sem="" sem2=""/>еще</w> <w><ana lex="стоять" gr="V,1p,act,indic,intr,ipf,norm,pl,praes" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:noncaus"/><ana lex="стоить" gr="V,1p,act,indic,ipf,norm,pl,praes" sem="d:root" sem2="d:root"/>стоим</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="место" gr="S,inan,loc,n,norm,sg" sem="qc:space t:space r:concr" sem2="qc:space sc:org t:tool t:space pt:element r:abstr pt:aggr:aggrpl pt:part pc:text r:concr"/>месте</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="ждать" gr="V,1p,act,indic,ipf,norm,pl,praes,tran" sem="d:root" sem2="d:root"/>ждем</w> «<w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="море" gr="S,gen,inan,n,norm,sg" sem="top:contain t:reservoir t:space r:concr" sem2="t:quant:max der:shift pt:qtm r:abstr"/>моря</w> <w><ana lex="погода" gr="S,f,gen,inan,norm,sg" sem="r:abstr t:weather" sem2=""/>погоды</w>», <w><ana lex="лишь" gr="PART,norm" sem="" sem2=""/>лишь</w> <w><ana lex="сергей" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Сергей</w> <w><ana lex="александрович" gr="S,anim,m,nom,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2="t:hum r:propn t:famn"/><ana lex="александрович" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum t:patrn r:propn der:s" sem2="t:hum r:propn t:famn"/>Александрович</w> <w><ana lex="добыть" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus d:pref t:poss" sem2="der:v d:pref"/>добыл</w> ...</se></p>
<p><se><b/><w><b>9</b></w><b>/</b><w><ana lex="xii" gr="bastard" sem="" sem2=""/><b>XII</b></w><b>, </b><w><ana lex="q" gr="bastard" sem="" sem2=""/><b>Q</b></w><b/>. <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w>: <w>ясно</w>, <w>холодно</w>!</se><se> <w><ana lex="вчера" gr="ADV,norm" sem="t:time" sem2=""/>Вчера</w>, <w><ana lex="возвращаться" gr="V,act,ger,intr,ipf,norm,praes" sem="der:v d:pref" sem2=""/>возвращаясь</w> <w><ana lex="около" gr="PR,norm" sem="" sem2=""/>около</w> <w><ana lex="три" gr="NUM,gen,norm" sem="r:card:pauc" sem2=""/>трех</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w> <w><ana lex="ночь" gr="S,f,gen,inan,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2=""/>ночи</w> <w><ana lex="со" gr="PR,norm" sem="" sem2=""/>со</w> <w><ana lex="спектакль" gr="S,gen,inan,m,norm,sg" sem="t:action r:abstr" sem2="r:abstr"/>спектакля</w>, <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="любоваться" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="ca:noncaus t:perc" sem2=""/>любовался</w> <w><ana lex="чудный" gr="A,ins,n,norm,plen,sg" sem="dt:abstr ev:posit r:rel" sem2="dt:abstr ev:posit t:quality der:s r:qual"/><ana lex="чудной" gr="A,ins,n,norm,plen,sg" sem="dt:abstr t:humq ev:neg r:qual" sem2=""/>чудным</w> <w><ana lex="зимний" gr="A,ins,n,norm,plen,sg" sem="dt:time dt:abstr dt:time:season der:s t:time r:rel" sem2=""/>зимним</w> <w><ana lex="небо" gr="S,inan,ins,n,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/><ana lex="небо" gr="S,inan,ins,n,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/>небом</w>!</se><se> <w><ana lex="созвездие" gr="S,acc,inan,n,norm,sg" sem="t:space t:astr sc:space:astr pt:set der:s r:concr" sem2="t:group pt:set r:concr sc:hum der:s"/>Созвездие</w> <w><ana lex="орион" gr="S,anim,gen,m,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Ориона</w> <w>неописуемо</w>, <w><ana lex="весь" gr="APRO,f,nom,norm,sg" sem="r:spec" sem2=""/>вся</w> <w>прочая</w>, <w><ana lex="сравнительно" gr="ADV,norm" sem="dt:degr der:a" sem2=""/>сравнительно</w> <w><ana lex="малый" gr="A,f,nom,norm,plen,sg" sem="t:size:min r:qual" sem2="t:time:age:min t:size:min r:qual"/>малая</w> <w><ana lex="компания" gr="S,f,inan,nom,norm,sg" sem="t:group pt:set r:concr sc:hum" sem2="r:concr t:org"/>компания</w> <w><ana lex="перевернуться" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref"/>перевернулась</w>, <w><ana lex="опуститься" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/>опустилась</w>, <w><ana lex="изменить" gr="V,act,f,indic,norm,pf,praet,sg" sem="der:v d:pref" sem2="der:v d:pref"/><ana lex="изменить" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v d:pref" sem2="der:v d:pref"/>изменила</w> <w><ana lex="положение" gr="S,acc,inan,n,norm,sg" sem="t:space r:abstr" sem2="t:ment pt:set t:text r:abstr t:loc:body t:loc r:concr sc:text"/>положение</w> <w><ana lex="настолько" gr="ADV,norm" sem="der:adv r:dem" sem2=""/>настолько</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="сразу" gr="ADV,norm" sem="t:time" sem2="ev der:s"/>сразу</w> <w><ana lex="даже" gr="PART,norm" sem="" sem2=""/>даже</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="разобрать" gr="V,2p,act,fut,indic,norm,pf,sg" sem="d:pref" sem2="ca:caus ca:0 d:pref t:poss"/>разберешь</w> <w><ana lex="топография" gr="S,f,gen,inan,norm,sg" sem="r:abstr" sem2="r:abstr"/>топографии</w> <w><ana lex="небо" gr="S,gen,inan,n,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/