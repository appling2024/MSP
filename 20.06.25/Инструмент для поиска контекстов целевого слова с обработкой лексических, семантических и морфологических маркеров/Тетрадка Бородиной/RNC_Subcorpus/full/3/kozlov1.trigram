<p><se><w><ana lex="юдин" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Юдин</w> <w><ana lex="вторично" gr="ADV,norm" sem="der:a" sem2=""/>вторично</w> <w><ana lex="телеграфировать" gr="V,act,indic,m,norm,pf,praet,sg,tran" sem="der:s" sem2=""/><ana lex="телеграфировать" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="der:s" sem2=""/>телеграфировал</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="пекин" gr="S,acc,inan,m,norm,sg" sem="r:propn t:topon" sem2=""/>Пекин</w> <w><ana lex="карахан" gr="S,anim,bastard,dat,m,persn,sg" sem="t:hum r:propn t:famn t:persn" sem2=""/>Карахану</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="необходимость" gr="S,f,inan,loc,norm,sg" sem="r:abstr der:a" sem2=""/>необходимости</w> <w><ana lex="выслать" gr="V,act,inf,norm,pf" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus t:move d:pref"/>выслать</w> <w><ana lex="тибетский" gr="A,f,gen,norm,plen,sg" sem="dt:topon r:rel der:s t:topon" sem2=""/>Тибетской</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w> <w><ana lex="китайский" gr="A,m,nom,norm,plen,sg" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>китайский</w> <w><ana lex="охранный" gr="A,m,nom,norm,plen,sg" sem="r:rel der:s" sem2="r:rel der:s"/>охранный</w> <w><ana lex="лист" gr="S,inan,m,nom,norm,sg" sem="pc:plant r:concr pt:part" sem2="t:doc qc:stuff pt:qtm r:abstr t:unit r:concr"/><ana lex="лист" gr="S,inan,m,nom,norm,sg" sem="pc:plant r:concr pt:part" sem2="t:doc qc:stuff pt:qtm r:abstr t:unit r:concr"/>лист</w>!</se><se> <w><ana lex="посмотреть" gr="V,1p,act,fut,indic,norm,pf,pl,tran" sem="ca:noncaus d:pref t:perc" sem2="d:pref"/><ana lex="посмотреть" gr="V,1p,act,imper,norm,pf,pl,tran" sem="ca:noncaus d:pref t:perc" sem2="d:pref"/>Посмотрим</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="выйти" gr="V,3p,act,fut,in