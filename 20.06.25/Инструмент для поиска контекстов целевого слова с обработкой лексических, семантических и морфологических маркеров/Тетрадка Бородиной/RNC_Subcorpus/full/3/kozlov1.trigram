inan,loc,n,norm,sg" sem="r:abstr t:param t:time" sem2="t:time:period r:abstr t:time"/>времени</w> <w><ana lex="7" gr="NUM,ciph"/>7</w>-<w><ana lex="часовой" gr="S,anim,gen,m,norm,sg" sem="t:hum r:concr der:s" sem2=""/>часового</w> <w><ana lex="метеорологический" gr="A,gen,n,norm,plen,sg" sem="r:rel der:s" sem2="r:rel der:s"/>метеорологического</w> <w><ana lex="наблюдение" gr="S,gen,inan,n,norm,sg" sem="der:v t:perc r:abstr" sem2=""/>наблюдения</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="все" gr="ADV,norm" sem="" sem2=""/>все</w> <w>много</w>, <w><ana lex="продуктивно" gr="ADV,norm" sem="der:a" sem2=""/>продуктивно</w> <w><ana lex="работать" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="der:s" sem2="der:s"/>работали</w>, <w><ana lex="поэтому" gr="ADVPRO,norm" sem="der:apro r:dem" sem2=""/>поэтому</w> <w><ana lex="зима" gr="S,f,inan,nom,norm,sg" sem="t:time:season r:abstr t:time" sem2="t:fam"/>зима</w> <w><ana lex="пройти" gr="V,act,f,indic,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="пройти" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="проходить" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2=""/>прошла</w> <w><ana lex="быстро" gr="ADV,norm" sem="dt:speed:max ev der:a" sem2="t:speed:max dt:speed:max ev der:a"/>быстро</w>.</se><se> <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>А</w> <w><ana lex="здесь" gr="ADVPRO,norm" sem="t:place r:dem" sem2="t:time r:dem"/>здесь</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="урга" gr="S,f,inan,loc,norm,sg" sem="r:propn t:topon" sem2=""/>Урге</w> ...</se>!</p>
<p><se><w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>Я</w> <w><ana lex="выезжать" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="ca:noncaus t:move d:pref" sem2=""/><ana lex="выезжать" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="ca:noncaus t:move d:pref" sem2=""/><ana lex="выезжать" gr="V,act,indic,ipf,m,norm,praet,sg" sem="ca:noncaus t:move d:pref" sem2=""/><ana lex="выезживать" gr="V,act,indic,ipf,m,norm,praet,sg" sem="der:v d:pref d:impf" sem2=""/>выезжал</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="город" gr="S,acc,inan,m,norm,sg" sem="sc:constr:build t:space r:concr" sem2="t:space r:concr"/>город</w> <w><ana lex="прогуляться" gr="V,act,inf,intr,norm,pf" sem="ca:noncaus t:move d:pref" sem2=""/>прогуляться</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="купить" gr="V,act,inf,norm,pf" sem="ca:noncaus d:root t:poss" sem2="der:shift d:root"/>купить</w> <w><ana lex="немного" gr="NUM,acc,norm" sem="" sem2=""/>немного</w> <w><ana lex="услада" gr="S,f,gen,inan,norm,pl" sem="ev:posit r:abstr" sem2=""/>услад</w> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="ида" gr="S,anim,f,gen,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Иды</w> <w><ana lex="павловна" gr="S,anim,f,gen,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Павловны</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="себе" gr="SPRO,gen,norm" sem="" sem2=""/>себя</w>.</se></p>
