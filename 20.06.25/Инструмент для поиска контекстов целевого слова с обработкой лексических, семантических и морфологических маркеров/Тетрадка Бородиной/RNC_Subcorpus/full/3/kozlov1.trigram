ca:noncaus der:v d:pref"/>разгадать</w> <w><ana lex="иногда" gr="ADV,norm" sem="r:spec t:time" sem2=""/>иногда</w> <w><ana lex="долго" gr="ADV,norm" sem="t:time:dur:max dt:time:dur:max der:a" sem2=""/>долго</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="разгадывать" gr="V,ipf,n,nom,norm,partcp,pass,plen,praes,sg,tran" sem="der:v d:pref d:impf" sem2=""/>разгадываемое</w>!</se></p>
<p><se><b/><w><b>7</b></w><b>/</b><w><ana lex="ii" gr="bastard" sem="" sem2=""/><b>II</b></w><b>, </b><w><ana lex="v" gr="bastard" sem="" sem2=""/><b>V</b></w><b/>. <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w> <w><ana lex="прекрасный" gr="A,n,nom,norm,plen,sg" sem="ev:posit t:appearance r:qual" sem2="ev:posit t:quality r:qual"/>прекрасное</w>, <w><ana lex="солнце" gr="S,inan,n,nom,norm,sg" sem="top:horiz top:spher t:astr t:space r:concr" sem2="ev:posit t:space r:concr r:abstr t:light"/>солнце</w>, <w><ana lex="прозрачность" gr="S,f,gen,inan,norm,sg" sem="r:abstr der:a" sem2=""/>прозрачности</w> <w><ana lex="воздух" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>воздуха</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w>много</w>.</se><se> <w><ana lex="узко" gr="ADV,comp,norm" sem="dt:size:min der:a" sem2="dt:size:min der:a"/><ana lex="уже" gr="ADV,norm" sem="t:time" sem2=""/>Уже</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="вершина" gr="S,dat,f,inan,norm,pl" sem="t:fam r:concr pc:x pt:part der:s" sem2=""/>вершинам</w> <w><ana lex="северный" gr="A,gen,norm,pl,plen" sem="t:place dt:space r:rel der:s" sem2=""/>северных</w> <w><ana lex="гребень" gr="S,gen,inan,m,norm,pl" sem="t:tool:instr r:concr" sem2="t:tool pc:animal pc:tool:device r:abstr pc:x pt:part pt:partb r:concr"/>гребней</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="верхний" gr="A,loc,norm,pl,plen" sem="t:place dt:space der:s r:qual" sem2="dt:space der:s r:qual t:place t:species r:rel"/>верхних</w> <w><ana lex="южный" gr="A,loc,norm,pl,plen" sem="t:place dt:space r:rel der:s" sem2=""/>южных</w> <w><ana lex="склон" gr="S,inan,loc,m,norm,pl" sem="t:space top:slope der:v top:form pt:part pc:space r:concr" sem2=""/>склонах</w> <w><ana lex="появляться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v d:pref" sem2=""/>появляется</w> <w>больше</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w>больше</w> <w><ana lex="темный" gr="A,gen,norm,pl,plen" sem="t:physq:color r:qual" sem2="t:humq t:physq:color ev:neg r:qual"/>темных</w>, <w><ana lex="свободный" gr="A,gen,norm,pl,plen" sem="der:s t:humq:char r:qual" sem2="t:size:max der:s r:qual"/>свободных</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="снег" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2=""/>снега</w> <w><ana lex="пространство" gr="S,gen,inan,n,norm,pl" sem="t:space r:concr hi:class" sem2="top:gape t:space r:concr r:abstr hi:class"/>пространств</w>.</se></p>
<p><se><w><ana lex="как" gr="ADVPRO,norm" sem="r:rel t:manner" sem2=""/>Как</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="вчера" gr="ADV,norm" sem="t:time" sem2=""/>вчера</w>, <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>сегодня</w> <w>много</w> <w><ana lex="гость" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr" sem2="t:hum der:shift r:concr"/>гостей</w>.</se><se> <w><ana lex="бурят" gr="S,anim,m,nom,norm,pl" sem="" sem2=""/>Буряты-земляки</w> <w><ana lex="явиться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus" sem2="ca:noncaus t:move"/>явились</w> <w><ana lex="гурьба" gr="S,f,inan,ins,norm,sg" sem="t:group pt:set ev r:concr sc:hum" sem2=""/>гурьбой</w>, <w><ana lex="человек" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr" sem2="t:hum ev:posit r:concr"/>человек</w> <w><ana lex="25" gr="NUM,ciph"/>25</w>, <w><ana lex="все" gr="ADV,norm" sem="" sem2=""/>все</w> <w><ana lex="молодежь" gr="S,f,inan,nom,norm,sg" sem="sc:hum pt:aggr r:concr der:a" sem2=""/>молодежь</w>: <w><ana lex="мужчина" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr der:s" sem2="t:hum r:concr der:s"/>мужчины</w>, <w><ana lex="женщина" gr="S,anim,f,nom,norm,pl" sem="t:hum r:concr" sem2=""/>женщины</w>, <w><ana lex="девушка" gr="S,anim,f,nom,norm,pl" sem="t:hum r:concr der:s" sem2="t:hum r:concr der:s"/>девушки</w>.</se><se> <w><ana lex="преобладающий" gr="A,m,nom,norm,plen,sg" sem="der:v r:rel" sem2=""/>Преобладающий</w> <w><ana lex="цвет" gr="S,inan,m,nom,norm,sg" sem="t:color sc:part pc:plant r:abstr pt:aggr pt:part r:concr" sem2="sc:hum pt:aggr r:concr pt:part"/>цвет</w> <w><ana lex="одеяние" gr="S,gen,inan,n,norm,pl" sem="der:v pt:aggr r:concr sc:tool:cloth hi:class" sem2=""/>одеяний</w> -- <w><ana lex="синий" gr="A,m,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:physq:color r:qual"/>синий</w>.</se><se> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>Мне</w> <w><ana lex="весьма" gr="ADV,norm" sem="t:degr:max" sem2=""/>весьма</w> <w>приятно</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="весь" gr="APRO,nom,norm,pl" sem="r:spec" sem2=""/>все</w> <w><ana lex="этот" gr="APRO,nom,norm,pl" sem="r:dem" sem2=""/>эти</w> <w><ana lex="бурят" gr="S,anim,m,nom,norm,pl" sem="" sem2=""/>буряты</w> <w><ana lex="прямо" gr="ADV,norm" sem="ev:posit dt:physq:form t:dir der:a" sem2="dt:physq:form der:a"/>прямо</w> <w><ana lex="подходить" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus t:move d:pref" sem2=""/>подходят</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="говорить" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="t:speech ca:noncaus d:root" sem2="d:root"/>говорят</w>: «<w><ana lex="ноин" gr="S,anim,famn,m,nom,norm,sg" sem="" sem2=""/>Ноин</w> <w><ana lex="козлов" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/><ana lex="козлов" gr="S,inan,m,nom,norm,sg" sem="" sem2="r:propn t:topon"/>Козлов</w>, <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="все" gr="ADV,norm" sem="" sem2=""/>все</w> <w><ana lex="вы" gr="SPRO,2p,acc,norm,pl" sem="r:pers" sem2=""/>Вас</w> <w><ana lex="знать" gr="V,1p,act,indic,ipf,norm,pl,praes,tran" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/>знаем</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="больший" gr="A,nom,norm,pl,plen" sem="d:compar t:size:max der:a dt:size:max r:qual" sem2=""/><ana lex="большой" gr="A,nom,norm,pl,plen" sem="t:size:max r:qual" sem2="t:quant:max t:time:age t:degr:max r:qual"/>большие</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="малый" gr="A,nom,norm,pl,plen" sem="t:size:min r:qual" sem2="t:time:age:min t:size:min r:qual"/>малые</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="поздравлять" gr="V,1p,act,indic,ipf,norm,pl,praes,tran" sem="der:v d:pref" sem2=""/>поздравляем</w> <w><ana lex="вы" gr="SPRO,2p,acc,norm,pl" sem="r:pers" sem2=""/>Вас</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="цаган" gr="S,anim,bastard,m,nom,sg" sem="t:hum r:propn t:persn" sem2=""/>Цаган-сар</w>.</se><se> <w><ana lex="вы" gr="SPRO,2p,nom,norm,pl" sem="r:pers" sem2=""/>Вы</w> <w><ana lex="наш" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>наш</w>!</se><se>». <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>Очень</w> <w>приятно</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="много" gr="ADV,comp,norm" sem="t:quant:max r:spec" sem2="t:degr:max"/><ana lex="более" gr="ADV,norm" sem="t:degr:max der:adv" sem2="t:degr:max"/>более</w> <w><ana lex="развитый" gr="A,nom,norm,pl,plen" sem="der:v r:rel" sem2=""/><ana lex="развитой" gr="A,nom,norm,pl,plen" sem="der:v dt:changest t:degr:max r:qual" sem2="der:v dt:changest r:qual"/>развитые</w> <w><ana lex="бурят" gr="S,anim,m,nom,norm,pl" sem="" sem2=""/>буряты</w> <w><ana lex="всегда" gr="ADVPRO,norm" sem="r:spec t:time" sem2=""/>всегда</w> <w><ana lex="говорить" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="t:speech ca:noncaus d:root" sem2="d:root"/>говорят</w> <w><ana lex="один" gr="APRO,acc,n,norm,sg" sem="" sem2="r:indet"/>одно</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="тот" gr="APRO,acc,n,norm,sg" sem="r:dem" sem2=""/>то</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w>: «<w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>Мы</w> <w><ana lex="ваш" gr="APRO,acc,f,norm,sg" sem="r:poss" sem2=""/>вашу</w> <w><ana lex="книга" gr="S,acc,f,inan,norm,sg" sem="t:media r:concr t:text" sem2="pc:text t:book r:concr t:text pt:part"/>книгу</w> <w><ana lex="читать" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="d:root" sem2="d:root"/>читали</w>!</se>».</p>
