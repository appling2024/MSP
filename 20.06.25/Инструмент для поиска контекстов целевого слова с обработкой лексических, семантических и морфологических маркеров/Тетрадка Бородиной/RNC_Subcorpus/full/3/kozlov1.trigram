<p><se><w><ana lex="день" gr="S,inan,m,nom,norm,pl" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>Дни</w> <w><ana lex="бежать" gr="V,3p,act,fut,indic,intr,norm,pf,pl" sem="ca:noncaus t:move d:root" sem2="d:root"/><ana lex="бежать" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus t:move d:root" sem2="d:root"/>бегут</w>, <w><ana lex="томление" gr="S,acc,inan,n,norm,sg" sem="der:v t:psych:emot r:abstr" sem2=""/>томление</w> <w><ana lex="пшевочка" gr="S,anim,bastard,gen,m,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Пшевочки</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="калганский" gr="A,f,loc,norm,plen,sg" sem="r:rel der:s" sem2=""/>калганской</w> <w><ana lex="дыра" gr="S,f,inan,loc,norm,sg" sem="t:space r:concr top:hole" sem2="t:space sc:space pt:part ev:neg pc:space r:concr"/>дыре</w> <w><ana lex="продолжаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:be:exist ca:noncaus der:v d:pref" sem2=""/>продолжается</w>.</se><se> <w><ana lex="чувствовать" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="ca:noncaus t:perc der:s" sem2="der:s"/>Чувствую</w> <w><ana lex="сильный" gr="A,m,nom,norm,plen,sg" sem="t:physq d:habit r:qual" sem2="ev:posit t:humq:char der:s t:degr:max r:qual r:rel"/>сильный</w> <w><ana lex="гнев" gr="S,inan,m,nom,norm,sg" sem="r:abstr" sem2=""/>гнев</w> <w><ana lex="мой" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/>моего</w> <w><ana lex="родной" gr="A,gen,m,norm,plen,sg" sem="t:humq:char r:qual" sem2="ev:posit t:social:emot t:humq:char r:qual"/>родного</w> <w><ana lex="мальчик" gr="S,anim,gen,m,norm,sg" sem="t:hum r:concr" sem2="t:hum r:concr"/>мальчика</w>, <w><ana lex="мой" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/>моего</w> <w><ana lex="спутник" gr="S,anim,gen,m,norm,sg" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,gen,inan,m,norm,sg" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутника</w> (<w><ana lex="весь" gr="APRO,n,no