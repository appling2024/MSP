<p><se><w><ana lex="вечер" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечер</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>был</w> <w><ana lex="превосходный" gr="A,m,nom,norm,plen,sg" sem="ev:posit t:quality r:qual" sem2="r:qual"/>превосходный</w>: <w><ana lex="тихий" gr="A,m,nom,norm,plen,sg" sem="d:neg t:sound r:qual" sem2="d:neg t:humq t:speed:min der:shift t:sound r:qual"/>тихий</w>, <w><ana lex="ясный" gr="A,m,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясный</w>, <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="холодный" gr="A,m,nom,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодный</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="ринчина" gr="S,acc,bastard,inan,m,sg" sem="" sem2=""/>Ринчино</w> (<w><ana lex="супруга" gr="S,anim,f,gen,norm,sg" sem="" sem2=""/>супруги</w>) <w><ana lex="проводить" gr="V,act,indic,norm,pf,pl,praet" sem="ca:caus t:move d:pref" sem2="d:pref"/><ana lex="проводить" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="ca:caus t:move d:pref" sem2="d:pref"/><ana lex="провести" gr="V,act,indic,norm,pf,pl,praet,tran" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="проводить" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="ca:caus t:move d:pref" sem2="d:pref"/><ana lex="проводить" gr="V,act,indic,norm,pf,pl,praet,tran" sem="ca:caus t:move d:pref" sem2="d:pref"/>проводили</w> <w><ana lex="мы" gr="SPRO,1p,acc,norm,pl" sem="r:pers" sem2=""/>нас</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="самый" gr="APRO,gen,m,norm,sg" sem="r:spec" sem2="r:spec"/><ana lex="сам" gr="APRO,gen,m,norm,sg" sem="r:spec" sem2=""/>самого</w> <w><ana lex="дом" gr="S,gen,inan,m,norm,sg" sem="top:contain t:constr:build r:conc