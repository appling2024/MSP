<p><se><w><ana lex="общий" gr="A,m,nom,norm,plen,sg" sem="r:rel t:general" sem2="t:social r:rel"/>Общий</w> <w><ana lex="вид" gr="S,anim,famn,m,nom,norm,sg" sem="" sem2=""/><ana lex="вид" gr="S,inan,m,nom,norm,sg" sem="der:v r:abstr" sem2="t:ment t:space r:abstr t:workart der:v t:perc r:concr t:fam"/>вид</w> <w><ana lex="верблюд" gr="S,anim,gen,m,norm,pl" sem="t:animal r:concr" sem2=""/>верблюдов</w> <w><ana lex="вполне" gr="ADV,norm" sem="dt:full t:degr:max der:a" sem2=""/>вполне</w> <w><ana lex="удовлетворительный" gr="A,brev,m,norm,sg" sem="" sem2=""/>удовлетворителен</w>, <w><ana lex="они" gr="SPRO,3p,nom,norm,pl" sem="r:pers" sem2=""/>они</w> <w><ana lex="подтянутый" gr="A,brev,norm,pl" sem="" sem2=""/>подтянуты</w>, <w><ana lex="отлично" gr="ADV,norm" sem="ev:posit dt:degr:max der:a" sem2=""/>отлично</w> «<w><ana lex="вывязать" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="der:v ca:caus d:pref t:impact:creat" sem2=""/>вывязаны</w>».</se><se> <w>Жаль</w> <w><ana lex="они" gr="SPRO,acc,anim,norm,pl" sem="r:pers" sem2=""/>их</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="весь" gr="APRO,f,gen,norm,sg" sem="r:spec" sem2=""/>всей</w> <w><ana lex="душа" gr="S,f,gen,inan,norm,sg" sem="pc:hum r:concr" sem2=""/>души</w> <w><ana lex="номад" gr="S,anim,gen,m,norm,sg" sem="t:hum r:concr" sem2=""/>номада</w>.</se><se> <w><ana lex="помнить" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="t:ment ca:noncaus d:pref" sem2=""/>Помню</w> <w><ana lex="отлично" gr="ADV,norm" sem="ev:posit dt:degr:max der:a" sem2=""/>отлично</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="какой" gr="APRO,loc,n,norm,sg" sem="t:neg r:rel ev:neg" sem2=""/>каком</w> <w><ana lex="радостный" gr="A,loc,n,norm,plen,sg" sem="dt:psych:emot ev:posit t:psych:emot der:s r:qual" sem2="dt:psych:emot ev:posit t:psych:emot der:s r:qual"/>радостном</w> <w><ana lex="состояние" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr der:s0" sem2="sc:thing ev:posit t:psych r:abstr der:shi