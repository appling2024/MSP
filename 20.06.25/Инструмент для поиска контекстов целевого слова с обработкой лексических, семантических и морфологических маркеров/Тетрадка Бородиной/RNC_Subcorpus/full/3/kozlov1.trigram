n,sg" sem="r:rel der:s" sem2="r:rel der:s"/>научного</w> <w><ana lex="работник" gr="S,anim,gen,m,norm,sg" sem="der:v t:hum ev:posit r:concr d:nag" sem2="der:v t:hum r:concr d:nag t:prof"/>работника</w>.</se><se> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>Я</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>был</w> <w><ana lex="ошеломить" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="ca:caus d:pref t:psych:emot" sem2=""/>ошеломлен</w>, <w><ana lex="пришибить" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="t:impact ca:caus d:pref" sem2="d:pref"/>пришиблен</w>, <w><ana lex="словно" gr="CONJ,norm" sem="" sem2=""/>словно</w> <w><ana lex="ударить" gr="V,m,nom,norm,partcp,pass,pf,plen,praet,sg" sem="t:impact ca:caus ca:0 d:pref" sem2="t:impact ca:noncaus d:pref t:sound"/>ударенный</w> <w><ana lex="обух" gr="S,inan,ins,m,norm,sg" sem="pc:tool:instr r:concr pt:part" sem2=""/>обухом</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="голова" gr="S,f,inan,loc,norm,sg" sem="pt:partb pc:animal r:concr pc:hum" sem2="t:ment pt:qtm r:abstr qc:aggr qc:food pc:x pt:part r:concr t:fam"/>голове</w>.</se><se> <w><ana lex="кто" gr="SPRO,acc,anim,m,norm,sg" sem="r:rel" sem2=""/>Кого</w> <w>угодно</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="только" gr="PART,norm" sem="" sem2=""/>только</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="глаголева" gr="S,anim,f,famn,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Глаголева</w>.</se><se> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>Мне</w> <w><ana lex="казаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v ca:noncaus t:perc" sem2="t:ment ca:noncaus der:v"/>кажется</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="если" gr="CONJ,norm" sem="" sem2=""/>если</w> <w><ana lex="сильно" gr="ADV,norm" sem="dt:physq t:degr:max der:a" sem