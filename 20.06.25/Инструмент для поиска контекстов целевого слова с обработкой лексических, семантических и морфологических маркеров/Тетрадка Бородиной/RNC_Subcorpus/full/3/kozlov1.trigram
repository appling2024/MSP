<p><se><w><ana lex="помыт" gr="S,bastard,gen,inan,m,pl" sem="" sem2=""/><ana lex="помыт" gr="S,anim,bastard,gen,m,pl" sem="" sem2=""/>Помытов</w> (<w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="сопровождение" gr="S,inan,loc,n,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="sc:hum der:v pt:aggr r:concr r:abstr"/>сопровождении</w> <w>Гомбо</w> <w><ana lex="бадмажапова" gr="S,anim,bastard,f,famn,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Бадмажапова</w>) <w><ana lex="поехать" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/>поехал</w> <w><ana lex="отвезти" gr="V,act,inf,norm,pf" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus t:move d:pref"/>отвезти</w> <w><ana lex="подарок" gr="S,acc,inan,m,norm,pl" sem="der:v t:thing r:concr" sem2="t:thing ev:posit r:concr r:abstr"/>подарки</w> <w><ana lex="два" gr="NUM,dat,norm" sem="r:card:pauc" sem2=""/>двум</w> <w><ana lex="лицо" gr="S,dat,inan,n,norm,pl" sem="pt:partb r:concr pc:hum" sem2="pc:tool:cloth t:space r:concr r:abstr"/><ana lex="лицо" gr="S,anim,dat,n,norm,pl" sem="" sem2="t:hum r:concr hi:class"/>лицам</w>: <w><ana lex="князь" gr="S,anim,dat,m,norm,pl" sem="t:hum r:concr" sem2="t:hum r:concr"/>князьям</w> <w><ana lex="чжамьян" gr="S,anim,bastard,m,nom,persn,sg" sem="" sem2=""/>Чжамьян-гуну</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="министр" gr="S,anim,dat,m,norm,sg" sem="t:hum r:concr" sem2=""/>министру</w> <w><ana lex="юстиция" gr="S,f,gen,inan,norm,sg" sem="r:abstr" sem2="sc:org pt:aggr r:concr"/>юстиции</w> <w><ana lex="сон" gr="S,anim,bastard,ins,m,persn,sg" sem="" sem2=""/><ana lex="сон" gr="S,bastard,inan,ins,m,sg" sem="t:physiol r:abstr" sem2="r:abstr"/><ana lex="сон" gr="S,anim,bastard,ins,m,sg" sem="" sem2=""/><ana lex="сон" gr="S,anim,bastard,ins,m,persn,sg" sem="" sem2=""/><ana lex="сон" gr="S,anim,bastard,famn,ins,m,sg" sem="" sem2=""/><ana lex="сон" gr="S,bastard,inan,ins,m,sg" sem="t:ph