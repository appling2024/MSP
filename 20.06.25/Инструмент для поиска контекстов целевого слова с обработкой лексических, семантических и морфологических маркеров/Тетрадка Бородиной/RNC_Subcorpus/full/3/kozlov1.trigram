<p><se><b/><w><b>14</b></w><b>/</b><w><ana lex="xi" gr="bastard" sem="" sem2=""/><b>XI</b></w><b>, </b><w><ana lex="s" gr="bastard" sem="" sem2=""/><b>S</b></w><b/>. <w><ana lex="облачность" gr="S,f,inan,nom,norm,sg" sem="r:abstr der:a" sem2="qc:stuff pt:aggr t:stuff r:concr sc:qtm"/>Облачность</w> <w><ana lex="преобладать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="d:pref" sem2=""/>преобладает</w> <w><ana lex="день" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>днем</w>, <w><ana lex="чистота" gr="S,f,inan,nom,norm,sg" sem="r:abstr der:a" sem2="r:abstr"/>чистота</w> <w><ana lex="небо" gr="S,gen,inan,n,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/><ana lex="небо" gr="S,gen,inan,n,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/>неба</w> -- <w><ana lex="ночь" gr="S,f,inan,ins,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2=""/>ночью</w>.</se><se> <w><ana lex="однажды" gr="ADV,norm" sem="t:freq der:anum" sem2="der:anum t:time"/>Однажды</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="глубина" gr="S,f,inan,loc,norm,sg" sem="r:abstr t:param t:size" sem2="t:degr t:space der:a r:abstr der:shift pt:part pc:space r:concr"/>глубине</w> <w><ana lex="массив" gr="S,gen,inan,m,norm,sg" sem="pt:set t:space r:concr sc:space" sem2="pt:set sc:constr:build t:space r:concr sc:plant"/>массива</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="наблюдать" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="ca:noncaus d:pref t:perc" sem2="d:pref"/>наблюдал</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="темнота" gr="S,f,inan,loc,norm,sg" sem="t:neg r:abstr t:light" sem2=""/>темноте</w> <w><ana lex="ночь" gr="S,f,gen,inan,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2=""/>ночи</w> <w><ana lex="яркий" gr="A,m