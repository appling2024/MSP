<p><se><w><ana lex="наконец" gr="ADV,PARENTH,norm" sem="der:s t:time" sem2=""/>Наконец-то</w> <w><ana lex="звонить" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:impact ca:noncaus t:sound" sem2="ev:neg"/>звонит</w> <w><ana lex="телефон" gr="S,inan,m,nom,norm,sg" sem="t:tool:device r:concr" sem2="r:concr t:text r:abstr"/>телефон</w>, <w><ana lex="дуда" gr="S,acc,f,inan,norm,sg" sem="t:tool:mus r:concr" sem2="t:tool:mus r:concr t:fam"/>Дуду</w> <w><ana lex="сообщать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="d:pref der:a" sem2=""/>сообщает</w>: «<w><ana lex="лошадь" gr="S,anim,f,nom,norm,pl" sem="t:animal r:concr" sem2=""/>Лошади</w> <w><ana lex="готовый" gr="A,brev,norm,pl" sem="" sem2=""/>готовы</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="1" gr="NUM,ciph"/>1</w> <w><ana lex="час" gr="S,acc,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>час</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дня</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="вы" gr="SPRO,2p,nom,norm,pl" sem="r:pers" sem2=""/>Вы</w> <w><ana lex="мочь" gr="V,2p,act,indic,intr,ipf,norm,pl,praes" sem="d:root" sem2=""/>можете</w> <w><ana lex="ехать" gr="V,act,inf,intr,ipf,norm" sem="ca:noncaus t:move d:root" sem2="d:root"/>ехать</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="сангина" gr="S,f,gen,inan,norm,pl" sem="" sem2=""/>Сангин</w>!</se><se>». <w><ana lex="это" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>Это</w> <w><ana lex="хороший" gr="A,brev,n,norm,sg" sem="ev:posit t:quality r:qual" sem2="ev:posit ev t:degr:max r:qual"/>хорошо</w> -- <w>можно</w> <w><ana lex="собраться" gr="V,act,inf,intr,norm,pf" sem="ca:noncaus t:move d:pref" sem2="ca:noncaus d:pref t:psych:volit"/>собраться</w>.</se></p>
<p><se><b/><w><b>3</b></w><b>/</b><w><ana lex="ii" gr="bastard" sem="" sem2=""/><b>II</b></w><b>, </b><w><ana lex="q" gr="bastard" sem="" sem2=""/><b>Q</b></w><b/>. <w><ana lex="около" gr="PR,norm" sem="" sem2=""/>Около</w> <w><ana lex="3" gr="NUM,ciph"/>3</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дня</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="узко" gr="ADV,comp,norm" sem="dt:size:min der:a" sem2="dt:size:min der:a"/><ana lex="уже" gr="ADV,norm" sem="t:time" sem2=""/>уже</w> <w><ana lex="дома" gr="ADV,norm" sem="t:place der:s" sem2=""/>дома</w>, <w><ana lex="прибыть" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2="d:pref"/>прибыл</w> <w><ana lex="вместе" gr="ADV,norm" sem="t:quant:abs" sem2="t:time"/>вместе</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="дуда" gr="S,acc,f,inan,norm,sg" sem="t:tool:mus r:concr" sem2="t:tool:mus r:concr t:fam"/>Дуду</w>, <w><ana lex="милый" gr="A,ins,m,norm,plen,sg" sem="t:humq r:qual" sem2="ev:posit t:social:emot r:qual"/>милым</w> <w><ana lex="андрей" gr="S,anim,ins,m,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Андреем</w> <w><ana lex="александрович" gr="S,anim,ins,m,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2="t:hum r:propn t:famn"/><ana lex="александрович" gr="S,anim,famn,ins,m,norm,sg" sem="t:hum t:patrn r:propn der:s" sem2="t:hum r:propn t:famn"/>Александровичем</w>.</se><se> <w><ana lex="день" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>День</w> <w><ana lex="прелестный" gr="A,m,nom,norm,plen,sg" sem="ev:posit der:s dt:hum r:qual" sem2=""/>прелестный</w>, <w><ana lex="прозрачный" gr="A,m,nom,norm,plen,sg" sem="t:physq r:rel" sem2="t:physq r:rel r:qual"/>прозрачный</w>, <w><ana lex="ясный" gr="A,m,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясный</w>, <w><ana lex="тихий" gr="A,m,nom,norm,plen,sg" sem="d:neg t:sound r:qual" sem2="d:neg t:humq t:speed:min der:shift t:sound r:qual"/>тихий</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="довольно" gr="ADV,norm" sem="t:degr dt:humq der:a" sem2="ev:posit dt:humq der:a"/>довольно</w> <w><ana lex="теплый" gr="A,m,nom,norm,plen,sg" sem="dt:temper dt:abstr t:physq:temper der:s r:qual" sem2="ev:posit t:physq:color dt:temper t:physq:temper dt:abstr der:s r:qual r:rel"/>теплый</w>.</se><se> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>Мы</w> <w><ana lex="пробыть" gr="V,act,indic,intr,norm,pf,pl,praet" sem="d:pref" sem2=""/>пробыли</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="дорога" gr="S,f,inan,loc,norm,sg" sem="top:stripe t:space r:concr t:fam" sem2="t:move dt:space r:abstr der:shift t:space r:concr"/>дороге</w> <w><ana lex="около" gr="PR,norm" sem="" sem2=""/>около</w> <w><ana lex="два" gr="NUM,gen,norm" sem="r:card:pauc" sem2=""/><ana lex="два" gr="NUM,acc,anim,f,norm" sem="r:card:pauc" sem2=""/><ana lex="два" gr="NUM,acc,anim,m,norm" sem="r:card:pauc" sem2=""/><ana lex="два" gr="NUM,loc,norm" sem="r:card:pauc" sem2=""/>двух</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="ехать" gr="V,act,ger,intr,ipf,norm,praes" sem="ca:noncaus t:move d:root" sem2="d:root"/>едучи</w> <w><ana lex="любоваться" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="ca:noncaus t:perc" sem2=""/>любовались</w> <w><ana lex="северный" gr="A,ins,m,norm,plen,sg" sem="t:place dt:space r:rel der:s" sem2=""/>северным</w> <w><ana lex="склон" gr="S,inan,ins,m,norm,sg" sem="t:space top:slope der:v top:form pt:part pc:space r:concr" sem2=""/>склоном</w> <w><ana lex="богдо" gr="ADV,bastard" sem="" sem2=""/>Богдо-улы</w>.</se></p>
<p><se><w><ana lex="ну" gr="PART,norm" sem="" sem2=""/>Ну</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w>теперь</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="порядок" gr="S,dat,inan,m,norm,sg" sem="ev:posit r:abstr" sem2="sc:hum ev:posit r:concr r:abstr t:asp:move"/>порядку</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="полдень" gr="S,gen,inan,m,norm,sg" sem="r:abstr t:time" sem2="t:space r:concr"/>полудня</w> <w><ana lex="31" gr="NUM,ciph"/>31</w>/<w>I</w>. <w><ana lex="около" gr="PR,norm" sem="" sem2=""/>Около</w> <w><ana lex="1" gr="NUM,ciph"/>1</w> <w><ana lex="час" gr="S,gen,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часа</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дня</w> <w><ana lex="наш" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>наш</w> <w><ana lex="дамба" gr="S,f,inan,nom,norm,sg" sem="t:space t:constr r:concr top:dam" sem2=""/>Дамба</w> <w><ana lex="доставить" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:caus t:move d:pref" sem2="d:pref"/>доставил</w> <w><ana lex="я" gr="SPRO,1p,acc,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="ветеринарный" gr="A,acc,n,norm,plen,sg" sem="r:rel der:s dt:hum" sem2=""/>Ветеринарное</w> <w><ana lex="управление" gr="S,acc,inan,n,norm,sg" sem="der:v r:abstr der:s0" sem2="sc:tool:device r:abstr t:org pc:tool:device der:v pt:aggr pt:part r:concr"/>управление</w>, <w><ana lex="где" gr="ADVPRO,norm" sem="t:place r:rel" sem2="t:place r:indet"/>где</w> <w><ana lex="я" gr="SPRO,1p,acc,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="встретить" gr="V,act,indic,m,norm,pf,praet,sg" sem="d:pref" sem2="d:pref"/>встретил</w> <w><ana lex="андрей" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Андрей</w> <w><ana lex="александрович" gr="S,anim,m,nom,norm,patrn,sg