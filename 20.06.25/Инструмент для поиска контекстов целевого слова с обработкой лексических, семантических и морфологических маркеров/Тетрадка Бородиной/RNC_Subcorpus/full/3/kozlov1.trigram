<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="воздух" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>воздух</w> <w><ana lex="необычайно" gr="ADV,norm" sem="ev:posit dt:degr:max t:degr:max der:a" sem2=""/>необычайно</w> <w><ana lex="прозрачный" gr="A,brev,m,norm,sg" sem="" sem2="r:qual"/>прозрачен</w>.</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="такой" gr="APRO,loc,norm,pl" sem="r:dem" sem2="r:indet r:spec t:degr:max"/>таких</w> <w><ana lex="случай" gr="S,inan,loc,m,norm,pl" sem="pt:qtm r:abstr" sem2="t:time:moment r:abstr"/>случаях</w> <w><ana lex="стараться" gr="V,2p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus d:root" sem2="ca:noncaus d:root"/>стараешься</w> <w><ana lex="смотреть" gr="V,act,inf,ipf,norm,tran" sem="ca:noncaus d:pref t:perc" sem2="ca:noncaus d:pref t:perc"/>смотреть</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="соседний" gr="A,acc,inan,m,norm,plen,sg" sem="t:dist r:rel der:s dt:hum" sem2=""/>соседний</w> <w><ana lex="священный" gr="A,acc,inan,m,norm,plen,sg" sem="ev r:rel" sem2="r:rel"/>священный</w> <w><ana lex="массив" gr="S,acc,inan,m,norm,sg" sem="pt:set t:space r:concr sc:space" sem2="pt:set sc:constr:build t:space r:concr sc:plant"/>массив</w> <w><ana lex="богдо" gr="ADV,bastard" sem="" sem2=""/>Богдо-ула</w>.</se><se> <w><ana lex="помимо" gr="PR,norm" sem="" sem2=""/>Помимо</w> <w>прочих</w> <w><ana lex="яркий" gr="A,gen,norm,pl,plen" sem="t:physq:light r:qual" sem2="ev:posit t:physq:color r:qual"/>ярких</w> <w><ana lex="краска" gr="S,f,gen,inan,norm,pl" sem="t:impact der:v r:abstr der:s0" sem2="der:v t:impact t:stuff r:concr r:abstr"/>красок</w> <w><ana lex="рельефно" gr="ADV,norm" sem="" sem2=""/>рельефно</w> <w><ana lex="заметный" gr="A,brev,m,norm,sg" sem="der:v r:qual" sem2="der:v t:humq:char r:qual"/>заметен</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="золотистый" gr="A,