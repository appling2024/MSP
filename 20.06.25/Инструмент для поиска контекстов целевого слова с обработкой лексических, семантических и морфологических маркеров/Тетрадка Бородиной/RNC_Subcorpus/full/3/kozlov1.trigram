<p><se><w><ana lex="день" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>Днем</w> <w><ana lex="тот" gr="APRO,acc,n,norm,sg" sem="r:dem" sem2=""/>то</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="дело" gr="S,acc,inan,n,norm,sg" sem="r:abstr" sem2="sc:doc ev:posit r:abstr t:org der:v r:concr"/>дело</w> <w><ana lex="раздаваться" gr="V,act,f,indic,intr,ipf,norm,praet,sg" sem="d:pref" sem2=""/>раздавалась</w> <w><ana lex="стрельба" gr="S,f,inan,nom,norm,sg" sem="t:impact der:v r:abstr der:s0" sem2="t:sport r:abstr"/>стрельба</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="пушка" gr="S,f,inan,nom,norm,pl" sem="t:tool:weapon r:concr" sem2="t:tool:device r:concr r:abstr r:phras"/>пушки</w>: <w><ana lex="это" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>это</w> <w><ana lex="праздновать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="" sem2=""/>празднует</w> <w><ana lex="богдо" gr="ADV,bastard" sem="" sem2=""/>Богдо-гэгэн</w> <w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w> <w><ana lex="свой" gr="APRO,gen,n,norm,sg" sem="r:poss" sem2="t:social r:poss"/>своего</w> <w><ana lex="рождение" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0 t:be:appear" sem2="der:shift t:time:moment r:abstr"/>рождения</w>.</se><se> <w><ana lex="вечер" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечером</w> <w><ana lex="при" gr="PR,norm" sem="" sem2=""/>при</w> <w><ana lex="тот" gr="APRO,f,loc,norm,sg" sem="r:dem" sem2=""/>той</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w> <w><ana lex="пальба" gr="S,f,inan,loc,norm,sg" sem="t:impact der:v r:abstr der:s0" sem2=""/>пальбе</w> <w><ana lex="он" gr="SPRO,3p,m,nom,norm,sg" sem="r:pers" sem2=""/>он</w> <w><ana lex="делать" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="d:root" sem2="d:root"/>делал</w> <w>