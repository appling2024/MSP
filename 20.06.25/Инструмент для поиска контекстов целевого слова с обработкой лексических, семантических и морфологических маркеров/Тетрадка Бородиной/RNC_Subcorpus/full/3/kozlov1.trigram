<p><se><w><ana lex="вечер" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечером</w> <w><ana lex="прибыть" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2="d:pref"/>прибыла</w> <w><ana lex="последний" gr="A,f,nom,norm,plen,sg" sem="r:rel t:ord" sem2="t:degr:max:magn r:qual r:rel ev:neg t:time"/>последняя</w> <w><ana lex="партия" gr="S,f,inan,nom,norm,sg" sem="r:concr t:org" sem2="sc:x pt:set t:org r:abstr t:group pc:workmus sc:hum pt:part r:concr"/>партия</w> <w><ana lex="верблюд" gr="S,anim,gen,m,norm,pl" sem="t:animal r:concr" sem2=""/>верблюдов</w> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="экспедиция" gr="S,f,inan,loc,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w>общем</w> <w><ana lex="много" gr="ADV,comp,norm" sem="t:quant:max r:spec" sem2="t:degr:max"/><ana lex="более" gr="ADV,norm" sem="t:degr:max der:adv" sem2="t:degr:max"/>более</w> <w><ana lex="сытый" gr="A,f,nom,norm,plen,sg" sem="t:physiol r:rel" sem2="r:rel r:qual"/>сытая</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="нарядный" gr="A,f,nom,norm,plen,sg" sem="dt:tool r:rel der:s dt:tool:cloth" sem2="dt:tool r:rel der:s dt:tool:cloth"/>нарядная</w>.</se><se> <w><ana lex="рост" gr="S,inan,m,nom,norm,sg" sem="der:v t:changest t:physiol r:abstr" sem2="der:v t:changest t:physiol r:abstr t:param"/>Рост</w> <w><ana lex="этот" gr="APRO,gen,norm,pl" sem="r:dem" sem2=""/>этих</w> <w><ana lex="животное" gr="S,anim,gen,n,norm,pl" sem="der:subst t:animal der:a r:concr hi:class" sem2="der:subst t:animal r:concr der:a"/>животных</w> <w><ana lex="средний" gr="A,m,nom,norm,plen,sg" sem="t:degr r:qual" sem2="r:qual r:rel t:humq t:size"/>средний</w>, <w><ana lex="упитанность" gr="S,f,inan,nom,norm,sg" sem="r:abstr der:a" sem2=""/>упитанность</w> -- <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="хороший" gr="A,f,nom,norm,plen,sg" sem="ev:posit t:quality r:qual" sem2="ev:posit ev t:degr:max r:qual"/>хорошая</w>.</se><se> <w>Надо</w> <w><ana lex="внимательно" gr="ADV,norm" sem="ev:posit dt:humq der:a" sem2=""/>внимательно</w> <w><ana lex="рассмотреть" gr="V,act,inf,norm,pf" sem="der:v ca:noncaus d:pref t:perc" sem2="der:v d:pref"/>рассмотреть</w>, <w><ana lex="исследовать" gr="V,act,inf,norm,pf,tran" sem="t:ment ca:noncaus d:pref" sem2="d:pref"/><ana lex="исследовать" gr="V,act,inf,ipf,norm,tran" sem="t:ment ca:noncaus d:pref" sem2="d:pref"/>исследовать</w> <w><ana lex="они" gr="SPRO,acc,anim,norm,pl" sem="r:pers" sem2=""/>их</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="отделить" gr="V,act,inf,norm,pf" sem="d:pref" sem2="d:pref"/>отделить</w> <w><ana lex="необходимый" gr="A,acc,n,norm,plen,sg" sem="der:v d:modal r:qual" sem2="r:rel d:modal"/>необходимое</w> <w><ana lex="количество" gr="S,acc,inan,n,norm,sg" sem="t:quant r:abstr" sem2="r:abstr"/>количество</w>.</se><se> <w>Теперь</w> <w><ana lex="вот" gr="PART,norm" sem="" sem2="r:dem"/>вот</w> <w><ana lex="что" gr="ADVPRO,norm" sem="r:rel" sem2=""/>что</w>: <w><ana lex="скольким" gr="NUM,norm" sem="" sem2=""/>сколько</w> <w><ana lex="мы" gr="SPRO,1p,dat,norm,pl" sem="r:pers" sem2=""/>нам</w> <w>нужно</w> <w><ana lex="купить" gr="V,act,inf,norm,pf" sem="ca:noncaus d:root t:poss" sem2="der:shift d:root"/>купить</w> <w><ana lex="непременно" gr="ADV,norm" sem="der:a" sem2=""/>непременно</w> <w><ana lex="верблюд" gr="S,anim,gen,m,norm,pl" sem="t:animal r:concr" sem2=""/>верблюдов</w> -- <w><ana lex="55" gr="NUM,ciph"/>55</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="60" gr="NUM,ciph"/>60</w>?</se><se> <w>Можно</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem