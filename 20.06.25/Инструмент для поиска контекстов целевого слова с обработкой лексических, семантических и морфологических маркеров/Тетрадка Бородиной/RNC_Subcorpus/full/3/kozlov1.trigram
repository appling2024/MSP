<p class="footnote"><se><sup><w><ana lex="13" gr="NUM,ciph"/>13</w></sup> <w><ana lex="статья" gr="S,f,inan,nom,norm,sg" sem="r:concr t:text" sem2="t:hier t:text r:abstr pt:part pc:text r:concr"/>Cтатья</w> <w>С</w>. <w>А</w>. <w><ana lex="кондратьева" gr="S,anim,f,famn,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Кондратьева</w>: «<w><ana lex="монгольский" gr="A,f,nom,norm,plen,sg" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>Монгольская</w> <w><ana lex="музыка" gr="S,f,inan,nom,norm,sg" sem="r:abstr" sem2="t:sound r:abstr t:fam"/>музыка</w>» <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="копия" gr="S,f,gen,inan,norm,sg" sem="t:thing r:concr" sem2="ev r:concr"/>копии</w> <w><ana lex="быть" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>будет</w> <w><ana lex="доставить" gr="V,brev,f,norm,partcp,pass,pf,praet,sg" sem="ca:caus t:move d:pref" sem2="d:pref"/>доставлена</w> <w><ana lex="рго" gr="S,0,anim,bastard,m,sg" sem="" sem2=""/><ana lex="рго" gr="S,0,anim,bastard,m,persn,sg" sem="" sem2=""/>РГО</w> <w><ana lex="главнаука" gr="S,bastard,f,inan,loc,sg" sem="r:propn t:org" sem2=""/>Главнауке</w> <w><ana lex="одновременно" gr="ADV,norm" sem="dt:time der:a t:time" sem2=""/>одновременно</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="мой" gr="APRO,f,ins,norm,sg" sem="r:poss" sem2=""/>моей</w> <w><ana lex="статья" gr="S,f,inan,ins,norm,sg" sem="r:concr t:text" sem2="t:hier t:text r:abstr pt:part pc:text r:concr"/>статьей</w> «<w><ana lex="гора" gr="S,f,inan,nom,norm,sg" sem="top:hill t:space r:concr" sem2="sc:x pt:set t:space t:form r:abstr t:quant:max r:concr"/>Гора</w> <w><ana lex="богдо" gr="ADV,bastard" sem="" sem2=""/>Богдо-ула</w>».</se> </p>
