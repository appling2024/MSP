<p><se><w><ana lex="странный" gr="A,n,nom,norm,plen,sg" sem="r:qual" sem2=""/>Странное</w> <w><ana lex="явление" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr der:s0" sem2="pc:workdram t:text r:abstr der:v t:manif pt:part r:concr"/>явление</w>: <w><ana lex="лес" gr="S,inan,m,nom,norm,sg" sem="pt:set t:space r:concr sc:plant" sem2="t:form pt:aggr t:stuff r:concr sc:qtm"/>лес</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="громадный" gr="A,loc,n,norm,plen,sg" sem="t:degr:max r:qual" sem2=""/>громадном</w> <w><ana lex="протяжение" gr="S,inan,loc,n,norm,sg" sem="r:abstr t:param t:size" sem2=""/>протяжении</w> <w><ana lex="испогадить" gr="V,bastard,brev,ipf,m,partcp,pass,praet,sg,tran" sem="" sem2=""/><ana lex="испогадить" gr="V,bastard,brev,m,partcp,pass,pf,praet,sg" sem="" sem2=""/><ana lex="испогадить" gr="V,bastard,brev,m,partcp,pass,pf,praet,sg,tran" sem="" sem2=""/><ana lex="испогадить" gr="V,bastard,brev,m,partcp,pass,pf,praet,sg" sem="" sem2=""/>испогажен</w>, <w><ana lex="огнь" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr" sem2=""/>огонь</w> <w><ana lex="гулять" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="ca:noncaus t:move d:root" sem2="d:root"/>гулял</w> <w>везде</w>, <w><ana lex="оставить" gr="V,act,ger,norm,pf,praet" sem="t:loc d:pref ca:caus" sem2="d:pref"/>оставив</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="себе" gr="SPRO,ins,norm" sem="" sem2=""/>собою</w> <w><ana lex="поблекнуть" gr="V,act,intr,nom,norm,partcp,pf,pl,plen,praet" sem="der:a dt:physq:color der:v t:changest ca:noncaus d:pref" sem2=""/>поблекшие</w> <w><ana lex="огромный" gr="A,acc,inan,norm,pl,plen" sem="t:size:max r:qual" sem2="t:quant:max t:degr:max r:qual"/>огромные</w> <w><ana lex="полоса" gr="S,acc,f,inan,norm,pl" sem="t:form t:space r:concr" sem2="qc:space t:plot qc:land t:space t:text dt:form qc:text t:form t:time:period pt:qtm r:abstr der:shift top:stripe pc:media pt:part qc:plant r:concr"/>полосы</w>.</se></p>
