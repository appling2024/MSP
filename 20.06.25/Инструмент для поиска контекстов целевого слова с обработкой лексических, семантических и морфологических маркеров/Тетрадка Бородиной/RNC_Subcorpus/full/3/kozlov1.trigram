<p><se><b/><w><b>20</b></w><b>/</b><w><ana lex="ix" gr="bastard" sem="" sem2=""/><b>IX</b></w><b/>.</se><se> <w><ana lex="вечер" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечер</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="отделение" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr der:s0" sem2="pc:org pt:set pc:contain t:org r:abstr der:v sc:hum pt:part pc:action r:concr"/>отделении</w> <w><ana lex="географический" gr="A,gen,n,norm,plen,sg" sem="r:rel der:s" sem2=""/>Географического</w> <w><ana lex="общество" gr="S,gen,inan,n,norm,sg" sem="sc:hum pt:aggr r:concr" sem2="sc:hum pt:aggr r:concr t:org r:abstr"/>общества</w>, <w><ana lex="доклад" gr="S,inan,m,nom,norm,sg" sem="t:speech r:abstr" sem2="t:speech der:v r:concr r:abstr t:text"/>доклад</w> <w><ana lex="кондратьев" gr="S,anim,famn,gen,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Кондратьева</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="генетический" gr="A,dat,f,norm,plen,sg" sem="r:rel der:s" sem2=""/>генетической</w> <w><ana lex="связь" gr="S,dat,f,inan,norm,sg" sem="r:abstr t:inter" sem2="sc:org pt:set r:abstr sc:thing t:inter der:v pt:aggr pc:constr pt:part r:concr"/>связи</w> <w><ana lex="музыка" gr="S,f,gen,inan,norm,sg" sem="r:abstr" sem2="t:sound r:abstr t:fam"/>музыки</w> <w><ana lex="европа" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2="t:pers"/>Европы</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="музыка" gr="S,f,inan,ins,norm,sg" sem="r:abstr" sem2="t:sound r:abstr t:fam"/>музыкой</w> <w><ana lex="азия" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Азии</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="задача" gr="S,f,inan,loc,norm,pl" sem="t:ment r:abstr" sem2="t:ment r:abstr"/>задачах</w> <w><ana lex="предстоящий" gr="A,gen,norm,pl,plen" sem="der:v r:rel t:time" sem2=""/>предстоящих</w> <w><ana lex="работа" gr="S,f,gen,inan,norm,pl" sem="der:v r:abstr" sem2="sc:x t:text t:workdram t:workmus r:abstr t:workart der:v pt:aggr t:workcin r:concr"/>работ</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="этот" gr="APRO,f,loc,norm,sg" sem="r:dem" sem2=""/>этой</w> <w><ana lex="область" gr="S,f,inan,loc,norm,sg" sem="t:space r:concr pt:part pc:space" sem2="t:space r:concr r:abstr pt:part pc:space"/>области</w> <w><ana lex="во" gr="PR,norm" sem="" sem2=""/>во</w> <w><ana lex="время" gr="S,acc,inan,n,norm,sg" sem="r:abstr t:param t:time" sem2="t:time:period r:abstr t:time"/>время</w> <w><ana lex="монголо" gr="ADV,bastard" sem="" sem2=""/>Монголо-Тибетской</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w>.</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w>общем</w>, <w><ana lex="все" gr="SPRO,inan,n,nom,norm,sg" sem="" sem2=""/>все</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="вполне" gr="ADV,norm" sem="dt:full t:degr:max der:a" sem2=""/>вполне</w> <w>удовлетворительно</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="успех" gr="S,inan,ins,m,norm,sg" sem="ev:posit r:abstr" sem2="ev:posit r:abstr"/>успехом</w> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="докладчик" gr="S,acc,anim,m,norm,sg" sem="der:v t:hum r:concr d:nag" sem2="der:v t:hum r:concr d:nag"/>докладчика</w>.</se></p>
<p><se><w><ana lex="время" gr="S,inan,n,nom,norm,sg" sem="r:abstr t:param t:time" sem2="t:time:period r:abstr t:time"/>Время</w> <w><ana lex="бежать" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="ca:noncaus t:move d:root" sem2="d:root"/><ana lex="бежать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:move d:root" sem2="d:root"/>бежит</w> <w><ana lex="быстро" gr="ADV,norm" sem="dt:speed:max ev der:a" sem2="t:speed:max dt:speed:max ev der:a"/>быстро</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="подходить" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:move d:pref" sem2=""/>подходит</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="отправление" gr="S,dat,inan,n,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="der:v r:concr t:text"/>отправлению</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w>.</se><se> <w><ana lex="все" gr="SPRO,inan,n,nom,norm,sg" sem="" sem2=""/>Все</w> <w><ana lex="укладываться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus d:pref d:impf" sem2=""/>укладывается</w>, <w><ana lex="сортироваться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="" sem2=""/>сортируется</w>.</se><se> <w><ana lex="прибыть" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2="d:pref"/>Прибыл</w> <w><ana lex="саранцев" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Саранцев</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="доставить" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:caus t:move d:pref" sem2="d:pref"/>доставил</w> <w><ana lex="наконец" gr="ADV,PARENTH,norm" sem="der:s t:time" sem2=""/>наконец</w> <w><ana lex="патрон" gr="S,acc,inan,m,norm,pl" sem="t:tool:shell r:concr" sem2="t:tool top:cylinder pt:part top:tube r:concr pc:tool"/>патроны</w>.</se><se> <w><ana lex="приготовить" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="d:pref der:s" sem2="d:pref der:s"/>Приготовлены</w> <w><ana lex="паспорт" gr="S,acc,inan,m,norm,pl" sem="t:doc r:concr" sem2="t:doc r:concr"/>паспорта</w>.</se><se> <w><ana lex="нанять" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="d:pref" sem2=""/>Наняты</w> <w><ana lex="извозчик" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr der:s t:prof" sem2="t:hum r:concr der:s t:prof"/>извозчики</w>.</se><se> <w><ana lex="идти" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus t:move d:root" sem2="ca:noncaus t:move d:root"/>Идут</w> <w><ana lex="последний" gr="A,nom,norm,pl,plen" sem="r:rel t:ord" sem2="t:degr:max:magn r:qual r:rel ev:neg t:time"/>последние</w> <w><ana lex="приготовление" gr="S,inan,n,nom,norm,pl" sem="der:v r:abstr" sem2=""/>приготовления</w>.</se><se> <w><ana lex="между" gr="PR,norm" sem="" sem2=""/>Между</w> <w><ana lex="прочее" gr="SPRO,ins,n,norm,sg" sem="" sem2=""/>прочим</w>, <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="решить" gr="V,act,indic,m,norm,pf,praet,sg" sem="t:ment ca:noncaus" sem2="t:ment ca:noncaus t:psych:volit"/>решил</w> <w><ana lex="сдать" gr="V,act,inf,norm,pf" sem="der:v ca:caus d:pref t:poss" sem2="der:v d:pref"/>сдать</w> <w>П</w>. <w>С</w>. <w><ana lex="михно" gr="S,0,anim,bastard,famn" sem="t:hum r:propn t:famn" sem2=""/><ana lex="михно" gr="S,0,anim,bastard,persn" sem="t:hum r:propn t:famn" sem2=""/>Михно</w>, <w><ana lex="как" gr="CONJ,norm" sem="" sem2=""/>как</w> <w><ana lex="председатель" gr="S,anim,dat,m,norm,sg" sem="t:hum r:concr d:nag" sem2=""/>председателю</w> <w><ana lex="отделение" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0" sem2="pc:org pt:set pc:contain t:org r:abstr der:v sc:hum pt:part pc:action r:concr"/>Отделения</w> <w><ana lex="местный" gr="A,gen,n,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s"/>местного</w> <w><ana lex="русский" gr="A,gen,n,norm,plen,sg" sem="dt:topon r:rel der:s t:topon" sem2=""/>Русского</w> <w><ana lex="географический" gr="A,gen,n,norm,plen,sg" sem="r:rel der:s" sem2=""/>географического</w> <w><ana lex="общество" gr="S,gen,inan,n,norm,sg" sem="sc:hum pt:aggr r:concr" sem2="sc:hum pt:aggr r:concr t:org r:abstr"/>общества</w>...</se></p>
<p><se><w><ana lex="третий" gr="ANUM,gen,m,norm,sg" sem="r:ord der:num r:rel t:ord" sem2="t:share r:rel der:num"/>Третьего</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дня</w> <w><ana lex="любоваться" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="ca:noncaus t:perc" sem2=""/>любовались</w> <w><ana lex="звездный" gr="A,ins,n,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space t:physq:form r:rel der:s"/>звездным</w> <w><ana lex="небо" gr="S,inan,ins,n,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/><ana lex="небо" gr="S,inan,ins,n,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/>небом</w>; <w><ana lex="вчера" gr="ADV,norm" sem="t:time" sem2=""/>вчера</w> <w><ana lex="прозрачный" gr="A,m,nom,norm,plen,sg" sem="t:physq r:rel" sem2="t:physq r:rel r:qual"/>прозрачный</w> <w><ana lex="воздух" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>воздух</w> <w><ana lex="искусить" gr="V,act,indic,m,norm,pf,praet,sg" sem="d:pref" sem2=""/>искусил</w> <w><ana lex="произвести" gr="V,act,inf,norm,pf" sem="ca:caus d:pref t:be:appear" sem2="d:pref"/>произвести</w> <w><ana lex="снимок" gr="S,acc,inan,m,norm,pl" sem="der:v r:concr t:workart" sem2=""/>снимки</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="наш" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/>нашего</w> <w><ana lex="дом" gr="S,gen,inan,m,norm,sg" sem="top:contain t:constr:build r:concr" sem2="sc:hum pt:set t:space t:org t:group der:shift r:concr"/>дома</w>.</se></p>
<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w>, <b/><w><b>22</b></w><b>/</b><w><ana lex="ix" gr="bastard" sem="" sem2=""/><b>IX</b></w><b/>, <w><ana lex="облачно" gr="ADV,norm" sem="" sem2=""/>облачно</w>, <w>пыльно</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="горизонт" gr="S,inan,m,nom,norm,sg" sem="t:space r:concr" sem2="t:ment t:space qc:stuff pt:qtm r:abstr pt:aggr r:concr"/>горизонт</w> <w><ana lex="значительно" gr="ADV,norm" sem="dt:size:max t:degr:max der:a" sem2="dt:size:max der:a"/>значительно</w> <w><ana lex="сократить" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="dt:size:min t:changest d:pref der:a ca:caus" sem2="d:pref der:a"/>сокращен</w>.</se></p>
<p><se><w><ana lex="экскурсия" gr="S,f,inan,nom,norm,sg" sem="t:action t:move r:abstr" sem2="t:group pt:set r:concr sc:hum"/>Экскурсия</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="птичка" gr="S,f,gen,inan,norm,pl" sem="" sem2="t:sign r:concr"/><ana lex="птичка" gr="S,anim,f,gen,norm,pl" sem="t:hum ev r:concr der:s d:dim" sem2=""/>птичек</w> <w><ana lex="дать" gr="V,act,f,indic,norm,pf,praet,sg" sem="ca:caus d:root t:poss" sem2="d:root"/>дала</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="результат" gr="S,inan,loc,m,norm,sg" sem="r:abstr" sem2="r:abstr"/>результате</w>: <w><ana lex="ruticilla" gr="bastard" sem="" sem2=""/>Ruticilla</w>, <w><ana lex="otocorys" gr="bastard" sem="" sem2=""/>Otocorys</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="poecile" gr="bastard" sem="" sem2=""/>Poecile</w>.</se><se> <w><ana lex="птица" gr="S,anim,f,nom,norm,pl" sem="t:animal r:concr hi:class" sem2=""/>Птицы</w> <w><ana lex="вообще" gr="ADV,PARENTH,norm" sem="dt:general der:a" sem2=""/>вообще</w> <w><ana lex="лететь" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus t:move" sem2=""/>летят</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="юг" gr="S,dat,inan,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr pt:part pc:space"/>югу</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="некоторый" gr="APRO,nom,norm,pl" sem="r:indet" sem2=""/>некоторые</w> <w><ana lex="много" gr="ADV,comp,norm" sem="t:quant:max r:spec" sem2="t:degr:max"/><ana lex="более" gr="ADV,norm" sem="t:degr:max der:adv" sem2="t:degr:max"/>более</w> <w><ana lex="нежный" gr="A,nom,norm,pl,plen" sem="t:humq r:qual" sem2="r:qual"/>нежные</w> <w><ana lex="форма" gr="S,f,inan,nom,norm,pl" sem="r:abstr" sem2="t:tool sc:partb t:form r:abstr sc:tool:cloth pt:aggr:aggrpl pt:aggr r:concr ev:posit"/>формы</w> <w><ana lex="узко" gr="ADV,comp,norm" sem="dt:size:min der:a" sem2="dt:size:min der:a"/><ana lex="уже" gr="ADV,norm" sem="t:time" sem2=""/>уже</w> <w><ana lex="отлететь" gr="V,act,indic,intr,norm,pf,pl,praet" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move t:be:disapp d:pref"/>отлетели</w>.</se></p>
<p><se> <b/><w><b>23</b></w><b>/</b><w><ana lex="ix" gr="bastard" sem="" sem2=""/><b>IX</b></w><b/>.</se><se> <w><ana lex="боевой" gr="A,f,nom,norm,plen,sg" sem="dt:inter r:rel der:s dt:hum" sem2="ev:posit t:humq dt:hum r:rel der:s r:qual dt:inter"/>Боевая</w> <w><ana lex="смотровой" gr="A,f,nom,norm,plen,sg" sem="dt:abstr r:rel der:s dt:action" sem2=""/>смотровая</w> <w><ana lex="стрельба" gr="S,f,inan,nom,norm,sg" sem="t:impact der:v r:abstr der:s0" sem2="t:sport r:abstr"/>стрельба</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="ружье" gr="S,gen,inan,n,norm,pl" sem="t:tool:weapon r:concr" sem2=""/>ружей</w>, <w><ana lex="револьвер" gr="S,gen,inan,m,norm,pl" sem="t:tool:weapon r:concr" sem2=""/>револьверов</w>, <w><ana lex="пулемет" gr="S,gen,inan,m,norm,pl" sem="der:comp t:tool:weapon r:concr" sem2=""/>пулеметов</w>.</se></p>
<p><se><w><ana lex="результат" gr="S,inan,m,nom,norm,sg" sem="r:abstr" sem2="r:abstr"/>Результат</w> <w><ana lex="вполне" gr="ADV,norm" sem="dt:full t:degr:max der:a" sem2=""/>вполне</w> <w><ana lex="удовлетворительный" gr="A,acc,inan,m,norm,plen,sg" sem="der:v t:quality r:rel" sem2=""/>удовлетворительный</w>, <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="довольный" gr="A,brev,m,norm,sg" sem="t:psych:emot r:qual" sem2=""/>доволен</w>!</se></p>
<p><se><w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="3" gr="NUM,ciph"/>3</w> <w><ana lex="час" gr="S,gen,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часа</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дня</w> <w><ana lex="мой" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/>моя</w> <w><ana lex="лекция" gr="S,f,inan,nom,norm,sg" sem="t:action r:abstr" sem2="r:concr t:text"/>лекция</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="народный" gr="A,loc,m,norm,plen,sg" sem="r:rel der:s" sem2="r:rel der:s"/>Народном</w> <w><ana lex="дом" gr="S,inan,loc,m,norm,sg" sem="top:contain t:constr:build r:concr" sem2="sc:hum pt:set t:space t:org t:group der:shift r:concr"/>доме</w>, <w><ana lex="привлечь" gr="V,act,f,nom,norm,partcp,pf,plen,praet,sg" sem="der:v d:pref" sem2="der:v d:pref"/>привлекшая</w> (<w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="город" gr="S,gen,inan,m,norm,sg" sem="sc:constr:build t:space r:concr" sem2="t:space r:concr"/>города</w> <w><ana lex="троицкосавск" gr="S,bastard,gen,inan,m,sg" sem="" sem2=""/>Троицкосавска</w>) <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="многолюдный" gr="A,n,nom,norm,plen,sg" sem="t:quant:max der:comp r:rel d:habit" sem2=""/>многолюдное</w> <w><ana lex="общество" gr="S,inan,n,nom,norm,sg" sem="sc:hum pt:aggr r:concr" sem2="sc:hum pt:aggr r:concr t:org r:abstr"/>общество</w>.</se><se> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>По</w> <w><ana lex="слово" gr="S,dat,inan,n,norm,pl" sem="t:word r:concr r:abstr" sem2="pt:aggr:aggrpl t:text sc:word r:abstr t:speech r:concr"/>словам</w> <w><ana lex="мой" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/>моих</w> <w><ana lex="спутник" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,gen,inan,m,norm,pl" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутников</w>, <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="говорить" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="t:speech ca:noncaus d:root" sem2="d:root"/>говорил</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="подъем" gr="S,inan,ins,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="t:space r:concr r:abstr der:v top:form pt:part pt:partb pc:partb t:psych pc:tool:cloth:boot"/>подъемом</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="особенность" gr="S,f,inan,loc,norm,sg" sem="r:abstr der:a" sem2="r:abstr der:a"/>особенности</w> <w><ana lex="после" gr="PR,norm" sem="" sem2=""/>после</w> <w><ana lex="перерыв" gr="S,gen,inan,m,norm,sg" sem="r:abstr t:time" sem2=""/>перерыва</w>.</se><se> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>Мне</w> <w><ana lex="поднести" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus t:move d:pref"/><ana lex="поднести" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus t:move d:pref"/>поднесли</w> <w><ana lex="букет" gr="S,acc,inan,m,norm,sg" sem="pt:set sc:plant r:concr" sem2="pt:set pt:qtm sc:workmus r:concr r:abstr"/>букет</w> <w><ana lex="красный" gr="A,gen,norm,pl,plen" sem="t:physq:color r:qual" sem2="ev:posit dt:physq:color der:shift r:qual t:species r:rel"/>красных</w> <w><ana lex="роза" gr="S,f,gen,inan,norm,pl" sem="t:plant r:concr" sem2="r:concr t:workart"/><ana lex="роза" gr="S,anim,f,gen,norm,persn,pl" sem="t:hum r:propn t:persn" sem2=""/>роз</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="цвет" gr="S,gen,inan,m,norm,pl" sem="t:color sc:part pc:plant r:abstr pt:aggr pt:part r:concr" sem2="sc:hum pt:aggr r:concr pt:part"/><ana lex="цветок" gr="S,gen,inan,m,norm,pl" sem="der:v pc:plant r:concr pt:part" sem2="der:v d:dim t:plant r:concr hi:class"/>цветов</w> <w><ana lex="вообще" gr="ADV,PARENTH,norm" sem="dt:general der:a" sem2=""/>вообще</w> (<w><ana lex="другой" gr="APRO,acc,n,norm,sg" sem="r:spec" sem2="r:ord r:spec r:indet"/>другое</w> <w><ana lex="подношение" gr="S,acc,inan,n,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="der:v t:thing r:concr"/>подношение</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="гимназистка" gr="S,anim,f,gen,norm,sg" sem="t:hum d:fem r:concr der:s" sem2=""/>гимназистки</w>).</se><se> <w><ana lex="вечер" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечером</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="навестить" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2=""/>навестил</w> <w><ana lex="николай" gr="S,acc,anim,m,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Николая</w> <w><ana lex="иванович" gr="S,acc,anim,m,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Ивановича</w> <w><ana lex="саловаров" gr="S,acc,anim,famn,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Саловарова</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="наш" gr="APRO,acc,anim,m,norm,sg" sem="r:poss" sem2=""/>нашего</w> <w><ana lex="друг" gr="S,acc,anim,m,norm,sg" sem="t:hum r:concr" sem2="t:hum r:concr"/>друга</w> <w>П</w>. <w>С</w>. <w><ana lex="михно" gr="S,0,anim,bastard,famn" sem="t:hum r:propn t:famn" sem2=""/><ana lex="михно" gr="S,0,anim,bastard,persn" sem="t:hum r:propn t:famn" sem2=""/>Михно</w>, <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="последний" gr="A,gen,m,norm,plen,sg" sem="r:rel t:ord" sem2="t:degr:max:magn r:qual r:rel ev:neg t:time"/>последнего</w> <w><ana lex="засидеться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus d:pref" sem2=""/>засиделся</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="поздний" gr="A,gen,norm,pl,plen" sem="t:time r:qual" sem2="t:time r:qual"/>поздних</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w>.</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="промежуток" gr="S,inan,loc,m,norm,sg" sem="t:dist t:space r:concr der:adv" sem2="der:shift t:dist r:abstr"/>промежутке</w> <w><ana lex="зайти" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/><ana lex="заходить" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2=""/><ana lex="зайти" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/>зашел</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="спектакль" gr="S,acc,inan,m,norm,sg" sem="t:action r:abstr" sem2="r:abstr"/>спектакль</w>, <w><ana lex="устроить" gr="V,acc,inan,m,norm,partcp,pass,pf,plen,praet,sg" sem="der:v ca:caus d:pref t:be:appear" sem2="der:v d:pref"/>устроенный</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="польза" gr="S,acc,f,inan,norm,sg" sem="ev:posit r:abstr" sem2=""/>пользу</w> <w><ana lex="япония" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Японии</w>, <w><ana lex="внести" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/>внес</w> <w><ana lex="мзда" gr="S,acc,f,inan,norm,sg" sem="ev:neg r:abstr t:poss" sem2=""/>мзду</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> -- <w><ana lex="восвояси" gr="ADV,norm" sem="dt:social t:dir der:apro" sem2=""/>восвояси</w>!</se><se> <w><ana lex="молодой" gr="A,0,norm,plen" sem="t:time:age r:qual" sem2="t:time:age r:qual"/>Молодой</w> <w><ana lex="человек" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr" sem2="t:hum ev:posit r:concr"/>человек</w> <w><ana lex="потап" gr="S,anim,gen,m,norm,persn,pl" sem="t:hum r:propn t:persn" sem2=""/><ana lex="потап" gr="S,acc,anim,m,norm,persn,pl" sem="t:hum r:propn t:persn" sem2=""/><ana lex="потапов" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Потапов</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="верхнеудинск" gr="S,gen,inan,m,norm,sg" sem="r:propn t:topon" sem2=""/>Верхнеудинска</w> -- «<w><ana lex="желать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="d:root" sem2="d:root"/>желает</w>» ...</se></p>
<p><se><w>С</w>. <w>А</w>. <w><ana lex="глаголев" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Глаголев</w> <w><ana lex="долгий" gr="A,acc,n,norm,plen,sg" sem="t:time:dur:max r:qual" sem2="t:size:max r:qual"/>долгое</w> <w><ana lex="время" gr="S,acc,inan,n,norm,sg" sem="r:abstr t:param t:time" sem2="t:time:period r:abstr t:time"/>время</w> <w><ana lex="принимать" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="d:pref" sem2=""/>принимал</w> <w><ana lex="извозчик" gr="S,acc,anim,m,norm,pl" sem="t:hum r:concr der:s t:prof" sem2="t:hum r:concr der:s t:prof"/>извозчиков</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w>много</w> <w><ana lex="говорить" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="t:speech ca:noncaus d:root" sem2="d:root"/>говорил</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="они" gr="SPRO,3p,ins,norm,pl" sem="r:pers" sem2=""/>ними</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="легковой" gr="A,ins,norm,pl,plen" sem="r:rel" sem2=""/>легковыми</w> (<w><ana lex="тарантасный" gr="A,ins,norm,pl,plen" sem="r:rel der:s" sem2=""/>тарантасными</w>), <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="тяжелый" gr="A,ins,norm,pl,plen" sem="t:physq:weight r:qual" sem2="t:humq der:metaph r:qual dt:physq:weight t:physq der:shift t:degr:max ev:neg r:rel"/>тяжелыми</w> (<w><ana lex="тележный" gr="A,ins,norm,pl,plen" sem="r:rel der:s dt:tool:transp dt:tool" sem2=""/>тележными</w>).</se><se> <w><ana lex="поехать" gr="V,1p,act,fut,indic,intr,norm,pf,pl" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="поехать" gr="V,1p,act,imper,intr,norm,pf,pl" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/>Поедем</w> <w><ana lex="транспорт" gr="S,inan,ins,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="r:abstr pt:set t:tool:transp pt:aggr sc:tool:transp r:concr"/>транспортом</w>: <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="убугунов" gr="S,anim,bastard,famn,ins,m,sg" sem="t:hum r:propn t:famn" sem2=""/>Убугуновым</w>, <w><ana lex="мой" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>мои</w> <w><ana lex="помощник" gr="S,anim,m,nom,norm,pl" sem="der:v t:hum r:concr d:nag" sem2="der:v t:hum r:concr d:nag"/>помощники</w> <w><ana lex="ученый" gr="S,anim,m,nom,norm,pl" sem="der:subst t:hum der:a r:concr t:prof" sem2=""/>ученые</w> -- <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="остальной" gr="APRO,ins,norm,pl" sem="" sem2=""/>остальными</w> <w><ana lex="спутник" gr="S,anim,ins,m,norm,pl" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,inan,ins,m,norm,pl" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутниками</w>.</se></p>
<p><se><b/><w><b>24</b></w><b>/</b><w><ana lex="ix" gr="bastard" sem="" sem2=""/><b>IX</b></w><b>, </b><w><ana lex="r" gr="bastard" sem="" sem2=""/><b>R</b></w><b/>. <w><ana lex="сплошной" gr="A,f,nom,norm,plen,sg" sem="r:rel der:adv" sem2="der:adv r:rel t:degr:max r:qual"/>Сплошная</w> <w><ana lex="облачность" gr="S,f,inan,nom,norm,sg" sem="r:abstr der:a" sem2="qc:stuff pt:aggr t:stuff r:concr sc:qtm"/>облачность</w>.</se><se> <w>Вообще</w>, <w><ana lex="что" gr="SPRO,inan,n,nom,norm,sg" sem="r:rel" sem2=""/><ana form="что-то" lex="что-то" gr="SPRO,inan,n,nom,norm,sg" sem="r:indet" sem2=""/>что-то</w> <w><ana lex="странный" gr="A,n,nom,norm,plen,sg" sem="r:qual" sem2=""/>странное</w> <w><ana lex="твориться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:be:exist ca:noncaus" sem2=""/><ana lex="твориться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:be:exist ca:noncaus" sem2=""/>творится</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="климат" gr="S,inan,ins,m,norm,sg" sem="t:asp:weather r:abstr" sem2="r:abstr"/>климатом</w>.</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="прежний" gr="A,acc,n,norm,plen,sg" sem="r:rel t:time" sem2="r:rel t:time"/>прежнее</w> <w><ana lex="время" gr="S,acc,inan,n,norm,sg" sem="r:abstr t:param t:time" sem2="t:time:period r:abstr t:time"/>время</w> <w><ana lex="осень" gr="S,f,inan,nom,norm,sg" sem="t:time:season r:abstr t:time" sem2=""/>осень</w> <w><ana lex="отмечаться" gr="V,act,f,indic,intr,ipf,norm,praet,sg" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref"/>отмечалась</w> <w><ana lex="сухой" gr="A,0,norm,plen" sem="t:physst r:qual" sem2="t:humq t:physq ev:neg dt:physst der:shift t:appearance r:qual t:sound dt:physq r:rel"/>сухой</w>, <w><ana lex="ясный" gr="A,f,ins,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясной</w>, <w><ana lex="прозрачный" gr="A,f,ins,norm,plen,sg" sem="t:physq r:rel" sem2="t:physq r:rel r:qual"/>прозрачной</w>, <w><ana lex="начинать" gr="V,act,ger,ipf,norm,praes,tran" sem="aux:phase d:pref" sem2="d:pref"/>начиная</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="1915" gr="NUM,ciph"/>1915</w>/<w><ana lex="16" gr="NUM,ciph"/>16</w>-<w>го</w> <w><ana lex="год" gr="S,gen,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:age r:abstr"/>года</w>, <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="слово" gr="S,dat,inan,n,norm,pl" sem="t:word r:concr r:abstr" sem2="pt:aggr:aggrpl t:text sc:word r:abstr t:speech r:concr"/>словам</w> <w><ana lex="обитатель" gr="S,anim,gen,m,norm,pl" sem="der:v t:hum r:concr d:nag dt:be:exist" sem2=""/>обитателей</w>, <w><ana lex="сухость" gr="S,f,inan,nom,norm,sg" sem="r:abstr der:a" sem2=""/>сухость</w> <w><ana lex="являться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v ca:noncaus" sem2="der:v ca:noncaus"/>является</w> <w><ana lex="лето" gr="S,inan,ins,n,norm,sg" sem="t:time:season r:abstr t:time" sem2=""/>летом</w>, <w><ana lex="влажность" gr="S,f,inan,nom,norm,sg" sem="r:abstr der:a" sem2=""/>влажность</w> -- <w><ana lex="осень" gr="S,f,inan,ins,norm,sg" sem="t:time:season r:abstr t:time" sem2=""/>осенью</w>!</se><se> <w><ana lex="ежедневно" gr="ADV,norm" sem="t:freq dt:time der:a" sem2=""/>Ежедневно</w> <w><ana lex="ветер" gr="S,acc,inan,m,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>ветер</w> <w><ana lex="приносить" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="ca:caus t:move d:pref" sem2=""/>приносит</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="уносить" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="ca:caus t:move d:pref" sem2=""/>уносит</w> <w><ana lex="масса" gr="S,acc,f,inan,norm,pl" sem="r:abstr t:param" sem2="sc:aggr t:stuff t:quant:max qc:stuff pt:qtm r:abstr qc:aggr pt:aggr:aggrpl pt:aggr sc:hum sc:stuff r:concr"/>массы</w> <w><ana lex="слоистый" gr="A,gen,norm,pl,plen" sem="t:physq d:habit der:s r:qual" sem2=""/>слоистых</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana form="слоисто-кучевых" lex="слоисто-кучевой" gr="A,gen,norm,pl,plen" sem="der:comp r:rel" sem2=""/>слоисто-кучевых</w> <w><ana lex="облако" gr="S,gen,inan,n,norm,pl" sem="qc:stuff r:concr" sem2="qc:stuff pt:qtm top:form r:concr"/>облаков</w>.</se><se> <w><ana lex="при" gr="PR,norm" sem="" sem2=""/>При</w> <w><ana lex="облачность" gr="S,f,gen,inan,norm,sg" sem="r:abstr der:a" sem2="qc:stuff pt:aggr t:stuff r:concr sc:qtm"/>облачности</w> <w><ana lex="теплый" gr="A,comp,norm,plen" sem="dt:temper dt:abstr t:physq:temper der:s r:qual" sem2="ev:posit t:physq:color dt:temper t:physq:temper dt:abstr der:s r:qual"/>теплее</w>, <w><ana lex="при" gr="PR,norm" sem="" sem2=""/>при</w> <w><ana lex="ясность" gr="S,f,gen,inan,norm,sg" sem="r:abstr der:a" sem2=""/>ясности</w> <w><ana lex="холодный" gr="A,comp,norm,plen" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual"/>холоднее</w>.</se></p>
<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="мы" gr="SPRO,1p,gen,norm,pl" sem="r:pers" sem2=""/>нас</w> <w><ana lex="все" gr="SPRO,inan,n,nom,norm,sg" sem="" sem2=""/>все</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="работа" gr="S,f,inan,ins,norm,sg" sem="der:v r:abstr" sem2="sc:x t:text t:workdram t:workmus r:abstr t:workart der:v pt:aggr t:workcin r:concr"/>работой</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="ранний" gr="A,gen,n,norm,plen,sg" sem="t:time r:qual" sem2="t:time r:qual"/>раннего</w> <w><ana lex="утро" gr="S,gen,inan,n,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утра</w>.</se><se> <w><ana lex="все" gr="SPRO,inan,n,nom,norm,sg" sem="" sem2=""/>Все</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="укладка" gr="S,f,inan,ins,norm,sg" sem="der:v r:abstr der:s0" sem2="der:v top:contain t:tool r:concr r:abstr"/>укладкой</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="сборы" gr="S,inan,ins,norm,pl" sem="" sem2=""/>сборами</w>.</se><se> <w>Пора</w>, <w>пора</w> <w><ana lex="неотложный" gr="A,brev,n,norm,sg" sem="" sem2=""/>неотложно</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="дальнейший" gr="A,acc,f,norm,plen,sg" sem="dt:dist:max der:a d:super r:qual" sem2=""/>дальнейшую</w> <w><ana lex="дорога" gr="S,acc,f,inan,norm,sg" sem="top:stripe t:space r:concr t:fam" sem2="t:move dt:space r:abstr der:shift t:space r:concr"/>дорогу</w>!</se></p>
<p><se><b/><w><b>25</b></w><b>/</b><w><ana lex="ix" gr="bastard" sem="" sem2=""/><b>IX</b></w><b>, </b><w><ana lex="u" gr="bastard" sem="" sem2=""/><b>U</b></w><b/>. <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>С</w> <w><ana lex="утро" gr="S,gen,inan,n,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утра</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="день" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>днем</w> <w><ana lex="приготовление" gr="S,acc,inan,n,norm,sg" sem="der:v r:abstr" sem2=""/>приготовление</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="дорога" gr="S,acc,f,inan,norm,sg" sem="top:stripe t:space r:concr t:fam" sem2="t:move dt:space r:abstr der:shift t:space r:concr"/>дорогу</w>, <w><ana lex="нагрузка" gr="S,f,inan,nom,norm,sg" sem="t:put der:v r:abstr der:s0" sem2="sc:thing r:abstr der:v pt:aggr ev:neg r:concr"/>нагрузка</w> <w><ana lex="ящик" gr="S,gen,inan,m,norm,pl" sem="top:contain t:tool r:concr" sem2="t:tool:device der:shift ev r:concr t:org"/>ящиков</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="сум" gr="S,inan,m,nom,norm,sg" sem="" sem2=""/>сум</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="вообще" gr="ADV,PARENTH,norm" sem="dt:general der:a" sem2=""/>вообще</w> <w><ana lex="багаж" gr="S,gen,inan,m,norm,sg" sem="sc:thing pt:aggr r:concr" sem2="pt:set der:shift"/>багажа</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w>, <w><ana lex="вес" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:param" sem2="r:abstr"/>вес</w> <w><ana lex="который" gr="APRO,gen,m,norm,sg" sem="r:rel t:ord" sem2=""/>которого</w> <w><ana lex="определиться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="t:ment ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>определился</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="450" gr="NUM,ciph"/>450</w> <w><ana lex="пуд" gr="S,anim,gen,m,norm,persn,pl" sem="" sem2=""/><ana lex="пуд" gr="S,gen,inan,m,norm,pl" sem="t:unit r:abstr" sem2=""/>пудов</w> (<w><ana lex="со" gr="PR,norm" sem="" sem2=""/>со</w> <w><ana lex="весь" gr="APRO,ins,norm,pl" sem="r:spec" sem2=""/>всеми</w> <w><ana lex="патрон" gr="S,inan,ins,m,norm,pl" sem="t:tool:shell r:concr" sem2="t:tool top:cylinder pt:part top:tube r:concr pc:tool"/><ana lex="патрон" gr="S,anim,ins,m,norm,pl" sem="t:hum r:concr" sem2="t:hum ev r:concr"/>патронами</w>), <w><ana lex="телега" gr="S,f,gen,inan,norm,pl" sem="t:tool:transp r:concr" sem2="t:speech r:abstr ev:neg"/>телег</w> <w><ana lex="около" gr="PR,norm" sem="" sem2=""/>около</w> <w><ana lex="35" gr="NUM,ciph"/>35</w>; <w><ana lex="целый" gr="A,f,nom,norm,plen,sg" sem="t:degr r:qual" sem2="t:degr r:spec r:qual"/>целая</w> <w><ana lex="уйма" gr="S,f,inan,nom,norm,sg" sem="t:quant:max pt:qtm r:abstr" sem2=""/>уйма</w> <w><ana lex="деньги" gr="S,gen,inan,norm,pl" sem="pt:aggr:aggrpl t:money r:concr sc:money:banknote hi:class" sem2="pt:aggr:aggrpl sc:money r:concr hi:class"/>денег</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="перевозка" gr="S,acc,f,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2=""/>перевозку</w> <w><ana lex="имущество" gr="S,gen,inan,n,norm,sg" sem="sc:thing der:v pt:aggr r:concr" sem2=""/>имущества</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w>.</se></p>
<p><se><w><ana lex="вечер" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечер</w>.</se><se> <w><ana lex="торжественный" gr="A,n,nom,norm,plen,sg" sem="r:rel der:s" sem2="r:rel der:s r:qual"/>Торжественное</w> <w><ana lex="заседание" gr="S,inan,n,nom,norm,sg" sem="t:action r:abstr" sem2=""/>заседание</w> <w><ana lex="представитель" gr="S,anim,gen,m,norm,pl" sem="der:v t:hum r:concr d:nag" sem2="der:v t:hum r:concr d:nag"/>представителей</w> <w><ana lex="город" gr="S,gen,inan,m,norm,sg" sem="sc:constr:build t:space r:concr" sem2="t:space r:concr"/>города</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="повод" gr="S,dat,inan,m,norm,sg" sem="der:v top:rope t:tool r:concr r:abstr" sem2=""/><ana lex="повод" gr="S,dat,inan,m,norm,sg" sem="der:v top:rope t:tool r:concr r:abstr" sem2=""/>поводу</w> <w><ana lex="выступление" gr="S,gen,inan,n,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="t:action t:speech r:abstr"/>выступления</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="далекий" gr="A,acc,inan,m,norm,plen,sg" sem="t:dist:max r:qual" sem2="dt:dist:max der:shift t:time t:humq r:qual"/>далекий</w> <w><ana lex="путь" gr="S,acc,inan,m,norm,sg" sem="top:stripe t:space r:concr" sem2="ev:posit t:space t:asp r:abstr sc:space pt:aggr:aggrpl pt:aggr top:stripe r:concr der:shift"/>путь</w> <w><ana lex="тибетский" gr="A,f,gen,norm,plen,sg" sem="dt:topon r:rel der:s t:topon" sem2=""/>Тибетской</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w>.</se><se> <w><ana lex="речь" gr="S,acc,f,inan,norm,pl" sem="t:speech r:abstr" sem2="t:speech r:concr r:abstr"/>Речи</w> <w><ana lex="почетный" gr="A,gen,norm,pl,plen" sem="r:rel der:s t:humq:char" sem2="r:rel der:s r:qual"/>почетных</w> <w><ana lex="член" gr="S,gen,inan,m,norm,pl" sem="" sem2="pc:hum pc:animal pt:set t:word pc:x pt:part pt:part