<p><se><b/><w><b>26</b></w><b>/</b><w><ana lex="vii" gr="bastard" sem="" sem2=""/><b>VII</b></w><b>, </b><w><ana lex="v" gr="bastard" sem="" sem2=""/><b>V</b></w><b/>. <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>Я</w> <w><ana lex="проснуться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:physiol d:pref" sem2="der:v ca:noncaus d:pref"/>проснулся</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="рано" gr="ADV,norm" sem="dt:time ev:neg der:a t:time" sem2="dt:time der:a t:time"/>рано</w>.</se><se> <w><ana lex="я" gr="SPRO,1p,acc,norm,sg" sem="r:pers" sem2=""/>Меня</w> <w><ana lex="печалить" gr="V,act,f,indic,ipf,norm,praet,sg,tran" sem="ca:caus t:psych:emot" sem2=""/>печалила</w> <w><ana lex="мысль" gr="S,f,inan,nom,norm,sg" sem="t:ment r:abstr" sem2="t:ment ev:posit r:abstr"/>мысль</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="стоять" gr="V,1p,act,indic,intr,ipf,norm,pl,praes" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:noncaus"/><ana lex="стоить" gr="V,1p,act,indic,ipf,norm,pl,praes" sem="d:root" sem2="d:root"/>стоим</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="бездействовать" gr="V,1p,act,indic,intr,ipf,norm,pl,praes" sem="d:pref der:s" sem2=""/>бездействуем</w>.</se><se> <w><ana lex="написать" gr="V,act,indic,norm,pf,pl,praet,tran" sem="der:v d:pref" sem2=""/>Написали</w> <w><ana lex="телеграмма" gr="S,acc,f,inan,norm,sg" sem="der:comp r:concr t:text" sem2=""/>телеграмму</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="вопль" gr="S,inan,ins,m,norm,sg" sem="t:sound r:abstr" sem2=""/>воплем</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="москва" gr="S,acc,f,inan,norm,sg" sem="r:propn t:topon" sem2="r:propn t:topon"/>Москву</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w>СНК</w> <w><ana lex="и" gr="CONJ,norm" s