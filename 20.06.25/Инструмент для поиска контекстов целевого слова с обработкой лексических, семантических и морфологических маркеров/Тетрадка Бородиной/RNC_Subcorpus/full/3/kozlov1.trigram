<p><se><w>Приятно</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="видеть" gr="V,act,inf,ipf,norm,tran" sem="ca:noncaus t:perc d:root" sem2="t:ment ca:noncaus d:root"/>видеть</w> <w><ana lex="семья" gr="S,acc,f,inan,norm,sg" sem="t:group pt:set r:concr sc:hum:kin" sem2="pt:set der:shift r:concr sc:animal hi:class"/>семью</w> <w><ana lex="ида" gr="S,anim,f,gen,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Иды</w> <w><ana lex="павловна" gr="S,anim,f,gen,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Павловны</w>: <w><ana lex="она" gr="SPRO,3p,f,nom,norm,sg" sem="r:pers" sem2=""/>она</w> <w><ana lex="справлять" gr="V,act,f,indic,ipf,norm,praet,sg,tran" sem="der:v d:pref" sem2=""/>справляла</w> <w><ana lex="накануне" gr="PR,norm" sem="" sem2=""/>накануне</w> <w><ana lex="мой" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/>моего</w> <w><ana lex="приезд" gr="S,gen,inan,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2=""/>приезда</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="утро" gr="S,gen,inan,n,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утра</w> <w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w> <w><ana lex="рождение" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0 t:be:appear" sem2="der:shift t:time:moment r:abstr"/>рождения</w> <w><ana lex="верочка" gr="S,anim,f,gen,norm,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Верочки</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="молодежь" gr="S,f,inan,ins,norm,sg" sem="sc:hum pt:aggr r:concr der:a" sem2=""/>молодежью</w>.</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="праздник" gr="S,inan,loc,m,norm,sg" sem="t:action r:abstr" sem2="r:abstr"/>празднике</w> <w><ana lex="деятельный" gr="A,acc,n,norm,plen,sg" sem="der:v t:hu