<p><se><w><ana lex="мандалец" gr="S,anim,bastard,m,nom,pl" sem="" sem2=""/><ana lex="мандалец" gr="S,anim,bastard,m,nom,pl" sem="" sem2=""/>Мандальцы</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>были</w> <w><ana lex="рад" gr="A,brev,norm,pl" sem="t:psych:emot r:qual" sem2="t:psych:volit r:qual"/>рады</w>, <w><ana lex="довольный" gr="A,brev,norm,pl" sem="t:psych:emot r:qual" sem2=""/>довольны</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="душа" gr="S,f,gen,inan,norm,sg" sem="pc:hum r:concr" sem2=""/>души</w> <w><ana lex="громкий" gr="A,ins,norm,pl,plen" sem="t:sound r:qual" sem2="der:shift ev:neg r:qual"/>громкими</w> <w><ana lex="рукоплескание" gr="S,inan,ins,n,norm,pl" sem="der:v r:abstr" sem2=""/>рукоплесканиями</w> <w><ana lex="приветствовать" gr="V,act,indic,norm,pf,pl,praet,tran" sem="d:pref der:s" sem2="d:pref der:s"/><ana lex="приветствовать" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="d:pref der:s" sem2="d:pref der:s"/>приветствовали</w> <w><ana lex="алексей" gr="S,acc,anim,m,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Алексея</w> <w><ana lex="николаевич" gr="S,acc,anim,m,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Николаевича</w>.</se><se> <w><ana lex="казаться" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="der:v ca:noncaus t:perc" sem2="t:ment ca:noncaus der:v"/>Казалось</w>, <w><ana lex="все" gr="SPRO,inan,n,nom,norm,sg" sem="" sem2=""/>все</w> <w><ana lex="кончить" gr="V,brev,n,norm,partcp,pass,pf,praet,sg" sem="aux:phase ca:caus t:be:disapp" sem2=""/>кончено</w>.</se><se> <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>Но</w> <w><ana lex="алексей" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Алексей</w> <w><ana lex="николаевич" gr="S,anim,m,nom,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Николаевич</w> <w><ana lex="заметить" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:noncaus d:pref t:perc" sem2="d:pref"/>заметил</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="он" gr="SPRO,3p,m,nom,norm,sg" sem="r:pers" sem2=""/>он</w> <w><ana lex="еще" gr="ADV,norm" sem="" sem2=""/>еще</w> <w><ana lex="желать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="d:root" sem2="d:root"/>желает</w> <w><ana lex="сказать" gr="V,act,inf,norm,pf,tran" sem="t:speech ca:noncaus" sem2=""/>сказать</w> <w><ana lex="слово" gr="S,acc,inan,n,norm,sg" sem="t:word r:concr r:abstr" sem2="pt:aggr:aggrpl t:text sc:word r:abstr t:speech r:concr"/>слово</w>.</se><se> <w><ana lex="все" gr="SPRO,nom,norm,pl" sem="" sem2=""/>Все</w> <w><ana lex="напрячься" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>напряглись</w>.</se><se> «<w><ana lex="здесь" gr="ADVPRO,norm" sem="t:place r:dem" sem2="t:time r:dem"/>Здесь</w>, <w><ana lex="среди" gr="PR,norm" sem="" sem2=""/>среди</w> <w><ana lex="мы" gr="SPRO,1p,gen,norm,pl" sem="r:pers" sem2=""/>нас</w>, <w><ana lex="быть" gr="V,1p,act,indic,intr,ipf,norm,praes,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/><ana lex="быть" gr="V,2p,act,indic,intr,ipf,norm,praes,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/><ana lex="быть" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/><ana lex="быть" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>есть</w> <w><ana lex="один" gr="ANUM,m,nom,norm,sg" sem="r:card r:card:pauc der:num" sem2=""/><ana lex="один" gr="ANUM,acc,inan,m,norm,sg" sem="r:card r:card:pauc der:num" sem2=""/>один</w> <w><ana lex="человек" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr" sem2="t:hum ev:posit r:concr"/>человек</w>, <w><ana lex="который" gr="APRO,m,nom,norm,sg" sem="r:rel t:ord" sem2=""/>который</w> <w><ana lex="являться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v ca:noncaus" sem2="der:v ca:noncaus"/>является</w> <w><ana lex="гордость" gr="S,f,inan,ins,norm,sg" sem="t:humq r:abstr der:a" sem2="ev:posit t:humq der:a r:abstr der:shift t:psych"/>гордостью</w> <w><ana lex="россия" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>России</w>, -- <w><ana lex="путешественник" gr="S,anim,m,nom,norm,sg" sem="der:v t:hum r:concr d:nag" sem2=""/>путешественник</w> <w>П</w>. <w>К</w>. <w><ana lex="козлов" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/><ana lex="козлов" gr="S,inan,m,nom,norm,sg" sem="" sem2="r:propn t:topon"/>Козлов</w>, <w><ana lex="великий" gr="A,m,nom,norm,plen,sg" sem="t:degr:max r:qual" sem2="t:size:max t:degr:max r:qual"/>великий</w> <w><ana lex="русский" gr="A,m,nom,norm,plen,sg" sem="dt:topon r:rel der:s t:topon" sem2=""/>русский</w> <w><ana lex="ученый" gr="S,anim,m,nom,norm,sg" sem="der:subst t:hum der:a r:concr t:prof" sem2=""/>ученый</w>, <w><ana lex="который" gr="APRO,m,nom,norm,sg" sem="r:rel t:ord" sem2=""/>который</w> <w><ana lex="хорошо" gr="ADV,PRAEDIC,norm" sem="ev:posit dt:quality der:a" sem2=""/><ana lex="хорошо" gr="ADV,PARENTH,norm" sem="ev:posit dt:quality der:a" sem2=""/>хорошо</w> <w><ana lex="известный" gr="A,brev,m,norm,sg" sem="" sem2=""/>известен</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="граница" gr="S,f,inan,ins,norm,sg" sem="t:space r:concr der:s" sem2="r:abstr"/>границей</w>, <w><ana lex="иметь" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="ca:noncaus d:root t:poss" sem2="d:root"/>имеет</w> <w>много</w> <w><ana lex="почетный" gr="A,gen,norm,pl,plen" sem="r:rel der:s t:humq:char" sem2="r:rel der:s r:qual"/>почетных</w> <w><ana lex="иностранный" gr="A,gen,norm,pl,plen" sem="der:comp r:rel" sem2="der:comp r:rel"/>иностранных</w> <w><ana lex="награда" gr="S,f,gen,inan,norm,pl" sem="r:abstr" sem2="t:sign r:abstr der:v t:thing qc:money t:money r:concr"/>наград</w>, <w><ana lex="написать" gr="V,act,indic,m,norm,pf,praet,sg,tran" sem="der:v d:pref" sem2=""/>написал</w> <w><ana lex="немало" gr="NUM,norm" sem="" sem2=""/>немало</w> <w><ana lex="книга" gr="S,f,gen,inan,norm,pl" sem="t:media r:concr t:text" sem2="pc:text t:book r:concr t:text pt:part"/>книг</w>, <w><ana lex="перевести" gr="V,gen,norm,partcp,pass,pf,pl,plen,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/>переведенных</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="заграничный" gr="A,acc,inan,norm,pl,plen" sem="dt:space r:rel der:s" sem2=""/>заграничные</w> <w><ana lex="язык" gr="S,acc,inan,m,norm,pl" sem="pt:partb pc:animal r:concr r:abstr pc:hum" sem2="t:food sc:hum t:form sc:word r:abstr der:shift pt:set pt:aggr pc:tool:mus pt:part top:rod r:concr pc:tool"/>языки</w>.</se><se> <w><ana lex="он" gr="SPRO,3p,m,nom,norm,sg" sem="r:pers" sem2=""/>Он</w> <w><ana lex="здесь" gr="ADVPRO,norm" sem="t:place r:dem" sem2="t:time r:dem"/>здесь</w> <w><ana lex="случайно" gr="ADV,PARENTH,norm" sem="der:a" sem2=""/>случайно</w> <w><ana lex="вместе" gr="ADV,norm" sem="t:quant:abs" sem2="t:time"/>вместе</w> <w><ana lex="со" gr="PR,norm" sem="" sem2=""/>со</w> <w><ana lex="я" gr="SPRO,1p,ins,norm,sg" sem="r:pers" sem2=""/>мною</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="товарищеский" gr="A,f,loc,norm,plen,sg" sem="der:s dt:hum r:qual" sem2="r:rel der:s dt:hum"/>товарищеской</w> <w><ana lex="охота" gr="S,f,inan,loc,norm,sg" sem="t:action t:psych:volit r:abstr" sem2="der:v d:nag r:abstr sc:hum pt:aggr r:concr"/>охоте</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="его" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,n,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,f,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,m,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,n,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,f,gen,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,n,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,f,gen,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,m,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,n,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,f,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,m,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,n,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,f,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,m,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,n,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,f,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,m,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,anim,m,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,inan,m,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,n,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,f,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,m,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,n,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,anim,norm,pl" sem="r:poss" sem2=""/>его</w> <w><ana lex="путь" gr="S,inan,m,nom,norm,sg" sem="top:stripe t:space r:concr" sem2="ev:posit t:space t:asp r:abstr sc:space pt:aggr:aggrpl pt:aggr top:stripe r:concr der:shift"/>путь</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="далекий" gr="A,m,nom,norm,plen,sg" sem="t:dist:max r:qual" sem2="dt:dist:max der:shift t:time t:humq r:qual"/>далекий</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="глубина" gr="S,acc,f,inan,norm,sg" sem="r:abstr t:param t:size" sem2=