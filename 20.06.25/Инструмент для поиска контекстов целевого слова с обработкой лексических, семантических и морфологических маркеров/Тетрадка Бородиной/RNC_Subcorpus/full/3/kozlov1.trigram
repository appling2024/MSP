<p><se><b/><w><b>20</b></w><b>/</b><w><ana lex="viii" gr="bastard" sem="" sem2=""/><b>VIII</b></w><b>, </b><w><ana lex="r" gr="bastard" sem="" sem2=""/><b>R</b></w><b/>. <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w> <w><ana lex="тихий" gr="A,n,nom,norm,plen,sg" sem="d:neg t:sound r:qual" sem2="d:neg t:humq t:speed:min der:shift t:sound r:qual"/>тихое</w>, <w><ana lex="облачный" gr="A,n,nom,norm,plen,sg" sem="r:rel der:s" sem2="t:physq r:rel der:s"/>облачное</w>, <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="горизонт" gr="S,dat,inan,m,norm,sg" sem="t:space r:concr" sem2="t:ment t:space qc:stuff pt:qtm r:abstr pt:aggr r:concr"/>горизонту</w> <w><ana form="темно-синие" lex="темно-синий" gr="A,nom,norm,pl,plen" sem="der:comp dt:physq:color r:rel t:physq:color" sem2=""/>темно-синие</w> <w><ana lex="туча" gr="S,f,inan,nom,norm,pl" sem="qc:stuff top:form r:concr" sem2="t:quant:max pt:qtm r:concr r:abstr"/>тучи</w>.</se><se> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>У</w> <w><ana lex="я" gr="SPRO,1p,gen,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="восточный" gr="A,acc,inan,norm,pl,plen" sem="t:place dt:space r:rel der:s" sem2=""/>восточные</w> <w><ana lex="окно" gr="S,acc,inan,n,norm,pl" sem="t:tool t:space pc:constr:build pt:part top:vertical r:concr top:hole" sem2="t:space r:abstr pc:constr pt:part t:time r:concr"/>окна</w> <w><ana lex="открываться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="d:pref" sem2=""/>открывается</w> <w><ana lex="даль" gr="S,acc,f,inan,norm,sg" sem="t:space der:a sc:space pc:space r:concr t:fam" sem2="t:space der:a sc:space pt:aggr:aggrpl pt:aggr r:concr"/>даль</w> <w><ana lex="со" gr="PR,norm" sem="" sem2=""/>со</w> <w><ana lex="степной" gr="A,ins,norm,pl,plen" sem="t:place dt:space r:rel der:s" sem2=""/>степными</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="лесной" gr="