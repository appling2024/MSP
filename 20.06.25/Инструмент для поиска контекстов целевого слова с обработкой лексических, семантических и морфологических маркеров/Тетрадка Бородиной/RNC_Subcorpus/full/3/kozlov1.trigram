<p><se><w><ana lex="после" gr="PR,norm" sem="" sem2=""/>После</w> <w><ana lex="4" gr="NUM,ciph"/>4</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дня</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="сергей" gr="S,anim,ins,m,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Сергеем</w> <w><ana lex="анатольевич" gr="S,anim,ins,m,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Анатольевичем</w> <w><ana lex="отправиться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2=""/>отправился</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="барбот" gr="S,acc,bastard,inan,m,sg" sem="" sem2=""/>Барбот</w> <w><ana lex="де" gr="PART,norm" sem="" sem2=""/>де</w> <w><ana lex="марни" gr="S,anim,bastard,m,nom,persn,sg" sem="" sem2=""/>Марни</w>, <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="дорога" gr="S,dat,f,inan,norm,sg" sem="top:stripe t:space r:concr t:fam" sem2="t:move dt:space r:abstr der:shift t:space r:concr"/>дороге</w> <w><ana lex="встретить" gr="V,act,indic,norm,pf,pl,praet" sem="d:pref" sem2="d:pref"/>встретили</w> <w>П</w>. <w>С</w>. <w><ana lex="михно" gr="S,0,anim,bastard,famn" sem="t:hum r:propn t:famn" sem2=""/><ana lex="михно" gr="S,0,anim,bastard,persn" sem="t:hum r:propn t:famn" sem2=""/>Михно</w>, <w><ana lex="порадовать" gr="V,acc,act,anim,m,norm,partcp,pf,plen,praet,sg,tran" sem="der:v ca:caus d:pref t:psych:emot" sem2=""/>порадовавшего</w> <w><ana lex="то" gr="SPRO,inan,ins,n,norm,sg" sem="r:dem" sem2=""/>тем</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="мы" gr="SPRO,1p,dat,norm,pl" sem="r:pers" sem2=""/>нам</w> <w><ana lex="иметься" gr="V,3p,act,indic,intr