<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="ясный" gr="A,brev,n,norm,sg" sem="r:qual" sem2="r:qual"/>ясно</w>, <w><ana lex="прозрачный" gr="A,brev,n,norm,sg" sem="" sem2="r:qual"/>прозрачно</w>, <w>холодно</w>!</se><se> <w><ana lex="мороз" gr="S,anim,famn,m,nom,norm,sg" sem="" sem2=""/><ana lex="мороз" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:temper" sem2="t:fam r:abstr t:weather"/>Мороз</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="ветер" gr="S,inan,ins,m,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>ветром</w>, <w><ana lex="около" gr="PR,norm" sem="" sem2=""/>около</w> <w><ana lex="25" gr="NUM,ciph"/>25</w>°<w><ana lex="r" gr="bastard" sem="" sem2=""/>R</w>, <w><ana lex="что" gr="SPRO,inan,n,nom,norm,sg" sem="r:rel" sem2=""/>что</w> <w><ana lex="касаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:impact ca:noncaus der:v t:contact" sem2="der:v ca:noncaus"/>касается</w> <w><ana lex="направление" gr="S,gen,inan,n,norm,sg" sem="r:abstr t:dir" sem2="t:doc t:space der:s0 r:abstr der:v pt:part pc:space r:concr"/>направления</w> <w><ana lex="ветер" gr="S,gen,inan,m,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>ветра</w>, <w><ana lex="то" gr="CONJ,norm" sem="" sem2=""/>то</w> <w><ana lex="ничто" gr="SPRO,gen,n,norm,sg" sem="r:neg" sem2=""/>ничего</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="мочь" gr="V,2p,act,indic,intr,ipf,norm,praes,sg" sem="d:root" sem2=""/>можешь</w> <w><ana lex="сказать" gr="V,act,inf,norm,pf,tran" sem="t:speech ca:noncaus" sem2=""/>сказать</w>, <w><ana lex="ибо" gr="CONJ,norm" sem="" sem2=""/>ибо</w> <w><ana lex="он" gr="SPRO,3p,m,nom,norm,sg" sem="r:pers" sem2=""/>он</w> <w><ana lex="меняться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus" sem2="ca:noncaus"/>меняется</w> <w><ana lex="часто" gr="ADV,norm" sem="t:freq der:a" sem2=""/>часто</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="дуть" gr="V,3p,act