<p><se>«<w><ana lex="такой" gr="APRO,gen,norm,pl" sem="r:dem" sem2="r:indet r:spec t:degr:max"/>Таких</w> <w><ana lex="человек" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr" sem2="t:hum ev:posit r:concr"/>людей</w>, <w><ana lex="как" gr="CONJ,norm" sem="" sem2=""/>как</w> <w><ana lex="пржевальский" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Пржевальский</w>, <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="любить" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="ca:noncaus t:psych:emot d:root" sem2="d:root"/>любил</w> <w><ana lex="бесконечно" gr="ADV,norm" sem="dt:time:dur t:degr:max der:a" sem2=""/>бесконечно</w>», -- <w><ana lex="сказать" gr="V,act,indic,m,norm,pf,praet,sg,tran" sem="t:speech ca:noncaus" sem2=""/>сказал</w> <w><ana lex="чехов" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/><ana lex="чехов" gr="S,inan,m,nom,norm,sg" sem="" sem2="r:propn t:topon"/>Чехов</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="один" gr="APRO,loc,n,norm,sg" sem="" sem2="r:indet"/>одном</w> <w><ana lex="частный" gr="A,loc,n,norm,plen,sg" sem="r:rel der:s" sem2="r:rel der:s"/>частном</w> <w><ana lex="письмо" gr="S,inan,loc,n,norm,sg" sem="r:concr t:text" sem2="pt:aggr t:asp r:concr r:abstr sc:letter"/>письме</w>.</se> «&lt;...<se>&gt; <w><ana lex="такой" gr="APRO,nom,norm,pl" sem="r:dem" sem2="r:indet r:spec t:degr:max"/>Такие</w> <w><ana lex="человек" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr" sem2="t:hum ev:posit r:concr"/>люди</w>, <w><ana lex="как" gr="CONJ,norm" sem="" sem2=""/>как</w> <w><ana lex="покойный" gr="A,m,nom,norm,plen,sg" sem="r:qual" sem2="r:rel"/>покойный</w>, <w><ana lex="во" gr="PR,norm" sem="" sem2=""/>во</w> <w><ana lex="весь" gr="APRO,acc,inan,norm,pl" sem="r:spec" sem2=""/>все</w> <w><ana lex="век" gr="S,acc,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period r:abstr t:time"/>века</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w