<p><se><w><ana lex="небольшой" gr="A,n,nom,norm,plen,sg" sem="d:neg r:rel t:size:min dt:size:max der:a" sem2="t:degr:min d:neg der:a dt:size:max r:qual"/>Небольшое</w> <w><ana lex="население" gr="S,inan,n,nom,norm,sg" sem="sc:hum der:v pt:aggr r:concr" sem2="sc:animal der:s0 r:abstr der:v pt:aggr r:concr"/>население</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="особенность" gr="S,f,inan,loc,norm,sg" sem="r:abstr der:a" sem2="r:abstr der:a"/>особенности</w> <w><ana lex="представитель" gr="S,anim,m,nom,norm,sg" sem="der:v t:hum r:concr d:nag" sem2="der:v t:hum r:concr d:nag"/>представитель</w> «<w><ana lex="монголор" gr="S,bastard,gen,inan,m,sg" sem="" sem2=""/>Монголора</w>» <w><ana lex="алексей" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Алексей</w> <w><ana lex="александрович" gr="S,anim,m,nom,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2="t:hum r:propn t:famn"/><ana lex="александрович" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum t:patrn r:propn der:s" sem2="t:hum r:propn t:famn"/>Александрович</w> <w><ana lex="кузнецов" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Кузнецов</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="его" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,n,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,f,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,m,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,n,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,f,gen,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,n,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,f,gen,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,m,norm,pl" sem="r: