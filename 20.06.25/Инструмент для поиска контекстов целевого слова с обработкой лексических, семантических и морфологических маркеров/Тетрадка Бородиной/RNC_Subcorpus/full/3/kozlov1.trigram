<p><se><b/><w><b>1-2</b></w><b>/</b><w><ana lex="viii" gr="bastard" sem="" sem2=""/><b>VIII</b></w><b>, </b><w><ana lex="u" gr="bastard" sem="" sem2=""/><b>U-S</b></w><b/>. <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w> <w><ana lex="серый" gr="A,n,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>серое</w>, <w><ana lex="мрачный" gr="A,n,nom,norm,plen,sg" sem="dt:light dt:neg t:physq:light dt:abstr der:s r:qual" sem2="dt:light dt:neg dt:abstr ev:neg der:s r:qual t:psych:emot"/>мрачное</w>.</se><se> <w><ana lex="идти" gr="V,1p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus t:move d:root" sem2="ca:noncaus t:move d:root"/>Идем</w> (<w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="глаголев" gr="S,anim,famn,ins,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Глаголевым</w>) <w><ana lex="хлопотать" gr="V,act,inf,intr,ipf,norm" sem="d:root" sem2="d:root"/>хлопотать</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="дальнейший" gr="A,loc,m,norm,plen,sg" sem="dt:dist:max der:a d:super r:qual" sem2=""/>дальнейшем</w> <w><ana lex="проезд" gr="S,inan,loc,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="der:v top:stripe t:space r:concr"/>проезде</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="почтовый" gr="A,loc,m,norm,plen,sg" sem="dt:org r:rel der:s" sem2=""/>почтовом</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="иркутск" gr="S,gen,inan,m,norm,sg" sem="r:propn t:topon" sem2=""/>Иркутска</w>.</se><se> <w><ana lex="ведь" gr="CONJ,norm" sem="" sem2=""/>Ведь</w> <w><ana lex="если" gr="CONJ,norm" sem="" sem2=""/>если</w> <w><ana lex="поехать" gr="V,1p,act,fut,indic,intr,norm,pf,pl" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="поехать" gr="V,1p,act,imper,intr,norm,pf,pl" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus