<p><se><b/><w><b>15</b></w><b>/</b><w><ana lex="x" gr="bastard" sem="" sem2=""/><b>X</b></w><b>, </b><w><ana lex="r" gr="bastard" sem="" sem2=""/><b>R</b></w><b/>. <w><ana lex="погода" gr="S,f,inan,nom,norm,sg" sem="r:abstr t:weather" sem2=""/>Погода</w> <w><ana lex="прекрасный" gr="A,f,nom,norm,plen,sg" sem="ev:posit t:appearance r:qual" sem2="ev:posit t:quality r:qual"/>прекрасная</w>, <w><ana lex="сравнительно" gr="ADV,norm" sem="dt:degr der:a" sem2=""/>сравнительно</w> <w><ana lex="тихий" gr="A,f,nom,norm,plen,sg" sem="d:neg t:sound r:qual" sem2="d:neg t:humq t:speed:min der:shift t:sound r:qual"/>тихая</w>, <w><ana lex="теплый" gr="A,f,nom,norm,plen,sg" sem="dt:temper dt:abstr t:physq:temper der:s r:qual" sem2="ev:posit t:physq:color dt:temper t:physq:temper dt:abstr der:s r:qual r:rel"/>теплая</w>, <w><ana lex="ясный" gr="A,f,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясная</w>.</se><se> <w><ana lex="даль" gr="S,anim,famn,m,nom,norm,sg" sem="" sem2=""/>Даль</w>, <w><ana lex="синий" gr="A,f,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:physq:color r:qual"/>синяя</w> <w><ana lex="горный" gr="A,f,nom,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s"/>горная</w> <w><ana lex="даль" gr="S,f,inan,nom,norm,sg" sem="t:space der:a sc:space pc:space r:concr t:fam" sem2="t:space der:a sc:space pt:aggr:aggrpl pt:aggr r:concr"/>даль</w> <w><ana lex="звать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="t:speech ca:noncaus d:root" sem2="d:root"/>зовет</w>!</se><se> <w><ana lex="становиться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus" sem2=""/>Становится</w> <w>тоскливо</w>.</se><se> <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="послать" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:caus t:move d:pref" sem2="d:pref"/>послал</w> <w><ana lex="весь" gr="APRO,acc,inan,norm,pl" sem="r:spec" sem2=""/>все</w> <w><ana lex="бумага" gr="S,acc,f,inan,norm,pl" sem="t:stuff r:concr" sem2="t:stuff r:c