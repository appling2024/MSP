<p><se><b/><w><b>25</b></w><b>/</b><w><ana lex="viii" gr="bastard" sem="" sem2=""/><b>VIII</b></w><b>, </b><w><ana lex="w" gr="bastard" sem="" sem2=""/><b>W</b></w><b/>. <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>С</w> <w><ana lex="утро" gr="S,gen,inan,n,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утра</w> <w><ana lex="стрелять" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="der:s" sem2="t:impact:destr ca:caus t:be:disapp t:poss ca:0 t:sound der:s ca:noncaus t:physiol"/>стреляли</w> <w><ana lex="при" gr="PR,norm" sem="" sem2=""/>при</w> <w><ana lex="серенький" gr="A,f,loc,norm,plen,sg" sem="d:dim dt:physq:color der:a t:physq:color r:qual" sem2=""/>серенькой</w> <w><ana lex="погода" gr="S,f,inan,loc,norm,sg" sem="r:abstr t:weather" sem2=""/>погоде</w>.</se><se> <w><ana lex="после" gr="PR,norm" sem="" sem2=""/>После</w> <w><ana lex="обед" gr="S,gen,inan,m,norm,sg" sem="r:abstr" sem2="t:food sc:food r:abstr pt:aggr t:time r:concr"/>обеда</w> <w><ana lex="мы" gr="SPRO,1p,acc,norm,pl" sem="r:pers" sem2=""/>нас</w> <w><ana lex="посетить" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v t:be d:pref ca:noncaus"/>посетил</w> <w><ana lex="консул" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr" sem2="t:hum r:concr"/>консул</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="который" gr="APRO,ins,m,norm,sg" sem="r:rel t:ord" sem2=""/>которым</w> <w><ana lex="интересно" gr="ADV,norm" sem="ev:posit dt:quality der:a" sem2=""/>интересно</w> <w><ana lex="беседовать" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:speech ca:noncaus der:s" sem2=""/>беседовали</w> <w><ana lex="вообще" gr="ADV,PARENTH,norm" sem="dt:general der:a" sem2=""/>вообще</w> <w><ana lex="около" gr="PR,norm" sem="" sem2=""/>около</w> <w><ana lex="час" gr="S,gen,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часа</w>.</se></p>
<p><se><w><ana lex="вечер" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечер</w> <w><ana lex="провести" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="провести" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="проводить" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="ca:caus t:move d:pref" sem2="d:pref"/>проведен</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w>П</w>. <w>С</w>. <w><ana lex="михно" gr="S,0,anim,bastard,famn" sem="t:hum r:propn t:famn" sem2=""/><ana lex="михно" gr="S,0,anim,bastard,persn" sem="t:hum r:propn t:famn" sem2=""/>Михно</w>, <w><ana lex="вначале" gr="ADV,norm" sem="der:s t:time" sem2=""/>вначале</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="специальный" gr="A,dat,norm,pl,plen" sem="r:rel" sem2="r:rel"/>специальным</w> <w><ana lex="вопрос" gr="S,dat,inan,m,norm,pl" sem="t:speech r:abstr" sem2="t:ment r:abstr"/>вопросам</w> <w><ana lex="отделение" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0" sem2="pc:org pt:set pc:contain t:org r:abstr der:v sc:hum pt:part pc:action r:concr"/>отделения</w> <w><ana lex="рго" gr="S,0,anim,bastard,m,sg" sem="" sem2=""/><ana lex="рго" gr="S,0,anim,bastard,m,persn,sg" sem="" sem2=""/>РГО</w>, <w><ana lex="примерно" gr="ADV,norm" sem="der:a" sem2=""/>примерно</w> <w><ana lex="около" gr="PR,norm" sem="" sem2=""/>около</w> <w><ana lex="1" gr="NUM,ciph"/>1</w>Ѕ <w><ana lex="час" gr="S,gen,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часа</w> -- <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="6" gr="NUM,ciph"/>6</w>Ѕ <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="8" gr="NUM,ciph"/>8</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w>,