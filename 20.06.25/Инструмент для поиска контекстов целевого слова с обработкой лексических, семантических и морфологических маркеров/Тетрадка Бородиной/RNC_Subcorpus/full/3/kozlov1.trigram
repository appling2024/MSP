<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w> <w><ana lex="препаратор" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr der:s" sem2=""/>препаратор</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w> <w><ana lex="уезжать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:move d:pref" sem2=""/>уезжает</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="некоторый" gr="APRO,acc,n,norm,sg" sem="r:indet" sem2=""/>некоторое</w> <w><ana lex="время" gr="S,acc,inan,n,norm,sg" sem="r:abstr t:param t:time" sem2="t:time:period r:abstr t:time"/>время</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w>Ежо</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="урочище" gr="S,inan,loc,n,norm,sg" sem="t:space r:concr" sem2=""/>урочище</w> <w><ana lex="баин" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Баин-булак</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="цель" gr="S,f,inan,ins,norm,sg" sem="t:space r:concr" sem2="t:ment r:abstr"/>целью</w> <w><ana lex="поэкскурсировать" gr="V,act,bastard,inf,intr,ipf" sem="" sem2=""/>поэкскурсировать</w> <w><ana lex="там" gr="ADVPRO,norm" sem="t:place r:dem" sem2=""/>там</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="добыть" gr="V,act,inf,norm,pf" sem="der:v ca:caus d:pref t:poss" sem2="der:v d:pref"/>добыть</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="возможность" gr="S,dat,f,inan,norm,sg" sem="der:a r:abstr t:mod" sem2="r:abstr der:a"/>возможности</w> <w><ana lex="птичка" gr="S,f,gen,inan,norm,pl" sem="" sem2="t:sign r:concr"/><ana lex="птичка" gr="S,anim,f,gen,norm,pl" sem="t:hum ev r:concr der:s d:dim" sem2=""/>птичек</w>, <w><ana lex="который" gr="APRO,acc,anim,norm,pl" sem="r:rel t:ord" sem2=""/>которых</