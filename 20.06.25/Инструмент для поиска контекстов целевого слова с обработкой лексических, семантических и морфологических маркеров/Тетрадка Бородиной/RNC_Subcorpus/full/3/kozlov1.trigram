<p><se><w>Ежо</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="рысь" gr="S,anim,f,nom,norm,sg" sem="t:animal r:concr" sem2=""/><ana lex="рысь" gr="S,f,inan,nom,norm,sg" sem="r:abstr hi:sort t:asp:move" sem2="t:fam r:abstr t:asp:move"/>рысь</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="убить" gr="V,act,indic,m,norm,pf,praet,sg" sem="t:impact ca:caus t:be:disapp d:pref" sem2="ca:caus d:pref t:be:disapp"/>убил</w>: <w><ana lex="она" gr="SPRO,3p,f,nom,norm,sg" sem="r:pers" sem2=""/>она</w> <w><ana lex="разгуливать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v d:pref d:impf" sem2="der:v ca:noncaus t:move d:impf d:pref"/>разгуливает</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="его" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,n,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,f,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,m,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,n,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,f,gen,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,n,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,f,gen,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,m,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,n,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,f,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,m,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,n,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,f,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,m,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,n,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,f,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,m,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,anim,m,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,inan,m,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,n,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,f,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,m,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,n,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,anim,norm,pl" sem="r:poss" sem2=""/>его</w> <w><ana lex="охотничий" gr="A,loc,norm,pl,plen" sem="r:poss der:s dt:hum" sem2=""/>охотничьих</w> <w><ana lex="владение" gr="S,inan,loc,n,norm,pl" sem="der:v r:abstr der:s0 t:poss" sem2="der:v t:space r:concr"/>владениях</w>!</se></p>
<p><se><w><ana lex="ночь" gr="S,f,inan,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2=""/>Ночь</w> <w><ana lex="ясный" gr="A,f,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясная</w>, <w><ana lex="холодный" gr="A,f,nom,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодная</w>.</se><se> <w><ana lex="луна" gr="S,f,inan,nom,norm,sg" sem="top:horiz top:spher t:astr t:space r:concr" sem2="t:space r:concr t:astr top:spher top:horiz pt:addit"/>Луна</w> <w><ana lex="светить" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:light" sem2=""/>светит</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="ярко" gr="ADV,norm" sem="ev:posit dt:physq:color der:a" sem2="dt:physq:color ev der:a"/>ярко</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w>, <w>кажется</w>, <w>можно</w> <w><ana lex="читать" gr="V,act,inf,ipf,norm,tran" sem="d:root" sem2="d:root"/>читать</w>.</se></p>
<p><se><b/><w><b>21</b></w><b>/</b><w><ana lex="i" gr="bastard" sem="" sem2=""/><b>I</b></w><b>, </b><w><ana lex="r" gr="bastard" sem="" sem2=""/><b>R</b></w><b/>. <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w> <w><ana lex="также" gr="PART,norm" sem="" sem2=""/>также</w> <w><ana lex="ясный" gr="A,n,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясное</w>, <w><ana lex="холодный" gr="A,n,nom,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодное</w>.</se><se> <w><ana lex="снег" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2=""/>Снег</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="богдо" gr="ADV,bastard" sem="" sem2=""/>Богдо-уле</w> <w><ana lex="искриться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v ca:noncaus t:light" sem2=""/>искрится</w>.</se><se> <w><ana lex="непременно" gr="ADV,norm" sem="der:a" sem2=""/>Непременно</w> <w>нужно</w> <w><ana lex="весна" gr="S,f,inan,ins,norm,sg" sem="t:time:season r:abstr t:time" sem2=""/>весною</w>, <w><ana lex="когда" gr="CONJ,norm" sem="" sem2=""/>когда</w> <w><ana lex="снег" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2=""/>снег</w> <w><ana lex="уменьшиться" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="dt:size:min der:a der:v t:changest ca:noncaus d:pref" sem2=""/>уменьшится</w>, <w><ana lex="поехать" gr="V,act,inf,intr,norm,pf" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/>поехать</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="богдо" gr="ADV,bastard" sem="" sem2=""/>Богдо-ула</w>, <w><ana lex="посмотреть" gr="V,act,inf,norm,pf,tran" sem="ca:noncaus d:pref t:perc" sem2="d:pref"/>посмотреть</w> <w><ana lex="характер" gr="S,acc,inan,m,norm,sg" sem="pt:aggr r:abstr" sem2="r:abstr"/>характер</w> <w><ana lex="этот" gr="APRO,f,gen,norm,sg" sem="r:dem" sem2=""/>этой</w> <w><ana lex="гора" gr="S,f,gen,inan,norm,sg" sem="top:hill t:space r:concr" sem2="sc:x pt:set t:space t:form r:abstr t:quant:max r:concr"/>горы</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="только" gr="PART,norm" sem="" sem2=""/>только</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="северный" gr="A,loc,m,norm,plen,sg" sem="t:place dt:space r:rel der:s" sem2=""/>северном</w> <w><ana lex="склон" gr="S,inan,loc,m,norm,sg" sem="t:space top:slope der:v top:form pt:part pc:space r:concr" sem2=""/>склоне</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="даже" gr="PART,norm" sem="" sem2=""/>даже</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="южный" gr="A,loc,m,norm,plen,sg" sem="t:place dt:space r:rel der:s" sem2=""/>южном</w>, <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="монгольский" gr="A,f,gen,norm,plen,sg" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>монгольской</w> <w><ana lex="маньчжурия" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Маньчжурии</w>, <w><ana lex="хотя" gr="CONJ,norm" sem="" sem2=""/>хотя</w> <w><ana lex="я" gr="SPRO,1p,acc,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="занимать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="d:pref" sem2=""/>занимает</w> <w><ana lex="главный" gr="A,ins,m,norm,plen,sg" sem="t:hier r:qual" sem2="t:hier r:qual"/>главным</w> <w><ana lex="образ" gr="S,inan,ins,m,norm,sg" sem="t:ment r:concr r:abstr t:workart" sem2="t:asp r:abstr"/>образом</w> <w><ana lex="самый" gr="APRO,acc,inan,m,norm,sg" sem="r:spec" sem2="r:spec"/>самый</w> <w><ana lex="массив" gr="S,acc,inan,m,norm,sg" sem="pt:set t:space r:concr sc:space" sem2="pt:set sc:constr:build t:space r:concr sc:plant"/>массив</w> <w><ana lex="богдо" gr="ADV,bastard" sem="" sem2=""/>Богдо-ула</w>.</se></p>
<p><se><w><ana lex="все" gr="SPRO,inan,n,nom,norm,sg" sem="" sem2=""/>Все</w> <w><ana lex="продолжать" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="aux:phase d:pref der:a" sem2=""/>продолжаю</w> <w><ana lex="писать" gr="V,act,inf,ipf,norm" sem="d:root" sem2="d:root"/><ana lex="писать" gr="V,act,inf,ipf,norm,tran" sem="d:root" sem2="d:root"/><ana lex="писать" gr="V,act,inf,ipf,norm" sem="d:root" sem2="d:root"/>писать</w> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="россия" gr="S,f,inan,loc,norm,sg" sem="r:propn t:topon" sem2=""/>России</w>, <w><ana lex="заканчивать" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="der:v t:be:disapp d:impf d:pref" sem2=""/>заканчиваю</w> <w><ana lex="отчет" gr="S,acc,inan,m,norm,pl" sem="t:speech der:v r:abstr der:s0" sem2="t:speech r:abstr"/>отчеты</w>, <w><ana lex="строчить" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="t:impact ca:caus" sem2=""/>строчу</w> <w><ana lex="михно" gr="S,0,anim,bastard,famn" sem="t:hum r:propn t:famn" sem2=""/><ana lex="михно" gr="S,0,anim,bastard,persn" sem="t:hum r:propn t:famn" sem2=""/>Михно</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="свой" gr="APRO,dat,norm,pl" sem="r:poss" sem2="t:social r:poss"/>своим</w>.</se><se> <w><ana lex="вот" gr="PART,norm" sem="" sem2="r:dem"/>Вот</w> <w><ana lex="они" gr="SPRO,3p,nom,norm,pl" sem="r:pers" sem2=""/>они</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="наговориться" gr="V,3p,act,fut,indic,intr,norm,pf,pl" sem="t:speech ca:noncaus d:pref" sem2=""/>наговорятся</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="участница" gr="S,anim,f,ins,norm,sg" sem="t:hum d:fem r:concr der:s" sem2=""/>участницей</w> <w><ana lex="мой" gr="APRO,f,gen,norm,sg" sem="r:poss" sem2=""/>моей</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w> <w>Е</w>. <w>П</w>. <w><ana lex