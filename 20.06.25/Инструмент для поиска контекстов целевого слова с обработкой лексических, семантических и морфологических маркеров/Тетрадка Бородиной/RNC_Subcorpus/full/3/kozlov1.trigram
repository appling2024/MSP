ине</w> <w><ana lex="курень" gr="S,gen,inan,m,norm,sg" sem="top:contain t:constr r:concr" sem2="sc:hum t:space top:contain t:org pt:set pt:part t:constr:build r:concr"/>Куреня</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="город" gr="S,inan,loc,m,norm,sg" sem="sc:constr:build t:space r:concr" sem2="t:space r:concr"/>городе</w>.</se><se> <w>Надо</w> <w><ana lex="хорошо" gr="ADV,PRAEDIC,norm" sem="ev:posit dt:quality der:a" sem2=""/><ana lex="хорошо" gr="ADV,PARENTH,norm" sem="ev:posit dt:quality der:a" sem2=""/>хорошо</w> <w><ana lex="знать" gr="V,act,inf,ipf,norm,tran" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/>знать</w> <w><ana lex="город" gr="S,acc,inan,m,norm,sg" sem="sc:constr:build t:space r:concr" sem2="t:space r:concr"/>город</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="уметь" gr="V,act,inf,intr,ipf,norm" sem="d:root" sem2="d:root"/>уметь</w> <w><ana lex="ориентироваться" gr="V,act,inf,intr,norm,pf" sem="ca:noncaus" sem2="ca:noncaus"/><ana lex="ориентироваться" gr="V,act,inf,intr,ipf,norm" sem="ca:noncaus" sem2="ca:noncaus"/>ориентироваться</w>, <w><ana lex="чтобы" gr="CONJ,norm" sem="" sem2=""/>чтобы</w> <w><ana lex="среди" gr="PR,norm" sem="" sem2=""/>среди</w> <w><ana lex="множество" gr="S,gen,inan,n,norm,sg" sem="t:quant:max pt:set sc:x r:abstr" sem2="pt:set sc:x der:adv r:concr hi:class"/>множества</w> <w><ana lex="улица" gr="S,f,gen,inan,norm,pl" sem="t:space r:concr pt:part pc:space" sem2="sc:hum pt:aggr t:space r:concr sc:space"/>улиц</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="узкий" gr="A,gen,norm,pl,plen" sem="t:size:min r:qual" sem2="ev:neg t:size:min r:qual"/>узких</w> <w><ana lex="переулок" gr="S,gen,inan,m,norm,pl" sem="top:stripe t:space r:concr der:s" sem2=""/>переулков</w> <w><ana lex="добраться" gr="V,act,inf,intr,norm,pf" sem="ca:noncaus t:move d:pref" sem2="ca:noncaus d:pref"/>добраться</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w>