<p><se><w><ana lex="серый" gr="A,m,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>Серый</w> <w><ana lex="день" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w>, <w><ana lex="короткий" gr="A,m,nom,norm,plen,sg" sem="t:size:min r:qual" sem2="t:behav ev:posit t:size:min t:time:dur:min r:qual"/>короткий</w> <w><ana lex="горизонт" gr="S,inan,m,nom,norm,sg" sem="t:space r:concr" sem2="t:ment t:space qc:stuff pt:qtm r:abstr pt:aggr r:concr"/>горизонт</w> <w><ana lex="гармонировать" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:s" sem2=""/>гармонируют</w> <w><ana lex="вполне" gr="ADV,norm" sem="dt:full t:degr:max der:a" sem2=""/>вполне</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="наш" gr="APRO,ins,n,norm,sg" sem="r:poss" sem2=""/>нашим</w> <w><ana lex="грустный" gr="A,ins,n,norm,plen,sg" sem="dt:abstr dt:psych:emot t:psych:emot der:s r:qual" sem2="dt:abstr dt:psych:emot ev:neg der:s r:qual"/>грустным</w> <w><ana lex="настроение" gr="S,inan,ins,n,norm,sg" sem="t:psych r:abstr" sem2="t:psych r:abstr"/>настроением</w>.</se><se> <w><ana lex="телеграмма" gr="S,f,gen,inan,norm,pl" sem="der:comp r:concr t:text" sem2=""/>Телеграмм</w> <w>нет</w>.</se><se> <w><ana lex="прислушиваться" gr="V,2p,act,indic,intr,ipf,norm,praes,sg" sem="der:v d:impf d:pref t:perc" sem2=""/>Прислушиваешься</w> <w><ana lex="ко" gr="PR,norm" sem="" sem2=""/>ко</w> <w><ana lex="всякий" gr="APRO,dat,m,norm,sg" sem="r:spec" sem2=""/>всякому</w> «<w><ana lex="шорох" gr="S,dat,inan,m,norm,sg" sem="t:sound r:abstr" sem2=""/>шороху</w>».</se><se> <w><ana lex="скольким" gr="NUM,norm" sem="" sem2=""/>Сколько</w> <w><ana lex="сплетня" gr="S,f,gen,inan,norm,pl" sem="t:speech r:abstr ev:neg" sem2=""/>сплетен</w> <w><ana lex="зарождаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v d:pref" sem2=""/>зарождается</w> <w><ana lex="по" gr="PR,norm"