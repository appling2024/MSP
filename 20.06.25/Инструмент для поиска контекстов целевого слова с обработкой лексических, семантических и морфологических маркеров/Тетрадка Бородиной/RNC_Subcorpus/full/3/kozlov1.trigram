<p><se><w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>Я</w> <w><ana lex="снарядить" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:caus d:pref t:poss" sem2=""/>снарядил</w> <w><ana lex="елена" gr="S,acc,anim,f,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Елену</w> <w><ana lex="петровна" gr="S,acc,anim,f,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Петровну</w> <w><ana lex="обстоятельный" gr="A,ins,m,norm,plen,sg" sem="ev:posit r:rel" sem2="ev:posit t:humq r:qual"/>обстоятельным</w> <w><ana lex="образ" gr="S,inan,ins,m,norm,sg" sem="t:ment r:concr r:abstr t:workart" sem2="t:asp r:abstr"/>образом</w>: <w><ana lex="американский" gr="A,ins,norm,pl,plen" sem="dt:topon r:rel der:s t:topon" sem2=""/>американскими</w> <w><ana lex="доллар" gr="S,inan,ins,m,norm,pl" sem="r:concr t:money:banknote" sem2=""/>долларами</w>, <w><ana lex="серебряный" gr="A,ins,norm,pl,plen" sem="dt:stuff r:rel der:s" sem2=""/>серебряными</w> <w><ana lex="китайский" gr="A,ins,norm,pl,plen" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>китайскими</w> <w><ana lex="доллар" gr="S,inan,ins,m,norm,pl" sem="r:concr t:money:banknote" sem2=""/>долларами</w>, <w><ana lex="банкнот" gr="S,inan,ins,m,norm,pl" sem="r:concr t:money:banknote" sem2=""/>банкнотами</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="проч" gr="S,anim,bastard,m,nom,sg" sem="" sem2=""/><ana lex="проча" gr="S,bastard,f,gen,inan,pl" sem="" sem2=""/>проч</w>.</se><se> <w><ana lex="она" gr="SPRO,3p,f,nom,norm,sg" sem="r:pers" sem2=""/>Она</w> <w><ana lex="взять" gr="V,act,f,indic,norm,pf,praet,sg,tran" sem="ca:caus t:poss" sem2="ca:noncaus"/>взяла</w> <w><ana lex="мой" gr="APRO,acc,inan,norm,pl" sem="r:poss" sem2=""/>мои</w> <w><ana lex="пакет" gr="S,acc,inan,m,norm,pl" sem="top:contain t:tool r:concr" sem2="sc:thing sc:doc t:tool top:contain pt:qtm pt:set sc:qtm r:concr"/>пакеты</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w>проч</w>.</se><se> <w>Кажется</w>, <w><ana lex="автомобиль" gr="S,inan,m,nom,norm,sg" sem="t:tool:transp r:concr" sem2=""/>автомобиль</w> <w><ana lex="быть" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>будет</w> <w><ana lex="загрузить" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="d:pref" sem2="d:pref"/>загружен</w> <w><ana lex="изрядно" gr="ADV,norm" sem="t:quant:max dt:quant:max der:a" sem2=""/>изрядно</w>.</se><se> <w><ana lex="ранний" gr="A,ins,m,norm,plen,sg" sem="t:time r:qual" sem2="t:time r:qual"/>Ранним</w> <w><ana lex="вечер" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>вечером</w>, <w><ana lex="усталый" gr="A,nom,norm,pl,plen" sem="der:v t:physiol dt:physiol r:qual" sem2="der:shift dt:physiol r:qual"/>усталые</w>, <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="улечься" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus d:pref t:move:body" sem2="ca:noncaus d:pref"/>улеглись</w>.</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="дом" gr="S,inan,loc,m,norm,sg" sem="top:contain t:constr:build r:concr" sem2="sc:hum pt:set t:space t:org t:group der:shift r:concr"/>доме</w> <w><ana lex="стать" gr="V,act,indic,intr,n,norm,pf,praet,sg" sem="aux:phase d:root t:move:body" sem2="ca:noncaus t:move d:root t:loc"/>стало</w> <w>пусто</w>, <w>холодно</w>, <w>крикливо</w>!</se></p>
<p><se><b/><w><b>29</b></w><b>/</b><w><ana lex="i" gr="bastard" sem="" sem2=""/><b>I</b></w><b>, </b><w><ana lex="u" gr="bastard" sem="" sem2=""/><b>U</b></w><b/>. <w><ana lex="ночь" gr="S,f,inan,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2=""/>Ночь</w> <w><ana lex="тихий" gr="A,f,nom,norm,plen,sg" sem="d:neg t:sound r:qual" sem2="d:neg t:humq t:speed:min der:shift t:sound r:qual"/>тихая</w>, <w><ana lex="полуясный" gr="A,bastard,f,nom,plen,sg" sem="" sem2=""/>полуясная</w>, <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утро</w> <w><ana lex="облачный" gr="A,n,nom,norm,plen,sg" sem="r:rel der:s" sem2="t:physq r:rel der:s"/>облачное</w>.</se><se> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>Мы</w> <w><ana lex="провожать" gr="V,1p,act,indic,ipf,norm,pl,praes,tran" sem="der:v t:move d:pref" sem2=""/>провожаем</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="далекий" gr="A,acc,inan,m,norm,plen,sg" sem="t:dist:max r:qual" sem2="dt:dist:max der:shift t:time t:humq r:qual"/>далекий</w> <w><ana lex="путь" gr="S,acc,inan,m,norm,sg" sem="top:stripe t:space r:concr" sem2="ev:posit t:space t:asp r:abstr sc:space pt:aggr:aggrpl pt:aggr top:stripe r:concr der:shift"/>путь</w> <w><ana lex="елена" gr="S,acc,anim,f,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Елену</w> <w><ana lex="петровна" gr="S,acc,anim,f,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Петровну</w>.</se><se> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>С</w> <w><ana lex="город" gr="S,gen,inan,m,norm,sg" sem="sc:constr:build t:space r:concr" sem2="t:space r:concr"/>города</w> <w><ana lex="сняться" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref"/>снялась</w> <w><ana lex="сизый" gr="A,f,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2=""/>сизая</w> <w><ana lex="дымовой" gr="A,f,nom,norm,plen,sg" sem="dt:stuff r:rel der:s" sem2=""/>дымовая</w> <w><ana lex="завеса" gr="S,f,inan,nom,norm,sg" sem="der:v t:tool r:concr" sem2="der:v t:form r:concr r:abstr"/>завеса</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="северный" gr="A,ins,n,norm,plen,sg" sem="t:place dt:space r:rel der:s" sem2=""/>северным</w> <w><ana lex="дуновение" gr="S,inan,ins,n,norm,sg" sem="t:move r:abstr" sem2=""/>дуновением</w> <w><ana lex="унестись" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v d:pref"/>унеслась</w> <w><ana lex="сначала" gr="ADV,norm" sem="der:s t:time" sem2=""/>сначала</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="подножие" gr="S,dat,inan,n,norm,sg" sem="t:space pc:constr der:s pt:part pc:space r:concr" sem2=""/>подножию</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="поздний" gr="A,comp,norm,plen" sem="t:time r:qual" sem2="t:time r:qual"/>позднее</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="средний" gr="A,acc,inan,m,norm,plen,sg" sem="t:degr r:qual" sem2="r:qual r:rel t:humq t:size"/>средний</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="верхний" gr="A,acc,inan,m,norm,plen,sg" sem="t:place dt:space der:s r:qual" sem2="dt:space der:s r:qual t:place t:species r:rel"/>верхний</w> <w><ana lex="пояс" gr="S,acc,inan,m,norm,sg" sem="top:rope t:access r:concr pc:tool:cloth pt:part:addit pt:addit" sem2="qc:space top:rope t:space pc:hum pc:animal pt:part:addit top:ring der:shift sc:partb pt:part pt:qtm pt:partb pc:partb pc:space r:concr"/>пояс</w> <w><ana lex="богдо" gr="ADV,bastard" sem="" sem2=""/>Богдо-улы</w>, <w><ana lex="словно" gr="CONJ,norm" sem="" sem2=""/>словно</w> <w><ana lex="жертвенный" gr="A,acc,inan,m,norm,plen,sg" sem="dt:hum der:s dt:thing ev r:rel dt:animal" sem2="dt:hum der:s dt:thing ev r:rel dt:animal"/>жертвенный</w> <w><ana lex="фимиам" gr="S,acc,inan,m,norm,sg" sem="t:stuff r:concr" sem2=""/>фимиам</w>.</se><se> <w><ana lex="даль" gr="S,anim,famn,m,nom,norm,sg" sem="" sem2=""/>Даль</w> <w><ana lex="мало" gr="ADV,norm" sem="dt:size:min r:spec t:quant:min der:a" sem2=""/>мало</w> <w><ana lex="открытый" gr="A,brev,f,norm,sg" sem="der:v r:qual" sem2="der:v ev:posit t:humq der:shift:v r:qual"/>открыта</w>, <w><ana lex="мешать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="ca:noncaus d:root" sem2="d:root"/><ana lex="мешать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus d:root" sem2="d:root"/>мешает</w> <w><ana lex="серый" gr="A,f,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>серая</w> <w><ana lex="пелена" gr="S,f,inan,nom,norm,sg" sem="t:stuff r:concr" sem2="r:abstr"/>пелена</w>.</se><se> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>По</w> <w><ana lex="долина" gr="S,f,inan,loc,norm,sg" sem="t:space r:concr der:s t:fam" sem2=""/>долине</w> <w><ana lex="там" gr="ADVPRO,norm" sem="t:place r:dem" sem2=""/>там</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="сям" gr="ADVPRO,norm" sem="r:dem" sem2=""/>сям</w> <w><ana lex="караван" gr="S,inan,m,nom,norm,pl" sem="pt:set r:concr sc:animal" sem2="pt:set sc:tool:transp sc:stuff r:concr sc:aggr"/>караваны</w>; <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="боковой" gr="A,loc,norm,pl,plen" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s t:dir"/>боковых</w> <w><ana lex="возвышение" gr="S,inan,loc,n,norm,pl" sem="der:v r:abstr der:s0" sem2="top:hill der:v t:space r:concr"/>возвышениях</w> <w><ana lex="орел" gr="S,inan,m,nom,norm,sg" sem="r:propn t:topon" sem2="der:shift r:concr t:fam"/><ana lex="орел" gr="S,inan,m,nom,norm,sg" sem="r:propn t:topon" sem2="der:shift r:concr t:fam"/><ana lex="орел" gr="S,anim,m,nom,norm,sg" sem="t:animal r:concr" sem2=""/>орел</w> <w><ana lex="словно" gr="CONJ,norm" sem="" sem2=""/>словно</w> <w><ana lex="санитар" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr" sem2=""/>санитар</w>.</se></p>
<p><se><w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>Я</w> <w><ana lex="думать" gr="V,1p,act,indic,intr,ipf,norm,praes,sg" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/><ana lex="думать" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/>думаю</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="сангина" gr="S,f,inan,loc,norm,sg" sem="" sem2=""/>Сангине</w>, <w><ana lex="следовать" gr="V,act,indic,ipf,n,norm,praet,sg" sem="ca:noncaus t:move der:s" sem2="ca:noncaus t:move der:s"/>следовало</w> <w><ana lex="бы" gr="PART,norm" sem="" sem2=""/>бы</w> <w><ana lex="там" gr="ADVPRO,norm" sem="t:place r:dem" sem2=""/>там</w> <w><ana lex="просить" gr="V,act,inf,ipf,norm,tran" sem="t:speech ca:caus d:root" sem2="d:root"/>просить</w> <w><ana lex="убивать" gr="V,act,inf,ipf,norm,tran" sem="der:v ca:caus t:be:disapp t:impact d:pref d:impf" sem2=""/>убивать</w> <w><ana lex="животное" gr="S,acc,anim,n,norm,pl" sem="der:subst t:animal der:a r:concr hi:class" sem2="der:subst t:animal r:concr der:a"/>животных</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="открытый" gr="A,loc,n,norm,plen,sg" sem="der:v r:qual" sem2="t:physq:form ev:posit t:humq r:rel der:v r:qual der:shift:v"/>открытом</w> <w><ana lex="место" gr="S,inan,loc,n,norm,sg" sem="qc:space t:space r:concr" sem2="qc:space sc:org t:tool t:space pt:element r:abstr pt:aggr:aggrpl pt:part pc:text r:concr"/>месте</w>, <w><ana lex="немного" gr="ADV,norm" sem="t:degr:min ev der:adv" sem2="ev t:time:dur:min t:quant:min der:adv"/>немного</w> <w><ana lex="вдали" gr="ADV,norm" sem="dt:dist:max t:dist:max der:s" sem2=""/>вдали</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="постройка" gr="S,f,gen,inan,norm,pl" sem="der:v r:abstr der:s0 t:impact:creat" sem2="der:v top:contain t:constr:hut r:concr"/>построек</w>, <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="привлечение" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr" sem2=""/>привлечения</w> <w><ana lex="хищник" gr="S,anim,gen,m,norm,pl" sem="t:animal r:concr der:a" sem2=""/>хищников</w>.</se><se> <w><ana lex="собираться" gr="V,1p,act,indic,intr,ipf,norm,praes,sg" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref t:psych:volit"/>Собираюсь</w> <w><ana lex="туда" gr="ADVPRO,norm" sem="t:dir r:dem" sem2="t:place r:dem"/>туда</w>!</se></p>
<p><se><w><ana lex="где" gr="ADVPRO,norm" sem="t:place r:rel" sem2="t:place r:indet"/><ana form="Где-то" lex="где-то" gr="ADVPRO,norm" sem="t:place r:indet der:advpro" sem2=""/>Где-то</w> <w><ana lex="следовать" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="ca:noncaus t:move der:s" sem2="ca:noncaus t:move der:s"/>следует</w> <w>теперь</w> <w><ana lex="мой" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/>моя</w> <w><ana lex="пшевочка" gr="S,anim,bastard,f,nom,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/><ana lex="пшевочка" gr="S,anim,bastard,f,nom,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/><ana lex="пшевочка" gr="S,bastard,f,inan,nom,sg" sem="" sem2=""/>Пшевочка</w>!</se><se> <w><ana lex="что" gr="SPRO,acc,inan,n,norm,sg" sem="r:rel" sem2=""/><ana form="Что-то" lex="что-то" gr="SPRO,acc,inan,n,norm,sg" sem="r:indet" sem2=""/>Что-то</w> <w><ana lex="она" gr="SPRO,3p,f,nom,norm,sg" sem="r:pers" sem2=""/>она</w> <w><ana lex="хороший" gr="A,n,nom,norm,plen,sg" sem="ev:posit t:quality r:qual" sem2="ev:posit ev t:degr:max r:qual"/>хорошее</w> <w><ana lex="думать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/><ana lex="думать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/>думает</w>!</se><se> <w><ana lex="забыть" gr="V,act,indic,m,norm,pf,praet,sg" sem="t:ment ca:noncaus" sem2=""/>Забыл</w> <w><ana lex="напомнить" gr="V,act,inf,norm,pf" sem="t:ment ca:caus der:v d:pref" sem2="t:ment ca:noncaus der:v d:pref"/>напомнить</w> <w><ana lex="она" gr="SPRO,3p,dat,f,norm,sg" sem="r:pers" sem2=""/>ей</w> <w><ana lex="внимательно" gr="ADV,norm" sem="ev:posit dt:humq der:a" sem2=""/>внимательно</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="все" gr="SPRO,inan,ins,n,norm,sg" sem="" sem2=""/>всем</w> <w><ana lex="наблюдать" gr="V,act,inf,ipf,norm,tran" sem="ca:noncaus d:pref t:perc" sem2="d:pref"/>наблюдать</w>: <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="природа" gr="S,f,inan,ins,norm,sg" sem="pt:aggr t:space r:concr sc:space" sem2="pt:aggr t:space r:concr r:abstr sc:space"/>природой</w> <w><ana lex="гоби" gr="S,0,f,inan,norm" sem="r:propn t:topon" sem2=""/>Гоби</w>, <w><ana lex="ее" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,n,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,f,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,m,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,n,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,f,gen,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,n,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,f,gen,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,m,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,n,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,f,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,m,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,n,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,f,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,m,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,n,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,f,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,m,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,anim,m,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,inan,m,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,n,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,f,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,m,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,n,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,anim,norm,pl" sem="r:poss" sem2=""/>ее</w> <w><ana lex="проявление" gr="S,inan,ins,n,norm,pl" sem="der:v r:abstr" sem2=""/>проявлениями</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="заносить" gr="V,act,inf,norm,pf" sem="der:v t:changest t:move d:pref ca:caus" sem2=""/><ana lex="заносить" gr="V,act,inf,ipf,norm,tran" sem="der:v t:changest t:move d:pref ca:caus" sem2=""/><ana lex="занести" gr="V,act,inf,norm,pf,tran" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus ca:0 d:pref"/><ana lex="заносить" gr="V,act,inf,ipf,norm,tran" sem="der:v t:changest t:move d:pref ca:caus" sem2=""/><ana lex="заносить" gr="V,act,inf,norm,pf,tran" sem="der:v t:changest t:move d:pref ca:caus" sem2=""/>заносить</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="себе" gr="SPRO,dat,norm" sem="" sem2=""/>себе</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="книжка" gr="S,acc,f,inan,norm,sg" sem="d:dim r:concr t:text der:s" sem2="t:doc d:dim r:concr der:s pt:element"/>книжку</w>.</se><se> <w><ana lex="ведь" gr="CONJ,norm" sem="" sem2=""/>Ведь</w> <w><ana lex="действительно" gr="ADV,PARENTH,norm" sem="der:a" sem2=""/>действительно</w> <w><ana lex="она" gr="SPRO,3p,f,nom,norm,sg" sem="r:pers" sem2=""/>она</w> <w><ana lex="много" gr="ADV,norm" sem="t:quant:max r:spec" sem2="t:degr:max"/>много-много</w> <w><ana lex="увидеть" gr="V,3p,act,fut,indic,norm,pf,sg,tran" sem="ca:noncaus d:pref t:perc" sem2=""/>увидит</w> <w><ana lex="интересный" gr="A,gen,n,norm,plen,sg" sem="dt:abstr der:s dt:ment r:qual" sem2="dt:abstr ev:posit der:s dt:ment r:qual"/>интересного</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="поучительный" gr="A,gen,n,norm,plen,sg" sem="der:v r:rel dt:speech" sem2=""/>поучительного</w>: <w><ana lex="широкий" gr="A,nom,norm,pl,plen" sem="t:size:max r:qual" sem2="t:quant:max der:shift t:size:max r:rel r:qual"/>широкие</w> <w><ana lex="горизонт" gr="S,inan,m,nom,norm,pl" sem="t:space r:concr" sem2="t:ment t:space qc:stuff pt:qtm r:abstr pt:aggr r:concr"/>горизонты</w>, <w><ana lex="антилопа" gr="S,acc,anim,f,norm,pl" sem="t:animal r:concr" sem2=""/>антилоп</w>, <w><ana lex="больдурук" gr="S,acc,anim,bastard,f,famn,pl" sem="" sem2=""/>больдуруков</w>.</se></p>
<p><se><w>Сейчас</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="я" gr="SPRO,1p,gen,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>были</w>: <w><ana lex="кондратьев" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Кондратьев</w>, <w><ana lex="убугунов" gr="S,anim,bastard,famn,m,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Убугунов</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="андрюша" gr="S,anim,m,nom,norm,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Андрюша</w>, <w><ana lex="беседовать" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:speech ca:noncaus der:s" sem2=""/>беседовали</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="разный" gr="A,loc,norm,pl,plen" sem="t:neg t:like" sem2="t:neg der:shift r:spec t:like"/>разных</w> <w><ana lex="история" gr="S,f,inan,loc,norm,pl" sem="r:abstr" sem2="ev:neg r:concr r:abstr t:text"/>историях</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="то" gr="SPRO,inan,loc,n,norm,sg" sem="r:dem" sem2=""/>том</w>, <w><ana lex="между" gr="PR,norm" sem="" sem2=""/>между</w> <w><ana lex="прочее" gr="SPRO,ins,n,norm,sg" sem="" sem2=""/>прочим</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="все" gr="SPRO,nom,norm,pl" sem="" sem2=""/>все</w> <w><ana lex="довольный" gr="A,brev,norm,pl" sem="t:psych:emot r:qual" sem2=""/>довольны</w> <w><ana lex="тот" gr="APRO,dat,n,norm,sg" sem="r:dem" sem2=""/>тому</w> <w><ana lex="обстоятельство" gr="S,dat,inan,n,norm,sg" sem="t:word r:concr r:abstr" sem2="r:abstr"/>обстоятельству</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w>наконец-то</w> <w><ana lex="елена" gr="S,anim,f,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Елена</w> <w><ana lex="петровна" gr="S,anim,f,nom,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Петровна</w> <w><ana lex="уехать" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2=""/>уехала</w>: <w>значит</w>, <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="цель" gr="S,f,gen,inan,norm,sg" sem="t:space r:concr" sem2="t:ment r:abstr"/>цели</w> <w><ana lex="близкий" gr="A,comp,norm,plen" sem="t:dist:min r:qual" sem2="t:social:emot r:qual der:shift t:like t:time t:social"/>ближе</w>.</se><se> <w><ana lex="кто" gr="SPRO,anim,m,nom,norm,sg" sem="r:rel" sem2=""/>Кто</w> <w><ana lex="мечтать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:ment ca:noncaus d:root" sem2=""/>мечтает</w> <w><ana lex="отделаться" gr="V,act,inf,intr,norm,pf" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref"/>отделаться</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="экспедиция" gr="S,f,inan,loc,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w>, <w><ana lex="кто" gr="SPRO,anim,m,nom,norm,sg" sem="r:rel" sem2=""/>кто</w>, <w>наоборот</w>, <w><ana lex="весь" gr="APRO,ins,norm,pl" sem="r:spec" sem2=""/>всеми</w> <w><ana lex="сила" gr="S,f,inan,ins,norm,pl" sem="sc:hum t:pers r:abstr pt:aggr:aggrpl t:param r:concr" sem2="pt:aggr sc:hum ev:posit t:quant:max pt:qtm r:abstr pt:aggr:aggrpl der:shift r:concr"/>силами</w> <w><ana lex="желать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="d:root" sem2="d:root"/>желает</w> <w><ana lex="оживление" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0" sem2="t:move r:abstr"/>оживления</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w> (<w><ana lex="все" gr="SPRO,inan,n,nom,norm,sg" sem="" sem2=""/>все</w>, <w><ana lex="кроме" gr="PR,norm" sem="" sem2=""/>кроме</w> <w><ana lex="убугунов" gr="S,anim,bastard,famn,gen,m,sg" sem="t:hum r:propn t:famn" sem2=""/>Убугунова</w>).</se><se> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>И</w> <w><ana lex="он" gr="SPRO,3p,m,nom,norm,sg" sem="r:pers" sem2=""/>он</w>, <w><ana lex="строго" gr="ADV,norm" sem="ev dt:humq der:a" sem2=""/>строго</w> <w><ana lex="говорить" gr="V,act,ger,ipf,norm,praes,tran" sem="t:speech ca:noncaus d:root" sem2="d:root"/>говоря</w>, <w><ana lex="желать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="d:root" sem2="d:root"/>желает</w> <w><ana lex="благополучный" gr="A,gen,n,norm,plen,sg" sem="ev:posit r:rel d:bon" sem2=""/>благополучного</w> <w><ana lex="разрешение" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0" sem2="der:v t:doc r:concr r:abstr t:param"/>разрешения</w> <w><ana lex="вопрос" gr="S,gen,inan,m,norm,sg" sem="t:speech r:abstr" sem2="t:ment r:abstr"/>вопроса</w> <w><ana lex="об" gr="PR,norm" sem="" sem2=""/>об</w> <w><ana lex="экспедиция" gr="S,f,inan,loc,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="желать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="d:root" sem2="d:root"/>желает</w> <w><ana lex="принять" gr="V,act,inf,norm,pf" sem="der:v ca:noncaus d:pref t:poss" sem2="der:v d:pref"/>принять</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="она" gr="SPRO,3p,f,loc,norm,sg" sem="r:pers" sem2=""/>ней</w> <w><ana lex="деятельный" gr="A,acc,n,norm,plen,sg" sem="der:v t:humq r:qual" sem2=""/>деятельное</w> <w><ana lex="участие" gr="S,acc,inan,n,norm,sg" sem="der:v r:abstr t:inter" sem2="der:v r:abstr t:inter"/>участие</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="отделаться" gr="V,act,inf,intr,norm,pf" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref"/>отделаться</w> <w><ana lex="от" gr="PR,norm" sem="" se