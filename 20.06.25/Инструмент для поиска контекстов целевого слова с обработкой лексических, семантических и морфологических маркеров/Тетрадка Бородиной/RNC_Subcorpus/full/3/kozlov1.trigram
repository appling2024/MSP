<p><se><w><ana lex="день" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>День</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="вечер" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>вечер</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>был</w> <w><ana lex="хороший" gr="A,m,nom,norm,plen,sg" sem="ev:posit t:quality r:qual" sem2="ev:posit ev t:degr:max r:qual"/>хороший</w>.</se><se> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>Я</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="высокий" gr="A,ins,m,norm,plen,sg" sem="t:size:max r:qual" sem2="ev:posit der:shift t:size:max t:sound t:degr:max r:qual t:interpretation"/>высоким</w> <w><ana lex="подъем" gr="S,inan,ins,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="t:space r:concr r:abstr der:v top:form pt:part pt:partb pc:partb t:psych pc:tool:cloth:boot"/>подъемом</w> <w><ana lex="стоять" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:noncaus"/>стоял</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="открытый" gr="A,gen,n,norm,plen,sg" sem="der:v r:qual" sem2="t:physq:form ev:posit t:humq r:rel der:v r:qual der:shift:v"/>открытого</w> <w><ana lex="окно" gr="S,gen,inan,n,norm,sg" sem="t:tool t:space pc:constr:build pt:part top:vertical r:concr top:hole" sem2="t:space r:abstr pc:constr pt:part t:time r:concr"/>окна</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="наслаждение" gr="S,inan,ins,n,norm,sg" sem="ev:posit t:psych:emot r:abstr" sem2=""/>наслаждением</w> <w><ana lex="вдыхать" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="der:v ca:caus t:physiol d:pref" sem2=""/>вдыхал</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="себе" gr