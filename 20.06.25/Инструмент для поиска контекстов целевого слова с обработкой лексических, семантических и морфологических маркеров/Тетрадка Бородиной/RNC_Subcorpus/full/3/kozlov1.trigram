<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="снарядить" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:caus d:pref t:poss" sem2=""/>снарядил</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="обстоятельно" gr="ADV,norm" sem="dt:humq der:a" sem2=""/>обстоятельно</w> <w><ana lex="убугунов" gr="S,anim,bastard,famn,gen,m,pl" sem="t:hum r:propn t:famn" sem2=""/>Убугуновых</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="дорога" gr="S,acc,f,inan,norm,sg" sem="top:stripe t:space r:concr t:fam" sem2="t:move dt:space r:abstr der:shift t:space r:concr"/>дорогу</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="иркутск" gr="S,gen,inan,m,norm,sg" sem="r:propn t:topon" sem2=""/>Иркутска</w>: <w><ana lex="180" gr="NUM,ciph"/>180</w> <w><ana lex="китайский" gr="A,gen,norm,pl,plen" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>китайских</w> <w><ana lex="доллар" gr="S,gen,inan,m,norm,pl" sem="r:concr t:money:banknote" sem2=""/>долларов</w>, <w><ana lex="100" gr="NUM,ciph"/>100</w> <w><ana lex="серебряный" gr="A,gen,norm,pl,plen" sem="dt:stuff r:rel der:s" sem2=""/>серебряных</w> <w><ana lex="русский" gr="A,gen,norm,pl,plen" sem="dt:topon r:rel der:s t:topon" sem2=""/>русских</w> <w><ana lex="рубль" gr="S,gen,inan,m,norm,pl" sem="r:concr t:money:banknote" sem2=""/>рублей</w> (<w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="они" gr="SPRO,3p,gen,norm,pl" sem="r:pers" sem2=""/>них</w> <w><ana lex="50" gr="NUM,ciph"/>50</w> <w><ana lex="он" gr="SPRO,3p,m,nom,norm,sg" sem="r:pers" sem2=""/>он</w> <w><ana lex="должный" gr="A,brev,m,norm,sg" sem="" sem2=""/>должен</w> <w><ana lex="возвратить" gr="V,act,inf,norm,pf" sem="der:v ca:caus d:pref t:poss" sem2=""/>возвратить</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="московский" gr="A,gen,n,norm,plen,sg"