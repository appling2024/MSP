<p><se><w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>День</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="редкость" gr="S,acc,f,inan,norm,sg" sem="r:abstr der:a" sem2="t:thing ev:posit r:concr r:abstr der:a"/>редкость</w> <w><ana lex="приятный" gr="A,m,nom,norm,plen,sg" sem="ev:posit r:qual" sem2="ev:posit t:humq r:qual"/>приятный</w>, <w><ana lex="ясный" gr="A,m,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясный</w>, <w><ana lex="тихий" gr="A,m,nom,norm,plen,sg" sem="d:neg t:sound r:qual" sem2="d:neg t:humq t:speed:min der:shift t:sound r:qual"/>тихий</w>, <w><ana lex="довольно" gr="ADV,norm" sem="t:degr dt:humq der:a" sem2="ev:posit dt:humq der:a"/>довольно</w> <w><ana lex="теплый" gr="A,m,nom,norm,plen,sg" sem="dt:temper dt:abstr t:physq:temper der:s r:qual" sem2="ev:posit t:physq:color dt:temper t:physq:temper dt:abstr der:s r:qual r:rel"/>теплый</w>, <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="солнце" gr="S,inan,loc,n,norm,sg" sem="top:horiz top:spher t:astr t:space r:concr" sem2="ev:posit t:space r:concr r:abstr t:light"/>солнце</w> -<w><ana lex="4-8" gr="NUM,ciph"/>4-8</w>°<w><ana lex="с" gr="S,0,norm" sem="" sem2=""/>С</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="снег" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2=""/>снег</w> <w><ana lex="немного" gr="ADV,norm" sem="t:degr:min ev der:adv" sem2="ev t:time:dur:min t:quant:min der:adv"/>немного</w> <w><ana lex="таять" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="t:changest d:root ca:noncaus" sem2="d:root"/>таял</w>.</se><se> <w><ana lex="однако" gr="CONJ,norm" sem="" sem2=""/>Однако</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="вечер" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>вечера</w> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w> <w><ana lex="