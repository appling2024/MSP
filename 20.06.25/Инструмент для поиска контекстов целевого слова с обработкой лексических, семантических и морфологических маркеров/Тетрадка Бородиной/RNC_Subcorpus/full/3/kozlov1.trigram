<p><se><w><ana lex="не" gr="PART,norm" sem="" sem2=""/>Не</w> <w><ana lex="знать" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/>знаю</w>, <w><ana lex="почему" gr="ADVPRO,norm" sem="der:spro r:rel" sem2=""/><ana form="почему-то" lex="почему-то" gr="ADVPRO,norm" sem="der:advpro r:indet" sem2=""/>почему-то</w> <w>С</w>. <w>А</w>. <w><ana lex="глаголев" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Глаголев</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="сильно" gr="ADV,norm" sem="dt:physq t:degr:max der:a" sem2="dt:physq der:a"/>сильно</w> <w><ana lex="ждать" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="d:root" sem2="d:root"/>ждал</w> <w><ana lex="мой" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/>моего</w> <w><ana lex="приезд" gr="S,gen,inan,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2=""/>приезда</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="петроград" gr="S,acc,inan,m,norm,sg" sem="r:propn t:topon" sem2=""/>Петроград</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="поэтому" gr="ADVPRO,norm" sem="der:apro r:dem" sem2=""/>поэтому</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="писать" gr="V,act,indic,ipf,m,norm,praet,sg" sem="d:root" sem2="d:root"/><ana lex="писать" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="d:root" sem2="d:root"/><ana lex="писать" gr="V,act,indic,ipf,m,norm,praet,sg" sem="d:root" sem2="d:root"/>писал</w> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="ограничиться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>ограничился</w> <w><ana lex="прекрасный" gr="A,ins,n,norm,plen,sg" sem="ev:posit t:appearance r:qual" sem2="ev:posit t:quality r:qual"/>прекрасным</w> <w><ana lex="письмо" gr="S,inan,ins,n,norm,sg" sem="r:concr t:text" sem2="pt:aggr t:asp r:concr r:abstr sc:letter"/>письмом</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w>С</w>. <w>А</w>. <w><ana lex="кондратьева" gr="S,acc,anim,f,famn,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Кондратьеву</w>.</se></p>
<p><se><w><ana lex="ночь" gr="S,f,inan,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2=""/>Ночь</w> <w><ana lex="холодный" gr="A,f,nom,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодная</w>, <w><ana lex="ясный" gr="A,f,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясная</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w>северо-северо-западным</w> <w><ana lex="ветер" gr="S,inan,ins,m,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>ветром</w>.</se><se> <w><ana lex="вернуться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus t:move" sem2="ca:noncaus"/>Вернулись</w> <w><ana lex="зимний" gr="A,acc,inan,norm,pl,plen" sem="dt:time dt:abstr dt:time:season der:s t:time r:rel" sem2=""/>зимние</w> <w><ana lex="холод" gr="S,acc,inan,m,norm,pl" sem="t:temper r:abstr t:weather" sem2="t:manif:emot r:abstr t:temper t:physiol t:manif:disease t:fam"/>холода</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="невзгода" gr="S,acc,f,inan,norm,pl" sem="r:abstr" sem2=""/>невзгоды</w>.</se></p>
<p><se><b/><w><b>12</b></w><b>/</b><w><ana lex="ii" gr="bastard" sem="" sem2=""/><b>II</b></w><b>, </b><w><ana lex="u" gr="bastard" sem="" sem2=""/><b>U</b></w><b/>. <w><ana lex="прежний" gr="A,m,nom,norm,plen,sg" sem="r:rel t:time" sem2="r:rel t:time"/>Прежний</w> <w><ana lex="холод" gr="S,inan,m,nom,norm,sg" sem="t:temper r:abstr t:weather" sem2="t:manif:emot r:abstr t:temper t:physiol t:manif:disease t:fam"/>холод</w>, <w><ana lex="адский" gr="A,m,nom,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space der:s t:degr:max r:qual"/>адский</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w>ССЗ</w> -- <w><ana lex="резкий" gr="A,m,nom,norm,plen,sg" sem="der:shift t:degr:max r:qual" sem2="t:physq:form der:shift t:time r:qual"/>резкий</w> <w><ana lex="ветер" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>ветер</w>.</se><se> <w>Вероятно</w>, <w><ana lex="настать" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="d:pref" sem2=""/>настал</w> <w><ana lex="значительный" gr="A,m,nom,norm,plen,sg" sem="t:quant:max der:v t:degr:max r:qual" sem2="der:v r:rel d:habit"/>значительный</w> <w><ana lex="период" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:time" sem2="t:text t:time:period r:abstr pt:part pc:text r:concr"/>период</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="холод" gr="S,inan,ins,m,norm,sg" sem="t:temper r:abstr t:weather" sem2="t:manif:emot r:abstr t:temper t:physiol t:manif:disease t:fam"/>холодом</w>!</se><se> <w><ana lex="стужа" gr="S,f,inan,nom,norm,sg" sem="r:abstr t:temper" sem2=""/>Стужа</w> <w><ana lex="этот" gr="APRO,f,nom,norm,sg" sem="r:dem" sem2=""/>эта</w> <w><ana lex="напомнить" gr="V,act,f,indic,norm,pf,praet,sg" sem="t:ment ca:caus der:v d:pref" sem2="t:ment ca:noncaus der:v d:pref"/>напомнила</w> <w><ana lex="самый" gr="APRO,acc,inan,norm,pl" sem="r:spec" sem2="r:spec"/>самые</w> <w><ana lex="холодный" gr="A,acc,inan,norm,pl,plen" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодные</w> <w><ana lex="минувший" gr="A,acc,inan,norm,pl,plen" sem="der:v r:rel dt:move t:time" sem2=""/>минувшие</w> <w><ana lex="период" gr="S,acc,inan,m,norm,pl" sem="r:abstr t:time" sem2="t:text t:time:period r:abstr pt:part pc:text r:concr"/>периоды</w>.</se></p>
<p><se><w><ana lex="наконец" gr="ADV,PARENTH,norm" sem="der:s t:time" sem2=""/>Наконец-то</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="получить" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:noncaus t:poss" sem2=""/>получил</w> <w><ana lex="письмецо" gr="S,acc,inan,n,norm,sg" sem="d:dim r:concr t:text der:s" sem2=""/>письмецо</w>, <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="интересный" gr="A,n,nom,norm,plen,sg" sem="dt:abstr der:s dt:ment r:qual" sem2="dt:abstr ev:posit der:s dt:ment r:qual"/>интересное</w>, <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="мой" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/>моего</w> <w><ana lex="родной" gr="A,gen,m,norm,plen,sg" sem="t:humq:char r:qual" sem2="ev:posit t:social:emot t:humq:char r:qual"/>родного</w> <w><ana lex="пшевик" gr="S,anim,bastard,gen,m,sg" sem="" sem2=""/>Пшевика</w>.</se><se> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>Для</w> <w><ana lex="я" gr="SPRO,1p,gen,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="интересный" gr="A,brev,n,norm,sg" sem="dt:abstr der:s dt:ment r:qual" sem2="dt:abstr ev:posit der:s dt:ment r:qual"/>интересно</w> <w><ana lex="тот" gr="APRO,acc,n,norm,sg" sem="r:dem" sem2=""/>то</w> <w><ana lex="сильный" gr="A,acc,n,norm,plen,sg" sem="t:physq d:habit r:qual" sem2="ev:posit t:humq:char der:s t:degr:max r:qual r:rel"/>сильное</w> <w><ana lex="впечатление" gr="S,acc,inan,n,norm,sg" sem="t:perc r:abstr" sem2="t:ment r:abstr"/>впечатление</w>, <w><ana lex="который" gr="APRO,acc,n,norm,sg" sem="r:rel t:ord" sem2=""/>которое</w> <w><ana lex="пшевик" gr="S,anim,bastard,m,nom,sg" sem="" sem2=""/>Пшевик</w> <w><ana lex="получить" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:noncaus t:poss" sem2=""/>получил</w> <w><ana lex="при" gr="PR,norm" sem="" sem2=""/>при</w> <w><ana lex="вид" gr="S,anim,famn,loc,m,norm,sg" sem="" sem2=""/><ana lex="вид" gr="S,inan,loc,m,norm,sg" sem="der:v r:abstr" sem2="t:ment t:space r:abstr t:workart der:v t:perc r:concr t:fam"/>виде</w> <w><ana lex="пустынь" gr="S,f,gen,inan,norm,sg" sem="r:concr t:org" sem2="t:space r:concr"/><ana lex="пустыня" gr="S,f,gen,inan,norm,sg" sem="t:space r:concr der:a" sem2="t:space r:concr der:a"/>пустыни</w> <w><ana lex="монголия" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Монголии</w> -- <w><ana lex="гоби" gr="S,0,f,inan,norm" sem="r:propn t:topon" sem2=""/>Гоби</w>.</se><se> <w><ana lex="она" gr="SPRO,3p,acc,f,norm,sg" sem="r:pers" sem2=""/>Ее</w> <w><ana lex="поразить" gr="V,act,f,indic,norm,pf,praet,sg" sem="d:pref" sem2="ca:caus d:pref t:psych:emot"/>поразила</w> <w><ana lex="мертвенность" gr="S,f,inan,nom,norm,sg" sem="r:abstr der:a" sem2=""/>мертвенность</w>, <w><ana lex="однообразие" gr="S,inan,n,nom,norm,sg" sem="der:comp r:abstr" sem2=""/>однообразие</w>, <w><ana lex="жуть" gr="S,f,inan,nom,norm,sg" sem="t:psych:emot r:abstr" sem2="t:quant:max t:psych r:abstr"/>жуть</w> <w><ana lex="мертвый" gr="A,f,gen,norm,plen,sg" sem="r:qual" sem2="der:shift r:qual"/>мертвой</w> <w><ana lex="страна" gr="S,f,gen,inan,norm,sg" sem="t:space r:concr" sem2="t:space r:concr"/>страны</w>.</se><se> <w><ana lex="автомобиль" gr="S,inan,m,nom,norm,pl" sem="t:tool:transp r:concr" sem2=""/>Автомобили</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="гудок" gr="S,inan,ins,m,norm,pl" sem="der:v t:tool:device r:concr pt:part pc:tool:transp" sem2="t:media r:abstr der:v t:tool:mus r:propn r:concr"/>гудками</w>, <w><ana lex="скелет" gr="S,inan,m,nom,norm,pl" sem="pt:partb:inner pc:animal sc:partb r:concr pc:hum" sem2="pt:base pc:constr r:concr pt:part"/>скелеты</w> <w><ana lex="животное" gr="S,anim,gen,n,norm,pl" sem="der:subst t:animal der:a r:concr hi:class" sem2="der:subst t:animal r:concr der:a"/>животных</w>, <w><ana lex="телеграфный" gr="A,nom,norm,pl,plen" sem="r:rel der:s" sem2=""/>телеграфные</w> <w><ana lex="столб" gr="S,inan,m,nom,norm,pl" sem="t:constr r:concr top:post" sem2="qc:stuff pt:qtm r:concr"/>столбы</w> <w><ana lex="осквернять" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="d:pref" sem2=""/>оскверняют</w> <w><ana lex="девственный" gr="A,acc,f,norm,plen,sg" sem="t:physq r:rel" sem2="r:qual"/>девственную</w> <w><ana lex="чистота" gr="S,acc,f,inan,norm,sg" sem="r:abstr der:a" sem2="r:abstr"/>чистоту</w> <w><ana lex="пустынь" gr="S,f,gen,inan,norm,sg" sem="r:concr t:org" sem2="t:space r:concr"/><ana lex="пустыня" gr="S,f,gen,inan,norm,sg" sem="t:space r:concr der:a" sem2="t:space r:concr der:a"/>пустыни</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="остров" gr="S,inan,ins,m,norm,pl" sem="t:space r:concr" sem2="t:space r:concr t:fam"/>островами</w> <w><ana lex="матрацевидный" gr="A,gen,norm,pl,plen" sem="der:comp r:rel" sem2=""/>матрацевидных</w> <w><ana lex="выход" gr="S,gen,inan,m,norm,pl" sem="der:v t:move r:abstr der:s0" sem2="t:quant ev:posit t:space r:abstr der:v pc:constr pt:part r:concr"/>выходов</w>, <w><ana lex="напоминать" gr="V,act,gen,ipf,norm,partcp,pl,plen,praes,tran" sem="t:ment ca:caus der:v d:pref" sem2="der:v d:pref"/>напоминающих</w> <w><ana lex="юный" gr="A,dat,m,norm,plen,sg" sem="t:time:age r:qual" sem2="dt:time:age der:shift r:qual"/>юному</w> <w><ana lex="путник" gr="S,anim,dat,m,norm,sg" sem="t:hum r:concr der:s" sem2=""/>путнику</w> <w><ana lex="недавний" gr="A,acc,inan,norm,pl,plen" sem="d:neg dt:time t:time der:a r:qual" sem2=""/>недавние</w> <w><ana lex="лекция" gr="S,acc,f,inan,norm,pl" sem="t:action r:abstr" sem2="r:concr t:text"/>лекции</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="история" gr="S,f,inan,loc,norm,sg" sem="r:abstr" sem2="ev:neg r:concr r:abstr t:text"/>истории</w> <w><ana lex="земля" gr="S,f,gen,inan,norm,sg" sem="top:spher t:astr t:space r:concr" sem2="t:space sc:space top:horiz t:stuff pt:part pc:space r:concr"/>земли</w> -- <w><ana lex="геология" gr="S,f,gen,inan,norm,sg" sem="r:abstr" sem2=""/>геологии</w>.</se><se> <w><ana lex="цзерен" gr="S,bastard,inan,m,nom,pl" sem="" sem2=""/><ana lex="цзерен" gr="S,anim,bastard,m,nom,pl" sem="" sem2=""/>Цзерены</w>, <w><ana lex="волк" gr="S,anim,m,nom,norm,pl" sem="t:animal r:concr" sem2=""/><ana lex="волк" gr="S,inan,m,nom,norm,pl" sem="" sem2="t:fam"/>волки</w>; <w><ana lex="один" gr="APRO,m,nom,norm,sg" sem="" sem2="r:indet"/>один</w> <w><ana lex="волк" gr="S,anim,m,nom,norm,sg" sem="t:animal r:concr" sem2=""/><ana lex="волк" gr="S,inan,m,nom,norm,sg" sem="" sem2="t:fam"/>волк</w> <w><ana lex="стоять" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:noncaus"/>стоял</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="самый" gr="APRO,gen,m,norm,sg" sem="r:spec" sem2="r:spec"/><ana lex="сам" gr="APRO,gen,m,norm,sg" sem="r:spec" sem2=""/>самого</w> <w><ana lex="автомобиль" gr="S,gen,inan,m,norm,sg" sem="t:tool:transp r:concr" sem2=""/>автомобиля</w>, <w><ana lex="глядеть" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="ca:noncaus t:perc d:root" sem2=""/>глядел</w>: <w><ana lex="серый" gr="A,nom,norm,pl,plen" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>серые</w> <w><ana lex="глазок" gr="S,inan,m,nom,norm,pl" sem="pc:hum pc:animal der:s d:dim pt:partb r:concr" sem2="t:space pc:gruit pt:addit pc:plant t:pattern der:s pt:part r:concr pc:tool"/>глазки</w>, <w><ana lex="опустить" gr="V,m,nom,norm,partcp,pass,pf,plen,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v d:pref"/>опущенный</w> <w><ana lex="хвост" gr="S,inan,m,nom,norm,sg" sem="pt:partb pc:animal r:concr" sem2="sc:hum top:rope pc:tool:cloth sc:stuff pc:tool:device r:abstr pt:set top:form pc:x pt:part ev:neg d:shift pt:aggr:aggrpl r:concr t:form"/>хвост</w>.</se><se> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>На</w> <w><ana lex="гудок" gr="S,acc,inan,m,norm,sg" sem="der:v t:tool:device r:concr pt:part pc:tool:transp" sem2="t:media r:abstr der:v t:tool:mus r:propn r:concr"/>гудок</w> <w><ana lex="волк" gr="S,anim,m,nom,norm,sg" sem="t:animal r:concr" sem2=""/><ana lex="волк" gr="S,inan,m,nom,norm,sg" sem="" sem2="t:fam"/>волк</w> <w><ana lex="лишь" gr="PART,norm" sem="" sem2=""/>лишь</w> <w><ana lex="насторожиться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus d:pref" sem2=""/>насторожился</w>, <w><ana lex="сосредоточиться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus d:pref" sem2="ca:noncaus d:pref"/><ana lex="сосредоточиться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>сосредоточился</w>, <w><ana lex="поднять" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:caus t:move d:pref" sem2="d:pref"/>поднял</w> <w><ana lex="ухо" gr="S,acc,inan,n,norm,pl" sem="pt:partb pc:animal r:concr pc:hum" sem2="t:tool pc:tool:cloth r:abstr top:form t:perc pt:part r:concr pc:tool"/>уши</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="только" gr="PART,norm" sem="" sem2=""/>только</w>.</se><se> <w>Теперь</w> <w><ana lex="мой" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>мой</w> <w><ana lex="пшевик" gr="S,anim,bastard,m,nom,sg" sem="" sem2=""/>Пшевик</w>, <w>вероятно</w>, <w><ana lex="узко" gr="ADV,comp,norm" sem="dt:size:min der:a" sem2="dt:size:min der:a"/><ana lex="уже" gr="ADV,norm" sem="t:time" sem2=""/>уже</w> <w><ana lex="среди" gr="PR,norm" sem="" sem2=""/>среди</w> <w><ana lex="свой" gr="APRO,f,gen,norm,sg" sem="r:poss" sem2="t:social r:poss"/>своей</w> <w><ana lex="родной" gr="A,0,norm,plen" sem="t:humq:char r:qual" sem2="ev:posit t:social:emot t:humq:char r:qual"/>родной</w> <w><ana lex="семья" gr="S,f,gen,inan,norm,sg" sem="t:group pt:set r:concr sc:hum:kin" sem2="pt:set der:shift r:concr sc:animal hi:class"/>семьи</w>.</se><se> <w><ana lex="быть" gr="V,1p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>Буду</w> <w><ana lex="ждать" gr="V,act,inf,ipf,norm,tran" sem="d:root" sem2="d:root"/>ждать</w> <w><ana lex="ее" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,n,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,f,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,m,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,n,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,f,gen,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,n,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,f,gen,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,m,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,n,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,f,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,m,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,n,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,f,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,m,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,n,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,f,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,m,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,anim,m,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,inan,m,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,n,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,f,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,m,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,n,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,anim,norm,pl" sem="r:poss" sem2=""/>ее</w> <w><ana lex="весть" gr="S,f,gen,inan,norm,pl" sem="t:speech r:abstr" sem2=""/>вестей</w>.</se></p>
