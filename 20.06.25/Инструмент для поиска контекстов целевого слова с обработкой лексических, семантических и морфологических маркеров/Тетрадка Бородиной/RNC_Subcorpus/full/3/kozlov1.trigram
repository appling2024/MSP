<w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="весь" gr="APRO,nom,norm,pl" sem="r:spec" sem2=""/>все</w> <w><ana lex="сидеть" gr="V,1p,act,indic,intr,ipf,norm,pl,praes" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:noncaus"/>сидим</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="город" gr="S,inan,loc,m,norm,sg" sem="sc:constr:build t:space r:concr" sem2="t:space r:concr"/>городе</w>, <w><ana lex="словно" gr="CONJ,norm" sem="" sem2=""/>словно</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="тюрьма" gr="S,f,inan,loc,norm,sg" sem="top:contain t:constr r:concr" sem2=""/>тюрьме</w>, <w><ana lex="любоваться" gr="V,act,ger,intr,ipf,norm,praes" sem="ca:noncaus t:perc" sem2=""/>любуясь</w> <w><ana lex="лишь" gr="PART,norm" sem="" sem2=""/>лишь</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="девственный" gr="A,acc,f,norm,plen,sg" sem="t:physq r:rel" sem2="r:qual"/>девственную</w> <w><ana lex="чистый" gr="A,acc,f,norm,plen,sg" sem="t:physst r:qual" sem2="t:physq ev:posit t:humq t:degr r:qual"/>чистую</w> <w><ana lex="красота" gr="S,acc,f,inan,norm,sg" sem="ev:posit t:fam r:abstr der:a" sem2="ev:posit r:abstr der:a"/>красоту</w> <w><ana lex="священный" gr="A,gen,m,norm,plen,sg" sem="ev r:rel" sem2="r:rel"/>священного</w> <w><ana lex="массив" gr="S,gen,inan,m,norm,sg" sem="pt:set t:space r:concr sc:space" sem2="pt:set sc:constr:build t:space r:concr sc:plant"/>массива</w>; <w><ana lex="невольно" gr="ADV,norm" sem="der:a" sem2=""/>невольно</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="часто" gr="ADV,norm" sem="t:freq der:a" sem2=""/>часто</w> <w><ana lex="приходить" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:move d:pref" sem2=""/>приходит</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="мысль" gr="S,acc,f,inan,norm,sg" sem="t:ment r:abstr" sem2="t:ment ev:posit r:abstr"/>мысль</w> <w><ana lex="дума" gr="S,f,inan