<p><se><w><ana lex="вчера" gr="ADV,norm" sem="t:time" sem2=""/>Вчера</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w> <w><ana lex="возвратиться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="der:v ca:noncaus t:move d:pref" sem2=""/>возвратились</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="пастьба" gr="S,f,gen,inan,norm,sg" sem="r:abstr" sem2=""/>пастьбы</w> <w><ana lex="мой" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>мои</w> <w><ana lex="старший" gr="A,nom,norm,pl,plen" sem="r:qual" sem2="t:hier r:rel t:ord"/>старшие</w> <w><ana lex="мальчишка" gr="S,anim,m,nom,norm,pl" sem="t:hum ev r:concr der:s d:dim" sem2=""/>мальчишки</w>.</se><se> <w>Много</w> <w><ana lex="интересный" gr="A,gen,n,norm,plen,sg" sem="dt:abstr der:s dt:ment r:qual" sem2="dt:abstr ev:posit der:s dt:ment r:qual"/>интересного</w>, <w><ana lex="любопытный" gr="A,gen,n,norm,plen,sg" sem="t:humq r:qual" sem2="r:qual"/>любопытного</w> <w><ana lex="сообщить" gr="V,act,indic,m,norm,pf,praet,sg" sem="t:speech ca:noncaus d:pref" sem2="d:pref"/>сообщил</w> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w>, <w><ana lex="много" gr="ADV,comp,norm" sem="t:quant:max r:spec" sem2="t:degr:max"/><ana lex="более" gr="ADV,norm" sem="t:degr:max der:adv" sem2="t:degr:max"/>более</w> <w><ana lex="другой" gr="APRO,gen,norm,pl" sem="r:spec" sem2="r:ord r:spec r:indet"/>других</w> <w><ana lex="вдумчивый" gr="A,m,nom,norm,plen,sg" sem="t:humq r:qual" sem2=""/>вдумчивый</w>, <w><ana lex="ботаник" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr der:s t:prof" sem2="t:hum r:concr der:s t:prof ev:neg"/>ботаник</w> <w>Н</w>. <w>В</w>. <w><ana lex="павлов" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Павлов</w>.</se><se> <w><ana lex="весь" gr="APRO,f,nom,norm,sg" sem="r:spec" sem2=""/>Вся</w> <w><ana lex="мой" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/>моя</w> <w><ana lex="молодежь" gr="S,f,inan,nom,norm,sg" sem="sc:hum pt:aggr r:concr der:a" sem2=""/>молоде