<p><se><w><ana lex="алексей" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Алексей</w> <w><ana lex="николаевич" gr="S,anim,m,nom,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Николаевич</w> <w><ana lex="встречать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="der:v d:pref" sem2=""/>встречает</w> <w><ana lex="любезно" gr="ADV,norm" sem="ev:posit dt:humq der:a" sem2=""/>любезно</w>: «<w><ana lex="убугунов" gr="S,anim,bastard,famn,m,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Убугунов</w> <w><ana lex="свободный" gr="A,brev,m,norm,sg" sem="der:s t:humq:char r:qual" sem2="t:size:max der:s r:qual"/>свободен</w>, <w><ana lex="мочь" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="d:root" sem2=""/>может</w> <w><ana lex="ехать" gr="V,act,inf,intr,ipf,norm" sem="ca:noncaus t:move d:root" sem2="d:root"/>ехать</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="иркутск" gr="S,acc,inan,m,norm,sg" sem="r:propn t:topon" sem2=""/>Иркутск</w>.</se><se> <w><ana lex="главный" gr="A,n,nom,norm,plen,sg" sem="t:hier r:qual" sem2="t:hier r:qual"/>Главное</w> <w><ana lex="наблюдение" gr="S,inan,n,nom,norm,sg" sem="der:v t:perc r:abstr" sem2=""/>наблюдение</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="экспедиция" gr="S,f,inan,ins,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедицией</w> <w><ana lex="поручить" gr="V,brev,n,norm,partcp,pass,pf,praet,sg" sem="d:pref" sem2=""/>поручено</w> <w><ana lex="полпред" gr="S,anim,dat,m,norm,sg" sem="der:comp t:hum r:concr der:abbr" sem2=""/>полпреду</w>.</se><se> <w><ana lex="начальник" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr" sem2=""/>Начальник</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="полпред" gr="S,anim,m,nom,