<p><se><w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>Мне</w> <w><ana lex="думаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:ment ca:noncaus" sem2="t:ment ca:noncaus"/>думается</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="здесь" gr="ADVPRO,norm" sem="t:place r:dem" sem2="t:time r:dem"/>здесь</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="екатеринбург" gr="S,inan,loc,m,norm,sg" sem="r:propn t:topon" sem2=""/>Екатеринбурге</w>, <w><ana lex="все" gr="SPRO,inan,n,nom,norm,sg" sem="" sem2=""/>все</w> <w><ana lex="устроиться" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="der:v d:pref t:be:appear" sem2=""/>устроится</w> <w><ana lex="как" gr="CONJ,norm" sem="" sem2=""/>как</w> <w><ana lex="надлежать" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="d:pref" sem2=""/>надлежит</w>!</se><se> <w><ana lex="тогда" gr="ADVPRO,norm" sem="t:time r:dem" sem2="r:dem"/>Тогда</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="окончательно" gr="ADV,norm" sem="dt:degr:max der:a" sem2=""/>окончательно</w> <w><ana lex="встать" gr="V,1p,act,fut,indic,intr,norm,pf,pl" sem="ca:noncaus d:pref t:move:body" sem2="d:pref"/><ana lex="встать" gr="V,1p,act,imper,intr,norm,pf,pl" sem="ca:noncaus d:pref t:move:body" sem2="d:pref"/>встанем</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="рельс" gr="S,acc,inan,m,norm,pl" sem="top:stripe t:tool r:concr" sem2="der:shift"/>рельсы</w>, <w><ana lex="чтобы" gr="CONJ,norm" sem="" sem2=""/>чтобы</w> <w><ana lex="двигаться" gr="V,act,inf,intr,ipf,norm" sem="der:v ca:noncaus t:move" sem2="der:v ca:noncaus"/>двигаться</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="самый" gr="APRO,gen,m,norm,sg" sem="r:spec" sem2="r:spec"/><ana lex="сам" gr="APRO,gen,m,norm,sg" sem="r:spec" sem2=""/>самого</w> <w><ana lex="верхнеудинск" gr="S,gen,inan,m,norm,sg" sem="r:propn t:topon" sem2=""/>Верхнеудинска</w>.</se><se> <w><ana lex="п