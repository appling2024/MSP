<p><se><b/><w><b>12</b></w><b>/</b><w><ana lex="iii" gr="bastard" sem="" sem2=""/><b>III</b></w><b>, </b><w><ana lex="s" gr="bastard" sem="" sem2=""/><b>S</b></w><b/>. <w><ana lex="что" gr="SPRO,inan,n,nom,norm,sg" sem="r:rel" sem2=""/>Что</w> <w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w> <w><ana lex="грясти" gr="V,acc,act,inan,intr,ipf,m,norm,partcp,plen,praes,sg" sem="d:root" sem2=""/>грядущий</w> <w><ana lex="мы" gr="SPRO,1p,dat,norm,pl" sem="r:pers" sem2=""/>нам</w> <w><ana lex="готовить" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="" sem2=""/>готовит</w>?</se><se> <w><ana lex="который" gr="APRO,m,nom,norm,sg" sem="r:rel t:ord" sem2=""/>Который</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="ближайший" gr="A,gen,norm,pl,supr" sem="t:dist:min der:a d:super dt:hum r:qual" sem2="der:a d:super dt:hum r:qual"/>ближайших</w> <w><ana lex="день" gr="S,gen,inan,m,norm,pl" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дней</w> <w><ana lex="мы" gr="SPRO,1p,dat,norm,pl" sem="r:pers" sem2=""/>нам</w> <w><ana lex="принести" gr="V,3p,act,fut,indic,norm,pf,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus ca:0 d:pref"/>принесет</w> <w><ana lex="весна" gr="S,acc,f,inan,norm,sg" sem="t:time:season r:abstr t:time" sem2=""/>весну</w>?</se><se> <w><ana lex="пока" gr="ADV,norm" sem="t:time" sem2=""/>Пока</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w> <w><ana lex="все" gr="SPRO,acc,inan,n,norm,sg" sem="" sem2=""/>все</w> <w><ana lex="приходиться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>приходится</w> <w><ana lex="отмечать" gr="V,act,inf,ipf,norm,tran" sem="der:v d:pref" sem2=""/>отмечать</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="метеорологический" gr="A,loc,m,norm,plen,sg" sem="r:rel der:s" sem2="r:rel der:s"/>метеорологическом</w> <w><ana