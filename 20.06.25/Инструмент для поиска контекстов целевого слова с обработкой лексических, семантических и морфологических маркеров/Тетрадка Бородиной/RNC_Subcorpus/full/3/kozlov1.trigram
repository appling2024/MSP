<p><se><w>Итак</w>, <w><ana lex="праздник" gr="S,inan,m,nom,norm,pl" sem="t:action r:abstr" sem2="r:abstr"/>праздники</w> <w><ana lex="идти" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus t:move d:root" sem2="ca:noncaus t:move d:root"/>идут</w>, <w><ana lex="оканчиваться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v ca:noncaus d:pref d:impf" sem2=""/>оканчивается</w> <w><ana lex="старый" gr="A,m,nom,norm,plen,sg" sem="t:time:age:max r:qual" sem2="t:time:dur t:time r:qual"/>старый</w>, <w><ana lex="1923" gr="NUM,ciph"/>1923</w>, <w><ana lex="год" gr="S,acc,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:age r:abstr"/>год</w>, <w><ana lex="подступать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v t:move d:pref" sem2=""/>подступает</w> <w><ana lex="новый" gr="A,m,nom,norm,plen,sg" sem="t:time r:qual" sem2="t:time r:qual"/>Новый</w>.</se><se> <w><ana lex="что" gr="SPRO,acc,inan,n,norm,sg" sem="r:rel" sem2=""/><ana form="Что-то" lex="что-то" gr="SPRO,acc,inan,n,norm,sg" sem="r:indet" sem2=""/>Что-то</w> <w><ana lex="он" gr="SPRO,3p,m,nom,norm,sg" sem="r:pers" sem2=""/>он</w> <w><ana lex="дать" gr="V,3p,act,fut,indic,norm,pf,sg" sem="ca:caus d:root t:poss" sem2="d:root"/>даст</w> <w><ana lex="мой" gr="APRO,f,gen,norm,sg" sem="r:poss" sem2=""/>моей</w> <w><ana lex="тибетский" gr="A,f,gen,norm,plen,sg" sem="dt:topon r:rel der:s t:topon" sem2=""/>Тибетской</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w>!</se><se> <w><ana lex="будущность" gr="S,f,inan,nom,norm,sg" sem="r:abstr der:a" sem2=""/>Будущность</w> <w><ana lex="неизвестный" gr="A,brev,f,norm,sg" sem="d:neg der:a r:qual" sem2="d:neg r:qual"/>неизвестна</w>!</se></p>
