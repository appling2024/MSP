<p><se><w><ana lex="мы" gr="SPRO,1p,ins,norm,pl" sem="r:pers" sem2=""/>Нами</w> <w><ana lex="пройти" gr="V,f,nom,norm,partcp,pass,pf,plen,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="пройти" gr="V,f,intr,nom,norm,partcp,pass,pf,plen,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="проходить" gr="V,f,intr,nom,norm,partcp,pass,pf,plen,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2=""/>пройденная</w> <w><ana lex="местность" gr="S,f,inan,nom,norm,sg" sem="t:space r:concr der:s" sem2="t:space r:concr der:s sc:space"/>местность</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="горный" gr="A,dat,f,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s"/>горной</w> <w><ana lex="часть" gr="S,dat,f,inan,norm,sg" sem="r:concr pc:x pt:part" sem2="pc:org r:abstr sc:part t:org pt:ind pt:aggr:aggrpl t:poss der:shift pc:x pt:part pc:text r:concr"/>части</w> <w><ana lex="долина" gr="S,f,gen,inan,norm,sg" sem="t:space r:concr der:s t:fam" sem2=""/>долины</w> <w><ana lex="селенга" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/><ana lex="селенга" gr="S,anim,f,gen,norm,sg" sem="" sem2=""/>Селенги</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="мост" gr="S,inan,ins,m,norm,sg" sem="top:horiz t:constr r:concr" sem2="t:tool t:space t:form r:abstr pc:tool:transp pt:part r:concr"/>мостом</w> <w><ana lex="через" gr="PR,norm" sem="" sem2=""/>через</w> <w><ana lex="она" gr="SPRO,3p,f,gen,norm,sg" sem="r:pers" sem2=""/>нее</w>, <w><ana lex="очаровательный" gr="A,f,nom,norm,plen,sg" sem="der:v r:rel d:potent" sem2=""/>очаровательная</w>: <w><ana lex="река" gr="S,f,inan,nom,norm,sg" sem="top:contain t:reservoir t:space r:concr" sem2="t:quant:max pt:qtm r:abstr"/>река</w> <w><ana lex="стремительно" gr="ADV,norm" sem="dt:speed:max ev der:a" sem2=""/>стремительно</w> <w><ana lex="нестись" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="d