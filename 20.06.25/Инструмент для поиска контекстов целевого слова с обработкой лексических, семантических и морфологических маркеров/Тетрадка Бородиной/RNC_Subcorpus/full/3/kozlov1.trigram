sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,gen,inan,m,norm,pl" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутников</w> <w><ana lex="усердно" gr="ADV,norm" sem="ev:posit dt:humq der:a" sem2=""/>усердно</w> <w><ana lex="гонять" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="ca:caus t:move d:root" sem2="d:root"/>гоняли</w> <w><ana lex="лисица" gr="S,acc,anim,f,norm,sg" sem="t:animal d:fem r:concr der:s" sem2="t:hum r:concr der:s ev:neg"/>лисицу</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="соседство" gr="S,inan,loc,n,norm,sg" sem="t:space r:abstr" sem2=""/>соседстве</w> <w><ana lex="лагерь" gr="S,gen,inan,m,norm,sg" sem="t:space r:concr" sem2="t:group pt:set t:space r:concr sc:hum"/>лагеря</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w>.</se><se> <w>Говорят</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="лисица" gr="S,anim,f,gen,norm,pl" sem="t:animal d:fem r:concr der:s" sem2="t:hum r:concr der:s ev:neg"/>лисиц</w> <w><ana lex="вообще" gr="ADV,PARENTH,norm" sem="dt:general der:a" sem2=""/>вообще</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="самый" gr="APRO,loc,n,norm,sg" sem="r:spec" sem2="r:spec"/><ana lex="сам" gr="APRO,loc,n,norm,sg" sem="r:spec" sem2=""/>самом</w> <w><ana lex="близкий" gr="A,loc,n,norm,plen,sg" sem="t:dist:min r:qual" sem2="t:social:emot r:qual der:shift t:like t:time t:social"/>близком</w> <w><ana lex="соседство" gr="S,inan,loc,n,norm,sg" sem="t:space r:abstr" sem2=""/>соседстве</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="урга" gr="S,f,inan,ins,norm,sg" sem="r:propn t:topon" sem2=""/>Ургой</w> <w><ana lex="немало" gr="NUM,norm" sem="" sem2=""/>немало</w>.</se><se> <w><ana lex="зверь" gr="S,anim,m,nom,norm,sg" sem="sc:animal hi:class t:animal pt:ind pt:aggr r:concr" sem2=""/>Зверь</w> <w><a