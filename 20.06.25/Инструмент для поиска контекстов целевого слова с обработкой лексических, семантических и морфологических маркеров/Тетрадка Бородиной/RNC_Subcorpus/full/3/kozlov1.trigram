m="der:v ca:caus t:move d:pref" sem2="der:v ca:caus t:move d:pref"/>подтолкнут</w> <w><ana lex="молодой" gr="A,nom,norm,pl,plen" sem="t:time:age r:qual" sem2="t:time:age r:qual"/>молодые</w> <w><ana lex="прогрессивный" gr="A,nom,norm,pl,plen" sem="dt:abstr der:s" sem2="dt:abstr der:s"/>прогрессивные</w> <w><ana lex="сила" gr="S,f,inan,nom,norm,pl" sem="sc:hum t:pers r:abstr pt:aggr:aggrpl t:param r:concr" sem2="pt:aggr sc:hum ev:posit t:quant:max pt:qtm r:abstr pt:aggr:aggrpl der:shift r:concr"/>силы</w>, <w><ana lex="вполне" gr="ADV,norm" sem="dt:full t:degr:max der:a" sem2=""/>вполне</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="давно" gr="ADV,norm" sem="t:time" sem2=""/>давно</w> <w><ana lex="сочувствовать" gr="V,acc,act,inan,intr,ipf,norm,partcp,pl,plen,praes" sem="der:v ca:noncaus d:pref t:psych:emot" sem2=""/>сочувствующие</w> <w><ana lex="молодой" gr="A,0,norm,plen" sem="t:time:age r:qual" sem2="t:time:age r:qual"/>молодой</w> <w><ana lex="россия" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>России</w>.</se><se> <w><ana lex="весь" gr="APRO,acc,n,norm,sg" sem="r:spec" sem2=""/>Все</w> <w><ana lex="это" gr="SPRO,acc,inan,n,norm,sg" sem="r:dem" sem2=""/>это</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="говорить" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="t:speech ca:noncaus d:root" sem2="d:root"/>говорю</w>, <w>конечно</w>, <w><ana lex="глубоко" gr="ADV,norm" sem="t:place dt:size:max der:a" sem2="der:shift dt:place t:degr:max dt:size:max der:a"/>глубоко</w> <w><ana lex="думать" gr="V,act,ger,intr,ipf,norm,praes" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/><ana lex="думать" gr="V,act,ger,ipf,norm,praes,tran" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/>думая</w> <w><ana lex="об" gr="PR,norm" sem="" sem2=""/>об</w> <w><ana lex="участь" gr="S,f,inan,nom,norm,pl" sem="r:abstr" sem2=""/><ana lex="участь" gr="S,f,gen,inan,norm,sg" sem="r:abstr" sem2=""/><ana lex="участь" gr="S,dat,f,inan,norm,sg" sem="r:abstr" sem2=""/><ana lex="участь" gr="S,acc,f,inan,norm,pl" sem="r:abstr" sem2=""/><ana lex="участь" gr="S,f,inan,loc,norm,sg" sem="r:abstr" sem2=""/>участи</w> <w><ana lex="мой" gr="APRO,gen,n,norm,sg" sem="r:poss" sem2=""/>моего</w> <w><ana lex="самый" gr="APRO,gen,n,norm,sg" sem="r:spec" sem2="r:spec"/><ana lex="сам" gr="APRO,gen,n,norm,sg" sem="r:spec" sem2=""/>самого</w> <w><ana lex="дорогой" gr="A,gen,n,norm,plen,sg" sem="r:qual" sem2="r:qual"/>дорогого</w>, <w><ana lex="родной" gr="A,gen,n,norm,plen,sg" sem="t:humq:char r:qual" sem2="ev:posit t:social:emot t:humq:char r:qual"/>родного</w> <w><ana lex="детище" gr="S,gen,inan,n,norm,sg" sem="" sem2="der:shift r:concr"/><ana lex="детище" gr="S,anim,gen,n,norm,sg" sem="t:hum ev r:concr der:s d:aug" sem2=""/>детища</w> -- <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w>.</se></p>
<p><se><w><ana lex="экспедиция" gr="S,f,inan,nom,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>Экспедиция</w> <w><ana lex="должный" gr="A,brev,f,norm,sg" sem="" sem2=""/>должна</w> <w><ana lex="жить" gr="V,act,inf,intr,ipf,norm" sem="t:be:exist ca:noncaus d:root" sem2="d:root"/>жить</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="быть" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>будет</w> <w><ana lex="жить" gr="V,act,inf,intr,ipf,norm" sem="t:be:exist ca:noncaus d:root" sem2="d:root"/>жить</w>: <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="это" gr="SPRO,acc,inan,n,norm,sg" sem="r:dem" sem2=""/>это</w> <w><ana lex="верить" gr="V,1p,act,indic,intr,ipf,norm,praes,sg" sem="t:ment ca:noncaus d:root der:s" sem2="ca:noncaus d:root der:s"/>верю</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="быть" gr="V,1p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>буду</w> <w><ana lex="жить" gr="V,act,inf,intr,ipf,norm" sem="t:be:exist ca:noncaus d:root" sem2="d:root"/>жить</w> <w><ana lex="такой" gr="APRO,0,norm" sem="r:dem" sem2="r:indet r:spec t:degr:max"/>такой</w> <w><ana lex="вера" gr="S,f,inan,ins,norm,sg" sem="t:ment r:abstr" sem2="r:abstr"/><ana lex="вера" gr="S,anim,f,ins,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>верой</w>.</se><se> <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>Но</w> <w><ana lex="что" gr="SPRO,inan,n,nom,norm,sg" sem="r:rel" sem2=""/>что</w> <w><ana lex="мочь" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="d:root" sem2=""/>может</w> <w><ana lex="произойти" gr="V,act,inf,intr,norm,pf" sem="t:be:exist ca:noncaus der:v d:pref" sem2="t:be:exist ca:noncaus der:v d:pref"/>произойти</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="тот" gr="APRO,ins,norm,pl" sem="r:dem" sem2=""/>теми</w>, <w><ana lex="который" gr="APRO,nom,norm,pl" sem="r:rel t:ord" sem2=""/>которые</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="большинство" gr="S,inan,loc,n,norm,sg" sem="sc:x der:a sc:hum pt:aggr pc:x pt:part r:concr" sem2=""/>большинстве</w> <w><ana lex="без" gr="PR,norm" sem="" sem2=""/>без</w> <w><ana lex="все" gr="SPRO,gen,inan,n,norm,sg" sem="" sem2=""/>всего</w> <w><ana lex="определить" gr="V,gen,m,norm,partcp,pass,pf,plen,praet,sg" sem="t:ment ca:noncaus d:pref" sem2="d:pref"/>определенного</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="харбин" gr="S,inan,loc,m,norm,sg" sem="r:propn t:topon" sem2=""/>Харбине</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="линия" gr="S,dat,f,inan,norm,sg" sem="top:line t:space r:concr" sem2="sc:x sc:hum t:space t:form top:line r:abstr pt:set der:shift t:conctr top:stripe pt:part t:unit r:concr"/>линии</w> <w>КВЖД</w> <w><ana lex="вообще" gr="ADV,PARENTH,norm" sem="dt:general der:a" sem2=""/>вообще</w>!</se><se> <w><ana lex="этот" gr="APRO,f,nom,norm,sg" sem="r:dem" sem2=""/>Эта</w> <w><ana lex="компания" gr="S,f,inan,nom,norm,sg" sem="t:group pt:set r:concr sc:hum" sem2="r:concr t:org"/>компания</w> <w><ana lex="еще" gr="ADV,norm" sem="" sem2=""/>еще</w> <w><ana lex="жить" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:be:exist ca:noncaus d:root" sem2="d:root"/>живет</w> <w><ana lex="иллюзия" gr="S,f,inan,ins,norm,pl" sem="t:ment t:perc r:abstr" sem2="t:ment r:abstr ev:neg"/>иллюзиями</w> <w><ana lex="насчет" gr="PR,norm" sem="" sem2=""/>насчет</w> <w><ana lex="защита" gr="S,f,gen,inan,norm,sg" sem="der:v r:abstr der:s0 t:inter" sem2="der:v ev:posit d:nag r:abstr t:inter sc:hum pt:aggr r:concr"/>защиты</w> <w><ana lex="америка" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Америки</w>.</se></p>
<p><se><w><ana lex="на" gr="PR,norm" sem="" sem2=""/>На</w> <w><ana lex="станция" gr="S,f,gen,inan,norm,sg" sem="pt:set sc:constr t:space r:concr top:horiz" sem2="t:constr pc:space r:concr r:abstr t:org"/>станции</w> <w><ana lex="сангина" gr="S,f,gen,inan,norm,pl" sem="" sem2=""/>Сангин</w> (<w><ana lex="ветеринарный" gr="A,acc,n,norm,plen,sg" sem="r:rel der:s dt:hum" sem2=""/>Ветеринарное</w> <w><ana lex="управление" gr="S,acc,inan,n,norm,sg" sem="der:v r:abstr der:s0" sem2="sc:tool:device r:abstr t:org pc:tool:device der:v pt:aggr pt:part r:concr"/>управление</w> <w><ana lex="монгольский" gr="A,gen,n,norm,plen,sg" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>монгольского</w> <w><ana lex="правительство" gr="S,gen,inan,n,norm,sg" sem="pc:org pt:set t:org der:v t:group sc:hum pt:part r:concr" sem2=""/>правительства</w>) <w><ana lex="дать" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:caus d:root t:poss" sem2="d:root"/>дал</w> <w><ana lex="два" gr="NUM,acc,f,inan,norm" sem="r:card:pauc" sem2=""/>две</w> <w><ana lex="наш" gr="APRO,acc,inan,norm,pl" sem="r:poss" sem2=""/>наши</w> <w><ana lex="винтовка" gr="S,acc,f,inan,norm,pl" sem="t:tool:weapon r:concr der:s" sem2=""/>винтовки</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="наган" gr="S,acc,inan,m,norm,sg" sem="t:tool:weapon r:concr" sem2=""/>наган</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="3" gr="NUM,ciph"/>3</w> <w><ana lex="пачка" gr="S,f,inan,ins,norm,pl" sem="sc:thing qc:thing qc:stuff pt:qtm qc:aggr pt:set r:concr" sem2="t:tool:cloth r:concr"/>пачками</w> <w><ana lex="патрон" gr="S,gen,inan,m,norm,pl" sem="t:tool:shell r:concr" sem2="t:tool top:cylinder pt:part top:tube r:concr pc:tool"/><ana lex="патрон" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr" sem2="t:hum ev r:concr"/>патронов</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="винчестер" gr="S,acc,inan,m,norm,sg" sem="r:propn t:topon" sem2="t:tool:weapon r:concr"/>винчестер</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="наган" gr="S,acc,inan,m,norm,sg" sem="t:tool:weapon r:concr" sem2=""/>наган</w>, <w>конечно</w> <w><ana lex="во" gr="PR,norm" sem="" sem2=""/>во</w> <w><ana lex="временный" gr="A,acc,n,norm,plen,sg" sem="t:time r:qual" sem2=""/><ana lex="временной" gr="A,acc,n,norm,plen,sg" sem="r:rel der:s" sem2=""/>временное</w> <w><ana lex="пользование" gr="S,acc,inan,n,norm,sg" sem="der:v r:abstr" sem2=""/>пользование</w>.</se></p>
<p><se><w><ana lex="продолжать" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="aux:phase d:pref der:a" sem2=""/>Продолжаю</w> <w><ana lex="знакомиться" gr="V,act,inf,intr,ipf,norm" sem="ca:noncaus" sem2="ca:noncaus"/><ana lex="знакомиться" gr="V,act,inf,intr,ipf,norm" sem="ca:noncaus" sem2="ca:noncaus"/>знакомиться</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="случай" gr="S,dat,inan,m,norm,sg" sem="pt:qtm r:abstr" sem2="t:time:moment r:abstr"/>случаю</w> <w><ana lex="праздник" gr="S,gen,inan,m,norm,sg" sem="t:action r:abstr" sem2="r:abstr"/>праздника</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="монголка" gr="S,anim,f,ins,norm,pl" sem="" sem2=""/>монголками</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="бурят" gr="S,anim,ins,m,norm,pl" sem="" sem2=""/>бурятами</w>.</se><se> <w><ana lex="я" gr="SPRO,1p,acc,norm,sg" sem="r:pers" sem2=""/>Меня</w> <w><ana lex="продолжать" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="aux:phase d:pref der:a" sem2=""/>продолжают</w> <w><ana lex="занимать" gr="V,act,inf,ipf,norm,tran" sem="d:pref" sem2=""/>занимать</w> <w><ana lex="богатый" gr="A,acc,inan,norm,pl,plen" sem="r:qual" sem2="der:shift r:qual"/>богатые</w>, <w><ana lex="оригинальный" gr="A,acc,inan,norm,pl,plen" sem="r:rel der:s" sem2="r:rel der:s"/>оригинальные</w> <w><ana lex="костюм" gr="S,acc,inan,m,norm,pl" sem="pt:set t:tool:cloth r:concr sc:tool:cloth hi:class" sem2="pt:set t:tool:cloth r:concr sc:tool:cloth"/>костюмы</w> <w><ana lex="монгольский" gr="A,gen,norm,pl,plen" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>монгольских</w> <w><ana lex="княгиня" gr="S,anim,f,gen,norm,pl" sem="t:hum d:fem r:concr der:s" sem2=""/>княгинь</w>.</se><se> <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="два" gr="NUM,f,nom,norm" sem="r:card:pauc" sem2=""/>две</w> <w><ana lex="такой" gr="APRO,nom,norm,pl" sem="r:dem" sem2="r:indet r:spec t:degr:max"/>такие</w> <w><