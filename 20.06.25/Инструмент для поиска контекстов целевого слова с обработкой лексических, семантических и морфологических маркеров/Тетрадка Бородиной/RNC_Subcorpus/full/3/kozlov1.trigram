<p><se><w>Много</w>, <w>много</w> <w><ana lex="интерес" gr="S,gen,inan,m,norm,sg" sem="t:ment r:abstr" sem2="r:abstr ev:neg"/>интереса</w> <w><ana lex="крыться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus" sem2=""/><ana lex="крыться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus" sem2=""/>кроется</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="помещение" gr="S,inan,loc,n,norm,sg" sem="top:contain pc:constr:hut r:concr t:room pt:part" sem2="t:put der:v r:abstr der:s0"/>помещении</w> <w><ana lex="музей" gr="S,gen,inan,m,norm,sg" sem="r:concr t:org" sem2=""/>музея</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="его" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,n,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,f,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,m,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,n,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,f,gen,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,n,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,f,gen,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,m,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,n,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,f,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,m,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,n,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,f,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,m,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,n,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,f,norm,sg" sem="r:poss