<p><se><b/><w><b>25</b></w><b>/</b><w><ana lex="i" gr="bastard" sem="" sem2=""/><b>I</b></w><b>, </b><w><ana lex="t" gr="bastard" sem="" sem2=""/><b>T</b></w><b/>. <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w> <w><ana lex="еще" gr="ADV,norm" sem="" sem2=""/>еще</w> <w><ana lex="много" gr="ADV,comp,norm" sem="t:quant:max r:spec" sem2="t:degr:max"/><ana lex="более" gr="ADV,norm" sem="t:degr:max der:adv" sem2="t:degr:max"/>более</w> <w><ana lex="морозный" gr="A,n,nom,norm,plen,sg" sem="dt:temper dt:abstr t:physq:temper r:rel der:s" sem2=""/>морозное</w>, -<w><ana lex="29" gr="NUM,ciph"/>29</w>°<w><ana lex="r" gr="bastard" sem="" sem2=""/>R</w>, <w><ana lex="да" gr="CONJ,norm" sem="" sem2=""/>да</w> <w><ana lex="еще" gr="ADV,norm" sem="" sem2=""/>еще</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana form="юго-восточным" lex="юго-восточный" gr="A,ins,m,norm,plen,sg" sem="t:place der:comp r:rel dt:space" sem2=""/>юго-восточным</w> <w><ana lex="ветер" gr="S,inan,ins,m,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>ветром</w>.</se></p>
<p><se><w><ana lex="мой" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>Мои</w> <w><ana lex="спутник" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,inan,m,nom,norm,pl" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутники</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="ночь" gr="S,dat,f,inan,norm,pl" sem="pc:day r:abstr pt:part t:time" sem2=""/>ночам</w> <w><ana lex="долго" gr="ADV,norm" sem="t:time:dur:max dt:time:dur:max der:a" sem2=""/>долго-долго</w> <w><ana lex="сидеть" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:noncaus"/>сидят</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="холодный" gr="A,ins,norm,pl,plen" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодными</w> <w><ana lex="утро" gr="S,inan,ins,n,norm,pl" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утрами</w> <w><ana lex="долго" gr="ADV,norm" sem="t:time:dur:max dt:time:dur:max der:a" sem2=""/>долго-долго</w> <w><ana lex="спать" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="d:root" sem2="d:root"/>спят</w>.</se><se> <w><ana lex="ничто" gr="SPRO,gen,n,norm,sg" sem="r:neg" sem2=""/>Ничего</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="поделать" gr="V,2p,act,fut,indic,norm,pf,sg,tran" sem="d:pref" sem2=""/>поделаешь</w> -- <w><ana lex="всегда" gr="ADVPRO,norm" sem="r:spec t:time" sem2=""/>всегда</w> <w><ana lex="бывать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:be:exist ca:noncaus der:v d:impf" sem2="der:v t:loc der:shift d:impf ca:noncaus"/>бывает</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="зимовка" gr="S,f,inan,loc,norm,pl" sem="der:v r:abstr der