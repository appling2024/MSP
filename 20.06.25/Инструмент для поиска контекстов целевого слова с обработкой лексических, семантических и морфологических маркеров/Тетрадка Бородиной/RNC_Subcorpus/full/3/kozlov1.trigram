<p><se><w><ana lex="на" gr="PR,norm" sem="" sem2=""/>На</w> <w><ana lex="табор" gr="S,inan,loc,m,norm,sg" sem="t:space r:concr t:org" sem2="t:group pt:set t:space r:concr sc:hum"/>таборе</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="весь" gr="APRO,nom,norm,pl" sem="r:spec" sem2=""/>все</w> <w><ana lex="сойтись" gr="V,act,indic,intr,norm,pf,pl,praet" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/>сошлись</w>, <w><ana lex="кто" gr="SPRO,anim,m,nom,norm,sg" sem="r:rel" sem2=""/>кто</w> <w><ana lex="ранний" gr="A,comp,norm,plen" sem="t:time r:qual" sem2="t:time r:qual"/>раньше</w>, <w><ana lex="кто" gr="SPRO,anim,m,nom,norm,sg" sem="r:rel" sem2=""/>кто</w> <w><ana lex="поздний" gr="A,comp,norm,plen" sem="t:time r:qual" sem2="t:time r:qual"/>позже</w>, <w><ana lex="поесть" gr="V,act,indic,norm,pf,pl,praet,tran" sem="ca:caus t:physiol d:pref" sem2="d:pref"/>поели</w>, <w><ana lex="попить" gr="V,act,indic,norm,pf,pl,praet,tran" sem="ca:caus t:physiol d:pref" sem2=""/>попили</w> <w><ana lex="чай" gr="S,gen2,inan,m,norm,sg" sem="t:plant:bush r:concr" sem2="t:food t:stuff r:abstr sc:plant t:liq pt:aggr t:plant:bush r:concr"/>чаю</w>.</se><se> <w><ana lex="никто" gr="SPRO,anim,m,nom,norm,sg" sem="r:neg" sem2=""/>Никто</w>, <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="исключение" gr="S,inan,ins,n,norm,sg" sem="t:put der:v r:abstr der:s0" sem2="r:abstr"/>исключением</w> <w><ana lex="васильев" gr="S,anim,famn,gen,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Васильева</w>, <w><ana lex="стрелять" gr="V,act,gen,ipf,m,norm,partcp,plen,praet,sg,tran" sem="der:s" sem2="t:impact:destr ca:caus t:be:disapp t:poss ca:0 t:sound der:s ca:noncaus t:physiol"/>стрелявшего</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="рябчик" gr="S,anim,dat,m,norm,pl" sem="t:animal r:concr der:a" sem2=""/><ana lex="рябчик" gr="S,dat,inan,m,norm,pl" sem="" sem2=""/>рябчикам</w>, <w><ana lex="и" gr