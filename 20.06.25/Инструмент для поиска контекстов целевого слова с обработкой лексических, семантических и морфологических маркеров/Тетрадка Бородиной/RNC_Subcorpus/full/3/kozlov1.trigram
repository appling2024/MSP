org pt:ind pt:aggr:aggrpl t:poss der:shift pc:x pt:part pc:text r:concr"/>части</w> <w><ana lex="палеонтологический" gr="A,gen,norm,pl,plen" sem="der:comp r:rel" sem2=""/>палеонтологических</w> <w><ana lex="находка" gr="S,f,gen,inan,norm,pl" sem="der:v t:thing r:propn r:concr t:topon" sem2="ev:posit r:abstr t:fam"/>находок</w>?</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="этот" gr="APRO,loc,n,norm,sg" sem="r:dem" sem2=""/>этом</w> <w><ana lex="отношение" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr der:s0 t:inter" sem2="der:v t:text r:concr r:abstr t:inter"/>отношении</w> <w><ana lex="еще" gr="ADV,norm" sem="" sem2=""/>еще</w> <w><ana lex="ничего" gr="ADV,norm" sem="ev:posit r:neg" sem2=""/>ничего</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="почти" gr="ADV,norm" sem="" sem2=""/>почти</w> <w><ana lex="ничто" gr="SPRO,gen,n,norm,sg" sem="r:neg" sem2=""/>ничего</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="сделать" gr="V,brev,n,norm,partcp,pass,pf,praet,sg,tran" sem="d:pref" sem2=""/>сделано</w>!</se><se> <w><ana lex="если" gr="CONJ,norm" sem="" sem2=""/>Если</w>, <w>конечно</w>, <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="считать" gr="V,act,inf,norm,pf" sem="der:v d:pref" sem2="der:v t:ment d:pref ca:noncaus"/><ana lex="считать" gr="V,act,inf,ipf,norm,tran" sem="der:v d:pref" sem2="der:v t:ment d:pref ca:noncaus"/><ana lex="считать" gr="V,act,inf,norm,pf,tran" sem="der:v d:pref" sem2="der:v t:ment d:pref ca:noncaus"/><ana lex="считать" gr="V,act,inf,ipf,norm,tran" sem="der:v d:pref" sem2="der:v t:ment d:pref ca:noncaus"/>считать</w> <w><ana lex="первое" gr="S,acc,inan,n,norm,pl" sem="t:food der:subst der:anum t:stuff sc:food t:liq pt:aggr pc:food r:concr" sem2=""/>первых</w> <w><ana lex="замечательный" gr="A,gen,norm,pl,plen" sem="der:v ev:posit t:quality r:qual" sem2=""/>замечательных</w> <w><ana lex="находка" gr="S,f,gen,inan,norm,pl" sem="der:v t:thing r:propn