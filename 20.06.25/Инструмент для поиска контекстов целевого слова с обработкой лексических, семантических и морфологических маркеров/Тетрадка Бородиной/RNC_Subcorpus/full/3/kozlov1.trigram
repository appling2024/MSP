<p><se><w>Конечно</w>, <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="сильно" gr="ADV,norm" sem="dt:physq t:degr:max der:a" sem2="dt:physq der:a"/>сильно</w> <w><ana lex="призадуматься" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="t:ment ca:noncaus d:pref" sem2=""/>призадумался</w> <w><ana lex="над" gr="PR,norm" sem="" sem2=""/>над</w> <w><ana lex="этот" gr="APRO,f,ins,norm,sg" sem="r:dem" sem2=""/>этой</w> <w><ana lex="телеграмма" gr="S,f,inan,ins,norm,sg" sem="der:comp r:concr t:text" sem2=""/>телеграммой</w>.</se><se> <w><ana lex="спасть" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2="d:pref"/><ana lex="спать" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="d:root" sem2="d:root"/>Спал</w> <w><ana lex="хорошо" gr="ADV,PRAEDIC,norm" sem="ev:posit dt:quality der:a" sem2=""/><ana lex="хорошо" gr="ADV,PARENTH,norm" sem="ev:posit dt:quality der:a" sem2=""/>хорошо</w>.</se><se> <w><ana lex="наутро" gr="ADV,norm" sem="der:s t:time" sem2=""/>Наутро</w>, <b/><w><b>22</b></w><b>/</b><w><ana lex="vii" gr="bastard" sem="" sem2=""/><b>VII</b></w><b>, </b><w><b>воскресенье</b></w><b/>, <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="отправиться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2=""/>отправился</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="один" gr="APRO,dat,m,norm,sg" sem="" sem2="r:indet"/>одному</w> <w><ana lex="свой" gr="APRO,dat,m,norm,sg" sem="r:poss" sem2="t:social r:poss"/>своему</w> <w><ana lex="друг" gr="S,anim,dat,m,norm,sg" sem="t:hum r:concr" sem2="t:hum r:concr"/>другу</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="торговый" gr="A,acc,f,norm,plen,sg" sem="dt:poss dt:abstr r:rel der:s" sem2="der:v dt:poss r:rel"/>Торговую</w> <w><ana lex="улица" gr="S,acc,f,inan,norm,sg" sem="t:space r:concr pt:part pc:space" sem2="sc:hum pt:aggr t:space r:concr sc:space"/>улицу</w>.</se><se> <w><a