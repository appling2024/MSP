<p><se><b/><w><b>10</b></w><b>/</b><w><ana lex="iii" gr="bastard" sem="" sem2=""/><b>III</b></w><b>, </b><w><ana lex="r" gr="bastard" sem="" sem2=""/><b>R</b></w><b/>. <w><ana lex="холодный" gr="A,n,nom,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>Холодное</w>, <w><ana lex="ясный" gr="A,n,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясное-ясное</w> <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утро</w>.</se><se> <w><ana lex="несмотря" gr="ADV,norm" sem="der:v" sem2=""/>Несмотря</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="еще" gr="ADV,norm" sem="" sem2=""/>еще</w>, <w>по-видимому</w>, <w><ana lex="полный" gr="A,acc,f,norm,plen,sg" sem="t:content r:qual" sem2="t:degr t:appearance r:qual"/>полную</w> <w><ana lex="зима" gr="S,acc,f,inan,norm,sg" sem="t:time:season r:abstr t:time" sem2="t:fam"/>зиму</w>, <w><ana lex="все" gr="SPRO,inan,n,nom,norm,sg" sem="" sem2=""/>все</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="воздух" gr="S,inan,loc,m,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>воздухе</w> <w><ana lex="замечаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus d:pref" sem2=""/>замечается</w> <w><ana lex="что" gr="SPRO,inan,n,nom,norm,sg" sem="r:rel" sem2=""/><ana form="что-то" lex="что-то" gr="SPRO,inan,n,nom,norm,sg" sem="r:indet" sem2=""/>что-то</w> <w><ana lex="чисто" gr="ADV,norm" sem="ev:posit dt:physq der:a" sem2="ev:posit dt:physq der:a"/>чисто</w> <w><ana lex="весенний" gr="A,n,nom,norm,plen,sg" sem="dt:time dt:abstr dt:time:season der:s t:time r:rel" sem2=""/>весеннее</w>, <w><ana lex="помимо" gr="PR,norm" sem="" sem2=""/>помимо</w> <w><ana lex="даже" gr="PART,norm" sem="" sem2=""/>даже</w> <w><ana lex="то" gr="SPRO,gen,inan,