<w><ana lex="золото" gr="S,inan,ins,n,norm,sg" sem="t:stuff r:concr" sem2="sc:workart sc:thing t:stuff sc:money:banknote sc:money pt:aggr r:concr"/>золотом</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="экстраординарный" gr="A,gen,norm,pl,plen" sem="der:comp ev r:rel t:degr:max" sem2="der:comp r:rel"/>экстраординарных</w> <w><ana lex="подарок" gr="S,gen,inan,m,norm,pl" sem="der:v t:thing r:concr" sem2="t:thing ev:posit r:concr r:abstr"/>подарков</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="государственный" gr="A,gen,n,norm,plen,sg" sem="dt:space r:rel der:s" sem2="ev:posit r:rel der:s t:humq:char"/>государственного</w> <w><ana lex="хранилище" gr="S,gen,inan,n,norm,sg" sem="der:v top:contain t:constr r:concr t:room" sem2=""/>хранилища</w> (<w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="мой" gr="APRO,dat,m,norm,sg" sem="r:poss" sem2=""/>моему</w> <w><ana lex="выбор" gr="S,dat,inan,m,norm,sg" sem="der:v r:abstr der:s0" sem2="pt:set r:abstr"/>выбору</w>).</se><se> <w><ana lex="усиленный" gr="A,ins,m,norm,plen,sg" sem="der:v dt:changest r:rel" sem2="t:degr:max r:qual"/>Усиленным</w> <w><ana lex="темп" gr="S,inan,ins,m,norm,sg" sem="t:speed r:abstr t:param" sem2=""/>темпом</w> <w><ana lex="экспедиция" gr="S,f,inan,nom,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиция</w> <w><ana lex="вести" gr="V,act,f,indic,ipf,norm,praet,sg,tran" sem="ca:caus t:move d:root" sem2="aux:caus ca:caus t:move d:root ca:bgr"/>вела</w> <w><ana lex="свой" gr="APRO,acc,inan,norm,pl" sem="r:poss" sem2="t:social r:poss"/>свои</w> <w><ana lex="работа" gr="S,acc,f,inan,norm,pl" sem="der:v r:abstr" sem2="sc:x t:text t:workdram t:workmus r:abstr t:workart der:v pt:aggr t:workcin r:concr"/>работы</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="снаряжение" gr="S,dat,inan,n,norm,sg" sem="der:v r:abstr der:s0 t:poss" sem2="der:v t:tool r:concr pt:a