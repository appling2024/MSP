<p><se><w><ana lex="завтра" gr="ADV,norm" sem="t:time" sem2=""/>Завтра</w> <w><ana lex="использовать" gr="V,3p,act,fut,indic,norm,pf,pl,tran" sem="der:v d:pref" sem2=""/><ana lex="использовать" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="der:v d:pref" sem2=""/>используют</w> <w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="тот" gr="APRO,f,ins,norm,sg" sem="r:dem" sem2=""/>той</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w> <w><ana lex="цель" gr="S,f,inan,ins,norm,sg" sem="t:space r:concr" sem2="t:ment r:abstr"/>целью</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w>С</w>. <w>А</w>. <w><ana lex="глаголев" gr="S,anim,famn,ins,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Глаголевым</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="остальной" gr="APRO,nom,norm,pl" sem="" sem2=""/>остальные</w> <w><ana lex="мой" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>мои</w> <w><ana lex="спутник" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,inan,m,nom,norm,pl" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутники</w>.</se><se> <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="знаменательный" gr="A,m,nom,norm,plen,sg" sem="r:qual" sem2=""/>знаменательный</w> <w><ana lex="день" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w> -- <w><ana lex="200" gr="NUM,ciph"/>200</w> <w><ana lex="год" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:age r:abstr"/>лет</w> <w><ana lex="город" gr="S,dat,inan,m,norm,sg"