<p><se><w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="случай" gr="S,inan,loc,m,norm,pl" sem="pt:qtm r:abstr" sem2="t:time:moment r:abstr"/>случаях</w> <w><ana lex="крайний" gr="A,f,gen,norm,plen,sg" sem="dt:space t:dist r:rel der:s t:ord" sem2="dt:space t:degr:max:magn r:rel der:s r:qual"/>крайней</w> <w><ana lex="спешка" gr="S,f,gen,inan,norm,sg" sem="der:v r:abstr der:s0" sem2="ev:neg r:abstr t:behav"/>спешки</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="значительный" gr="A,gen,norm,pl,plen" sem="t:quant:max der:v t:degr:max r:qual" sem2="der:v r:rel d:habit"/>значительных</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="объем" gr="S,dat,inan,m,norm,sg" sem="r:abstr t:param" sem2="r:abstr"/>объему</w> <w><ana lex="отчет" gr="S,gen,inan,m,norm,pl" sem="t:speech der:v r:abstr der:s0" sem2="t:speech r:abstr"/>отчетов</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="быть" gr="V,1p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>буду</w> <w><ana lex="вынудить" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="d:pref" sem2="d:pref"/>вынужден</w> <w><ana lex="отправлять" gr="V,act,inf,ipf,norm,tran" sem="der:v ca:caus t:move d:pref" sem2=""/>отправлять</w> <w><ana lex="таковой" gr="APRO,acc,inan,norm,pl" sem="r:dem" sem2=""/>таковые</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="главнаука" gr="S,bastard,f,inan,loc,sg" sem="r:propn t:org" sem2=""/>Главнауке</w>, <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="рго" gr="S,0,anim,bastard,m,sg" sem="" sem2=""/><ana lex="рго" gr="S,0,anim,bastard,m,persn,sg" sem="" sem2=""/>РГО</w> <w><ana lex="поочередно" gr="ADV,norm" sem="dt:dstrib der:a" sem2=""/>поочередно</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="просьба" gr="S,f,inan,ins,norm,sg" sem="t:speech der:v r:abstr" sem2="r:abstr"/>просьбой</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="получить" gr="V,act,dat,n,norm,partcp,pf,plen,praet,sg" sem="ca:noncaus t:poss" sem2=""/>получившему</w> <w><ana lex="учреждение" gr="S,dat,inan,n,norm,sg" sem="der:v r:abstr der:s0 t:be:appear" sem2="der:v r:abstr r:concr t:org hi:class"/>учреждению</w> <w><ana lex="копия" gr="S,f,inan,ins,norm,pl" sem="t:thing r:concr" sem2="ev r:concr"/>копиями</w> <w><ana lex="познакомить" gr="V,act,inf,norm,pf,tran" sem="d:pref" sem2=""/>познакомить</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="известие" gr="S,inan,ins,n,norm,pl" sem="t:speech r:abstr" sem2="der:v r:propn r:concr t:text t:media"/>известиями</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w> <w><ana lex="учреждение" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr der:s0 t:be:appear" sem2="der:v r:abstr r:concr t:org hi:class"/>учреждение</w>, <w><ana lex="неполучить" gr="V,act,bastard,n,nom,partcp,pf,plen,praet,sg,tran" sem="" sem2=""/>неполучившее</w>.</se><se> <w><ana lex="надеяться" gr="V,1p,act,indic,intr,ipf,norm,praes,sg" sem="t:ment ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>Надеюсь</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="скорый" gr="A,acc,inan,m,norm,plen,sg" sem="t:speed:max r:qual" sem2="t:time r:rel r:qual"/>скорый</w> <w><ana lex="отклик" gr="S,acc,inan,m,norm,sg" sem="t:speech der:v r:abstr der:s0" sem2="t:speech r:abstr"/>отклик</w>.</se><se> <w><ana lex="привет" gr="S,inan,m,nom,norm,sg" sem="r:abstr" sem2="t:speech r:abstr"/>Привет</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="монголия" gr="S,f,inan,loc,norm,sg" sem="r:propn t:topon" sem2=""/>Монголии</w>.</se></p>
<p><se><w>П</w>. <w><ana lex="козлов" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/><ana lex="козлов" gr="S,inan,m,nom,norm,sg" sem="" sem2="r:propn t:topon"/>Козлов</w></se></p>
<p><se><i/><w><i>Примечание</i></w><i/>.</se><se> <w><ana lex="помимо" gr="PR,norm" sem="" sem2=""/>Помимо</w> <w><ana lex="отчет" gr="S,gen,inan,m,norm,pl" sem="t:speech der:v r:abstr der:s0" sem2="t:speech r:abstr"/>отчетов</w> <w><ana lex="павлов" gr="S,anim,famn,gen,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Павлова</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="козлова" gr="S,anim,f,famn,gen,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Козловой</w> <w><ana lex="прилагать" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="der:v d:pref" sem2=""/>прилагаю</w> <w><ana lex="еще" gr="ADV,norm" sem="" sem2=""/>еще</w> <w><ana lex="два" gr="NUM,m,nom,norm" sem="r:card:pauc" sem2=""/>два</w> <w><ana lex="фотографический" gr="A,gen,norm,pl,plen" sem="der:comp r:rel" sem2=""/>фотографических</w> <w><ana lex="снимок" gr="S,gen,inan,m,norm,sg" sem="der:v r:concr t:workart" sem2=""/>снимка</w> <w><ana lex="тибетский" gr="A,f,gen,norm,plen,sg" sem="dt:topon r:rel der:s t:topon" sem2=""/>Тибетской</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w> (<w><ana lex="персонал" gr="S,inan,m,nom,norm,sg" sem="sc:hum pt:aggr r:concr" sem2=""/>персонал</w> <w><ana lex="тибетский" gr="A,f,gen,norm,plen,sg" sem="dt:topon r:rel der:s t:topon" sem2=""/>Тибетской</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w>С</w>. <w><ana lex="гедин" gr="S,anim,bastard,ins,m,persn,sg" sem="" sem2=""/><ana lex="гедин" gr="S,bastard,inan,ins,m,sg" sem="" sem2=""/><ana lex="гедин" gr="S,anim,bastard,ins,m,persn,sg" sem="" sem2=""/><ana lex="гедин" gr="S,bastard,inan,ins,