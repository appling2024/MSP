m,pl" sem="" sem2=""/><ana lex="прочее" gr="SPRO,acc,n,norm,pl" sem="" sem2=""/><ana lex="прочее" gr="SPRO,loc,n,norm,pl" sem="" sem2=""/>прочих</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="целый" gr="A,acc,f,norm,plen,sg" sem="t:degr r:qual" sem2="t:degr r:spec r:qual"/>целую</w> <w><ana lex="голова" gr="S,acc,anim,f,famn,norm,sg" sem="" sem2="t:hum ev:posit ev r:concr"/><ana lex="голова" gr="S,acc,f,inan,norm,sg" sem="pt:partb pc:animal r:concr pc:hum" sem2="t:ment pt:qtm r:abstr qc:aggr qc:food pc:x pt:part r:concr t:fam"/>голову</w>.</se><se> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>Из</w> <w><ana lex="серия" gr="S,f,gen,inan,norm,sg" sem="pt:set sc:x r:concr r:abstr pt:qtm" sem2="pc:workcin r:concr r:abstr pt:part t:text"/>серии</w> <w><ana lex="птица" gr="S,anim,f,gen,norm,pl" sem="t:animal r:concr hi:class" sem2=""/>птиц</w>, <w><ana lex="привезти" gr="V,gen,norm,partcp,pass,pf,pl,plen,praet" sem="der:v ca:caus t:move d:pref" sem2=""/>привезенных</w> <w><ana lex="кондратьев" gr="S,anim,famn,ins,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Кондратьевым</w>, <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="сделать" gr="V,act,indic,m,norm,pf,praet,sg,tran" sem="d:pref" sem2=""/>сделал</w> <w><ana lex="cinclus" gr="bastard" sem="" sem2=""/>Cinclus</w>&apos;<w><ana lex="a" gr="bastard" sem="" sem2=""/>a</w> (<w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="который" gr="APRO,acc,anim,m,norm,sg" sem="r:rel t:ord" sem2=""/>которого</w> <w><ana lex="весь" gr="APRO,acc,inan,m,norm,sg" sem="r:spec" sem2=""/>весь</w> <w><ana lex="низ" gr="S,acc,inan,m,norm,sg" sem="r:concr pc:x pt:part" sem2="t:sound r:abstr pt:part"/>низ</w>, <w>т</w>.<w>е</w>. <w><ana lex="шея" gr="S,f,inan,nom,norm,sg" sem="pt:partb pc:animal r:concr pc:hum" sem2=""/>шея</w>, <w><ana lex="грудь" gr="S,f,inan,nom,norm,sg" sem="top:contain pc:hum pc:animal pt:partb top:jut top:vertical r:concr" sem2="pt:partb pc:tool:cloth r