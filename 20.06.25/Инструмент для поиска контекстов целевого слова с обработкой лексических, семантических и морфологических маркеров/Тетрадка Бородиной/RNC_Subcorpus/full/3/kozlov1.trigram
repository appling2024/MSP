<p><se><w><ana lex="какой" gr="APRO,n,nom,norm,sg" sem="t:neg r:rel ev:neg" sem2=""/>Какое</w> <w><ana lex="счастие" gr="S,inan,n,nom,norm,sg" sem="t:psych:emot r:abstr" sem2=""/>счастье</w> <w><ana lex="быть" gr="V,act,inf,intr,ipf,norm" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>быть</w> <w>теперь</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="центр" gr="S,inan,loc,m,norm,sg" sem="t:space r:concr pc:form:geom pt:part" sem2="pc:org t:space pc:hum pc:animal t:org pt:set pt:partb:organ pc:x pt:part sc:cell2 r:concr"/>центре</w> <w><ana lex="гоби" gr="S,0,f,inan,norm" sem="r:propn t:topon" sem2=""/>Гоби</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="бар" gr="S,gen,inan,m,norm,sg" sem="t:unit r:concr t:org r:abstr" sem2="t:space top:contain t:tool:furn pt:part top:hill pc:reservoir pc:space r:concr"/>Бара-хулусуне</w>.</se><se> <w><ana lex="чувствовать" gr="V,act,inf,ipf,norm,tran" sem="ca:noncaus t:perc der:s" sem2="der:s"/>Чувствовать</w> <w><ana lex="себе" gr="SPRO,acc,norm" sem="" sem2=""/>себя</w> <w><ana lex="независимый" gr="A,ins,m,norm,plen,sg" sem="d:impot r:rel der:a" sem2="d:impot t:humq der:a r:qual"/>независимым</w>, <w><ana lex="свободный" gr="A,ins,m,norm,plen,sg" sem="der:s t:humq:char r:qual" sem2="t:size:max der:s r:qual"/>свободным</w> <w><ana lex="человек" gr="S,anim,ins,m,norm,sg" sem="t:hum r:concr" sem2="t:hum ev:posit r:concr"/>человеком</w>, <w><ana lex="видеть" gr="V,act,inf,ipf,norm,tran" sem="ca:noncaus t:perc d:root" sem2="t:ment ca:noncaus d:root"/>видеть</w> <w><ana lex="экспедиция" gr="S,acc,f,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедицию</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="работа" gr="S,f,inan,ins,norm,sg" sem="der:v r:abstr" sem2="sc:x t:text t:workdram t:workmus r:abstr t:workart der:v pt:aggr t:workcin r:concr"/>работой</w>, <w><ana lex="ликующий" gr="A,f,ins,