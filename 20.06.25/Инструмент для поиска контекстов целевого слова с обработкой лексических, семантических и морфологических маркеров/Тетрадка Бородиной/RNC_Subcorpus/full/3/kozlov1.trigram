<p><se><w><ana lex="наш" gr="APRO,n,nom,norm,sg" sem="r:poss" sem2=""/>Наше</w> <w><ana lex="ожидание" gr="S,inan,n,nom,norm,sg" sem="t:ment der:v r:abstr der:s0" sem2="t:ment r:abstr"/>ожидание</w> <w><ana lex="ответ" gr="S,gen,inan,m,norm,sg" sem="t:speech r:abstr" sem2="t:text r:concr r:abstr t:speech pc:text pt:addit"/>ответа</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="москва" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2="r:propn t:topon"/>Москвы</w> <w><ana lex="превратиться" gr="V,act,indic,intr,n,norm,pf,praet,sg" sem="der:v ca:noncaus d:pref" sem2=""/>превратилось</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="хронический" gr="A,acc,n,norm,plen,sg" sem="r:rel t:time" sem2="t:time:dur:max r:rel r:qual"/>хроническое</w>.</se><se> <w><ana lex="притупиться" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="dt:physq der:a der:v t:changest ca:noncaus d:pref dt:physq:form" sem2="ca:noncaus d:pref"/>Притупилась</w> <w><ana lex="тот" gr="APRO,f,nom,norm,sg" sem="r:dem" sem2=""/>та</w> <w><ana lex="острый" gr="A,f,nom,norm,plen,sg" sem="t:physq ev r:qual" sem2="t:physq:form ev:posit der:shift r:qual t:physq:taste ev"/>острая</w> <w><ana lex="боль" gr="S,f,inan,nom,norm,sg" sem="t:physiol r:abstr" sem2="t:physiol r:abstr"/>боль</w>, <w><ana lex="который" gr="APRO,f,nom,norm,sg" sem="r:rel t:ord" sem2=""/>которая</w> <w><ana lex="появиться" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="ca:noncaus d:pref t:be:appear" sem2="ca:noncaus d:pref"/>появилась</w> <w><ana lex="вначале" gr="ADV,norm" sem="der:s t:time" sem2=""/>вначале</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="болезненно" gr="ADV,norm" sem="der:a ev:neg" sem2=""/>болезненно</w>.</se><se> <w><ana lex="прекрасный" gr="A,m,nom,norm,plen,sg" sem="ev:posit t:appearance r:qual" sem2="ev:posit t:quality r:qual"/>Прекрасный</w> <w><ana lex="день" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:pa