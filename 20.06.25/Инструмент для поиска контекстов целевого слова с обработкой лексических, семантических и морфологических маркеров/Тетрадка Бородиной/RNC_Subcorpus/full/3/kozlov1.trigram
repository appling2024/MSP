<p><se><w><ana lex="покоиться" gr="V,2p,act,imper,intr,ipf,norm,sg" sem="t:loc d:pref ca:noncaus" sem2="ca:noncaus d:pref"/>Покойся</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="торжествовать" gr="V,2p,act,imper,intr,ipf,norm,sg" sem="der:s" sem2="der:s"/>торжествуй</w>, <w>по-своему</w> <w><ana lex="лучший" gr="A,m,nom,norm,sg,supr" sem="d:super ev:posit der:a t:quality r:qual" sem2=""/>лучший</w>, <w><ana lex="чистый" gr="A,m,nom,norm,plen,sg" sem="t:physst r:qual" sem2="t:physq ev:posit t:humq t:degr r:qual"/>чистый</w> <w><ana lex="уголок" gr="S,inan,m,nom,norm,sg" sem="dt:form t:form top:corner top:form der:s d:dim r:concr" sem2="pt:aggr sc:tool t:tool t:space top:contain dt:space top:corner t:room pt:ind t:sign dt:part top:form pc:x pt:part d:dim r:concr pc:room der:s"/>уголок</w> <w><ana lex="центральный" gr="A,f,gen,norm,plen,sg" sem="t:place dt:space r:rel der:s" sem2="dt:space t:hier r:rel der:s"/>Центральной</w> <w><ana lex="азия" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Азии</w>.</se><se> <w><ana lex="любоваться" gr="V,act,ger,intr,ipf,norm,praes" sem="ca:noncaus t:perc" sem2=""/>Любуясь</w> <w><ana lex="ты" gr="SPRO,2p,ins,norm,sg" sem="r:pers" sem2=""/>тобою</w>, <w><ana lex="всегда" gr="ADVPRO,norm" sem="r:spec t:time" sem2=""/>всегда</w> <w><ana lex="невольно" gr="ADV,norm" sem="der:a" sem2=""/>невольно</w> <w><ana lex="вспоминать" gr="V,2p,act,indic,ipf,norm,praes,sg,tran" sem="der:v d:pref" sem2="der:v d:pref"/>вспоминаешь</w> <w><ana lex="мудрый" gr="A,acc,anim,m,norm,plen,sg" sem="ev:posit t:humq r:qual" sem2="ev:posit der:shift r:qual"/>мудрого</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="мудрый" gr="A,gen,norm,pl,plen" sem="ev:posit t:humq r:qual" sem2="ev:posit der:shift r:qual"/>мудрых</w> <w><ana lex="ундура" gr="S,bastard,f,gen,inan,pl" sem="" sem2=""/>Ундур-гэгэна</w>.</se><se> <w><ana lex="этот" gr="APRO,f,nom,norm,sg" sem="r:dem" sem2=""/>Эта</w> <w><ana lex="личность" gr="