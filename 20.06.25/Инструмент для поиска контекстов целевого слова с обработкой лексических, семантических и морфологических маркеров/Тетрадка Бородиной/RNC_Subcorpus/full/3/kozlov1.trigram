" gr="SPRO,nom,norm,pl" sem="" sem2=""/>все</w> <w><ana lex="разойтись" gr="V,act,indic,intr,norm,pf,pl,praet" sem="der:v ca:noncaus t:move d:pref" sem2="der:v d:pref"/><ana lex="расходиться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus t:move d:pref" sem2="ca:noncaus t:move d:pref"/>разошлись</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="свой" gr="APRO,dat,norm,pl" sem="r:poss" sem2="t:social r:poss"/>своим</w> <w><ana lex="угол" gr="S,dat,inan,m,norm,pl" sem="t:form t:space r:concr" sem2="t:space r:concr pc:room pt:part pc:space"/>углам</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="улечься" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus d:pref t:move:body" sem2="ca:noncaus d:pref"/>улегся</w> <w><ana lex="спать" gr="V,act,inf,intr,ipf,norm" sem="d:root" sem2="d:root"/>спать</w>.</se></p>
<p><se><b/><w><b>5</b></w><b>/</b><w><ana lex="xi" gr="bastard" sem="" sem2=""/><b>XI</b></w><b>, </b><w><ana lex="r" gr="bastard" sem="" sem2=""/><b>R</b></w><b/>. <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w> <w><ana lex="облачный" gr="A,n,nom,norm,plen,sg" sem="r:rel der:s" sem2="t:physq r:rel der:s"/>облачное</w>, <w><ana lex="серый" gr="A,n,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>серое</w>; <w><ana lex="небо" gr="S,inan,n,nom,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/><ana lex="небо" gr="S,inan,n,nom,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/>небо</w> <w><ana lex="сплошь" gr="ADV,norm" sem="dt:degr:max der:a" sem2=""/>сплошь</w> <w><ana lex="укрыть" gr="V,brev,n,norm,partcp,pass,pf,praet,sg" sem="d:pref" sem2="d:pref"/>укрыто</w> <w><ana lex="снеговой" gr="A,ins,norm,pl,plen" sem="r:rel der:s" sem2=""/>снеговыми</w> <w><ana lex="облако" gr="S,inan,ins,n,norm,pl" sem="qc:stuff r:concr" sem2="qc:stuff pt:qtm top:form r:concr"/>облаками</w>; <w><ana lex="воздух" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>воздух</w> <w><ana lex="холодный" gr="A,m,nom,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодный-холодный</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="чуть" gr="ADV,norm" sem="t:degr:min ev" sem2=""/><ana form="чуть-чуть" lex="чуть-чуть" gr="ADV,norm" sem="der:comp t:quant:min" sem2=""/>чуть-чуть</w> <w><ana lex="дышать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:physiol d:root" sem2="d:root"/>дышит</w> <w><ana lex="северный" gr="A,ins,n,norm,plen,sg" sem="t:place dt:space r:rel der:s" sem2=""/>северным</w> <w><ana lex="движение" gr="S,inan,ins,n,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="t:move r:abstr t:behav"/>движением</w>.</se></p>
<p><se><w><ana lex="что" gr="SPRO,inan,n,nom,norm,sg" sem="r:rel" sem2=""/><ana form="Что-то" lex="что-то" gr="SPRO,inan,n,nom,norm,sg" sem="r:indet" sem2=""/>Что-то</w> <w><ana lex="принести" gr="V,3p,act,fut,indic,norm,pf,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus ca:0 d:pref"/>принесет</w> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w> <w><ana lex="сегодняшний" gr="A,acc,inan,m,norm,plen,sg" sem="dt:time r:rel der:adv" sem2=""/>сегодняшний</w> <w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w>?</se><se> <w>Хорошо</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="ответ" gr="S,gen,inan,m,norm,sg" sem="t:speech r:abstr" sem2="t:text r:concr r:abstr t:speech pc:text pt:addit"/>ответа</w> <w>нет</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="долго" gr="ADV,norm" sem="t:time:dur:max dt:time:dur:max der:a" sem2=""/>долго</w> -- <w>по-моему</w>, <w><ana lex="это" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>это</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="лучший" gr="A,dat,n,norm,sg,supr" sem="d:super ev:posit der:a t:quality r:qual" sem2=""/>лучшему</w>!</se><se> <w>Говорят</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="письмецо" gr="S,gen,inan,n,norm,sg" sem="d:dim r:concr t:text der:s" sem2=""/>письмеца</w> <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>сегодня</w> <w><ana lex="принести" gr="V,3p,act,fut,indic,norm,pf,pl" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus ca:0 d:pref"/>принесут</w> <w><ana lex="член" gr="S,dat,inan,m,norm,pl" sem="" sem2="pc:hum pc:animal pt:set t:word pc:x pt:part pt:partb r:concr"/><ana lex="член" gr="S,anim,dat,m,norm,pl" sem="t:hum r:concr" sem2=""/>членам</w> <w><ana lex="экспедиция" g