ии</w>?</se><se> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>И</w> <w><ana lex="быть" gr="V,1p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>буду</w> <w><ana lex="ли" gr="PART,norm" sem="" sem2=""/>ли</w> <w><ana lex="когда" gr="ADVPRO,norm" sem="r:rel t:time" sem2="t:time"/>когда</w>?</se></p>
<p><se><w>Сейчас</w> <w><ana lex="второй" gr="ANUM,f,nom,norm,sg" sem="r:ord der:num r:rel t:ord" sem2="t:hier t:share r:rel der:num"/>вторая</w> <w><ana lex="половина" gr="S,f,inan,nom,norm,sg" sem="t:share r:concr r:abstr pt:part pc:x" sem2="pc:constr:build r:abstr pc:room pt:part pc:group t:hum:kin ev r:concr"/><ana lex="половина" gr="S,anim,f,nom,norm,sg" sem="" sem2=""/>половина</w> <w><ana lex="январь" gr="S,gen,inan,m,norm,sg" sem="t:time:month r:abstr" sem2=""/><ana lex="январь" gr="S,anim,gen,m,norm,persn,sg" sem="" sem2=""/>января</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="там" gr="ADVPRO,norm" sem="t:place r:dem" sem2=""/>там</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="февраль" gr="S,inan,m,nom,norm,sg" sem="t:time:month r:abstr" sem2=""/>февраль</w>, <w><ana lex="солнце" gr="S,inan,n,nom,norm,sg" sem="top:horiz top:spher t:astr t:space r:concr" sem2="ev:posit t:space r:concr r:abstr t:light"/>солнце</w> <w><ana lex="высокий" gr="A,comp,norm,plen" sem="t:size:max r:qual" sem2="ev:posit der:shift t:size:max t:sound t:degr:max r:qual t:interpretation"/>выше</w>, <w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w> <w><ana lex="долгий" gr="A,comp,norm,plen" sem="t:time:dur:max r:qual" sem2="t:size:max r:qual"/>дольше</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="март" gr="S,inan,loc,m,norm,sg" sem="t:time:month r:abstr" sem2=""/><ana lex="март" gr="S,anim,loc,m,norm,persn,sg" sem="" sem2=""/>марте</w> <w><ana lex="полететь" gr="V,3p,act,fut,indic,intr,norm,pf,pl" sem="ca:noncaus t:move d:pref" sem2="ca:noncaus t:move d:pref"/>полетят</w> <w><ana lex="птица" gr="S,anim,f,nom,norm,pl" sem="t:animal r:concr hi:class" sem2=""/>птицы</w>.</se><se> <w><ana lex="если" gr="CONJ,norm" sem="" sem2=""/>Если</w> <w><ana lex="бы" gr="PART,norm" sem="" sem2=""/>б