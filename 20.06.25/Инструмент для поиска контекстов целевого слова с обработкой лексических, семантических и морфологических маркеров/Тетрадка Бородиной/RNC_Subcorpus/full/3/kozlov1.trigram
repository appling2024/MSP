<p><se><w><ana lex="убугунов" gr="S,anim,bastard,famn,m,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Убугунов</w> <w><ana lex="направиться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2="ca:noncaus d:pref"/>направился</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="представительство" gr="S,acc,inan,n,norm,sg" sem="der:v r:abstr der:s0" sem2="der:v r:concr t:org r:abstr"/>Представительство</w> <w><ana lex="похлопотать" gr="V,act,inf,intr,norm,pf" sem="d:pref" sem2=""/>похлопотать</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="вопрос" gr="S,inan,ins,m,norm,sg" sem="t:speech r:abstr" sem2="t:ment r:abstr"/>вопросом</w> <w><ana lex="об" gr="PR,norm" sem="" sem2=""/>об</w> <w><ana lex="отъезжающая" gr="S,anim,f,loc,norm,pl" sem="" sem2=""/>отъезжающих</w>.</se> </p>
<p><se><w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>Я</w> <w><ana lex="отправить" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:caus t:move d:pref" sem2="d:pref"/>отправил</w> <w><ana lex="телеграмма" gr="S,acc,f,inan,norm,sg" sem="der:comp r:concr t:text" sem2=""/>телеграмму</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="москва" gr="S,acc,f,inan,norm,sg" sem="r:propn t:topon" sem2="r:propn t:topon"/>Москву</w> <w><ana lex="следующий" gr="A,gen,n,norm,plen,sg" sem="der:v r:rel dt:move t:ord" sem2="der:v r:rel dt:move t:ord"/>следующего</w> <w><ana lex="содержание" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0" sem2="pt:set t:text r:abstr t:poss der:v pt:aggr sc:money pt:part pc:text r:concr"/>содержания</w>: «<w><ana lex="москва" gr="S,f,inan,nom,norm,sg" sem="r:propn t:topon" sem2="r:propn t:topon"/>Москва</w>.</se><se> <w><ana lex="совнарком" gr="S,inan,m,nom,norm,sg" sem="der:comp der:abbr r:concr t:org" sem2=""/>Совнарком</w>.</se><se> <w><ana lex="управдел" gr="S,anim,ins,m,norm,pl" sem="t:hum r:concr" sem2=""/><ana lex="управделами" gr="S,0,anim,norm" sem="" sem2=""/>Управделами</w> <w><ana lex="горбунов" gr="S,anim,dat,famn,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Горбунову</w>.</se><se> <w><ana lex="экспедиция" gr="S,f,inan,nom,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>Экспедиция</w> <w><ana lex="лишиться" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="ca:noncaus t:poss" sem2=""/>лишилась</w><sup><w><ana lex="4" gr="NUM,ciph"/>4</w></sup> <w><ana lex="три" gr="NUM,acc,anim,norm" sem="r:card:pauc" sem2=""/>трех</w> <w><ana lex="незаменимый" gr="A,gen,norm,pl,plen" sem="der:v d:neg d:impot r:rel" sem2=""/>незаменимых</w> <w><ana lex="участник" gr="S,anim,gen,m,norm,pl" sem="der:v t:hum r:concr d:nag" sem2=""/>участников</w>: <w><ana lex="глаголева" gr="S,anim,f,famn,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Глаголева</w>, <w><ana lex="сар