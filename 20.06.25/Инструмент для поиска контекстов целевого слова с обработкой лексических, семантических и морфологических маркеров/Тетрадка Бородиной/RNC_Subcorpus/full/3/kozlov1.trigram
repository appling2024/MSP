praes,sg" sem="ca:noncaus t:perc" sem2=""/>Любуешься</w> <w><ana lex="темно" gr="ADV,norm" sem="dt:physq:color ev der:a" sem2="dt:physq:color der:a ev:neg"/>темно-бурыми</w> <w><ana lex="шершавый" gr="A,ins,norm,pl,plen" sem="r:qual" sem2=""/>шершавыми</w> <w><ana lex="пустынный" gr="A,ins,norm,pl,plen" sem="dt:space r:rel der:s" sem2="dt:space der:shift r:rel der:s r:qual"/>пустынными</w> <w><ana lex="склон" gr="S,inan,ins,m,norm,pl" sem="t:space top:slope der:v top:form pt:part pc:space r:concr" sem2=""/>склонами</w> <w><ana lex="северный" gr="A,gen,norm,pl,plen" sem="t:place dt:space r:rel der:s" sem2=""/>северных</w> <w><ana lex="гора" gr="S,f,gen,inan,norm,pl" sem="top:hill t:space r:concr" sem2="sc:x pt:set t:space t:form r:abstr t:quant:max r:concr"/>гор</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="переводить" gr="V,2p,act,fut,indic,norm,pf,sg,tran" sem="der:v t:move d:pref" sem2=""/><ana lex="переводить" gr="V,2p,act,indic,ipf,norm,praes,sg,tran" sem="der:v t:move d:pref" sem2=""/>переводишь</w> <w><ana lex="взор" gr="S,acc,inan,m,norm,sg" sem="r:abstr" sem2=""/>взор</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="южный" gr="A,nom,norm,pl,plen" sem="t:place dt:space r:rel der:s" sem2=""/>южные</w>, <w><ana lex="укрыть" gr="V,nom,norm,partcp,pass,pf,pl,plen,praet" sem="d:pref" sem2="d:pref"/>укрытые</w> <w><ana lex="снег" gr="S,inan,ins,m,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2=""/>снегом</w>.</se><se> <w><ana lex="там" gr="ADVPRO,norm" sem="t:place r:dem" sem2=""/>Там</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="сям" gr="ADVPRO,norm" sem="r:dem" sem2=""/>сям</w> <w><ana lex="вблизи" gr="PR,norm" sem="" sem2=""/>вблизи</w> <w><ana lex="вы" gr="SPRO,2p,gen,norm,pl" sem="r:pers" sem2=""/>вас</w> <w><ana lex="картинно" gr="ADV,norm" sem="der:a ev:neg" sem2=""/>картинно</w> <w><ana lex="стлаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v ca:noncaus" sem2=""/>стел