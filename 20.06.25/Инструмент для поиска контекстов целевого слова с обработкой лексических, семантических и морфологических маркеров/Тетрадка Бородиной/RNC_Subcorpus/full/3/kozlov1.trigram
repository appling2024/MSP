2=""/>монголом</w>.</se><se> <w><ana lex="во" gr="PR,norm" sem="" sem2=""/>Во</w> <w><ana lex="всякий" gr="APRO,loc,m,norm,sg" sem="r:spec" sem2=""/>всяком</w> <w><ana lex="случай" gr="S,inan,loc,m,norm,sg" sem="pt:qtm r:abstr" sem2="t:time:moment r:abstr"/>случае</w>, <w><ana lex="это" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>это</w> <w><ana lex="необходимый" gr="A,brev,n,norm,sg" sem="der:v d:modal r:qual" sem2=""/>необходимо</w>!</se><se> <w><ana lex="явиться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus" sem2="ca:noncaus t:move"/>Явился</w> <w><ana lex="даниил" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Даниил</w> <w><ana lex="михайлович" gr="S,anim,m,nom,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Михайлович</w> <w><ana lex="убугунов" gr="S,anim,bastard,famn,m,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Убугунов</w>.</se><se> <w><ana lex="мило" gr="ADV,norm" sem="ev:posit dt:humq der:a" sem2="ev:posit dt:humq der:a"/>Мило</w> <w><ana lex="переговорить" gr="V,act,indic,norm,pf,pl,praet" sem="t:speech ca:noncaus der:v d:pref" sem2="t:speech ca:noncaus der:v d:pref"/>переговорили</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="наш" gr="APRO,loc,n,norm,sg" sem="r:poss" sem2=""/>нашем</w> <w><ana lex="положение" gr="S,inan,loc,n,norm,sg" sem="t:space r:abstr" sem2="t:ment pt:set t:text r:abstr t:loc:body t:loc r:concr sc:text"/>положении</w>.</se><se> <w><ana lex="удивляться" gr="V,1p,act,indic,intr,ipf,norm,pl,praes" sem="der:v d:pref" sem2=""/>Удивляемся</w> <w><ana lex="молчание" gr="S,dat,inan,n,norm,sg" sem="t:speech der:v r:abstr" sem2=""/>молчанию</w> <w><ana lex="центр" gr="S,gen,inan,m,norm,sg" sem="t:space r:concr pc:form:geom pt:part" sem2="pc:org t:space pc:hum pc:animal t:org pt:set pt:partb:organ pc:x pt:part sc:cell2 r:concr"/>Центра</w>.</se><se> <w><ana lex="убугунов" gr="S,anim,bastard,famn,m,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Убугунов</w> <w><ana lex="решить" gr="V,act,indic,m,norm,pf,praet,sg" sem="t:ment ca:noncaus" sem2="t:ment ca:noncaus t:psych:volit"/>решил</w> <w><ana lex="предложить" gr="V,act,inf,norm,pf" sem="t:speech ca:noncaus d:pref" sem2="t:speech ca:noncaus d:pref"/>предложить</w> <w><ana lex="себе" gr="SPRO,acc,norm" sem="" sem2=""/>себя</w> <w><ana lex="дежурить" gr="V,act,inf,intr,ipf,norm" sem="" sem2=""/>дежурить</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="он" gr="SPRO,3p,m,nom,norm,sg" sem="r:pers" sem2=""/>он</w> <w><ana lex="первый" gr="ANUM,acc,inan,m,norm,sg" sem="r:ord der:num t:ord r:qual" sem2="ev:posit t:hier t:qual r:qual"/>первый</w> <w><ana lex="раз" gr="S,acc,inan,m,norm,sg" sem="pt:qtm r:abstr" sem2="pt:qtm r:abstr t:card"/>раз</w> <w><ana lex="вступать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v d:pref" sem2=""/>вступает</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="дневной" gr="A,acc,n,norm,plen,sg" sem="dt:abstr dt:time:period r:rel der:s dt:unit" sem2="dt:abstr dt:time:period r:rel der:s dt:unit"/><ana lex="дневный" gr="A,acc,n,norm,plen,sg" sem="dt:abstr dt:time r:rel der:s t:time" sem2=""/>дневное</w>, <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="весь" gr="APRO,acc,inan,m,norm,sg" sem="r:spec" sem2=""/>весь</w> <w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день-деньской</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="утро" gr="S,gen,inan,n,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утра</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="вечер" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>вечера</w>.</se><se> <w><ana lex="быть" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>Был</w> <w><ana lex="галсан" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Галсан</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="он" gr="SPRO,3p,ins,m,norm,sg" sem="r:pers" sem2=""/>ним</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="выбирать" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="der:v ca:caus d:pref" sem2=""/>выбирали</w> <w><ana lex="подарок" gr="S,acc,inan,m,norm,pl" sem="der:v t:thing r:concr" sem2="t:thing ev:posit r:concr r:abstr"/>подарки</w> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="три" gr="NUM,gen,norm" sem="r:card:pauc" sem2=""/>трех</w> <w><ana lex="местный" gr="A,gen,norm,pl,plen" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s"/>местных</w> <w><ana lex="тибетец" gr="S,anim,gen,m,norm,pl" sem="" sem2=""/>тибетцев</w>: <w><ana lex="дониро" gr="S,bastard,inan,n,nom,pl" sem="" sem2=""/>донира</w>, <w><ana lex="кончун" gr="S,bastard,inan,m,nom,sg" sem="" sem2=""/>кончун-сойбона</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="называть" gr="V,gen,ipf,m,norm,partcp,pass,plen,praes,sg,tran" sem="t:speech der:v d:pref d:impf" sem2=""/>называемого</w> <w><ana lex="3" gr="NUM,ciph"/>3</w>-<w>го</w>.</se></p>
<p><se><w><ana lex="около" gr="PR,norm" sem="" sem2=""/>Около</w> <w><ana lex="3" gr="NUM,ciph"/>3</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w> <w><ana lex="объявиться" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="ca:noncaus d:pref" sem2=""/>объявилась</w> <w><ana lex="ко" gr="PR,norm" sem="" sem2=""/>ко</w> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="визит" gr="S,inan,ins,m,norm,sg" sem="t:action r:abstr" sem2=""/>визитом</w> <w><ana lex="интересный" gr="A,f,nom,norm,plen,sg" sem="dt:abstr der:s dt:ment r:qual" sem2="dt:abstr ev:posit der:s dt:ment r:qual"/>интересная</w> <w><ana lex="чета" gr="S,f,inan,nom,norm,sg" sem="pt:set sc:x r:abstr t:numcoll" sem2="pt:set sc:hum:kin r:concr"/>чета</w> (<w><ana lex="княжеский" gr="A,f,nom,norm,plen,sg" sem="r:rel der:s dt:hum" sem2=""/>княжеская</w>), <w><ana lex="сам" gr="APRO,m,nom,norm,sg" sem="r:spec" sem2=""/>сам</w> <w><ana lex="молодец" gr="S,anim,m,nom,norm,sg" sem="t:hum ev:posit r:concr der:a" sem2="t:hum ev:posit r:concr"/><ana lex="молодец" gr="S,anim,m,nom,norm,sg" sem="t:hum ev:posit r:concr der:a" sem2="t:hum ev:posit r:concr"/>молодец</w>, <w><ana lex="симпатичный" gr="A,f,nom,norm,plen,sg" sem="ev:posit t:appearance der:s dt:hum r:qual" sem2=""/>симпатичная</w> <w><ana lex="княгиня" gr="S,anim,f,nom,norm,sg" sem="t:hum d:fem r:concr der:s" sem2=""/>княгиня</w>, <w><ana lex="убрать" gr="V,f,nom,norm,partcp,pass,pf,plen,praet,sg" sem="ca:caus t:move d:pref" sem2="d:pref"/>убранная</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="золото" gr="S,acc,inan,n,norm,sg" sem="t:stuff r:concr" sem2="sc:workart sc:thing t:stuff sc:money:banknote sc:money pt:aggr r:concr"/>золото</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="драгоценный" gr="A,acc,inan,norm,pl,plen" sem="der:comp r:qual" sem2="der: