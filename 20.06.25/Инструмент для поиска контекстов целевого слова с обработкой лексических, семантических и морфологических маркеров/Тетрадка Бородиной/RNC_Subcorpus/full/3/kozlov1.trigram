<p><se><b/><w><b>9</b></w><b>/</b><w><ana lex="i" gr="bastard" sem="" sem2=""/><b>I</b></w><b>, </b><w><ana lex="s" gr="bastard" sem="" sem2=""/><b>S</b></w><b/>. <w><ana lex="серый" gr="A,n,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>Серое</w>, <w><ana lex="скоро" gr="ADV,comp,norm" sem="dt:speed:max der:a t:time" sem2="dt:speed:max der:a t:time"/>скорее</w> <w><ana lex="ясный" gr="A,n,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясное</w> <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утро</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="сильный" gr="A,ins,m,norm,plen,sg" sem="t:physq d:habit r:qual" sem2="ev:posit t:humq:char der:s t:degr:max r:qual r:rel"/>сильным</w> <w>северо-северо-западным</w> <w><ana lex="ветер" gr="S,inan,ins,m,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>ветром</w>.</se><se> <w><ana lex="несмотря" gr="ADV,norm" sem="der:v" sem2=""/>Несмотря</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="низкий" gr="A,acc,f,norm,plen,sg" sem="t:size:min r:qual" sem2="t:humq t:hier t:level r:qual t:size:min t:sound ev:neg t:interpretation"/>низкую</w> <w><ana lex="t" gr="bastard" sem="" sem2=""/>t</w> <w><ana lex="воздух" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>воздуха</w> (-<w><ana lex="16.7" gr="NUM,ciph"/>16.7</w>°<w><ana lex="r" gr="bastard" sem="" sem2=""/>R</w>), <w><ana lex="все" gr="SPRO,inan,n,nom,norm,sg" sem="" sem2=""/>все</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w> <w><ana lex="крайне" gr="ADV,norm" sem="dt:dist dt:ord t:degr:max der:a" sem2=""/>крайне</w> <w>холодно</w>.</se><se> <w><ana lex="экскурсия" gr="S,f,inan,nom,norm,sg" sem="t:action t:move r:abstr" sem2="t:group pt:set r:concr sc:hum"/>Экскурсия</w> <w><ana lex="мой" gr="APRO,gen,norm,pl" sem="r:po