<p><se><w><ana lex="долина" gr="S,anim,f,famn,nom,norm,sg" sem="" sem2=""/><ana lex="долина" gr="S,f,inan,nom,norm,sg" sem="t:space r:concr der:s t:fam" sem2=""/>Долина</w> <w><ana lex="тола" gr="S,f,gen,inan,norm,sg" sem="" sem2=""/>Толы</w> <w><ana lex="между" gr="PR,norm" sem="" sem2=""/>между</w> <w><ana lex="город" gr="S,inan,ins,m,norm,sg" sem="sc:constr:build t:space r:concr" sem2="t:space r:concr"/>городом</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="священный" gr="A,ins,m,norm,plen,sg" sem="ev r:rel" sem2="r:rel"/>священным</w> <w><ana lex="массив" gr="S,inan,ins,m,norm,sg" sem="pt:set t:space r:concr sc:space" sem2="pt:set sc:constr:build t:space r:concr sc:plant"/>массивом</w> <w><ana lex="полный" gr="A,brev,f,norm,sg" sem="t:content r:qual" sem2="t:degr t:appearance r:qual"/>полна</w> <w><ana lex="юрт" gr="S,inan,ins,m,norm,pl" sem="t:space r:concr" sem2=""/>юртами</w> <w><ana lex="обитатель" gr="S,anim,gen,m,norm,pl" sem="der:v t:hum r:concr d:nag dt:be:exist" sem2=""/>обитателей</w>.</se><se> <w><ana lex="все" gr="SPRO,nom,norm,pl" sem="" sem2=""/>Все</w> <w><ana lex="тянуться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v t:changest ca:noncaus" sem2="der:v ca:noncaus t:move"/>тянутся</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="простор" gr="S,acc,inan,m,norm,sg" sem="t:space r:concr" sem2="ev:posit r:abstr"/>простор</w>, <w><ana lex="чистота" gr="S,acc,f,inan,norm,sg" sem="r:abstr der:a" sem2="r:abstr"/>чистоту</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="лучший" gr="A,acc,inan,m,norm,sg,supr" sem="d:super ev:posit der:a t:quality r:qual" sem2=""/>лучший</w> <w><ana lex="воздух" gr="S,acc,inan,m,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>воздух</w>.</se><se> <w><ana lex="то" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>То</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w> <w><ana lex="замечаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus d:pref" sem2=""/>замечается</w> <w>везде</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="горный" gr="A,dat,norm,pl,plen" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s"/>горным</w> <w><ana lex="ущелие" gr="S,dat,inan,n,norm,pl" sem="" sem2=""/>ущельям</w>.</se><se> <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="настроить" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus d:pref t:impact:creat" sem2="der:v ca:caus d:pref t:psych"/>настроили</w> <w><ana lex="сачок" gr="S,inan,m,nom,norm,pl" sem="top:contain t:tool r:concr" sem2=""/>сачки</w>, <w><ana lex="зарядить" gr="V,act,indic,norm,pf,pl,praet" sem="d:pref" sem2="d:pref"/><ana lex="зарядить" gr="V,act,indic,norm,pf,pl,praet,tran" sem="d:pref" sem2="d:pref"/>зарядили</w> <w><ana lex="морилка" gr="S,acc,f,inan,norm,pl" sem="der:v t:stuff r:concr t:liq" sem2="der:v t:stuff r:concr t:liq"/>морилки</w>, <w><ana lex="поймать" gr="V,act,indic,norm,pf,pl,praet,tran" sem="ca:noncaus d:pref t:poss" sem2=""/>поймали</w> <w><ana lex="первый" gr="ANUM,acc,f,norm,sg" sem="r:ord der:num t:ord r:qual" sem2="ev:posit t:hier t:qual r:qual"/>первую</w> <w><ana lex="муха" gr="S,acc,anim,f,norm,sg" sem="t:animal r:concr" sem2=""/>муху</w>!</se><se> <w><ana lex="приготовиться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="der:v ca:noncaus d:pref" sem2=""/>Приготовились</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="дорога" gr="S,acc,f,inan,norm,sg" sem="top:stripe t:space r:concr t:fam" sem2="t:move dt:space r:abstr der:shift t:space r:concr"/>дорогу</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="что" gr="SPRO,inan,n,nom,norm,sg" sem="r:rel" sem2=""/><ana form="что-то" lex="что-то" gr="SPRO,inan,n,nom,norm,sg" sem="r:indet" sem2=""/>что-то</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="объявляться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v d:pref" sem2=""/>объяв