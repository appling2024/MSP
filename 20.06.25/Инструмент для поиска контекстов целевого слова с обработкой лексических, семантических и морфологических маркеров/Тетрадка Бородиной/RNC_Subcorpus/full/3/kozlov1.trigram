<p><se><w>Теперь</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="я" gr="SPRO,1p,gen,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="такой" gr="APRO,f,nom,norm,sg" sem="r:dem" sem2="r:indet r:spec t:degr:max"/>такая</w> <w><ana lex="программа" gr="S,f,inan,nom,norm,sg" sem="t:ment pt:set r:abstr" sem2="pt:set r:concr t:text r:abstr"/>программа</w>: <w><ana lex="прежде" gr="ADV,norm" sem="dt:time der:a t:time" sem2="dt:time der:a t:time"/>прежде</w> <w><ana lex="все" gr="SPRO,gen,inan,n,norm,sg" sem="" sem2=""/>всего</w> <w><ana lex="отправить" gr="V,act,inf,norm,pf" sem="ca:caus t:move d:pref" sem2="d:pref"/>отправить</w> <w><ana lex="елена" gr="S,acc,anim,f,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Елену</w> <w><ana lex="петровна" gr="S,acc,anim,f,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Петровну</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="россия" gr="S,acc,f,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Россию</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="самый" gr="APRO,dat,m,norm,sg" sem="r:spec" sem2="r:spec"/><ana lex="сам" gr="APRO,dat,m,norm,sg" sem="r:spec" sem2=""/>самому</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="два" gr="NUM,ins,norm" sem="r:card:pauc" sem2=""/>двумя</w> <w><ana lex="спутник" gr="S,anim,ins,m,norm,pl" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,inan,ins,m,norm,pl" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутниками</w> <w><ana lex="отправиться" gr="V,act,inf,intr,norm,pf" sem="ca:noncaus t:move d:pref" sem2=""/>отправиться</w> <w><ana lex="опять" gr="ADV,norm" sem="" sem2=""/>опять</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="мандала" gr="S,f,gen,inan,norm,pl" sem="r:concr t:text t:workart" sem2=""/>Мандал</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="суга" gr="S,acc,bastard,f,inan,sg" sem="" sem2=""/>Сугу-нур</w>.</se><se> <w