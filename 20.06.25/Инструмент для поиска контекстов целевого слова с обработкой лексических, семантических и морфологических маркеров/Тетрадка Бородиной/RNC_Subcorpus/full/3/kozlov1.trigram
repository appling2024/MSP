азнообразиться" gr="V,act,bastard,indic,intr,ipf,n,praet,sg" sem="" sem2=""/>поразнообразилось</w>!</se><se> «<w><ana lex="со" gr="PR,norm" sem="" sem2=""/>Со</w> <w><ana lex="снимок" gr="S,inan,ins,m,norm,pl" sem="der:v r:concr t:workart" sem2=""/>снимками</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="рука" gr="S,f,inan,loc,norm,pl" sem="pt:partb r:concr pc:hum" sem2="sc:hum t:asp r:abstr pt:aggr:aggrpl t:dir r:concr"/>руках</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="пустить" gr="V,1p,act,fut,indic,norm,pf,sg" sem="ca:caus t:move d:root" sem2="ca:caus t:move d:root"/>пущу</w> <w><ana lex="интересный" gr="A,acc,f,norm,plen,sg" sem="dt:abstr der:s dt:ment r:qual" sem2="dt:abstr ev:posit der:s dt:ment r:qual"/>интересную</w> <w><ana lex="весть" gr="S,acc,f,inan,norm,sg" sem="t:speech r:abstr" sem2=""/>весть</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="мы" gr="SPRO,1p,acc,norm,pl" sem="r:pers" sem2=""/>нас</w> <w><ana lex="оба" gr="NUM,acc,anim,m,norm" sem="r:card:pauc" sem2=""/>обоих</w>, <w>право</w>, <w><ana lex="мой" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>мой</w> <w><ana lex="друг" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr" sem2="t:hum r:concr"/>друг</w> <w><ana lex="петр" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Петр</w> <w><ana lex="кузьмич" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum t:patrn r:propn der:s t:famn" sem2=""/><ana lex="кузьмич" gr="S,anim,m,nom,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s t:famn" sem2=""/>Кузьмич</w>», -- <w><ana lex="сказать" gr="V,act,indic,m,norm,pf,praet,sg,tran" sem="t:speech ca:noncaus" sem2=""/>сказал</w> <w>С</w>. <w>Л</w>. <w><ana lex="гедин" gr="S,anim,famn,m,nom,norm,sg" sem="" sem2=""/>Гедин</w>.</se></p>
<p><se><w><ana lex="такой" gr="APRO,ins,m,norm,sg" sem="r:dem" sem2="r:indet r:spec t:degr:max"/>Таким</w> <w><ana lex="образ" gr="S,inan,ins,m,norm,sg" sem="t:ment r:concr r:abstr t:workart" sem2="t:asp r:abstr"/>образом</w>, <w><ana lex="все" gr="SPRO,inan,n,nom,norm,sg" sem="" sem2=""/>все</w> <w><ana lex="мой" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/>моя</w> <w><ana lex="тибетский" gr="A,f,nom,norm,plen,sg" sem="dt:topon r:rel der:s t:topon" sem2=""/>Тибетская</w> <w><ana lex="экспедиция" gr="S,f,inan,nom,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиция</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="скоро" gr="ADV,norm" sem="dt:speed:max der:a t:time" sem2="dt:speed:max der:a t:time"/>скоро</w> <w><ana lex="освоиться" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v ca:noncaus d:pref" sem2=""/>освоилась</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="мой" gr="APRO,ins,m,norm,sg" sem="r:poss" sem2=""/>моим</w> <w><ana lex="друг" gr="S,anim,ins,m,norm,sg" sem="t:hum r:concr" sem2="t:hum r:concr"/>другом</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="стать" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="aux:phase d:root t:move:body" sem2="ca:noncaus t:move d:root t:loc"/>стала</w> <w><ana lex="считать" gr="V,act,inf,norm,pf" sem="der:v d:pref" sem2="der:v t:ment d:pref ca:noncaus"/><ana lex="считать" gr="V,act,inf,ipf,norm,tran" sem="der:v d:pref" sem2="der:v t:ment d:pref ca:noncaus"/><ana lex="считать" gr="V,act,inf,norm,pf,tran" sem="der:v d:pref" sem2="der:v t:ment d:pref ca:noncaus"/><ana lex="считать" gr="V,act,inf,ipf,norm,tran" sem="der:v d:pref" sem2="der:v t:ment d:pref ca:noncaus"/>считать</w> <w><ana lex="он" gr="SPRO,3p,acc,m,norm,sg" sem="r:pers" sem2=""/>его</w> <w><ana lex="наш" gr="APRO,ins,m,norm,sg" sem="r:poss" sem2=""/>нашим</w> <w><ana lex="друг" gr="S,anim,ins,m,norm,sg" sem="t:hum r:concr" sem2="t:hum r:concr"/>другом-гостем</w>.</se><se> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>За</w> <w><ana lex="исключение" gr="S,inan,ins,n,norm,sg" sem="t:put der:v r:abstr der:s0" sem2="r:abstr"/>исключением</w> <w><ana lex="двое" gr="NUM,gen,norm" sem="r:coll:pauc" sem2=""/>двоих</w>, <w><ana lex="симукова" gr="S,anim,bastard,f,famn,nom,sg" sem="t:hum r:propn t:famn" sem2=""/><ana lex="симукова" gr="S,anim,bastard,f,famn,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Симукова</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="канаева" gr="S,anim,f,famn,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Канаева</w>, <w><ana lex="весь" gr="APRO,nom,norm,pl" sem="r:spec" sem2=""/>все</w> <w><ana lex="мой" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>мои</w> <w><ana lex="спутник" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,inan,m,nom,norm,pl" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутники</w> <w><ana lex="видеть" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="ca:noncaus t:perc d:root" sem2="t:ment ca:noncaus d:root"/>видели</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="знать" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/>знают</w> <w>С</w>. <w>Л</w>. <w><ana lex="гедин" gr="S,anim,famn,gen,m,norm,sg" sem="" sem2=""/>Гедина</w>.</se><se> <w><ana lex="завтра" gr="ADV,norm" sem="t:time" sem2=""/>Завтра</w> <w><ana lex="он" gr="SPRO,3p,m,nom,norm,sg" sem="r:pers" sem2=""/>он</w> <w><ana lex="быть" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>будет</w> <w><ana lex="также" gr="PART,norm" sem="" sem2=""/>также</w> <w><ana lex="наш" gr="APRO,ins,m,norm,sg" sem="r:poss" sem2=""/>нашим</w> <w><ana lex="гость" gr="S,anim,ins,m,norm,sg" sem="t:hum r:concr" sem2="t:hum der:shift r:concr"/>гостем</w>.</se></p>
<p><se><w><ana lex="вечер" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечер</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="весь" gr="APRO,f,ins,norm,sg" sem="r:spec" sem2=""/>всей</w> <w><ana lex="компания" gr="S,f,inan,ins,norm,sg" sem="t:group pt:set r:concr sc:hum" sem2="r:concr t:org"/>компанией</w> (<w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="бадмажапов" gr="S,anim,bastard,famn,m,nom,pl" sem="t:hum r:propn t:famn" sem2=""/>Бадмажаповы</w>) <w><ana lex="провести" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="провести" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="проводить" gr="V,act,indic,norm,pf,pl,praet" sem="ca:caus t:move d:pref" sem2="d:pref"/>провели</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="наш" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/>наших</w> <w><ana lex="знакомый" gr="S,anim,gen,m,norm,pl" sem="der:v t:hum r:concr der:subst" sem2=""/>знакомых</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="дорога" gr="S,dat,f,inan,norm,sg" sem="top:stripe t:space r:concr t:fam" sem2="t:move dt:space r:abstr der:shift t:space r:concr"/>дороге</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="урга" gr="S,acc,f,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Ургу</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="здесь" gr="ADVPRO,norm" sem="t:place r:dem" sem2="t:time r:dem"/>здесь</w>, <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="заведовать" gr="V,act,gen,intr,ipf,m,norm,partcp,plen,praes,sg" sem="der:v d:pref" sem2=""/>заведующего</w> <w><ana lex="монгольский" gr="A,f,ins,norm,plen,sg" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>монгольской</w> <w><ana lex="аптека" gr="S,f,inan,ins,norm,sg" sem="r:concr t:org" sem2="pt:set sc:stuff r:concr"/>аптекой</w> <w>Е</w>. <w>Ч</w>.</se></p>
<p><se><b/><w><b>22</b></w><b>/</b><w><ana lex="xi" gr="bastard" sem="" sem2=""/><b>XI</b></w><b>, </b><w><ana lex="v" gr="bastard" sem="" sem2=""/><b>V</b></w><b/>. <w><ana lex="погода" gr="S,f,inan,nom,norm,sg" sem="r:abstr t:weather" sem2=""/>Погода</w> <w><ana lex="серый" gr="A,f,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>серая</w>, <w><ana lex="кругом" gr="ADV,norm" sem="t:place der:s" sem2="der:s"/>кругом</w> <w><ana lex="значительный" gr="A,f,ins,norm,plen,sg" sem="t:quant:max der:v t:degr:max r:qual" sem2="der:v r:rel d:habit"/>значительной</w> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="здешний" gr="A,gen,norm,pl,plen" sem="t:place r:rel der:adv" sem2=""/>здешних</w> <w><ana lex="место" gr="S,gen,inan,n,norm,pl" sem="qc:space t:space r:concr" sem2="qc:space sc:org t:tool t:space pt:element r:abstr pt:aggr:aggrpl pt:part pc:text r:concr"/>мест</w> <w><ana lex="толща" gr="S,f,inan,ins,norm,sg" sem="qc:stuff pt:qtm t:form r:concr der:a" sem2=""/>толщей</w> <w><ana lex="залегать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v d:pref" sem2=""/>залегает</w> <w><ana lex="снег" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2=""/>снег</w>!</se><se> <w><ana lex="этот" gr="APRO,m,nom,norm,sg" sem="r:dem" sem2=""/>Этот</w> <w><ana lex="осадок" gr="S,inan,m,nom,norm,sg" sem="der:v t:stuff r:concr" sem2="r:abstr"/>осадок</w> <w><ana lex="продолжать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="aux:phase d:pref der:a" sem2=""/>продолжает</w> <w><ana lex="падать" gr="V,act,inf,intr,ipf,norm" sem="ca:noncaus t:move d:root" sem2="d:root"/>падать</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="день" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>днем</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="самый" gr="APRO,f,loc,norm,sg" sem="r:spec" se