<p><se><b/><w><b>29</b></w><b>/</b><w><ana lex="vii" gr="bastard" sem="" sem2=""/><b>VII</b></w><b>.</b></se><se> <w><ana lex="говорить" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="t:speech ca:noncaus d:root" sem2="d:root"/>Говорят</w> (<w><ana lex="окрестность" gr="S,f,inan,nom,norm,sg" sem="der:a t:space r:concr sc:space pc:space" sem2=""/>окрестность</w> <w><ana lex="вятка" gr="S,anim,f,gen,norm,sg" sem="" sem2=""/><ana lex="вятка" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2="r:propn t:topon"/>Вятки</w>), <w><ana lex="здесь" gr="ADVPRO,norm" sem="t:place r:dem" sem2="t:time r:dem"/>здесь</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w>жарко</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="сибирь" gr="S,f,inan,loc,norm,sg" sem="r:propn t:topon" sem2=""/>Сибири</w> <w><ana lex="также" gr="PART,norm" sem="" sem2=""/>также</w> <w>жарко</w>.</se></p>
