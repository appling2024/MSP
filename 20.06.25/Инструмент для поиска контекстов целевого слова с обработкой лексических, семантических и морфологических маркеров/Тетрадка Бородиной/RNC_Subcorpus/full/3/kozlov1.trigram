<p><se><w><ana lex="праздничный" gr="A,m,nom,norm,plen,sg" sem="dt:abstr ev r:rel der:s dt:action" sem2=""/>Праздничный</w> <w><ana lex="день" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w> <w><ana lex="однообразный" gr="A,brev,m,norm,sg" sem="" sem2=""/>однообразен</w>, <w><ana lex="монотонный" gr="A,brev,m,norm,sg" sem="der:comp ev:neg t:sound r:qual" sem2=""/>монотонен</w>.</se><se> <w><ana lex="бездействие" gr="S,inan,n,nom,norm,sg" sem="r:abstr" sem2=""/>Бездействие</w> <w><ana lex="совершенно" gr="ADV,norm" sem="dt:degr:max t:degr:max der:a" sem2=""/>совершенно</w> <w><ana lex="надоесть" gr="V,act,indic,intr,n,norm,pf,praet,sg" sem="der:v d:pref" sem2=""/>надоело</w>.</se><se> <w><ana lex="никто" gr="SPRO,anim,m,nom,norm,sg" sem="r:neg" sem2=""/>Никто</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="мочь" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="d:root" sem2=""/>может</w> <w><ana lex="спокойно" gr="ADV,norm" sem="ev:posit dt:quality der:a" sem2=""/>спокойно</w> <w><ana lex="делать" gr="V,act,inf,ipf,norm,tran" sem="d:root" sem2="d:root"/>делать</w> <w><ana lex="даже" gr="PART,norm" sem="" sem2=""/>даже</w> <w><ana lex="самый" gr="APRO,n,nom,norm,sg" sem="r:spec" sem2="r:spec"/>самое</w> <w><ana lex="интересный" gr="A,n,nom,norm,plen,sg" sem="dt:abstr der:s dt:ment r:qual" sem2="dt:abstr ev:posit der:s dt:ment r:qual"/>интересное</w> <w><ana lex="дело" gr="S,inan,n,nom,norm,sg" sem="r:abstr" sem2="sc:doc ev:posit r:abstr t:org der:v r:concr"/>дело</w>.</se><se> <w><ana lex="жизнь" gr="S,f,inan,nom,norm,sg" sem="t:be:exist r:abstr" sem2="t:be:exist r:abstr t:time"/>Жизнь</w> <w><ana lex="стать" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="aux:phase d:root t:move:body" sem2="ca:noncaus t:move d:root t:loc"/>стала</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="однообразный" gr="A,brev,f,norm,sg" sem="" sem2=""/>однообразна</w