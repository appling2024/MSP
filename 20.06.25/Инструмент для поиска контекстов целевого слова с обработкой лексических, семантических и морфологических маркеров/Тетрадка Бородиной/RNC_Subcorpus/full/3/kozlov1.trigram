<p><se><w>Кстати</w>, <w><ana lex="когда" gr="CONJ,norm" sem="" sem2=""/>когда</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="смотреть" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="ca:noncaus d:pref t:perc" sem2="ca:noncaus d:pref t:perc"/>смотрю</w> <w>теперь</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="небо" gr="S,acc,inan,n,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/><ana lex="небо" gr="S,acc,inan,n,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/>небо</w> -- <w><ana lex="невольно" gr="ADV,norm" sem="der:a" sem2=""/>невольно</w> <w><ana lex="вспоминать" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="der:v d:pref" sem2="der:v d:pref"/>вспоминаю</w> <w><ana lex="первый" gr="ANUM,acc,f,norm,sg" sem="r:ord der:num t:ord r:qual" sem2="ev:posit t:hier t:qual r:qual"/>первую</w> <w><ana lex="страница" gr="S,acc,f,inan,norm,sg" sem="qc:text pt:qtm r:concr pt:part" sem2="pt:phase t:time:period r:abstr"/>страницу</w> <w><ana lex="мой" gr="APRO,f,gen,norm,sg" sem="r:poss" sem2=""/>моей</w> <w><ana lex="последний" gr="A,f,gen,norm,plen,sg" sem="r:rel t:ord" sem2="t:degr:max:magn r:qual r:rel ev:neg t:time"/>последней</w> <w><ana lex="книга" gr="S,f,gen,inan,norm,sg" sem="t:media r:concr t:text" sem2="pc:text t:book r:concr t:text pt:part"/>книги</w> «<w><ana lex="хара" gr="S,anim,nom,norm,persn,sg" sem="t:hum r:propn t:famn" sem2=""/>Хара-хото</w>», <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="который" gr="APRO,acc,f,norm,sg" sem="r:rel t:ord" sem2=""/>которую</w> (<w><ana lex="страница" gr="S,acc,f,inan,norm,sg" sem="qc:text pt:qtm r:concr pt:part" sem2="pt:phase t:time:period r:abstr"/>страницу</w>) <w><ana lex="я" gr="SPRO,1p,acc,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der