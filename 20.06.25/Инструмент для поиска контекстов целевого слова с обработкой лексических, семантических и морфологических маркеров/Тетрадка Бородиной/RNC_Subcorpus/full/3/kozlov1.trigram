inf,ipf,norm,tran" sem="ca:noncaus t:perc d:root" sem2="t:ment ca:noncaus d:root"/>видеть</w> <w><ana lex="такой" gr="APRO,acc,f,norm,sg" sem="r:dem" sem2="r:indet r:spec t:degr:max"/>такую</w> <w><ana lex="искренний" gr="A,acc,f,norm,plen,sg" sem="r:qual" sem2=""/>искреннюю</w> <w><ana lex="дружба" gr="S,acc,f,inan,norm,sg" sem="der:v r:abstr t:inter" sem2=""/>дружбу</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="свой" gr="APRO,gen,norm,pl" sem="r:poss" sem2="t:social r:poss"/>своих</w> <w><ana lex="родные" gr="S,anim,gen,norm,pl" sem="" sem2=""/>родных</w>.</se><se> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>И</w> <w><ana lex="это" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>это</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="пушкарев" gr="S,anim,famn,gen,m,norm,pl" sem="t:hum r:propn t:famn" sem2=""/>Пушкаревых</w> <w><ana lex="всегда" gr="ADVPRO,norm" sem="r:spec t:time" sem2=""/>всегда</w> <w><ana lex="бывать" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus der:v d:impf" sem2="der:v t:loc der:shift d:impf ca:noncaus"/>бывало</w>, <w><ana lex="это" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>это</w> <w><ana lex="прелестный" gr="A,f,nom,norm,plen,sg" sem="ev:posit der:s dt:hum r:qual" sem2=""/>прелестная</w> <w><ana lex="черта" gr="S,f,inan,nom,norm,sg" sem="t:form top:line r:concr" sem2="t:space r:concr r:abstr"/>черта</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="они" gr="SPRO,3p,gen,norm,pl" sem="r:pers" sem2=""/>них</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="кровь" gr="S,f,inan,nom,norm,pl" sem="t:stuff r:concr t:liq" sem2="der:shift r:concr pt:aggr sc:animal"/><ana lex="кровь" gr="S,f,gen,inan,norm,sg" sem="t:stuff r:concr t:liq" sem2="der:shift r:concr pt:aggr sc:animal"/><ana lex="кровь" gr="S,dat,f,inan,norm,sg" sem="t:stuff r:concr t:liq" sem2="der:shift r:concr pt:aggr sc:animal"/><ana lex="кровь" gr="S,acc,f,inan,norm,pl" sem="t:stuff r:concr t:liq" sem2="der:shift r:concr pt:aggr sc:animal"/><ana lex="кровь" gr="S,f,inan,loc,norm,sg" sem="t:stuff r:concr t:liq" sem2="der:shift r:concr pt:aggr sc:animal"/>крови</w>.</se><se> <w><ana lex="мой" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>Мой</w> <w><ana lex="пшевик" gr="S,anim,bastard,m,nom,sg" sem="" sem2=""/>Пшевик</w> <w><ana lex="приуныть" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus d:pref t:psych:emot" sem2=""/>приуныл</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="тянуться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v t:changest ca:noncaus" sem2="der:v ca:noncaus t:move"/>тянется</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="харбин" gr="S,acc,inan,m,norm,sg" sem="r:propn t:topon" sem2=""/>Харбин</w>.</se><se> <w>Кстати</w>, <w><ana lex="подходящий" gr="A,m,nom,norm,plen,sg" sem="der:v r:rel dt:move" sem2=""/>подходящий</w> <w><ana lex="случай" gr="S,inan,m,nom,norm,sg" sem="pt:qtm r:abstr" sem2="t:time:moment r:abstr"/>случай</w> -- <w><ana lex="бадмажапыч" gr="S,anim,bastard,m,nom,patrn,sg" sem="" sem2=""/>Бадмажапыч</w> <w><ana lex="ехать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:move d:root" sem2="d:root"/>едет</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="тяньцзин" gr="S,acc,bastard,inan,m,sg" sem="" sem2=""/>Тяньцзин</w>, <w>значит</w>, <w><ana lex="находиться" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="ca:noncaus t:move d:pref" sem2="t:loc d:pref ca:noncaus"/><ana lex="находиться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:move d:pref" sem2="t:loc d:pref ca:noncaus"/><ana lex="находиться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:move d:pref" sem2="t:loc d:pref ca:noncaus"/>находится</w> <w><ana lex="лучший" gr="A,m,nom,norm,sg,supr" sem="d:super ev:posit der:a t:quality r:qual" sem2=""/>лучший</w> <w><ana lex="попутчик" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr der:s" sem2="t:hum