<p><se><w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="1" gr="NUM,ciph"/>1</w>/<w><ana lex="4" gr="NUM,ciph"/>4</w> <w><ana lex="11" gr="NUM,ciph"/>11</w>-<w>го</w>, <w><ana lex="вечер" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>вечером</w>, <w><ana lex="явиться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus" sem2="ca:noncaus t:move"/>явились</w> <w><ana lex="ко" gr="PR,norm" sem="" sem2=""/>ко</w> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w> «<w><ana lex="елена" gr="S,anim,f,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Елена</w> <w><ana lex="прекрасный" gr="A,f,nom,norm,plen,sg" sem="ev:posit t:appearance r:qual" sem2="ev:posit t:quality r:qual"/>Прекрасная</w>» <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="заявление" gr="S,inan,ins,n,norm,sg" sem="t:speech der:v r:concr r:abstr t:text" sem2="der:v r:concr t:text"/>заявлением</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="ее" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,n,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,f,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,m,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,n,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,f,gen,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,n,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,f,gen,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,m,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,n,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,f,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,m,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr