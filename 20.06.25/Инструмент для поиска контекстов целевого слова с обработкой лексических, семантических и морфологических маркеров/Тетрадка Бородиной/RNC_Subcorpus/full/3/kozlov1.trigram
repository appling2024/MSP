<p><se><w><ana lex="вечер" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечером</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="немножечко" gr="ADV,norm" sem="t:degr:min d:dim ev der:adv" sem2="d:dim ev t:time:dur:min t:quant:min der:adv"/>немножечко</w> <w><ana lex="развернуться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref"/>развернулись</w>: <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="случай" gr="S,dat,inan,m,norm,sg" sem="pt:qtm r:abstr" sem2="t:time:moment r:abstr"/>случаю</w> <w><ana lex="отъезд" gr="S,gen,inan,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="t:move r:abstr"/>отъезда</w>, <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="случай" gr="S,dat,inan,m,norm,sg" sem="pt:qtm r:abstr" sem2="t:time:moment r:abstr"/>случаю</w> <w><ana lex="избрание" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr" sem2=""/>избрания</w> <w><ana lex="свой" gr="APRO,gen,n,norm,sg" sem="r:poss" sem2="t:social r:poss"/>своего</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="почетный" gr="A,nom,norm,pl,plen" sem="r:rel der:s t:humq:char" sem2="r:rel der:s r:qual"/>почетные</w> <w><ana lex="член" gr="S,inan,m,nom,norm,pl" sem="" sem2="pc:hum pc:animal pt:set t:word pc:x pt:part pt:partb r:concr"/><ana lex="член" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr" sem2=""/>члены</w> <w><ana lex="американский" gr="A,gen,m,norm,plen,sg" sem="dt:topon r:rel der:s t:topon" sem2=""/>Американского</w> <w><ana lex="музей" gr="S,gen,inan,m,norm,sg" sem="r:concr t:org" sem2=""/>музея</w> <w><ana lex="естественный" gr="A,f,gen,norm,plen,sg" sem="r:rel der:s" sem2="r:rel der:s"/>естественной</w> <w><ana lex="история" gr="S,f,gen,inan,norm,sg" sem="r:abstr" sem2="ev:neg r:concr r:abstr t:text"/>истории</w>.</se><se> <w>Ц</w>. <w>Г</w>. <w><ana lex="бадмажап" gr="S,anim,bastard,gen,m,persn,pl" sem="t:hum r:pro