,sg" sem="r:propn t:topon" sem2="r:propn t:topon"/>Москву</w> <w><ana lex="елена" gr="S,anim,f,gen,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Елены</w> <w><ana lex="петровна" gr="S,anim,f,gen,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Петровны</w>.</se><se> <w><ana lex="мочь" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="d:root" sem2=""/>Может</w> <w><ana lex="быть" gr="V,act,inf,intr,ipf,norm" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>быть</w>, <w><ana lex="почему" gr="ADVPRO,norm" sem="der:spro r:rel" sem2=""/><ana form="почему-нибудь" lex="почему-нибудь" gr="ADVPRO,norm" sem="der:advpro r:indet" sem2=""/>почему-нибудь</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="годовщина" gr="S,acc,f,inan,norm,sg" sem="r:abstr t:time" sem2=""/>годовщину</w> <w><ana lex="утверждение" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0" sem2="t:speech r:abstr"/>утверждения</w> <w><ana lex="тибетский" gr="A,f,gen,norm,plen,sg" sem="dt:topon r:rel der:s t:topon" sem2=""/>Тибетской</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="именно" gr="PART,norm" sem="" sem2=""/>именно</w> <w><ana lex="27" gr="NUM,ciph"/>27</w>/<w>II</w>, <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="получить" gr="V,1p,act,fut,indic,norm,pf,sg" sem="ca:noncaus t:poss" sem2=""/>получу</w> <w><ana lex="что" gr="SPRO,acc,inan,n,norm,sg" sem="r:rel" sem2=""/><ana form="что-либо" lex="что-либо" gr="SPRO,acc,inan,n,norm,sg" sem="r:indet" sem2=""/>что-либо</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="николай" gr="S,anim,gen,m,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Николая</w> <w><ana lex="петрович" gr="S,anim,gen,m,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Петровича</w>?</se><