:s r:qual" sem2=""/>слоистым</w> <w><ana lex="облако" gr="S,inan,ins,n,norm,sg" sem="qc:stuff r:concr" sem2="qc:stuff pt:qtm top:form r:concr"/>облаком</w>.</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w>общем</w>, <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>сегодня</w> <w><ana lex="серый" gr="A,m,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>серый</w>, <w><ana lex="тихий" gr="A,m,nom,norm,plen,sg" sem="d:neg t:sound r:qual" sem2="d:neg t:humq t:speed:min der:shift t:sound r:qual"/>тихий</w>, <w><ana lex="настоящий" gr="A,m,nom,norm,plen,sg" sem="r:rel t:time" sem2="ev:posit r:dem t:ver t:degr t:degr:max r:qual r:rel"/>настоящий</w> <w><ana lex="зимний" gr="A,m,nom,norm,plen,sg" sem="dt:time dt:abstr dt:time:season der:s t:time r:rel" sem2=""/>зимний</w> <w><ana lex="день" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w>.</se><se> <w>Хорошо</w>!</se></p>
<p><se><w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> Ѕ<w>10</w>-<w>го</w> <w><ana lex="час" gr="S,gen,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часа</w> <w><ana lex="утро" gr="S,gen,inan,n,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утра</w> <w><ana lex="появиться" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="ca:noncaus d:pref t:be:appear" sem2="ca:noncaus d:pref"/>появилась</w> <w><ana lex="первый" gr="ANUM,f,nom,norm,sg" sem="r:ord der:num t:ord r:qual" sem2="ev:posit t:hier t:qual r:qual"/>первая</w> «<w><ana lex="ласточка" gr="S,anim,f,nom,norm,sg" sem="t:animal r:concr" sem2=""/>ласточка</w>» <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="путь" gr="S,inan,loc,m,norm,sg" sem="top:stripe t:space r:concr" sem2="ev:posit t:space t:asp r:abstr sc:space pt:aggr:aggrpl pt:aggr top:stripe r:concr der:shift"/>пути</w> <w><ana lex="наш" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/>наших</w> (<w><ana lex="таэрша" gr="S,anim,bastard,f,nom,persn,sg" sem="" sem2=""/><ana lex="таэрша" gr="S,anim,bastard,f,nom,sg" sem="" sem2=""/><ana lex="таэрша" gr="S,bastard,f,inan,nom,sg" sem="" sem2=""/><ana lex="таэрша" gr="S,bastard,f,inan,nom,sg" sem="" sem2=""/><ana lex="таэрша" gr="S,bastard,f,inan,nom,sg" sem="" sem2=""/><ana lex="таэрша" gr="S,bastard,f,inan,nom,sg" sem="" sem2=""/><ana lex="таэрша" gr="S,bastard,f,inan,nom,sg" sem="" sem2=""/>Таэрша</w>).</se><se> «<w><ana lex="благополучно" gr="ADV,norm" sem="ev:posit der:a" sem2=""/>Благополучно</w>, <w><ana lex="ехать" gr="V,1p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus t:move d:root" sem2="d:root"/>едем</w> <w><ana lex="далекий" gr="A,comp,norm,plen" sem="t:dist:max r:qual" sem2="dt:dist:max der:shift t:time t:humq r:qual"/>дальше</w>.</se><se> <w><ana lex="козбад" gr="S,anim,bastard,m,nom,persn,sg" sem="" sem2=""/><ana lex="козбад" gr="S,bastard,inan,m,nom,sg" sem="" sem2=""/><ana lex="козбад" gr="S,bastard,inan,m,nom,sg" sem="" sem2=""/><ana lex="козбад" gr="S,anim,bastard,m,nom,persn,sg" sem="" sem2=""/>Козбад</w> <w><ana lex="хорошо" gr="ADV,PRAEDIC,norm" sem="ev:posit dt:quality der:a" sem2=""/><ana lex="хорошо" gr="ADV,PARENTH,norm" sem="ev:posit dt:quality der:a" sem2=""/>хорошо</w> <w><ana lex="сформировать" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus d:pref t:be:appear" sem2=""/>сформировали</w>».</se><se> <w><ana lex="быть" gr="V,1p,act,fut,indic,intr,norm,pf,pl" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/><ana lex="быть" gr="V,1p,act,imper,intr,norm,pf,pl" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>Будем</w> <w><ana lex="ждать" gr="V,act,inf,ipf,norm,tran" sem="d:root" sem2="d:root"/>ждать</w> <w><ana lex="далекий" gr="A,comp,norm,plen" sem="t:dist:max r:qual" sem2="dt:dist:max der:shift t:time t:humq r:qual"/>дальше</w> <w><ana lex="новый" gr="A,gen,norm,pl,plen" sem="t:time r:qual" sem2="t:time r:qual"/>новых</w> «<w><ana lex="ласточка" gr="S,anim,f,gen,norm,pl" sem="t:animal r:concr" sem2=""/>ласточек</w>».</se></p>
<p><se><w><ana lex="удивительно" gr="ADV,norm" sem="ev:posit dt:degr t:degr:max der:a" sem2="ev:posit dt:degr der:a"/>Удивительно</w> <w><ana lex="хороший" gr="A,f,nom,norm,plen,sg" sem="ev:posit t:quality r:qual" sem2="ev:posit ev t:degr:max r:qual"/>хорошая</w> <w><ana lex="погода" gr="S,f,inan,nom,norm,sg" sem="r:abstr t:weather" sem2=""/>погода</w>, -<w><ana lex="10.7" gr="NUM,ciph"/>10.7</w>°<w><ana lex="r" gr="bastard" sem="" sem2=""/>R</w>, <w><ana lex="только" gr="PART,norm" sem="" sem2=""/>только</w> <w><ana lex="бы" gr="PART,norm" sem="" sem2=""/>бы</w> <w><ana lex="быть" gr="V,act,inf,intr,ipf,norm" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>быть</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="сангина" gr="S,f,inan,loc,norm,sg" sem="" sem2=""/>Сангине</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="гулять" gr="V,act,inf,intr,ipf,norm" sem="ca:noncaus t:move d:root" sem2="d:root"/>гулять</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="ружье" gr="S,inan,ins,n,norm,sg" sem="t:tool:weapon r:concr" sem2=""/>ружьем</w>!</se><se> <w>Пожалуй</w>, <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>сегодня</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="попасть" gr="V,1p,act,fut,indic,norm,pf,sg" sem="d:pref" sem2="d:pref"/><ana lex="попадать" gr="V,1p,act,fut,indic,intr,norm,pf,sg" sem="der:v d:pref" sem2=""/><ana lex="попасть" gr="V,1p,act,fut,indic,intr,norm,pf,sg" sem="d:pref" sem2="d:pref"/>попаду</w> <w><ana lex="туда" gr="ADVPRO,norm" sem="t:dir r:dem" sem2="t:place r:dem"/>туда</w>, <w><ana lex="хотя" gr="CONJ,norm" sem="" sem2=""/>хотя</w> <w><ana lex="стремление" gr="S,inan,n,nom,norm,sg" sem="t:ment der:v r:abstr der:s0" sem2="t:psych r:abstr"/>стремление</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncau