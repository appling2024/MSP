<p><se><w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="связь" gr="S,f,inan,nom,norm,pl" sem="r:abstr t:inter" sem2="sc:org pt:set r:abstr sc:thing t:inter der:v pt:aggr pc:constr pt:part r:concr"/><ana lex="связь" gr="S,f,gen,inan,norm,sg" sem="r:abstr t:inter" sem2="sc:org pt:set r:abstr sc:thing t:inter der:v pt:aggr pc:constr pt:part r:concr"/><ana lex="связь" gr="S,dat,f,inan,norm,sg" sem="r:abstr t:inter" sem2="sc:org pt:set r:abstr sc:thing t:inter der:v pt:aggr pc:constr pt:part r:concr"/><ana lex="связь" gr="S,acc,f,inan,norm,pl" sem="r:abstr t:inter" sem2="sc:org pt:set r:abstr sc:thing t:inter der:v pt:aggr pc:constr pt:part r:concr"/><ana lex="связь" gr="S,f,inan,loc,norm,sg" sem="r:abstr t:inter" sem2="sc:org pt:set r:abstr sc:thing t:inter der:v pt:aggr pc:constr pt:part r:concr"/><ana lex="связи" gr="S,inan,nom,norm,pl" sem="" sem2=""/><ana lex="связи" gr="S,acc,inan,norm,pl" sem="" sem2=""/>связи</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="это" gr="SPRO,inan,ins,n,norm,sg" sem="r:dem" sem2=""/>этим</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="невольно" gr="ADV,norm" sem="der:a" sem2=""/>невольно</w> <w><ana lex="вспоминать" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="der:v d:pref" sem2="der:v d:pref"/>вспоминаю</w> <w><ana lex="история" gr="S,acc,f,inan,norm,sg" sem="r:abstr" sem2="ev:neg r:concr r:abstr t:text"/>историю</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="революция" gr="S,f,inan,ins,norm,sg" sem="r:abstr" sem2="r:abstr"/>революцией</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="маньчжурия" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Маньчжурии</w>.</se></p>
<p><se><b/><w><b>5</b></w><b>/</b><w><ana lex="x" gr="bastard" sem="" sem2=""/><b>X</b></w><b>, </b><w><ana lex="t" gr="bastard" sem="" sem2=""/><b>T</b></w><b/>. <w><ana lex="ночь" gr="S,f,inan,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2=""/>Ночь</w> <w><ana lex="ясный" gr="A,f,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясная</w>, <w><ana lex="тихий" gr="A,f,nom,norm,plen,sg" sem="d:neg t:sound r:qual" sem2="d:neg t:humq t:speed:min der:shift t:sound r:qual"/>тихая</w>.</se><se> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>К</w> <w><ana lex="утро" gr="S,dat,inan,n,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утру</w>, <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="обыкновение" gr="S,dat,inan,n,norm,sg" sem="r:abstr" sem2=""/>обыкновению</w>, <w><ana lex="появиться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus d:pref t:be:appear" sem2="ca:noncaus d:pref"/>появились</w> <w><ana lex="слоистый" gr="A,nom,norm,pl,plen" sem="t:physq d:habit der:s r:qual" sem2=""/>слоистые</w> <w><ana lex="облако" gr="S,inan,n,nom,norm,pl" sem="qc:stuff r:concr" sem2="qc:stuff pt:qtm top:form r:concr"/>облака</w>.</se><se> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>На</w> <w><ana lex="зара" gr="S,f,inan,loc,norm,sg" sem="" sem2=""/><ana lex="зара" gr="S,anim,f,loc,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/><ana lex="заря" gr="S,f,inan,loc,norm,sg" sem="r:abstr t:light t:weather" sem2="ev:posit t:sound r:abstr"/>заре</w> <w><ana lex="3-2" gr="NUM,ciph"/>3-2</w>°<w>С</w>. <w><ana lex="среди" gr="PR,norm" sem="" sem2=""/>Среди</w> <w><ana lex="абсолютный" gr="A,f,gen,norm,plen,sg" sem="r:rel der:s" sem2="t:degr:max:magn der:s r:qual"/>абсолютной</w> <w><ana lex="тишина" gr="S,f,gen,inan,norm,sg" sem="t:neg t:sound r:abstr t:fam" sem2="r:abstr"/>тишины</w> <w><ana lex="оригинально" gr="ADV,norm" sem="der:a" sem2=""/>оригинально</w> <w><ana lex="раздаваться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="d:pref" se