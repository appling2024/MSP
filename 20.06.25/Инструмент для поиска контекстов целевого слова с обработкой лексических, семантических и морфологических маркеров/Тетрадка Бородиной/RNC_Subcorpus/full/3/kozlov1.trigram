<p><se><b/><w><b>9</b></w><b>/</b><w><ana lex="ii" gr="bastard" sem="" sem2=""/><b>II</b></w><b>, </b><w><ana lex="w" gr="bastard" sem="" sem2=""/><b>W</b></w><b/>. <w><ana lex="серо" gr="ADV,norm" sem="dt:physq:color der:a ev:neg" sem2="dt:physq:color der:a ev:neg"/>Серо</w>, <w>холодно</w>, <w><ana lex="снежный" gr="A,brev,n,norm,sg" sem="" sem2="t:physq:color r:qual"/>снежно</w>, <w>бр-р-р</w>.</se><se> <w><ana lex="богдо" gr="ADV,bastard" sem="" sem2=""/>Богдо-ула</w> <w><ana lex="скрыть" gr="V,brev,f,norm,partcp,pass,pf,praet,sg" sem="d:pref" sem2="d:pref"/>скрыта</w> <w><ana lex="снежный" gr="A,ins,m,norm,plen,sg" sem="dt:stuff r:rel der:s" sem2="t:physq:color r:qual"/>снежным</w> <w><ana lex="туман" gr="S,inan,ins,m,norm,sg" sem="r:abstr t:weather" sem2="ev:neg r:abstr t:weather"/>туманом</w>.</se></p>
