<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w> <w><ana lex="вручить" gr="V,brev,f,norm,partcp,pass,pf,praet,sg" sem="ca:caus d:pref t:poss" sem2="d:pref"/>вручена</w> <w><ana lex="полпредство" gr="S,inan,ins,n,norm,sg" sem="r:concr t:org" sem2=""/>полпредством</w> <w><ana lex="следующий" gr="A,f,nom,norm,plen,sg" sem="der:v r:rel dt:move t:ord" sem2="der:v r:rel dt:move t:ord"/>следующая</w> <w><ana lex="телеграмма" gr="S,f,inan,nom,norm,sg" sem="der:comp r:concr t:text" sem2=""/>телеграмма</w>: «<w><ana lex="главнаука" gr="S,bastard,f,inan,nom,sg" sem="r:propn t:org" sem2=""/>Главнаука</w> <w><ana lex="наркомпрос" gr="S,bastard,gen,inan,m,sg" sem="der:comp der:abbr r:propn t:org" sem2=""/>Наркомпроса</w> <w><ana lex="просить" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="t:speech ca:caus d:root" sem2="d:root"/>просит</w> <w><ana lex="телеграфировать" gr="V,act,inf,norm,pf,tran" sem="der:s" sem2=""/><ana lex="телеграфировать" gr="V,act,inf,ipf,norm,tran" sem="der:s" sem2=""/>телеграфировать</w>, <w><ana lex="где" gr="ADVPRO,norm" sem="t:place r:rel" sem2="t:place r:indet"/>где</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w>данное</w> <w><ana lex="время" gr="S,acc,inan,n,norm,sg" sem="r:abstr t:param t:time" sem2="t:time:period r:abstr t:time"/>время</w> <w><ana lex="экспедиция" gr="S,f,inan,nom,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиция</w> <w><ana lex="козлов" gr="S,anim,famn,gen,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/><ana lex="козлов" gr="S,gen,inan,m,norm,sg" sem="" sem2="r:propn t:topon"/>Козлова</w>, <w><ana lex="предложить" gr="V,act,inf,norm,pf" sem="t:speech ca:noncaus d:pref" sem2="t:speech ca:noncaus d:pref"/>предложить</w> <w><ana lex="она" gr="SPRO,3p,dat,f,norm,sg" sem="r:pers" sem2=""/>ей</w> <w><ana lex="телеграфировать" gr="V,act,inf,norm,pf,tran" sem="der:s" sem2=""/><ana lex="телеграфировать" gr="V,act,inf,ipf,norm,tran" sem="der:s" sem2=""/>телеграфировать</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="состояние" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr der:s0" sem2="sc:thing ev:posit t:psych r:abstr der:shift sc:money pt:aggr t:physiol r:concr"/>состоянии</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w> <w><ana lex="письменно" gr="ADV,norm" sem="der:a" sem2=""/>письменно</w>, <w><ana lex="срочно" gr="ADV,norm" sem="dt:time der:a t:time" sem2=""/>срочно</w> <w><ana lex="прислать" gr="V,act,inf,norm,pf" sem="ca:caus t:move d:pref" sem2="ca:caus t:move d:pref"/>прислать</w> <w><ana lex="отчет" gr="S,acc,inan,m,norm,pl" sem="t:speech der:v r:abstr der:s0" sem2="t:speech r:abstr"/>отчеты</w>.</se><se> <w><ana lex="завглавнаука" gr="S,bastard,f,inan,ins,sg" sem="" sem2=""/><ana lex="завглавнаука" gr="S,bastard,f,inan,ins,sg" sem="" sem2=""/>Завглавнаукой</w> <w>Н</w>. <w><ana lex="петров" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn t:persn" sem2=""/>Петров</w>».</se><se> <w><ana lex="через" gr="PR,norm" sem="" sem2=""/>Через</w> <w><ana lex="час" gr="S,acc,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>час</w> <w><ana lex="время" gr="S,gen,inan,n,norm,sg" sem="r:abstr t:param t:time" sem2="t:time:period r:abstr t:time"/>времени</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="ответить" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="t:speech ca:noncaus d:pref" sem2="d:pref"/>ответил</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w>:</se></p>
<p><se>«<w><ana lex="москва" gr="S,f,inan,nom,norm,sg" sem="r:propn t:topon" sem2="r:propn t:topon"/>Москва</w>.</se><se> <w><ana lex="главнаука" gr="S,bastard,f,inan,nom,sg" sem="r:propn t:org" sem2=""/>Главнаука</w>.</se><se> <w><ana lex="наркомпрос" gr="S,bastard,inan,m,nom,sg" sem="der:comp der:abbr r:propn t:org" sem2=""/>Наркомпрос</w>.</se><se> <w><ana lex="тибетский" gr="A,f,nom,norm,plen,sg" sem="dt:topon r:rel der:s t:topon" sem2=""/>Тибетская</w> <w><ana lex="экспедиция" gr="S,f,inan,nom,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиция</w> <w><ana lex="вынужденный" gr="A,brev,f,norm,sg" sem="" sem2=""/>вынуждена</w> <w><ana lex="быть" gr="V,act,f,indic,intr,ipf,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>была</w> <w><ana lex="зимовать" gr="V,act,inf,intr,ipf,norm" sem="der:s" sem2=""/>зимовать</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="урга" gr="S,f,inan,loc,norm,sg" sem="r:propn t:topon" sem2=""/>Урге</w>, <w><ana lex="сосредоточиться" gr="V,act,ger,intr,norm,pf,praet" sem="ca:noncaus d:pref" sem2="ca:noncaus d:pref"/><ana lex="сосредоточиться" gr="V,act,ger,intr,norm,pf,praet" sem="ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>сосредоточившись</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="исследование" gr="S,inan,loc,n,norm,sg" sem="t:ment der:v r:abstr" sem2=""/>исследовании</w> <w><ana lex="монгол" gr="S,anim,gen,m,norm,pl" sem="" sem2=""/>монголов</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="природа" gr="S,f,gen,inan,norm,sg" sem="pt:aggr t:space r:concr sc:space" sem2="pt:aggr t:space r:concr r:abstr sc:space"/>природы</w> <w><ana lex="окрестности" gr="S,gen,inan,norm,pl" sem="" sem2=""/>окрестностей</w> <w><ana lex="столица" gr="S,f,gen,inan,norm,sg" sem="sc:constr:build t:space r:concr" sem2=""/>столицы</w> <w><ana lex="радиус" gr="S,inan,ins,m,norm,sg" sem="t:space r:concr" sem2="t:space r:concr"/>радиусом</w> <w><ana lex="сто" gr="NUM,acc,norm" sem="r:card" sem2=""/>сто</w> <w><ana lex="верста" gr="S,f,gen,inan,norm,pl" sem="t:unit r:abstr" sem2=""/>верст</w>.</se><se> <w><ana lex="изучить" gr="V,brev,n,norm,partcp,pass,pf,praet,sg" sem="d:pref" sem2="d:pref"/>Изучено</w> <w><ana lex="местный" gr="A,n,nom,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s"/>местное</w> <w><ana lex="музыкальный" gr="A,n,nom,norm,plen,sg" sem="r:rel der:s" sem2="ev:posit t:humq t:sound der:s r:qual r:rel"/>музыкальное</w> <w><ana lex="творчество" gr="S,inan,n,nom,norm,sg" sem="t:ment r:abstr t:be:appear" sem2=""/>творчество</w>, <w><ana lex="собрать" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="d:pref" sem2="ca:caus d:pref t:poss"/>собраны</w> <w><ana lex="коллекция" gr="S,f,inan,nom,norm,pl" sem="pt:set sc:thing r:concr" sem2="pt:set sc:thing sc:plant r:concr sc:animal"/>коллекции</w> -- <w><ana lex="этнографический" gr="A,f,nom,norm,plen,sg" sem="der:comp r:rel" sem2=""/>этнографическая</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="естественно" gr="PART,norm" sem="" sem2=""/>естественно-историческая</w>, <w><ana lex="периодически" gr="ADV,norm" sem="t:freq dt:time der:a" sem2=""/>периодически</w> <w><ana lex="отправлять" gr="V,ipf,nom,norm,partcp,pass,pl,plen,praes,tran" sem="der:v ca:caus t:move d:pref" sem2=""/>отправляемые</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="петроград" gr="S,acc,inan,m,norm,sg" sem="r:propn t:topon" sem2=""/>Петроград</w>.</se><se> <w><ana lex="вестись" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="t:be:exist ca:noncaus der:v" sem2="der:v ca:noncaus"/><ana lex="вестись" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="t:be:exist ca:noncaus der:v" sem2="der:v ca:noncaus"/>Ведутся</w> <w><ana lex="археологический" gr="A,nom,norm,pl,plen" sem="der:comp r:rel der:s" sem2=""/>археологические</w> <w><ana lex="раскопка" gr="S,f,inan,nom,norm,pl" sem="t:impact der:v r:abstr der:s0" sem2=""/>раскопки</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="наблюдение" gr="S,inan,n,nom,norm,pl" sem="der:v t:perc r:abstr" sem2=""/>наблюдения</w> <w><ana lex="пролет" gr="S,gen,inan,m,norm,sg" sem="t:move der:s0 r:abstr der:v t:space r:concr" sem2="pc:constr t:space r:concr pt:part pc:space"/>пролета</w> <w><ana lex="птица" gr="S,anim,f,gen,norm,pl" sem="t:animal r:concr hi:class" sem2=""/>птиц</w>.</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="май" gr="S,inan,loc,m,norm,sg" sem="t:time:month t:pers r:abstr" sem2="r:abstr"/><ana lex="май" gr="S,anim,loc,m,norm,persn,sg" sem="t:hum r:propn t:famn" sem2=""/>мае</w> <w><ana lex="месяц" gr="S,inan,loc,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:space t:astr t:time:period r:abstr top:form r:concr t:fam"/>месяце</w> <w><ana lex="экспедиция" gr="S,f,inan,nom,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиция</w> <w><ana lex="предполагать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="t:ment ca:noncaus der:v d:pref" sem2="t:ment ca:noncaus der:v d:pref"/>предполагает</w> <w><ana lex="перекочевать" gr="V,act,inf,intr,norm,pf" sem="der:v ca:noncaus t:move d:pref" sem2=""/>перекочевать</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana form="юго-западный" lex="юго-западный" gr="A,acc,inan,m,norm,plen,sg" sem="t:place der:comp r:rel dt:space" sem2=""/>юго-западный</w> <w><ana lex="излом" gr="S,acc,inan,m,norm,sg" sem="der:v t:space r:concr" sem2="der:v t:space r:concr"/>излом</w> <w><ana lex="тола" gr="S,f,gen,inan,norm,sg" sem="" sem2=""/>Толы</w>.</se><se> <w><ana lex="подробность" gr="S,f,inan,nom,norm,pl" sem="r:abstr der:a" sem2="r:abstr pt:part der:a"/>Подробности</w> <w><ana lex="письмо" gr="S,inan,ins,n,norm,sg" sem="r:concr t:text" sem2="pt:aggr t:asp r:concr r:abstr sc:letter"/>письмом</w>.</se><se> <w><ana lex="козлов" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/><ana lex="козлов" gr="S,inan,m,nom,norm,sg" sem="" sem2="r:propn t:topon"/>Козлов</w>».</se><se> <w>Надо</w> <w><ana lex="приступить" gr="V,act,inf,intr,norm,pf" sem="der:v d:pref" sem2="der:v d:pref"/>приступить</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="писание" gr="S,dat,inan,n,norm,sg" sem="der:v r:abstr der:s0 t:impact:creat" sem2="der:v ev r:concr t:text"/>писанию</w> <w><ana lex="отчет" gr="S,gen,inan,m,norm,sg" sem="t:speech der:v r:abstr der:s0" sem2="t:speech r:abstr"/>отчета</w>.</se></p>
<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="барометр" gr="S,inan,m,nom,norm,sg" sem="der:comp t:tool:device:measur:metr r:concr" sem2="r:abstr"/>барометр</w> <w><ana lex="вновь" gr="ADV,norm" sem="dt:time der:a" sem2=""/>вновь</w> <w><ana lex="падать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:move d:root" sem2="d:root"/>падает</w>, <w>холодно</w> <w><ana lex="словно" gr="CONJ,norm" sem="" sem2=""/>словно</w> <w><ana lex="зима" gr="S,f,inan,ins,norm,sg" sem="t:time:season r:abstr t:time" sem2="t:fam"/>зимою</w>, <w><ana lex="то" gr="SPRO,inan,ins,n,norm,sg" sem="r:dem" sem2=""/>тем</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="менее" gr="ADV,norm" sem="t:degr:min der:adv" sem2="t:degr:min der:adv"/>менее</w> <w><ana lex="объявиться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus d:pref" sem2=""/>объявились</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="этот" gr="APRO,acc,inan,m,norm,sg" sem="r:dem" sem2=""/>этот</w> <w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w> <w><ana lex="нежный" gr="A,nom,norm,pl,plen" sem="t:humq r:qual" sem2="r:qual"/>нежные</w> <w><ana lex="птичка" gr="S,f,inan,nom,norm,pl" sem="" sem2="t:sign r:concr"/><ana lex="птичка" gr="S,anim,f,nom,norm,pl" sem="t:hum ev r:concr der:s d:dim" sem2=""/>птички</w>, <w><ana lex="плисок" gr="S,anim,bastard,m,nom,pl" sem="" sem2=""/><ana lex="плиск" gr="S,bastard,inan,m,nom,pl" sem="" sem2=""/><ana lex="плиск" gr="S,anim,bastard,m,nom,pl" sem="" sem2=""/><ana lex="плиск" gr="S,anim,bastard,m,nom,persn,pl" sem="" sem2=""/>плиски</w>, <w><ana lex="держащийся" gr="V,act,intr,ipf,nom,norm,partcp,pl,plen,praes" sem="" sem2=""/><ana lex="держаться" gr="V,act,intr,ipf,nom,norm,partcp,pl,plen,praes" sem="der:v ca:noncaus" sem2="der:v ca:noncaus"/>держащиеся</w> <w><ana lex="вблизи" gr="PR,norm" sem="" sem2=""/>вблизи</w> <w><ana lex="жилище" gr="S,gen,inan,n,norm,pl" sem="der:v top:contain t:constr:build r:concr" sem2=""/>жилищ</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="двор" gr="S,dat,inan,m,norm,pl" sem="pt:set t:space r:concr pc:constr:build t:group sc:hum pt:addit" sem2="t:space r:concr pc:constr:build t:org t:constr pt:addit"/>дворам</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="забор" gr="S,dat,inan,m,norm,pl" sem="der:s0 r:abstr t:poss der:v t:constr top:vertical r:concr" sem2=""/>заборам</w>!</se><se> <w><ana lex="непременно" gr="ADV,norm" sem="der:a" sem2=""/>Непременно</w> <w>нужно</w> <w><ana lex="быть" gr="V,act,inf,intr,ipf,norm" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>быть</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="пролетный" gr="A,loc,m,norm,plen,sg" sem="der:v r:rel dt:move" sem2="dt:move dt:space der:v der:s:deverb t:place r:rel"/>пролетном</w> <w><ana lex="путь" gr="S,inan,loc,m,norm,sg" sem="top:stripe t:space r:concr" sem2="ev:posit t:space t:asp r:abstr sc:space pt:aggr:aggrpl pt:aggr top:stripe r:concr der:shift"/>пути</w>, <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="станция" gr="S,f,inan,loc,norm,sg" sem="pt:set sc:constr t:space r:concr top:horiz" sem2="t:constr pc:space r:concr r:abstr t:org"/>станции</w> <w><ana lex="сангина" gr="S,f,gen,inan,norm,pl" sem="" sem2=""/>Сангин</w>, <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="как" gr="ADVPRO,norm" sem="r:rel t:manner" sem2=""/>как</w> <w><ana lex="птица" gr="S,anim,f,nom,norm,pl" sem="t:animal r:concr hi:class" sem2=""/>птицы</w> <w><ana lex="мочь" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="d:root" sem2=""/>могут</w> <w><ana lex="прибывать" gr="V,act,inf,intr,ipf,norm" sem="der:v t:move d:impf d:pref" sem2=""/>прибывать</w> <w><ana lex="ежеднев