ual d:pref ca:caus"/>исправит</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="я" gr="SPRO,1p,gen,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="мой" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/>моя</w> <w><ana lex="помощница" gr="S,anim,f,nom,norm,sg" sem="t:hum d:fem r:concr der:s" sem2=""/>помощница</w> -- <w><ana lex="пшевочка" gr="S,anim,bastard,m,nom,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Пшевочка</w>!</se><se> <w><ana lex="уж" gr="PART,norm" sem="" sem2=""/>Уж</w> <w><ana lex="если" gr="CONJ,norm" sem="" sem2=""/>если</w> <w>обречено</w> <w><ana lex="засидеться" gr="V,act,inf,intr,norm,pf" sem="ca:noncaus d:pref" sem2=""/>засидеться</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="урга" gr="S,f,inan,loc,norm,sg" sem="r:propn t:topon" sem2=""/>Урге</w>, <w><ana lex="то" gr="CONJ,norm" sem="" sem2=""/>то</w> <w><ana lex="это" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>это</w> <w><ana lex="произойти" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus der:v d:pref" sem2="t:be:exist ca:noncaus der:v d:pref"/>произойдет</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="вина" gr="S,dat,f,inan,norm,sg" sem="r:abstr" sem2="r:abstr ev:neg"/>вине</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w>.</se><se> <w><ana lex="тогда" gr="ADVPRO,norm" sem="t:time r:dem" sem2="r:dem"/>Тогда</w> <w>надо</w> <w><ana lex="устроить" gr="V,act,inf,norm,pf" sem="der:v ca:caus d:pref t:be:appear" sem2="der:v d:pref"/>устроить</w>, <w><ana lex="пока" gr="CONJ,norm" sem="" sem2=""/>пока</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w>холодно</w>, <w><ana lex="хороший" gr="A,acc,f,norm,plen,sg" sem="ev:posit t:quality r:qual" sem2="ev:posit ev t:degr:max r:qual"/>хорошую</w> <w><ana lex="облава" gr="