<p><se><w><ana lex="павлов" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Павлов</w>, <w><ana lex="горбунова" gr="S,anim,f,famn,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Горбунова</w>, <w><ana lex="телешов" gr="S,anim,bastard,famn,m,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Телешов</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w>К<sup>о</sup></w><sup/> <w><ana lex="собираться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref t:psych:volit"/>собираются</w> <w><ana lex="ехать" gr="V,act,inf,intr,ipf,norm" sem="ca:noncaus t:move d:root" sem2="d:root"/>ехать</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="смена" gr="S,acc,f,inan,norm,sg" sem="der:v r:abstr der:s0" sem2="pt:set der:v t:time:period r:abstr sc:tool:cloth t:group sc:hum r:concr"/>смену</w> <w><ana lex="пастушеский" gr="A,gen,m,norm,plen,sg" sem="r:rel der:s dt:hum" sem2=""/>пастушеского</w> <w><ana lex="лагерь" gr="S,gen,inan,m,norm,sg" sem="t:space r:concr" sem2="t:group pt:set t:space r:concr sc:hum"/>лагеря</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="замена" gr="S,f,gen,inan,norm,sg" sem="der:v r:abstr der:s0" sem2=""/>замены</w> <w><ana lex="палатка" gr="S,f,gen,inan,norm,sg" sem="top:contain r:concr der:s" sem2="top:contain t:constr r:concr"/>палатки</w> <w><ana lex="теплый" gr="A,f,ins,norm,plen,sg" sem="dt:temper dt:abstr t:physq:temper der:s r:qual" sem2="ev:posit t:physq:color dt:temper t:physq:temper dt:abstr der:s r:qual r:rel"/>теплой</w> <w><ana lex="юрта" gr="S,f,inan,ins,norm,sg" sem="top:contain t:constr r:concr" sem2=""/>юртой</w>!</se><se> <w><ana lex="быть" gr="V,1p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>Буду</w> <w><ana lex="собираться" gr="V,act,inf,intr,ipf,norm" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref t:psych:volit"/>собираться</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w>, <w><ana lex="просто" gr="PART,norm" sem="dt:quality der:a" sem2=""/>просто</w> <w><ana lex="прокатиться" gr="V,act,inf,intr,norm,pf" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move t:sound d:pref"/>прокатиться</w>.</se><se> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>Я</w> <w><ana lex="думать" gr="V,1p,act,indic,intr,ipf,norm,praes,sg" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/><ana lex="думать" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/>думаю</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="я" gr="SPRO,1p,acc,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="гусев" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/><ana lex="гусев" gr="S,inan,m,nom,norm,sg" sem="" sem2=""/>Гусев</w> <w><ana lex="собрать" gr="V,3p,act,fut,indic,norm,pf,sg" sem="d:pref" sem2="ca:caus d:pref t:poss"/>соберет</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="дорога" gr="S,acc,f,inan,norm,sg" sem="top:stripe t:space r:concr t:fam" sem2="t:move dt:space r:abstr der:shift t:space r:concr"/>дорогу</w>.</se></p>
<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="отправить" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:caus t:move d:pref" sem2="d:pref"/>отправил</w> <w><ana lex="подарок" gr="S,acc,inan,m,norm,pl" sem="der:v t:thing r:concr" sem2="t:thing ev:posit r:concr r:abstr"/>подарки</w> <w><ana lex="два" gr="NUM,dat,norm" sem="r:card:pauc" sem2=""/>двум</w> <w><ana lex="тибетец" gr="S,anim,dat,m,norm,pl" sem="" sem2=""/>тибетцам</w>: <w><ana lex="куш" gr="S,dat,inan,m,norm,sg" sem="qc:money ev r:concr" sem2=""/>Кушу-чамбала</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="кенчун" gr="S,bastard,inan,m,nom,sg" sem="" sem2=""/><ana lex="кенчун" gr="S,anim,bastard,m,nom,sg" sem="" sem2=""/>кенчун-сойбону</w>, <w><ana lex="лицо" gr="S,dat,inan,n,norm,pl" sem="pt:partb r:concr pc:hum" sem2="pc:tool:cloth t:space r:concr r:abstr"/><ana lex="лицо" gr="S,anim,dat,n,norm,pl" sem="" sem2="t:hum r:concr hi:class"/>лицам</w> <w><ana lex="духовный" gr="A,gen,n,norm,plen,sg" sem="dt:hum:supernat r:rel der:s" sem2="dt:hum:supernat r:rel der:s"/>духовного</w> <w><ana lex="звание" gr="S,gen,inan,n,norm,sg" sem="r:abstr" sem2="sc:hum der:v pt:aggr r:concr r:abstr"/>звания</w>, <w><ana lex="командировать" gr="V,dat,norm,partcp,pass,pf,pl,plen,praet,tran" sem="" sem2=""/>командированным</w> <w><ana lex="сюда" gr="ADVPRO,norm" sem="t:dir r:dem" sem2="t:place r:dem"/>сюда</w> <w><ana lex="управление" gr="S,inan,ins,n,norm,sg" sem="der:v r:abstr der:s0" sem2="sc:tool:device r:abstr t:org pc:tool:device der:v pt:aggr pt:part r:concr"/>управлением</w> <w><ana lex="далай" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>далай-ламской</w> <w><ana lex="канцелярия" gr="S,f,gen,inan,norm,sg" sem="pc:org r:concr t:org pt:part" sem2=""/>канцелярии</w>.</se><se> <w><ana lex="подарок" gr="S,acc,inan,m,norm,pl" sem="der:v t:thing r:concr" sem2="t:thing ev:posit r:concr r:abstr"/>Подарки</w> <w><ana lex="этот" gr="APRO,dat,norm,pl" sem="r:dem" sem2=""/>этим</w> <w><ana lex="лицо" gr="S,dat,inan,n,norm,pl" sem="pt:partb r:concr pc:hum" sem2="pc:tool:cloth t:space r:concr r:abstr"/><ana lex="лицо" gr="S,anim,dat,n,norm,pl" sem="" sem2="t:hum r:concr hi:class"/>лицам</w> <w><ana lex="быть" gr="V,3p,act,fut,indic,intr,norm,pf,pl" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>будут</w> <w><ana lex="поднести" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus t:move d:pref"/><ana lex="поднести" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus t:move d:pref"/>поднесены</w> <w><ana lex="кондратьев" gr="S,anim,famn,ins,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Кондратьевым</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="галсан" gr="S,anim,ins,m,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Галсаном</w>.</se></p>
<p><se><w><ana lex="затем" gr="ADV,norm" sem="der:apro t:time r:dem" sem2=""/>Затем</w>, <w><ana lex="быстро" gr="ADV,norm" sem="dt:speed:max ev der:a" sem2="t:speed:max dt:speed:max ev der:a"/>быстро</w> <w><ana lex="собраться" gr="V,act,ger,intr,norm,pf,praet" sem="ca:noncaus t:move d:pref" sem2="ca:noncaus d:pref t:psych:volit"/>собравшись</w>, <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="отправиться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2=""/>отправился</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="сангина" gr="S,f,gen,inan,norm,pl" sem="" sem2=""/>Сангин</w>, <w><ana lex="урочище" gr="S,inan,n,nom,norm,sg" sem="t:space r:concr" sem2=""/>урочище</w>, <w><ana lex="расположить" gr="V,n,nom,norm,partcp,pass,pf,plen,praet,sg" sem="t:put ca:caus der:v d:pref" sem2=""/><ana lex="расположить" gr="V,intr,n,nom,norm,partcp,pass,pf,plen,praet,sg" sem="t:put ca:caus der:v d:pref" sem2=""/>расположенное</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="долина" gr="S,f,inan,loc,norm,sg" sem="t:space r:concr der:s t:fam" sem2=""/>долине</w> <w><ana lex="тола" gr="S,f,gen,inan,norm,sg" sem="" sem2=""/>Толы</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="мелкий" gr="A,ins,m,norm,plen,sg" sem="t:compos:size:min r:qual" sem2="dt:size:min t:hier t:degr:min ev:neg t:size:min der:shift r:qual r:rel"/>мелким</w> <w><ana lex="лес" gr="S,inan,ins,m,norm,sg" sem="pt:set t:space r:concr sc:plant" sem2="t:form pt:aggr t:stuff r:concr sc:qtm"/>лесом</w>, <w><ana lex="состоять" gr="V,act,ins,intr,ipf,m,norm,partcp,plen,praes,sg" sem="d:pref" sem2="d:pref"/>состоящим</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="тополь" gr="S,anim,famn,gen,m,norm,sg" sem="" sem2=""/><ana lex="тополь" gr="S,gen,inan,m,norm,sg" sem="t:plant r:concr" sem2="t:fam"/>тополя</w>, <w><ana lex="лоза" gr="S,f,gen,inan,norm,sg" sem="t:plant r:concr" sem2="t:form r:concr pc:plant pt:part t:fam"/>лозы</w>, <w><ana lex="дикий" gr="A,f,gen,norm,plen,sg" sem="r:rel" sem2="t:humq r:qual der:shift t:degr:max ev:neg r:rel"/>дикой</w> <w><ana lex="яблоня" gr="S,f,gen,inan,norm,sg" sem="t:plant r:concr" sem2=""/>яблони</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="другой" gr="APRO,0,norm" sem="r:spec" sem2="r:ord r:spec r:indet"/>другой</w> <w><ana lex="растительность" gr="S,f,gen,inan,norm,sg" sem="pt:aggr sc:plant r:concr hi:class" sem2="t:hair pc:hum pt:aggr r:concr sc:hair"/>растительности</w>, <w><ana lex="служащий" gr="A,n,nom,norm,plen,sg" sem="" sem2=""/>служащее</w> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="ургинский" gr="A,bastard,f,gen,plen,sg" sem="" sem2=""/>ургинской</w> <w><ana lex="аристократия" gr="S,f,gen,inan,norm,sg" sem="sc:hum pt:aggr r:concr der:s" sem2="sc:hum pt:aggr r:concr der:s"/>аристократии</w> <w><ana lex="дачный" gr="A,ins,m,norm,plen,sg" sem="dt:space r:rel der:s" sem2=""/>дачным</w> <w><ana lex="уголок" gr="S,inan,ins,m,norm,sg" sem="dt:form t:form top:corner top:form der:s d:dim r:concr" sem2="pt:aggr sc:tool t:tool t:space top:contain dt:space top:corner t:room pt:ind t:sign dt:part top:form pc:x pt:part d:dim r:concr pc:room der:s"/>уголком</w>.</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="сангина" gr="S,f,inan,loc,norm,sg" sem="" sem2=""/>Сангине</w> <w><ana lex="тол" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr" sem2=""/>Тола</w> <w><ana lex="особенно" gr="ADV,norm" sem="t:degr:max der:a" sem2="der:aprt der:a"/>особенно</w> <w><ana lex="характерный" gr="A,brev,n,norm,sg" sem="" sem2="t:humq der:s r:qual"/>характерно</w> <w><ana lex="разбиваться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v d:pref d:impf" sem2=""/>разбивается</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="рукав" gr="S,acc,inan,m,norm,pl" sem="pc:tool:cloth r:concr der:s pt:part" sem2="top:rope t:tool t:space top:contain t:reservoir top:tube pt:part pc:reservoir pc:space r:concr"/>рукава</w>, <w><ana lex="среди" gr="PR,norm" sem="" sem2=""/>среди</w> <w><ana lex="который" gr="APRO,gen,norm,pl" sem="r:rel t:ord" sem2=""/>которых</w> <w><ana lex="там" gr="ADVPRO,norm" sem="t:place r:dem" sem2=""/>там</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="сям" gr="ADVPRO,norm" sem="r:dem" sem2=""/>сям</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="выемка" gr="S,f,inan,loc,norm,pl" sem="der:v r:abstr der:s0" sem2="top:pit top:contain der:v t:space r:concr"/>выемках</w>, <w><ana lex="залегать" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v d:pref" sem2=""/>залегают</w> <w><ana lex="ключ" gr="S,inan,m,nom,norm,pl" sem="top:contain t:tool t:space r:concr t:spring" sem2="t:ment t:tool ev:posit pt:addit pc:tool:device r:abstr t:sign t:tool:instr pt:part pc:constr r:concr"/>ключи</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="родник" gr="S,inan,m,nom,norm,pl" sem="top:contain t:space r:concr t:spring" sem2=""/>родники</w>, <w><ana lex="вода" gr="S,f,inan,nom,norm,sg" sem="t:stuff r:concr t:liq" sem2="t:food dt:stuff t:stuff sc:reservoir t:liq sc:space r:abstr pt:aggr:aggrpl sc:qtm t:space pt:part ev:neg sc:spring pc:space r:concr der:shift"/>вода</w> <w><ana lex="который" gr="APRO,gen,norm,pl" sem="r:rel t:ord" sem2=""/>которых</w> <w><ana lex="отрадно" gr="ADV,norm" sem="ev:posit der:a" sem2=""/>отрадно</w> <w><ana lex="оставаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="d:pref" sem2=""/>остается</w> <w><ana lex="открытый" gr="A,f,ins,norm,plen,sg" sem="der:v r:qual" sem2="t:physq:form ev:posit t:humq r:rel der:v r:qual der:shift:v"/>открытой</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="течение" gr="S,acc,inan,n,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="qc:stuff der:v t:move r:concr r:abstr"/>течение</w> <w><ana lex="весь" gr="APRO,f,gen,norm,sg" sem="r:spec" sem2=""/>всей</w> <w><ana lex="зима" gr="S,f,gen,inan,norm,sg" sem="t:time:season r:abstr t:time" sem2="t:fam"/>зимы</w>.</se><se> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>На</w> <w><ana lex="открытый" gr="A,loc,norm,pl,plen" sem="der:v r:qual" sem2="t:physq:form ev:posit t:humq r:rel der:v r:qual der:shift:v"/>открытых</w> <w><ana lex="вода" gr="S,f,inan,loc,norm,pl" sem="t:stuff r:concr t:liq" sem2="t:food dt:stuff t:stuff sc:reservoir t:liq sc:space r:abstr pt:aggr:aggrpl sc:qtm t:space pt:part ev:neg sc:spring pc:space r:concr der:shift"/>водах</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="защитить" gr="V,loc,norm,partcp,pass,pf,pl,plen,praet" sem="d:pref" sem2="d:pref"/>защищенных</w> <w><ana lex="растительность" gr="S,f,inan,ins,norm,sg" sem="pt:aggr sc:plant r:concr hi:class" sem2="t:hair pc:hum pt:aggr r:concr sc:hair"/>растительностью</w> <w><ana lex="место" gr="S,inan,loc,n,norm,pl" sem="qc:space t:space r:concr" sem2="qc:space sc:org t:tool t:space pt:element r:abstr pt:aggr:aggrpl pt:part pc:text r:concr"/>местах</w> <w><ana lex="ютиться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="t:loc ca:noncaus" sem2="ca:noncaus t:loc"/>ютятся</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="крепкий" gr="A,acc,inan,norm,pl,plen" sem="t:physq r:qual" sem2="t:humq t:physq t:degr:max:magn der:shift r:qual r:rel t:behav"/>крепкие</w> <w><ana lex="мороз" gr="S,acc,inan,m,norm,pl" sem="r:abstr t:temper" sem2="t:fam r:abstr t:weather"/>морозы</w> <w><ana lex="дупель" gr="S,anim,m,nom,norm,sg" sem="t:animal r:concr" sem2=""/>дупель-отшельник</w> (<w><ana lex="scolopax" gr="bastard" sem="" sem2=""/>Scolopax</w> <w><ana lex="solitaria" gr="bastard" sem="" sem2=""/>solitaria</w>) <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="оляпка" gr="S,anim,f,nom,norm,sg" sem="t:animal r:concr" sem2=""/>оляпка</w> (<w><ana lex="сinclus" gr="bastard" sem="" sem2=""/>Сinclus</w>).</se><se> <w><ana lex="забавно" gr="ADV,norm" sem="ev der:a" sem2="