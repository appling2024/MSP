<p><se><w><ana lex="обратно" gr="ADV,norm" sem="dt:dir t:dir der:a" sem2=""/>Обратно</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="медленно" gr="ADV,norm" sem="ev dt:speed:min t:speed:min der:a" sem2=""/>медленно</w> <w><ana lex="подниматься" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="ca:noncaus t:move d:pref" sem2=""/><ana lex="подниматься" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="ca:noncaus t:move d:pref" sem2=""/><ana lex="подыматься" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2=""/>поднимался</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="табор" gr="S,dat,inan,m,norm,sg" sem="t:space r:concr t:org" sem2="t:group pt:set t:space r:concr sc:hum"/>табору</w>, <w><ana lex="любоваться" gr="V,act,ger,intr,ipf,norm,praes" sem="ca:noncaus t:perc" sem2=""/>любуясь</w> <w><ana lex="лес" gr="S,inan,ins,m,norm,sg" sem="pt:set t:space r:concr sc:plant" sem2="t:form pt:aggr t:stuff r:concr sc:qtm"/>лесом</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="пернатый" gr="A,ins,m,norm,plen,sg" sem="r:rel der:s d:habit" sem2=""/>пернатым</w> <w><ana lex="мир" gr="S,inan,ins,m,norm,sg" sem="t:space r:concr r:abstr t:inter" sem2="pt:set t:space hi:class r:abstr t:inter sc:hum pt:aggr pt:part sc:living pc:space r:concr"/><ana lex="мир" gr="S,anim,ins,m,norm,persn,sg" sem="" sem2=""/>миром</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="он" gr="SPRO,3p,loc,m,norm,sg" sem="r:pers" sem2=""/>нем</w>.</se><se> <w><ana lex="дятел" gr="S,anim,m,nom,norm,pl" sem="t:animal r:concr" sem2=""/>Дятлы</w> (<w><ana lex="черный" gr="A,m,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq t:physq:color dt:physq:color r:qual der:shift t:race ev:neg t:species ev r:rel"/>черный</w>, <w><ana lex="большой" gr="A,0,norm,plen" sem="t:size:max r:qual" sem2="t:quant:max t:time:age t:degr:max r:qual"/>большой</w> <w><ana lex="пестрый" gr="A,m,nom,norm,plen,sg