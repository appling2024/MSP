<p><se><w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="пернатый" gr="A,loc,m,norm,plen,sg" sem="r:rel der:s d:habit" sem2=""/>пернатом</w> <w><ana lex="мир" gr="S,inan,loc,m,norm,sg" sem="t:space r:concr r:abstr t:inter" sem2="pt:set t:space hi:class r:abstr t:inter sc:hum pt:aggr pt:part sc:living pc:space r:concr"/><ana lex="мир" gr="S,anim,loc,m,norm,persn,sg" sem="" sem2=""/>мире</w> <w><ana lex="прежний" gr="A,n,nom,norm,plen,sg" sem="r:rel t:time" sem2="r:rel t:time"/>прежнее</w> <w><ana lex="затишье" gr="S,inan,n,nom,norm,sg" sem="r:propn r:abstr t:topon" sem2=""/>затишье</w>: <w><ana lex="все" gr="SPRO,inan,n,nom,norm,sg" sem="" sem2=""/>все</w> <w><ana lex="оседлый" gr="A,n,nom,norm,plen,sg" sem="der:v t:humq dt:move r:qual" sem2=""/>оседлое</w>, <w><ana lex="ни" gr="CONJ,norm" sem="" sem2=""/>ни</w> <w><ana lex="экземпляр" gr="S,gen,inan,m,norm,sg" sem="t:thing r:concr" sem2=""/>экземпляра</w> <w><ana lex="новый" gr="A,gen,m,norm,plen,sg" sem="t:time r:qual" sem2="t:time r:qual"/>нового</w>!</se></p>
