<p><se><w><ana lex="у" gr="PR,norm" sem="" sem2=""/>У</w> <w><ana lex="окраина" gr="S,f,gen,inan,norm,pl" sem="pc:space r:concr der:s pt:part" sem2="pc:space r:concr der:s pt:part"/>окраин</w> <w><ana lex="долина" gr="S,f,gen,inan,norm,sg" sem="t:space r:concr der:s t:fam" sem2=""/>долины</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="север" gr="S,gen,inan,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr t:fam pt:part pc:space"/><ana lex="север" gr="S,anim,gen,m,norm,persn,sg" sem="" sem2=""/>севера</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="юг" gr="S,gen,inan,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr pt:part pc:space"/>юга</w>, <w><ana lex="тонкий" gr="A,f,ins,norm,plen,sg" sem="t:size:min r:qual" sem2="t:physq:form t:humq der:shift t:sound r:qual ev"/>тонкой</w> <w><ana lex="нить" gr="S,f,inan,ins,norm,sg" sem="top:rope t:tool r:concr" sem2="top:rope t:form top:line der:shift top:form r:concr"/>нитью</w> <w><ana lex="нанизать" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="t:put ca:caus der:v d:pref" sem2=""/>нанизаны</w> <w><ana lex="след" gr="S,inan,m,nom,norm,pl" sem="top:pit top:contain t:space r:concr" sem2="pc:hum r:abstr der:shift pt:part pt:partb pc:partb r:concr"/>следы</w> <w><ana lex="кумушка" gr="S,anim,f,gen,norm,pl" sem="" sem2="t:hum der:shift r:concr d:dim ev:neg"/>кумушек-лисиц</w>.</se></p>
<p><se><w><ana lex="у" gr="PR,norm" sem="" sem2=""/>У</w> <w><ana lex="любить" gr="V,gen,ipf,m,norm,partcp,pass,plen,praes,sg,tran" sem="ca:noncaus t:psych:emot d:root" sem2="d:root"/>любимого</w> <w><ana lex="мой" gr="APRO,acc,anim,m,norm,sg" sem="r:poss" sem2=""/>моего</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="пшевик" gr="S,acc,anim,bastard,m,sg" sem="" sem2=""/>Пшевика</w> <w><ana lex="место" gr="S,gen,inan,n,norm,sg" sem="qc:space t:space r:concr" sem2="qc:space sc:org t:tool t:space pt:element r:abstr pt:aggr:aggrpl pt:part pc:text r:concr"/>места</w>, <w><ana lex="невдалеке" gr="ADV,norm" sem="d:neg t:dist:min dt:dist:max der:adv" sem2=""/>невдалеке</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="ключевой" gr="A,gen,norm,pl,plen" sem="dt:space r:rel der:s dt:tool" sem2="der:shift t:hier"/>ключевых</w> <w><ana lex="вода" gr="S,f,gen,inan,norm,pl" sem="t:stuff r:concr t:liq" sem2="t:food dt:stuff t:stuff sc:reservoir t:liq sc:space r:abstr pt:aggr:aggrpl sc:qtm t:space pt:part ev:neg sc:spring pc:space r:concr der:shift"/>вод</w>, <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="окраина" gr="S,acc,f,inan,norm,pl" sem="pc:space r:concr der:s pt:part" sem2="pc:space r:concr der:s pt:part"/>окраины</w> <w><ana lex="чаща" gr="S,f,gen,inan,norm,sg" sem="t:quant:max t:space der:a r:abstr pt:set der:shift sc:plant pt:part pc:space r:concr" sem2=""/>чащи</w> <w><ana lex="лесной" gr="A,0,norm,plen" sem="dt:space r:rel der:s" sem2=""/>лесной</w>, <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="остановиться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/>остановился</w>, <w><ana lex="держать" gr="V,act,ger,ipf,norm,praes,tran" sem="t:loc d:root ca:caus" sem2="d:root"/>держа</w> <w><ana lex="наготове" gr="ADV,norm" sem="der:a" sem2="der:a"/>наготове</w> <w><ana lex="ружье" gr="S,acc,inan,n,norm,sg" sem="t:tool:weapon r:concr" sem2=""/>ружье</w> («<w><ana lex="гано" gr="S,0,anim,bastard,m,persn" sem="t:hum r:propn t:famn" sem2=""/>Гано</w>»).</se><se> <w><ana lex="вдруг" gr="ADV,norm" sem="" sem2=""/>Вдруг</w> <w><ana lex="справа" gr="ADV,norm" sem="dt:place t:dir der:a" sem2="t:place dt:place der:a"/>справа</w> <w><ana lex="сорваться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/>сорвался</w> <w><ana lex="тетеревятник" gr="S,anim,m,nom,norm,sg" sem="t:animal r:concr der:s" sem2=""/>тетеревятник</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="мимо" gr="PR,norm" sem="" sem2=""/>мимо</w> <w><ana lex="я" gr="SPRO,1p,gen,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="понестись" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2=""/>понесся</w> <w><ana lex="вверх" gr="ADV,norm" sem="der:s t:dir" sem2="der:s"/>вверх</w>.</se><se> <w><ana lex="удачный" gr="A,ins,m,norm,plen,sg" sem="r:rel der:s" sem2="t:quality ev:posit r:rel der:s"/>Удачным</w> <w><ana lex="выстрел" gr="S,inan,ins,m,norm,sg" sem="r:abstr" sem2=""/>выстрелом</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="добыть" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus d:pref t:poss" sem2="der:v d:pref"/>добыл</w> <w><ana lex="первый" gr="ANUM,gen,n,norm,sg" sem="r:ord der:num t:ord r:qual" sem2="ev:posit t:hier t:qual r:qual"/>первого</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="этот" gr="APRO,loc,n,norm,sg" sem="r:dem" sem2=""/>этом</w> <w><ana lex="путешествие" gr="S,inan,loc,n,norm,sg" sem="t:move r:abstr" sem2=""/>путешествии</w> <w><ana lex="сильный" gr="A,gen,m,norm,plen,sg" sem="t:physq d:habit r:qual" sem2="ev:posit t:humq:char der:s t:degr:max r:qual r:rel"/>сильного</w>, <w><ana lex="стремительный" gr="A,gen,m,norm,plen,sg" sem="t:speed:max der:v r:qual" sem2=""/>стремительного</w> <w><ana lex="крылатый" gr="A,gen,m,norm,plen,sg" sem="dt:partb d:habit der:s r:qual" sem2="ev:posit der:s dt:partb r:qual"/>крылатого</w> <w><ana lex="хищник" gr="S,anim,gen,m,norm,sg" sem="t:animal r:concr der:a" sem2=""/>хищника</w>.</se></p>
<p><se><w><ana lex="обойти" gr="V,act,ger,norm,pf,praet" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/>Обойдя</w> <w><ana lex="вокруг" gr="PR,norm" sem="" sem2=""/>вокруг</w> <w><ana lex="место" gr="S,gen,inan,n,norm,sg" sem="qc:space t:space r:concr" sem2="qc:space sc:org t:tool t:space pt:element r:abstr pt:aggr:aggrpl pt:part pc:text r:concr"/>места</w>, <w><ana lex="знакомый" gr="A,nom,norm,pl,plen" sem="der:v dt:ment r:qual" sem2="t:social r:qual"/>знакомые</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="прежний" gr="A,dat,norm,pl,plen" sem="r:rel t:time" sem2="r:rel t:time"/>прежним</w> <w><ana lex="охота" gr="S,dat,f,inan,norm,pl" sem="t:action t:psych:volit r:abstr" sem2="der:v d:nag r:abstr sc:hum pt:aggr r:concr"/>охотам</w>, <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="пойти" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/>пошел</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="обратный" gr="A,acc,f,norm,plen,sg" sem="der:v r:rel t:dir" sem2="t:place r:rel"/>обратную</w> <w><ana lex="сторона" gr="S,acc,f,inan,norm,sg" sem="t:space r:concr pt:part pc:space" sem2="sc:hum t:space t:asp:ment r:abstr pt:set pc:x pt:part pc:space r:concr pc:form:geom"/>сторону</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="добыть" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus d:pref t:poss" sem2="der:v d:pref"/>добыл</w> <w><ana lex="водяной" gr="A,acc,f,norm,plen,sg" sem="dt:stuff r:rel der:s" sem2=""/>водяную</w> <w><ana lex="оляпка" gr="S,acc,anim,f,norm,sg" sem="t:animal r:concr" sem2=""/>оляпку</w>!</se><se> <w><ana lex="птичка" gr="S,f,inan,nom,norm,sg" sem="" sem2="t:sign r:concr"/><ana lex="птичка" gr="S,anim,f,nom,norm,sg" sem="t:hum ev r:concr der:s d:dim" sem2=""/>Птичка</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="одиночество" gr="S,inan,loc,n,norm,sg" sem="r:abstr" sem2=""/>одиночестве</w> <w><ana lex="ютиться" gr="V,act,f,indic,intr,ipf,norm,praet,sg" sem="t:loc ca:noncaus" sem2="ca:noncaus t:loc"/>ютилась</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="прозрачный" gr="A,loc,norm,pl,plen" sem="t:physq r:rel" sem2="t:physq r:rel r:qual"/>прозрачных</w> <w><ana lex="вода" gr="S,f,inan,loc,norm,pl" sem="t:stuff r:concr t:liq" sem2="t:food dt:stuff t:stuff sc:reservoir t:liq sc:space r:abstr pt:aggr:aggrpl sc:qtm t:space pt:part ev:neg sc:spring pc:space r:concr der:shift"/>водах</w>.</se><se> <w>Странно</w>: <w><ana lex="зима" gr="S,f,inan,ins,norm,sg" sem="t:time:season r:abstr t:time" sem2="t:fam"/>зимою</w>, <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="большой" gr="A,loc,m,norm,plen,sg" sem="t:size:max r:qual" sem2="t:quant:max t:time:age t:degr:max r:qual"/>большом</w> <w><ana lex="мороз" gr="S,anim,famn,loc,m,norm,sg" sem="" sem2=""/><ana lex="мороз" gr="S,inan,loc,m,norm,sg" sem="r:abstr t:temper" sem2="t:fam r:abstr t:weather"/>морозе</w> -- <w><ana lex="вода" gr="S,f,inan,nom,norm,pl" sem="t:stuff r:concr t:liq" sem2="t:food dt:stuff t:stuff sc:reservoir t:liq sc:space r:abstr pt:aggr:aggrpl sc:qtm t:space pt:part ev:neg sc:spring pc:space r:concr der:shift"/>воды</w>, <w><ana lex="катиться" gr="V,act,intr,ipf,nom,norm,partcp,pl,plen,praes" sem="ca:noncaus t:move" sem2="ca:noncaus"/><ana lex="катиться" gr="V,act,intr,ipf,nom,norm,partcp,pl,plen,praes" sem="ca:noncaus t:move" sem2="ca:noncaus"/>катящиеся</w> <w><ana lex="звонко" gr="ADV,norm" sem="ev:posit dt:sound der:a" sem2=""/>звонко</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="камешек" gr="S,dat,inan,m,norm,pl" sem="d:dim r:concr der:s" sem2=""/>камешкам</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="самый" gr="APRO,f,nom,norm,sg" sem="r:spec" sem2="r:spec"/>самая</w> <w><ana lex="птичка" gr="S,f,inan,nom,norm,sg" sem="" sem2="t:sign r:concr"/><ana lex="птичка" gr="S,anim,f,nom,norm,sg" sem="t:hum ev r:concr der:s d:dim" sem2=""/>птичка</w> <w><ana lex="то" gr="CONJ,norm" sem="" sem2=""/>то</w> <w><ana lex="юркнуть" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="der:v ca:noncaus d:semelf t:move" sem2=""/>юркнет</w> <w><ana lex="под" gr="PR,norm" sem="" sem2=""/>под</w> <w><ana lex="вода" gr="S,acc,f,inan,norm,sg" sem="t:stuff r:concr t:liq" sem2="t:food dt:stuff t:stuff sc:reservoir t:liq sc:space r:abstr pt:aggr:aggrpl sc:qtm t:space pt:part ev:neg sc:spring pc:space r:concr der:shift"/>воду</w>, <w><ana lex="то" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>то</w> <w><ana lex="усесться" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="ca:noncaus d:pref t:move:body" sem2="ca:noncaus d:pref"/>усядется</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="камешек" gr="S,inan,loc,m,norm,pl" sem="d:dim r:concr der:s" sem2=""/>камешках</w>, <w><ana lex="низко" gr="ADV,norm" sem="dt:size:min t:dir der:a" sem2="t:place dt:size:min der:a"/>низко</w> <w><ana lex="припадать" gr="V,act,ger,intr,ipf,norm,praes" sem="der:v d:pref" sem2=""/>припадая</w> <w><ana lex="поклон" gr="S,inan,ins,m,norm,sg" sem="t:loc:body der:v r:abstr" sem2="t:speech r:abstr t:move:body"/>поклоном</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="поверхность" gr="S,f,inan,loc,norm,sg" sem="top:surface t:space r:concr" sem2="r:abstr top:surface der:shift pt:part ev:neg pc:reservoir pc:space r:concr"/>поверхности</w> <w><ana lex="вода" gr="S,f,gen,inan,norm,sg" sem="t:stuff r:concr t:liq" sem2="t:food dt:stuff t:stuff sc:reservoir t:liq sc:space r:abstr pt:aggr:aggrpl sc:qtm t:space pt:part ev:neg sc:spring pc:space r:concr der:shift"/>воды</w>!</se><se> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>Не</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="гора" gr="S,f,inan,ins,norm,pl" sem="top:hill t:space r:concr" sem2="sc:x pt:set t:space t:form r:abstr t:quant:max r:concr"/>горами</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="март" gr="S,inan,m,nom,norm,sg" sem="t:time:month r:abstr" sem2=""/><ana lex="март" gr="S,anim,m,nom,norm,persn,sg" sem="" sem2=""/>март</w> <w><ana lex="месяц" gr="S,inan,m,nom,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:space t:astr t:time:period r:abstr top:form r:concr t:fam"/>месяц</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="солнечный" gr="A,acc,inan,norm,pl,plen" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s"/>солнечные</w>, <w><ana lex="теплый" gr="A,acc,inan,norm,pl,plen" sem="dt:temper dt:abstr t:physq:temper der:s r:qual" sem2="ev:posit t:physq:color dt:temper t:physq:temper dt:abstr der:s r:qual r:rel"/>теплые</w> <w><ana lex="час" gr="S,acc,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часы</w> <w><ana lex="который" gr="APRO,gen,m,norm,sg" sem="r:rel t:ord" sem2=""/>которого</w> <w><ana lex="раздаться" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="der:v ca:noncaus d:pref" sem2="der:v t:changest d:pref ca:noncaus"/>раздастся</w> <w><ana lex="нежный" gr="A,f,nom,norm,plen,sg" sem="t:humq r:qual" sem2="r:qual"/>нежная</w> <w><ana lex="звонкий" gr="A,f,nom,norm,plen,sg" sem="t:sound r:qual" sem2="t:sound r:qual"/>звонкая</w> <w><ana lex="песнь" gr="S,f,inan,nom,norm,sg" sem="t:workmus r:concr" sem2="pc:text r:concr t:text pt:part"/>песнь</w> <w><ana lex="этот" gr="APRO,f,gen,norm,sg" sem="r:dem" sem2=""/>этой</w> <w><ana lex="оригинальный" gr="A,f,gen,norm,plen,sg" sem="r:rel der:s" sem2="r:rel der:s"/>оригинальной</w>, <w><ana lex="живой" gr="A,0,norm,plen" sem="der:v r:qual" sem2="t:humq r:qual"/>живой</w>, <w><ana lex="милый" gr="A,f,gen,norm,plen,sg" sem="t:humq r:qual" sem2="ev:posit t:social:emot r:qual"/>милой</w> <w><ana lex="птичка" gr="S,f,gen,inan,norm,sg" sem="" sem2="t:sign r:concr"/><ana lex="птичка" gr="S,anim,f,gen,norm,sg" sem="t:hum ev r:concr der:s d:dim" sem2=""/>птички</w>.</se><se> <w><ana lex="она"