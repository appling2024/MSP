lex="касаться" gr="V,acc,act,inan,intr,ipf,norm,partcp,pl,plen,praes" sem="t:impact ca:noncaus der:v t:contact" sem2="der:v ca:noncaus"/>касающиеся</w> <w><ana lex="экспедиция" gr="S,acc,f,inan,norm,pl" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w>, <w><ana lex="обязать" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="d:pref" sem2="d:pref"/>обязан</w> <w><ana lex="устроить" gr="V,act,inf,norm,pf" sem="der:v ca:caus d:pref t:be:appear" sem2="der:v d:pref"/>устроить</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="облегчить" gr="V,act,inf,norm,pf" sem="dt:physq:weight t:changest d:pref der:a ca:caus" sem2="d:pref"/>облегчить</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="устройство" gr="S,dat,inan,n,norm,sg" sem="der:v r:abstr der:s0" sem2="t:tool:device r:concr r:abstr"/>устройству</w> <w><ana lex="полпред" gr="S,anim,m,nom,norm,sg" sem="der:comp t:hum r:concr der:abbr" sem2=""/>полпред</w>».</se><se> <w><ana lex="относительно" gr="PR,norm" sem="" sem2=""/>Относительно</w> <w><ana lex="политкомиссар" gr="S,anim,bastard,gen,m,sg" sem="" sem2=""/>политкомиссара</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w>: <w><ana lex="вместо" gr="PR,norm" sem="" sem2=""/>вместо</w> <w><ana lex="убугунов" gr="S,anim,bastard,famn,gen,m,sg" sem="t:hum r:propn t:famn" sem2=""/>Убугунова</w> <w><ana lex="алексей" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Алексей</w> <w><ana lex="николаевич" gr="S,anim,m,nom,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Николаевич</w> <w><ana lex="обещать" gr="V,act,indic,m,norm,pf,praet,sg,tran" sem="t:speech ca:noncaus d:pref der:s" sem2="d:pref der:s"/><ana lex="обещать" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="t:speech ca:noncaus d:pref der:s" sem2="d:pref der:s"/>обеща