<p><se><w><ana lex="мечтать" gr="V,1p,act,indic,intr,ipf,norm,pl,praes" sem="t:ment ca:noncaus d:root" sem2=""/>Мечтаем</w> <w><ana lex="об" gr="PR,norm" sem="" sem2=""/>об</w> <w><ana lex="облава" gr="S,f,inan,loc,norm,sg" sem="r:abstr" sem2="r:abstr"/>облаве</w> <w><ana lex="генеральный" gr="A,f,gen,norm,plen,sg" sem="t:hier r:rel" sem2="t:hier r:rel"/>генеральной</w>, <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="знать" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/>знаю</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="выйти" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="der:v t:move d:pref" sem2=""/><ana lex="выйти" gr="V,3p,act,fut,indic,norm,pf,sg" sem="der:v t:move d:pref" sem2=""/><ana lex="выходить" gr="V,3p,act,fut,indic,norm,pf,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v d:pref"/>выйдет</w>.</se><se> <w><ana lex="вечер" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечером</w> <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>сегодня</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="некоторый" gr="APRO,f,loc,norm,sg" sem="r:indet" sem2=""/>некоторой</w> <w><ana lex="степень" gr="S,f,inan,loc,norm,sg" sem="t:degr r:abstr" sem2="t:hier r:abstr"/>степени</w> <w><ana lex="весь" gr="APRO,n,nom,norm,sg" sem="r:spec" sem2=""/>все</w> <w><ana lex="это" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>это</w> <w><ana lex="выясниться" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="t:ment ca:noncaus d:pref" sem2=""/>выяснится</w>.</se><se> <w><ana lex="пока" gr="CONJ,norm" sem="" sem2=""/>Пока</w> <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="наш" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/>наша</w> <w><ana lex="экспедиция" gr="S,f,inan,nom,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>э