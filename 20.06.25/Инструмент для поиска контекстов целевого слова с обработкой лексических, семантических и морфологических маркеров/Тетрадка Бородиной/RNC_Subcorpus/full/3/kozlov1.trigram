<p><se><w>А</w>. <w>Н</w>. <w><ana lex="васильев" gr="S,anim,dat,famn,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Васильеву</w> <w><ana lex="дать" gr="V,brev,f,norm,partcp,pass,pf,praet,sg" sem="ca:caus d:root t:poss" sem2="d:root"/>дана</w> <w><ana lex="во" gr="PR,norm" sem="" sem2=""/>во</w> <w><ana lex="временный" gr="A,acc,n,norm,plen,sg" sem="t:time r:qual" sem2=""/><ana lex="временной" gr="A,acc,n,norm,plen,sg" sem="r:rel der:s" sem2=""/>временное</w> <w><ana lex="пользование" gr="S,acc,inan,n,norm,sg" sem="der:v r:abstr" sem2=""/>пользование</w> <w><ana lex="наш" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/>наша</w> <w><ana lex="трехлинейка" gr="S,f,inan,nom,norm,sg" sem="t:tool:weapon r:concr" sem2=""/>трехлинейка</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="принадлежность" gr="S,f,inan,ins,norm,pl" sem="der:v r:abstr der:s0 t:poss" sem2="der:v t:access r:concr r:abstr"/>принадлежностями</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="соответствующий" gr="A,ins,m,norm,plen,sg" sem="der:v r:rel" sem2=""/>соответствующим</w> <w><ana lex="запас" gr="S,inan,ins,m,norm,sg" sem="sc:x der:v pt:aggr r:concr" sem2="pc:tool:cloth der:shift r:abstr sc:hum pt:aggr r:concr"/>запасом</w> <w><ana lex="патрон" gr="S,gen,inan,m,norm,pl" sem="t:tool:shell r:concr" sem2="t:tool top:cylinder pt:part top:tube r:concr pc:tool"/><ana lex="патрон" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr" sem2="t:hum ev r:concr"/>патронов</w>.</se><se> <w><ana lex="быть" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>Был</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="я" gr="SPRO,1p,gen,norm,sg" sem="r:pers" sem2=""/>меня</w> <w>В</w>. <w>Г</w>. <w><ana lex="дадиани" gr="S,0,anim,bastard,f,persn,sg" sem="" sem2=""/>Дадиани</w>.</se></p>
<p><se><b/><w><b>6</b></w><b>/</b><w><ana lex="iii" gr="bastard" sem="" sem2=""/><b>III</b></w><b>, </b><w><ana lex="v" gr="bastard" sem="" sem2=""/><b>V</b></w><b/>. <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w> <w><ana lex="ясный" gr="A,n,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясное</w>, <w><ana lex="холодный" gr="A,n,nom,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодное</w>, -<w><ana lex="22.6" gr="NUM,ciph"/>22.6</w>°<w><ana lex="r" gr="bastard" sem="" sem2=""/>R</w>. <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>Я</w> <w><ana lex="подняться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/>поднялся</w> <w><ana lex="рано" gr="ADV,norm" sem="dt:time ev:neg der:a t:time" sem2="dt:time der:a t:time"/>рано</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="цель" gr="S,f,inan,ins,norm,sg" sem="t:space r:concr" sem2="t:ment r:abstr"/>целью</w> <w><ana lex="написать" gr="V,act,inf,norm,pf,tran" sem="der:v d:pref" sem2=""/>написать</w> <w><ana lex="навстречу" gr="ADV,norm" sem="der:s t:dir" sem2=""/>навстречу</w> <w><ana lex="мой" gr="APRO,dat,f,norm,sg" sem="r:poss" sem2=""/>моей</w> <w><ana lex="родной" gr="A,0,norm,plen" sem="t:humq:char r:qual" sem2="ev:posit t:social:emot t:humq:char r:qual"/>родной</w> <w><ana lex="пшевочка" gr="S,anim,bastard,dat,f,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/><ana lex="пшевочка" gr="S,anim,bastard,dat,f,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/><ana lex="пшевочка" gr="S,bastard,dat,f,inan,sg" sem="" sem2=""/>Пшевочке</w> <w><ana lex="приветственный" gr="A,acc,n,norm,plen,sg" sem="r:rel der:s" sem2=""/>приветственное</w> <w><ana lex="письмо" gr="S,acc,inan,n,norm,sg" sem="r:concr t:text" sem2="pt:aggr t: