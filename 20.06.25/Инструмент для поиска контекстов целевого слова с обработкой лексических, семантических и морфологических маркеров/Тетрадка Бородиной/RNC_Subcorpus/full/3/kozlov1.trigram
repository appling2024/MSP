> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="холодный" gr="A,acc,inan,m,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодный</w> <w><ana lex="воздух" gr="S,acc,inan,m,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>воздух</w> <w><ana lex="вносить" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="ca:caus t:move d:pref" sem2=""/>вносит</w> <w><ana lex="много" gr="ADV,norm" sem="t:quant:max r:spec" sem2="t:degr:max"/>много-много</w> <w><ana lex="оживление" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0" sem2="t:move r:abstr"/>оживления</w>.</se><se> <w><ana lex="богдо" gr="ADV,bastard" sem="" sem2=""/>Богдо-ула</w> <w><ana lex="погрести" gr="V,brev,f,norm,partcp,pass,pf,praet,sg" sem="der:v t:move d:pref" sem2=""/><ana lex="погрести" gr="V,brev,f,norm,partcp,pass,pf,praet,sg,tran" sem="der:v t:move d:pref" sem2=""/>погребена</w> <w><ana lex="снег" gr="S,inan,ins,m,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2=""/>снегом</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="как" gr="ADVPRO,norm" sem="r:rel t:manner" sem2=""/>как</w> <w><ana lex="контрастно" gr="ADV,norm" sem="" sem2=""/>контрастно</w> <w><ana lex="выделяться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v d:pref" sem2=""/>выделяется</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="белый" gr="A,loc,m,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:race dt:physq:color der:shift r:qual t:species r:rel"/>белом</w> <w><ana lex="фон" gr="S,inan,loc,m,norm,sg" sem="r:abstr pt:part" sem2="t:space pc:workart r:abstr pt:part t:unit r:concr"/>фоне</w> <w><ana lex="ее" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,n,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,f,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,m,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,n,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,f,gen,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,n,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,f,gen,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,m,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,n,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,f,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,m,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,n,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,f,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,m,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,n,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,f,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,m,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,anim,m,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,inan,m,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,n,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,f,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,m,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,n,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,anim,norm,pl" sem="r:poss" sem2=""/>ее</w> <w><ana lex="растительный" gr="A,f,nom,norm,plen,sg" sem="dt:plant r:rel der:s" sem2="t:humq ev:neg r:qual"/>растительная</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="древесный" gr="A,f,nom,norm,plen,sg" sem="dt:plant r:rel der:s" sem2="dt:stuff r:rel der:s"/>древесная</w> <w><ana lex="зона" gr="S,f,inan,nom,norm,sg" sem="top:stripe t:space r:concr" sem2=""/>зона</w>, <w><ana lex="сло