"местный" gr="A,m,nom,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s"/>местный</w> <w><ana lex="малый" gr="A,m,nom,norm,plen,sg" sem="t:size:min r:qual" sem2="t:time:age:min t:size:min r:qual"/>малый</w> <w><ana lex="заяц" gr="S,anim,m,nom,norm,sg" sem="t:animal r:concr" sem2="t:hum r:concr ev:neg"/>заяц</w> (<w><ana lex="lepus" gr="bastard" sem="" sem2=""/>Lepus</w> <w><ana lex="tolai" gr="bastard" sem="" sem2=""/>tolai</w>).</se><se> <w>Кстати</w>, <w><ana lex="этот" gr="APRO,acc,anim,m,norm,sg" sem="r:dem" sem2=""/>этого</w> <w><ana lex="охотничий" gr="A,acc,anim,m,norm,plen,sg" sem="r:poss der:s dt:hum" sem2=""/>охотничьего</w> <w><ana lex="зверек" gr="S,acc,anim,m,norm,sg" sem="der:s t:hum r:concr d:dim ev:neg" sem2="d:dim t:animal r:concr der:s hi:class"/>зверька</w> <w><ana lex="ургинский" gr="A,bastard,nom,pl,plen" sem="" sem2=""/>ургинские</w> <w><ana lex="охотник" gr="S,anim,m,nom,norm,pl" sem="der:v t:hum r:concr d:nag t:prof" sem2="der:praedic t:hum ev r:concr d:nag"/>охотники</w> <w><ana lex="совершенно" gr="ADV,norm" sem="dt:degr:max t:degr:max der:a" sem2=""/>совершенно</w> <w><ana lex="выбить" gr="V,act,indic,norm,pf,pl,praet" sem="ca:caus t:move d:pref" sem2="d:pref"/>выбили</w>.</se><se> <w>Теперь</w> <w><ana lex="он" gr="SPRO,3p,m,nom,norm,sg" sem="r:pers" sem2=""/>он</w> <w><ana lex="здесь" gr="ADVPRO,norm" sem="t:place r:dem" sem2="t:time r:dem"/>здесь</w> <w><ana lex="страшно" gr="ADV,norm" sem="dt:quality ev t:degr:max der:a" sem2="dt:quality der:a ev:neg"/>страшно</w> <w><ana lex="редкий" gr="A,brev,m,norm,sg" sem="t:physq r:qual" sem2="t:time t:dist r:qual"/>редок</w>, <w><ana lex="иногда" gr="ADV,norm" sem="r:spec t:time" sem2=""/>иногда</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="течение" gr="S,acc,inan,n,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="qc:stuff der:v t:move r:concr r:abstr"/>течение</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:act