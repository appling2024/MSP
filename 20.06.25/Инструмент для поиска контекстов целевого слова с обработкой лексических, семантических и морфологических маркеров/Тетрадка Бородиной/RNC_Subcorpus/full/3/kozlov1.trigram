<p><se><w><ana lex="вчера" gr="ADV,norm" sem="t:time" sem2=""/>Вчера</w> <w><ana lex="забежать" gr="V,act,f,indic,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="забежать" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="забегать" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2=""/>забежала</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="наш" gr="APRO,acc,inan,m,norm,sg" sem="r:poss" sem2=""/>наш</w> <w><ana lex="двор" gr="S,acc,inan,m,norm,sg" sem="pt:set t:space r:concr pc:constr:build t:group sc:hum pt:addit" sem2="t:space r:concr pc:constr:build t:org t:constr pt:addit"/>двор</w> <w><ana lex="собака" gr="S,anim,f,nom,norm,sg" sem="t:animal r:concr" sem2="t:animal r:concr"/>собака</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="пена" gr="S,f,inan,ins,norm,sg" sem="t:stuff r:concr" sem2="t:stuff r:concr"/>пеною</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="рот" gr="S,anim,gen,m,norm,sg" sem="" sem2="t:hum der:shift r:concr"/><ana lex="рот" gr="S,gen,inan,m,norm,sg" sem="pt:partb top:contain r:concr pc:hum" sem2="top:contain pc:hum pc:animal der:shift pt:partb t:fam r:concr top:hole"/>рта</w>, <w><ana lex="человек" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr" sem2="t:hum ev:posit r:concr"/>люди</w> <w><ana lex="кричать" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="ca:noncaus t:sound d:root" sem2="d:root"/>кричали</w>: «<w><ana lex="бешеный" gr="A,f,nom,norm,plen,sg" sem="dt:abstr dt:disease r:rel der:s" sem2="t:degr:max:magn t:humq ev:neg r:qual"/>Бешеная</w> <w><ana lex="собака" gr="S,anim,f,nom,norm,sg" sem="t:animal r:concr" sem2="t:animal r:concr"/>собака</w>!</se><se>». <w><ana lex="прежде" gr="PR,norm" sem="" sem2=""/>Прежде</w> <w><ana lex="что" gr="SPRO,inan,loc,n,norm,sg" sem="r:rel" sem2=""/>чем</w> <w><ana lex="она" gr="SPRO,3