<p><se><b/><w><b>15</b></w><b>/</b><w><ana lex="i" gr="bastard" sem="" sem2=""/><b>I</b></w><b>, </b><w><ana lex="u" gr="bastard" sem="" sem2=""/><b>U</b></w><b/>. <w><ana lex="ранний" gr="A,ins,n,norm,plen,sg" sem="t:time r:qual" sem2="t:time r:qual"/>Ранним-ранним</w> <w><ana lex="утро" gr="S,inan,ins,n,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утром</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="ездить" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="ca:noncaus t:move d:root" sem2="d:root"/>ездил</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="западный" gr="A,acc,n,norm,plen,sg" sem="t:place dt:space r:rel der:s" sem2=""/>западное</w> <w><ana lex="ущелие" gr="S,acc,inan,n,norm,sg" sem="" sem2=""/>ущелье</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="волк" gr="S,acc,anim,m,norm,pl" sem="t:animal r:concr" sem2=""/>волков</w>.</se><se> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>Было</w> <w>морозно</w>, <w>ясно</w>, <w><ana lex="хотя" gr="CONJ,norm" sem="" sem2=""/>хотя</w> <w><ana lex="молодой" gr="A,f,nom,norm,plen,sg" sem="t:time:age r:qual" sem2="t:time:age r:qual"/>молодая</w> <w><ana lex="луна" gr="S,f,inan,nom,norm,sg" sem="top:horiz top:spher t:astr t:space r:concr" sem2="t:space r:concr t:astr top:spher top:horiz pt:addit"/>Луна</w> <w><ana lex="узко" gr="ADV,comp,norm" sem="dt:size:min der:a" sem2="dt:size:min der:a"/><ana lex="уже" gr="ADV,norm" sem="t:time" sem2=""/>уже</w> <w><ana lex="зайти" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/><ana lex="заходить" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2=""/><ana lex="зайти" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/>зашла</w>.</se><se> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>К</w> <w><ana lex="сожаление" gr="S,dat,inan,n,norm,sg" sem="t:psych:emot r:abstr" sem2="t:psych:emot r:abstr"/>сожалению</w>, <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="ничто" gr="SPRO,gen,n,norm,sg" sem="r:neg" sem2=""/>ничего</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="видеть" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="ca:noncaus t:perc d:root" sem2="t:ment ca:noncaus d:root"/>видели</w>!</se><se> <w>Приятно</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="вернуться" gr="V,act,inf,intr,norm,pf" sem="ca:noncaus t:move" sem2="ca:noncaus"/>вернуться</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="тепло" gr="S,acc,inan,n,norm,sg" sem="r:abstr t:temper" sem2="t:psych:emot r:abstr"/>тепло</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="уютность" gr="S,f,inan,nom,norm,sg" sem="r:abstr der:a" sem2=""/>уютность</w>, <w><ana lex="главное" gr="S,inan,n,nom,norm,sg" sem="der:subst r:abstr der:a" sem2=""/>главное</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="тепло" gr="S,acc,inan,n,norm,sg" sem="r:abstr t:temper" sem2="t:psych:emot r:abstr"/>тепло</w>, <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="как" gr="ADVPRO,norm" sem="r:rel t:manner" sem2=""/>как</w> <w><ana lex="сидеть" gr="V,act,ger,intr,ipf,norm,praes" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:noncaus"/>сидя</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="розвальни" gr="S,inan,loc,norm,pl" sem="top:horiz t:tool:transp r:concr" sem2=""/>розвальнях</w> <w><ana lex="чувствоваться" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="ca:noncaus t:perc" sem2=""/>чувствовался</w> <w><ana lex="сильный" gr="A,m,nom,norm,plen,sg" sem="t:physq d:habit r:qual" sem2="ev:posit t:humq:char der:s t:degr:max r:qual r:rel"/>сильный</w> <w><ana lex="холод" gr="S,inan,m,nom,norm,sg" sem="t:temper r:abstr t:weather" sem2="t:manif:emot r:abstr t:temper t:physiol t:manif:disease t:fam"/>холод</w>.</se></p>
<p><se><w><ana lex="вскоре" gr="ADV,norm" sem="der:adv t:time" sem2=""/>Вскоре</w> <w><ana lex="прибыть" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2="d:pref"/>прибыл</w> <w><ana lex="посланец" gr="S,anim,m,nom,norm,sg" sem="der:v t:hum r:concr d:nag" sem2=""/>посланец</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="урга" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Урги</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="васильев" gr="S,anim,famn,gen,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Васильева</w> <w><ana lex="со" gr="PR,norm" sem="" sem2=""/>со</w> <w><ana lex="весь" gr="APRO,loc,m,norm,sg" sem="r:spec" sem2=""/>всем</w> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="мы" gr="SPRO,1p,gen,norm,pl" sem="r:pers" sem2=""/>нас</w> <w><ana lex="необходимый" gr="A,ins,n,norm,plen,sg" sem="der:v d:modal r:qual" sem2="r:rel d:modal"/>необходимым</w>.</se><se> <w><ana lex="угрюмость" gr="S,f,inan,nom,norm,sg" sem="r:abstr der:a" sem2=""/>Угрюмость</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="шофер" gr="S,anim,gen,m,norm,sg" sem="t:hum r:concr t:prof" sem2=""/>шофера</w> <w><ana lex="спасть" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2="d:pref"/><ana lex="спать" gr="V,act,f,indic,intr,ipf,norm,praet,sg" sem="d:root" sem2="d:root"/>спала</w>, <w><ana lex="он" gr="SPRO,3p,m,nom,norm,sg" sem="r:pers" sem2=""/>он</w> <w><ana lex="оживиться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>оживился</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="быстро" gr="ADV,norm" sem="dt:speed:max ev der:a" sem2="t:speed:max dt:speed:max ev der:a"/>быстро</w> <w><ana lex="приступить" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v d:pref" sem2="der:v d:pref"/>приступил</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="исправление" gr="S,dat,inan,n,norm,sg" sem="der:v r:abstr der:s0" sem2="t:changest r:abstr"/>исправлению</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="приведение" gr="S,dat,inan,n,norm,sg" sem="der:v r:abstr" sem2=""/>приведению</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="порядок" gr="S,acc,inan,m,norm,sg" sem="ev:posit r:abstr" sem2="sc:hum ev:posit r:concr r:abstr t:asp:move"/>порядок</w> <w><ana lex="машина" gr="S,f,gen,inan,norm,sg" sem="t:tool:device:machine r:concr t:fam" sem2="t:tool:transp ev r:concr t:org der:figur"/>машины</w>.</se><se> <w><ana lex="покончить" gr="V,act,ger,norm,pf,praet,tran" sem="d:pref" sem2="d:pref"/>Покончив</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="этот" gr="APRO,dat,norm,pl" sem="r:dem" sem2=""/>этим</w>, <w><ana lex="он" gr="SPRO,3p,m,nom,norm,sg" sem="r:pers" sem2=""/>он</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="лавренти" gr="S,anim,ins,m,norm,persn,sg" sem="" sem2=""/><ana lex="лаврентий" gr="S,anim,ins,m,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Лаврентием</w> <w><ana lex="яковлевич" gr="S,anim,ins,m,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Яковлевичем</w> <w><ana lex="укатить" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="укатить" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/>укатил</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="суга" gr="S,acc,bastard,f,inan,sg" sem="" sem2=""/>Сугу-нур</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="наш" gr="APRO,f,ins,norm,sg" sem="r:poss" sem2=""/>нашей</w> <w><ana lex="компания" gr="S,f,inan,ins,norm,sg" sem="t:group pt:set r:concr sc:hum" sem2="r:concr t:org"/>компанией</w>.</se></p>
<p><se><w><ana lex="там" gr="ADVPRO,norm" sem="t:place r:dem" sem2=""/>Там</w> <w><ana lex="андрюша" gr="S,anim,m,nom,norm,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Андрюша</w> <w><ana lex="симук" gr="S,bastard,gen,inan,m,pl" sem="" sem2=""/>Симуков</w> <w><ana lex="экскурсировать" gr="V,act,bastard,indic,ipf,m,praet,sg" sem="" sem2=""/>экскурсировал</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="заросль" gr="S,f,inan,loc,norm,pl" sem="pt:aggr:aggrpl pt:aggr t:space r:concr sc:plant" sem2=""/>зарослях</w>, <w><ana lex="окаймлять" gr="V,act,ipf,loc,norm,partcp,pl,plen,praes,tran" sem="d:pref der:s" sem2=""/>окаймляющих</w> <w><ana lex="река" gr="S,acc,f,inan,norm,sg" sem="top:contain t:reservoir t:space r:concr" sem2="t:quant:max pt:qtm r:abstr"/>реку</w>, <w><ana lex="стеснить" gr="V,acc,f,norm,partcp,pass,pf,plen,praet,sg" sem="d:pref" sem2="d:pref"/>стесненную</w> <w><ana lex="береговой" gr="A,ins,norm,pl,plen" sem="dt:space r:rel der:s" sem2=""/>береговыми</w> <w><ana lex="увал" gr="S,inan,ins,m,norm,pl" sem="t:space r:concr" sem2=""/>увалами</w>.</se><se> <w><ana lex="растительность" gr="S,f,inan,nom,norm,sg" sem="pt:aggr sc:plant r:concr hi:class" sem2="t:hair pc:hum pt:aggr r:concr sc:hair"/>Растительность</w> <w><ana lex="ущелие" gr="S,gen,inan,n,norm,sg" sem="" sem2=""/>ущелья</w> <w><ana lex="богатый" gr="A,brev,f,norm,sg" sem="r:qual" sem2="der:shift r:qual"/>богата</w> <w><ana lex="следующий" gr="A,ins,norm,pl,plen" sem="der:v r:rel dt:move t:ord" sem2="der:v r:rel dt:move t:ord"/>следующими</w> <w><ana lex="форма" gr="S,f,inan,ins,norm,pl" sem="r:abstr" sem2="t:tool sc:partb t:form r:abstr sc:tool:cloth pt:aggr:aggrpl pt:aggr r:concr ev:posit"/>формами</w>: <w><ana lex="ива" gr="S,f,inan,nom,norm,sg" sem="t:plant r:concr" sem2=""/><ana lex="ива" gr="S,anim,f,nom,norm,persn,sg" sem="" sem2=""/>ива</w> (<w><ana lex="salix" gr="bastard" sem="" sem2=""/>Salix</w>), <w><ana lex="несколько" gr="NUM,nom,norm" sem="" sem2=""/>несколько</w> <w><ana lex="вид" gr="S,anim,famn,gen,m,norm,pl" sem="" sem2=""/><ana lex="вид" gr="S,gen,inan,m,norm,pl" sem="der:v r:abstr" sem2="t:ment t:space r:abstr t:workart der:v t:perc r:concr t:fam"/>видов</w> <w><ana lex="густой" gr="A,gen,norm,pl,plen" sem="t:physq r:qual" sem2="t:physq t:sound r:qual"/>густых</w> <w><ana lex="заросль" gr="S,f,gen,inan,norm,pl" sem="pt:aggr:aggrpl pt:aggr t:space r:concr sc:plant" sem2=""/>зарослей</w>, <w><ana lex="лиственница" gr="S,f,inan,nom,norm,sg" sem="t:plant r:concr" sem2=""/>лиственница</w> (<w><ana lex="larix" gr="bastard" sem="" sem2=""/>Larix</w> <w><ana lex="dahurica" gr="bastard" sem="" sem2=""/>dahurica</w>), <w><ana lex="береза" gr="S,f,inan,nom,norm,sg" sem="t:plant r:concr" sem2="t:fam"/>береза</w> (<w><ana lex="betula" gr="bastard" sem="" sem2=""/>Betula</w> <w><ana lex="verrucosa" gr="bastard" sem="" sem2=""/>verrucosa</w>, <w><ana lex="betula" gr="bastard" sem="" sem2=""/>Betula</w> <w><ana lex="humilis" gr="bastard" sem="" sem2=""/>humilis</w>), <w><ana lex="тополь" gr="S,anim,famn,m,nom,norm,sg" sem="" sem2=""/><ana lex="тополь" gr="S,inan,m,nom,norm,sg" sem="t:plant r:concr" sem2="t:fam"/>тополь</w> (<w><ana lex="populus" gr="bastard" sem="" sem2=""/>Populus</w>), <w><ana lex="черемуха" gr="S,f,inan,nom,norm,sg" sem="t:food t:plant r:concr pt:aggr sc:fruit" sem2=""/>черемуха</w> (<w><ana lex="prunus" gr="bastard" sem="" sem2=""/>Prunus</w> <w><ana lex="padus" gr="bastard" sem="" sem2=""/>Padus</w>), <w><ana lex="жимолость" gr="S,f,inan,nom,norm,sg" sem="pt:aggr t:plant:bush r:concr sc:plant" sem2=""/>жимолость</w> (<w><ana lex="zun" gr="bastard" sem="" sem2=""/>Zun</w>. <w><ana lex="coerulen" gr="bastard" sem="" sem2=""/>coerulen</w>), <w><ana lex="боярышник" gr="S,inan,m,nom,norm,sg" sem="t:plant r:concr" sem2=""/>боярышник</w> (<w><ana lex="сrataegus" gr="bastard" sem="" sem2=""/>Сrataegus</w> <w><ana lex="sanguinea" gr="bastard" sem="" sem2=""/>sanguinea</w>).</se><se> <w><ana lex="экскурсия" gr="S,f,inan,nom,norm,sg" sem="t:action t:move r:abstr" sem2="t:group pt:set r:concr sc:hum"/>Экскурсия</w> <w><ana lex="андрюша" gr="S,anim,gen,m,norm,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Андрюши</w> <w><ana lex="дать" gr="V,act,f,indic,norm,pf,praet,sg" sem="ca:caus d:root t:poss" sem2="d:root"/>дала</w> <w><ana lex="следующий" gr="A,gen,norm,pl,plen" sem="der:v r:rel dt:move t:ord" sem2="der:v r:rel dt:move t:ord"/>следующих</w> <w><ana lex="птичка" gr="S,f,gen,inan,norm,pl" sem="" sem2="t:sign r:concr"/><ana lex="птичка" gr="S,anim,f,gen,norm,pl" sem="t:hum ev r:concr der:s d:dim" sem2=""/>птичек</w>: <w><ana lex="picus" gr="bastard" sem="" sem2=""/>Picus</w> <w><ana lex="leuconotus" gr="bastard" sem="" sem2=""/>leuconotus</w>, <w><ana lex="дятел" gr="S,anim,gen,m,norm,sg" sem="t:animal r:concr" sem2=""/>дятла</w> <w><ana lex="малый" gr="A,gen,m,norm,plen,sg" sem="t:size:min r:qual" sem2="t:time:age:min t:size:min r:qual"/>малого</w> <w><ana lex="сибирский" gr="A,gen,m,norm,plen,sg" sem="r:rel t:topon" sem2=""/>сибирского</w>, <w><ana lex="sitta" gr="bastard" sem="" sem2=""/>Sitta</w> <w><ana lex="europaea" gr="bastard" sem="" sem2=""/>europaea</w> <w><ana lex="uralensis" gr="bastard" sem="" sem2=""/>uralensis</w>, <w><ana lex="сойка" gr="S,acc,anim,f,norm,sg" sem="t:animal r:concr" sem2=""/>сойку</w> <w><ana lex="коричнеголовый" gr="A,acc,bastard,f,plen,sg" sem="" sem2=""/>коричнеголовую</w>, <w><ana lex="синица" gr="S,acc,anim,f,norm,sg" sem="t:animal r:concr" sem2=""/>синицу</w> <w><ana lex="роeсile" gr="bastard" sem="" sem2=""/>Роeсile</w> <w><ana lex="borealis" gr="bastard" sem="" sem2=""/>borealis</w>, <w><ana lex="чечетка" gr="S,f,gen,inan,norm,pl" sem="" sem2=""/><ana lex="чечетка" gr="S,anim,f,gen,norm,pl" sem="t:animal r:concr" sem2=""/>чечеток</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="длиннохвостый" gr="A,acc,f,norm,plen,sg" sem="der:comp r:rel" sem2=""/>длиннохвостую</w> <w><ana lex="синичка" gr="S,acc,anim,f,norm,sg" sem="d:dim t:animal r:concr der:s" sem2=""/>синичку</w> (<w><ana lex="acredula" gr="bastard" sem="" sem2=""/>Acredula</w>), <w><ana lex="ворон" gr="S,anim,gen,m,norm,sg" sem="t:animal r:concr" sem2=""/>ворона</w> (<w><ana lex="добыть" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="der:v ca:caus d:pref t:poss" sem2="der:v d:pref"/>добыт</w> <w><ana lex="меркулов" gr="S,anim,famn,ins,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Меркуловым</w>).</se></p>
<p><se><w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>Мы</w> <w><ana lex="тотчас" gr="ADV,norm" sem="der:comp" sem2=""/>тотчас</w> <w><ana lex="сняться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref"/>снялись</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="укатить" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="укатить" gr="V,act,indic,intr,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/>укатили</w>.</se><se> <w><ana lex="воробьева" gr="S,acc,anim,f,famn,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Воробьеву</w> <w><ana lex="оставить" gr="V,brev,n,norm,partcp,pass,pf,praet,sg" sem="t:loc d:pref ca:caus" sem2="d:pref"/>оставлено</w> <w><ana lex="мой" gr="APRO,n,nom,norm,sg" sem="r:poss" sem2=""/>мое</w> <w><ana lex="седло" gr="S,inan,n,nom,norm,sg" sem="der:v t:tool r:concr pc:tool pt:part" sem2="t:tool t:form der:v pc:tool:transp pt:part r:concr"/>седло</w>!</se><se> <w><ana lex="он" gr="SPRO,3p,m,nom,norm,sg" sem="r:pers" sem2=""/>Он</w> <w><ana lex="должный" gr="A,brev,m,norm,sg" sem="" sem2=""/>должен</w> <w><ana lex="он" gr="SPRO,3p,acc,m,norm,sg" sem="r:pers" sem2=""/>его</w> <w><ana lex="хранить" gr="V,act,inf,ipf,norm,tran" sem="ca:noncaus d:root t:poss" sem2="d:root"/>хранить</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="беречь" gr="V,act,inf,ipf,norm,tran" sem="d:root" sem2="d:root"/>беречь</w>.</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="мой" gr="APRO,acc,inan,norm,pl" sem="r:poss" sem2=""/>мои</w> <w><ana lex="наезд" gr="S,acc,inan,m,norm,pl" sem="der:v t:move r:abstr der:s0" sem2="r:abstr"/>наезды</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="быть" gr="V,1p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>буду</w> <w><ana lex="он" gr="SPRO,3p,ins,m,norm,sg" sem="r:pers" sem2=""/>им</w> <w><ana lex="пользоваться" gr="V,act,inf,intr,ipf,norm" sem="ca:noncaus" sem2="ca:noncaus"/>пользоваться</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="мой" gr="APRO,acc,n,norm,sg" sem="r:poss" sem2=""/>мое</w> <w><ana lex="отсутствие" gr="S,acc,inan,n,norm,sg" sem="r:abstr" sem2=""/>отсутствие</w> -- <w><ana lex="сарочка" gr="S,anim,f,nom,norm,persn,sg" sem="" sem2=""/>Сарочка</w>.</se></p>
<p><se><w><ana lex="наш" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>Наш</w> <w><ana lex="обратный" gr="A,m,nom,norm,plen,sg" sem="der:v r:rel t:dir" sem2="t:place r:rel"/>обратный</w> <w><ana lex="путь" gr="S,inan,m,nom,norm,sg" sem="top:stripe t:space r:concr" sem2="ev:posit t:space t:asp r:abstr sc:space pt:aggr:aggrpl pt:aggr top:stripe r:concr der:shift"/>путь</w> <w><ana lex="случайно" gr="ADV,PARENTH,norm" sem="der:a" sem2=""/>случайно</w> <w><ana lex="выйти" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v t:move d:pref" sem2=""/><ana lex="выйти" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v t:move d:pref" sem2=""/><ana lex="выходить" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v d:pref"/>вышел</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="удачный" gr="A,ins,m,norm,plen,sg" sem="r:rel der:s" sem2="t:quality ev:posit r:rel der:s"/>удачным</w>.</se><se> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>Мы</w> <w><ana lex="попасть" gr="V,act,indic,norm,pf,pl,praet" sem="d:pref" sem2="d:pref"/><ana lex="попасть" gr="V,act,indic,intr,norm,pf,pl,praet" sem="d:pref" sem2="d:pref"/><ana lex="попадать" gr="V,act,indic,intr,norm,pf,pl,praet" sem="der:v d:pref" sem2=""/>попали</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="халцзан" gr="S,acc,bastard,inan,m,sg" sem="" sem2=""/><ana lex="халцзан" gr="S,acc,bastard,inan,m,sg" sem="" sem2=""/><ana lex="халцзан" gr="S,acc,bastard,inan,m,sg" sem="" sem2=""/><ana lex="халцзан" gr="S,acc,bastard,inan,m,sg" sem="" sem2=""/>Халцзан-дабан</w>, <w><ana lex="быстро" gr="ADV,norm" sem="dt:speed:max ev der:a" sem2="t:speed:max dt:speed:max ev der:a"/>быстро</w> <w><ana lex="он" gr="SPRO,3p,acc,m,norm,sg" sem="r:pers" sem2=""/>его</w> <w><ana lex="миновать" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="ca:noncaus t:move" sem2=""/><ana lex="миновать" gr="V,act,indic,norm,pf,pl,praet,tran" sem="ca:noncaus t:move" sem2=""/>миновали</w>, <w><ana lex="еще" gr="ADV,norm" sem="" sem2=""/>еще</w> <w><ana lex="быстро" gr="ADV,comp,norm" sem="dt:speed:max ev der:a" sem2="t:speed:max dt:speed:max ev der:a"/>быстрее</w> <w><ana lex="катить" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="ca:caus t:move d:root" sem2="d:root"/>катили</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="ущелие" gr="S,dat,inan,n,norm,sg" sem="" sem2=""/>ущелью</w> <w><ana lex="р" gr="S,0,norm" sem="" sem2=""/>р</w>.</se><se> <w><ana lex="сельба" gr="S,bastard,f,gen,inan,sg" sem="" sem2=""/>Сельбы</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="прибыть" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus t:move d:pref" sem2="d:pref"/>прибыли</w> <w><ana lex="домой" gr="ADV,norm" sem="der:s t:dir" sem2=""/>домой</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="6" gr="NUM,ciph"/>6</w> <w><ana lex="1" gr="NUM,ciph"/>1</w>/<w><ana lex="2" gr="NUM,ciph"/>2</w> <w><ana lex="час" gr="S,gen,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часа</w> <w><ana lex="вечер" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>вечера</w>.</se><se> <w>Приятно</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="окунуться" gr="V,act,inf,intr,norm,pf" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/>окунуться</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="тепло" gr="S,acc,inan,n,norm,sg" sem="r:abstr t:temper" sem2="t:psych:emot r:abstr"/>тепло</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="радушие" gr="S,inan,n,nom,norm,sg" sem="ev:posit t:humq r:abstr" sem2=""/>радушие</w> <w><ana lex="пшевочка" gr="S,anim,bastard,gen,m,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Пшевочки</w>.</se></p>
<p><se><w><ana lex="поздний" gr="A,ins,m,norm,plen,sg" sem="t:time r:qual" sem2="t:time r:qual"/>Поздним</w> <w><ana lex="вечер" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>вечером</w> (<w><ana lex="быть" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>были</w> <w><ana lex="байков" gr="S,anim,famn,m,nom,norm,pl" sem="t:hum r:propn t:famn" sem2=""/>Байковы</w>) <w><ana lex="наконец" gr="ADV,PARENTH,norm" sem="der:s t:time" sem2=""/>наконец</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="улечься" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus d:pref t:move:body" sem2="ca:noncaus d:pref"/>улеглись</w> <w><ana lex="спать" gr="V,act,inf,intr,ipf,norm" sem="d:root" sem2="d:root"/>спать</w>.</se><se> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>Я</w> <w><ana lex="проснуться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:physiol d:pref" sem2="der:v ca:noncaus d:pref"/>проснулся</w> <w><ana lex="поздно" gr="ADV,norm" sem="dt:time der:a t:time" sem2="dt:time ev:neg der:a t:time"/>поздно</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="сила" gr="S,f,inan,loc,norm,pl" sem="sc:hum t:pers r:abstr pt:aggr:aggrpl t:param r:concr" sem2="pt:aggr sc:hum ev:posit t:quant:max pt:qtm r:abstr pt:aggr:aggrpl der:shift r:concr"/>силах</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>был</w> <w><ana lex="отделаться" gr="V,act,inf,intr,norm,pf" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref"/>отделаться</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="образ" gr="S,gen,inan,m,norm,pl" sem="t:ment r:concr r:abstr t:workart" sem2="t:asp r:abstr"/>образов</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="обстановка" gr="S,f,gen,inan,norm,sg" sem="der:v pt:aggr sc:tool:furn r:concr" sem2="r:abstr"/>обстановки</w> <w><ana lex="мандала" gr="S,f,inan,nom,norm,sg" sem="r:concr t:text t:workart" sem2=""/>Мандала</w>.</se></p>
