lex="создавать" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="der:v d:pref d:impf t:be:appear" sem2=""/>создают</w> <w><ana lex="приятный" gr="A,nom,norm,pl,plen" sem="ev:posit r:qual" sem2="ev:posit t:humq r:qual"/>приятные</w> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="глаз" gr="S,acc,inan,m,norm,pl" sem="pt:partb pc:animal r:concr top:disk pc:hum" sem2=""/>глаза</w> <w><ana lex="картина" gr="S,f,gen,inan,norm,sg" sem="r:concr t:workart" sem2="pc:workdram t:text r:abstr t:workart t:perc pt:part t:workcin r:concr"/>картины</w>.</se><se> <w><ana lex="яркий" gr="A,n,nom,norm,plen,sg" sem="t:physq:light r:qual" sem2="ev:posit t:physq:color r:qual"/>Яркое</w> <w><ana lex="солнце" gr="S,inan,n,nom,norm,sg" sem="top:horiz top:spher t:astr t:space r:concr" sem2="ev:posit t:space r:concr r:abstr t:light"/>солнце</w>, <w><ana lex="необычайный" gr="A,f,nom,norm,plen,sg" sem="d:neg t:degr:max r:qual" sem2=""/>необычайная</w> <w><ana lex="прозрачность" gr="S,f,inan,nom,norm,sg" sem="r:abstr der:a" sem2=""/>прозрачность</w> <w><ana lex="воздух" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>воздуха</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana form="ярко-синим" lex="ярко-синий" gr="A,ins,n,norm,plen,sg" sem="der:comp dt:physq:color r:rel t:physq:color" sem2=""/>ярко-синим</w> <w><ana lex="небо" gr="S,inan,ins,n,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/><ana lex="небо" gr="S,inan,ins,n,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/>небом</w> <w><ana lex="дополнять" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="d:pref der:a" sem2=""/>дополняют</w> <w><ana lex="картина" gr="S,acc,anim,f,famn,norm,sg" sem="" sem2=""/><ana lex="картина" gr="S,acc,f,inan,norm,sg" sem="r:concr t:workart" sem2="pc:workdram t:text r:abstr t:workart t:perc pt:part t:workcin r:concr"/>картину</w>.</se></p>
<p><se><w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="11" gr="NUM,ciph"/>11</w>Ѕ <w><ana lex="час" gr="S,gen,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часа</w> <w><ana lex="утро" gr="S,gen,inan,n,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утра</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="урочище" gr="S,inan,loc,n,norm,sg" sem="t:space r:concr" sem2=""/>урочище</w> <w><ana lex="баин" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Баин-булак</w>, <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="гостеприимный" gr="A,gen,norm,pl,plen" sem="der:comp ev:posit t:humq r:qual" sem2=""/>гостеприимных</w> <w><ana lex="поселянин" gr="S,anim,gen,m,norm,pl" sem="der:v t:hum r:concr" sem2=""/>поселян</w> <w>Ежо</w>.</se><se> <w><ana lex="вкусно" gr="ADV,norm" sem="ev:posit dt:physq:taste der:a" sem2=""/>Вкусно</w> <w><ana lex="есть" gr="V,1p,act,indic,ipf,norm,pl,praes,tran" sem="ca:caus t:physiol d:root" sem2="t:be:exist ca:noncaus d:root"/>едим</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="собираться" gr="V,1p,act,indic,intr,ipf,norm,pl,praes" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref t:psych:volit"/>собираемся</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="облава" gr="S,acc,f,inan,norm,sg" sem="r:abstr" sem2="r:abstr"/>облаву</w>.</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="час" gr="S,acc,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>час</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дня</w> <w><ana lex="узко" gr="ADV,comp,norm" sem="dt:size:min der:a" sem2="dt:size:min der:a"/><ana lex="уже" gr="ADV,norm" sem="t:time" sem2=""/>уже</w> <w><ana lex="стоять" gr="V,1p,act,indic,intr,ipf,norm,pl,praes" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:noncaus"/><ana lex="стоить" gr="V,1p,act,indic,ipf,norm,pl,praes" sem="d:root" sem2="d:root"/>стоим</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="номер" gr="S,inan,loc,m,norm,pl" sem="r:abstr" sem2="t:tool t:sign top:contain t:param r:abstr t:room pc:constr pt:part r:concr"/>номерах</w> <w><ana lex="сначала" gr="ADV,norm" sem="der:s t:time" sem2=""/>сначала</w> <w><ana lex="один" gr="APRO,gen,n,norm,sg" sem="" sem2="r:indet"/>одного</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="потом" gr="ADVPRO,norm" sem="t:time" sem2=""/>потом</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="другой" gr="APRO,gen,m,norm,sg" sem="r:spec" sem2="r:ord r:spec r:indet"/>другого</w> <w><ana lex="загон" gr="S,gen,inan,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="der:v t:space r:concr r:abstr"/>загона</w>.</se><se> <w>Чудно</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="вокруг" gr="ADV,norm" sem="t:place der:s" sem2="der:s t:dir"/>вокруг</w>: <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="звонкий" gr="A,ins,m,norm,plen,sg" sem="t:sound r:qual" sem2="t:sound r:qual"/>звонким</w> <w><ana lex="крик" gr="S,inan,ins,m,norm,sg" sem="t:sound:asp r:abstr" sem2="t:fam"/>криком</w> <w><ana lex="пролететь" gr="V,act,f,indic,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="пролетать" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2=""/><ana lex="пролететь" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/>пролетела</w> <w><ana lex="дважды" gr="ADV,norm" sem="t:freq der:num" sem2="t:quant:abs der:num"/>дважды</w> <w><ana lex="стайка" gr=