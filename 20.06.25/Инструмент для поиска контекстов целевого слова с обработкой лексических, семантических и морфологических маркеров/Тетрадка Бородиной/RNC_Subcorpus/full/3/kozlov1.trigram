<p><se><w><ana lex="ночь" gr="S,f,inan,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2=""/>Ночь</w> <w><ana lex="замечательно" gr="ADV,norm" sem="ev:posit dt:quality der:a" sem2=""/>замечательно</w> <w><ana lex="тихий" gr="A,f,nom,norm,plen,sg" sem="d:neg t:sound r:qual" sem2="d:neg t:humq t:speed:min der:shift t:sound r:qual"/>тихая</w>, <w><ana lex="воздух" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>воздух</w> <w><ana lex="удивительно" gr="ADV,norm" sem="ev:posit dt:degr t:degr:max der:a" sem2="ev:posit dt:degr der:a"/>удивительно</w> <w><ana lex="прозрачный" gr="A,brev,m,norm,sg" sem="" sem2="r:qual"/>прозрачен</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="звездный" gr="A,m,nom,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space t:physq:form r:rel der:s"/>звездный</w> <w><ana lex="мир" gr="S,inan,m,nom,norm,sg" sem="t:space r:concr r:abstr t:inter" sem2="pt:set t:space hi:class r:abstr t:inter sc:hum pt:aggr pt:part sc:living pc:space r:concr"/><ana lex="мир" gr="S,anim,m,nom,norm,persn,sg" sem="" sem2=""/>мир</w> <w><ana lex="невольно" gr="ADV,norm" sem="der:a" sem2=""/>невольно</w> <w><ana lex="влечь" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="der:v ca:caus t:move d:pref" sem2="der:v d:pref"/>влечет</w> <w><ana lex="вы" gr="SPRO,2p,acc,norm,pl" sem="r:pers" sem2=""/>вас</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="себе" gr="SPRO,dat,norm" sem="" sem2=""/>себе</w>.</se><se> <w><ana lex="какой" gr="APRO,nom,norm,pl" sem="t:neg r:rel ev:neg" sem2=""/>Какие</w> <w><ana lex="глубокий" gr="A,nom,norm,pl,plen" sem="t:size:max r:qual" sem2="t:dist:max dt:size:max t:degr:max:magn der:shift t:degr:max r:qual"/>глубокие</w> <w><ana lex="мысль" gr="S,f,inan,nom,norm,pl" sem="t:ment r:abstr" sem2="t:ment ev:posit r:abstr"/>мысли</w> <w><ana lex="появляться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v d:pref" sem2=""/>появляются</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="человек" gr="S,anim,loc,m,norm,sg" sem="t:hum r:concr" sem2="t:hum ev:posit r:concr"/>человеке</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="весь" gr="APRO,nom,norm,pl" sem="r:spec" sem2=""/>все</w> <w><ana lex="они" gr="SPRO,3p,nom,norm,pl" sem="r:pers" sem2=""/>они</w> <w><ana lex="уносить" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="ca:caus t:move d:pref" sem2=""/>уносят</w> <w><ana lex="вы" gr="SPRO,2p,acc,norm,pl" sem="r:pers" sem2=""/>вас</w> <w><ana lex="далеко" gr="ADV,norm" sem="t:dist:max" sem2=""/>далеко-далеко</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="мир" gr="S,acc,inan,m,norm,sg" sem="t:space r:concr r:abstr t:inter" sem2="pt:set t:space hi:class r:abstr t:inter sc:hum pt:aggr pt:part sc:living pc:space r:concr"/>мир</w> <w><ana lex="тихий" gr="A,m,nom,norm,plen,sg" sem="d:neg t:sound r:qual" sem2="d:neg t:humq t:speed:min der:shift t:sound r:qual"/>тихий</w>, <w><ana lex="бесстрастный" gr="A,m,nom,norm,plen,sg" sem="dt:psych:emot dt:abstr d:carit der:s r:qual t:psych:emot" sem2=""/>бесстрастный</w>!</se><se> <w><ana lex="вчера" gr="ADV,norm" sem="t:time" sem2=""/>Вчера</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="долго" gr="ADV,norm" sem="t:time:dur:max dt:time:dur:max der:a" sem2=""/>долго-долго</w> <w><ana lex="любоваться" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="ca:noncaus t:perc" sem2=""/>любовался</w> <w><ana lex="звездный" gr="A,ins,n,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space t:physq:form r:rel der:s"/>звездным</w> <w><ana lex="небо" gr="S,inan,ins,n,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/><ana lex="небо" gr="S,inan,ins,n,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/>небом</w>.</se><se> <w><ana lex="звезда" gr="S,f,inan,nom,norm,pl" sem="t:astr t:sp