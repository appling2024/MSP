<p><se><w><ana lex="вечер" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечером</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>были</w> <w><ana lex="мжецкий" gr="S,anim,bastard,famn,m,nom,pl" sem="" sem2=""/>Мжецкие</w>: <w><ana lex="сосед" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr" sem2="t:hum r:concr"/>соседи</w> <w><ana lex="привезти" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2=""/>привезли</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="пекин" gr="S,gen,inan,m,norm,sg" sem="r:propn t:topon" sem2=""/>Пекина</w> <w><ana lex="елочный" gr="A,acc,inan,norm,pl,plen" sem="dt:plant r:rel der:s" sem2=""/>елочные</w> <w><ana lex="украшение" gr="S,acc,inan,n,norm,pl" sem="der:v r:abstr der:s0" sem2="der:v t:access ev:posit r:concr r:abstr"/>украшения</w>, <w><ana lex="подходить" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:move d:pref" sem2=""/>подходит</w> <w><ana lex="праздник" gr="S,inan,m,nom,norm,sg" sem="t:action r:abstr" sem2="r:abstr"/>праздник</w>.</se></p>
<p><se><w><ana lex="ждать" gr="V,1p,act,indic,ipf,norm,pl,praes,tran" sem="d:root" sem2="d:root"/>Ждем</w> <w><ana lex="верблюд" gr="S,acc,anim,m,norm,pl" sem="t:animal r:concr" sem2=""/>верблюдов</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="пастбище" gr="S,gen,inan,n,norm,sg" sem="der:v t:space r:concr" sem2=""/>пастбища</w>.</se><se> <w><ana lex="как" gr="ADVPRO,norm" sem="r:rel t:manner" sem2=""/><ana form="Как-то" lex="как-то" gr="ADVPRO,norm" sem="der:advpro r:indet t:manner" sem2=""/>Как-то</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="они" gr="SPRO,acc,anim,norm,pl" sem="r:pers" sem2=""/>их</w> <w><ana lex="ликвидировать" gr="V,1p,act,fut,indic,norm,pf,pl,tran" sem="ca:caus t:be:disapp" sem2=""/><ana lex="ликвидировать" gr="V,1p,act,imper,norm,pf,pl,tran" sem="ca:caus t:be:disapp" sem2=""/><ana lex="ликвидировать" gr="V,1p,act,indic,ipf,norm,pl,praes,tran" sem="ca:caus t:be:disapp" sem2=""/>ликвидируем</w>?</se></p>
<p><se><b/><w><b>16</b></w><b>/</b><w><ana lex="xii" gr="bastard" sem="" sem2=""/><b>XII</b></w><b>, </b><w><ana lex="q" gr="bastard" sem="" sem2=""/><b>Q</b></w><b/>. <w><ana lex="полуясный" gr="A,bastard,n,nom,plen,sg" sem="" sem2=""/>Полуясное</w>, <w><ana lex="ветреный" gr="A,n,nom,norm,plen,sg" sem="r:rel der:s d:habit" sem2="t:humq der:s ev:neg r:qual"/>ветреное</w> <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утро</w>.</se><se> <w><ana lex="мечтать" gr="V,1p,act,indic,intr,ipf,norm,praes,sg" sem="t:ment ca:noncaus d:root" sem2=""/>Мечтаю</w> <w><ana lex="отправить" gr="V,act,inf,norm,pf" sem="ca:caus t:move d:pref" sem2="d:pref"/>отправить</w> <w><ana lex="свой" gr="APRO,gen,norm,pl" sem="r:poss" sem2="t:social r:poss"/>своих</w> <w><ana lex="спутник" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,gen,inan,m,norm,pl" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутников</w> (<w><ana lex="лишний" gr="A,gen,norm,pl,plen" sem="r:rel" sem2="r:rel ev:neg"/>лишних</w>) <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="север" gr="S,dat,inan,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr t:fam pt:part pc:space"/><ana lex="север" gr="S,anim,dat,m,norm,persn,sg" sem="" sem2=""/>северу</w>!</se><se> <w><ana lex="температура" gr="S,f,inan,nom,norm,sg" sem="r:abstr t:param t:temper" sem2="t:physiol r:abstr t:temper"/>Температура</w> <w><ana lex="довольно" gr="ADV,norm" sem="t:degr dt:humq der:a" sem2="ev:posit dt:humq der:a"/>довольно</w> <w><ana lex="высокий" gr="A,f,nom,norm,plen,sg" sem="t:size:max r:qual" sem2="ev:posit der:shift t:size:max t:sound t:degr:max r:qual t:interpretation"/>высокая</w>, -<w><ana lex="10" gr="NUM,ciph"/>10</w>°<w><ana lex="r" gr="bastard" sem="" sem2=""/>R</w>, <w><ana lex="между" gr="PR,norm" sem="" sem2=""/>между</w> <w><ana lex="то" gr="SPRO,inan,ins,n,norm,sg" sem="r:dem" sem2="