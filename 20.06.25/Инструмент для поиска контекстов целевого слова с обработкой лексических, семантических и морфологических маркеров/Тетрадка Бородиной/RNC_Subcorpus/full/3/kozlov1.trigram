<p><se><b/><w><b>20</b></w><b>/</b><w><ana lex="vii" gr="bastard" sem="" sem2=""/><b>VII</b></w><b>.</b></se><se> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>Так</w> <w><ana lex="долго" gr="ADV,norm" sem="t:time:dur:max dt:time:dur:max der:a" sem2=""/>долго</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="писать" gr="V,act,indic,ipf,m,norm,praet,sg" sem="d:root" sem2="d:root"/><ana lex="писать" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="d:root" sem2="d:root"/><ana lex="писать" gr="V,act,indic,ipf,m,norm,praet,sg" sem="d:root" sem2="d:root"/>писал</w>, <w><ana lex="потому" gr="ADVPRO,norm" sem="der:apro r:dem" sem2=""/>потому</w> <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w>нечего</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="писать" gr="V,act,inf,ipf,norm" sem="d:root" sem2="d:root"/><ana lex="писать" gr="V,act,inf,ipf,norm,tran" sem="d:root" sem2="d:root"/><ana lex="писать" gr="V,act,inf,ipf,norm" sem="d:root" sem2="d:root"/>писать</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w>, <w><ana lex="точный" gr="A,comp,norm,plen" sem="r:qual" sem2="r:qual"/>точнее</w>, <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="новый" gr="A,gen,n,norm,plen,sg" sem="t:time r:qual" sem2="t:time r:qual"/>нового</w>, <w><ana lex="давно" gr="ADV,norm" sem="t:time" sem2=""/>давно</w> <w><ana lex="ждать" gr="V,acc,anim,ipf,m,norm,partcp,pass,plen,praet,sg" sem="d:root" sem2="d:root"/>жданного</w>.</se><se> <w><ana form="По-прежнему" lex="по-прежнему" gr="ADV,norm" sem="dt:time der:a" sem2=""/>По-прежнему</w> <w><ana lex="ждать" gr="V,1p,act,indic,ipf,norm,pl,praes,tran" sem="d:root" sem2="d:root"/>ждем</w> <w><ana lex="у" gr="PR,norm" sem="" 