лее" gr="ADV,norm" sem="t:degr:max der:adv" sem2="t:degr:max"/>Более</w> <w><ana lex="все" gr="SPRO,gen,inan,n,norm,sg" sem="" sem2=""/>всего</w> <w><ana lex="интересный" gr="A,brev,m,norm,sg" sem="dt:abstr der:s dt:ment r:qual" sem2="dt:abstr ev:posit der:s dt:ment r:qual"/>интересен</w> <w><ana lex="человек" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr" sem2="t:hum ev:posit r:concr"/>человек</w>, <w><ana lex="определить" gr="V,act,inf,norm,pf" sem="t:ment ca:noncaus d:pref" sem2="d:pref"/>определить</w> <w><ana lex="который" gr="APRO,gen,m,norm,sg" sem="r:rel t:ord" sem2=""/>которого</w> <w><ana lex="являться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v ca:noncaus" sem2="der:v ca:noncaus"/>является</w> <w><ana lex="возможность" gr="S,f,inan,nom,norm,sg" sem="der:a r:abstr t:mod" sem2="r:abstr der:a"/>возможность</w> <w><ana lex="благодаря" gr="PR,norm" sem="" sem2=""/>благодаря</w> <w><ana lex="присутствие" gr="S,dat,inan,n,norm,sg" sem="r:abstr" sem2="der:v t:space r:concr r:abstr t:org"/>присутствию</w> <w><ana lex="скелет" gr="S,gen,inan,m,norm,pl" sem="pt:partb:inner pc:animal sc:partb r:concr pc:hum" sem2="pt:base pc:constr r:concr pt:part"/>скелетов</w>.</se><se> <w><ana lex="больший" gr="A,f,nom,norm,plen,sg" sem="d:compar t:size:max der:a dt:size:max r:qual" sem2=""/><ana lex="большой" gr="A,f,nom,norm,plen,sg" sem="t:size:max r:qual" sem2="t:quant:max t:time:age t:degr:max r:qual"/>Большая</w> <w><ana lex="часть" gr="S,f,inan,nom,norm,sg" sem="r:concr pc:x pt:part" sem2="pc:org r:abstr sc:part t:org pt:ind pt:aggr:aggrpl t:poss der:shift pc:x pt:part pc:text r:concr"/>часть</w> <w><ana lex="добыть" gr="V,gen,norm,partcp,pass,pf,pl,plen,praet" sem="der:v ca:caus d:pref t:poss" sem2="der:v d:pref"/>добытых</w> <w><ana lex="предмет" gr="S,gen,inan,m,norm,pl" sem="t:thing r:concr" sem2="t:ment t:thing r:concr r:abstr"/>предметов</w> <w><ana lex="отправить" gr="V,brev,f,norm,partcp,pass,pf,praet,sg" sem="ca:caus t:move d:pref" sem2="d:pref"/>отправлена</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="иркутск" gr="S,acc,inan,m,norm,sg" sem="r:propn t:topon" sem2=""/>Иркутск</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="отдел" gr="S,acc,inan,m,norm,sg" sem="r:concr pt:part hi:class" sem2="pc:org t:text pt:set sc:hum pt:part pc:text r:concr"/>отдел</w> <w><ana lex="рго" gr="S,0,anim,bastard,m,sg" sem="" sem2=""/><ana lex="рго" gr="S,0,anim,bastard,m,persn,sg" sem="" sem2=""/>РГО</w>, <w><ana lex="меньший" gr="A,f,nom,norm,plen,sg" sem="r:qual" sem2="r:rel t:ord"/><ana lex="меньшой" gr="A,f,nom,norm,plen,sg" sem="r:rel t:ord" sem2=""/>меньшая</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="ценный" gr="A,f,nom,norm,plen,sg" sem="d:habit der:s r:qual" sem2="r:rel der:s r:qual"/>ценная</w> -- <w><ana lex="золото" gr="S,inan,n,nom,norm,sg" sem="t:stuff r:concr" sem2="sc:workart sc:thing t:stuff sc:money:banknote sc:money pt:aggr r:concr"/>золото</w> -- <w><ana lex="припрятать" gr="V,brev,f,norm,partcp,pass,pf,praet,sg" sem="t:put ca:caus der:v d:pref" sem2=""/>припрятана</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="карман" gr="S,acc,inan,m,norm,pl" sem="pt:part:addit pc:tool:cloth r:concr t:fam" sem2="t:tool t:space top:contain pc:tool:cloth pt:part:addit top:pit r:concr pc:tool"/>карманы</w>.</se><se> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>Мне</w> <w><ana lex="сообщить" gr="V,act,indic,m,norm,pf,praet,sg" sem="t:speech ca:noncaus d:pref" sem2="d:pref"/>сообщил</w> <w><ana lex="один" gr="APRO,m,nom,norm,sg" sem="" sem2="r:indet"/>один</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="рабочий" gr="S,anim,gen,m,norm,pl" sem="der:subst t:famn der:a r:propn t:prof t:hum r:concr" sem2=""/>рабочих</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w>много</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="предмет" gr="S,gen,inan,m,norm,pl" sem="t:thing r:concr" sem2="t:ment t:thing r:concr r:abstr"/>предметов</w> <w><ana lex="первый" gr="ANUM,f,gen,norm,sg" sem="r:ord der:num t:ord r:qual" sem2="ev:posit t:hier t:qual r:qual"/>первой</w> <w><ana lex="необходимость" gr="S,f,gen,inan,norm,sg" sem="r:abstr der:a" sem2=""/>необходимости</w> (<w><ana lex="преимущественно" gr="ADV,norm" sem="dt:hier der:a" sem2=""/>преимущественно</w> <w><ana lex="железный" gr="A,nom,norm,pl,plen" sem="dt:stuff r:rel der:s" sem2="ev:posit r:rel der:shift t:degr:max"/>железные</w> <w><ana lex="предмет" gr="S,inan,m,nom,norm,pl" sem="t:thing r:concr" sem2="t:ment t:thing r:concr r:abstr"/>предметы</w> <w><ana lex="вроде" gr="PR,norm" sem="" sem2=""/>вроде</w> <w><ana lex="топор" gr="S,gen,inan,m,norm,pl" sem="t:tool:instr r:concr" sem2=""/>топоров</w>, <w><ana lex="лопата" gr="S,f,gen,inan,norm,pl" sem="t:tool:instr r:concr" sem2="t:fam"/>лопат</w>, <w><ana lex="столярный" gr="A,gen,norm,pl,plen" sem="r:rel der:s dt:hum" sem2=""/>столярных</w> <w><ana lex="предмет" gr="S,gen,inan,m,norm,pl" sem="t:thing r:concr" sem2="t:ment t:thing r:concr r:abstr"/>предметов</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="проч" gr="S,anim,bastard,m,nom,sg" sem="" sem2=""/><ana lex="проча" gr="S,bastard,f,gen,inan,pl" sem="" sem2=""/>проч</w>.</se><se>). <w><ana lex="во" gr="PR,norm" sem="" sem2=""/>Во</w> <w><ana lex="всякий" gr="APRO,loc,m,norm,sg" sem="r:spec" sem2=""/>всяком</w> <w><ana lex="случай" gr="S,inan,loc,m,norm,sg" sem="pt:qtm r:abstr" sem2="t:time:moment r:abstr"/>случае</w>, <w><ana lex="весь" gr="APRO,n,nom,norm,sg" sem="r:spec" sem2=""/>все</w> <w><ana lex="это" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>это</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="интересный" gr="A,brev,n,norm,sg" sem="dt:abstr der:s dt:ment r:qual" sem2="dt:abstr ev:posit der:s dt:ment r:qual"/>интересно</w>!</se></p>
<p><se><w><ana lex="интересный" gr="A,brev,f,norm,sg" sem="dt:abstr der:s dt:ment r:qual" sem2="dt:abstr ev:posit der:s dt:ment r:qual"/>Интересна</w> <w><ana lex="весна" gr="S,f,inan,ins,norm,sg" sem="t:time:season r:abstr t:time" sem2=""/>весной</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="весь" gr="APRO,f,nom,norm,sg" sem="r:spec" sem2=""/>вся</w> <w><ana lex="вокруг" gr="ADV,norm" sem="t:place der:s" sem2="der:s t:dir"/>вокруг</w> <w><ana lex="лежать" gr="V,act,f,intr,ipf,nom,norm,partcp,plen,praes,sg" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:noncaus"/>лежащая</w> <w><ana lex="местность" gr="S,f,inan,nom,norm,sg" sem="t:space r:concr der:s" sem2="t:space r:concr der:s sc:space"/>местность</w>: <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="гора" gr="S,acc,f,inan,norm,pl" sem="top:hill t:space r:concr" sem2="sc:x pt:set t:space t:form r:abstr t:quant:max r:concr"/>горы</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="долина" gr="S,anim,f,famn,nom,norm,sg" sem="" sem2=""/><ana lex="долина" gr="S,f,inan,nom,norm,sg" sem="t:space r:concr der:s t:fam" sem2=""/>долина</w>.</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="первый" gr="ANUM,loc,m,norm,sg" sem="r:ord der:num t:ord r:qual" sem2="ev:posit t:hier t:qual r:qual"/>первом</w> <w><ana lex="случай" gr="S,inan,loc,m,norm,sg" sem="pt:qtm r:abstr" sem2="t:time:moment r:abstr"/>случае</w> <w><ana lex="лес" gr="S,acc,inan,m,norm,sg" sem="pt:set t:space r:concr sc:plant" sem2="t:form pt:aggr t:stuff r:concr sc:qtm"/>лес</w> <w><ana lex="вековой" gr="A,0,norm,plen" sem="dt:abstr dt:time r:rel der:s" sem2="dt:abstr dt:time r:rel der:s"/>вековой</w>, <w><ana lex="во" gr="PR,norm" sem="" sem2=""/>во</w> <w><ana lex="второй" gr="ANUM,loc,m,norm,sg" sem="r:ord der:num r:rel t:ord" sem2="t:hier t:share r:rel der:num"/>втором</w> -- <w><ana lex="обильный" gr="A,m,nom,norm,plen,sg" sem="t:quant:max r:qual" sem2="t:quant:max r:qual"/>обильный</w> <w><ana lex="высокий" gr="A,m,nom,norm,plen,sg" sem="t:size:max r:qual" sem2="ev:posit der:shift t:size:max t:sound t:degr:max r:qual t:interpretation"/>высокий</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="низкий" gr="A,m,nom,norm,plen,sg" sem="t:size:min r:qual" sem2="t:humq t:hier t:level r:qual t:size:min t:sound ev:neg t:interpretation"/>низкий</w> <w><ana lex="кустарник" gr="S,inan,m,nom,norm,sg" sem="t:plant r:concr der:s hi:class" sem2="hi:class t:plant pt:aggr sc:plant der:s r:concr"/>кустарник</w>.</se><se> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>С</w> <w><ana lex="точка" gr="S,f,gen,inan,norm,sg" sem="der:v t:space der:s0 r:abstr t:impact r:concr" sem2="t:space t:sign r:concr r:abstr"/>точки</w> <w><ana lex="зрение" gr="S,gen,inan,n,norm,sg" sem="t:perc r:abstr" sem2=""/>зрения</w> <w><ana lex="красота" gr="S,f,gen,inan,norm,sg" sem="ev:posit t:fam r:abstr der:a" sem2="ev:posit r:abstr der:a"/>красоты</w> <w><ana lex="живой" gr="A,0,norm,plen" sem="der:v r:qual" sem2="t:humq r:qual"/>живой</w>, <w><ana lex="сильный" gr="A,f,gen,norm,plen,sg" sem="t:physq d:habit r:qual" sem2="ev:posit t:humq:char der:s t:degr:max r:qual r:rel"/>сильной</w> <w><ana lex="природа" gr="S,f,gen,inan,norm,sg" sem="pt:aggr t:space r:concr sc:space" sem2="pt:aggr t:space r:concr r:abstr sc:space"/>природы</w> <w><ana lex="здесь" gr="ADVPRO,norm" sem="t:place r:dem" sem2="t:time r:dem"/>здесь</w> <w><ana lex="удивительно" gr="ADV,norm" sem="ev:posit dt:degr t:degr:max der:a" sem2="ev:posit dt:degr der:a"/>удивительно</w> <w>хорошо</w>!</se><se> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>Так</w>, <w>кажется</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="поселиться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus d:pref" sem2=""/>поселился</w> <w><ana lex="бы" gr="PART,norm" sem="" sem2=""/>бы</w> <w><ana lex="там" gr="ADVPRO,norm" sem="t:place r:dem"