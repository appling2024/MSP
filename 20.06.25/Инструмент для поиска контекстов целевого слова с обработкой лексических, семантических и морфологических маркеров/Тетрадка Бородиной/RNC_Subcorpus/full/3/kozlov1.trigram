<p><se><w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>Мы</w> <w><ana lex="улечься" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus d:pref t:move:body" sem2="ca:noncaus d:pref"/>улеглись</w> <w><ana lex="спать" gr="V,act,inf,intr,ipf,norm" sem="d:root" sem2="d:root"/>спать</w> <w><ana lex="ровно" gr="ADV,norm" sem="ev:posit dt:physq:form der:a" sem2="dt:physq:form der:a"/>ровно</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="полночь" gr="S,acc,f,inan,norm,sg" sem="ev:posit r:abstr t:time" sem2="t:space r:concr r:abstr"/>полночь</w> <w><ana lex="после" gr="PR,norm" sem="" sem2=""/>после</w> <w><ana lex="то" gr="SPRO,gen,inan,n,norm,sg" sem="r:dem" sem2=""/>того</w>, <w><ana lex="как" gr="CONJ,norm" sem="" sem2=""/>как</w> <w><ana lex="все" gr="SPRO,inan,n,nom,norm,sg" sem="" sem2=""/>все</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="исполнить" gr="V,brev,n,norm,partcp,pass,pf,praet,sg" sem="d:pref" sem2="d:pref"/>исполнено</w>.</se></p>
<p><se><b/><w><b>4</b></w><b>/</b><w><ana lex="iv" gr="bastard" sem="" sem2=""/><b>IV</b></w><b>, </b><w><ana lex="t" gr="bastard" sem="" sem2=""/><b>T</b></w><b/>. <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="приятный" gr="A,n,nom,norm,plen,sg" sem="ev:posit r:qual" sem2="ev:posit t:humq r:qual"/>приятное</w> <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утро</w>, <w><ana lex="тихий" gr="A,n,nom,norm,plen,sg" sem="d:neg t:sound r:qual" sem2="d:neg t:humq t:speed:min der:shift t:sound r:qual"/>тихое</w>, <w><ana lex="ясный" gr="A,n,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясное</w>.</se><se> <w><ana lex="вокруг" gr="PR,norm" sem="" sem2=""/>Вокруг</w> <w><ana lex="наш" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/>нашего</w> <w><ana lex="дом" gr="S,gen,inan,m,norm,sg" sem="top:contain t:constr:build r:concr" sem2="sc:hum pt:set t:space t:org t:group der:shift r:concr"/>дома</w> <w><ana lex="воздух" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>воздух</w> <w><ana lex="застыть" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v t:changest d:pref dt:physq ca:noncaus" sem2="d:pref"/><ana lex="застынуть" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v t:changest d:pref dt:physq ca:noncaus" sem2="d:pref"/><ana lex="застынуть" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v t:changest d:pref dt:physq ca:noncaus" sem2="d:pref"/>застыл</w> -- <w><ana lex="тишина" gr="S,anim,f,famn,nom,norm,sg" sem="" sem2=""/><ana lex="тишина" gr="S,f,inan,nom,norm,sg" sem="t:neg t:sound r:abstr t:fam" sem2="r:abstr"/>тишина</w> <w><ana lex="абсолютный" gr="A,f,nom,norm,plen,sg" sem="r:rel der:s" sem2="t:degr:max:magn der:s r:qual"/>абсолютная</w>.</se><se> <w><ana lex="белый" gr="A,nom,norm,pl,plen" sem="t:physq:color r:qual" sem2="t:race dt:physq:color der:shift r:qual t:species r:rel"/>Белые</w> <w><ana lex="даль" gr="S,f,inan,nom,norm,pl" sem="t:space der:a sc:space pc:space r:concr t:fam" sem2="t:space der:a sc:space pt:aggr:aggrpl pt:aggr r:concr"/><ana lex="даль" gr="S,anim,f,famn,nom,norm,pl" sem="" sem2=""/>дали</w> <w><ana lex="открыть" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="t:impact ca:caus d:pref" sem2="t:speech ca:noncaus d:pref"/>открыты</w>.</se><se> <w><ana lex="южный" gr="A,nom,norm,pl,plen" sem="t:place dt:space r:rel der:s" sem2=""/>Южные</w> <w><ana lex="скат" gr="S,inan,m,nom,norm,pl" sem="t:animal:fish der:v pc:constr pt:part pc:part pc:space r:concr" sem2="pc:tool:transp r:concr pt:part"/><ana lex="скат" gr="S,anim,m,nom,norm,pl" sem="" sem2=""/>скаты</w> <w><ana lex="гора" gr="S,f,gen,inan,norm,pl" sem="top:hill t:space r:concr" sem2="sc:x pt:set t:space t:form r:abstr t:quant:max r:concr"/>гор</w> <w><ana lex="во" gr="PR,norm" sem="" sem2=""/>во</w> <w><ana lex="время" gr="S,acc,inan,n,norm,sg" sem="r:abstr t:param t:time" sem2="t:time:period r:abstr t:time"/>время</w> <w><ana lex="минувший" gr="A,gen,norm,pl,plen" sem="der:v r:rel dt:move t:time" sem2=""/>минувших</w> <w><ana lex="бурный" gr="A,gen,norm,pl,plen" sem="dt:weather dt:abstr der:s r:qual" sem2="dt:weather dt:abstr t:degr:max:magn der:s t:degr:max r:qual"/>бурных</w> <w><ana lex="снежный" gr="A,gen,norm,pl,plen" sem="dt:stuff r:rel der:s" sem2="t:physq:color r:qual"/>снежных</w> <w><ana lex="день" gr="S,gen,inan,m,norm,pl" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дней</w> <w><ana lex="вновь" gr="ADV,norm" sem="dt:time der:a" sem2=""/>вновь</w> <w><ana lex="покрыться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>покрылись</w> <w><ana lex="белый" gr="A,ins,m,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:race dt:physq:color der:shift r:qual t:species r:rel"/>белым</w> <w><ana lex="основательный" gr="A,ins,m,norm,plen,sg" sem="r:rel" sem2="ev:posit t:humq t:physq t:quant:max r:qual r:rel"/>основательным</w> <w><ana lex="покров" gr="S,inan,ins,m,norm,sg" sem="t:stuff t:topon qc:stuff der:v r:propn pc:x r:concr" sem2="pt:aggr:aggrpl r:abstr t:inter der:v r:concr t:tool:bedding sc:tool:cloth"/>покровом</w> <w><ana lex="снег" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2=""/>снега</w>.</se><se> <w><ana lex="однако" gr="CONJ,norm" sem="" sem2=""/>Однако</w> <w><ana lex="сегодняшний" gr="A,acc,inan,m,norm,plen,sg" sem="dt:time r:rel der:adv" sem2=""/>сегодняшний</w> <w><ana lex="теплый" gr="A,acc,inan,m,norm,plen,sg" sem="dt:temper dt:abstr t:physq:temper der:s r:qual" sem2="ev:posit t:physq:color dt:temper t:physq:temper dt:abstr der:s r:qual r:rel"/>теплый</w> <w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w> <w><ana lex="распустить" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v d:pref"/>распустил</w> <w><ana lex="вода" gr="S,f,gen,inan,norm,sg" sem="t:stuff r:concr t:liq" sem2="t:food dt:stuff t:stuff sc:reservoir t:liq sc:space r:abstr pt:aggr:aggrpl sc:qtm t:space pt:part ev:neg sc:spring pc:space r:concr der:shift"/>воды</w>, <w><ana lex="растопить" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v d:pref" sem2=""/>растопил</w> <w><ana lex="снег" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2=""/>снег</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="оголить" gr="V,act,indic,m,norm,pf,praet,sg" sem="d:pref" sem2="d:pref"/>оголил</w> <w><ana lex="значительно" gr="ADV,norm" sem="dt:size:max t:degr:max der:a" sem2="dt:size:max der:a"/>значительно</w> <w><ana lex="полуденный" gr="A,acc,inan,norm,pl,plen" sem="der:comp r:rel t:time" sem2=""/>полуденные</w> <w><ana lex="скат" gr="S,acc,inan,m,norm,pl" sem="t:animal:fish der:v pc:constr pt:part pc:part pc:space r:concr" sem2="pc:tool:transp r:concr pt:part"/>скаты</w> <w><ana lex="северный" gr="A,gen,norm,pl,plen" sem="t:place dt:space r:rel der:s" sem2=""/>северных</w> <w><ana lex="гора" gr="S,f,gen,inan,norm,pl" sem="top:hill t:space r:concr" sem2="sc:x pt:set t:space t:form r:abstr t:quant:max r:concr"/>гор</w>.</se><se> <w><ana lex="письмо" gr="S,gen,inan,n,norm,pl" sem="r:concr t:text" sem2="pt:aggr t:asp r:concr r:abstr sc:letter"/>Писем</w> <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>сегодня</w> <w><ana lex="почти" gr="ADV,norm" sem="" sem2=""/>почти</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w>, <w><ana lex="если" gr="CONJ,norm" sem="" sem2=""/>если</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="считать" gr="V,act,inf,norm,pf" sem="der:v d:pref" sem2="der:v t:ment d:pref ca:noncaus"/><ana lex="считать" gr="V,act,inf,ipf,norm,tran" sem="der:v d:pref" sem2="der:v t:ment d:pref ca:noncaus"/><ana lex="считать" gr="V,act,inf,norm,pf,tran" sem="der:v d:pref" sem2="der:v t:ment d:pref ca:noncaus"/><ana lex="считать" gr="V,act,inf,ipf,norm,tran" sem="der:v d:pref" sem2="der:v t:ment d:pref ca:noncaus"/>считать</w> <w><ana lex="павлов" gr="S,anim,famn,gen,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Павлова</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="пахомов" gr="S,acc,anim,famn,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Пахомова</w>, <w><ana lex="получить" gr="V,act,gen,norm,partcp,pf,pl,plen,praet" sem="ca:noncaus t:poss" sem2=""/>получивших</w> <w><ana lex="местный" gr="A,acc,inan,norm,pl,plen" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s"/>местные</w> <w><ana lex="письмо" gr="S,acc,inan,n,norm,pl" sem="r:concr t:text" sem2="pt:aggr t:asp r:concr r:abstr sc:letter"/>письма</w>.</se><se> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>И</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="мой" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>мой</w> <w><ana lex="пшевик" gr="S,anim,bastard,m,nom,sg" sem="" sem2=""/>Пшевик</w> <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>сегодня</w>, <w><ana lex="как" gr="ADVPRO,norm" sem="r:rel t:manner" sem2=""/>как</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="вчера" gr="ADV,norm" sem="t:time" sem2=""/>вчера</w>, <w><ana lex="усердно" gr="ADV,norm" sem="ev:posit dt:humq der:a" sem2=""/>усердно</w> <w><ana lex="сидеть" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:noncaus"/>сидели</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="писание" gr="S,inan,ins,n,norm,sg" sem="der:v r:abstr der:s0 t:impact:creat" sem2="der:v ev r:concr t:text"/>писанием</w> <w><ana lex="отчет" gr="S,gen,inan,m,norm,pl" sem="t:speech der:v r:abstr der:s0" sem2="t:speech r:abstr"/>отчетов</w>.</se><se> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>У</w> <w><ana lex="я" gr="SPRO,1p,gen,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="оставаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="d:pref" sem2=""/>остается</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w>много</w> <w><ana lex="работа" gr="S,f,gen,inan,norm,sg" sem="der:v r:abstr" sem2="sc:x t:text t:workdram t:workmus r:abstr t:workart der:v pt:aggr t:workcin r:concr"/>работы</w> <w><ana lex="впереди" gr="ADV,norm" sem="t:place der:s" sem2="der:s t:time"/>впереди</w>, <w>пожалуй</w>, <w><ana lex="завтра" gr="ADV,norm" sem="t:time" sem2=""/>завтра</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="окончить" gr="V,1p,act,fut,indic,norm,pf,sg" sem="der:v d:pref" sem2=""/>окончу</w>.</se><se> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>Не</w> <w><ana lex="знать" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/>знаю</w>, <w><ana lex="что" gr="SPRO,inan,ins,n,norm,sg" sem="r:rel" sem2=""/>чем</w> <w><ana lex="заняться" gr="V,act,inf,intr,norm,pf" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref"/>заняться</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w>дальнейшем</w>.</se></p>
<p><se><w><ana lex="подле" gr="PR,norm" sem="" sem2=""/>Подле</w> <w><ana lex="наш" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/>нашего</w> <w><ana lex="лагерь" gr="S,gen,inan,m,norm,sg" sem="t:space r:concr" sem2="t:group pt:set t:space r:concr sc:hum"/>лагеря</w> <w><ana lex="ежедневно" gr="ADV,norm" sem="t:freq dt:time der:a" sem2=""/>ежедневно</w> <w><ana lex="происходить" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:be:exist ca:noncaus d:pref" sem2="t:be:exist ca:noncaus d:pref"/>происходит</w> <w><ana lex="учение" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr der:s0" sem2="t:action pt:aggr r:abstr"/>учение</w> <w><ana lex="монгольский" gr="A,gen,norm,pl,plen" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>монгольских</w> <w><ana lex="цирик" gr="S,anim,gen,m,norm,pl" sem="t:hum r:propn t:famn" sem2=""/>цириков</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="долина" gr="S,f,inan,loc,norm,sg" sem="t:space r:concr der:s t:fam" sem2=""/>долине</w> -- <w><ana lex="молодежь" gr="S,f,gen,inan,norm,sg" sem="sc:hum pt:aggr r:concr der:a" sem2=""/>молодежи</w>, <w><ana lex="монгольский" gr="A,gen,norm,pl,plen" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>монгольских</w> <w><ana lex="юнкер" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr" sem2="t:hum r:concr"/>юнкеров</w>, <w><ana lex="одеть" gr="V,gen,norm,partcp,pass,pf,pl,plen,praet" sem="d:pref" sem2="d:pref"/>одетых</w> <w><ana lex="довольно" gr="ADV,norm" sem="t:degr dt:humq der:a" sem2="ev:posit dt:humq der:a"/>довольно</w> <w><ana lex="прилично" gr="ADV,norm" sem="t:quant:max ev:posit der:a" sem2="ev:posit der:a"/>прилично</w>, <w>щеголевато</w>!</se></p>
