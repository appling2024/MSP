<p><se><w><ana lex="наш" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>Наши</w> <w><ana lex="сосед" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr" sem2="t:hum r:concr"/>соседи</w>, <w><ana lex="учитывать" gr="V,act,ger,ipf,norm,praes,tran" sem="der:v d:pref d:impf" sem2=""/>учитывая</w> <w><ana lex="подходящий" gr="A,acc,inan,m,norm,plen,sg" sem="der:v r:rel dt:move" sem2=""/>подходящий</w> <w><ana lex="момент" gr="S,acc,inan,m,norm,sg" sem="pt:qtm t:time:moment r:abstr pc:time" sem2="r:abstr"/>момент</w>, <w><ana lex="спешить" gr="V,3p,act,fut,indic,norm,pf,pl" sem="der:v" sem2="der:v"/><ana lex="спешить" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v" sem2="der:v"/><ana lex="спешить" gr="V,3p,act,fut,indic,norm,pf,pl,tran" sem="der:v" sem2="der:v"/><ana lex="спешить" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="der:v" sem2="der:v"/>спешат</w> <w><ana lex="со" gr="PR,norm" sem="" sem2=""/>со</w> <w><ana lex="свой" gr="APRO,ins,m,norm,sg" sem="r:poss" sem2="t:social r:poss"/>своим</w> <w><ana lex="отъезд" gr="S,inan,ins,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="t:move r:abstr"/>отъездом</w>.</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="конец" gr="S,inan,loc,m,norm,sg" sem="pt:phase r:concr r:abstr pt:part pc:x" sem2="top:rope t:tool t:space t:be:disapp r:abstr ev:neg r:concr"/>конце</w> <w><ana lex="конец" gr="S,gen,inan,m,norm,pl" sem="pt:phase r:concr r:abstr pt:part pc:x" sem2="top:rope t:tool t:space t:be:disapp r:abstr ev:neg r:concr"/>концов</w>, <w>можно</w> <w><ana lex="получить" gr="V,act,inf,norm,pf" sem="ca:noncaus t:poss" sem2=""/>получить</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="центр" gr="S,gen,inan,m,norm,sg" sem="t:space r:concr pc:form:geom pt:part" sem2="pc:org t:space pc:hum pc:animal t:org pt:set pt:partb:organ pc:x pt:part sc:cell2 r:concr"/>Центра</w> <w><ana lex="самый" gr="APRO,n,nom,norm,sg" sem="r:spec" sem2="r:spec"/>самое</w> <w><ana lex="невероятный" gr="A,n,nom,nor