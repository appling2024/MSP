<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="я" gr="SPRO,1p,acc,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="навестить" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2=""/>навестил</w> <w><ana lex="представитель" gr="S,anim,m,nom,norm,sg" sem="der:v t:hum r:concr d:nag" sem2="der:v t:hum r:concr d:nag"/>представитель</w> <w><ana lex="молодежь" gr="S,f,gen,inan,norm,sg" sem="sc:hum pt:aggr r:concr der:a" sem2=""/>молодежи</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="выражение" gr="S,inan,ins,n,norm,sg" sem="t:speech der:v r:abstr der:s0" sem2="der:v t:speech r:concr r:abstr t:text"/>выражением</w> <w><ana lex="благодарность" gr="S,f,gen,inan,norm,sg" sem="der:a r:abstr t:behav" sem2="t:speech t:psych:emot r:abstr der:a"/>благодарности</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="подарок" gr="S,acc,inan,m,norm,sg" sem="der:v t:thing r:concr" sem2="t:thing ev:posit r:concr r:abstr"/>подарок</w>.</se><se> <w><ana lex="молодой" gr="A,0,norm,plen" sem="t:time:age r:qual" sem2="t:time:age r:qual"/>Молодой</w> <w><ana lex="человек" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr" sem2="t:hum ev:posit r:concr"/>человек</w>, <w><ana lex="благодаря" gr="PR,norm" sem="" sem2=""/>благодаря</w> <w><ana lex="я" gr="SPRO,1p,gen,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="внимание" gr="S,acc,inan,n,norm,sg" sem="t:ment r:abstr" sem2="r:abstr"/>внимание</w>, <w><ana lex="возложить" gr="V,act,indic,m,norm,pf,praet,sg" sem="t:put ca:caus der:v d:pref" sem2="der:v d:pref"/>возложил</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="мой" gr="APRO,acc,inan,norm,pl" sem="r:poss" sem2=""/>мои</w> <w><ana lex="рука" gr="S,acc,f,inan,norm,pl" sem="pt:partb r:concr pc:hum" sem2="sc:hum t:asp r:abstr pt:aggr:aggrpl t:dir r:concr"/>руки</w> <w><ana lex="хадак" gr="S,bastard,inan,m,nom,sg