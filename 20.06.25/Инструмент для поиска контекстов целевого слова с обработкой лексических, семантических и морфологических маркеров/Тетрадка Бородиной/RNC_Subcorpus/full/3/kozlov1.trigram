<p><se><w><ana lex="вечер" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечер</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="пшевочка" gr="S,anim,bastard,ins,m,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Пшевочкой</w> <w><ana lex="провести" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="провести" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="проводить" gr="V,act,indic,norm,pf,pl,praet" sem="ca:caus t:move d:pref" sem2="d:pref"/>провели</w> <w><ana lex="дома" gr="ADV,norm" sem="t:place der:s" sem2=""/>дома</w>.</se><se> <w><ana lex="мой" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>Мои</w> <w><ana lex="препаратор" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr der:s" sem2=""/>препараторы</w> «<w><ana lex="делать" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="d:root" sem2="d:root"/>делали</w> <w><ana lex="птица" gr="S,anim,f,gen,norm,pl" sem="t:animal r:concr hi:class" sem2=""/>птиц</w>», <w>т</w>.<w>е</w>. <w><ana lex="мастерить" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="ca:caus t:impact:creat" sem2=""/>мастерили</w> <w><ana lex="шкурка" gr="S,acc,f,inan,norm,pl" sem="qc:stuff d:dim pc:animal r:concr der:s" sem2="t:stuff r:concr der:s pc:gruit"/>шкурки</w>.</se><se> <w><ana lex="понемногу" gr="ADV,norm" sem="t:quant:min der:adv" sem2="der:adv"/>Понемногу</w> <w><ana lex="начинать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="aux:phase d:pref" sem2="d:pref"/>начинает</w> <w><ana lex="копиться" gr="V,act,inf,intr,ipf,norm" sem="ca:noncaus" sem2=""/><ana lex="копиться" gr="V,act,inf,intr,ipf,norm" sem="ca:noncaus" sem2=""/>копиться</w> <w><ana lex="научный" gr="A,acc,inan,m,norm,plen,sg" sem="r:rel der:s" sem2="r:rel der:s"/>научный</w> <w><ana lex="материал" gr="S,acc,inan,m,norm,sg" sem="t:stuff r:concr" sem2="t:stuff t:text hi:class r:abstr sc:doc r:concr"/>материал</w>.</se></p>
<p><se><w><ana lex="один" gr="APRO,m,nom,norm,sg" sem="" sem2="r:indet"/>Один</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="мой" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/>моих</w> <w><ana lex="мальчик" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr" sem2="t:hum r:concr"/>мальчиков</w> <w><ana lex="мастерить" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="ca:caus t:impact:creat" sem2=""/>мастерил</w> <w><ana lex="съемка" gr="S,acc,f,inan,norm,sg" sem="der:v r:abstr der:s0" sem2="r:abstr"/>съемку</w> (<w><ana lex="андрюша" gr="S,anim,m,nom,norm,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Андрюша</w>).</se></p>
<p><se><b/><w><b>8-9</b></w><b>/</b><w><ana lex="x" gr="bastard" sem="" sem2=""/><b>X</b></w><b>, </b><w><ana lex="r" gr="bastard" sem="" sem2=""/><b>R</b></w><b> </b><w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <b/><w><ana lex="u" gr="bastard" sem="" sem2=""/><b>U</b></w><b/>. <w><ana lex="вчера" gr="ADV,norm" sem="t:time" sem2=""/>Вчера</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <b/><w><ana lex="r" gr="bastard" sem="" sem2=""/><b>R</b></w><b/>, <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="осмотреть" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v d:pref" sem2="der:v d:pref"/>осмотрел</w> <w><ana lex="весь" gr="APRO,acc,inan,m,norm,sg" sem="r:spec" sem2=""/>весь</w> <w><ana lex="лагерь" gr="S,acc,inan,m,norm,sg" sem="t:space r:concr" sem2="t:group pt:set t:space r:concr sc:hum"/>лагерь</w>, <w><ana lex="посмотреть" gr="V,act,indic,m,norm,pf,praet,sg,tran" sem="ca:noncaus d:pref t:perc" sem2="d:pref"/>посмотрел</w> <w><ana lex="также" gr="PART,norm" sem="" sem2=""/>также</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="вещь" gr="S,f,inan,nom,norm,pl" sem="t:thing r:concr" sem2="sc:thing t:text t:workdram t:workmus t:workart r:abstr t:thing t:workcin r:concr"/>вещи</w> <w><ana lex="наш" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/>нашего</w> <w><ana lex="спутник" gr="S,anim,gen,m,norm,sg" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,gen,inan,m,norm,sg" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутника</w> <w><ana lex="лама" gr="S,anim,nom,norm,pl" sem="t:hum t:animal r:concr" sem2=""/>ламы-тибетца</w>: <w><ana lex="несколько" gr="NUM,nom,norm" sem="" sem2=""/>несколько</w> <w><ana lex="винтовка" gr="S,f,gen,inan,norm,pl" sem="t:tool:weapon r:concr der:s" sem2=""/>винтовок</w>, <w><ana lex="патрон" gr="S,acc,inan,m,norm,pl" sem="t:tool:shell r:concr" sem2="t:tool top:cylinder pt:part top:tube r:concr pc:tool"/>патроны</w>, <w><ana lex="один" gr="APRO,m,nom,norm,sg" sem="" sem2="r:indet"/>один</w> <w><ana lex="пулемет" gr="S,inan,m,nom,norm,sg" sem="der:comp t:tool:weapon r:concr" sem2=""/>пулемет</w> (<w><ana lex="старый" gr="A,m,nom,norm,plen,sg" sem="t:time:age:max r:qual" sem2="t:time:dur t:time r:qual"/>старый</w> <w><ana lex="японский" gr="A,m,nom,norm,plen,sg" sem="dt:hum:etn r:rel der:s" sem2=""/>японский</w>, <w><ana lex="система" gr="S,f,gen,inan,norm,sg" sem="pt:set r:abstr" sem2="sc:org r:abstr pt:set t:tool:device pt:aggr r:concr"/>системы</w> <w><ana lex="tock" gr="bastard" sem="" sem2=""/>Tock</w>), <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="все" gr="SPRO,inan,n,nom,norm,sg" sem="" sem2=""/>все</w>.</se><se> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>На</w> <w><ana lex="основание" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr der:s0 t:be:appear" sem2="t:stuff hi:class r:abstr pc:x pt:part r:concr pc:form:geom"/>основании</w> <w><ana lex="отметить" gr="V,gen,m,norm,partcp,pass,pf,plen,praet,sg" sem="d:pref" sem2="d:pref"/>отмеченного</w> <w><ana lex="явствовать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:s" sem2=""/>явствует</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="военный" gr="A,nom,norm,pl,plen" sem="dt:abstr dt:inter r:rel der:s" sem2="dt:abstr dt:inter r:rel der:s"/>военные</w> <w><ana lex="принадлежность" gr="S,f,inan,nom,norm,pl" sem="der:v r:abstr der:s0 t:poss" sem2="der:v t:access r:concr r:abstr"/>принадлежности</w> <w><ana lex="вообще" gr="ADV,PARENTH,norm" sem="dt:general der:a" sem2=""/>вообще</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="тибет" gr="S,inan,loc,m,norm,sg" sem="r:propn t:topon" sem2=""/>Тибете</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="почет" gr="S,inan,loc,m,norm,sg" sem="ev:posit r:abstr" sem2=""/>почете</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="что" gr="SPRO,inan,n,nom,norm,sg" sem="r:rel" sem2=""/>что</w>, <w><ana lex="невзирая" gr="ADV,norm" sem="der:v" sem2=""/>невзирая</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="больший" gr="A,acc,inan,norm,pl,plen" sem="d:compar t:size:max der:a dt:size:max r:qual" sem2=""/><ana lex="большой" gr="A,acc,inan,norm,pl,plen" sem="t:size:max r:qual" sem2="t:quant:max t:time:age t:degr:max r:qual"/>большие</w> <w><ana lex="трудность" gr="S,acc,f,inan,norm,pl" sem="r:abstr der:a" sem2="r:abstr der:a"/>трудности</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="дорога" gr="S,dat,f,inan,norm,sg" sem="top:stripe t:space r:concr t:fam" sem2="t:move dt:space r:abstr der:shift t:space r:concr"/>дороге</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="тибет" gr="S,gen,inan,m,norm,sg" sem="r:propn t:topon" sem2=""/>Тибета</w>, <w><ana lex="то" gr="SPRO,inan,ins,n,norm,sg" sem="r:dem" sem2=""/>тем</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="менее" gr="ADV,norm" sem="t:degr:min der:adv" sem2="t:degr:min der:adv"/>менее</w> <w>необходимо</w> <w><ana lex="они" gr="SPRO,acc,anim,norm,pl" sem="r:pers" sem2=""/>их</w> <w><ana lex="везти" gr="V,act,inf,ipf,norm" sem="ca:caus t:move d:root ca:noncaus" sem2="ca:caus d:root"/>везти</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="главный" gr="A,gen,m,norm,plen,sg" sem="t:hier r:qual" sem2="t:hier r:qual"/>главного</w> <w><ana lex="пункт" gr="S,gen,inan,m,norm,sg" sem="t:space r:concr" sem2="t:text pt:phase r:abstr t:org der:shift pt:part pc:text r:concr"/>пункта</w>.</se><se> <w><ana lex="именно" gr="PART,norm" sem="" sem2=""/>Именно</w> <w><ana lex="этот" gr="APRO,n,nom,norm,sg" sem="r:dem" sem2=""/>это</w> <w><ana lex="обстоятельство" gr="S,inan,n,nom,norm,sg" sem="t:word r:concr r:abstr" sem2="r:abstr"/>обстоятельство</w> <w><ana lex="мочь" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="d:root" sem2=""/>может</w> <w><ana lex="выручить" gr="V,act,inf,norm,pf" sem="d:pref" sem2="d:pref"/>выручить</w> <w><ana lex="экспедиция" gr="S,acc,f,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедицию</w> <w><ana lex="большой" gr="A,comp,norm,plen" sem="t:size:max r:qual" sem2="t:quant:max t:time:age t:degr:max r:qual"/>больше</w> <w>прочих</w>, <w><ana lex="то" gr="SPRO,inan,ins,n,norm,sg" sem="r:dem" sem2=""/>тем</w> <w><ana lex="много" gr="ADV,comp,norm" sem="t:quant:max r:spec" sem2="t:degr:max"/><ana lex="более" gr="ADV,norm" sem="t:degr:max der:adv" sem2="t:degr:max"/>более</w> <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="обо" gr="PR,norm" sem="" sem2=""/>обо</w> <w><ana lex="весь" gr="APRO,loc,n,norm,sg" sem="r:spec" sem2=""/>всем</w> <w><ana lex="это" gr="SPRO,inan,loc,n,norm,sg" sem="r:dem" sem2=""/>этом</w> <w><ana lex="узко" gr="ADV,comp,norm" sem="dt:size:min der:a" sem2="dt:size:min der:a"/><ana lex="уже" gr="ADV,norm" sem="t:time" sem2=""/>уже</w> <w><ana lex="писаться" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="der:v ca:noncaus" sem2="der:v ca:noncaus"/><ana lex="писаться" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="der:v ca:noncaus" sem2="der:v ca:noncaus"/>писалось</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="тибет" gr="S,inan,m,nom,norm,sg" sem="r:propn t:topon" sem2=""/>Тибет</w> <w><ana lex="далай" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Далай-ламе</w> <w><ana lex="мой" gr="APRO,ins,m,norm,sg" sem="r:poss" sem2=""/>моим</w> <w><ana lex="друг" gr="S,anim,ins,m,norm,sg" sem="t:hum r:concr" sem2="t:hum r:concr"/>другом</w> <w><ana lex="агван" gr="S,anim,ins,m,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Агваном</w> <w><ana lex="доржиев" gr="S,anim,famn,ins,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Доржиевым</w>.</se></p>
<p><se><w>Надо</w> <w><ana lex="обстоятельно" gr="ADV,norm" sem="dt:humq der:a" sem2=""/>обстоятельно</w> <w><ana lex="наладить" gr="V,act,inf,norm,pf" sem="d:pref" sem2="d:pref"/>наладить</w> <w><ana lex="весь" gr="APRO,acc,inan,norm,pl" sem="r:spec" sem2=""/>все</w> <w><ana lex="вьюк" gr="S,acc,inan,m,norm,pl" sem="sc:thing der:v t:tool top:contain pt:qtm pt:set r:concr" sem2=""/>вьюки</w>, <w><ana lex="все" gr="ADV,norm" sem="" sem2=""/>все</w> <w><ana lex="осмотреть" gr="V,act,inf,norm,pf" sem="der:v d:pref" sem2="der:v d:pref"/>осмотреть</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="тогда" gr="ADVPRO,norm" sem="t:time r:dem" sem2="r:dem"/>тогда</w> <w><ana lex="лишь" gr="PART,norm" sem="" sem2=""/>лишь</w> <w><ana lex="думать" gr="V,act,inf,intr,ipf,norm" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/><ana lex="думать" gr="V,act,inf,ipf,norm,tran" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/>думать</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="начало" gr="S,inan,loc,n,norm,sg" sem="pt:phase r:abstr pc:x pt:part pc:pc:x r:concr" sem2="t:asp r:abstr pt:part"/>начале</w> <w><ana lex="вьючок" gr="S,inan,m,nom,norm,pl" sem="" sem2=""/>вьючки</w> <w><ana lex="караван" gr="S,gen,inan,m,norm,sg" sem="pt:set r:concr sc:animal" sem2="pt:set sc:tool:transp sc:stuff r:concr sc:aggr"/>каравана</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="об" gr="PR,norm" sem="" sem2=""/>об</w> <w><ana lex="отправление" gr="S,inan,loc,n,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="der:v r:concr t:text"/>отправлении</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="далекий" gr="A,acc,f,norm,plen,sg" sem="t:dist:max r:qual" sem2="dt:dist:max der:shift t:time t:humq r:qual"/>далекую</w> <w><ana lex="дорога" gr="S,acc,f,inan,norm,sg" sem="top:stripe t:space r:concr t:fam" sem2="t:move dt:space r:abstr der:shift t:space r:concr"/>дорогу</w>.</se></p>
<p><se><w><ana lex="мой" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>Мои</w> <w><ana lex="ребята" gr="S,anim,nom,norm,pl" sem="" sem2=""/>ребята</w> <w><ana lex="все" gr="ADV,norm" sem="" sem2=""/>все</w> <w><ana lex="нет" gr="ADV,PRAEDIC,norm" sem="" sem2=""/>нет-нет</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="недомогать" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v d:pref" sem2=""/>недомогают</w>: <w><ana lex="кто" gr="SPRO,anim,m,nom,norm,sg" sem="r:rel" sem2=""/>кто</w> <w><ana lex="жаловаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:speech ca:noncaus" sem2="ca:noncaus"/>жалуется</w> <w><ana lex="ухо" gr="S,inan,ins,n,norm,sg" sem="pt:partb pc:animal r:concr pc:hum" sem2="t:tool pc:tool:cloth r:abstr top:form t:perc pt:part r:concr pc:tool"/>ухом</w>, <w><ana lex="кто" gr="SPRO,anim,m,nom,norm,sg" sem="r:rel" sem2=""/>кто</w> <w><ana lex="стереть" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus t:impact:destr t:be:disapp d:pref" sem2="t:impact ca:caus der:v d:pref"/>стер</w> <w><ana lex="нога" gr="S,acc,f,inan,norm,pl" sem="pt:partb r:concr pc:hum" sem2="r:concr pc:tool:furn pt:part pc:tool:device"/>ноги</w>, <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="кто" gr="SPRO,anim,gen,m,norm,sg" sem="r:rel" sem2=""/>кого</w> <w><ana lex="разбросать" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v d:pref"/><ana lex="разбросить" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="der:v t:move d:pref" sem2=""/>разбросаны</w> <w><ana lex="чирей" gr="S,inan,m,nom,norm,pl" sem="pt:spotb pc:hum r:concr" sem2=""/>чирьи</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="кто" gr="SPRO,anim,ins,m,norm,sg" sem="r:rel" sem2=""/>кем</w> -- <w><ana lex="вроде" gr="PR,norm" sem="" sem2=""/>вроде</w> <w><ana lex="удар" gr="S,gen,inan,m,norm,sg" sem="t:impact pt:qtm r:abstr" sem2="pc:sound pt:qtm r:abstr ev:neg t:sound:asp t:disease pc:move"/>удара</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="проч" gr="S,anim,bastard,m,nom,sg" sem="" sem2=""/><ana lex="проча" gr="S,bastard,f,gen,inan,pl" sem="" sem2=""/>проч</w>.</se><se>, <w><ana lex="проч" gr="S,anim,bastard,m,nom,sg" sem="" sem2=""/>проч</w>.</se><se> <w><ana lex="всегда" gr="ADVPRO,norm" sem="r:spec t:time" sem2=""/>Всегда</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="бывать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:be:exist ca:noncaus der:v d:impf" sem2="der:v t:loc der:shift d:impf ca:noncaus"/>бывает</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="место" gr="S,inan,loc,n,norm,sg" sem="qc:space t:space r:concr" sem2="qc:space sc:org t:tool t:space pt:element r:abstr pt:aggr:aggrpl pt:part pc:text r:concr"/>месте</w>, <w><ana lex="тогда" gr="ADVPRO,norm" sem="t:time r:dem" sem2="r:dem"/>тогда</w> <w><ana lex="как" gr="ADVPRO,norm" sem="r:rel t:manner" sem2=""/>как</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="дорога" gr="S,f,inan,loc,norm,sg" sem="top:stripe t:space r:concr t:fam" sem2="t:move dt:space r:abstr der:shift t:space r:concr"/>дороге</w> <w><ana lex="совершенно" gr="ADV,norm" sem="dt:degr:max t:degr:max der:a" sem2=""/>совершенно</w> <w>иначе</w>: <w><ana lex="хотеть" gr="V,2p,act,indic,ipf,norm,praes,sg,tran" sem="ca:noncaus t:psych:volit d:root" sem2="d:root"/>хочешь</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="хотеть" gr="V,2p,act,indic,ipf,norm,praes,sg,tran" sem="ca:noncaus t:psych:volit d:root" sem2="d:root"/>хочешь</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="делать" gr="V,act,inf,ipf,norm,tran" sem="d:root" sem2="d:root"/>делать</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="идти" gr="V,act,inf,intr,ipf,norm" sem="ca:noncaus t:move d:root" sem2="ca:noncaus t:move d:root"/>идти</w> <w>надо</w>.</se><se> <w><ana lex="бывать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:be:exist ca:noncaus der:v d:impf" sem2="der:v t:loc der:shift d:impf ca:noncaus"/>Бывает</w> <w><ana lex="нередко" gr="ADV,norm" sem="t:freq der:a" sem2=""/>нередко</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="трудный" gr="A,nom,norm,pl,plen" sem="r:qual" sem2="t:humq ev r:qual"/>трудные</w> <w><ana lex="заболевание" gr="S,inan,n,nom,norm,pl" sem="der:v r:abstr pt:class t:disease" sem2="der:v pc:disease pt:qtm r:abstr"/>заболевания</w> <w><ana lex="проходить" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="der:v ca:noncaus t:move d:pref" sem2=""/><ana lex="проходить" gr="V,3p,act,fut,indic,norm,pf,pl,tran" sem="der:v ca:noncaus t:move d:pref" sem2=""/><ana lex="проходить" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v ca:noncaus t:move d:pref" sem2=""/><ana lex="проходить" gr="V,3p,act,fut,indic,intr,norm,pf,pl" sem="der:v ca:noncaus t:move d:pref" sem2=""/><ana lex="пройти" gr="V,3p,act,fut,indic,intr,norm,pf,pl" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/>проходят</w> <w><ana lex="легко" gr="ADV,norm" sem="dt:physq:weight ev der:a" sem2=""/>легко</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="дорога" gr="S,dat,f,inan,norm,sg" sem="top:stripe t:space r:concr t:fam" sem2="t:move dt:space r:abstr der:shift t:space r:concr"/>дороге</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="бесконечно" gr="ADV,norm" sem="dt:time:dur t:degr:max der:a" sem2=""/>бесконечно</w> <w><ana lex="тянуться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v t:changest ca:noncaus" sem2="der:v ca:noncaus t:move"/>тянутся</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="место" gr="S,inan,loc,n,norm,sg" sem="qc:space t:space r:concr" sem2="qc:space sc:org t:tool t:space pt:element r:abstr pt:aggr:aggrpl pt:part pc:text r:concr"/>месте</w>, <w><ana lex="чем" gr="CONJ,norm" sem="" sem2=""/>чем</w> <w><ana lex="это" gr="SPRO,acc,inan,n,norm,sg" sem="r:dem" sem2=""/>это</w> <w><ana lex="объяснить" gr="V,act,inf,norm,pf" sem="t:speech ca:noncaus d:pref" sem2=""/>объяснить</w> -- <w>неизвестно</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="это" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>это</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w>.</se></p>
<p><se><w><ana lex="с" gr="PR,norm" sem="" sem2=""/>С</w> <w><ana lex="8" gr="NUM,ciph"/>8</w>/<w><ana lex="x" gr="bastard" sem="" sem2=""/>X</w> <w><ana lex="настать" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="d:pref" sem2=""/>настала</w> <w><ana lex="чудный" gr="A,f,nom,norm,plen,sg" sem="dt:abstr ev:posit r:rel" sem2="dt:abstr ev:posit t:quality der:s r:qual"/><ana lex="чудной" gr="A,f,nom,norm,plen,sg" sem="dt:abstr t:humq ev:neg r:qual" sem2=""/>чудная</w> <w><ana lex="ясный" gr="A,f,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясная</w>, <w><ana lex="тихий" gr="A,f,nom,norm,plen,sg" sem="d:neg t:sound r:qual" sem2="d:neg t:humq t:speed:min der:shift t:sound r:qual"/>тихая</w> <w><ana lex="погода" gr="S,f,inan,nom,norm,sg" sem="r:abstr t:weather" sem2=""/>погода</w>, <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="думать" gr="V,1p,act,indic,intr,ipf,norm,praes,sg" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/><ana lex="думать" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/>думаю</w>, <w><ana lex="тот" gr="APRO,f,nom,norm,sg" sem="r:dem" sem2=""/>та</w> <w><ana lex="прославить" gr="V,f,nom,norm,partcp,pass,pf,plen,praet,sg" sem="d:pref" sem2=""/>прославленная</w> <w><ana lex="осенний" gr="A,f,nom,norm,plen,sg" sem="dt:time dt:abstr dt:time:season der:s t:time r:rel" sem2=""/>осенняя</w>, <w><ana lex="чем" gr="CONJ,norm" sem="" sem2=""/>чем</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="славиться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus" sem2=""/><ana lex="славиться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus" sem2=""/>славится</w> <w><ana lex="вообще" gr="ADV,PARENTH,norm" sem="dt:general der:a" sem2=""/>вообще</w> <w><ana lex="центральный" gr="A,f,nom,norm,plen,sg" sem="t:place dt:space r:rel der:s" sem2="dt:space t:hier r:rel der:s"/>Центральн