<p><se><w><ana lex="наш" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>Наш</w> <w><ana lex="багаж" gr="S,inan,m,nom,norm,sg" sem="sc:thing pt:aggr r:concr" sem2="pt:set der:shift"/>багаж</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="порядок" gr="S,inan,loc,m,norm,sg" sem="ev:posit r:abstr" sem2="sc:hum ev:posit r:concr r:abstr t:asp:move"/>порядке</w>, <w><ana lex="все" gr="SPRO,inan,n,nom,norm,sg" sem="" sem2=""/>все</w> <w><ana lex="удобный" gr="A,brev,n,norm,sg" sem="r:qual" sem2="ev:posit r:qual"/>удобно</w>, <w><ana lex="приличный" gr="A,brev,n,norm,sg" sem="r:qual" sem2="ev:posit t:degr:max r:qual"/>прилично</w>!</se></p>
<p><se><w><ana lex="какой" gr="APRO,acc,n,norm,sg" sem="t:neg r:rel ev:neg" sem2=""/>Какое</w> <w><ana lex="удовольствие" gr="S,acc,inan,n,norm,sg" sem="t:psych:emot r:abstr" sem2="ev:posit r:abstr"/>удовольствие</w> <w><ana lex="быть" gr="V,act,inf,intr,ipf,norm" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>быть</w> <w>теперь</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="юрта" gr="S,f,inan,loc,norm,sg" sem="top:contain t:constr r:concr" sem2=""/>юрте</w> <w><ana lex="младший" gr="A,gen,norm,pl,plen" sem="r:qual" sem2="t:hier r:rel"/>младших</w> <w><ana lex="спутник" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,gen,inan,m,norm,pl" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутников</w>: <w><ana lex="тишина" gr="S,anim,f,famn,nom,norm,sg" sem="" sem2=""/><ana lex="тишина" gr="S,f,inan,nom,norm,sg" sem="t:neg t:sound r:abstr t:fam" sem2="r:abstr"/>тишина</w>, <w><ana lex="приличие" gr="S,inan,n,nom,norm,sg" sem="ev:posit r:abstr der:a" sem2="r:abstr"/>приличие</w>, <w><ana lex="весь" gr="APRO,nom,norm,pl" sem="r:spec" sem2=""/>все</w> <w><ana lex="лицо" gr="S,inan,n,nom,norm,pl" sem="pt:partb r:concr pc:hum" sem2="pc:tool:cloth t:space r:concr r:abstr"/><ana lex="лицо" gr="S,anim,n,nom,norm,pl" sem="" sem2="t:hum r:concr hi:class"/>лица</w> <w><ana lex="дышать" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus t:physiol d:root" sem2="d:root"/>дышат</w> <w><ana lex="ласковый" gr="A,ins,m,norm,plen,sg" sem="ev:posit t:humq dt:abstr dt:manif:emot der:s r:qual" sem2=""/>ласковым</w> <w><ana lex="привет" gr="S,inan,ins,m,norm,sg" sem="r:abstr" sem2="t:speech r:abstr"/>приветом</w>, <w><ana lex="все" gr="ADV,norm" sem="" sem2=""/>все</w> <w><ana lex="милый" gr="A,brev,norm,pl" sem="t:humq r:qual" sem2="ev:posit t:social:emot r:qual"/>милы</w>, <w><ana lex="ни" gr="CONJ,norm" sem="" sem2=""/>ни</w> <w><ana lex="тень" gr="S,f,inan,nom,norm,pl" sem="t:space r:concr" sem2="t:stuff t:light t:hum:supernat pc:hum r:abstr t:space pt:part pt:spotb r:concr"/><ana lex="тень" gr="S,anim,f,nom,norm,pl" sem="" sem2="t:hum ev r:concr"/>тени</w> <w><ana lex="угрюмство" gr="S,bastard,gen,inan,n,sg" sem="" sem2=""/>угрюмства</w>.</se><se> <w><ana lex="весь" gr="APRO,f,nom,norm,sg" sem="r:spec" sem2=""/>Вся</w> <w><ana lex="компания" gr="S,f,inan,nom,norm,sg" sem="t:group pt:set r:concr sc:hum" sem2="r:concr t:org"/>компания</w> (<w><ana lex="последний" gr="A,f,nom,norm,plen,sg" sem="r:rel t:ord" sem2="t:degr:max:magn r:qual r:rel ev:neg t:time"/>последняя</w>), «<w><ana lex="милый" gr="A,f,nom,norm,plen,sg" sem="t:humq r:qual" sem2="ev:posit t:social:emot r:qual"/>милая</w> <w><ana lex="троица" gr="S,f,inan,nom,norm,sg" sem="t:topon sc:hum:supernat pt:set r:propn der:s r:concr" sem2="pt:set r:abstr t:group sc:hum t:numcoll ev r:concr der:s"/>троица</w>», <w><ana lex="как" gr="ADVPRO,norm" sem="r:rel t:manner" sem2=""/>как</w> <w><ana lex="удачно" gr="ADV,norm" sem="" sem2="ev:posit der:a"/>удачно</w> <w><ana lex="назвать" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus d:pref" sem2="der:v t:speech d:pref ca:noncaus"/>назвал</w> <w><ana lex="она" gr="SPRO,3p,acc,f,norm,sg" sem="r:pers" sem2=""/>ее</w> <w><ana lex="наш" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>наш</w> <w><ana lex="павлов" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Павлов</w>, <w><ana lex="как" gr="CONJ,norm" sem="" sem2=""/>как</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="подбор" gr="S,acc,inan,m,norm,sg" sem="der:v r:abstr der:s0" sem2="pt:set sc:x der:v r:concr r:abstr"/>подбор</w> -- <w><ana lex="никуда" gr="ADVPRO,norm" sem="der:advpro r:neg t:dir" sem2=""/>никуда</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="годиться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus" sem2="ca:noncaus"/>годится</w>, <w><ana lex="как" gr="CONJ,norm" sem="" sem2=""/>как</w> <w><ana lex="только" gr="PART,norm" sem="" sem2=""/>только</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="сыск" gr="S,acc,inan,m,norm,sg" sem="r:abstr" sem2=""/>сыск</w>, <w><ana lex="ну" gr="PART,norm" sem="" sem2=""/>ну</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="компания" gr="S,f,inan,nom,norm,sg" sem="t:group pt:set r:concr sc:hum" sem2="r:concr t:org"/>компания</w> -- <w><ana lex="один" gr="APRO,m,nom,norm,sg" sem="" sem2="r:indet"/>один</w> <w><ana lex="другой" gr="APRO,gen,m,norm,sg" sem="r:spec" sem2="r:ord r:spec r:indet"/>другого</w> <w><ana lex="хороший" gr="A,comp,norm,plen" sem="ev:posit t:quality r:qual" sem2="ev:posit ev t:degr:max r:qual"/>лучше</w>!</se><se> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>И</w> <w><ana lex="скольким" gr="NUM,norm" sem="" sem2=""/>сколько</w> <w><ana lex="всевозможный" gr="A,gen,norm,pl,plen" sem="dt:qual r:rel der:a" sem2=""/>всевозможных</w> <w><ana lex="претензия" gr="S,f,gen,inan,norm,pl" sem="r:abstr t:poss" sem2="t:speech ev:neg r:abstr t:behav"/>претензий</w> -- <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="обобраться" gr="V,2p,act,fut,indic,intr,norm,pf,sg" sem="ca:noncaus d:pref" sem2=""/>оберешься</w>!</se></p>
<p><se><w><ana lex="лучший" gr="A,ins,m,norm,sg,supr" sem="d:super ev:posit der:a t:quality r:qual" sem2=""/>Лучшим</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="полезный" gr="A,ins,n,norm,plen,sg" sem="ev:posit der:s r:qual" sem2="der:s r:qual"/>полезным</w> <w><ana lex="развлечение" gr="S,inan,ins,n,norm,sg" sem="der:v r:abstr der:s0" sem2="r:abstr"/>развлечением</w> <w><ana lex="здесь" gr="ADVPRO,norm" sem="t:place r:dem" sem2="t:time r:dem"/>здесь</w> <w><ana lex="являться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v ca:noncaus" sem2="der:v ca:noncaus"/>являются</w> <w><ana lex="облава" gr="S,f,inan,nom,norm,pl" sem="r:abstr" sem2="r:abstr"/>облавы</w>.</se><se> <w><ana lex="васильев" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Васильев</w> <w><ana lex="согласиться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus d:pref" sem2="t:speech ca:noncaus d:pref"/>согласился</w> <w><ana lex="последовать" gr="V,act,inf,intr,norm,pf" sem="der:v ca:noncaus t:move d:pref" sem2=""/>последовать</w> <w><ana lex="наш" gr="APRO,dat,m,norm,sg" sem="r:poss" sem2=""/>нашему</w> <w><ana lex="пример" gr="S,dat,inan,m,norm,sg" sem="t:ment r:abstr" sem2="ev:posit r:concr r:abstr der:shift t:text"/>примеру</w> -- <w><ana lex="ехать" gr="V,act,inf,intr,ipf,norm" sem="ca:noncaus t:move d:root" sem2="d:root"/>ехать</w> <w><ana lex="поохотиться" gr="V,act,inf,intr,norm,pf" sem="d:pref" sem2=""/>поохотиться</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="мандала" gr="S,f,gen,inan,norm,pl" sem="r:concr t:text t:workart" sem2=""/>Мандал</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="суга" gr="S,acc,bastard,f,inan,sg" sem="" sem2=""/>Сугу-нур</w>.</se><se> <w>Говорят</w>, <w><ana lex="там" gr="ADVPRO,norm" sem="t:place r:dem" sem2=""/>там</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="хороший" gr="A,acc,inan,norm,pl,plen" sem="ev:posit t:quality r:qual" sem2="ev:posit ev t:degr:max r:qual"/>хорошие</w> <w><ana lex="нетронутый" gr="A,acc,inan,norm,pl,plen" sem="der:v d:neg dt:contact" sem2=""/>нетронутые</w> <w><ana lex="место" gr="S,acc,inan,n,norm,pl" sem="qc:space t:space r:concr" sem2="qc:space sc:org t:tool t:space pt:element r:abstr pt:aggr:aggrpl pt:part pc:text r:concr"/>места</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="иметься" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus t:poss" sem2=""/>имеются</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="только" gr="PART,norm" sem="" sem2=""/>только</w> <w><ana lex="коза" gr="S,anim,f,nom,norm,pl" sem="t:animal r:concr" sem2=""/>козы</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="волк" gr="S,anim,m,nom,norm,pl" sem="t:animal r:concr" sem2=""/><ana lex="волк" gr="S,inan,m,nom,norm,pl" sem="" sem2="t:fam"/>волки</w>.</se><se> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>И</w> <w><ana lex="облава" gr="S,f,inan,nom,norm,sg" sem="r:abstr" sem2="r:abstr"/>облава</w> <w><ana lex="обещать" gr="V,3p,act,fut,indic,norm,pf,sg,tran" sem="t:speech ca:noncaus d:pref der:s" sem2="d:pref der:s"/><ana lex="обещать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="t:speech ca:noncaus d:pref der:s" sem2="d:pref der:s"/>обещает</w> <w><ana lex="быть" gr="V,act,inf,intr,ipf,norm" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>быть</w> (<w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="суббота" gr="S,acc,f,inan,norm,sg" sem="t:time:week r:abstr" sem2=""/>субботу</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="мандала" gr="S,f,inan,loc,norm,sg" sem="r:concr t:text t:workart" sem2=""/>Мандале</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="q" gr="bastard" sem="" sem2=""/>Q</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="суга" gr="S,acc,bastard,f,inan,sg" sem="" sem2=""/>Сугу-нуре</w>) <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="занимательный" gr="A,f,gen,norm,plen,sg" sem="der:v d:potent r:qual" sem2=""/>занимательной</w>.</se></p>
<p><se><b/><w><b>11</b></w><b>/</b><w><ana lex="i" gr="bastard" sem="" sem2=""/><b>I</b></w><b>, </b><w><ana lex="t" gr="bastard" sem="" sem2=""/><b>T</b></w><b/>. <w><ana lex="погода" gr="S,f,inan,nom,norm,sg" sem="r:abstr t:weather" sem2=""/>Погода</w> <w><ana lex="порядочный" gr="A,f,nom,norm,plen,sg" sem="ev:posit t:humq r:qual" sem2="t:degr:max r:qual"/>порядочная</w>: <w><ana lex="t" gr="bastard" sem="" sem2=""/>t</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="низкий" gr="A,f,nom,norm,plen,sg" sem="t:size:min r:qual" sem2="t:humq t:hier t:level r:qual t:size:min t:sound ev:neg t:interpretation"/>низкая</w>, -<w><ana lex="18.5" gr="NUM,ciph"/>18.5</w>°<w><ana lex="r" gr="bastard" sem="" sem2=""/>R</w> (<w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="зара" gr="S,f,inan,loc,norm,sg" sem="" sem2=""/><ana lex="зара" gr="S,anim,f,loc,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/><ana lex="заря" gr="S,f,inan,loc,norm,sg" sem="r:abstr t:light t:weather" sem2="ev:posit t:sound r:abstr"/>заре</w>), <w><ana lex="небо" gr="S,inan,n,nom,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/><ana lex="небо" gr="S,inan,n,nom,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/>небо</w> <w><ana lex="ясный" gr="A,n,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясное</w>, <w><ana lex="богдо" gr="ADV,bastard" sem="" sem2=""/>Богдо-ула</w> <w><ana lex="дремать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:physiol d:root" sem2=""/>дремлет</w>, <w><ana lex="вершина" gr="S,f,inan,nom,norm,pl" sem="t:fam r:concr pc:x pt:part der:s" sem2=""/>вершины</w> <w><ana lex="окрестный" gr="A,gen,norm,pl,plen" sem="t:place r:rel der:adv" sem2=""/>окрестных</w> <w><ana lex="гора" gr="S,f,gen,inan,norm,pl" sem="top:hill t:space r:concr" sem2="sc:x pt:set t:space t:form r:abstr t:quant:max r:concr"/>го