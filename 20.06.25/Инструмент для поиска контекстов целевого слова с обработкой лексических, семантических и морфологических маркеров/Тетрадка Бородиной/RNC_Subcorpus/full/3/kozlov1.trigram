<p><se><w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="заключение" gr="S,acc,inan,n,norm,sg" sem="t:put der:v r:abstr der:s0" sem2="t:text t:ment:result t:put pt:phase r:abstr der:v pc:workmus pt:part pc:text r:concr"/>заключение</w> <w><ana lex="очерк" gr="S,gen,inan,m,norm,sg" sem="r:concr t:text" sem2="der:v r:concr t:text"/>очерка</w> <w><ana lex="просить" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="t:speech ca:caus d:root" sem2="d:root"/>прошу</w> <w><ana lex="вы" gr="SPRO,2p,acc,norm,pl" sem="r:pers" sem2=""/>Вас</w> <w><ana lex="пожелать" gr="V,act,inf,norm,pf,tran" sem="d:pref" sem2=""/>пожелать</w> <w><ana lex="ваш" gr="APRO,dat,n,norm,sg" sem="r:poss" sem2=""/>Вашему</w> <w><ana lex="детище" gr="S,dat,inan,n,norm,sg" sem="" sem2="der:shift r:concr"/><ana lex="детище" gr="S,anim,dat,n,norm,sg" sem="t:hum ev r:concr der:s d:aug" sem2=""/>детищу</w> -- <w><ana lex="тибетский" gr="A,f,gen,norm,plen,sg" sem="dt:topon r:rel der:s t:topon" sem2=""/>Тибетской</w> <w><ana lex="научный" gr="A,f,gen,norm,plen,sg" sem="r:rel der:s" sem2="r:rel der:s"/>научной</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w> <w><ana lex="скорейший" gr="A,f,gen,norm,sg,supr" sem="t:speed:max dt:speed:max der:a d:super r:qual" sem2=""/>скорейшей</w> <w><ana lex="свобода" gr="S,f,gen,inan,norm,sg" sem="r:abstr" sem2="r:abstr"/>свободы</w> <w><ana lex="действие" gr="S,gen,inan,n,norm,sg" sem="r:abstr" sem2="t:text r:abstr der:v pt:part pc:text r:concr"/>действия</w>; <w><ana lex="она" gr="SPRO,3p,f,nom,norm,sg" sem="r:pers" sem2=""/>она</w>, <w><ana lex="надеяться" gr="V,1p,act,indic,intr,ipf,norm,praes,sg" sem="t:ment ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>надеюсь</w>, <w><ana lex="весь" gr="APRO,ins,norm,pl" sem="r:spec" sem2=""/>всеми</w> <w><ana lex="сила" gr="S,f,inan,ins,norm,pl" sem="sc:hum t:pers r:abstr pt:aggr:aggrpl t:param r:concr"