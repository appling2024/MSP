<p><se><w><ana lex="весь" gr="APRO,acc,inan,m,norm,sg" sem="r:spec" sem2=""/>Весь</w> <w><ana lex="вечер" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>вечер</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="провести" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="провести" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="проводить" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:caus t:move d:pref" sem2="d:pref"/>провел</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="юрт" gr="S,inan,loc,m,norm,sg" sem="t:space r:concr" sem2=""/>юрте</w> «<w><ana lex="старший" gr="A,gen,norm,pl,plen" sem="r:qual" sem2="t:hier r:rel t:ord"/>старших</w>» <w><ana lex="мальчик" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr" sem2="t:hum r:concr"/>мальчиков</w>, <w><ana lex="где" gr="ADVPRO,norm" sem="t:place r:rel" sem2="t:place r:indet"/>где</w> <w><ana lex="узнать" gr="V,act,indic,m,norm,pf,praet,sg" sem="d:pref" sem2="t:ment ca:noncaus d:pref"/>узнал</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="отпустить" gr="V,nom,norm,partcp,pass,pf,pl,plen,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus ca:0 d:pref ca:bgr"/>отпущенные</w> «<w><ana lex="со" gr="PR,norm" sem="" sem2=""/>со</w> <w><ana lex="двор" gr="S,gen,inan,m,norm,sg" sem="pt:set t:space r:concr pc:constr:build t:group sc:hum pt:addit" sem2="t:space r:concr pc:constr:build t:org t:constr pt:addit"/>двора</w>» <w><ana lex="старик" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr der:a" sem2="t:hum ev r:concr der:a"/>старики</w> <w><ana lex="мой" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>мои</w> <w><ana lex="телешов" gr="S,anim,bastard,famn,m,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Телешов</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="бохин" gr="S,anim,bastard,famn,m,nom,sg" sem="t:hum r:propn t:famn" sem2=""/><ana lex="бохин" gr="S,bastard,inan,m,nom,sg" sem="" sem2=""/>Бохин</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="вернуться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus t:move" sem2="ca:noncaus"/>вернулись</w> <w><ana lex="вдвоем" gr="ADV,norm" sem="t:quant:abs r:numcoll der:num" sem2=""/>вдвоем</w>: <w><ana lex="телешка" gr="S,anim,bastard,m,nom,persn,sg" sem="" sem2=""/>Телешка</w> <w><ana lex="дом" gr="S,gen,inan,m,norm,sg" sem="top:contain t:constr:build r:concr" sem2="sc:hum pt:set t:space t:org t:group der:shift r:concr"/>дома</w>, <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="дорога" gr="S,f,inan,loc,norm,sg" sem="top:stripe t:space r:concr t:fam" sem2="t:move dt:space r:abstr der:shift t:space r:concr"/>дороге</w> <w><ana lex="где" gr="ADVPRO,norm" sem="t:place r:rel" sem2="t:place r:indet"/><ana form="где-то" lex="где-то" gr="ADVPRO,norm" sem="t:place r:indet der:advpro" sem2=""/>где-то</w> <w><ana lex="хлебнуть" gr="V,act,indic,m,norm,pf,praet,sg,tran" sem="der:v d:semelf t:physiol" sem2=""/>хлебнул</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="бохин" gr="S,anim,bastard,famn,m,nom,sg" sem="t:hum r:propn t:famn" sem2=""/><ana lex="бохин" gr="S,bastard,inan,m,nom,sg" sem="" sem2=""/>Бохин</w> <w><ana lex="совсем" gr="ADV,norm" sem="t:degr:max der:apro" sem2="t:degr:min der:apro"/>совсем</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="появляться" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="der:v d:pref" sem2=""/>появлялся</w>.</se><se> <w><ana lex="что" gr="SPRO,acc,inan,n,norm,sg" sem="r:rel" sem2=""/>Что</w> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w> <w><ana lex="делать" gr="V,act,inf,ipf,norm,tran" sem="d:root" sem2="d:root"/>делать</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="они" gr="SPRO,3p,ins,norm,pl" sem="r:pers" sem2=""/>ними</w>?</se><se>! <w><ana lex="наказывать" gr="V,act,inf,ipf,norm,tran" sem="der:v d:pref d:impf" sem2=""/>Наказывать</w> <w>жалко</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="они" gr="SPRO,3p,dat,norm,pl" sem="r:pers" sem2=""/>им</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w>стыдно</w>; <w><ana lex="оставлять" gr="V,act,inf,ipf,norm,tran" sem="der:v d:pref" sem2=""/>оставлять</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> -- <w><ana lex="потворство" gr="S,inan,n,nom,norm,sg" sem="der:v ev:neg r:abstr t:behav" sem2=""/>потворство</w> <w><ana lex="они" gr="SPRO,3p,dat,norm,pl" sem="r:pers" sem2=""/>им</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="разврат" gr="S,inan,m,nom,norm,sg" sem="r:abstr" sem2="t:humq r:abstr ev:neg t:behav"/>разврат</w> <w><ana lex="другой" gr="APRO,dat,norm,pl" sem="r:spec" sem2="r:ord r:spec r:indet"/>другим</w>, <w><ana lex="юный" gr="A,dat,norm,pl,plen" sem="t:time:age r:qual" sem2="dt:time:age der:shift r:qual"/>юным</w> <w><ana lex="мальчик" gr="S,anim,dat,m,norm,pl" sem="t:hum r:concr" sem2="t:hum r:concr"/>мальчикам</w>.</se><se> <w><ana lex="бохина" gr="S,anim,bastard,f,famn,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Бохина</w> <w><ana lex="следовать" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="ca:noncaus t:move der:s" sem2="ca:noncaus t:move der:s"/>следует</w> <w><ana lex="просто" gr="ADV,norm" sem="ev:posit dt:quality der:a" sem2="ev:posit t:humq dt:humq der:a"/><ana form="просто-напросто" lex="просто-напросто" gr="ADV,norm" sem="der:comp" sem2=""/>просто-напросто</w> <w><ana lex="высечь" gr="V,act,inf,norm,pf" sem="der:v ca:caus t:impact d:pref t:impact:creat" sem2="der:v ca:caus d:pref t:impact:creat"/><ana lex="высечь" gr="V,act,inf,norm,pf,tran" sem="der:v ca:caus t:impact d:pref t:impact:creat" sem2="der:v ca:caus d:pref t:impact:creat"/>высечь</w>!</se></p>
<p><se><b/><w><b>12</b></w><b>/</b><w><ana lex="xi" gr="bastard" sem="" sem2=""/><b>XI</b></w><b>, </b><w><ana lex="r" gr="bastard" sem="" sem2=""/><b>R</b></w><b/>. <w><ana lex="серый" gr="A,n,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>Серое</w>, <w><ana lex="облачный" gr="A,n,nom,norm,plen,sg" sem="r:rel der:s" sem2="t:physq r:rel der:s"/>облачное</w> <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утро</w>.</se><se> <w><ana lex="островок" gr="S,inan,m,nom,norm,pl" sem="d:dim t:space r:concr der:s" sem2=""/>Островки</w> <w><ana lex="голубой" gr="A,gen,n,norm,plen,sg" sem="t:physq:color r:qual" sem2="ev r:qual"/>голубого</w> <w><ana lex="небо" gr="S,gen,inan,n,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/><ana lex="небо" gr="S,gen,inan,n,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/>неба</w> <w><ana lex="красиво" gr="ADV,norm" sem="ev:posit dt:quality der:a" sem2=""/>красиво</w> <w><ana lex="выделяться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v d:pref" sem2=""/>выделяются</w> <w><ana lex="среди" gr="PR,norm" sem="" sem2=""/>среди</w> <w><ana lex="громада" gr="S,f,gen,inan,norm,pl" sem="t:asp r:concr r:abstr" sem2=""/>громад</w> <w><ana lex="кучевой" gr="A,gen,norm,pl,plen" sem="r:rel der:s" sem2=""/>кучевых</w> <w><ana lex="облако" gr="S,gen,inan,n,norm,pl" sem="qc:stuff r:concr" sem2="qc:stuff pt:qtm top:form r:concr"/>облаков</w>.</se><se> <w><ana lex="богдо" gr="ADV,bastard" sem="" sem2=""/>Богдо-ула</w> <w><ana lex="укрыть" gr="V,brev,f,norm,partcp,pass,pf,praet,sg" sem="d:pref" sem2="d:pref"/>укрыта</w> <w><ana lex="сплошь" gr="ADV,norm" sem="dt:degr:max der:a" sem2=""/>сплошь</w> <w><ana lex="белый" gr="A,ins,m,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:race dt: