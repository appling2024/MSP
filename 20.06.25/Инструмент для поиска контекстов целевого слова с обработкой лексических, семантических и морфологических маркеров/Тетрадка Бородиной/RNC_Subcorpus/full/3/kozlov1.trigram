<p><se><w><ana lex="еще" gr="ADV,norm" sem="" sem2=""/>Еще</w> <w><ana lex="два" gr="NUM,acc,f,inan,norm" sem="r:card:pauc" sem2=""/>две</w> <w><ana lex="верста" gr="S,f,gen,inan,norm,sg" sem="t:unit r:abstr" sem2=""/>версты</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="небольшой" gr="A,ins,n,norm,plen,sg" sem="d:neg r:rel t:size:min dt:size:max der:a" sem2="t:degr:min d:neg der:a dt:size:max r:qual"/>небольшим</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="свернуть" gr="V,act,indic,norm,pf,pl,praet" sem="der:v d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="свернуть" gr="V,act,indic,intr,norm,pf,pl,praet" sem="der:v d:pref" sem2="der:v ca:noncaus t:move d:pref"/>свернули</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="восток" gr="S,acc,inan,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr pt:part pc:space"/>восток</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="урочище" gr="S,inan,loc,n,norm,sg" sem="t:space r:concr" sem2=""/>урочище</w> <w><ana lex="баин" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Баин-булак</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="укромный" gr="A,acc,inan,m,norm,plen,sg" sem="ev r:rel" sem2=""/>укромный</w> <w><ana lex="уголок" gr="S,acc,inan,m,norm,sg" sem="dt:form t:form top:corner top:form der:s d:dim r:concr" sem2="pt:aggr sc:tool t:tool t:space top:contain dt:space top:corner t:room pt:ind t:sign dt:part top:form pc:x pt:part d:dim r:concr pc:room der:s"/>уголок</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="соседство" gr="S,dat,inan,n,norm,sg" sem="t:space r:abstr" sem2=""/>соседству</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="перевал" gr="S,inan,ins,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="t:space der:v pt:part top:hill pc:space r:concr"/>перевалом</w>.</se><se> <w><ana lex="первый" gr="ANUM,acc,inan,m,norm,sg" sem="r:ord der:num t:ord r:qual" sem2="ev:posit t:hier t:qual r:qual"/>Первый</w> <w><ana lex="загон" gr="S,acc,inan,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="der:v t:space r:concr r:abstr"/>загон</w>.</se><se> <w><ana lex="здесь" gr="ADVPRO,norm" sem="t:place r:dem" sem2="t:time r:dem"/>Здесь</w> <w><ana lex="проживать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="t:be:exist ca:noncaus der:v d:pref d:impf" sem2="der:v d:pref d:impf"/><ana lex="проживать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:be:exist ca:noncaus der:v d:pref d:impf" sem2="der:v d:pref d:impf"/>проживает</w> <w><ana lex="наш" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>наш</w> «<w><ana lex="лейб" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:famn t:persn" sem2=""/>лейб-егерь</w>», <w><ana lex="как" gr="CONJ,norm" sem="" sem2=""/>как</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="шутка" gr="S,acc,f,inan,norm,sg" sem="der:v r:abstr" sem2="der:shift r:concr t:workdram"/>шутку</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="назвать" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus d:pref" sem2="der:v t:speech d:pref ca:noncaus"/>назвал</w> <w><ana lex="горный" gr="A,gen,m,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s"/>горного</w> <w><ana lex="отшельник" gr="S,anim,gen,m,norm,sg" sem="der:v t:hum r:concr d:nag" sem2="t:hum ev r:concr d:nag"/>отшельника</w>, <w>Ежо</w> (<w><ana lex="иосиф" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Иосиф</w> <w><ana lex="иоганнович" gr="S,anim,m,nom,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Иоганнович</w>) <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="его" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,n,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,f,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,m,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,n,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,f,gen,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,n,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,f,gen,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,m,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,n,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,f,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,m,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,n,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,f,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,m,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,n,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,f,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,m,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,anim,m,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,inan,m,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,n,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,f,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,m,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,n,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,anim,norm,pl" sem="r:poss" sem2=""/>его</w> <w><ana lex="жена" gr="S,anim,f,ins,norm,sg" sem="" sem2="t:hum r:concr"/>женой</w> <w><ana lex="таисия" gr="S,anim,f,ins,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Таисией</w> <w><ana lex="павловна" gr="S,anim,f,ins,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Павловной</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="два" gr="NUM,ins,norm" sem="r:card:pauc" sem2=""/>двумя</w> <w><ana lex="птенец" gr="S,anim,ins,m,norm,pl" sem="t:animal r:concr der:s d:fil" sem2=""/>птенцами</w>.</se></p>
<p><se><w>Ежо</w> <w><ana lex="удачно" gr="ADV,norm" sem="" sem2="ev:posit der:a"/>удачно</w> <w><ana lex="расположить" gr="V,act,indic,m,norm,pf,praet,sg" sem="t:put ca:caus der:v d:pref" sem2=""/><ana lex="расположить" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="t:put ca:caus der:v d:pref" sem2=""/>расположил</w> <w><ana lex="свой" gr="APRO,acc,f,norm,sg" sem="r:poss" sem2="t:social r:poss"/>свою</w> <w><ana lex="усадьба" gr="S,acc,f,inan,norm,sg" sem="sc:constr:build t:constr r:concr" sem2="sc:constr:build t:space r:concr"/>усадьбу</w> (<w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="скромный" gr="A,acc,f,norm,plen,sg" sem="t:humq r:qual" sem2="t:quant:min r:qual"/>скромную</w>) <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="горный" gr="A,loc,m,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s"/>горном</w> <w><ana lex="воздух" gr="S,inan,loc,m,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>воздухе</w>, <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="склон" gr="S,inan,loc,m,norm,sg" sem="t:space top:slope der:v top:form pt:part pc:space r:concr" sem2=""/>склоне</w>, <w><ana lex="пригревать" gr="V,ipf,loc,m,norm,partcp,pass,plen,praes,sg,tran" sem="der:v t:changest d:pref d:impf" sem2=""/>пригреваемом</w> <w><ana lex="постоянный" gr="A,ins,n,norm,plen,sg" sem="r:rel t:time" sem2="t:time:dur t:humq r:rel r:qual"/>постоянным</w> <w><ana lex="солнце" gr="S,inan,ins,n,norm,sg" sem="top:horiz top:spher t:astr t:space r:concr" sem2="ev:posit t:space r:concr r:abstr t:light"/>солнцем</w>.</se><se> <w>Действительно</w>, <w><ana lex="здесь" gr="ADVPRO,norm" sem="t:place r:dem" sem2="t:time r:dem"/>здесь</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="течение" gr="S,acc,inan,n,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="qc:stuff der:v t:move r:concr r:abstr"/>течение</w> <w><ana lex="весь" gr="APRO,gen,m,norm,sg" sem="r:spec" sem2=""/>всего</w>