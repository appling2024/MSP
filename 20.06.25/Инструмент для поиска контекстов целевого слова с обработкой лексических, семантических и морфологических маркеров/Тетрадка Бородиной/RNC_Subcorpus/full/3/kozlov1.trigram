<p><se><w><ana lex="такой" gr="APRO,ins,m,norm,sg" sem="r:dem" sem2="r:indet r:spec t:degr:max"/>Таким</w> <w><ana lex="образ" gr="S,inan,ins,m,norm,sg" sem="t:ment r:concr r:abstr t:workart" sem2="t:asp r:abstr"/>образом</w> <w><ana lex="3" gr="NUM,ciph"/>3</w>-<w><ana lex="дневной" gr="A,n,nom,norm,plen,sg" sem="dt:abstr dt:time:period r:rel der:s dt:unit" sem2="dt:abstr dt:time:period r:rel der:s dt:unit"/><ana lex="дневный" gr="A,n,nom,norm,plen,sg" sem="dt:abstr dt:time r:rel der:s t:time" sem2=""/>дневное</w> <w><ana lex="пребывание" gr="S,inan,n,nom,norm,sg" sem="t:be:exist der:v r:abstr" sem2=""/>пребывание</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="сангина" gr="S,f,inan,loc,norm,sg" sem="" sem2=""/>Сангине</w> <w><ana lex="пройти" gr="V,act,indic,n,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="пройти" gr="V,act,indic,intr,n,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="проходить" gr="V,act,indic,intr,n,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2=""/>прошло</w> <w><ana lex="замечательно" gr="ADV,norm" sem="ev:posit dt:quality der:a" sem2=""/>замечательно</w> <w><ana lex="скоро" gr="ADV,norm" sem="dt:speed:max der:a t:time" sem2="dt:speed:max der:a t:time"/>скоро</w>, <w><ana lex="дорога" gr="S,f,inan,nom,norm,sg" sem="top:stripe t:space r:concr t:fam" sem2="t:move dt:space r:abstr der:shift t:space r:concr"/>дорога</w> <w><ana lex="туда" gr="ADVPRO,norm" sem="t:dir r:dem" sem2="t:place r:dem"/>туда</w> <w><ana lex="проходить" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="der:v ca:noncaus t:move d:pref" sem2=""/><ana lex="проходить" gr="V,3p,act,fut,indic,norm,pf,sg,tran" sem="der:v ca:noncaus t:move d:pref" sem2=""/><ana lex="проходить" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v ca:noncaus t:move d:pref" sem2=""/><ana lex="проходить" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="der:v ca:nonc