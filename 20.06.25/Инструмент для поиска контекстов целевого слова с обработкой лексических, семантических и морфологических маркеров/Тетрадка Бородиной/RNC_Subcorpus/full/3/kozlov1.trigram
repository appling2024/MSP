<p><se><b/><w><b>30</b></w><b>/</b><w><ana lex="xi" gr="bastard" sem="" sem2=""/><b>XI</b></w><b>, </b><w><ana lex="t" gr="bastard" sem="" sem2=""/><b>T</b></w><b/>. <w><ana lex="серо" gr="ADV,norm" sem="dt:physq:color der:a ev:neg" sem2="dt:physq:color der:a ev:neg"/>Серо</w>, <w><ana lex="облачно" gr="ADV,norm" sem="" sem2=""/>облачно</w>, <w><ana lex="ветрено" gr="ADV,norm" sem="der:a dt:humq ev:neg" sem2=""/>ветрено</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana form="юго-восточной" lex="юго-восточный" gr="A,f,loc,norm,plen,sg" sem="t:place der:comp r:rel dt:space" sem2=""/>юго-восточной</w> <w><ana lex="часть" gr="S,f,inan,loc,norm,sg" sem="r:concr pc:x pt:part" sem2="pc:org r:abstr sc:part t:org pt:ind pt:aggr:aggrpl t:poss der:shift pc:x pt:part pc:text r:concr"/>части</w> <w><ana lex="серый" gr="A,gen,m,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>серого</w> <w><ana lex="горизонт" gr="S,gen,inan,m,norm,sg" sem="t:space r:concr" sem2="t:ment t:space qc:stuff pt:qtm r:abstr pt:aggr r:concr"/>горизонта</w>.</se><se> <w><ana lex="над" gr="PR,norm" sem="" sem2=""/>Над</w> <w><ana lex="северный" gr="A,ins,m,norm,plen,sg" sem="t:place dt:space r:rel der:s" sem2=""/>северным</w> <w><ana lex="склон" gr="S,inan,ins,m,norm,sg" sem="t:space top:slope der:v top:form pt:part pc:space r:concr" sem2=""/>склоном</w> <w><ana lex="богдо" gr="ADV,bastard" sem="" sem2=""/>Богдо-ула</w>, <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="снежный" gr="A,loc,m,norm,plen,sg" sem="dt:stuff r:rel der:s" sem2="t:physq:color r:qual"/>снежном</w> <w><ana lex="белый" gr="A,loc,m,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:race dt:physq:color der:shift r:qual t:species r:rel"/>белом</w> <w><ana lex="фон" gr="S,inan,loc,m,norm,sg" sem="r:abstr pt:part" sem2="t:space pc:workart r:abstr pt:part t:unit r:concr"/>фоне</w>, <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень