<p><se><w><ana lex="к" gr="PR,norm" sem="" sem2=""/>К</w> <w><ana lex="север" gr="S,dat,inan,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr t:fam pt:part pc:space"/><ana lex="север" gr="S,anim,dat,m,norm,persn,sg" sem="" sem2=""/>северу</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="урочище" gr="S,gen,inan,n,norm,sg" sem="t:space r:concr" sem2=""/>урочища</w> <w><ana lex="хотат" gr="S,bastard,dat,inan,m,sg" sem="" sem2=""/>Хотату</w> (<w><ana lex="ходат" gr="S,bastard,dat,inan,m,sg" sem="" sem2=""/>Ходату</w>) <w><ana lex="иметься" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus t:poss" sem2=""/>имеются</w> <w><ana lex="огромный" gr="A,nom,norm,pl,plen" sem="t:size:max r:qual" sem2="t:quant:max t:degr:max r:qual"/>огромные</w> <w><ana lex="намогильный" gr="A,nom,norm,pl,plen" sem="dt:space r:rel der:s" sem2=""/>намогильные</w> <w><ana lex="памятник" gr="S,inan,m,nom,norm,pl" sem="r:concr t:workart der:a" sem2="t:constr r:concr der:a"/>памятники</w> <w><ana lex="больший" gr="A,gen,norm,pl,plen" sem="d:compar t:size:max der:a dt:size:max r:qual" sem2=""/><ana lex="большой" gr="A,gen,norm,pl,plen" sem="t:size:max r:qual" sem2="t:quant:max t:time:age t:degr:max r:qual"/>больших</w> <w><ana lex="размер" gr="S,gen,inan,m,norm,pl" sem="r:abstr t:param t:size" sem2="t:degr r:abstr"/>размеров</w>.</se><se> <w><ana lex="гора" gr="S,f,inan,nom,norm,sg" sem="top:hill t:space r:concr" sem2="sc:x pt:set t:space t:form r:abstr t:quant:max r:concr"/>Гора</w> <w><ana lex="уоша" gr="S,bastard,f,inan,nom,sg" sem="" sem2=""/>Уоша</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="интересный" gr="A,brev,f,norm,sg" sem="dt:abstr der:s dt:ment r:qual" sem2="dt:abstr ev:posit der:s dt:ment r:qual"/>интересна</w> <w><ana lex="больший" gr="A,ins,norm,pl,plen" sem="d:compar t:size:max der:a dt:size:max r:qual" sem2=""/><ana lex="большой" gr="A,ins,norm,pl,plen" sem="t:size:max r:qual" sem2="t:quant:max