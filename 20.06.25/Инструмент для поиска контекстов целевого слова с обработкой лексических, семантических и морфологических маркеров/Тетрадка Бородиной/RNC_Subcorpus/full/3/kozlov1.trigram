<p><se><w>Пожалуй</w>, <w><ana lex="живить" gr="V,act,ger,ipf,norm,praes,tran" sem="d:root" sem2=""/><ana lex="жить" gr="V,act,ger,intr,ipf,norm,praes" sem="t:be:exist ca:noncaus d:root" sem2="d:root"/>живя</w> <w><ana lex="здесь" gr="ADVPRO,norm" sem="t:place r:dem" sem2="t:time r:dem"/>здесь</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="урга" gr="S,f,inan,loc,norm,sg" sem="r:propn t:topon" sem2=""/>Урге</w>, <w><ana lex="исписать" gr="V,2p,act,fut,indic,norm,pf,sg" sem="der:v d:pref" sem2=""/>испишешь</w> <w><ana lex="полностью" gr="ADV,norm" sem="dt:full t:degr:max der:a" sem2=""/>полностью</w> <w><ana lex="этот" gr="APRO,acc,inan,m,norm,sg" sem="r:dem" sem2=""/>этот</w> <w><ana lex="дневник" gr="S,acc,inan,m,norm,sg" sem="r:concr t:text der:s" sem2="r:concr t:text der:s"/>дневник</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="что" gr="SPRO,inan,ins,n,norm,sg" sem="r:rel" sem2=""/>чем</w>?</se></p>
<p><se><b/><w><b>18</b></w><b>/</b><w><ana lex="i" gr="bastard" sem="" sem2=""/><b>I</b></w><b>, </b><w><ana lex="t" gr="bastard" sem="" sem2=""/><b>T</b></w><b/>. <w><ana lex="почти" gr="ADV,norm" sem="" sem2=""/>Почти</w> <w><ana lex="ясный" gr="A,n,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясное</w> <w><ana lex="небо" gr="S,inan,n,nom,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/><ana lex="небо" gr="S,inan,n,nom,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/>небо</w>, <w><ana lex="прозрачный" gr="A,brev,n,norm,sg" sem="" sem2="r:qual"/>прозрачно</w>, <w><ana lex="холодный" gr="A,brev,n,norm,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual"/>холодно</w>, <w><ana form="юго-восточный" lex="юго-восточный" gr="A,m,nom,norm,plen,sg" sem="t:place der:comp r:rel dt:space" sem2=""/>юго-восточный</w> <w><ana lex="ветер" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>ветер</w> <w><ana lex="дуть" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="ca:noncaus d:root t:weather" sem2="d:root"/>дует</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="ночь" gr="S,f,gen,inan,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2=""/>ночи</w>.</se><se> <w><ana lex="день" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>День</w> <w><ana lex="начинать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="aux:phase d:pref" sem2="d:pref"/>начинает</w> <w><ana lex="прибывать" gr="V,act,inf,intr,ipf,norm" sem="der:v t:move d:impf d:pref" sem2=""/>прибывать</w>.</se><se> <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="отправлять" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="der:v ca:caus t:move d: