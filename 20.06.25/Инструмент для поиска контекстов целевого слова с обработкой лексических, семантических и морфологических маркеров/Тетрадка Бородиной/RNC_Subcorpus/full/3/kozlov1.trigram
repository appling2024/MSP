<p><se><w><ana lex="нахождение" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr der:s0 t:poss" sem2=""/>Нахождение</w> <w><ana lex="каменный" gr="A,f,gen,norm,plen,sg" sem="dt:stuff dt:stone r:rel der:s" sem2="r:rel dt:stuff dt:stone der:shift der:s ev:neg t:psych:emot"/>каменной</w> <w><ana lex="фигура" gr="S,f,gen,inan,norm,sg" sem="r:concr t:form:geom" sem2="t:speech t:tool r:abstr t:workart t:loc:body t:tool:card t:word t:tool:game r:concr"/>фигуры</w> <w><ana lex="кондратьев" gr="S,anim,famn,ins,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Кондратьевым</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="долина" gr="S,f,inan,loc,norm,sg" sem="t:space r:concr der:s t:fam" sem2=""/>долине</w> <w><ana lex="тола" gr="S,f,gen,inan,norm,sg" sem="" sem2=""/>Толы</w>, <w><ana lex="вверх" gr="ADV,norm" sem="der:s t:dir" sem2="der:s"/>вверх</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="урга" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Урги</w> <w><ana lex="около" gr="PR,norm" sem="" sem2=""/>около</w> <w><ana lex="сорок" gr="NUM,gen,norm" sem="r:card" sem2=""/>сорока</w> <w><ana lex="верста" gr="S,f,gen,inan,norm,pl" sem="t:unit r:abstr" sem2=""/>верст</w>, <w><ana lex="жамцарать" gr="V,bastard,brev,ipf,n,partcp,pass,praet,sg,tran" sem="" sem2=""/><ana lex="жамцарать" gr="V,bastard,brev,n,partcp,pass,pf,praet,sg" sem="" sem2=""/><ana lex="жамцарать" gr="V,bastard,brev,n,partcp,pass,pf,praet,sg,tran" sem="" sem2=""/>Жамцарано</w> <w><ana lex="приписывать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="der:v d:pref d:impf" sem2=""/>приписывает</w> <w>VII</w> <w><ana lex="век" gr="S,dat,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period r:abstr t:time"/>веку</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="проявлять" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="der:v d:pref" sem2=""/>проявляет</w> <w><ana lex="высокий" gr="A,acc,inan,m,norm,plen,sg" sem="t:size:max r:qual" sem2="