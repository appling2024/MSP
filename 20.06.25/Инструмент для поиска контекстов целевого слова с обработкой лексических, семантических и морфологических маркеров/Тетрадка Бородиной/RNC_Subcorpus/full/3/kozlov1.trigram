<p><se><w><ana lex="усиленно" gr="ADV,norm" sem="ev der:aprt dt:degr" sem2=""/>Усиленно</w> <w><ana lex="ждать" gr="V,1p,act,indic,ipf,norm,pl,praes,tran" sem="d:root" sem2="d:root"/>ждем</w> <w><ana lex="наш" gr="APRO,acc,anim,norm,pl" sem="r:poss" sem2=""/>наших</w> -- <w><ana lex="мой" gr="APRO,acc,f,norm,sg" sem="r:poss" sem2=""/>мою</w> <w><ana lex="пшевочка" gr="S,acc,anim,bastard,f,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/><ana lex="пшевочка" gr="S,acc,anim,bastard,f,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/><ana lex="пшевочка" gr="S,acc,bastard,f,inan,sg" sem="" sem2=""/>Пшевочку</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="цокто" gr="S,0,anim,bastard,m,sg" sem="t:hum r:propn t:persn" sem2=""/>Цокто</w> <w><ana lex="гармаевич" gr="S,anim,bastard,gen,m,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Гармаевича</w>.</se><se> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>Не</w> <w><ana lex="знать" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/>знаю</w>, <w><ana lex="узко" gr="ADV,comp,norm" sem="dt:size:min der:a" sem2="dt:size:min der:a"/><ana lex="уже" gr="ADV,norm" sem="t:time" sem2=""/>уже</w> <w><ana lex="пятый" gr="ANUM,acc,inan,m,norm,sg" sem="r:ord der:num r:rel t:ord" sem2="t:share r:rel der:num"/>пятый</w> <w><ana lex="час" gr="S,acc,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>час</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="они" gr="SPRO,acc,anim,norm,pl" sem="r:pers" sem2=""/>их</w> <w><ana lex="все" gr="ADV,norm" sem="" sem2=""/>все</w> <w>нет</w>!</se></p>
