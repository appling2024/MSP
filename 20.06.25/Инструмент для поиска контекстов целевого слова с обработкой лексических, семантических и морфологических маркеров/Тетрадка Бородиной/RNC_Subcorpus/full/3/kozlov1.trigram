<p><se><w><ana lex="получить" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:noncaus t:poss" sem2=""/>Получил</w> <w><ana lex="телеграмма" gr="S,acc,f,inan,norm,sg" sem="der:comp r:concr t:text" sem2=""/>телеграмму</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="харбин" gr="S,gen,inan,m,norm,sg" sem="r:propn t:topon" sem2=""/>Харбина</w>, <w><ana lex="что" gr="SPRO,inan,n,nom,norm,sg" sem="r:rel" sem2=""/><ana form="что-то" lex="что-то" gr="SPRO,inan,n,nom,norm,sg" sem="r:indet" sem2=""/>что-то</w> <w><ana lex="там" gr="ADVPRO,norm" sem="t:place r:dem" sem2=""/>там</w> <w><ana lex="действительно" gr="ADV,PARENTH,norm" sem="der:a" sem2=""/>действительно</w> <w>неважно</w>, <w>кажется</w> <w><ana lex="мамик" gr="S,anim,bastard,m,nom,persn,sg" sem="t:hum r:propn t:persn" sem2=""/><ana lex="мамик" gr="S,bastard,inan,m,nom,sg" sem="" sem2=""/><ana lex="мамик" gr="S,anim,bastard,m,nom,sg" sem="t:hum r:propn t:persn" sem2=""/>мамик</w> <w><ana lex="вздумать" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="t:ment ca:noncaus d:pref" sem2=""/>вздумал</w> <w><ana lex="перестараться" gr="V,act,inf,intr,norm,pf" sem="ca:noncaus d:pref" sem2=""/>перестараться</w>.</se><se> <w><ana lex="сведение" gr="S,inan,n,nom,norm,sg" sem="t:ment r:abstr" sem2="t:speech t:ment r:abstr"/>Сведение</w> <w><ana lex="тревожный" gr="A,n,nom,norm,plen,sg" sem="dt:abstr dt:psych:emot r:rel der:s" sem2="dt:abstr dt:psych:emot r:rel der:s"/>тревожное</w>, <w><ana lex="если" gr="CONJ,norm" sem="" sem2=""/>если</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="сгустить" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="t:changest d:pref der:a dt:physq ca:caus" sem2=""/>сгущены</w> <w><ana lex="краска" gr="S,f,inan,nom,norm,pl" sem="t:impact der:v r:abstr der:s0" sem2="der:v t:impact t:stuff r:concr r:abstr"/>краски</w>, <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="что" gr="SPRO,acc,inan,n,norm,sg" sem="r:rel" sem2=""/>что</w> <w><ana lex="мамик" gr="