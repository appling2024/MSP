,sg" sem="r:abstr der:a" sem2=""/>определенности</w>.</se><se> «<w><ana lex="ждать" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="d:root" sem2="d:root"/>Жду</w> <w><ana lex="со" gr="PR,norm" sem="" sem2=""/>со</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дня</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w>», -- <w><ana lex="говорить" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="t:speech ca:noncaus d:root" sem2="d:root"/>говорит</w> <w><ana lex="николай" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Николай</w> <w><ana lex="петрович" gr="S,anim,m,nom,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Петрович</w>.</se></p>
<p><se><w><ana lex="кто" gr="SPRO,acc,anim,m,norm,sg" sem="r:rel" sem2=""/>Кого-то</w> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w> <w><ana lex="подсунуть" gr="V,3p,act,fut,indic,norm,pf,pl" sem="t:put ca:caus der:v d:pref" sem2="der:v d:pref"/>подсунут</w> <w><ana lex="помимо" gr="PR,norm" sem="" sem2=""/>помимо</w> <w><ana lex="мой" gr="APRO,gen,n,norm,sg" sem="r:poss" sem2=""/>моего</w> <w><ana lex="желание" gr="S,gen,inan,n,norm,sg" sem="t:psych:volit r:abstr" sem2="r:abstr"/>желания</w>!</se><se> <w>Говорят</w>, <w><ana lex="бурят" gr="S,anim,gen,m,norm,sg" sem="" sem2=""/>бурята</w>.</se><se> <w>Вероятно</w>, <w><ana lex="коммунист" gr="S,acc,anim,m,norm,sg" sem="t:hum r:concr der:s" sem2=""/>коммуниста</w>.</se><se> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>И</w> <w><ana lex="что" gr="SPRO,acc,inan,n,norm,sg" sem="r:rel" sem2=""/>что</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w> <w><ana lex="он" gr="SPRO,3p,m,nom,norm,sg" sem="r:pers" sem2=""/>он</w> <w><ana lex="быть" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>будет</w> <w><ana lex="делать" gr="V,act,inf,ipf,norm,tran" sem="d:root" sem2="d:root"/>делать</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="центральный" gr="A,f,loc,norm,plen,sg" sem="t:place dt:space r:rel der:s" sem2="dt:space t:hier r:rel der:s"/>Центральной</w> <w><ana lex="азия" gr="S,f,inan,loc,norm,sg" sem="r:propn t:topon" sem2=""/>Азии</w>?</se></p>
<p><se><w><ana lex="привезти" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2=""/>Привезены</w> (<w><ana lex="11" gr="NUM,ciph"/>11</w>/<w>VII</w>) <w><ana lex="мой" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>мои</w> «<w><ana lex="ребенок" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr" sem2="t:hum ev r:concr d:fil"/>дети</w> <w><ana lex="малый" gr="A,nom,norm,pl,plen" sem="t:size:min r:qual" sem2="t:time:age:min t:size:min r:qual"/>малые</w>» -- <w><ana lex="хронометр" gr="S,inan,m,nom,norm,pl" sem="der:comp t:tool:device:measur:metr r:concr" sem2=""/>хронометры</w>, <w><ana lex="идти" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus t:move d:root" sem2="ca:noncaus t:move d:root"/>идут</w> <w><ana lex="прилично" gr="ADV,norm" sem="t:quant:max ev:posit der:a" sem2="ev:posit der:a"/>прилично</w>, <w><ana lex="заводить" gr="V,1p,act,fut,indic,norm,pf,sg" sem="d:pref" sem2=""/><ana lex="заводить" gr="V,1p,act,fut,indic,norm,pf,sg,tran" sem="d:pref" sem2=""/><ana lex="завозить" gr="V,1p,act,fut,indic,norm,pf,sg" sem="ca:caus t:move d:pref" sem2=""/><ana lex="заводить" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="d:pref" sem2=""/><ana lex="завозить" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="ca:caus t:move d:pref" sem2=""/><ana lex="завозить" gr="V,1p,act,fut,indic,norm,pf,sg,tran" sem="ca:caus t:move d:pref" sem2=""/><ana lex="завозить" gr="V,1p,act,indic,ipf,norm,praes,sg" sem="ca:caus t:move d:pref" sem2=""/><ana lex="заводить" gr="V,1p,act,indic,ipf,norm,praes,sg" sem="d:pref" sem2=""/>завожу</w>!</se></p>
<p><se><b/><w><b>15</b></w><b>/</b><w><ana lex="vii" gr="bastard" sem="" sem2=""/><b>VII</b></w><b>, </b><w><ana lex="q" gr="bastard" sem="" sem2=""/><b>Q</b></w><b/>. <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="течение" gr="S,acc,inan,n,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="qc:stuff der:v t:move r:concr r:abstr"/>течение</w> <w><ana lex="весь" gr="APRO,gen,m,norm,sg" sem="r:spec" sem2=""/>всего</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дня</w> <w><ana lex="скука" gr="S,f,inan,nom,norm,sg" sem="t:psych:emot r:abstr" sem2="t:psych:emot r:abstr"/>скука</w> <w><ana lex="смертный" gr="A,f,nom,norm,plen,sg" sem="r:rel der:s" sem2="r:rel der:s t:humq:char r:qual"/>смертная</w>.</se><se> <w>Главное</w>, <w><ana lex="все" gr="SPRO,nom,norm,pl" sem="" sem2=""/>все</w> <w><ana lex="разъехаться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus t:move d:pref" sem2="ca:noncaus t:move d:pref"/>разъехались</w>, <w>нет</w> <w><ana lex="мой" gr="APRO,f,gen,norm,sg" sem="r:poss" sem2=""/>моей</w> <w><ana lex="милый" gr="A,f,gen,norm,plen,sg" sem="t:humq r:qual" sem2="ev:posit t:social:emot r:qual"/>милой</w> <w><ana lex="соседка" gr="S,anim,f,gen,norm,sg" sem="t:hum d:fem r:concr der:s" sem2=""/>соседки</w>, <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="кто" gr="SPRO,anim,dat,m,norm,sg" sem="r:rel" sem2=""/>кому</w> <w><ana lex="сходить" gr="V,act,inf,norm,pf" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="сходить" gr="V,act,inf,intr,ipf,norm" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/>сходить</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="кто" gr="SPRO,anim,ins,m,norm,sg" sem="r:rel" sem2=""/>кем</w> <w><ana lex="погулять" gr="V,act,inf,intr,norm,pf" sem="ca:noncaus t:move d:pref" sem2=""/>погулять</w>, <w><ana lex="побеседовать" gr="V,act,inf,intr,norm,pf" sem="der:v d:pref" sem2=""/>побеседовать</w>, <w><ana lex="помечтать" gr="V,act,inf,intr,norm,pf" sem="d:pref" sem2=""/>помечтать</w>; <w><ana lex="все" gr="ADV,norm" sem="" sem2=""/>все</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="лоно" gr="S,inan,loc,n,norm,sg" sem="pt:partb r:concr pc:hum" sem2=""/>лоне</w> <w><ana lex="природа" gr="S,f,gen,inan,norm,sg" sem="pt:aggr t:space r:concr sc:space" sem2="pt:aggr t:space r:concr r:abstr sc:space"/>природы</w>, <w><ana lex="все" gr="SPRO,nom,norm,pl" sem="" sem2=""/>все</w> <w><ana lex="дышать" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus t:physiol d:root" sem2="d:root"/>дышат</w> <w><ana lex="полный" gr="A,f,ins,norm,plen,sg" sem="t:content r:qual" sem2="t:degr t:appearance r:qual"/>полной</w> <w><ana lex="грудь" gr="S,f,inan,ins,norm,sg" sem="top:contain pc:hum pc:animal pt:partb top:jut top:vertical r:concr" sem2="pt:partb pc:tool:cloth r:concr pt:part pc:hum"/>грудью</w>, <w><ana lex="набираться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v d:pref" sem2=""/>набираются</w> <w><ana lex="сила" gr="S,f,gen,inan,norm,pl" sem="sc:hum t:pers r:abstr pt:aggr:aggrpl t:param r:concr" sem2="pt:aggr sc:hum ev:posit t:quant:max pt:qtm r:abstr pt:aggr:aggrpl der:shift r:concr"/>сил</w> <w><ana lex="перед" gr="PR,norm" sem="" sem2=""/>перед</w> <w><ana lex="зимний" gr="A,ins,n,norm,plen,sg" sem="dt:time dt:abstr dt:time:season der:s t:time r:rel" sem2=""/>зимним</w> <w><ana lex="докучливый" gr="A,ins,n,norm,plen,sg" sem="der:v t:humq ev:neg r:qual" sem2=""/>докучливым</w> <w><ana lex="сидение" gr="S,inan,ins,n,norm,sg" sem="der:v r:abstr" sem2=""/>сидением</w>, <w><ana lex="весь" gr="APRO,nom,norm,pl" sem="r:spec" sem2=""/>все</w> <w><ana lex="иметь" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="ca:noncaus d:root t:poss" sem2="d:root"/>имеют</w> <w><ana lex="тот" gr="APRO,acc,f,norm,sg" sem="r:dem" sem2=""/>ту</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="иной" gr="APRO,acc,f,norm,sg" sem="r:spec" sem2="r:spec"/>иную</w> <w><ana lex="цель" gr="S,acc,f,inan,norm,sg" sem="t:space r:concr" sem2="t:ment r:abstr"/>цель</w>!</se><se> <w><ana lex="вспоминать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="der:v d:pref" sem2="der:v d:pref"/>Вспоминает</w> <w><ana lex="ли" gr="PART,norm" sem="" sem2=""/>ли</w> <w><ana lex="мой" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/>моя</w> <w><ana lex="милый" gr="A,f,nom,norm,plen,sg" sem="t:humq r:qual" sem2="ev:posit t:social:emot r:qual"/>милая</w> <w><ana lex="соседка" gr="S,anim,f,nom,norm,sg" sem="t:hum d:fem r:concr der:s" sem2=""/>соседка</w> <w><ana lex="то" gr="SPRO,gen,inan,n,norm,sg" sem="r:dem" sem2=""/>того</w>, <w><ana lex="кто" gr="SPRO,anim,m,nom,norm,sg" sem="r:rel" sem2=""/>кто</w> <w><ana lex="она" gr="SPRO,3p,acc,f,norm,sg" sem="r:pers" sem2=""/>ее</w> <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>сегодня</w> <w><ana lex="вспомнить" gr="V,act,indic,m,norm,pf,praet,sg" sem="t:ment ca:noncaus der:v d:pref" sem2="t:ment ca:noncaus der:v d:pref"/><ana lex="вспомнить" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="t:ment ca:noncaus der:v d:pref" sem2="t:ment ca:noncaus der:v d:pref"/><ana lex="вспомнить" gr="V,act,indic,m,norm,pf,praet,sg,tran" sem="t:ment ca:noncaus der:v d:pref" sem2="t:ment ca:noncaus der:v d:pref"/>вспомнил</w> <w><ana lex="бесконечный" gr="A,acc,n,norm,plen,sg" sem="d:carit t:size:max r:rel der:s" sem2="t:time:dur t:degr d:carit der:s r:qual"/>бесконечное</w> <w><ana lex="число" gr="S,acc,inan,n,norm,sg" sem="r:abstr" sem2="pt:set der:shift r:abstr t:time"/>число</w> <w><ana lex="раз" gr="S,gen,inan,m,norm,pl" sem="pt:qtm r:abstr" sem2="pt:qtm r:abstr t:card"/>раз</w>?</se> </p>
<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="интерес" gr="S,inan,ins,m,norm,sg" sem="t:ment r:abstr" sem2="r:abstr ev:neg"/>интересом</w> <w><ana lex="просматривать" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="der:v ca:noncaus d:pref t:perc d:impf" sem2="der:v ca:noncaus d:pref t:perc d:impf"/>просматривал</w> «<w><ana lex="исторический" gr="A,nom,norm,pl,plen" sem="dt:abstr r:rel der:s" sem2="dt:abstr r:rel der:s"/>Исторические</w> <w><ana lex="портрет" gr="S,inan,m,nom,norm,pl" sem="r:concr t:workart" sem2="r:concr t:text"/>портреты</w>».</se><se> <w><ana lex="как" gr="ADVPRO,norm" sem="r:rel t:manner" sem2=""/>Как</w> <w>много</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="они" gr="SPRO,3p,gen,norm,pl" sem="r:pers" sem2=""/>них</w> <w><ana lex="поучительный" gr="A,acc,anim,m,norm,plen,sg" sem="der:v r:rel dt:speech" sem2=""/>поучительного</w>, <w><ana lex="занятный" gr="A,acc,anim,m,norm,plen,sg" sem="r:qual" sem2=""/>занятного</w>.</se><se> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>По</w> <w><ana lex="возвращение" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr t:poss" sem2=""/>возвращении</w> <w><ana lex="непременно" gr="ADV,norm" sem="der:a" sem2=""/>непременно</w> <w><ana lex="осилить" gr="V,1p,act,fut,indic,norm,pf,sg" sem="d:pref" sem2=""/>осилю</w> <w><ana lex="они" gr="SPRO,acc,anim,norm,pl" sem="r:pers" sem2=""/>их</w>.</se><se> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>По</w> <w><ana lex="крайний" gr="A,dat,f,norm,plen,sg" sem="dt:space t:dist r:rel der:s t:ord" sem2="dt:space t:degr:max:magn r:rel der:s r:qual"/>крайней</w> <w><ana lex="мера" gr="S,dat,f,inan,norm,sg" sem="t:unit r:abstr pt:class" sem2="t:unit r:abstr"/><ana lex="меря" gr="S,dat,f,inan,norm,sg" sem="pt:aggr r:concr" sem2=""/>мере</w> <w>надо</w> <w><ana lex="проштудировать" gr="V,act,inf,norm,pf,tran" sem="der:v d:pref" sem2=""/>проштудировать</w> <w><ana lex="хорошенько" gr="ADV,norm" sem="d:dim ev:posit der:adv" sem2=""/>хорошенько</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana form="кое-что" lex="кое-что" gr="SPRO,inan,n,nom,norm,sg" sem="r:indet" sem2=""/>кое-что</w> <w><ana lex="наиболее" gr="ADV,norm" sem="t:degr:max der:adv" sem2=""/>наиболее</w> <w><ana lex="замечательный" gr="A,n,nom,norm,plen,sg" sem="der:v ev:posit t:quality r:qual" sem2=""/>замечательное</w> <w><ana lex="следовать" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="ca:noncaus t:move der:s" sem2="ca:noncaus t:move der:s"/>следует</w> <w><ana lex="непременно" gr="ADV,norm" sem="der:a" sem2=""/>непременно</w> <w><ana lex="прочесть" gr="V,act,inf,norm,pf" sem="d:pref" sem2=""/><ana lex="прочитать" gr="V,act,inf,norm,pf" sem="der:v d:pref" sem2="der:v d:pref"/>прочесть</w> <w><ana lex="сплошь" gr="ADV,norm" sem="dt:degr:max der:a" sem2=""/>сплошь</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="полностью" gr="ADV,norm" sem="dt:full t:degr:max der:a" sem2=""/>полностью</w>, <w><ana lex="как" gr="ADVPRO,norm" sem="r:rel t:manner" sem2=""/>как</w> <w>например</w> <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>сегодня</w>, <w><ana lex="во" gr="PR,norm" sem="" sem2=""/>во</w> <w>II</w> <w><ana lex="том" gr="S,anim,loc,m,norm,persn,sg" sem="" sem2=""/><ana lex="том" gr="S,inan,loc,m,norm,sg" sem="pc:text r:concr t:text pt:part t:pers" sem2=""/>томе</w> -- <w><ana lex="екатерининский" gr="A,f,nom,norm,plen,sg" sem="dt:persn r:rel der:s" sem2=""/>Екатерининская</w> <w><ana lex="эпоха" gr="S,f,inan,nom,norm,sg" sem="t:time:period t:time:age r:abstr" sem2=""/>эпоха</w>, <w><ana lex="сестра" gr="S,anim,f,nom,norm,pl" sem="" sem2="t:hum r:concr"/>сестры</w> (<w><ana lex="три" gr="NUM,nom,norm" sem="r:card:pauc" sem2=""/>три</w>) <w><ana lex="энгельгардт" gr="S,anim,bastard,famn,m,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Энгельгардт</w>, <w><ana lex="родной" gr="A,nom,norm,pl,plen" sem="t:humq:char r:qual" sem2="ev:posit t:social:emot t:humq:char r:qual"/>родные</w> <w><ana lex="племянница" gr="S,anim,f,nom,norm,pl" sem="" sem2=""/>племянницы</w> <w><ana lex="потемкин" gr="S,anim,famn,gen,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Потемкина</w>.</se></p>
<p><se><w><ana lex="между" gr="PR,norm" sem="" sem2=""/>Между</w> <w><ana lex="прочее" gr="SPRO,ins,n,norm,sg" sem="" sem2=""/>прочим</w>, <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>сегодня</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w> <w><ana lex="около" gr="PR,norm" sem="" sem2=""/>около</w> <w><ana lex="12" gr="NUM,ciph"/>12</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w> <w><ana lex="сгуститься" gr="V,act,indic,intr,norm,pf,pl,praet" sem="dt:physq der:a der:v t:changest ca:noncaus d:pref" sem2=""/>сгустились</w> <w><ana lex="туча" gr="S,f,inan,nom,norm,pl" sem="qc:stuff top:form r:concr" sem2="t:quant:max pt:qtm r:concr r:abstr"/>тучи</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="пойти" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/>пошел</w> <w><ana lex="дождь" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2="pt:set sc:x r:concr"/>дождь</w>; <w><ana lex="вскоре" gr="ADV,norm" sem="der:adv t:time" sem2=""/>вскоре</w> <w><ana lex="еще" gr="ADV,norm" sem="" sem2=""/>еще</w> <w><ana lex="сильно" gr="ADV,comp,norm" sem="dt:physq t:degr:max der:a" sem2="dt:physq der:a"/>сильнее</w> <w><ana lex="подуть" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="d:pref" sem2="d:pref"/>подул</w> <w><ana lex="ветер" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>ветер</w>, <w><ana lex="приносить" gr="V,act,ger,ipf,norm,praes,tran" sem="ca:caus t:move d:pref" sem2=""/>принося</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="себе" gr="SPRO,ins,norm" sem="" sem2=""/>собою</w> <w><ana lex="облако" gr="S,acc,inan,n,norm,pl" sem="qc:stuff r:concr" sem2="qc:stuff pt:qtm top:form r:concr"/>облака</w>.</se><se> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>К</w> <w><ana lex="вечер" gr="S,dat,inan,m,norm,sg" sem="pc:day r:abstr