<p><se><w><ana lex="мой" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/>Моя</w> <w><ana lex="муська" gr="S,anim,f,nom,norm,persn,sg" sem="d:dimb t:animal r:propn" sem2="t:hum r:propn t:persn"/>Муська</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="хорошо" gr="ADV,PRAEDIC,norm" sem="ev:posit dt:quality der:a" sem2=""/><ana lex="хорошо" gr="ADV,PARENTH,norm" sem="ev:posit dt:quality der:a" sem2=""/>хорошо</w> <w><ana lex="чувствовать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="ca:noncaus t:perc der:s" sem2="der:s"/>чувствует</w> <w><ana lex="себе" gr="SPRO,acc,norm" sem="" sem2=""/>себя</w>, <w><ana lex="она" gr="SPRO,3p,f,nom,norm,sg" sem="r:pers" sem2=""/>она</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="ребенок" gr="S,anim,ins,m,norm,pl" sem="t:hum r:concr" sem2="t:hum ev r:concr d:fil"/>детьми</w>, <w><ana lex="который" gr="APRO,nom,norm,pl" sem="r:rel t:ord" sem2=""/>которые</w> <w><ana lex="она" gr="SPRO,3p,acc,f,norm,sg" sem="r:pers" sem2=""/>ее</w> <w><ana lex="радовать" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="der:v ca:caus t:psych:emot" sem2=""/>радуют</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="тепло" gr="S,inan,loc,n,norm,sg" sem="r:abstr t:temper" sem2="t:psych:emot r:abstr"/>тепле</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="удобство" gr="S,inan,loc,n,norm,sg" sem="r:abstr der:a" sem2="pt:aggr:aggrpl r:concr sc:tool"/>удобстве</w>.</se><se> <w><ana lex="прекрасный" gr="A,nom,norm,pl,plen" sem="ev:posit t:appearance r:qual" sem2="ev:posit t:quality r:qual"/>Прекрасные</w> <w><ana lex="известие" gr="S,inan,n,nom,norm,pl" sem="t:speech r:abstr" sem2="der:v r:propn r:concr t:text t:media"/>известия</w> <w><ana lex="всегда" gr="ADVPRO,norm" sem="r:spec t:time" sem2=""/>всегда</w> <w><ana lex="бодрить" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="" sem2=""/>бодрят</w> <w><ana lex="человек" gr="S,acc,anim,m,norm,sg" sem="t:hum r:concr" se