""/>что</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="тот" gr="APRO,acc,n,norm,sg" sem="r:dem" sem2=""/>то</w> <w><ana lex="время" gr="S,acc,inan,n,norm,sg" sem="r:abstr t:param t:time" sem2="t:time:period r:abstr t:time"/>время</w>, <w><ana lex="когда" gr="CONJ,norm" sem="" sem2=""/>когда</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="урга" gr="S,f,inan,loc,norm,sg" sem="r:propn t:topon" sem2=""/>Урге</w> <w><ana lex="ветер" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>ветер</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w>холодно</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="сангина" gr="S,f,inan,loc,norm,sg" sem="" sem2=""/>Сангине</w> <w><ana lex="тихо" gr="ADV,norm" sem="dt:sound der:a" sem2="ev dt:sound der:a"/>тихо</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="солнце" gr="S,inan,n,nom,norm,sg" sem="top:horiz top:spher t:astr t:space r:concr" sem2="ev:posit t:space r:concr r:abstr t:light"/>солнце</w> <w><ana lex="пригревать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="der:v t:changest d:pref d:impf" sem2=""/>пригревает</w> <w><ana lex="настолько" gr="ADV,norm" sem="der:adv r:dem" sem2=""/>настолько</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="становиться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus" sem2=""/>становится</w> <w><ana lex="вообще" gr="ADV,PARENTH,norm" sem="dt:general der:a" sem2=""/>вообще</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w>приятно</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="особенность" gr="S,f,inan,loc,norm,sg" sem="r:abstr der:a" sem2="r:abstr der:a"/>особенности</w> <w><ana lex="среди" gr="PR,norm" sem="" sem2=""/>среди</w> <w><ana lex="заросль" gr="S,f,gen,inan,norm,pl" sem="pt:aggr:aggrpl pt:aggr t:space r:concr sc:plant" sem2=""/>зарослей</w> <w><ana lex="тальник" gr="S,gen,inan,m,norm,sg" sem="t:space sc:plant pt:aggr t:plant:bush der:s r:concr" sem2=""/>тальника</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="другой" gr="APRO,gen,norm,pl" sem="r:spec" sem2="r:ord r:spec r:indet"/>других</w> <w><ana lex="куст" gr="S,gen,inan,m,norm,pl" sem="t:plant r:concr" sem2="pt:set sc:org t:plant r:concr t:org"/>кустов</w>.</se></p>
<p><se><w><ana lex="наконец" gr="ADV,PARENTH,norm" sem="der:s t:time" sem2=""/>Наконец-то</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="побывать" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v d:pref"/>побывал</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="парикмахер" gr="S,acc,anim,m,norm,sg" sem="t:hum r:concr" sem2=""/>парикмахера</w>, <w><ana lex="вымыться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="t:impact ca:noncaus d:pref" sem2=""/>вымылся</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="баня" gr="S,f,inan,loc,norm,sg" sem="top:contain t:constr:build r:concr t:org" sem2="r:abstr"/>бане</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="целый" gr="A,acc,inan,m,norm,plen,sg" sem="t:degr r:qual" sem2="t:degr r:spec r:qual"/>целый</w> <w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w> <w><ana lex="ждать" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="d:root" sem2="d:root"/>ждал</w> <w><ana lex="мой" gr="APRO,f,gen,norm,sg" sem="r:poss" sem2=""/>моей</w> <w><ana lex="пшевочка" gr="S,anim,bastard,f,gen,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/><ana lex="пшевочка" gr="S,anim,bastard,f,gen,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/><ana lex="пшевочка" gr="S,bastard,f,gen,inan,sg" sem="" sem2=""/>Пшевочки</w>!</se><se> <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>А</w> <w><ana lex="она" gr="SPRO,3p,acc,f,norm,sg" sem="r:pers" sem2=""/>ее</w> <w><ana lex="все" gr="ADV,norm" sem="" sem2=""/>все</w> <w>нет</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w>нет</w>!</se></p>
<p><se><w><ana lex="кондратьев" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Кондратьев</w> <w><ana lex="запасаться" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="der:v d:pref" sem2=""/>запасался</w> <w><ana lex="продукт" gr="S,inan,ins,m,norm,pl" sem="t:thing r:concr" sem2="t:food hi:class sc:food r:abstr pt:aggr:aggrpl r:concr"/>продуктами</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="предстоящий" gr="A,acc,f,norm,plen,sg" sem="der:v r:rel t:time" sem2=""/>предстоящую</w> <w><ana lex="экскурсия" gr="S,acc,f,inan,norm,sg" sem="t:action t:move r:abstr" sem2="t:group pt:set r:concr sc:hum"/>экскурсию</w>.</se></p>
<p><se><b/><w><b>11</b></w><b>/</b><w><ana lex="iii" gr="bastard" sem="" sem2=""/><b>III</b></w><b>, </b><w><ana lex="u" gr="bastard" sem="" sem2=""/><b>U</b></w><b/>. <w><ana lex="ветер" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>Ветер</w> <w><ana lex="порывистый" gr="A,m,nom,norm,plen,sg" sem="t:physq der:s:deverb dt:space r:qual" sem2="t:humq der:shift:n t:physq dt:space r:qual der:s:deverb"/>порывистый</w> <w><ana lex="со" gr="PR,norm" sem="" sem2=""/>со</w> <w><ana lex="весь" gr="APRO,gen,norm,pl" sem="r:spec" sem2=""/>всех</w> <w><ana lex="сторона" gr="S,f,gen,inan,norm,pl" sem="t:space r:concr pt:part pc:space" sem2="sc:hum t:space t:asp:ment r:abstr pt:set pc:x pt:part pc:space r:concr pc:form:geom"/>сторон</w>!</se><se> <w><ana lex="небо" gr="S,inan,n,nom,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/><ana lex="небо" gr="S,inan,n,nom,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/>Небо</w> <w><ana lex="ясный" gr="A,brev,n,norm,sg" sem="r:qual" sem2="r:qual"/>ясно</w>, <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="исключение" gr="S,inan,ins,n,norm,sg" sem="t:put der:v r:abstr der:s0" sem2="r:abstr"/>исключением</w> <w><ana lex="восточный" gr="A,f,gen,norm,plen,sg" sem="t:place dt:space r:rel der:s" sem2=""/>восточной</w> <w><ana lex="часть" gr="S,f,gen,inan,norm,sg" sem="r:concr pc:x pt:part" sem2="pc:org r:abstr sc:part t:org pt:ind pt:aggr:aggrpl t:poss der:shift pc:x pt:part pc:text r:concr"/>части</w> <w><ana lex="горизонт" gr="S,gen,inan,m,norm,sg" sem="t:space r:concr" sem2="t:ment t:space qc:stuff pt:qtm r:abstr pt:aggr r:concr"/>горизонта</w>, <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="который" gr="APRO,loc,m,norm,sg" sem="r:rel t:ord" sem2=""/>котором</w> <w><ana lex="лежать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:loc:body ca:nonca