r="A,acc,inan,m,norm,plen,sg" sem="r:rel der:s" sem2="r:rel der:s"/>Зоологический</w> <w><ana lex="музей" gr="S,acc,inan,m,norm,sg" sem="r:concr t:org" sem2=""/>музей</w> <w><ana lex="академия" gr="S,f,gen,inan,norm,sg" sem="r:concr t:org" sem2="r:concr t:org"/>Академии</w> <w><ana lex="наука" gr="S,f,gen,inan,norm,pl" sem="r:abstr" sem2="ev:posit r:abstr"/>наук</w>.</se><se> <w>Надо</w> <w><ana lex="также" gr="PART,norm" sem="" sem2=""/>также</w> <w><ana lex="написать" gr="V,act,inf,norm,pf,tran" sem="der:v d:pref" sem2=""/>написать</w> <w><ana lex="родные" gr="S,anim,dat,norm,pl" sem="" sem2=""/>родным</w>, <w><ana lex="друг" gr="S,anim,dat,m,norm,pl" sem="t:hum r:concr" sem2="t:hum r:concr"/>друзьям</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="близкий" gr="A,dat,norm,pl,plen" sem="t:dist:min r:qual" sem2="t:social:emot r:qual der:shift t:like t:time t:social"/>близким</w> <w><ana lex="знакомый" gr="S,anim,dat,m,norm,pl" sem="der:v t:hum r:concr der:subst" sem2=""/>знакомым</w>.</se><se> <w>Надо</w> <w><ana lex="также" gr="PART,norm" sem="" sem2=""/>также</w> <w><ana lex="все" gr="SPRO,acc,inan,n,norm,sg" sem="" sem2=""/>все</w> <w><ana lex="привести" gr="V,act,inf,norm,pf" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref ca:bgr aux:caus"/>привести</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="порядок" gr="S,acc,inan,m,norm,sg" sem="ev:posit r:abstr" sem2="sc:hum ev:posit r:concr r:abstr t:asp:move"/>порядок</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="часть" gr="S,f,inan,loc,norm,sg" sem="r:concr pc:x pt:part" sem2="pc:org r:abstr sc:part t:org pt:ind pt:aggr:aggrpl t:poss der:shift pc:x pt:part pc:text r:concr"/>части</w> <w><ana lex="орнитологический" gr="A,gen,norm,pl,plen" sem="r:rel der:s" sem2="r:rel der:s"/>орнитологических</w> <w><ana lex="сбор" gr="S,gen,inan,m,norm,pl" sem="der:v r:abstr der:s0" sem2="der:v t:action r:abstr t:poss sc:money pt:aggr r:concr"/>сборов</w>.</se></p>
<p><se><w><ana lex="час" gr="S,gen,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>Часа</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="4" gr="NUM,ciph"/>4</w> <w><ana lex="стать" gr="V,act,indic,intr,norm,pf,pl,praet" sem="aux:phase d:root t:move:body" sem2="ca:noncaus t:move d:root t:loc"/>стали</w> <w><ana lex="появляться" gr="V,act,inf,intr,ipf,norm" sem="der:v d:pref" sem2=""/>появляться</w> <w><ana lex="облако" gr="S,acc,inan,n,norm,pl" sem="qc:stuff r:concr" sem2="qc:stuff pt:qtm top:form r:concr"/>облака</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="запад" gr="S,inan,loc,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr pt:part pc:space"/>западе</w>.</se><se> <w><ana lex="барометр" gr="S,inan,m,nom,norm,sg" sem="der:comp t:tool:device:measur:metr r:concr" sem2="r:abstr"/>Барометр</w> <w><ana lex="стоять" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:noncaus"/><ana lex="стоить" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="d:root" sem2="d:root"/>стоит</w> <w><ana lex="низко" gr="ADV,norm" sem="dt:size:min t:dir der:a" sem2="t:place dt:size:min der:a"/>низко</w>.</se><se> <w><ana lex="луна" gr="S,f,inan,nom,norm,sg" sem="top:horiz top:spher t:astr t:space r:concr" sem2="t:space r:concr t:astr top:spher top:horiz pt:addit"/>Луна</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="область" gr="S,f,inan,loc,norm,sg" sem="t:space r:concr pt:part pc:space" sem2="t:space r:concr r:abstr pt:part pc:space"/>области</w> <w><ana lex="тонко" gr="ADV,norm" sem="dt:size:min ev:posit der:a" sem2="dt:size:min ev der:a"/>тонко-перистых</w> <w><ana lex="облако" gr="S,gen,inan,n,norm,pl" sem="qc:stuff r:concr" sem2="qc:stuff pt:qtm top:form r:concr"/>облаков</w>.</se><se> <w><ana lex="что" gr="SPRO,inan,n,nom,norm,sg" sem="r:rel" sem2=""/>Что</w> <w><ana lex="быть" gr="V,3p,act,fut,indic,intr,norm,pf,sg"