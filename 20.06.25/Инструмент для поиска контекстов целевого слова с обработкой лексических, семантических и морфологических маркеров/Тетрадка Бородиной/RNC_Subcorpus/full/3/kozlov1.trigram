<p><se><w><ana lex="у" gr="PR,norm" sem="" sem2=""/>У</w> <w><ana lex="я" gr="SPRO,1p,gen,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="совещание" gr="S,inan,n,nom,norm,sg" sem="t:action r:abstr" sem2=""/>совещание</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="приискание" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr" sem2=""/>приискании</w> <w><ana lex="лучший" gr="A,gen,m,norm,sg,supr" sem="d:super ev:posit der:a t:quality r:qual" sem2=""/>лучшего</w> <w><ana lex="уголок" gr="S,gen,inan,m,norm,sg" sem="dt:form t:form top:corner top:form der:s d:dim r:concr" sem2="pt:aggr sc:tool t:tool t:space top:contain dt:space top:corner t:room pt:ind t:sign dt:part top:form pc:x pt:part d:dim r:concr pc:room der:s"/>уголка</w> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="лагерь" gr="S,gen,inan,m,norm,sg" sem="t:space r:concr" sem2="t:group pt:set t:space r:concr sc:hum"/>лагеря</w> <w><ana lex="пастух" gr="S,anim,gen,m,norm,pl" sem="der:v t:hum r:concr d:nag t:prof" sem2=""/>пастухов</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="пастьба" gr="S,f,gen,inan,norm,sg" sem="r:abstr" sem2=""/>пастьбы</w> <w><ana lex="верблюд" gr="S,anim,gen,m,norm,pl" sem="t:animal r:concr" sem2=""/>верблюдов</w>.</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="совет" gr="S,inan,loc,m,norm,sg" sem="t:speech r:abstr" sem2="pc:org ev:posit t:action r:abstr t:org t:inter der:shift pt:part r:concr"/>совете</w> <w><ana lex="значащий" gr="A,m,nom,norm,plen,sg" sem="der:v r:rel" sem2=""/>значащий</w> <w><ana lex="голос" gr="S,inan,m,nom,norm,sg" sem="t:sound r:abstr" sem2="t:ment sc:org r:abstr pt:aggr:aggrpl pc:workmus t:sound pt:part ev:neg r:concr"/>голос</w> <w><ana lex="цокто" gr="S,0,anim,bastard,m,sg" sem="t:hum r:propn t:persn" sem2=""/>Цокто</w> <w><ana lex="гармаевич" gr="S,acc,anim,bastard,m,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Гармаевича</w> <w><ana lex="с" gr="PR,norm" sem="" sem