,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v d:pref"/><ana lex="проноситься" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/>пронесся</w> <w><ana lex="subbuteo" gr="bastard" sem="" sem2=""/>Subbuteo</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="красный" gr="A,loc,norm,pl,plen" sem="t:physq:color r:qual" sem2="ev:posit dt:physq:color der:shift r:qual t:species r:rel"/>красных</w> <w><ana lex="штаны" gr="S,inan,loc,norm,pl" sem="t:tool:cloth r:concr" sem2=""/>штанах</w>.</se><se> <w><ana lex="скоро" gr="ADV,norm" sem="dt:speed:max der:a t:time" sem2="dt:speed:max der:a t:time"/>Скоро</w> <w><ana lex="вступить" gr="V,1p,act,fut,indic,intr,norm,pf,pl" sem="der:v ca:noncaus t:move d:pref" sem2="der:v d:pref"/><ana lex="вступить" gr="V,1p,act,imper,intr,norm,pf,pl" sem="der:v ca:noncaus t:move d:pref" sem2="der:v d:pref"/>вступим</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="долина" gr="S,acc,anim,f,famn,norm,sg" sem="" sem2=""/><ana lex="долина" gr="S,acc,f,inan,norm,sg" sem="t:space r:concr der:s t:fam" sem2=""/>долину</w> <w><ana lex="красавица" gr="S,anim,f,gen,norm,sg" sem="t:hum d:fem r:concr der:s" sem2=""/>красавицы</w> <w><ana lex="ангара" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Ангары</w>.</se><se> <w>Итак</w>, <w><ana lex="близиться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus" sem2=""/>близится</w> <w><ana lex="давно" gr="ADV,norm" sem="t:time" sem2=""/>давно</w> <w><ana lex="ждать" gr="V,ipf,m,nom,norm,partcp,pass,plen,praet,sg" sem="d:root" sem2="d:root"/>жданный</w> <w><ana lex="иркутск" gr="S,inan,m,nom,norm,sg" sem="r:propn t:topon" sem2=""/>Иркутск</w>.</se><se> <w><ana lex="получить" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:noncaus t:poss" sem2=""/>Получил</w> <w><ana lex="ли" gr="PART,norm" sem="" sem2=""/>ли</w> <w><ana lex="мой" gr="APRO,acc,f,norm,sg" sem="r:poss" sem2=""/>мою</w> <w><ana lex="телеграмма" gr="S,acc,f,inan,norm,sg" sem="der:comp r:concr t:text" sem2=""/>телеграмму</w> <w><ana lex="семен" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Семен</w> <w><ana lex="николаевич" gr="S,anim,m,nom,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Николаевич</w> <w><ana lex="родионов" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Родионов</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="объявиться" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="ca:noncaus d:pref" sem2=""/>объявится</w> <w><ana lex="ли" gr="PART,norm" sem="" sem2=""/>ли</w> <w><ana lex="он" gr="SPRO,3p,m,nom,norm,sg" sem="r:pers" sem2=""/>он</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="вокзал" gr="S,inan,loc,m,norm,sg" sem="top:contain t:constr r:concr" sem2=""/>вокзале</w>?</se><se> <w><ana lex="скоро" gr="ADV,norm" sem="dt:speed:max der:a t:time" sem2="dt:speed:max der:a t:time"/>Скоро</w> <w><ana lex="узнавать" gr="V,1p,act,indic,ipf,norm,pl,praes,tran" sem="t:ment der:v d:pref d:impf" sem2=""/><ana lex="узнать" gr="V,1p,act,fut,indic,norm,pf,pl,tran" sem="d:pref" sem2="t:ment ca:noncaus d:pref"/><ana lex="узнать" gr="V,1p,act,imper,norm,pf,pl,tran" sem="d:pref" sem2="t:ment ca:noncaus d:pref"/>узнаем</w>.</se><se> <w>Черемхово</w> <w><ana lex="дымить" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="" sem2=""/>дымит</w>: <w><ana lex="работать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:s" sem2="der:s"/>работает</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="добыча" gr="S,f,inan,loc,norm,sg" sem="der:v r:abstr der:s0 t:poss" sem2="sc:thing r:abstr pt:ind der:v t:poss pt:aggr r:concr"/>добыче</w> <w><ana lex="каменный" gr="A,gen,m,norm,plen,sg" sem="dt:stuff dt:stone r:rel der:s" sem2="r:rel dt:stuff dt:stone der:shift der:s ev:neg t:psych:emot"/>каменного</w> <w><ana lex="угль" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr" sem2=""/>угля</w>, <w><ana lex="который" gr="APRO,ins,m,norm,sg" sem="r:rel t:ord" sem2=""/>которым</w> <w><ana lex="отапливаться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus d:pref d:impf" sem2=""/>отапливаются</w> <w><ana lex="весь" gr="APRO,nom,norm,pl" sem="r:spec" sem2=""/>все</w> <w><ana lex="окрестный" gr="A,nom,norm,pl,plen" sem="t:place r:rel der:adv" sem2=""/>окрестные</w> <w><ana lex="паровоз" gr="S,inan,m,nom,norm,pl" sem="der:comp t:tool:transp r:concr" sem2=""/>паровозы</w>.</se><se> <w><ana lex="что" gr="SPRO,inan,n,nom,norm,sg" sem="r:rel" sem2=""/>Что</w> <w><ana lex="дать" gr="V,3p,act,fut,indic,norm,pf,sg" sem="ca:caus d:root t:poss" sem2="d:root"/>даст</w> <w><ana lex="мы" gr="SPRO,1p,dat,norm,pl" sem="r:pers" sem2=""/>нам</w> <w><ana lex="интересный" gr="A,acc,anim,m,norm,plen,sg" sem="dt:abstr der:s dt:ment r:qual" sem2="dt:abstr ev:posit der:s dt:ment r:qual"/>интересного</w> <w><ana lex="иркутск" gr="S,acc,inan,m,norm,sg" sem="r:propn t:topon" sem2=""/>Иркутск</w>?</se><se> <w><ana lex="что" gr="SPRO,acc,inan,n,norm,sg" sem="r:rel" sem2=""/>Что</w> <w><ana lex="узнавать" gr="V,1p,act,indic,ipf,norm,pl,praes,tran" sem="t:ment der:v d:pref d:impf" sem2=""/><ana lex="узнать" gr="V,1p,act,fut,indic,norm,pf,pl,tran" sem="d:pref" sem2="t:ment ca:noncaus d:pref"/><ana lex="узнать" gr="V,1p,act,imper,norm,pf,pl,tran" sem="d:pref" sem2="t:ment ca:noncaus d:pref"/>узнаем</w>, <w><ana lex="кто" gr="SPRO,acc,anim,m,norm,sg" sem="r:rel" sem2=""/>кого</w> <w><ana lex="увидеть" gr="V,1p,act,fut,indic,norm,pf,pl,tran" sem="ca:noncaus d:pref t:perc" sem2=""/><ana lex="увидеть" gr="V,1p,act,imper,norm,pf,pl,tran" sem="ca:noncaus d:pref t:perc" sem2=""/>увидим</w>, <w><ana lex="что" gr="SPRO,acc,inan,n,norm,sg" sem="r:rel" sem2=""/>что</w> <w><ana lex="сделать" gr="V,act,indic,m,norm,pf,praet,sg,tran" sem="d:pref" sem2=""/>сделал</w> <w><ana lex="наш" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>наш</w> <w><ana lex="саранцев" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Саранцев</w>?</se><se> <w>Тепло</w>, <w>сухо</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w>пыльно</w>!</se></p>
<p><se><w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>А</w> <w><ana lex="вот" gr="PART,norm" sem="" sem2="r:dem"/>вот</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="иркутск" gr="S,inan,m,nom,norm,sg" sem="r:propn t:topon" sem2=""/>Иркутск</w>: <w><ana lex="поезд" gr="S,inan,m,nom,norm,sg" sem="sc:tool:transp t:tool:transp r:concr" sem2="pt:set sc:tool:transp r:concr"/>поезд</w> <w><ana lex="наш" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>наш</w> <w><ana lex="прибыть" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2="d:pref"/>прибыл</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="1" gr="NUM,ciph"/>1</w>/<w><ana lex="4" gr="NUM,ciph"/>4</w> <w><ana lex="час" gr="S,gen,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часа</w> <w><ana lex="ранний" gr="A,comp,norm,plen" sem="t:time r:qual" sem2="t:time r:qual"/>раньше</w> <w><ana lex="срок" gr="S,gen,inan,m,norm,sg" sem="t:time:period r:abstr t:param" sem2="t:time:moment r:abstr"/>срока</w>.</se><se> <w><ana lex="перрон" gr="S,acc,inan,m,norm,sg" sem="t:space pt:part t:constr pc:constr top:dam r:concr" sem2=""/>Перрон</w> <w>наконец-то</w>.</se><se> <w><ana lex="дорогостайский" gr="A,bastard,m,nom,plen,sg" sem="" sem2=""/><ana lex="дорогостайский" gr="A,bastard,m,nom,plen,sg" sem="" sem2=""/><ana lex="дорогостайский" gr="A,bastard,m,nom,plen,sg" sem="" sem2=""/>Дорогостайский</w>, <w><ana lex="собенников" gr="S,anim,bastard,famn,m,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Собенников</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="сеня" gr="S,anim,m,nom,norm,persn,sg" sem="" sem2=""/>Сеня</w>.</se><se> <w><ana lex="все" gr="SPRO,nom,norm,pl" sem="" sem2=""/>Все</w> <w><ana lex="улыбаться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus" sem2="ca:noncaus"/>улыбаются</w>.</se><se> <w><ana lex="объятие" gr="S,acc,inan,n,norm,pl" sem="r:abstr" sem2=""/>Объятия</w>, <w><ana lex="разговор" gr="S,acc,inan,m,norm,pl" sem="t:speech r:abstr" sem2="t:speech der:shift r:abstr"/>разговоры</w>.</se><se> <w><ana lex="поездка" gr="S,f,inan,nom,norm,sg" sem="t:move r:abstr" sem2=""/>Поездка</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="комплекс" gr="S,acc,inan,m,norm,sg" sem="pt:set r:abstr" sem2="sc:org sc:x hi:class pt:set sc:constr:build r:concr"/>комплекс</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="семен" gr="S,anim,dat,m,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Семену</w> <w><ana lex="николаевич" gr="S,anim,dat,m,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Николаевичу</w> <w><ana lex="родионов" gr="S,anim,dat,famn,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Родионову</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="там" gr="ADVPRO,norm" sem="t:place r:dem" sem2=""/>там</w> <w><ana lex="основаться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="der:v ca:noncaus d:pref t:be:appear" sem2="der:v ca:noncaus d:pref"/>основались</w>.</se><se> <w><ana lex="саша" gr="S,anim,nom,norm,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Саша-бурятка</w>.</se><se> <w><ana lex="прежний" gr="A,nom,norm,pl,plen" sem="r:rel t:time" sem2="r:rel t:time"/>Прежние</w> <w><ana lex="воспоминание" gr="S,inan,n,nom,norm,pl" sem="t:ment r:abstr" sem2="der:v r:concr t:text"/>воспоминания</w>.</se><se> <w><ana lex="уютность" gr="S,f,inan,nom,norm,sg" sem="r:abstr der:a" sem2=""/>Уютность</w>, <w><ana lex="обед" gr="S,inan,m,nom,norm,sg" sem="r:abstr" sem2="t:food sc:food r:abstr pt:aggr t:time r:concr"/>обед</w>, <w><ana lex="хорошо" gr="ADV,PRAEDIC,norm" sem="ev:posit dt:quality der:a" sem2=""/><ana lex="хорошо" gr="ADV,PARENTH,norm" sem="ev:posit dt:quality der:a" sem2=""/>хорошо</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="тихо" gr="ADV,norm" sem="dt:sound der:a" sem2="ev dt:sound der:a"/>тихо</w>!</se><se> <w><ana lex="никто" gr="SPRO,anim,m,nom,norm,sg" sem="r:neg" sem2=""/>Никто</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="беспокоить" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="ca:caus d:pref t:psych:emot" sem2=""/>беспокоит</w>, <w><ana lex="тишина" gr="S,anim,f,famn,nom,norm,sg" sem="" sem2=""/><ana lex="тишина" gr="S,f,inan,nom,norm,sg" sem="t:neg t:sound r:abstr t:fam" sem2="r:abstr"/>тишина</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="чистота" gr="S,f,inan,nom,norm,sg" sem="r:abstr der:a" sem2="r:abstr"/>чистота</w>.</se><se> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>До</w> <w><ana lex="поздний" gr="A,f,gen,norm,plen,sg" sem="t:time r:qual" sem2="t:time r:qual"/>поздней</w> <w><ana lex="ночь" gr="S,f,gen,inan,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2=""/>ночи</w> <w><ana lex="разговор" gr="S,inan,m,nom,norm,pl" sem="t:speech r:abstr" sem2="t:speech der:shift r:abstr"/>разговоры</w>.</se></p>
<p><se><b/><w><b>9</b></w><b>/</b><w><ana lex="viii" gr="bastard" sem="" sem2=""/><b>VIII</b></w><b>, </b><w><ana lex="v" gr="bastard" sem="" sem2=""/><b>V</b></w><b/>. <w><ana lex="сергей" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Сергей</w> <w><ana lex="анатольевич" gr="S,anim,m,nom,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Анатольевич</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="убугунов" gr="S,anim,bastard,famn,m,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Убугунов</w>.</se><se> <w><ana lex="баня" gr="S,f,inan,nom,norm,pl" sem="top:contain t:constr:build r:concr t:org" sem2="r:abstr"/>Бани</w> -- <w><ana lex="чудный" gr="A,nom,norm,pl,plen" sem="dt:abstr ev:posit r:rel" sem2="dt:abstr ev:posit t:quality der:s r:qual"/><ana lex="чудной" gr="A,nom,norm,pl,plen" sem="dt:abstr t:humq ev:neg r:qual" sem2=""/>чудные</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="чистый" gr="A,f,ins,norm,plen,sg" sem="t:physst r:qual" sem2="t:physq ev:posit t:humq t:degr r:qual"/>чистой</w> <w><ana lex="вода" gr="S,f,inan,ins,norm,sg" sem="t:stuff r:concr t:liq" sem2="t:food dt:stuff t:stuff sc:reservoir t:liq sc:space r:abstr pt:aggr:aggrpl sc:qtm t:space pt:part ev:neg sc:spring pc:space r:concr der:shift"/>водой</w>.</se><se> <w><ana lex="прекрасно" gr="ADV,norm" sem="ev:posit dt:degr:max der:a" sem2=""/>Прекрасно</w>, <w><ana lex="легко" gr="ADV,norm" sem="dt:physq:weight ev der:a" sem2=""/>легко</w>, <w><ana lex="свободно" gr="ADV,norm" sem="ev:posit dt:quality der:a" sem2=""/>свободно</w>!</se></p>
<p><se><w><ana lex="дома" gr="ADV,norm" sem="t:place der:s" sem2=""/>Дома</w> <w><ana lex="продолжение" gr="S,acc,inan,n,norm,sg" sem="der:v r:abstr der:s0" sem2="der:v r:concr pc:x pt:part r:abstr"/>продолжение</w> <w><ana lex="отдых" gr="S,gen,inan,m,norm,sg" sem="r:abstr" sem2=""/>отдыха</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="встреча" gr="S,f,inan,nom,norm,sg" sem="der:v r:abstr der:s0" sem2="t:action r:abstr"/>встреча</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="знакомый" gr="S,anim,ins,m,norm,pl" sem="der:v t:hum r:concr der:subst" sem2=""/>знакомыми</w>.</se><se> <w>Чудно</w>.</se><se> <w><ana lex="мечта" gr="S,f,inan,nom,norm,pl" sem="t:ment r:abstr" sem2="t:ment ev:posit r:abstr"/>Мечты</w> <w><ana lex="будить" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="ca:caus d:root" sem2="ca:caus d:root"/>будят</w> <w><ana lex="прежний" gr="A,acc,n,norm,plen,sg" sem="r:rel t:time" sem2="r:rel t:time"/>прежнее</w>.</se></p>
<p><se><b/><w><b>10</b></w><b>/</b><w><ana lex="viii" gr="bastard" sem="" sem2=""/><b>VIII</b></w><b>.</b></se><se> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>С</w> <w><ana lex="утро" gr="S,gen,inan,n,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утра</w> <w><ana lex="перевезти" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus t:move d:pref"/>перевезли</w> <w><ana lex="имущество" gr="S,acc,inan,n,norm,sg" sem="sc:thing der:v pt:aggr r:concr" sem2=""/>имущество</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="музей" gr="S,gen,inan,m,norm,sg" sem="r:concr t:org" sem2=""/>Музея</w>.</se><se> <w><ana lex="разобраться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus d:pref" sem2="t:ment ca:noncaus d:pref"/>Разобрались</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="потом" gr="ADVPRO,norm" sem="t:time" sem2=""/>потом</w> <w><ana lex="чудный" gr="A,n,nom,norm,plen,sg" sem="dt:abstr ev:posit r:rel" sem2="dt:abstr ev:posit t:quality der:s r:qual"/><ana lex="чудной" gr="A,n,nom,norm,plen,sg" sem="dt:abstr t:humq ev:neg r:qual" sem2=""/>чудное</w> <w><ana lex="катание" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr" sem2=""/>катание</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> «<w><ana lex="чайка" gr="S,anim,dat,f,norm,sg" sem="t:animal r:concr" sem2="t:hum r:propn t:famn"/>Чайке</w>» -- <w><ana lex="моторный" gr="A,loc,m,norm,plen,sg" sem="r:rel der:s dt:tool:device dt:tool" sem2="r:rel der:s dt:tool:device dt:tool"/>моторном</w> <w><ana lex="катер" gr="S,inan,loc,m,norm,sg" sem="t:tool:transp r:concr" sem2="t:tool:transp r:concr"/>катере</w> <w><ana lex="байкал" gr="S,gen,inan,m,norm,sg" sem="r:propn t:topon" sem2="t:food t:stuff r:propn"/>Байкала</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="распоряжение" gr="S,inan,loc,n,norm,sg" sem="t:speech der:v r:abstr der:s0" sem2="t:speech r:abstr"/>распоряжении</w> <w>В</w>. <w>Ч</w>. <w><ana lex="дорогостайский" gr="A,bastard,gen,m,plen,sg" sem="" sem2=""/><ana lex="дорогостайский" gr="A,bastard,gen,m,plen,sg" sem="" sem2=""/><ana lex="дорогостайский" gr="A,bastard,gen,m,plen,sg" sem="" sem2=""/>Дорогостайского</w>.</se><se> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>С</w> <w><ana lex="мы" gr="SPRO,1p,ins,norm,pl" sem="r:pers" sem2=""/>нами</w> <w><ana lex="сам" gr="S,anim,m,nom,norm,sg" sem="" sem2="t:hum r:concr"/>сам-восемь</w> <w><ana lex="плюс" gr="CONJ,norm" sem="" sem2=""/>плюс</w> <w><ana lex="илляшевич" gr="S,anim,bastard,m,nom,patrn,sg" sem="t:hum r:propn t:famn" sem2=""/>Илляшевич</w> (<w>С</w>. <w>П</w>. <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="ее" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,n,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,f,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,m,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,n,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,f,gen,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,n,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,f,gen,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,m,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,n,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,f,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,m,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,n,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,f,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,m,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,dat,n,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,f,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,m,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,anim,m,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,inan,m,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,n,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,f,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,m,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,n,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,acc,anim,norm,pl" sem="r:poss" sem2=""/>ее</w> <w><ana lex="милый" gr="A,nom,norm,pl,plen" sem="t:humq r:qual" sem2="ev:posit t:social:emot r:qual"/>милые</w> <w><ana lex="дочка" gr="S,anim,f,nom,norm,pl" sem="" sem2="t:hum ev:posit r:concr der:s"/>дочки</w>).</se><se> <w><ana lex="дивный" gr="A,m,nom,norm,plen,sg" sem="der:s:deverb dt:abstr ev:posit dt:psych" sem2="t:degr dt:psych dt:abstr ev:posit r:qual der:s:deverb"/>Дивный</w> <w><ana lex="огненный" gr="A,m,nom,norm,plen,sg" sem="dt:stuff r:rel der:s" sem2="t:humq t:physq:color dt:stuff der:shift t:appearance der:s r:qual ev r:rel"/>огненный</w> <w><ana lex="блеск" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:light" sem2="ev:posit t:stuff r:abstr der:v t:manif r:concr"/>блеск</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="поверхность" gr="S,f,inan,loc,norm,sg" sem="top:surface t:space r:concr" sem2="r:abstr top:surface der:shift pt:part ev:neg pc:reservoir pc:space r:concr"/>поверхности</w> <w><ana lex="ангара" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Ангары</w>.</se><se> <w><ana lex="вечер" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечер</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="милый" gr="A,f,ins,norm,plen,sg" sem="t:humq r:qual" sem2="ev:posit t:social:emot r:qual"/>милой</w> <w><ana lex="софи" gr="S,0,anim,f,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Софи</w>.</se><se> <w><ana lex="наш" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>Наш</w> <w><ana lex="композитор" gr="S,anim,m,nom,norm,sg" sem="der:s t:hum r:concr d:nag t:prof" sem2=""/>композитор</w> <w><ana lex="прекрасно" gr="ADV,norm" sem="ev:posit dt:degr:max der:a" sem2=""/>прекрасно</w> <w><ana lex="играть" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="d:root" sem2="d:root"/>играл</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="петь" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="d:root" sem2="d:root"/>пел</w>, <w><ana lex="произвести" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:caus d:pref t:be:appear" sem2="d:pref"/>произвел</w> <w><ana lex="очарование" gr="S,acc,inan,n,norm,sg" sem="ev:posit r:abstr" sem2=""/>очарование</w>!</se><se> <w><ana lex="поздний" gr="A,f,ins,norm,plen,sg" sem="t:time r:qual" sem2="t:time r:qual"/>Поздней</w> <w><ana lex="ночь" gr="S,f,inan,ins,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2=""/>ночью</w> <w><ana lex="дом" gr="S,gen,inan,m,norm,sg" sem="top:contain t:constr:build r:concr" sem2="sc:hum pt:set t:space t:org t:group der:shift r:concr"/>дома</w>, <w><ana lex="спать" gr="V,1p,act,indic,intr,ipf,norm,pl,praes" sem="d:root" sem2="d:root"/>спим</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="8" gr="NUM,ciph"/>8</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w> <w><ana lex="следующий" gr="A,gen,m,norm,plen,sg" sem="der:v r:rel dt:move t:ord" sem2="der:v r:rel dt:move t:ord"/>следующего</w>, <w><ana lex="канунный" gr="A,gen,m,norm,plen,sg" sem="r:rel der:s" sem2=""/>канунного</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дня</w>.</se></p>
<p><se><b/><w><b>11</b></w><b>/</b><w><ana lex="viii" gr="bastard" sem="" sem2=""/><b>VIII</b></w><b>.</b></se><se> <w>Много</w> <w><ana lex="посетитель" gr="S,anim,gen,m,norm,pl" sem="der:v t:hum r:concr d:nag" sem2=""/>посетителей</w>: <w><ana lex="представитель" gr="S,anim,m,nom,norm,pl" sem="der:v t:hum r:concr d:nag" sem2="der:v t:hum r:concr d:nag"/>представители</w> <w><ana lex="рго" gr="S,0,anim,bastard,m,sg" sem="" sem2=""/><ana lex="рго" gr="S,0,anim,bastard,m,persn,sg" sem="" sem2=""/>РГО</w>, <w><ana lex="проситель" gr="S,anim,m,nom,norm,pl" sem="der:v t:hum r:concr d:nag" sem2=""/>просители</w>, <w><ana lex="мой" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>мои</w> <w><ana lex="спутник" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,inan,m,nom,norm,pl" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутники</w> -- <w><ana lex="мадаев" gr="S,anim,bastard,famn,m,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Мадаев</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="другой" gr="APRO,nom,norm,pl" sem="r:spec" sem2="r:ord r:spec r:indet"/>другие</w>.</se><se> <w><ana lex="письмо" gr="S,gen,inan,n,norm,sg" sem="r:concr t:text" sem2="pt:aggr t:asp r:concr r:abstr sc:letter"/>Письма</w> <w><ana lex="михно" gr="S,0,anim,bastard,famn" sem="t:hum r:propn t:famn" sem2=""/><ana lex="михно" gr="S,0,anim,bastard,persn" sem="t:hum r:propn t:famn" sem2=""/>Михно</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="телеграмма" gr="S,f,inan,nom,norm,sg" sem="der:comp r:concr t:text" sem2=""/>телеграмма</w> <w><ana lex="цоктошить" gr="V,2p,act,bastard,imper,pf,sg" sem="" sem2=""/>Цоктоши</w> <w><ana lex="бадмажапова" gr="S,acc,anim,bastard,f,famn,sg" sem="t:hum r:propn t:famn" sem2=""/>Бадмажапову</w>, <w><ana lex="газетный" gr="A,nom,norm,pl,plen" sem="dt:text r:rel der:s" sem2=""/>газетные</w> <w><ana lex="заметка" gr="S,f,inan,nom,norm,pl" sem="der:v t:sign r:concr" sem2="der:v