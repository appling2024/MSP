<p><se><w><ana lex="написать" gr="V,act,indic,m,norm,pf,praet,sg,tran" sem="der:v d:pref" sem2=""/>Написал</w> <w><ana lex="письмо" gr="S,acc,inan,n,norm,sg" sem="r:concr t:text" sem2="pt:aggr t:asp r:concr r:abstr sc:letter"/>письмо</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="харбин" gr="S,acc,inan,m,norm,sg" sem="r:propn t:topon" sem2=""/>Харбин</w>, <w>О</w>. <w>Н</w>. <w><ana lex="кузнецова" gr="S,anim,f,famn,gen,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Кузнецовой</w>.</se><se> <w><ana lex="все" gr="SPRO,acc,inan,n,norm,sg" sem="" sem2=""/>Все</w> <w><ana lex="честь" gr="S,f,inan,nom,norm,sg" sem="r:abstr" sem2="ev:posit r:abstr"/>честь</w> <w><ana lex="честь" gr="S,f,inan,ins,norm,sg" sem="r:abstr" sem2="ev:posit r:abstr"/>честью</w>.</se><se> <w><ana lex="сломать" gr="V,n,nom,norm,partcp,pass,pf,plen,praet,sg,tran" sem="t:impact ca:caus d:pref" sem2=""/>Сломанное</w> <w><ana lex="ложе" gr="S,inan,n,nom,norm,sg" sem="top:gutter t:space t:tool:furn top:horiz pt:part r:concr pc:tool:weapon" sem2="top:gutter t:space pt:part pc:reservoir pc:space r:concr"/>ложе</w> <w><ana lex="ружье" gr="S,gen,inan,n,norm,sg" sem="t:tool:weapon r:concr" sem2=""/>ружья</w> <w><ana lex="отдать" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:noncaus d:pref t:poss" sem2="ca:noncaus d:pref t:poss"/>отдал</w> <w><ana lex="столяр" gr="S,anim,dat,m,norm,sg" sem="t:hum r:concr t:prof" sem2="t:hum r:propn t:famn"/>столяру-китайцу</w> <w><ana lex="посадить" gr="V,act,inf,norm,pf,tran" sem="d:pref" sem2=""/>посадить</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="металлический" gr="A,acc,inan,m,norm,plen,sg" sem="dt:stuff r:rel der:s" sem2=""/>металлический</w> <w><ana lex="стержень" gr="S,acc,inan,m,norm,sg" sem="r:concr pc:x pt:part top:rod" sem2="r:concr pc:x pt:part"/>стержень</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="срочно" gr="ADV,norm" sem="dt:time der:a t:time" sem2=""/>срочно</w> <w><ana lex="заклеить" gr="V,