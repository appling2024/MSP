<p><se><b/><w><b>30</b></w><b>/</b><w><ana lex="xii" gr="bastard" sem="" sem2=""/><b>XII</b></w><b>, </b><w><ana lex="q" gr="bastard" sem="" sem2=""/><b>Q</b></w><b/>. -<w><ana lex="21.1" gr="NUM,ciph"/>21.1</w>°<w><ana lex="r" gr="bastard" sem="" sem2=""/>R</w>, <w>ясно</w>, <w><ana lex="почти" gr="ADV,norm" sem="" sem2=""/>почти</w> <w><ana lex="тихо" gr="ADV,norm" sem="dt:sound der:a" sem2="ev dt:sound der:a"/>тихо</w>.</se><se> <w><ana lex="зима" gr="S,f,inan,nom,norm,sg" sem="t:time:season r:abstr t:time" sem2="t:fam"/>Зима</w> <w><ana lex="давать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="der:v ca:caus d:impf t:poss d:root" sem2="der:v d:root d:impf"/>дает</w> <w><ana lex="себе" gr="SPRO,acc,norm" sem="" sem2=""/>себя</w> <w><ana lex="чувствовать" gr="V,act,inf,ipf,norm,tran" sem="ca:noncaus t:perc der:s" sem2="der:s"/>чувствовать</w>.</se><se> <w><ana lex="все" gr="SPRO,nom,norm,pl" sem="" sem2=""/>Все</w> <w><ana lex="спасть" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus t:move d:pref" sem2="d:pref"/><ana lex="спать" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="d:root" sem2="d:root"/>спали</w> <w><ana lex="долго" gr="ADV,norm" sem="t:time:dur:max dt:time:dur:max der:a" sem2=""/>долго</w>.</se><se> <w>Теперь</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="вставать" gr="V,1p,act,indic,intr,ipf,norm,pl,praes" sem="der:v d:pref d:impf t:move:body" sem2=""/>встаем</w> <w><ana lex="поздно" gr="ADV,comp,norm" sem="dt:time der:a t:time" sem2="dt:time ev:neg der:a t:time"/>позже</w> <w><ana lex="9" gr="NUM,ciph"/>9</w>-<w><ana lex="ти" gr="S,0,f,inan,norm,sg" sem="" sem2=""/>ти</w> <w><ana lex="ежедневно" gr="ADV,norm" sem="t:freq dt:time der:a" sem2=""/>ежедневно</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="около" gr="PR,norm" sem="" sem2=""/>около</w> Ѕ<w>10</w>-<w>го</w>-<w><ana lex="10" gr="NUM,ciph"/>10</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr