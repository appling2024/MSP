<p><se> <b/><w><b>4</b></w><b>/</b><w><ana lex="ii" gr="bastard" sem="" sem2=""/><b>II</b></w><b>,</b> <b/><w><ana lex="r" gr="bastard" sem="" sem2=""/><b>R</b></w><b/>. <w>Ветрено</w>, <w><ana lex="облачно" gr="ADV,norm" sem="" sem2=""/>облачно</w>, <w><ana lex="серо" gr="ADV,norm" sem="dt:physq:color der:a ev:neg" sem2="dt:physq:color der:a ev:neg"/>серо</w>, <w><ana lex="дать" gr="V,act,indic,norm,pf,pl,praet" sem="ca:caus d:root t:poss" sem2="d:root"/>дали</w> <w><ana lex="закрытый" gr="A,brev,norm,pl" sem="" sem2=""/>закрыты</w>.</se><se> <w><ana lex="опять" gr="ADV,norm" sem="" sem2=""/>Опять</w> <w><ana lex="пойти" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/>пошла</w> <w><ana lex="однообразный" gr="A,f,nom,norm,plen,sg" sem="der:comp r:rel t:like" sem2=""/>однообразная</w> <w><ana lex="работа" gr="S,f,inan,nom,norm,sg" sem="der:v r:abstr" sem2="sc:x t:text t:workdram t:workmus r:abstr t:workart der:v pt:aggr t:workcin r:concr"/>работа</w>: <w><ana lex="разговор" gr="S,inan,m,nom,norm,pl" sem="t:speech r:abstr" sem2="t:speech der:shift r:abstr"/>разговоры</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="препаратор" gr="S,anim,ins,m,norm,sg" sem="t:hum r:concr der:s" sem2=""/>препаратором</w>, <w><ana lex="измерение" gr="S,inan,n,nom,norm,pl" sem="der:v r:abstr der:s0" sem2="r:abstr"/>измерения</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="запись" gr="S,f,inan,nom,norm,pl" sem="t:put der:v r:abstr der:s0" sem2="t:doc r:concr t:text"/>записи</w> <w><ana lex="добыть" gr="V,gen,norm,partcp,pass,pf,pl,plen,praet" sem="der:v ca:caus d:pref t:poss" sem2="der:v d:pref"/>добытых</w> <w><ana lex="птичка" gr="S,f,gen,inan,norm,pl" sem="" sem2="t:sign r:concr"/><ana lex="птичка" gr="S,anim,f,gen,norm,pl" sem="t:hum ev r:concr der:s d:dim" sem2=""/>птичек</w>, <w><ana lex="писание" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr der:s0 t:impact:creat" sem2="der:v ev r: