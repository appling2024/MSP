w><ana lex="высота" gr="S,f,inan,ins,norm,pl" sem="r:abstr t:param t:size" sem2="t:space t:param der:a r:abstr t:size t:manif pc:form:geom pt:part top:hill r:concr"/>высотами</w> (<w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="окружность" gr="S,f,inan,loc,norm,sg" sem="r:concr t:form:geom top:ring" sem2="t:space r:concr der:s"/>окружности</w> <w><ana lex="около" gr="PR,norm" sem="" sem2=""/>около</w> <w><ana lex="12" gr="NUM,ciph"/>12</w> <w><ana lex="верста" gr="S,f,gen,inan,norm,pl" sem="t:unit r:abstr" sem2=""/>верст</w>), <w><ana lex="дачный" gr="A,n,nom,norm,plen,sg" sem="dt:space r:rel der:s" sem2=""/>дачное</w> <w><ana lex="место" gr="S,inan,n,nom,norm,sg" sem="qc:space t:space r:concr" sem2="qc:space sc:org t:tool t:space pt:element r:abstr pt:aggr:aggrpl pt:part pc:text r:concr"/>место</w>, <w><ana lex="прекрасный" gr="A,m,nom,norm,plen,sg" sem="ev:posit t:appearance r:qual" sem2="ev:posit t:quality r:qual"/>прекрасный</w> <w><ana lex="уголок" gr="S,inan,m,nom,norm,sg" sem="dt:form t:form top:corner top:form der:s d:dim r:concr" sem2="pt:aggr sc:tool t:tool t:space top:contain dt:space top:corner t:room pt:ind t:sign dt:part top:form pc:x pt:part d:dim r:concr pc:room der:s"/>уголок</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="ароматный" gr="A,ins,m,norm,plen,sg" sem="der:s dt:stuff ev:posit t:physq:smell r:qual" sem2=""/>ароматным</w> <w><ana lex="чистый" gr="A,ins,m,norm,plen,sg" sem="t:physst r:qual" sem2="t:physq ev:posit t:humq t:degr r:qual"/>чистым</w> <w><ana lex="воздух" gr="S,inan,ins,m,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>воздухом</w>.</se></p>
<p><se><w><ana lex="день" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>Днем</w> <w><ana lex="еще" gr="ADV,norm" sem="" sem2=""/>еще</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="отправить" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:caus t:move d:pref" sem2="d:pref"/>отправил</w> <w><ana lex="заказной" gr="A,acc,inan,norm,pl,plen" sem="der:v r:rel" sem2="dt:thing r:rel der:s"/>заказные</w> <w><ana lex="письмо" gr="S,acc,inan,n,norm,pl" sem="r:concr t:text" sem2="pt:aggr t:asp r:concr r:abstr sc:letter"/>письма</w> (<w><ana lex="3" gr="NUM,ciph"/>3</w>) <w>Е</w>. <w>И</w>. <w><ana lex="константинова" gr="S,anim,f,famn,gen,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Константиновой</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="небольшой" gr="A,ins,n,norm,plen,sg" sem="d:neg r:rel t:size:min dt:size:max der:a" sem2="t:degr:min d:neg der:a dt:size:max r:qual"/>небольшим</w> <w><ana lex="приложение" gr="S,inan,ins,n,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="der:v r:concr t:text"/>приложением</w>.</se></p>
<p><se><w><ana lex="возвращаться" gr="V,act,ger,intr,ipf,norm,praes" sem="der:v d:pref" sem2=""/>Возвращаясь</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="город" gr="S,gen,inan,m,norm,sg" sem="sc:constr:build t:space r:concr" sem2="t:space r:concr"/>города</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w>, <w><ana lex="точный" gr="A,comp,norm,plen" sem="r:qual" sem2="r:qual"/>точнее</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="пригородный" gr="A,gen,n,norm,plen,sg" sem="t:place dt:space r:rel der:s" sem2="t:place dt:space r:rel der:s"/>пригородного</w> <w><ana lex="озеро" gr="S,gen,inan,n,norm,sg" sem="top:contain t:reservoir t:space r:concr" sem2=""/>озера</w>, <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="пшевочка" gr="S,anim,bastard,ins,m,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Пшевочкой</w> <w><ana lex="ехать" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="ca:noncaus t:move d:root" sem2="d:root"/>ехали</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="извозчик" gr="S,anim,loc,m,norm,sg" sem="t:hum r:concr der:s t:prof" sem2="t:hum r:concr der:s t:prof"/>извозчике</w>, <w><ana lex="который" gr="APRO,m,nom,norm,sg" sem="r:rel t:ord" sem2=""/>который</w> <w><ana lex="указать" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v" sem2="der:v"/>указал</w> <w><ana lex="мы" gr="SPRO,1p,dat,norm,pl" sem="r:pers" sem2=""/>нам</w> <w><ana lex="домик" gr="S,inan,m,nom,norm,sg" sem="top:contain t:constr:build r:concr der:s d:dim" sem2=""/>домик</w> <w><ana lex="белый" gr="A,m,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:race dt:physq:color der:shift r:qual t:species r:rel"/>белый</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="который" gr="APRO,loc,m,norm,sg" sem="r:rel t:ord" sem2=""/>котором</w> <w><ana lex="проживать" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="t:be:ex