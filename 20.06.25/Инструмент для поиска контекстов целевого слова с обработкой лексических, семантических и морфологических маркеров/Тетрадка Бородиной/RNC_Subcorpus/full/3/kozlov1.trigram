<p><se><w><ana lex="вчера" gr="ADV,norm" sem="t:time" sem2=""/>Вчера</w> <w><ana lex="я" gr="SPRO,1p,acc,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="усиленно" gr="ADV,norm" sem="ev der:aprt dt:degr" sem2=""/>усиленно</w> <w><ana lex="приглашать" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="der:v d:pref" sem2=""/>приглашали</w> <w><ana lex="тибетец" gr="S,anim,m,nom,norm,pl" sem="" sem2=""/>тибетцы</w> <w><ana lex="откушать" gr="V,act,inf,norm,pf,tran" sem="ca:noncaus t:physiol d:pref" sem2="ca:noncaus ca:caus t:physiol d:pref"/>откушать</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="они" gr="SPRO,3p,ins,norm,pl" sem="r:pers" sem2=""/>ними</w> <w><ana lex="чашка" gr="S,acc,f,inan,norm,sg" sem="top:contain r:concr t:tool:dish der:s" sem2="t:form r:concr pc:tool:device pt:part"/>чашку</w> <w><ana lex="чай" gr="S,gen,inan,m,norm,sg" sem="t:plant:bush r:concr" sem2="t:food t:stuff r:abstr sc:plant t:liq pt:aggr t:plant:bush r:concr"/>чая</w>.</se><se> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>Не</w> <w><ana lex="знать" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/>знаю</w>, <w><ana lex="как" gr="CONJ,norm" sem="" sem2=""/>как</w> <w><ana lex="быть" gr="V,act,inf,intr,ipf,norm" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>быть</w>, <w><ana lex="приглашение" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr der:s0 t:inter" sem2="der:v r:concr t:text"/>приглашение</w> <w><ana lex="последовать" gr="V,act,indic,intr,n,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2=""/>последовало</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>сегодня</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="3" gr="NUM,ciph"/>3</w> <w><ana lex="час" gr="S,gen,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часа</w> <w><ana lex="день" gr="S,ge