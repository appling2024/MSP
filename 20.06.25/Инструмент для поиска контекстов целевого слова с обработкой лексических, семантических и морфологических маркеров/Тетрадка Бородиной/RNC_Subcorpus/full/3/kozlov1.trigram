rm,pf,pl" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>будете</w> <w><ana lex="сидеть" gr="V,act,inf,intr,ipf,norm" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:noncaus"/>сидеть</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="да" gr="CONJ,norm" sem="" sem2=""/>Да-Куре</w>; <w><ana lex="если" gr="CONJ,norm" sem="" sem2=""/>если</w> <w><ana lex="выступить" gr="V,2p,act,fut,indic,intr,norm,pf,pl" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="выступить" gr="V,2p,act,imper,intr,norm,pf,pl" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/>выступите</w> <w><ana lex="весна" gr="S,f,inan,ins,norm,sg" sem="t:time:season r:abstr t:time" sem2=""/>весной</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="вполне" gr="ADV,norm" sem="dt:full t:degr:max der:a" sem2=""/>вполне</w> <w>возможно</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="монголия" gr="S,acc,f,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Монголию</w>, <w><ana lex="то" gr="CONJ,norm" sem="" sem2=""/>то</w> <w><ana lex="экспедиция" gr="S,f,inan,nom,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиция</w> <w><ana lex="быть" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>будет</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="высота" gr="S,f,inan,loc,norm,sg" sem="r:abstr t:param t:size" sem2="t:space t:param der:a r:abstr t:size t:manif pc:form:geom pt:part top:hill r:concr"/>высоте</w> <w><ana lex="свой" gr="APRO,gen,n,norm,sg" sem="r:poss" sem2="t:social r:poss"/>своего</w> <w><ana lex="положение" gr="S,gen,inan,n,norm,sg" sem="t:space r:abstr" sem2="t:ment pt:set t:text r:abstr t:loc:body t:loc r:concr sc:text"/>положения</w>; <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w>надо</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="ночь" gr="S,dat,f,inan,norm,pl" sem="pc:day r:abstr pt:part t:time" sem2=""/>ночам</w> <w>много</w> <w><ana lex="думать" gr="V,act,inf,intr,ipf,norm" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/><ana lex="думать" gr="V,act,inf,ipf,norm,tran" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/>думать</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w>надо</w> <w><ana lex="спать" gr="V,act,inf,intr,ipf,norm" sem="d:root" sem2="d:root"/>спать</w>.</se><se> <w><ana lex="ехать" gr="V,act,inf,intr,ipf,norm" sem="ca:noncaus t:move d:root" sem2="d:root"/>Ехать</w> <w><ana lex="домой" gr="ADV,norm" sem="der:s t:dir" sem2=""/>домой</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="следовать" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="ca:noncaus t:move der:s" sem2="ca:noncaus t:move der:s"/>следует</w>!</se></p>
<p><se><w><ana lex="убугунов" gr="S,anim,bastard,famn,m,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Убугунов</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>был</w> <w><ana lex="особенно" gr="ADV,norm" sem="t:degr:max der:a" sem2="der:aprt der:a"/>особенно</w> <w><ana lex="внимательный" gr="A,brev,m,norm,sg" sem="t:humq r:qual" sem2="t:humq r:qual"/>внимателен</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="откровенный" gr="A,brev,m,norm,sg" sem="t:humq ev r:qual" sem2="ev:neg t:appearance ev t:degr:max r:qual"/>откровенен</w>.</se><se> <w><ana lex="дословно" gr="ADV,norm" sem="der:a" sem2=""/>Дословно</w> <w><ana lex="передать" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v d:pref t:poss" sem2="der:v d:pref"/><ana lex="передать" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v d:pref t:poss" sem2="der:v d:pref"/><ana lex="передавать" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v d:pref d:impf t:poss" sem2=""/>передал</w> <w><ana lex="содержание" gr="S,acc,inan,n,norm,sg" sem="der:v r:abstr der:s0" sem2="pt:set t:text r:abstr t:poss der:v pt:aggr sc:money pt:part pc:text r:concr"/>содержание</w> <w><ana lex="бумага" gr="S,f,gen,inan,norm,sg" sem="t:stuff r:concr" sem2="t:stuff r:concr t:text"/>бумаги</w>, <w><ana lex="изложить" gr="V,f,gen,norm,partcp,pass,pf,plen,praet,sg" sem="t:speech ca:noncaus der:v d:pref" sem2=""/>изложенной</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="поручение" gr="S,dat,inan,n,norm,sg" sem="der:v r:abstr der:s0" sem2="r:abstr"/>поручению</w> <w>А</w>. <w>Н</w>. <w><ana lex="васильев" gr="S,anim,famn,gen,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Васильева</w>.</se><se> <w><ana lex="это" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>Это</w>, <w>собственно</w>, <w><ana lex="характеристика" gr="S,f,inan,nom,norm,sg" sem="r:abstr" sem2="der:v r:concr t:text"/>характеристика</w> (<w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="политический" gr="A,loc,n,norm,plen,sg" sem="r:rel der:s" sem2="r:rel der:s t:humq:char r:qual"/>политическом</w> <w><ana lex="отношение" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr der:s0 t:inter" sem2="der:v t:text r:concr r:abstr t:inter"/>отношении</w>) <w><ana lex="состав" gr="S,gen,inan,m,norm,sg" sem="sc:hum pt:aggr r:concr" sem2="der:v t:tool:transp t:stuff r:concr sc:tool:transp"/>состава</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w>.</se><se> <w><ana lex="васильев" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Васильев</w> <w><ana lex="сказать" gr="V,act,indic,m,norm,pf,praet,sg,tran" sem="t:speech ca:noncaus" sem2=""/>сказал</w>: «<w><ana lex="такой" gr="APRO,f,nom,norm,sg" sem="r:dem" sem2="r:indet r:spec t:degr:max"/>Такая</w> <w><ana lex="оценка" gr="S,f,inan,nom,norm,sg" sem="t:ment der:v r:abstr der:s0" sem2="t:ment t:schoolmark der:v r:concr r:abstr"/>оценка</w> <w><ana lex="лицо" gr="S,gen,inan,n,norm,pl" sem="pt:partb r:concr pc:hum" sem2="pc:tool:cloth t:space r:concr r:abstr"/><ana lex="лицо" gr="S,anim,gen,n,norm,pl" sem="" sem2="t:hum r:concr hi:class"/>лиц</w> <w><ana lex="послужить" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="d:pref" sem2="d:pref"/>послужит</w> <w><ana lex="экспедиция" gr="S,acc,f,inan,norm,pl" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w> <w><ana lex="больший" gr="A,ins,m,norm,plen,sg" sem="d:compar t:size:max der:a dt:size:max r:qual" sem2=""/><ana lex="большой" gr="A,ins,m,norm,plen,sg" sem="t:size:max r:qual" sem2="t:quant:max t:time:age t:degr:max r:qual"/>большим</w> <w><ana lex="плюс" gr="S,inan,ins,m,norm,sg" sem="t:sign r:concr" sem2="ev:posit r:abstr t:temper"/>плюсом</w>».</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="центр" gr="S,inan,loc,m,norm,sg" sem="t:space r:concr pc:form:geom pt:part" sem2="pc:org t:space pc:hum pc:animal t:org pt:set pt:partb:organ pc:x pt:part sc:cell2 r:concr"/>Центре</w> <w><ana lex="вопрос" gr="S,inan,m,nom,norm,sg" sem="t:speech r:abstr" sem2="t:ment r:abstr"/>вопрос</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>был</w> <w><ana lex="поставить" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="der:v d:pref" sem2=""/>поставлен</w> <w><ana lex="такой" gr="APRO,ins,m,norm,sg" sem="r:dem" sem2="r:indet r:spec t:degr:max"/>таким</w> <w><ana lex="образ" gr="S,inan,ins,m,norm,sg" sem="t:ment r:concr r:abstr t:workart" sem2="t:asp r:abstr"/>образом</w>: «<w><ana lex="быть" gr="V,act,inf,intr,ipf,norm" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>Быть</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="быть" gr="V,act,inf,intr,ipf,norm" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>быть</w>!</se><se> <w><ana lex="вернуть" gr="V,act,inf,norm,pf,tran" sem="ca:noncaus d:root t:poss" sem2="d:root"/>Вернуть</w> <w><ana lex="экспедиция" gr="S,acc,f,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедицию</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="вернуть" gr="V,act,inf,norm,pf,tran" sem="ca:noncaus d:root t:poss" sem2="d:root"/>вернуть</w>!</se><se>». <w><ana lex="убугунов" gr="S,anim,bastard,famn,m,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Убугунов</w> <w><ana lex="доказывать" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="der:v d:pref d:impf" sem2=""/>доказывал</w> <w><ana lex="необходимость" gr="S,acc,f,inan,norm,sg" sem="r:abstr der:a" sem2=""/>необходимость</w> <w><ana lex="поездка" gr="S,f,gen,inan,norm,sg" sem="t:move r:abstr" sem2=""/>поездки</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="москва" gr="S,acc,f,inan,norm,sg" sem="r:propn t:topon" sem2="r:propn t:topon"/>Москву</w> <w><ana lex="представитель" gr="S,anim,gen,m,norm,pl" sem="der:v t:hum r:concr d:nag" sem2="der:v t:hum r:concr d:nag"/>представителей</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w>.</se><se> <w><ana lex="васильев" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Васильев</w> <w><ana lex="стоять" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:noncaus"/>стоял</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="обратный" gr="A,acc,n,norm,plen,sg" sem="der:v r:rel t:dir" sem2="t:place r:rel"/>обратное</w>.</se><se> <w><ana lex="убугунов" gr="S,anim,bastard,famn,m,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Убугунов</w>, <w><ana lex="изложить" gr="V,act,ger,norm,pf,praet" sem="t:speech ca:noncaus der:v d:pref" sem2=""/>изложив</w> <w><ana lex="все" gr="SPRO,acc,inan,n,norm,sg" sem="" sem2=""/>все</w> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w>, <w><ana lex="убеждать" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="d:pref" sem2=""/>убеждал</w> <w><ana lex="я" gr="SPRO,1p,acc,norm,sg" sem="r:pers" sem2=""/>меня</w> (<w><ana lex="искренно" gr="ADV,norm" sem="ev:posit der:a" sem2=""/>искренно</w>) <w><ana lex="быть" gr="V,act,inf,intr,ipf,norm" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>быть</w> <w><ana lex="твердый" gr="A,ins,m,norm,plen,sg" sem="t:physq r:qual" sem2="t:physq t:sound t:humq r:rel r:qual"/>твердым</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="васильев" gr="S,anim,dat,famn,m,norm,pl" sem="t:hum r:propn t:famn" sem2=""/>Васильевым</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="отношение" gr="S,dat,inan,n,nor