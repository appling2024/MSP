<p><se><w><ana lex="будущее" gr="S,inan,n,nom,norm,sg" sem="der:v der:subst r:abstr t:time" sem2="der:v der:subst r:abstr t:time"/>Будущее</w> <w><ana lex="урга" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Урги</w> <w><ana lex="как" gr="CONJ,norm" sem="" sem2=""/>как</w> <w><ana lex="торговый" gr="A,gen,m,norm,plen,sg" sem="dt:poss dt:abstr r:rel der:s" sem2="der:v dt:poss r:rel"/>торгового</w> <w><ana lex="центр" gr="S,gen,inan,m,norm,sg" sem="t:space r:concr pc:form:geom pt:part" sem2="pc:org t:space pc:hum pc:animal t:org pt:set pt:partb:organ pc:x pt:part sc:cell2 r:concr"/>центра</w> <w><ana lex="громадный" gr="A,n,nom,norm,plen,sg" sem="t:degr:max r:qual" sem2=""/>громадное</w>.</se><se> <w>Интересно</w>, <w><ana lex="кто" gr="SPRO,anim,m,nom,norm,sg" sem="r:rel" sem2=""/>кто</w> <w><ana lex="быть" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>будет</w> <w><ana lex="во" gr="PR,norm" sem="" sem2=""/>во</w> <w><ana lex="глава" gr="S,f,inan,loc,norm,sg" sem="t:text pc:hum pt:part pc:text pt:partb r:concr" sem2="pc:constr r:concr pt:part"/>главе</w>?</se><se> <w><ana lex="случайно" gr="ADV,PARENTH,norm" sem="der:a" sem2=""/>Случайно</w> <w><ana lex="иметь" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="ca:noncaus d:root t:poss" sem2="d:root"/>имел</w> <w><ana lex="свидание" gr="S,acc,inan,n,norm,sg" sem="r:abstr" sem2="r:abstr"/>свидание</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="меркулов" gr="S,anim,famn,ins,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Меркуловым</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="другой" gr="APRO,ins,norm,pl" sem="r:spec" sem2="r:ord r:spec r:indet"/>другими</w> <w><ana lex="два" gr="NUM,ins,norm" sem="r:card:pauc" sem2=""/>двумя</w> <w><ana lex="обитатель" gr="S,anim,ins,m,norm,pl" sem="der:v t:hum r:concr d:nag dt:be:exist" sem2=""/>обитателями</w> <w><ana lex="урга" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Урги</w>, <w><ana lex="интересный" gr="A,ins,norm,pl,plen" sem="dt:abstr der:s dt:ment r:qual" sem2="dt:abstr ev:posit der:s dt:ment r:qual"/>интересными</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="точка" gr="S,f,gen,inan,norm,sg" sem="der:v t:space der:s0 r:abstr t:impact r:concr" sem2="t:space t:sign r:concr r:abstr"/>точки</w> <w><ana lex="зрение" gr="S,gen,inan,n,norm,sg" sem="t:perc r:abstr" sem2=""/>зрения</w> <w><ana lex="охота" gr="S,f,gen,inan,norm,sg" sem="t:action t:psych:volit r:abstr" sem2="der:v d:nag r:abstr sc:hum pt:aggr r:concr"/>охоты</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="охотничий" gr="A,gen,norm,pl,plen" sem="r:poss der:s dt:hum" sem2=""/>охотничьих</w> <w><ana lex="наблюдение" gr="S,gen,inan,n,norm,pl" sem="der:v t:perc r:abstr" sem2=""/>наблюдений</w> <w>Ж</w> <w><ana lex="урга" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Урги</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="улясутай" gr="S,gen,inan,m,norm,sg" sem="" sem2=""/>Улясутая</w>.</se><se> <w><ana lex="здесь" gr="ADVPRO,norm" sem="t:place r:dem" sem2="t:time r:dem"/>Здесь</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="монголия" gr="S,f,inan,loc,norm,sg" sem="r:propn t:topon" sem2=""/>Монголии</w>, <w><ana lex="северный" gr="A,f,nom,norm,plen,sg" sem="t:place dt:space r:rel der:s" sem2=""/>северная</w> <w><ana lex="граница" gr="S,f,inan,nom,norm,sg" sem="t:space r:concr der:s" sem2="r:abstr"/>граница</w> <w><ana lex="географический" gr="A,gen,n,norm,plen,sg" sem="r:rel der:s" sem2=""/>географического</w> <w><ana lex="распространение" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr" sem2=""/>распространения</w> <w><ana lex="vultur" gr="bastard" sem="" sem2=""/>Vultur</w> <w><ana lex="monachus" gr="bastard" sem="" sem2=""/>monachus</w>.</se><se> <w><ana lex="наконец" gr="ADV,PARENTH,norm" sem="der:s t:time" sem2=""/>Наконец</w> <w><ana lex="понять" gr="V,act,f,indic,no