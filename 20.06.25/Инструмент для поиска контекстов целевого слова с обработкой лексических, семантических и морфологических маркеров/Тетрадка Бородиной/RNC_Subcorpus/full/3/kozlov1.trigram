g" sem="r:propn t:topon" sem2=""/>Тибете</w>, <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="растительный" gr="A,loc,n,norm,plen,sg" sem="dt:plant r:rel der:s" sem2="t:humq ev:neg r:qual"/>растительном</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="животный" gr="A,loc,n,norm,plen,sg" sem="r:rel" sem2="r:rel"/>животном</w> <w><ana lex="богатство" gr="S,inan,loc,n,norm,sg" sem="r:abstr der:a" sem2="sc:money sc:thing pt:aggr r:concr der:a"/>богатстве</w> <w><ana lex="этот" gr="APRO,gen,norm,pl" sem="r:dem" sem2=""/>этих</w> <w><ana lex="место" gr="S,gen,inan,n,norm,pl" sem="qc:space t:space r:concr" sem2="qc:space sc:org t:tool t:space pt:element r:abstr pt:aggr:aggrpl pt:part pc:text r:concr"/>мест</w>.</se><se> <w><ana lex="мысль" gr="S,f,inan,nom,norm,sg" sem="t:ment r:abstr" sem2="t:ment ev:posit r:abstr"/>Мысль</w> <w><ana lex="переносить" gr="V,act,f,indic,norm,pf,praet,sg" sem="ca:caus t:move d:pref" sem2="d:pref"/><ana lex="переносить" gr="V,act,f,indic,ipf,norm,praet,sg,tran" sem="ca:caus t:move d:pref" sem2="d:pref"/><ana lex="перенести" gr="V,act,f,indic,norm,pf,praet,sg,tran" sem="der:v ca:caus t:move d:pref" sem2="der:v d:pref"/><ana lex="переносить" gr="V,act,f,indic,ipf,norm,praet,sg,tran" sem="ca:caus t:move d:pref" sem2="d:pref"/><ana lex="переносить" gr="V,act,f,indic,norm,pf,praet,sg,tran" sem="ca:caus t:move d:pref" sem2="d:pref"/>переносила</w> <w><ana lex="мы" gr="SPRO,1p,acc,norm,pl" sem="r:pers" sem2=""/>нас</w> <w><ana lex="словно" gr="CONJ,norm" sem="" sem2=""/>словно</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="действительность" gr="S,acc,f,inan,norm,sg" sem="r:abstr der:a" sem2="r:abstr"/>действительность</w>.</se><se> <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>А</w> <w><ana lex="вечер" gr="S,inan,m,nom,norm,pl" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>вечера</w> <w><ana lex="больший" gr="A,nom,norm,pl,plen" sem="d:compar t:size:max der:a dt:size:max r:qua