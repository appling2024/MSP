al"/>глубокой</w> <w><ana lex="воронка" gr="S,f,inan,ins,norm,sg" sem="t:tool r:concr t:form" sem2="top:pit top:contain t:space r:concr"/>воронкой</w> <w><ana lex="посредине" gr="ADV,norm" sem="t:place der:s" sem2=""/>посредине</w> (<w><ana lex="курган" gr="S,gen,inan,m,norm,sg" sem="top:hill r:propn t:space r:concr t:topon" sem2=""/><ana lex="курган" gr="S,gen,inan,m,norm,sg" sem="top:hill r:propn t:space r:concr t:topon" sem2=""/>кургана</w>).</se><se> <w><ana lex="самый" gr="APRO,n,nom,norm,sg" sem="r:spec" sem2="r:spec"/>Самое</w> <w><ana lex="погребение" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr" sem2=""/>погребение</w> <w><ana lex="покоиться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:loc d:pref ca:noncaus" sem2="ca:noncaus d:pref"/><ana lex="покоиться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:loc d:pref ca:noncaus" sem2="ca:noncaus d:pref"/>покоится</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="глубина" gr="S,f,inan,loc,norm,sg" sem="r:abstr t:param t:size" sem2="t:degr t:space der:a r:abstr der:shift pt:part pc:space r:concr"/>глубине</w> <w><ana lex="5-7" gr="NUM,ciph"/>5-7</w> <w><ana lex="сажень" gr="S,f,gen,inan,norm,pl" sem="t:unit r:abstr" sem2="t:unit t:tool r:concr r:abstr top:rod"/>саженей</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="дно" gr="S,inan,loc,n,norm,sg" sem="pc:reservoir pc:space r:concr pt:part" sem2="pc:tool:cloth der:shift sc:hum pt:aggr pc:x pt:part r:concr"/>дне</w> <w><ana lex="курган" gr="S,gen,inan,m,norm,sg" sem="top:hill r:propn t:space r:concr t:topon" sem2=""/><ana lex="курган" gr="S,gen,inan,m,norm,sg" sem="top:hill r:propn t:space r:concr t:topon" sem2=""/>кургана</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="состоять" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="d:pref" sem2="d:pref"/>состоит</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="капитальный" gr="A,f,ins,norm,plen,sg" sem="t:degr t:hier ev:posit r:qual" sem2=""/>капитальной</w> <w><ana lex="деревянный" gr="A,f,ins,norm,plen,sg" sem="dt:stuff r:rel der:s" sem2="dt:stuff r:rel der:s ev:neg"/>деревянной</w>, <w><ana lex="обтесать" gr="V,f,ins,norm,partcp,pass,pf,plen,praet,sg" sem="der:v d:pref" sem2="der:v d:pref"/>обтесанной</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="бок" gr="S,dat,inan,m,norm,pl" sem="pt:partb pc:animal t:space r:concr pc:hum" sem2="t:space r:concr pc:x pt:part"/>бокам</w> <w><ana lex="постройка" gr="S,f,gen,inan,norm,sg" sem="der:v r:abstr der:s0 t:impact:creat" sem2="der:v top:contain t:constr:hut r:concr"/>постройки</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="двойной" gr="A,ins,m,norm,plen,sg" sem="t:quant:abs r:rel" sem2="t:appearance r:rel"/>двойным</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="тройной" gr="A,ins,m,norm,plen,sg" sem="t:quant:abs r:rel" sem2="t:appearance r:rel"/>тройным</w> <w><ana lex="бревенчатый" gr="A,ins,m,norm,plen,sg" sem="dt:thing r:rel der:s" sem2=""/>бревенчатым</w> <w><ana lex="потолок" gr="S,inan,ins,m,norm,sg" sem="top:horiz pc:constr:build r:concr pc:room pt:part" sem2="r:abstr"/>потолком</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="цель" gr="S,f,inan,ins,norm,sg" sem="t:space r:concr" sem2="t:ment r:abstr"/>целью</w> <w><ana lex="противостоять" gr="V,act,inf,intr,ipf,norm" sem="d:pref" sem2="d:pref"/>противостоять</w> <w><ana lex="тяжелый" gr="A,dat,n,norm,plen,sg" sem="t:physq:weight r:qual" sem2="t:humq der:metaph r:qual dt:physq:weight t:physq der:shift t:degr:max ev:neg r:rel"/>тяжелому</w> <w><ana lex="давление" gr="S,dat,inan,n,norm,sg" sem="t:impact der:v r:abstr der:s0" sem2="r:abstr t:param"/>давлению</w> <w><ana lex="земляной" gr="A,gen,m,norm,plen,sg" sem="dt:space r:rel der:s" sem2=""/>земляного</w> <w><ana lex="покров" gr="S,gen,inan,m,norm,sg" sem="t:stuff t:topon qc:stuff d