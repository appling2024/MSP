<p><se><w><ana lex="пока" gr="CONJ,norm" sem="" sem2=""/>Пока</w> <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="купить" gr="V,act,indic,norm,pf,pl,praet" sem="ca:noncaus d:root t:poss" sem2="der:shift d:root"/>купили</w> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="нужда" gr="S,f,gen,inan,norm,pl" sem="r:abstr" sem2="r:abstr"/>нужд</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w> <w><ana lex="600" gr="NUM,ciph"/>600</w> <w><ana lex="лист" gr="S,gen,inan,m,norm,pl" sem="pc:plant r:concr pt:part" sem2="t:doc qc:stuff pt:qtm r:abstr t:unit r:concr"/>листов</w> <w><ana lex="китайский" gr="A,f,gen,norm,plen,sg" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>китайской</w> <w><ana lex="оберточный" gr="A,f,gen,norm,plen,sg" sem="r:rel der:s" sem2=""/>оберточной</w> <w><ana lex="бумага" gr="S,f,gen,inan,norm,sg" sem="t:stuff r:concr" sem2="t:stuff r:concr t:text"/>бумаги</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="заказать" gr="V,act,indic,norm,pf,pl,praet" sem="der:v d:pref" sem2=""/>заказали</w> <w><ana lex="пуд" gr="S,acc,inan,m,norm,sg" sem="t:unit r:abstr" sem2=""/>пуд</w> <w><ana lex="вата" gr="S,f,gen,inan,norm,sg" sem="t:stuff r:concr" sem2=""/>ваты</w> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="чучело" gr="S,acc,anim,n,norm,pl" sem="" sem2="t:hum r:concr ev:neg"/>чучел</w> <w><ana lex="птица" gr="S,anim,f,gen,norm,pl" sem="t:animal r:concr hi:class" sem2=""/>птиц</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="укладка" gr="S,f,gen,inan,norm,sg" sem="der:v r:abstr der:s0" sem2="der:v top:contain t:tool r:concr r:abstr"/>укладки</w>.</se></p>
<p><se><b/><w><b>13</b></w><b>/</b><w><ana lex="x" gr="bastard" sem="" sem2=""/><b>X</b></w><b>, </b><w><ana lex="w" gr="bastard" sem="" sem2=""/><b>W</b></w><b/>. <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w> <w><ana lex="серый" gr="A,n,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>серое</w>, <w><ana lex="туманный" gr="A,n,nom,norm,plen,sg" sem="dt:weather dt:abstr r:rel der:s" sem2="dt:weather dt:abstr der:shift der:s ev r:rel"/>туманное</w>, <w><ana lex="далее" gr="ADV,norm" sem="" sem2=""/>далее</w> <w><ana lex="десять" gr="NUM,gen,norm" sem="r:card" sem2=""/>десяти</w> <w><ana lex="сажень" gr="S,f,gen,inan,norm,pl" sem="t:unit r:abstr" sem2="t:unit t:tool r:concr r:abstr top:rod"/>саженей</w> <w><ana lex="ничто" gr="SPRO,gen,n,norm,sg" sem="r:neg" sem2=""/>ничего</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w>видно</w>.</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="воздух" gr="S,inan,loc,m,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>воздухе</w> <w>сыро</w>, <w>прохладно</w>, <w><ana lex="t" gr="bastard" sem="" sem2=""/>t</w> -<w><ana lex="4" gr="NUM,ciph"/>4</w>°<w>С</w>. <w><ana lex="постепенно" gr="ADV,norm" sem="der:a" sem2=""/>Постепенно</w> <w><ana lex="холод" gr="S,inan,m,nom,norm,sg" sem="t:temper r:abstr t:weather" sem2="t:manif:emot r:abstr t:temper t:physiol t:manif:disease t:fam"/>холод</w> <w><ana lex="надвигаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v d:pref" sem2=""/>надвигается</w> <w>больше</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w>больше</w>.</se><se> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>К</w> <w><ana lex="полдень" gr="S,dat,inan,m,norm,sg" sem="r:abstr t:time" sem2="t:space r:concr"/>полудню</w> <w><ana lex="небо" gr="S,inan,n,nom,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr"