:group pc:hum pt:set r:concr sc:hum" sem2="t:tool:cloth r:concr"/>свите</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="вид" gr="S,anim,famn,loc,m,norm,sg" sem="" sem2=""/><ana lex="вид" gr="S,inan,loc,m,norm,sg" sem="der:v r:abstr" sem2="t:ment t:space r:abstr t:workart der:v t:perc r:concr t:fam"/>виде</w> <w><ana lex="приветствие" gr="S,gen,inan,n,norm,sg" sem="t:speech r:abstr" sem2=""/>приветствия</w>, <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="часть" gr="S,f,inan,ins,norm,pl" sem="r:concr pc:x pt:part" sem2="pc:org r:abstr sc:part t:org pt:ind pt:aggr:aggrpl t:poss der:shift pc:x pt:part pc:text r:concr"/>частями</w> <w><ana lex="подарить" gr="V,brev,f,norm,partcp,pass,pf,praet,sg,tran" sem="der:v ca:caus d:pref t:poss" sem2=""/>подарена</w> <w><ana lex="тибетский" gr="A,dat,norm,pl,plen" sem="dt:topon r:rel der:s t:topon" sem2=""/>тибетским</w> <w><ana lex="чиновник" gr="S,anim,dat,m,norm,pl" sem="t:hum r:concr der:s" sem2="t:hum r:concr ev:neg"/>чиновникам</w> (<w><ana lex="тибетский" gr="A,n,nom,norm,plen,sg" sem="dt:topon r:rel der:s t:topon" sem2=""/>Тибетское</w> <w><ana lex="представительство" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr der:s0" sem2="der:v r:concr t:org r:abstr"/>представительство</w>), <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="кто" gr="SPRO,anim,dat,m,norm,sg" sem="r:rel" sem2=""/>кому-либо</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="духовный" gr="A,gen,norm,pl,plen" sem="dt:hum:supernat r:rel der:s" sem2="dt:hum:supernat r:rel der:s"/>духовных</w> <w><ana lex="особа" gr="S,anim,f,gen,norm,pl" sem="t:hum ev r:concr der:a" sem2=""/>особ</w> <w><ana lex="монголия" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Монголии</w>.</se><se> <w><ana lex="ведь" gr="PART,norm" sem="" sem2=""/>Ведь</w> <w><ana lex="полный" gr="A,m,nom,norm,plen,sg" sem="t:content r:qual" sem2="t:degr t:appearance r:qual"/>полный</w> <w><ana lex="штат" gr="S,inan,m,nom,norm,sg" sem="pc:org pt:set t:space pt:aggr:aggrpl t:group sc:hum pt:part pc:space r:concr" sem2="pt:set sc:hum r:concr t:text"/>штат</w> <w><ana lex="больший" gr="A,gen,norm,pl,plen" sem="d:compar t:size:max der:a dt:size:max r:qual" sem2=""/><ana lex="большой" gr="A,gen,norm,pl,plen" sem="t:size:max r:qual" sem2="t:quant:max t:time:age t:degr:max r:qual"/>больших</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="влиятельный" gr="A,gen,norm,pl,plen" sem="der:v t:humq d:habit r:qual" sem2=""/>влиятельных</w> <w><ana lex="лама" gr="S,anim,gen,norm,pl" sem="t:hum t:animal r:concr" sem2=""/>лам</w> <w><ana lex="иметься" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:poss" sem2=""/>имеется</w> <w><ana lex="при" gr="PR,norm" sem="" sem2=""/>при</w> <w><ana lex="особа" gr="S,anim,f,loc,norm,sg" sem="t:hum ev r:concr der:a" sem2=""/>особе</w> <w><ana lex="богдо" gr="ADV,bastard" sem="" sem2=""/>Богдо-гэгэна</w>!</se></p>
<p><se><w><ana lex="препаратор" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr der:s" sem2=""/>Препаратор</w> <w><ana lex="канаев" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Канаев</w> <w><ana lex="сделать" gr="V,act,indic,m,norm,pf,praet,sg,tran" sem="d:pref" sem2=""/>сделал</w> <w><ana lex="чучело" gr="S,inan,n,nom,norm,sg" sem="r:concr" sem2="t:tool r:concr"/><ana lex="чучело" gr="S,anim,n,nom,norm,sg" sem="" sem2="t:hum r:concr ev:neg"/>чучело</w> <w><ana lex="graculus" gr="bastard" sem="" sem2=""/>Graculus</w> <w><ana lex="graculus" gr="bastard" sem="" sem2=""/>graculus</w>, <w>по-моему</w>, <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="удачно" gr="ADV,norm" sem="" sem2="ev:posit der:a"/>удачно</w>!</se><se> <w><ana lex="поза" gr="S,f,inan,nom,norm,sg" sem="t:loc:body r:abstr" sem2="ev:neg r:abstr t:behav"/>Поза</w> -- <w><ana lex="птица" gr="S,anim,f,nom,norm,sg" sem="t:animal r:concr hi:class" sem2=""/>птица</w> <w><ana lex="сидеть" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:noncaus"/>сидит</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="ветка" gr="S,f,inan,loc,norm,sg" sem="pc:plant r:concr der:s pt:part" sem2="top:stripe t:space r:concr pt:part pc:space"/>ветке</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="готовый" gr="A,brev,f,norm,sg" sem="" sem2=""/>готова</w> <w><ana lex="слететь" gr="V,act,inf,norm,pf" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="слетать" gr="V,act,inf,intr,norm,pf" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="слететь" gr="V,act,inf,intr,norm,pf" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/>слететь</w> <w><ana lex="вниз" gr="ADV,norm" sem="der:s t:dir" sem2="der:s"/>вниз</w>.</se><se> <w><ana lex="все" gr="SPRO,dat,norm,pl" sem="" sem2=""/>Всем</w> <w><ana lex="нравиться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus" sem2=""/>нравится</w>.</se></p>
<p><se><w><ana lex="вечер" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечером</w> <w><ana lex="беседовать" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="t:speech ca:noncaus der:s" sem2=""/>беседовал</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="кондратьев" gr="S,anim,famn,ins,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Кондратьевым</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="результат" gr="S,inan,loc,m,norm,sg" sem="r:abstr" sem2="r:abstr"/>результате</w> <w><ana lex="его" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,n,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,f,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,m,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,n,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,f,gen,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,n,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,f,gen,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,m,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,gen,n,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,f,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,m,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,n,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,f,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,m,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,dat,n,norm,pl" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,f,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,m,norm,sg" sem="r:poss" sem2=""/><ana lex="его" gr="APRO,acc,anim,m,norm,sg" se