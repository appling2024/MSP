"" sem2=""/>в</w> <w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w>.</se><se> <w>Надо</w> <w><ana lex="надеяться" gr="V,act,inf,intr,ipf,norm" sem="t:ment ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>надеяться</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="встретить" gr="V,1p,act,fut,indic,norm,pf,sg" sem="d:pref" sem2="d:pref"/>встречу</w> <w><ana lex="все" gr="SPRO,acc,norm,pl" sem="" sem2=""/>всех</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="полный" gr="A,loc,n,norm,plen,sg" sem="t:content r:qual" sem2="t:degr t:appearance r:qual"/>полном</w> <w><ana lex="здравие" gr="S,inan,loc,n,norm,sg" sem="t:physiol r:abstr" sem2=""/>здравии</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="благополучие" gr="S,inan,loc,n,norm,sg" sem="ev:posit r:abstr" sem2="ev:posit r:abstr"/>благополучии</w>, <w><ana lex="полный" gr="A,loc,norm,pl,plen" sem="t:content r:qual" sem2="t:degr t:appearance r:qual"/>полных</w> <w><ana lex="лучший" gr="A,ins,norm,pl,supr" sem="d:super ev:posit der:a t:quality r:qual" sem2=""/>лучшими</w> <w><ana lex="впечатление" gr="S,inan,ins,n,norm,pl" sem="t:perc r:abstr" sem2="t:ment r:abstr"/>впечатлениями</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="путь" gr="S,inan,loc,m,norm,sg" sem="top:stripe t:space r:concr" sem2="ev:posit t:space t:asp r:abstr sc:space pt:aggr:aggrpl pt:aggr top:stripe r:concr der:shift"/>пути</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="урга" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Урги</w>, <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="осенний" gr="A,f,gen,norm,plen,sg" sem="dt:time dt:abstr dt:time:season der:s t:time r:rel" sem2=""/>осенней</w> <w><ana lex="пора" gr="S,f,gen,inan,norm,sg" sem="t:space r:abstr t:time pc:par