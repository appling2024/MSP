<p><se><b/><w><b>8</b></w><b>/</b><w><ana lex="xi" gr="bastard" sem="" sem2=""/><b>XI</b></w><b>, </b><w><ana lex="v" gr="bastard" sem="" sem2=""/><b>V</b></w><b/>. <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w> <w><ana lex="ясный" gr="A,n,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясное</w>, <w><ana lex="тихий" gr="A,n,nom,norm,plen,sg" sem="d:neg t:sound r:qual" sem2="d:neg t:humq t:speed:min der:shift t:sound r:qual"/>тихое</w>, <w><ana lex="морозный" gr="A,n,nom,norm,plen,sg" sem="dt:temper dt:abstr t:physq:temper r:rel der:s" sem2=""/>морозное</w>.</se><se> <w><ana lex="окно" gr="S,inan,n,nom,norm,pl" sem="t:tool t:space pc:constr:build pt:part top:vertical r:concr top:hole" sem2="t:space r:abstr pc:constr pt:part t:time r:concr"/>Окна</w> <w><ana lex="одеваться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus d:pref" sem2=""/>одеваются</w> <w><ana lex="ледяной" gr="A,ins,norm,pl,plen" sem="dt:stuff r:rel der:s" sem2="t:degr:max:magn t:physq:temper r:qual dt:stuff der:shift der:s ev:neg r:rel"/>ледяными</w> <w><ana lex="узор" gr="S,inan,ins,m,norm,pl" sem="t:pattern r:concr" sem2=""/>узорами</w>, <w><ana lex="над" gr="PR,norm" sem="" sem2=""/>над</w> <w><ana lex="урга" gr="S,f,inan,ins,norm,sg" sem="r:propn t:topon" sem2=""/>Ургой</w> <w><ana lex="сплошной" gr="A,0,norm,plen" sem="r:rel der:adv" sem2="der:adv r:rel t:degr:max r:qual"/>сплошной</w> <w><ana lex="дым" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr" sem2=""/>дым</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="отопление" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0" sem2="der:v sc:tool:device pt:aggr r:concr"/>отопления</w> <w><ana lex="весь" gr="APRO,gen,norm,pl" sem="r:spec" sem2=""/>всех</w> <w><ana lex="жилищный" gr="A,gen,norm,pl,plen" sem="r:rel der:s dt:constr" sem2=""/>жилищных</w> <w><ana lex="уголок" gr="S,gen,inan,m,norm,pl" sem="dt:form t:form top:corner top:form der:s d:dim r:c