RENTH,norm" sem="der:s t:time" sem2=""/>наконец</w> <w><ana lex="настоящий" gr="A,f,nom,norm,plen,sg" sem="r:rel t:time" sem2="ev:posit r:dem t:ver t:degr t:degr:max r:qual r:rel"/>настоящая</w> <w><ana lex="типичный" gr="A,f,nom,norm,plen,sg" sem="r:rel der:s dt:hum" sem2="r:rel der:s dt:hum"/>типичная</w> <w><ana lex="осень" gr="S,f,inan,nom,norm,sg" sem="t:time:season r:abstr t:time" sem2=""/>осень</w> (<w><ana lex="осень" gr="S,f,inan,nom,norm,sg" sem="t:time:season r:abstr t:time" sem2=""/>осень</w> <w><ana lex="центральный" gr="A,f,gen,norm,plen,sg" sem="t:place dt:space r:rel der:s" sem2="dt:space t:hier r:rel der:s"/>Центральной</w> <w><ana lex="азия" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Азии</w>).</se></p>
<p><se><w><ana lex="мы" gr="SPRO,1p,dat,norm,pl" sem="r:pers" sem2=""/>Нам</w> <w>необходимо</w> <w><ana lex="получить" gr="V,act,inf,norm,pf" sem="ca:noncaus t:poss" sem2=""/>получить</w> <w><ana lex="здесь" gr="ADVPRO,norm" sem="t:place r:dem" sem2="t:time r:dem"/>здесь</w> <w>Ж</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="время" gr="S,inan,n,nom,norm,sg" sem="r:abstr t:param t:time" sem2="t:time:period r:abstr t:time"/>время</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="наш" gr="APRO,dat,m,norm,sg" sem="r:poss" sem2=""/>нашему</w> «<w><ana lex="гильдебрандт" gr="S,anim,dat,famn,m,norm,sg" sem="" sem2=""/>Гильдебрандту</w>».</se><se> <w>Кстати</w>, <w><ana lex="монгол" gr="S,anim,m,nom,norm,pl" sem="" sem2=""/>монголы</w> <w><ana lex="также" gr="PART,norm" sem="" sem2=""/>также</w> <w><ana lex="получить" gr="V,act,indic,norm,pf,pl,praet" sem="ca:noncaus t:poss" sem2=""/>получили</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="москва" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2="r:propn t:topon"/>Москвы</w> <w><ana lex="порядочный" gr="A,acc,f,norm,plen,sg" sem="ev:posit t:humq r:qual" sem2="t:degr:max r:qual"/>порядочную</w> <w><ana lex="4" gr="NUM,ciph"/>4</w>Ѕ-<w><ana lex="дюймовый" gr="A,acc,f,norm,plen,sg" sem="dt:abstr r:rel der:s dt:unit" sem2=""/>дюймовую</w> <w><ana lex="труба" gr="S,acc,f,inan,norm,sg" sem="t:tool top:tube r:concr top:form" sem2="pc:partb:organ r:abstr t:tool:mus top:form pt:part ev:neg top:tube r:concr"/>трубу</w> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="наблюдение" gr="S,gen,inan,n,norm,sg" sem="der:v t:perc r:abstr" sem2=""/>наблюдения</w> <w><ana lex="небесный" gr="A,gen,norm,pl,plen" sem="dt:space r:rel der:s" sem2="dt:space ev:posit r:rel der:s"/>небесных</w> <w><ana lex="светило" gr="S,anim,gen,n,norm,pl" sem="" sem2="t:hum ev:posit r:concr"/><ana lex="светило" gr="S,gen,inan,n,norm,pl" sem="der:v t:astr t:space r:concr" sem2=""/>светил</w>.</se><se> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>К</w> <w><ana lex="сожаление" gr="S,dat,inan,n,norm,sg" sem="t:psych:emot r:abstr" sem2="t:psych:emot r:abstr"/>сожалению</w>, <w><ana lex="при" gr="PR,norm" sem="" sem2=""/>при</w> <w><ana lex="пересылка" gr="S,f,inan,loc,norm,sg" sem="t:space der:s0 r:abstr der:v t:move r:concr" sem2=""/>пересылке</w> <w><ana lex="труба" gr="S,f,inan,nom,norm,sg" sem="t:tool top:tube r:concr top:form" sem2="pc:partb:organ r:abstr t:tool:mus top:form pt:part ev:neg top:tube r:concr"/>труба</w> <w><ana lex="немало" gr="ADV,norm" sem="t:quant:max ev der:a" sem2=""/>немало</w> <w><ana lex="пострадать" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v d:pref" sem2=""/>пострадала</w>.</se><se> <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>А</w> <w><ana lex="здесь" gr="ADVPRO,norm" sem="t:place r:dem" sem2="t:time r:dem"/>здесь</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="урга" gr="S,f,inan,loc,norm,sg" sem="r:propn t:topon" sem2=""/>Урге</w>, <w>можно</w> <w><ana lex="отлично" gr="ADV,norm" sem="ev:posit dt:degr:max der:a" sem2=""/>отлично</w> <w><ana lex="наблюдать" gr="V,act,inf,ipf,norm,tran" sem="ca:noncaus d:pref t:perc" sem2="d:pref"/>наблюдать</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="солнце" gr="S,inan,n,nom,norm,sg" sem="top:horiz top:spher t:astr t:space r:concr" sem2="ev:posit t:space r:concr r:abstr t:light"/>солнце</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="планета" gr="S,f,inan,nom,norm,pl" sem="top:horiz top:spher t:astr t:space r:concr" sem2=""/>планеты</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="звезда" gr="S,f,inan,nom,norm,pl" sem="t:astr t:space r:concr" sem2="t:form t:sign r:concr"/><ana lex="звезда" gr="S,anim,f,nom,norm,pl" sem="" sem2="t:hum ev r:concr"/>звезды</w> <w><ana lex="благодаря" gr="PR,norm" sem="" sem2=""/>благодаря</w> <w><ana lex="великий" gr="A,f,gen,norm,plen,sg" sem="t:d