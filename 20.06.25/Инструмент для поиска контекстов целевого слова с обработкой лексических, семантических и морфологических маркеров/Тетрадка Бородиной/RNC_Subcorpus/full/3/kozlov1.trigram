<p><se><b/><w><b>27</b></w><b>/</b><w><ana lex="viii" gr="bastard" sem="" sem2=""/><b>VIII</b></w><b>, </b><w><ana lex="r" gr="bastard" sem="" sem2=""/><b>R</b></w><b/>. <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w> <w><ana lex="серый" gr="A,n,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>серое</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="8" gr="NUM,ciph"/>8</w>ј <w><ana lex="час" gr="S,gen,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часа</w> <w><ana lex="падать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:move d:root" sem2="d:root"/>падает</w> <w><ana lex="дождь" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2="pt:set sc:x r:concr"/>дождь</w>.</se><se> <w><ana lex="со" gr="PR,norm" sem="" sem2=""/>Со</w> <w><ana lex="вчерашний" gr="A,gen,m,norm,plen,sg" sem="der:adv r:rel t:time" sem2="der:adv r:rel t:time"/>вчерашнего</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дня</w> <w><ana lex="начаться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus d:pref t:be:appear" sem2=""/>начались</w> <w><ana lex="экскурсия" gr="S,f,inan,nom,norm,pl" sem="t:action t:move r:abstr" sem2="t:group pt:set r:concr sc:hum"/>экскурсии</w>.</se><se> <w><ana lex="сергей" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Сергей</w> <w><ana lex="анатольевич" gr="S,anim,m,nom,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Анатольевич</w> <w><ana lex="видеть" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="ca:noncaus t:perc d:root" sem2="t:ment ca:noncaus d:root"/>видел</w> <w><ana lex="волк" gr="S,acc,anim,m,norm,sg" sem="t:animal r:concr" sem2=""/>волка</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="п