<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="день" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="присутственный" gr="A,m,nom,norm,plen,sg" sem="r:rel" sem2=""/>присутственный</w>.</se><se> <w><ana lex="мой" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>Мои</w> <w><ana lex="готовить" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="" sem2=""/>готовят</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="путь" gr="S,acc,inan,m,norm,sg" sem="top:stripe t:space r:concr" sem2="ev:posit t:space t:asp r:abstr sc:space pt:aggr:aggrpl pt:aggr top:stripe r:concr der:shift"/>путь</w> <w><ana lex="леночка" gr="S,acc,anim,f,norm,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Леночку</w>, <w><ana lex="который" gr="APRO,f,nom,norm,sg" sem="r:rel t:ord" sem2=""/>которая</w> <w><ana lex="хлопотать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="d:root" sem2="d:root"/>хлопочет</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="отъезд" gr="S,inan,ins,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="t:move r:abstr"/>отъездом</w>.</se><se> <w><ana lex="кроме" gr="PR,norm" sem="" sem2=""/>Кроме</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w> <w><ana lex="она" gr="SPRO,3p,dat,f,norm,sg" sem="r:pers" sem2=""/>ей</w> <w><ana lex="еще" gr="ADV,norm" sem="" sem2=""/>еще</w> <w><ana lex="даваться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus" sem2="ca:noncaus"/><ana lex="даваться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus" sem2="ca:noncaus"/>даются</w> <w><ana lex="различный" gr="A,acc,inan,norm,pl,plen" sem="r:qual" sem2=""/>различные</w> <w><ana lex="поручение" gr="S,acc,inan,n,norm,pl" sem="der:v r:abstr der:s0"