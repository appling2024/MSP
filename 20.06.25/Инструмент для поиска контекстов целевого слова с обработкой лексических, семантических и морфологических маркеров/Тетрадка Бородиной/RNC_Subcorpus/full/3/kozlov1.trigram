<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="против" gr="PR,norm" sem="" sem2=""/>против</w> <w><ana lex="дом" gr="S,gen,inan,m,norm,sg" sem="top:contain t:constr:build r:concr" sem2="sc:hum pt:set t:space t:org t:group der:shift r:concr"/>дома</w>, <w><ana lex="занимать" gr="V,gen,ipf,m,norm,partcp,pass,plen,praes,sg,tran" sem="d:pref" sem2=""/>занимаемого</w> <w><ana lex="мы" gr="SPRO,1p,ins,norm,pl" sem="r:pers" sem2=""/>нами</w>, <w><ana lex="разлиться" gr="V,act,indic,intr,n,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2="ca:noncaus d:pref"/>разлилось</w> <w><ana lex="целый" gr="A,n,nom,norm,plen,sg" sem="t:degr r:qual" sem2="t:degr r:spec r:qual"/>целое</w> <w><ana lex="небольшой" gr="A,n,nom,norm,plen,sg" sem="d:neg r:rel t:size:min dt:size:max der:a" sem2="t:degr:min d:neg der:a dt:size:max r:qual"/>небольшое</w> <w><ana lex="озерко" gr="S,inan,n,nom,norm,sg" sem="d:dim t:space r:concr" sem2="r:propn t:topon"/>озерко</w> <w><ana lex="вода" gr="S,f,gen,inan,norm,sg" sem="t:stuff r:concr t:liq" sem2="t:food dt:stuff t:stuff sc:reservoir t:liq sc:space r:abstr pt:aggr:aggrpl sc:qtm t:space pt:part ev:neg sc:spring pc:space r:concr der:shift"/>воды</w>.</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="тот" gr="APRO,acc,n,norm,sg" sem="r:dem" sem2=""/>то</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w> <w><ana lex="время" gr="S,acc,inan,n,norm,sg" sem="r:abstr t:param t:time" sem2="t:time:period r:abstr t:time"/>время</w> <w>северо-северо-западный</w> <w><ana lex="ветер" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>ветер</w> <w><ana lex="сильно" gr="ADV,norm" sem="dt:physq t:degr:max der:a" sem2="dt:physq der:a"/>сильно</w> <w><ana lex="крутить" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="ca:caus t:move d:root" sem2="d:root"/>крутит</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="вздымать" gr="V,3p,act,indic,ipf,norm,praes,sg