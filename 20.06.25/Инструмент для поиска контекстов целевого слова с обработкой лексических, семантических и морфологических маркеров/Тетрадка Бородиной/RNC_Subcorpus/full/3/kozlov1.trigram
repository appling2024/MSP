<p><se><b/><w><b>2</b></w><b>/</b><w><ana lex="xi" gr="bastard" sem="" sem2=""/><b>XI</b></w><b>, </b>.</se><se> <w><ana lex="серый" gr="A,n,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>Серое</w>, <w><ana lex="мрачный" gr="A,n,nom,norm,plen,sg" sem="dt:light dt:neg t:physq:light dt:abstr der:s r:qual" sem2="dt:light dt:neg dt:abstr ev:neg der:s r:qual t:psych:emot"/>мрачное</w> <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утро</w>, <w><ana lex="окрестность" gr="S,f,inan,nom,norm,sg" sem="der:a t:space r:concr sc:space pc:space" sem2=""/>окрестность</w> <w><ana lex="сливаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v ca:noncaus d:pref d:impf" sem2=""/>сливается</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="один" gr="ANUM,n,nom,norm,sg" sem="r:card r:card:pauc der:num" sem2=""/><ana lex="один" gr="ANUM,acc,n,norm,sg" sem="r:card r:card:pauc der:num" sem2=""/>одно</w>, <w><ana lex="тоже" gr="PART,norm" sem="" sem2=""/>тоже</w> <w><ana lex="серый" gr="A,n,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>серое</w>, <w><ana lex="некрасивый" gr="A,n,nom,norm,plen,sg" sem="d:neg der:a dt:qual r:qual t:appearance ev:neg" sem2="d:neg ev:neg"/>некрасивое</w>.</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="воздух" gr="S,inan,loc,m,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>воздухе</w> <w><ana lex="полный" gr="A,f,nom,norm,plen,sg" sem="t:content r:qual" sem2="t:degr t:appearance r:qual"/>полная</w> <w><ana lex="тишина" gr="S,anim,f,famn,nom,norm,sg" sem="" sem2=""/><ana lex="тишина" gr="S,f,inan,nom,norm,sg" sem="t:neg t:sound r:abstr t:fam" sem2="r:abstr"/>тишина</w>, <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w>слышно</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w>видно</w> <w><ana lex="даже" gr="PART,norm" sem="" sem2=""/>даже</w> <w><ana lex="воробей" gr="S,anim,gen,m,norm,pl" sem="t:animal r:concr" sem2=""/>воробьев</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="красноклювый" gr="A,gen,norm,pl,plen" sem="der:comp r:rel" sem2=""/>красноклювых</w> <w><ana lex="клушица" gr="S,anim,f,gen,norm,pl" sem="" sem2=""/>клушиц</w>, <w><ana lex="постоянный" gr="A,gen,norm,pl,plen" sem="r:rel t:time" sem2="t:time:dur t:humq r:rel r:qual"/>постоянных</w> <w><ana lex="посетитель" gr="S,anim,gen,m,norm,pl" sem="der:v t:hum r:concr d:nag" sem2=""/>посетителей</w> <w><ana lex="наш" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/>нашего</w> <w><ana lex="двор" gr="S,gen,inan,m,norm,sg" sem="pt:set t:space r:concr pc:constr:build t:group sc:hum pt:addit" sem2="t:space r:concr pc:constr:build t:org t:constr pt:addit"/>двора</w> (<w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="я" gr="SPRO,1p,gen,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="перед" gr="PR,norm" sem="" sem2=""/>перед</w> <w><ana lex="окно" gr="S,inan,ins,n,norm,sg" sem="t:tool t:space pc:constr:build pt:part top:vertical r:concr top:hole" sem2="t:space r:abstr pc:constr pt:part t:time r:concr"/>окном</w>).</se></p>
<p><se><w><ana lex="мечтать" gr="V,1p,act,indic,intr,ipf,norm,pl,praes" sem="t:ment ca:noncaus d:root" sem2=""/>Мечтаем</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="сангина" gr="S,f,inan,loc,norm,sg" sem="" sem2=""/>Сангине</w>, <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="знакомство" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr der:s0 t:inter" sem2="t:ment sc:hum r:abstr pt:aggr:aggrpl der:s r:concr"/>знакомстве</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="район" gr="S,inan,ins,m,norm,sg" sem="t:space r:concr" sem2="t:space r:concr pt:part pc:space"/>районом</w> <w><ana lex="ископаемое" gr="S,gen,inan,n,norm,pl" sem="der:v der:subst t:stuff r:concr" sem2=""/><ana lex="ископаемое" gr="S,anim,gen,n,norm,pl" sem="" sem2="der:v der:subst t:animal r:concr"/>ископаемых</w>, <w><ana lex="иметь" gr="V,1p,act,indic,ipf,norm,pl,praes,tran" sem="ca:noncaus d:root t:poss" sem2="d:root"/>имеем</w> <w><ana lex="большой" gr="A,acc,n,norm,plen,sg" sem="t:size:max r:qual" sem2="t:quant:max t:time:age t:degr:max r:qual"/>большое</w> <w><ana lex="желание" gr="S,acc,inan,n,norm,sg" sem="t:psych:volit r:abstr" sem2="r:abstr"/>желание</w> <w><ana lex="настрелять" gr="V,act,inf,norm,pf" sem="t:impact ca:caus der:v t:be:disapp d:pref" sem2="der:v d:pref"/>настрелять</w> <w><ana lex="птичка" gr="S,acc,anim,f,norm,pl" sem="t:hum ev r:concr der:s d:dim" sem2=""/>птичек</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="заросль" gr="S,f,inan,loc,norm,pl" sem="pt:aggr:aggrpl pt:aggr t:space r:concr sc:plant" sem2=""/>зарослях</w> <w><ana lex="тола" gr="S,f,gen,inan,norm,sg" sem="" sem2=""/>Толы</w>.</se></p>
<p><se><w>Надо</w> <w><ana lex="выяснить" gr="V,act,inf,norm,pf" sem="t:ment ca:noncaus d:pref der:a" sem2=""/><ana lex="выяснеть" gr="V,act,inf,norm,pf" sem="der:v d:pref" sem2=""/><ana lex="выяснить" gr="V,act,inf,norm,pf" sem="t:ment ca:noncaus d:pref der:a" sem2=""/>выяснить</w> <w><ana lex="вопрос" gr="S,acc,inan,m,norm,sg" sem="t:speech r:abstr" sem2="t:ment r:abstr"/>вопрос</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="китайский" gr="A,loc,n,norm,plen,sg" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>китайском</w> <w><ana lex="серебро" gr="S,inan,loc,n,norm,sg" sem="t:stuff r:concr" sem2="sc:thing t:stuff sc:money:banknote sc:money pt:aggr r:concr"/>серебре</w>, <w><ana lex="оставаться" gr="V,act,intr,ipf,loc,n,norm,partcp,plen,praet,sg" sem="d:pref" sem2=""/>остававшемся</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="хранение" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr t:poss" sem2=""/>хранении</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="консульство" gr="S,inan,loc,n,norm,sg" sem="r:concr t:org der:s" sem2="r:abstr"/>консульстве</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="потом" gr="ADVPRO,norm" sem="t:time" sem2=""/>потом</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="монгольский" gr="A,loc,m,norm,plen,sg" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>Монгольском</w> <w><ana lex="банк" gr="S,inan,loc,m,norm,sg" sem="qc:money r:concr t:org" sem2="sc:x t:tool t:space r:concr r:abstr"/>банке</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="урга" gr="S,f,inan,loc,norm,sg" sem="r:propn t:topon" sem2=""/>Урге</w>.</se><se> <w><ana lex="орлов" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/><ana lex="орлов" gr="S,inan,m,nom,norm,sg" sem="" sem2=""/>Орлов</w> <w><ana lex="прислать" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:caus t:move d:pref" sem2="ca:caus t:move d:pref"/>прислал</w> <w><ana