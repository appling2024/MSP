<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="обещать" gr="V,act,indic,norm,pf,pl,praet,tran" sem="t:speech ca:noncaus d:pref der:s" sem2="d:pref der:s"/><ana lex="обещать" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="t:speech ca:noncaus d:pref der:s" sem2="d:pref der:s"/>обещали</w> <w><ana lex="доставить" gr="V,act,inf,norm,pf" sem="ca:caus t:move d:pref" sem2="d:pref"/>доставить</w> <w><ana lex="письмо" gr="S,acc,inan,n,norm,sg" sem="r:concr t:text" sem2="pt:aggr t:asp r:concr r:abstr sc:letter"/>письмо</w> <w><ana lex="мой" gr="APRO,f,gen,norm,sg" sem="r:poss" sem2=""/>моей</w> <w><ana lex="пшевочка" gr="S,anim,bastard,f,gen,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/><ana lex="пшевочка" gr="S,anim,bastard,f,gen,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/><ana lex="пшевочка" gr="S,bastard,f,gen,inan,sg" sem="" sem2=""/>Пшевочки</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="калган" gr="S,gen,inan,m,norm,sg" sem="t:plant r:concr" sem2=""/>Калгана</w>, <w><ana lex="привезти" gr="V,n,nom,norm,partcp,pass,pf,plen,praet,sg" sem="der:v ca:caus t:move d:pref" sem2=""/>привезенное</w> <w><ana lex="котов" gr="S,anim,famn,ins,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Котовым</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="сдать" gr="V,n,nom,norm,partcp,pass,pf,plen,praet,sg" sem="der:v ca:caus d:pref t:poss" sem2="der:v d:pref"/>сданное</w>, <w><ana lex="как" gr="CONJ,norm" sem="" sem2=""/>как</w> <w><ana lex="водиться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus d:root" sem2="ca:noncaus d:root"/>водится</w>, <w><ana lex="через" gr="PR,norm" sem="" sem2=""/>через</w> <w><ana lex="таможня" gr="S,acc,f,inan,norm,sg" sem="r:concr t:org" sem2=""/>таможню</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="охранный" gr="A,acc,n,norm,plen,sg" sem="r:rel der:s" sem2="r:rel der:s"/>охранное</w> <w><ana lex="отделение" gr="S,acc,inan,n,norm,sg" sem="der:v r:abstr der:s0" sem2="pc:org pt:set pc:contain t:org r:abstr der:v sc:hum pt:part pc:action r:concr"/>отделение</w> (<w><ana lex="цензура" gr="S,f,inan,nom,norm,sg" sem="r:abstr" sem2=""/>цензура</w>).</se></p>
<p><se><w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="1" gr="NUM,ciph"/>1</w> <w><ana lex="час" gr="S,acc,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>час</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дня</w> <w><ana lex="отбыть" gr="V,act,f,indic,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v d:pref"/>отбыла</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="север" gr="S,acc,inan,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr t:fam pt:part pc:space"/>север</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="урочище" gr="S,inan,loc,n,norm,sg" sem="t:space r:concr" sem2=""/>урочище</w> <w><ana lex="цзун" gr="S,anim,bastard,m,nom,sg" sem="" sem2=""/>Цзун-модо</w> <w><ana lex="ученый" gr="A,f,nom,norm,plen,sg" sem="der:v r:rel" sem2="der:v t:humq r:rel r:qual"/>ученая</w> <w><ana lex="экскурсия" gr="S,f,inan,nom,norm,sg" sem="t:action t:move r:abstr" sem2="t:group pt:set r:concr sc:hum"/>экскурсия</w> <w><ana lex="во" gr="PR,norm" sem="" sem2=""/>во</w> <w><ana lex="глава" gr="S,f,inan,loc,norm,sg" sem="t:text pc:hum pt:part pc:text pt:partb r:concr" sem2="pc:constr r:concr pt:part"/>главе</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="мой" gr="APRO,ins,m,norm,sg" sem="r:poss" sem2=""/>моим</w> <w><ana lex="старший" gr="A,ins,m,norm,plen,sg" sem="r:qual" sem2="t:hier r:rel t:ord"/>старшим</w> <w><ana lex="помощник" gr="S,anim,ins,m,norm,sg" sem="der:v t:hum r:concr d:nag" sem2="der:v t:hum r:concr d:nag"/>помощником</w> <w><ana lex="кондратьев" gr="S,anim,famn,ins,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Кондратьевым</w>.</se><se> <w><ana lex="последний" gr="A,dat,m,norm,plen,sg" sem="r:rel t:ord" sem2="t:degr:max:magn r:qual r:rel ev:neg t:time"/>Последнему</w> <w><ana lex="сопутствовать" gr="V,act,indic,intr,ipf,nor