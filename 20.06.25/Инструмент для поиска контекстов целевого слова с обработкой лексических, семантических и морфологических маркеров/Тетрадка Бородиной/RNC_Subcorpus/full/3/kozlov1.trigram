<w><ana lex="фотографический" gr="A,gen,m,norm,plen,sg" sem="der:comp r:rel" sem2=""/>фотографического</w> <w><ana lex="аппарат" gr="S,gen,inan,m,norm,sg" sem="t:tool:device r:concr" sem2="sc:org sc:hum sc:partb pc:hum pc:animal t:org pt:set pt:aggr t:group pt:partb:inner r:concr"/>аппарата</w>, <w><ana lex="чтобы" gr="CONJ,norm" sem="" sem2=""/>чтобы</w> <w><ana lex="снять" gr="V,act,inf,norm,pf" sem="der:v ca:caus t:move d:pref" sem2="der:v d:pref"/>снять</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="только" gr="PART,norm" sem="" sem2=""/>только</w> <w><ana lex="вид" gr="S,anim,famn,m,nom,norm,pl" sem="" sem2=""/><ana lex="вид" gr="S,inan,m,nom,norm,pl" sem="der:v r:abstr" sem2="t:ment t:space r:abstr t:workart der:v t:perc r:concr t:fam"/>виды</w> <w><ana lex="монастырь" gr="S,gen,inan,m,norm,pl" sem="r:concr t:org" sem2="t:constr r:concr t:org"/>монастырей</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="вид" gr="S,anim,famn,m,nom,norm,pl" sem="" sem2=""/><ana lex="вид" gr="S,inan,m,nom,norm,pl" sem="der:v r:abstr" sem2="t:ment t:space r:abstr t:workart der:v t:perc r:concr t:fam"/>виды</w> <w><ana lex="красивый" gr="A,gen,norm,pl,plen" sem="ev:posit t:appearance r:qual" sem2="ev:posit ev t:appearance r:qual"/>красивых</w> <w><ana lex="уголок" gr="S,gen,inan,m,norm,pl" sem="dt:form t:form top:corner top:form der:s d:dim r:concr" sem2="pt:aggr sc:tool t:tool t:space top:contain dt:space top:corner t:room pt:ind t:sign dt:part top:form pc:x pt:part d:dim r:concr pc:room der:s"/>уголков</w> <w><ana lex="местный" gr="A,f,gen,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s"/>местной</w> <w><ana lex="природа" gr="S,f,gen,inan,norm,sg" sem="pt:aggr t:space r:concr sc:space" sem2="pt:aggr t:space r:concr r:abstr sc:space"/>природы</w>.</se></p>
