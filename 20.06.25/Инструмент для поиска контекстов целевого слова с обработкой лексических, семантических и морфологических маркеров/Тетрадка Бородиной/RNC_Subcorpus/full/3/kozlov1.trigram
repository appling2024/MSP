<p><se><b/><w><b>20</b></w><b>/</b><w><ana lex="x" gr="bastard" sem="" sem2=""/><b>X</b></w><b>, </b><w><ana lex="w" gr="bastard" sem="" sem2=""/><b>W</b></w><b/>. <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="полуясный" gr="A,acc,bastard,inan,m,plen,sg" sem="" sem2=""/>полуясный</w> <w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w>.</se><se> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>Мы</w> <w><ana lex="задумать" gr="V,act,indic,norm,pf,pl,praet" sem="t:ment ca:noncaus der:v d:pref" sem2="der:v d:pref"/>задумали</w> <w><ana lex="устроить" gr="V,act,inf,norm,pf" sem="der:v ca:caus d:pref t:be:appear" sem2="der:v d:pref"/>устроить</w> <w><ana lex="облава" gr="S,acc,f,inan,norm,sg" sem="r:abstr" sem2="r:abstr"/>облаву</w> <w><ana lex="назавтра" gr="ADV,norm" sem="der:adv t:time" sem2=""/>назавтра</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="r" gr="bastard" sem="" sem2=""/>R</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="соседний" gr="A,gen,norm,pl,plen" sem="t:dist r:rel der:s dt:hum" sem2=""/>соседних</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="север" gr="S,dat,inan,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr t:fam pt:part pc:space"/><ana lex="север" gr="S,anim,dat,m,norm,persn,sg" sem="" sem2=""/>северу</w> <w><ana lex="гора" gr="S,f,inan,loc,norm,pl" sem="top:hill t:space r:concr" sem2="sc:x pt:set t:space t:form r:abstr t:quant:max r:concr"/>горах</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="ущелие" gr="S,inan,loc,n,norm,pl" sem="" sem2=""/>ущельях</w>, <w><ana lex="расположить" gr="V,loc,norm,partcp,pass,pf,pl,plen,praet" sem="t:put ca:caus der:v d:pref" sem2=""/><ana lex="расположить" gr="V,intr,loc,norm,partcp,pass,pf,pl,plen,praet" sem="t:put ca:caus der:v d:pref" sem2=""/>расположенных</w> <w