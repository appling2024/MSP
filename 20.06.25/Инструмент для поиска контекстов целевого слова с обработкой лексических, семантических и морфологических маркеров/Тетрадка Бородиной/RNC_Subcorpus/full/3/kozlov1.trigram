<p><se><w><ana lex="мой" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/>Моя</w> <w><ana lex="спутница" gr="S,anim,f,nom,norm,sg" sem="t:hum d:fem r:concr der:s" sem2=""/>спутница</w> <w><ana lex="елена" gr="S,anim,f,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Елена</w> <w><ana lex="петровна" gr="S,anim,f,nom,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Петровна</w> <w><ana lex="поохотиться" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="d:pref" sem2=""/>поохотилась</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="серый" gr="A,ins,norm,pl,plen" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>серыми</w> <w><ana lex="куропатка" gr="S,anim,f,ins,norm,pl" sem="t:animal r:concr" sem2=""/>куропатками</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="китайский" gr="A,dat,norm,pl,plen" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>китайским</w> <w><ana lex="пашня" gr="S,dat,f,inan,norm,pl" sem="der:v t:plot t:space r:concr" sem2=""/>пашням</w>.</se><se> <w><ana lex="вечер" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечер</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="все" gr="ADV,norm" sem="" sem2=""/>все</w> <w><ana lex="со" gr="PR,norm" sem="" sem2=""/>со</w> <w><ana lex="свой" gr="APRO,ins,norm,pl" sem="r:poss" sem2="t:social r:poss"/>своими</w> <w><ana lex="хозяин" gr="S,anim,ins,m,norm,pl" sem="t:hum r:concr" sem2="t:hum ev:posit ev r:concr"/>хозяевами</w> <w><ana lex="провести" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="провести" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="проводить" gr="V,act,indic,norm,pf,pl,praet" sem="ca:caus t:move d:pref" sem2="d:pref"/>провели</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="ми