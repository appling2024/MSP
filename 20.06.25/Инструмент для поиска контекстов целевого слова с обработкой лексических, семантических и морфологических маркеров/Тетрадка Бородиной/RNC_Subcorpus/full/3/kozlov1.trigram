<p><se><w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>Очень</w> <w>приятно</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="свидеться" gr="V,act,inf,intr,norm,pf" sem="ca:noncaus d:pref t:perc" sem2=""/>свидеться</w> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w> <w><ana lex="здесь" gr="ADVPRO,norm" sem="t:place r:dem" sem2="t:time r:dem"/>здесь</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w>А</w>. <w>А</w>. <w><ana lex="дудукалов" gr="S,anim,bastard,famn,ins,m,sg" sem="t:hum r:propn t:famn" sem2=""/>Дудукаловым</w>, <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="который" gr="APRO,gen,m,norm,sg" sem="r:rel t:ord" sem2=""/>которого</w>, <w><ana lex="между" gr="PR,norm" sem="" sem2=""/>между</w> <w><ana lex="прочее" gr="SPRO,ins,n,norm,sg" sem="" sem2=""/>прочим</w>, <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="произвести" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:caus d:pref t:be:appear" sem2="d:pref"/>произвел</w> <w><ana lex="обмен" gr="S,acc,inan,m,norm,sg" sem="der:v r:abstr der:s0 t:poss" sem2="der:v r:abstr t:inter"/>обмен</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="размен" gr="S,acc,inan,m,norm,sg" sem="der:v r:abstr" sem2=""/>размен</w> <w><ana lex="американский" gr="A,gen,norm,pl,plen" sem="dt:topon r:rel der:s t:topon" sem2=""/>американских</w> <w><ana lex="доллар" gr="S,gen,inan,m,norm,pl" sem="r:concr t:money:banknote" sem2=""/>долларов</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="янчень" gr="S,bastard,f,gen,inan,sg" sem="" sem2=""/><ana lex="янчень" gr="S,bastard,f,gen,inan,sg" sem="" sem2=""/>янчени</w>.</se><se> <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>Но</w> <w><ana lex="большой" gr="A,comp,norm,plen" sem="t:size:max r:qual" sem2="t:quant:max t:time:age t:degr:max r:qual"/>больше</w> <w><ana