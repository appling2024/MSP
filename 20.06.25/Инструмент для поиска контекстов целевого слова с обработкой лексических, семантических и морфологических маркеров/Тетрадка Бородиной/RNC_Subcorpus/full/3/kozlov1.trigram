<p><se><w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="11" gr="NUM,ciph"/>11</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w> <w><ana lex="утро" gr="S,gen,inan,n,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утра</w> <w><ana lex="леночка" gr="S,anim,f,nom,norm,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Леночка</w> <w><ana lex="принести" gr="V,act,f,indic,norm,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus ca:0 d:pref"/>принесла</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="консульство" gr="S,gen,inan,n,norm,sg" sem="r:concr t:org der:s" sem2="r:abstr"/>консульства</w> <w><ana lex="известие" gr="S,acc,inan,n,norm,sg" sem="t:speech r:abstr" sem2="der:v r:propn r:concr t:text t:media"/>известие</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="смерть" gr="S,f,gen,inan,norm,sg" sem="t:physiol der:v t:be:disapp r:abstr" sem2="t:quant:max t:be:disapp r:abstr"/>смерти</w> <w><ana lex="ленин" gr="S,anim,famn,gen,m,norm,sg" sem="t:hum r:propn t:famn t:persn" sem2=""/>Ленина</w>.</se><se> <w><ana lex="важный" gr="A,m,nom,norm,plen,sg" sem="t:hier r:qual" sem2="t:quality ev:posit t:hier r:qual"/>Важный</w> <w><ana lex="момент" gr="S,inan,m,nom,norm,sg" sem="pt:qtm t:time:moment r:abstr pc:time" sem2="r:abstr"/>момент</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="история" gr="S,f,inan,loc,norm,sg" sem="r:abstr" sem2="ev:neg r:concr r:abstr t:text"/>истории</w> <w><ana lex="россия" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>России</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="далекий" gr="A,brev,norm,pl" sem="t:dist:max r:qual" sem2="dt:dist:max der:shif