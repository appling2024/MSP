lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w>слышно</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="лай" gr="S,gen,inan,m,norm,sg" sem="der:v t:sound:asp r:abstr der:s0" sem2=""/>лая</w> <w><ana lex="собака" gr="S,anim,f,gen,norm,pl" sem="t:animal r:concr" sem2="t:animal r:concr"/>собак</w>.</se><se> <w><ana lex="гулять" gr="V,act,ger,intr,ipf,norm,praes" sem="ca:noncaus t:move d:root" sem2="d:root"/>Гуляя</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="поздний" gr="A,gen,m,norm,plen,sg" sem="t:time r:qual" sem2="t:time r:qual"/>позднего</w> <w><ana lex="вечер" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>вечера</w>, <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="наблюдать" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="ca:noncaus d:pref t:perc" sem2="d:pref"/>наблюдал</w> <w><ana lex="медленный" gr="A,acc,n,norm,plen,sg" sem="t:speed:min r:qual" sem2="t:speed:min r:qual"/>медленное</w> <w><ana lex="перемещение" gr="S,acc,inan,n,norm,sg" sem="der:v t:move r:abstr" sem2=""/>перемещение</w> <w><ana lex="небесный" gr="A,gen,norm,pl,plen" sem="dt:space r:rel der:s" sem2="dt:space ev:posit r:rel der:s"/>небесных</w> <w><ana lex="светило" gr="S,anim,gen,n,norm,pl" sem="" sem2="t:hum ev:posit r:concr"/><ana lex="светило" gr="S,gen,inan,n,norm,pl" sem="der:v t:astr t:space r:concr" sem2=""/>светил</w>.</se></p>
