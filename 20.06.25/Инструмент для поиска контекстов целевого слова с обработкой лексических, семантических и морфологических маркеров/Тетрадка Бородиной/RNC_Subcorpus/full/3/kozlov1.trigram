<p><se><w><ana lex="напрасно" gr="ADV,norm" sem="der:a" sem2=""/>Напрасно</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="ждать" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="d:root" sem2="d:root"/>ждали</w> <w><ana lex="почта" gr="S,f,gen,inan,norm,sg" sem="sc:org pt:aggr r:concr t:org pt:ind" sem2="sc:thing r:abstr t:org pt:aggr r:concr sc:text"/>почты</w>: <w><ana lex="никто" gr="SPRO,anim,dat,m,norm,sg" sem="r:neg" sem2=""/>никому</w> -- <w><ana lex="ничто" gr="SPRO,gen,n,norm,sg" sem="r:neg" sem2=""/>ничего</w>, <w><ana lex="если" gr="CONJ,norm" sem="" sem2=""/>если</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="считать" gr="V,act,inf,norm,pf" sem="der:v d:pref" sem2="der:v t:ment d:pref ca:noncaus"/><ana lex="считать" gr="V,act,inf,ipf,norm,tran" sem="der:v d:pref" sem2="der:v t:ment d:pref ca:noncaus"/><ana lex="считать" gr="V,act,inf,norm,pf,tran" sem="der:v d:pref" sem2="der:v t:ment d:pref ca:noncaus"/><ana lex="считать" gr="V,act,inf,ipf,norm,tran" sem="der:v d:pref" sem2="der:v t:ment d:pref ca:noncaus"/>считать</w> <w><ana lex="единственный" gr="A,f,gen,norm,plen,sg" sem="r:rel" sem2="r:rel"/>единственной</w> <w><ana lex="застарелый" gr="A,f,gen,norm,plen,sg" sem="r:rel" sem2=""/>застарелой</w> <w><ana lex="весточка" gr="S,f,gen,inan,norm,sg" sem="t:ment d:dim r:abstr der:s" sem2=""/>весточки</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="петроград" gr="S,gen,inan,m,norm,sg" sem="r:propn t:topon" sem2=""/>Петрограда</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="три" gr="NUM,gen,norm" sem="r:card:pauc" sem2=""/>трех</w> <w><ana lex="девица" gr="S,anim,f,gen,norm,pl" sem="t:hum r:concr der:s" sem2=""/>девиц</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="конец" gr="S,gen,inan,m,norm,sg" sem="pt:phase r:concr r:abstr pt:part pc:x" sem2="top:rope t:tool t:space t:be:disapp r:abstr ev:neg r:concr"/>конца</w> <w><ana lex="декабрь" gr="S,gen,inan,m,norm,sg" sem="t:time:month r:abstr" sem2=""/>декабря</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="начало" gr="S,gen,inan,n,norm,sg" sem="pt:phase r:abstr pc:x pt:part pc:pc:x r:concr" sem2="t:asp r:abstr pt:part"/>начала</w> <w><ana lex="январь" gr="S,gen,inan,m,norm,sg" sem="t:time:month r:abstr" sem2=""/><ana lex="январь" gr="S,anim,gen,m,norm,persn,sg" sem="" sem2=""/>января</w>.</se><se> <w><ana lex="что" gr="SPRO,inan,n,nom,norm,sg" sem="r:rel" sem2=""/><ana form="Что-то" lex="что-то" gr="SPRO,inan,n,nom,norm,sg" sem="r:indet" sem2=""/>Что-то</w> <w><ana lex="такой" gr="APRO,n,nom,norm,sg" sem="r:dem" sem2="r:indet r:spec t:degr:max"/>такое</w> <w><ana lex="делаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v ca:noncaus" sem2="der:v ca:noncaus"/>делается</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="письмо" gr="S,inan,ins,n,norm,pl" sem="r:concr t:text" sem2="pt:aggr t:asp r:concr r:abstr sc:letter"/>письмами</w>?</se><se> <w><ana lex="это" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>Это</w> <w><ana lex="непонятный" gr="A,brev,n,norm,sg" sem="d:neg der:a r:qual" sem2="d:neg r:qual"/>непонятно</w>, <w><ana lex="ничто" gr="SPRO,ins,n,norm,sg" sem="r:neg" sem2=""/><ana lex="ничто" gr="SPRO,inan,ins,n,norm,sg" sem="r:neg" sem2=""/>ничем</w> <w>нельзя</w> <w><ana lex="объяснить" gr="V,act,inf,norm,pf" sem="t:speech ca:noncaus d:pref" sem2=""/>объяснить</w>.</se><se> <w><ana lex="ни" gr="PART,norm" sem="" sem2=""/>Ни</w> <w><ana lex="один" gr="APRO,gen,n,norm,sg" sem="" sem2="r:indet"/>одного</w> <w><ana lex="письмо" gr="S,gen,inan,n,norm,sg" sem="r:concr t:text" sem2="pt:aggr t:asp r:concr r:abstr sc:letter"/>письма</w> <w><ana lex="никто" gr="SPRO,anim,dat,m,norm,sg" sem="r:neg" sem2=""/>никому</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="состав" gr="S,gen,inan,m,norm,sg" sem="sc:hum pt:aggr r:concr" sem2="der:v t:tool:transp t:stuff r:concr sc:tool:tran