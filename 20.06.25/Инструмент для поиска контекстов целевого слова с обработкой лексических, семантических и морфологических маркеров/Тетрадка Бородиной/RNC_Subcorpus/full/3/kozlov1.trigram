<p><se><w><ana lex="вечер" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечер</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="поздний" gr="A,f,gen,norm,plen,sg" sem="t:time r:qual" sem2="t:time r:qual"/>поздней</w> <w><ana lex="ночь" gr="S,f,gen,inan,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2=""/>ночи</w> (<w><ana lex="3" gr="NUM,ciph"/>3</w> <w><ana lex="час" gr="S,gen,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часа</w>) <w><ana lex="провести" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="провести" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="проводить" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="ca:caus t:move d:pref" sem2="d:pref"/>проведен</w> <w><ana lex="я" gr="SPRO,1p,ins,norm,sg" sem="r:pers" sem2=""/>мною</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="два" gr="NUM,ins,norm" sem="r:card:pauc" sem2=""/>двумя</w> <w><ana lex="мой" gr="APRO,ins,norm,pl" sem="r:poss" sem2=""/>моими</w> <w><ana lex="старший" gr="A,ins,norm,pl,plen" sem="r:qual" sem2="t:hier r:rel t:ord"/>старшими</w> <w><ana lex="спутник" gr="S,anim,ins,m,norm,pl" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,inan,ins,m,norm,pl" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутниками</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="милый" gr="A,gen,m,norm,plen,sg" sem="t:humq r:qual" sem2="ev:posit t:social:emot r:qual"/>милого</w> <w>А</w>. <w>Н</w>. <w><ana lex="васильев" gr="S,anim,famn,gen,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Васильева</w>.</se><se> <w><ana lex="приглашение" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr der:s0 t:inter" sem2="der:v r:concr t:text"/>Приглашение</w> <w><ana lex="последовать" gr="V,act,indic,intr,n,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2=""/>последовало</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="блин" gr="S,acc,inan,m,norm,pl" sem="t:food r:concr top:disk" sem2=""/>блины</w>.</se><se> <w><ana lex="званый" gr="A,gen,norm,pl,plen" sem="der:v r:rel dt:speech" sem2="der:v r:rel dt:speech"/>Званых</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w>много</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="дама" gr="S,anim,f,ins,norm,pl" sem="t:hum r:concr" sem2="t:hum r:concr"/>дамами</w>.</se><se> <w><ana lex="ринчина" gr="S,acc,bastard,inan,m,sg" sem="" sem2=""/>Ринчино</w>, <w><ana lex="жамцарать" gr="V,bastard,brev,ipf,n,partcp,pass,praet,sg,tran" sem="" sem2=""/><ana lex="жамцарать" gr="V,bastard,brev,n,partcp,pass,pf,praet,sg" sem="" sem2=""/><ana lex="жамцарать" gr="V,bastard,brev,n,partcp,pass,pf,praet,sg,tran" sem="" sem2=""/>Жамцарано</w>, <w><ana lex="батухан" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Батухан</w>, <w><ana lex="цецен" gr="S,bastard,inan,m,nom,sg" sem="" sem2=""/>Цецен-хан</w> (<w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="супруга" gr="S,anim,f,ins,norm,sg" sem="" sem2=""/>супругой</w>).</se><se> <w><ana lex="короткий" gr="A,comp,norm,plen" sem="t:size:min r:qual" sem2="t:behav ev:posit t:size:min t:time:dur:min r:qual"/>Короче</w>, <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="все" gr="SPRO,inan,n,nom,norm,sg" sem="" sem2=""/>все</w> <w><ana lex="лучший" gr="A,n,nom,norm,sg,supr" sem="d:super ev:posit der:a t:quality r:qual" sem2=""/>лучшее</w>, <w><ana lex="старший" gr="A,n,nom,norm,plen,sg" sem="r:qual" sem2="t:hier r:rel t:ord"/>старшее</w>, <w><ana lex="симпатичный" gr="A,n,nom,norm,plen,sg" sem="ev:posit t:appearance der:s dt:hum r:qual" sem2=""/>симпатичное</w>.</se><se> <w><ana lex="блин" gr="S,inan,m,nom,norm,pl" sem="t:food r:concr top:disk" sem2=""/>Блины</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="весь" gr="APRO,nom,norm,pl" sem="r:spec" sem2=""/>все</w> <w>прочие</w> <w><ana lex="приложение" gr="S,inan,n,nom,norm,pl" sem="der:v t:move r:abstr der:s0" sem2="der:v r:concr t:text"/>приложения</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>были</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="слава" gr="S,acc,f,inan,norm,sg" sem="ev:posit r:abstr" sem2="t:speech r:abstr ev:neg"/>славу</w> <w><ana lex="хороший" gr="A,brev,norm,pl" sem="ev:posit t:quality r:qual" sem2="ev:posit ev t:degr:max r:qual"/>хороши</w>.</se><se> <w><ana lex="говориться" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:speech ca:noncaus d:root" sem2="ca:noncaus d:root"/><ana lex="говориться" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:speech ca:noncaus d:root" sem2="ca:noncaus d:root"/>Говорились</w> <w><ana lex="милый" gr="A,nom,norm,pl,plen" sem="t:humq r:qual" sem2="ev:posit t:social:emot r:qual"/>милые</w> <w><ana lex="речь" gr="S,f,inan,nom,norm,pl" sem="t:speech r:abstr" sem2="t:speech r:concr r:abstr"/>речи</w>, <w><ana lex="подзадоривать" gr="V,act,ipf,nom,norm,partcp,pl,plen,praet,tran" sem="d:pref d:impf der:s" sem2=""/>подзадоривавшие</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="поднятие" gr="S,dat,inan,n,norm,sg" sem="der:v t:move r:abstr" sem2=""/>поднятию</w> <w><ana lex="рюмка" gr="S,f,gen,inan,norm,pl" sem="top:contain r:concr t:tool:dish" sem2=""/>рюмок</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="прекрасный" gr="A,ins,n,norm,plen,sg" sem="ev:posit t:appearance r:qual" sem2="ev:posit t:quality r:qual"/>прекрасным</w> <w><ana lex="вино" gr="S,inan,ins,n,norm,sg" sem="t:food t:stuff r:concr t:liq" sem2="t:food t:stuff r:concr t:liq"/>вином</w>.</se><se> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>До</w> <w><ana lex="поздний" gr="A,gen,norm,pl,plen" sem="t:time r:qual" sem2="t:time r:qual"/>поздних</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w> <w><ana lex="сидеть" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:noncaus"/>сидели</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="больший" gr="A,ins,m,norm,plen,sg" sem="d:compar t:size:max der:a dt:size:max r:qual" sem2=""/><ana lex="большой" gr="A,ins,m,norm,plen,sg" sem="t:size:max r:qual" sem2="t:quant:max t:time:age t:degr:max r:qual"/>большим</w> <w><ana lex="стол" gr="S,inan,ins,m,norm,sg" sem="top:horiz top:contain r:concr t:tool:furn" sem2="t:space sc:food t:org t:tool:furn pt:aggr r:concr"/>столом</w>, <w><ana lex="вкушать" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="der:v t:physiol d:pref" sem2=""/>вкушали</w> <w><ana lex="под" gr="PR,norm" sem="" sem2=""/>под</w> <w><ana lex="звук" gr="S,acc,inan,m,norm,pl" sem="t:sound r:abstr" sem2="pc:speech pt:qtm r:abstr"/>звуки</w> <w><ana lex="песня" gr="S,f,gen,inan,norm,pl" sem="t:workmus r:concr t:text" sem2="t:sound r:abstr"/>песен</w> <w><ana lex="дополнительный" gr="A,gen,m,norm,plen,sg" sem="der:v r:rel" sem2="dt:abstr r:rel der:s"/>дополнительного</w>, <w><ana lex="домашний" gr="A,gen,m,norm,plen,sg" sem="r:rel der:s dt:constr" sem2="r:rel der:s dt:constr"/>домашнего</w> <w><ana lex="стол" gr="S,gen,inan,m,norm,sg" sem="top:horiz top:contain r:concr t:tool:furn" sem2="t:space sc:food t:org t:tool:furn pt:aggr r:concr"/>стола</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="молодежь" gr="S,f,inan,ins,norm,sg" sem="sc:hum pt:aggr r:concr der:a" sem2=""/>молодежью</w>.</se><se> <w><ana lex="вечер" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечер</w> <w><ana lex="удаться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref"/>удался</w> <w><ana lex="лучший" gr="A,ins,m,norm,sg,supr" sem="d:super ev:posit der:a t:quality r:qual" sem2=""/>лучшим</w> <w><ana lex="образ" gr="S,inan,ins,m,norm,sg" sem="t:ment r:concr r:abstr t:workart" sem2="t:asp r:abstr"/>образом</w>.</se><se> <w>Много</w> <w><ana lex="беседовать" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:speech ca:noncaus der:s" sem2=""/>беседовали</w>, <w>столько</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w> <w><ana lex="есть" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="ca:caus t:physiol d:root" sem2="t:be:exist ca:noncaus d:root"/>ели</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="пить" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="ca:caus t:physiol d:root" sem2="d:root"/>пили</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="менее" gr="ADV,norm" sem="t:degr:min der:adv" sem2="t:degr:min der:adv"/>менее</w> <w><ana lex="то" gr="SPRO,gen,inan,n,norm,sg" sem="r:dem" sem2=""/>того</w> <w><ana lex="заниматься" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>занимались</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="гостина" gr="S,anim,f,famn,loc,norm,sg" sem="" sem2=""/><ana lex="гостиная" gr="S,f,inan,loc,norm,sg" sem="der:subst top:contain der:a pc:constr:build t:room pt:part pc:room:appart r:concr" sem2="pt:set der:subst sc:tool:furn r:concr der:a"/>гостиной</w>, <w><ana lex="играть" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="d:root" sem2="d:root"/>играли</w>.</se><se> <w><ana lex="короткий" gr="A,comp,norm,plen" sem="t:size:min r:qual" sem2="t:behav ev:posit t:size:min t:time:dur:min r:qual"/>Короче</w>, <w><ana lex="веселиться" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="ca:noncaus t:psych:emot t:behav" sem2=""/><ana lex="веселиться" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="ca:noncaus t:psych:emot t:behav" sem2=""/>веселились</w> <w><ana lex="все" gr="SPRO,acc,inan,n,norm,sg" sem="" sem2=""/>все</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="слава" gr="S,acc,f,inan,norm,sg" sem="ev:posit r:abstr" sem2="t:speech r:abstr ev:neg"/>славу</w>!</se><se> <w><ana lex="честь" gr="S,f,inan,nom,norm,sg" sem="r:abstr" sem2="ev:posit r:abstr"/>Честь</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="слава" gr="S,f,inan,nom,norm,sg" sem="ev:posit r:abstr" sem2="t:speech r:abstr ev:neg"/>слава</w> <w><ana lex="хозяин" gr="S,anim,dat,m,norm,sg" sem="t:hum r:concr" sem2="t:hum ev:posit ev r:concr"/>хозяину</w>.</se><se> <w><ana lex="мой" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>Мой</w> <w><ana lex="сергей" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Сергей</w> <w><ana lex="александрович" gr="S,anim,m,nom,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2="t:hum r:propn t:famn"/><ana lex="александрович" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum t:patrn r:propn der:s" sem2="t:hum r:propn t:famn"/>Александрович</w> <w><ana lex="играть" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="d:root" sem2="d:root"/>играл</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="роял" gr="S,anim,loc,m,norm,persn,sg" sem="" sem2=""/><ana lex="рояль" gr="S,inan,loc,m,norm,sg" sem="t:tool:mus r:concr" sem2=""/>рояле</w>, <w>конечно</w> <w><ana lex="превосходно" gr="ADV,norm" sem="ev:posit dt:degr:max der:a" sem2=""/>превосходно</w>!</se></p>
<p><se><w><ana lex="как" gr="ADVPRO,norm" sem="r:rel t:manner" sem2=""/><ana form="Как-то" lex="как-то" gr="ADVPRO,norm" sem="der:advpro r:indet t:manner" sem2=""/>Как-то</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="бывать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:be:exist ca:noncaus der:v d:impf" sem2="der:v t:loc der:shift d:impf ca:noncaus"/>бывает</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="наряду" gr="ADV,norm" sem="der:s" sem2=""/>наряду</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="хороший" gr="A,ins,m,norm,plen,sg" sem="ev:posit t:quality r:qual" sem2="ev:posit ev t:degr:max r:qual"/>хорошим</w> <w><ana lex="случаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="" sem2=""/>случается</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="нехороший" gr="A,acc,n,norm,plen,sg" sem="d:neg ev:neg t:quality der:a r:qual" sem2=""/>нехорошее</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="неудачный" gr="A,acc,n,norm,plen,sg" sem="d:neg ev der:a r:qual" sem2="d:neg ev:neg t:quality der:a r:qual"/>неудачное</w>.</se><se> <w><ana lex="наш" gr="APRO,acc,f,norm,sg" sem="r:poss" sem2=""/>Нашу</w> <w><ana lex="тележка" gr="S,acc,f,inan,norm,sg" sem="t:tool:transp r:concr der:s d:dim" sem2="t:tool pc:tool:device top:horiz t:tool:transp der:s pt:part r:concr"/>тележку</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="кучер" gr="S,acc,anim,m,norm,sg" sem="t:hum r:concr t:prof" sem2=""/>кучера</w> <w><ana lex="разбить" gr="V,act,indic,m,norm,pf,praet,sg" sem="t:impact ca:caus d:pref" sem2="t:impact ca:caus ca:0 d:pref ca:bgr"/>разбил</w> <w><ana lex="автомобиль" gr="S,inan,m,nom,norm,sg" sem="t:tool:transp r:concr" sem2=""/>автомобиль</w> -- «<w><ana lex="удовольствие" gr="S,inan,n,nom,norm,sg" sem="t:psych:emot r:abstr" sem2="ev:posit r:abstr"/>удовольствие</w>»!</se><se> <w><ana l