<p><se><w><ana lex="дело" gr="S,inan,n,nom,norm,sg" sem="r:abstr" sem2="sc:doc ev:posit r:abstr t:org der:v r:concr"/>Дело</w> <w><ana lex="сделать" gr="V,brev,n,norm,partcp,pass,pf,praet,sg,tran" sem="d:pref" sem2=""/>сделано</w>.</se><se> <w><ana lex="телеграф" gr="S,inan,m,nom,norm,sg" sem="r:abstr" sem2="der:comp t:tool:device r:concr"/>Телеграф</w> <w><ana lex="понести" gr="V,act,indic,m,norm,pf,praet,sg,tran" sem="der:v ca:caus t:move d:pref" sem2="t:move ca:caus der:v ca:0 ca:noncaus d:pref"/>понес</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="далекий" gr="A,acc,inan,m,norm,plen,sg" sem="t:dist:max r:qual" sem2="dt:dist:max der:shift t:time t:humq r:qual"/>далекий</w> <w><ana form="северо-запад" lex="северо-запад" gr="S,acc,inan,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr pt:part pc:space"/>северо-запад</w> <w><ana lex="наш" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>наши</w> <w><ana lex="мечта" gr="S,f,inan,nom,norm,pl" sem="t:ment r:abstr" sem2="t:ment ev:posit r:abstr"/>мечты</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="стремление" gr="S,inan,n,nom,norm,pl" sem="t:ment der:v r:abstr der:s0" sem2="t:psych r:abstr"/>стремления</w>!</se><se> <w><ana lex="как" gr="ADVPRO,norm" sem="r:rel t:manner" sem2=""/><ana form="Как-то" lex="как-то" gr="ADVPRO,norm" sem="der:advpro r:indet t:manner" sem2=""/>Как-то</w> <w><ana lex="там" gr="ADVPRO,norm" sem="t:place r:dem" sem2=""/>там</w> <w><ana lex="понять" gr="V,3p,act,fut,indic,norm,pf,pl" sem="t:ment ca:noncaus der:v d:pref" sem2=""/>поймут</w> <w><ana lex="мы" gr="SPRO,1p,acc,norm,pl" sem="r:pers" sem2=""/>нас</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="как" gr="ADVPRO,norm" sem="r:rel t:manner" sem2=""/>как</w> <w><ana lex="откликнуться" gr="V,3p,act,fut,indic,intr,norm,pf,pl" sem="t:speech ca:noncaus d:pref t:sound" sem2="ca:noncaus d:pref"/>откликнутся</w>?</se><se> <w><ana lex="быть" gr="V,1p,act,fut,indic,intr,