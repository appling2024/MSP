<p><se><w><ana lex="новость" gr="S,f,inan,nom,norm,sg" sem="r:abstr der:a" sem2="t:speech der:a r:concr t:text r:abstr"/>Новость</w> -- <w><ana lex="электричество" gr="S,inan,n,nom,norm,sg" sem="r:abstr" sem2="sc:tool:device pt:aggr r:concr r:abstr t:light"/>электричество</w>.</se><se> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>Мы</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="лучший" gr="A,f,gen,norm,sg,supr" sem="d:super ev:posit der:a t:quality r:qual" sem2=""/>лучшей</w> <w><ana lex="часть" gr="S,f,gen,inan,norm,sg" sem="r:concr pc:x pt:part" sem2="pc:org r:abstr sc:part t:org pt:ind pt:aggr:aggrpl t:poss der:shift pc:x pt:part pc:text r:concr"/>части</w> <w><ana lex="урга" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Урги</w>, <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="опоганить" gr="V,f,gen,norm,partcp,pass,pf,plen,praet,sg" sem="der:v t:changest d:pref ca:caus" sem2=""/>опоганенной</w> <w><ana lex="зловоние" gr="S,inan,ins,n,norm,sg" sem="der:comp r:abstr" sem2=""/>зловонием</w>.</se><se> <w><ana lex="устроиться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="der:v d:pref t:be:appear" sem2=""/>Устроились</w>!</se><se> <w><ana lex="благодаря" gr="PR,norm" sem="" sem2=""/>Благодаря</w> <w><ana lex="любезность" gr="S,f,inan,loc,norm,sg" sem="t:humq r:abstr der:a" sem2="t:speech ev:posit r:abstr der:a"/>любезности</w> <w><ana lex="мой" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/>моего</w> <w>Ц</w>. <w>Г</w>. <w><ana lex="бадмажапова" gr="S,anim,bastard,f,famn,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Бадмажапова</w> <w><ana lex="мы" gr="SPRO,1p,dat,norm,pl" sem="r:pers" sem2=""/>нам</w> <w><ana lex="житься" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v ca:noncaus" sem2="der:v ca:noncaus"/>живется</w> <w>отлично</w>, <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="лучший" gr="A,loc,norm,pl,su