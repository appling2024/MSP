<p><se><w><ana lex="p" gr="bastard" sem="" sem2=""/>P</w>. <w><ana lex="s" gr="bastard" sem="" sem2=""/>S</w>. <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>Очень</w> <w><ana lex="хотеться" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="ca:noncaus t:psych:volit" sem2=""/>хотелось</w> <w><ana lex="бы" gr="PART,norm" sem="" sem2=""/>бы</w> <w><ana lex="знать" gr="V,act,inf,ipf,norm,tran" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/>знать</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="какой" gr="APRO,loc,m,norm,sg" sem="t:neg r:rel ev:neg" sem2=""/>каком</w> <w><ana lex="объем" gr="S,inan,loc,m,norm,sg" sem="r:abstr t:param" sem2="r:abstr"/>объеме</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="какой" gr="APRO,gen,m,norm,sg" sem="t:neg r:rel ev:neg" sem2=""/>какого</w> <w><ana lex="род" gr="S,anim,gen,m,norm,persn,sg" sem="" sem2=""/><ana lex="род" gr="S,gen,inan,m,norm,sg" sem="t:group pt:set r:concr sc:hum r:abstr" sem2="pt:set sc:hum r:concr r:abstr t:like"/>рода</w> <w><ana lex="желательный" gr="A,brev,norm,pl" sem="der:v r:qual" sem2=""/>желательны</w> <w><ana lex="вы" gr="SPRO,2p,dat,norm,pl" sem="r:pers" sem2=""/>Вам</w> <w><ana lex="очерк" gr="S,inan,m,nom,norm,pl" sem="r:concr t:text" sem2="der:v r:concr t:text"/>очерки</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="периодический" gr="A,nom,norm,pl,plen" sem="dt:text r:rel der:s t:time" sem2="dt:text r:rel der:s t:time"/>периодические</w> <w><ana lex="отчет" gr="S,inan,m,nom,norm,pl" sem="t:speech der:v r:abstr der:s0" sem2="t:speech r:abstr"/>отчеты</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="состояние" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr der:s0" sem2="sc:thing ev:posit t:psych r:abstr der:shift sc:money pt:aggr t:physiol r:concr"/>состоянии</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="деятельность" gr="S,f,inan,loc,norm,sg" sem="der:v r:abstr" sem2=