<p><se><w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="этот" gr="APRO,loc,m,norm,sg" sem="r:dem" sem2=""/>этом</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w> <w><ana lex="номер" gr="S,inan,loc,m,norm,sg" sem="r:abstr" sem2="t:tool t:sign top:contain t:param r:abstr t:room pc:constr pt:part r:concr"/>номере</w> <w><ana lex="иметься" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:poss" sem2=""/>имеется</w> <w><ana lex="заметка" gr="S,f,inan,nom,norm,sg" sem="der:v t:sign r:concr" sem2="der:v r:concr t:text"/>заметка</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="монгольский" gr="A,f,loc,norm,plen,sg" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>монгольской</w> <w><ana lex="музыка" gr="S,f,inan,loc,norm,sg" sem="r:abstr" sem2="t:sound r:abstr t:fam"/>музыке</w> (<w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="статья" gr="S,f,gen,inan,norm,sg" sem="r:concr t:text" sem2="t:hier t:text r:abstr pt:part pc:text r:concr"/>статьи</w> <w><ana lex="кондратьев" gr="S,anim,famn,gen,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Кондратьева</w>).</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="течение" gr="S,acc,inan,n,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="qc:stuff der:v t:move r:concr r:abstr"/>течение</w> <w><ana lex="весь" gr="APRO,gen,m,norm,sg" sem="r:spec" sem2=""/>всего</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дня</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="сторона" gr="S,f,gen,inan,norm,sg" sem="t:space r:concr pt:part pc:space" sem2="sc:hum t:space t:asp:ment r:abstr pt:set pc:x pt:part pc:space r:concr pc:form:geom"/>стороны</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="сторона" gr="S,acc,f,inan,norm,sg" sem="t:space r:concr pt:part pc:space" sem2="sc:hum t:space t:asp:ment r:abstr pt:set pc:x pt:part pc:space r:concr pc:form:geom"/>сторону</w> <w><ana lex="сновать" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus t:move d:root" sem2=""/>снуют</w> <w><ana lex="нарядный" gr="A,nom,norm,pl,plen" sem="dt:tool r:rel der:s dt:tool:cloth" sem2="dt:tool r:rel der:s dt:tool:cloth"/>нарядные</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="пестрый" gr="A,loc,norm,pl,plen" sem="t:physq:color r:qual" sem2="der:shift r:qual"/>пестрых</w> <w><ana lex="цветистый" gr="A,loc,norm,pl,plen" sem="dt:part d:habit der:s r:qual" sem2="t:physq:color dt:abstr dt:color der:s r:qual ev"/>цветистых</w> <w><ana lex="костюм" gr="S,inan,loc,m,norm,pl" sem="pt:set t:tool:cloth r:concr sc:tool:cloth hi:class" sem2="pt:set t:tool:cloth r:concr sc:tool:cloth"/>костюмах</w> <w><ana lex="монгол" gr="S,anim,m,nom,norm,pl" sem="" sem2=""/>монголы</w>.</se><se> <w>Говорят</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>сегодня</w>, <w>т</w>.<w>е</w>. <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="1" gr="NUM,ciph"/>1</w>-<w>й</w> <w><ana lex="день" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w> <w><ana lex="цаган" gr="S,anim,bastard,m,nom,sg" sem="t:hum r:propn t:persn" sem2=""/>Цаган-сара</w>, <w><ana lex="весь" gr="APRO,nom,norm,pl" sem="r:spec" sem2=""/>все</w> <w><ana lex="именитый" gr="A,nom,norm,pl,plen" sem="t:humq der:s r:qual" sem2=""/>именитые</w> <w><ana lex="монгол" gr="S,anim,m,nom,norm,pl" sem="" sem2=""/>монголы</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="поклонение" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr t:move:body" sem2=""/>поклонении</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="принесение" gr="S,inan,loc,n,norm,sg" sem="der:v t:move r:abstr" sem2=""/>принесении</w> <w><ana lex="новогодний" gr="A,gen,norm,pl,plen" sem="der:comp r:rel t:time" s