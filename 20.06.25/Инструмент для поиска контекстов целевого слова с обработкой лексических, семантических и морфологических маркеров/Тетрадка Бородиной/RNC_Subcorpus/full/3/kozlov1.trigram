<p><se><w><ana lex="вчера" gr="ADV,norm" sem="t:time" sem2=""/>Вчера</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>сегодня</w> <w><ana lex="делать" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="d:root" sem2="d:root"/>делал</w> <w><ana lex="патрон" gr="S,acc,inan,m,norm,pl" sem="t:tool:shell r:concr" sem2="t:tool top:cylinder pt:part top:tube r:concr pc:tool"/>патроны</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> «<w><ana lex="гано" gr="S,0,anim,bastard,m,persn" sem="t:hum r:propn t:famn" sem2=""/>Гано</w>» <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="иметь" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="ca:noncaus d:root t:poss" sem2="d:root"/>имел</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="неприятный" gr="A,m,nom,norm,plen,sg" sem="d:neg t:humq ev:neg r:qual" sem2="d:neg t:humq ev:neg r:qual"/>неприятный</w> <w><ana lex="разговор" gr="S,inan,m,nom,norm,sg" sem="t:speech r:abstr" sem2="t:speech der:shift r:abstr"/>разговор</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="мальчик" gr="S,anim,ins,m,norm,pl" sem="t:hum r:concr" sem2="t:hum r:concr"/>мальчиками</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="повод" gr="S,dat,inan,m,norm,sg" sem="der:v top:rope t:tool r:concr r:abstr" sem2=""/><ana lex="повод" gr="S,dat,inan,m,norm,sg" sem="der:v top:rope t:tool r:concr r:abstr" sem2=""/>поводу</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="называть" gr="V,gen,ipf,norm,partcp,pass,pl,plen,praes,tran" sem="t:speech der:v d:pref d:impf" sem2=""/>называемых</w> <w><ana lex="подъемные" gr="S,gen,inan,norm,pl" sem="pt:aggr:aggrpl sc:money der:a r:concr der:subst" sem2=""/>подъемных</w>.</se><se> <w><ana lex="мальчик" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr" sem2="t:hum r:concr"/>Мальчики</w> <w><ana lex="признат