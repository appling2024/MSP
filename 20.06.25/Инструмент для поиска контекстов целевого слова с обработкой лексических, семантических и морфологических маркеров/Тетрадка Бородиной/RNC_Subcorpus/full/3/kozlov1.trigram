<p><se><b/><w><b>18</b></w><b>/</b><w><ana lex="xi" gr="bastard" sem="" sem2=""/><b>XI</b></w><b>, </b><w><ana lex="q" gr="bastard" sem="" sem2=""/><b>Q</b></w><b/>. <w><ana lex="серый" gr="A,n,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>Серое</w>, <w><ana lex="облачный" gr="A,n,nom,norm,plen,sg" sem="r:rel der:s" sem2="t:physq r:rel der:s"/>облачное</w> <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утро</w>.</se><se> <w><ana lex="тихо" gr="ADV,norm" sem="dt:sound der:a" sem2="ev dt:sound der:a"/>Тихо</w>, <w><ana lex="кругом" gr="ADV,norm" sem="t:place der:s" sem2="der:s"/>кругом</w> <w>бело</w>.</se><se> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>На</w> <w><ana lex="пышный" gr="A,loc,m,norm,plen,sg" sem="t:qual" sem2="ev r:qual"/>пышном</w> <w><ana lex="снеговой" gr="A,loc,m,norm,plen,sg" sem="r:rel der:s" sem2=""/>снеговом</w> <w><ana lex="покров" gr="S,inan,loc,m,norm,sg" sem="t:stuff t:topon qc:stuff der:v r:propn pc:x r:concr" sem2="pt:aggr:aggrpl r:abstr t:inter der:v r:concr t:tool:bedding sc:tool:cloth"/>покрове</w> <w><ana lex="контрастно" gr="ADV,norm" sem="" sem2=""/>контрастно</w> <w><ana lex="выделяться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v d:pref" sem2=""/>выделяется</w> <w><ana lex="лесной" gr="A,f,nom,norm,plen,sg" sem="dt:space r:rel der:s" sem2=""/>лесная</w> <w><ana lex="зона" gr="S,f,inan,nom,norm,sg" sem="top:stripe t:space r:concr" sem2=""/>зона</w> <w><ana lex="священный" gr="A,gen,m,norm,plen,sg" sem="ev r:rel" sem2="r:rel"/>священного</w> <w><ana lex="массив" gr="S,gen,inan,m,norm,sg" sem="pt:set t:space r:concr sc:space" sem2="pt:set sc:constr:build t:space r:concr sc:plant"/>массива</w>, <w><ana lex="словно" gr="CONJ,norm" sem="" sem2=""/>словно</w> <w><ana lex="темный" gr="A,f,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq t:physq:color ev:neg r:qual"/>темная</w> <w><ana le