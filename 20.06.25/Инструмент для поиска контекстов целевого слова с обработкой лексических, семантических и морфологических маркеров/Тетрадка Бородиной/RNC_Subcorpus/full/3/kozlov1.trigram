<p><se><w><ana lex="холодновато" gr="ADV,norm" sem="der:adv d:atten ev:neg" sem2="der:adv d:atten ev:neg"/>Холодновато</w>, <w><ana lex="то" gr="SPRO,inan,ins,n,norm,sg" sem="r:dem" sem2=""/>тем</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="менее" gr="ADV,norm" sem="t:degr:min der:adv" sem2="t:degr:min der:adv"/>менее</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="надеяться" gr="V,1p,act,indic,intr,ipf,norm,praes,sg" sem="t:ment ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>надеюсь</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="экскурсия" gr="S,f,inan,nom,norm,sg" sem="t:action t:move r:abstr" sem2="t:group pt:set r:concr sc:hum"/>экскурсия</w> <w><ana lex="сделать" gr="V,3p,act,fut,indic,norm,pf,sg,tran" sem="d:pref" sem2=""/>сделает</w> <w><ana lex="все" gr="SPRO,acc,inan,n,norm,sg" sem="" sem2=""/>все</w> <w><ana lex="возможный" gr="A,acc,n,norm,plen,sg" sem="t:mod r:qual" sem2=""/>возможное</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="успешно" gr="ADV,norm" sem="ev:posit der:a" sem2=""/>успешно</w> <w><ana lex="выполнить" gr="V,3p,act,fut,indic,norm,pf,sg" sem="d:pref" sem2="d:pref"/>выполнит</w> <w><ana lex="задача" gr="S,acc,f,inan,norm,sg" sem="t:ment r:abstr" sem2="t:ment r:abstr"/>задачу</w> <w><ana lex="первый" gr="ANUM,gen,n,norm,sg" sem="r:ord der:num t:ord r:qual" sem2="ev:posit t:hier t:qual r:qual"/>первого</w> <w><ana lex="ознакомление" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr" sem2=""/>ознакомления</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="место" gr="S,inan,ins,n,norm,sg" sem="qc:space t:space r:concr" sem2="qc:space sc:org t:tool t:space pt:element r:abstr pt:aggr:aggrpl pt:part pc:text r:concr"/>местом</w> <w><ana lex="нахождение" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0 t:poss" sem2=""/>нахождения</w> <w><ana lex="интересный" gr="A,gen,norm,pl,plen" sem="dt:abstr der:s dt:ment r:qual" sem2="