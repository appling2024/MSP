<p><se><b/><w><b>10</b></w><b>/</b><w><ana lex="x" gr="bastard" sem="" sem2=""/><b>X</b></w><b>, </b><w><ana lex="s" gr="bastard" sem="" sem2=""/><b>S</b></w><b/>. <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w> <w><ana lex="полуясный" gr="A,bastard,n,nom,plen,sg" sem="" sem2=""/>полуясное</w>: <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="небо" gr="S,inan,loc,n,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/><ana lex="небо" gr="S,inan,loc,n,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/>небе</w> <w><ana lex="сплошь" gr="ADV,norm" sem="dt:degr:max der:a" sem2=""/>сплошь</w> <w><ana lex="тонко" gr="ADV,norm" sem="dt:size:min ev:posit der:a" sem2="dt:size:min ev der:a"/>тонко-перистые</w> <w><ana lex="облако" gr="S,inan,n,nom,norm,pl" sem="qc:stuff r:concr" sem2="qc:stuff pt:qtm top:form r:concr"/>облака</w>.</se><se> <w><ana lex="богдо" gr="ADV,bastard" sem="" sem2=""/>Богдо-ула</w> <w><ana lex="все" gr="SPRO,inan,n,nom,norm,sg" sem="" sem2=""/>все</w> <w><ana lex="еще" gr="ADV,norm" sem="" sem2=""/>еще</w> <w><ana lex="дремать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:physiol d:root" sem2=""/>дремлет</w> <w><ana lex="под" gr="PR,norm" sem="" sem2=""/>под</w> <w><ana lex="сень" gr="S,f,inan,ins,norm,sg" sem="sc:part pt:aggr t:space r:concr" sem2=""/>сенью</w> <w><ana lex="растительность" gr="S,f,gen,inan,norm,sg" sem="pt:aggr sc:plant r:concr hi:class" sem2="t:hair pc:hum pt:aggr r:concr sc:hair"/>растительности</w> (<w><ana lex="увядший" gr="A,f,gen,norm,plen,sg" sem="der:v r:rel" sem2=""/>увядшей</w>) <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="белый" gr="A,gen,m,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:race dt:physq:color der:shift r:qual t:species r:rel"/>белого</w> <w><ana lex="снего