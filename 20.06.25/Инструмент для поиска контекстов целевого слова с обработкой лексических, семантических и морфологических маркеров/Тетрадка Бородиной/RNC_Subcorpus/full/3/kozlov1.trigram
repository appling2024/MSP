"A,brev,f,norm,sg" sem="r:qual" sem2="der:shift r:qual"/>богата</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="библиотека" gr="S,f,inan,nom,norm,sg" sem="r:concr t:org" sem2="sc:book r:concr sc:text"/>библиотека</w> (<w><ana lex="путем" gr="PR,norm" sem="" sem2=""/>путем</w> <w><ana lex="обмен" gr="S,gen,inan,m,norm,sg" sem="der:v r:abstr der:s0 t:poss" sem2="der:v r:abstr t:inter"/>обмена</w>).</se><se> <w><ana lex="свой" gr="APRO,acc,inan,norm,pl" sem="r:poss" sem2="t:social r:poss"/>Свои</w> «<w><ana lex="записка" gr="S,acc,f,inan,norm,pl" sem="r:concr t:text" sem2="t:book r:concr t:text"/>Записки</w>» <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="количество" gr="S,inan,loc,n,norm,sg" sem="t:quant r:abstr" sem2="r:abstr"/>количестве</w> <w><ana lex="38" gr="NUM,ciph"/>38</w> <w><ana lex="том" gr="S,anim,gen,m,norm,persn,pl" sem="" sem2=""/><ana lex="том" gr="S,gen,inan,m,norm,pl" sem="pc:text r:concr t:text pt:part t:pers" sem2=""/>томов</w>.</se><se> <w><ana lex="предполагать" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="t:ment ca:noncaus der:v d:pref" sem2="t:ment ca:noncaus der:v d:pref"/>Предполагаю</w> <w><ana lex="большой" gr="A,n,nom,norm,plen,sg" sem="t:size:max r:qual" sem2="t:quant:max t:time:age t:degr:max r:qual"/>большое</w> <w><ana lex="содержание" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr der:s0" sem2="pt:set t:text r:abstr t:poss der:v pt:aggr sc:money pt:part pc:text r:concr"/>содержание</w> <w><ana lex="материал" gr="S,gen,inan,m,norm,pl" sem="t:stuff r:concr" sem2="t:stuff t:text hi:class r:abstr sc:doc r:concr"/>материалов</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="местный" gr="A,dat,m,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s"/>местному</w> <w><ana lex="край" gr="S,dat,inan,m,norm,sg" sem="t:space r:concr pc:x pt:part" sem2="t:space r:concr pt:part pc:space"/>краю</w>, <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="урал" gr="