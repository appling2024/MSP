<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="1" gr="NUM,ciph"/>1</w> <w><ana lex="час" gr="S,acc,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>час</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дня</w> <w><ana lex="отправиться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus t:move d:pref" sem2=""/>отправились</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="пастьба" gr="S,acc,f,inan,norm,sg" sem="r:abstr" sem2=""/>пастьбу</w> <w><ana lex="наш" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>наши</w> <w><ana lex="верблюд" gr="S,anim,m,nom,norm,pl" sem="t:animal r:concr" sem2=""/>верблюды</w>.</se><se> <w><ana lex="предполагать" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="t:ment ca:noncaus der:v d:pref" sem2="t:ment ca:noncaus der:v d:pref"/>Предполагали</w> <w><ana lex="это" gr="SPRO,acc,inan,n,norm,sg" sem="r:dem" sem2=""/>это</w> <w><ana lex="сделать" gr="V,act,inf,norm,pf,tran" sem="d:pref" sem2=""/>сделать</w> <w><ana lex="ранний" gr="A,ins,n,norm,plen,sg" sem="t:time r:qual" sem2="t:time r:qual"/>ранним</w> <w><ana lex="утро" gr="S,inan,ins,n,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утром</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="местный" gr="A,n,nom,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s"/>местное</w> <w><ana lex="гпу" gr="S,0,inan,n,norm,sg" sem="r:propn t:org" sem2=""/>ГПУ</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="внимательный" gr="A,brev,n,norm,sg" sem="t:humq r:qual" sem2="t:humq r:qual"/>внимательно</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="несообразительный" gr="A,brev,n,norm,sg" sem="d:neg t:humq der:a dt:humq r:qual" sem2=""/>несообразительно</w>, <w><ana lex="что" gr="SPRO,inan,n,nom,norm,sg" sem="r:rel" sem2=""/>что</w> <w><ana lex="продержать" gr="V,act,indic,n,norm,pf,praet,sg,tran" sem="d:pref" sem2=""/>продержало</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="1" gr="NUM,ciph"/>1</w>/<w><ana lex="2" gr="NUM,ciph"/>2</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дня</w>, <w><ana lex="да" gr="CONJ,norm" sem="" sem2=""/>да</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="то" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>то</w> <w><ana lex="благодаря" gr="PR,norm" sem="" sem2=""/>благодаря</w> <w><ana lex="настойчивость" gr="S,f,gen,inan,norm,sg" sem="r:abstr der:a" sem2=""/>настойчивости</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="энергия" gr="S,f,gen,inan,norm,sg" sem="r:abstr" sem2="r:abstr"/>энергии</w> <w><ana lex="кондратьев" gr="S,anim,famn,gen,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Кондратьева</w>.</se><se> <w><ana lex="глаголев" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Глаголев</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="помыт" gr="S,bastard,gen,inan,m,pl" sem="" sem2=""/><ana lex="помыт" gr="S,anim,bastard,gen,m,pl" sem="" sem2=""/>Помытов</w>, <w><ana lex="проводить" gr="V,act,ger,norm,pf,praet" sem="ca:caus t:move d:pref" sem2="d:pref"/><ana lex="проводить" gr="V,act,ger,ipf,norm,praet,tran" sem="ca:caus t:move d:pref" sem2="d:pref"/><ana lex="провести" gr="V,act,ger,norm,pf,praet,tran" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="проводить" gr="V,act,ger,ipf,norm,praet,tran" sem="ca:caus t:move d:pref" sem2="d:pref"/><ana lex="проводить" gr="V,act,ger,norm,pf,praet,tran" sem="ca:caus t:move d:pref" sem2="d:pref"/>проводив</w> <w><ana lex="верблюд" gr="S,acc,anim,m,norm,pl" sem="t:animal r:concr" sem2=""/>верблюдов</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="мост" gr="S,gen,inan,m,norm,sg" sem="top:horiz t:constr r:concr" sem2="t:tool t:space t:form r:abstr pc:tool:transp pt:part r:concr"/>моста</w> <w><ana lex="гэгэнский" gr="A,bastard,gen,m,plen,sg" sem="" sem2=""/><ana lex="гэгэнский" gr="A,bastard,gen,m,plen,sg" sem="" sem2=""/>гэгэнского</w>, <w><ana lex="затем" gr="ADV,norm" sem="der:apro t:time r:dem" sem2=""/>затем</w> <w><ana lex="повернуть" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v d:pref"/><ana lex="повернуть" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v d:pref"/><ana lex="поворотить" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2=""/>повернули</w> <w><ana lex="домой" gr="ADV,norm" sem="der:s t:dir" sem2=""/>домой</w>.</se></p>
<p><se><w>Грустно</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w>больно</w> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="видеть" gr="V,act,inf,ipf,norm,tran" sem="ca:noncaus t:perc d:root" sem2="t:ment ca:noncaus d:root"/>видеть</w> <w><ana lex="расставание" gr="S,acc,inan,n,norm,sg" sem="der:v r:abstr" sem2=""/>расставание</w> <w><ana lex="савельев" gr="S,anim,famn,gen,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Савельева</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="телешов" gr="S,anim,bastard,famn,ins,m,sg" sem="t:hum r:propn t:famn" sem2=""/>Телешовым</w>.</se><se> <w><ana lex="прощаться" gr="V,act,ger,intr,ipf,norm,praes" sem="der:v ca:noncaus d:pref" sem2=""/>Прощаясь</w> <w><ana lex="со" gr="PR,norm" sem="" sem2=""/>со</w> <w><ana lex="я" gr="SPRO,1p,ins,norm,sg" sem="r:pers" sem2=""/>мною</w>, <w><ana lex="телешка" gr="S,anim,bastard,m,nom,persn,sg" sem="" sem2=""/>Телешка</w>, <w><ana lex="указать" gr="V,act,ger,norm,pf,praet" sem="der:v" sem2="der:v"/>указав</w> <w><ana lex="рука" gr="S,f,inan,ins,norm,sg" sem="pt:partb r:concr pc:hum" sem2="sc:hum t:asp r:abstr pt:aggr:aggrpl t:dir r:concr"/>рукою</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="сторона" gr="S,acc,f,inan,norm,sg" sem="t:space r:concr pt:part pc:space" sem2="sc:hum t:space t:asp:ment r:abstr pt:set pc:x pt:part pc:space r:concr pc:form:geom"/>сторону</w> <w><ana lex="савельев" gr="S,anim,famn,gen,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Савельева</w>, <w><ana lex="сам" gr="APRO,m,nom,norm,sg" sem="r:spec" sem2=""/>сам</w> <w><ana lex="заплакать" gr="V,act,indic,m,norm,pf,praet,sg,tran" sem="ca:noncaus t:physiol d:pref" sem2=""/>заплакал</w>.</se></p>
<p><se><w>Итак</w>, <w><ana lex="обречь" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="der:v d:pref" sem2=""/>обречены</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="ожидание" gr="S,acc,inan,n,norm,sg" sem="t:ment der:v r:abstr der:s0" sem2="t:ment r:abstr"/>ожидание</w> <w><ana lex="будущее" gr="S,gen,inan,n,norm,sg" sem="der:v der:subst r:abstr t:time" sem2="der:v der:subst r:abstr t:time"/>будущего</w>.</se><se> <w><ana lex="завтра" gr="ADV,norm" sem="t:time" sem2=""/>Завтра-послезавтра</w>, <w>вероятно</w>, <w><ana lex="что" gr="SPRO,acc,inan,n,norm,sg" sem="r:rel" sem2=""/><ana form="что-либо" lex="что-либо" gr="SPRO,acc,inan,n,norm,sg" sem="r:indet" sem2=""/>что-либо</w> <w><ana lex="получить" gr="V,1p,act,fut,indic,norm,pf,pl" sem="ca:noncaus t:poss" sem2=""/><ana lex="получить" gr="V,1p,act,imper,norm,pf,pl" sem="ca:noncaus t:poss" sem2=""/>получим</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="центр" gr="S,gen,inan,m,norm,sg" sem="t:space r:concr pc:form:geom pt:part" sem2="pc:org t:space pc:hum pc:animal t:org pt:set pt:partb:organ pc:x pt:part sc:cell2 r:concr"/>Центра</w>.</se><se> <w><ana lex="ужель" gr="PART,norm" sem="" sem2=""/>Ужель</w> <w><ana lex="назначить" gr="V,3p,act,fut,indic,norm,pf,pl" sem="d:pref" sem2="d:pref"/>назначат</w> <w><ana lex="кто" gr="SPRO,acc,anim,m,norm,sg" sem="r:rel" sem2=""/>кого-либо</w> <w><ana lex="взамен" gr="PR,norm" sem="" sem2=""/>взамен</w> <w><ana lex="отставить" gr="V,gen,norm,partcp,pass,pf,pl,plen,praet" sem="ca:caus t:move d:pref" sem2="d:pref"/>отставленных</w>?</se></p>
<p><se><w><ana lex="прямо" gr="ADV,norm" sem="ev:posit dt:physq:form t:dir der:a" sem2="dt:physq:form der:a"/>Прямо</w> <w>нет</w> <w><ana lex="сила" gr="S,f,gen,inan,norm,pl" sem="sc:hum t:pers r:abstr pt:aggr:aggrpl t:param r:concr" sem2="pt:aggr sc:hum ev:posit t:quant:max pt:qtm r:abstr pt:aggr:aggrpl der:shift r:concr"/>сил</w> <w><ana lex="смотреть" gr="V,act,inf,ipf,norm,tran" sem="ca:noncaus d:pref t:perc" sem2="ca:noncaus d:pref t:perc"/>смотреть</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="далекий" gr="A,acc,inan,norm,pl,plen" sem="t:dist:max r:qual" sem2="dt:dist:max der:shift t:time t:humq r:qual"/>далекие</w>, <w><ana lex="южный" gr="A,acc,inan,norm,pl,plen" sem="t:place dt:space r:rel der:s" sem2=""/>южные</w>, <w><ana lex="манить" gr="V,acc,act,inan,ipf,norm,partcp,pl,plen,praes,tran" sem="d:root" sem2="d:root"/>манящие</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="себе" gr="SPRO,loc,norm" sem="" sem2=""/>себе</w> <w><ana lex="гора" gr="S,acc,f,inan,norm,pl" sem="top:hill t:space r:concr" sem2="sc:x pt:set t:space t:form r:abstr t:quant:max r:concr"/>горы</w>.</se><se> <w>Кажется</w>, <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="совершенно" gr="ADV,norm" sem="dt:degr:max t:degr:max der:a" sem2=""/>совершенно</w> <w><ana lex="извериться" gr="V,1p,act,fut,indic,intr,norm,pf,sg" sem="ca:noncaus d:pref t:psych" sem2=""/>изверюсь</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="человек" gr="S,anim,loc,m,norm,pl" sem="t:hum r:concr" sem2="t:hum ev:posit r:concr"/>людях</w>.</se></p>
<p><se><w><ana lex="вечер" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечером</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="цокто" gr="S,0,anim,bastard,m,sg" sem="t:hum r:propn t:persn" sem2=""/>Цокто</w> <w><ana lex="гармаевич" gr="S,anim,bastard,gen,m,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Гармаевича</w> <w><ana lex="собраться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2="ca:noncaus d:pref t:psych:volit"/>собрался</w> <w><ana lex="кружок" gr="S,inan,m,nom,norm,sg" sem="d:dim t:form top:circle r:concr der:s" sem2="t:group pt:set sc:hum pt:aggr der:s d:dim r:concr"/>кружок</w> <w><ana lex="знакомый" gr="S,anim,gen,m,norm,pl" sem="der:v t:hum r:concr der:subst" sem2=""/>знакомых</w> <w><ana lex="при" gr="PR,norm" sem="" sem2=""/>при</w> <w><ana lex="наличие" gr="S,inan,loc,n,norm,sg" sem="t:be:exist r:abstr" sem2=""/>наличии</w> <w><ana lex="три" gr="NUM,gen,norm" sem="r:card:pauc" sem2=""/>трех</w> <w><ana lex="мой" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/>моих</w> <w><ana lex="спутник" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,gen,inan,m,norm,pl" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутников</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="певец" gr="S,anim,gen,m,norm,pl" sem="der:v t:hum r:concr d:nag t:prof" sem2="der:v t:hum r:concr d:nag t:prof"/>певцов</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="певица" gr="S,anim,f,gen,norm,pl" sem="t:hum d:fem r:concr der:s" sem2=""/>певиц</w> -- <w><ana lex="монгол" gr="S,anim,gen,m,norm,pl" sem="" sem2=""/>монголов</w>.</se><se> <w><ana lex="исполняться" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="der:v d:pref" sem2=""/>Исполнялись</w> <w><ana lex="монгольский" gr="A,acc,inan,norm,pl,plen" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>монгольские</w> <w><ana lex="песнь" gr="S,