<p><se><w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="заключение" gr="S,acc,inan,n,norm,sg" sem="t:put der:v r:abstr der:s0" sem2="t:text t:ment:result t:put pt:phase r:abstr der:v pc:workmus pt:part pc:text r:concr"/>заключение</w> <w><ana lex="петь" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="d:root" sem2="d:root"/>пели</w> <w><ana lex="бурятка" gr="S,anim,f,nom,norm,pl" sem="" sem2=""/>бурятки</w>, <w><ana lex="неважный" gr="A,brev,n,norm,sg" sem="" sem2="d:neg ev:neg t:quality r:qual"/>неважно</w>, <w><ana lex="некрасивый" gr="A,brev,n,norm,sg" sem="d:neg der:a dt:qual r:qual t:appearance ev:neg" sem2=""/>некрасиво</w>.</se><se> <w><ana lex="этот" gr="APRO,acc,inan,m,norm,sg" sem="r:dem" sem2=""/>Этот</w> <w><ana lex="отдел" gr="S,acc,inan,m,norm,sg" sem="r:concr pt:part hi:class" sem2="pc:org t:text pt:set sc:hum pt:part pc:text r:concr"/>отдел</w> <w><ana lex="великолепно" gr="ADV,norm" sem="ev:posit dt:quality der:a" sem2=""/>великолепно</w> <w><ana lex="закончить" gr="V,act,f,indic,norm,pf,praet,sg" sem="der:v d:pref" sem2=""/>закончила</w> <w><ana lex="супруг" gr="S,acc,anim,m,norm,sg" sem="" sem2=""/>супруга</w> <w><ana lex="ринчина" gr="S,acc,bastard,inan,m,sg" sem="" sem2=""/>Ринчино</w> (<w><ana lex="корейка" gr="S,f,inan,nom,norm,sg" sem="t:food t:stuff r:concr hi:sort" sem2=""/>корейка</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="рождение" gr="S,dat,inan,n,norm,sg" sem="der:v r:abstr der:s0 t:be:appear" sem2="der:shift t:time:moment r:abstr"/>рождению</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="русский" gr="A,f,nom,norm,plen,sg" sem="dt:topon r:rel der:s t:topon" sem2=""/>русская</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="воспитание" gr="S,dat,inan,n,norm,sg" sem="der:v r:abstr der:s0" sem2="r:abstr"/>воспитанию</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="образование" gr="S,dat,inan,n,norm,sg" sem="der:v r:abstr der:s0 t:be:appear"