<p><se><b/><w><b>14</b></w><b>/</b><w><ana lex="xii" gr="bastard" sem="" sem2=""/><b>XII</b></w><b>, </b><w><ana lex="t" gr="bastard" sem="" sem2=""/><b>T</b></w><b/>. <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w>, <w><ana lex="даже" gr="CONJ,norm" sem="" sem2=""/>даже</w> <w><ana form="по-старому" lex="по-старому" gr="ADV,norm" sem="dt:time:age ev der:a" sem2=""/>по-старому</w>, <w><ana lex="декабрь" gr="S,inan,m,nom,norm,sg" sem="t:time:month r:abstr" sem2=""/>декабрь</w> <w><ana lex="месяц" gr="S,inan,m,nom,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:space t:astr t:time:period r:abstr top:form r:concr t:fam"/>месяц</w>, <w><ana lex="первый" gr="ANUM,n,nom,norm,sg" sem="r:ord der:num t:ord r:qual" sem2="ev:posit t:hier t:qual r:qual"/>первое</w> <w><ana lex="число" gr="S,inan,n,nom,norm,sg" sem="r:abstr" sem2="pt:set der:shift r:abstr t:time"/>число</w>, <w><ana lex="зима" gr="S,f,inan,nom,norm,sg" sem="t:time:season r:abstr t:time" sem2="t:fam"/>зима</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="полный" gr="A,loc,m,norm,plen,sg" sem="t:content r:qual" sem2="t:degr t:appearance r:qual"/>полном</w> <w><ana lex="разгар" gr="S,inan,loc,m,norm,sg" sem="r:abstr" sem2="pt:phase r:abstr"/>разгаре</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="снег" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2=""/>снега</w> <w><ana lex="гораздо" gr="ADV,norm" sem="t:degr:max" sem2=""/>гораздо</w> <w>больше</w> <w><ana lex="обыкновенный" gr="A,gen,n,norm,plen,sg" sem="r:rel" sem2=""/>обыкновенного</w> (<w><ana lex="средний" gr="A,gen,n,norm,plen,sg" sem="t:degr r:qual" sem2="r:qual r:rel t:humq t:size"/>среднего</w>).</se><se> <w>Ясно</w>, <w>холодно</w>, <w><ana lex="монотонно" gr="ADV,norm" sem="der:a dt:sound ev:neg" sem2=""/>монотонно</w>.</se><se> <w><ana lex="священный" gr="A,f,nom,norm,plen,sg" sem="ev r:rel" sem2="r:rel"/>Священная</w> <w><ana lex="соседка" gr="S,anim,f,n