<p><se><b/><w><b>19</b></w><b>/</b><w><ana lex="i" gr="bastard" sem="" sem2=""/><b>I</b></w><b>, </b><w><ana lex="w" gr="bastard" sem="" sem2=""/><b>W</b></w><b/>. <w><ana lex="барометр" gr="S,inan,m,nom,norm,sg" sem="der:comp t:tool:device:measur:metr r:concr" sem2="r:abstr"/>Барометр</w> <w><ana lex="пойти" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/>пошел</w> <w><ana lex="вверх" gr="ADV,norm" sem="der:s t:dir" sem2="der:s"/>вверх</w>, <w><ana lex="ветер" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>ветер</w> <w>северо-северо-западный</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="результат" gr="S,inan,loc,m,norm,sg" sem="r:abstr" sem2="r:abstr"/>результате</w> <w><ana lex="мороз" gr="S,anim,famn,m,nom,norm,sg" sem="" sem2=""/><ana lex="мороз" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:temper" sem2="t:fam r:abstr t:weather"/>мороз</w> -<w><ana lex="24.1" gr="NUM,ciph"/>24.1</w>°<w><ana lex="r" gr="bastard" sem="" sem2=""/>R</w>.</se></p>
