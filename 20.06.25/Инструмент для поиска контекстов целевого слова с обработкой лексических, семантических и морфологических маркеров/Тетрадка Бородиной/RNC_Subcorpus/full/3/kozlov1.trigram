<p><se><b/><w><b>25</b></w><b>/</b><w><ana lex="xi" gr="bastard" sem="" sem2=""/><b>XI</b></w><b>, </b><w><ana lex="q" gr="bastard" sem="" sem2=""/><b>Q</b></w><b/>. <w><ana lex="серый" gr="A,n,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>Серое</w>, <w><ana lex="белый" gr="A,n,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:race dt:physq:color der:shift r:qual t:species r:rel"/>белое</w>, <w><ana lex="чувствительный" gr="A,brev,n,norm,sg" sem="der:v dt:perc t:humq d:habit r:qual" sem2="dt:perc t:degr t:humq d:potent der:v r:qual"/>чувствительно</w> <w><ana lex="морозный" gr="A,n,nom,norm,plen,sg" sem="dt:temper dt:abstr t:physq:temper r:rel der:s" sem2=""/>морозное</w> <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утро</w>.</se><se> <w><ana lex="ветер" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>Ветер</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w>ЮВ</w> <w><ana lex="пронзительный" gr="A,m,nom,norm,plen,sg" sem="der:v t:sound dt:impact r:qual" sem2="der:v der:shift dt:impact r:qual"/>пронзительный</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="долина" gr="S,f,inan,loc,norm,sg" sem="t:space r:concr der:s t:fam" sem2=""/>долине</w> <w><ana lex="тола" gr="S,f,gen,inan,norm,sg" sem="" sem2=""/>Толы</w> <w><ana lex="стужа" gr="S,f,inan,nom,norm,sg" sem="r:abstr t:temper" sem2=""/>стужа</w> <w><ana lex="адский" gr="A,f,nom,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space der:s t:degr:max r:qual"/>адская</w>.</se><se> <w><ana lex="мой" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>Мой</w> <w><ana lex="друг" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr" sem2="t:hum r:concr"/>друг</w> <w><ana lex="узко" gr="ADV,comp,norm" sem="dt:size:min der:a" sem2="dt:size:min der:a"/><ana lex="уже" gr="ADV,norm" sem="t:time" sem2=""/>уже</w> <w><ana lex="катить" gr="V,3p,act,indic,ipf,norm,p