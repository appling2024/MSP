<p><se><b/><w><b>2</b></w><b>/</b><w><ana lex="viii" gr="bastard" sem="" sem2=""/><b>VIII</b></w><b>, </b><w><ana lex="v" gr="bastard" sem="" sem2=""/><b>V</b></w><b/>. <w><ana lex="весь" gr="APRO,acc,inan,m,norm,sg" sem="r:spec" sem2=""/>Весь</w> <w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w> <w><ana lex="провести" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="провести" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="проводить" gr="V,act,indic,norm,pf,pl,praet" sem="ca:caus t:move d:pref" sem2="d:pref"/>провели</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="екатеринбург" gr="S,inan,loc,m,norm,sg" sem="r:propn t:topon" sem2=""/>Екатеринбурге</w>.</se><se> <w><ana lex="глаголев" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Глаголев</w> <w><ana lex="хлопотать" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="d:root" sem2="d:root"/>хлопотал</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="бумага" gr="S,f,inan,ins,norm,pl" sem="t:stuff r:concr" sem2="t:stuff r:concr t:text"/>бумагами</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="поезд" gr="S,inan,ins,m,norm,sg" sem="sc:tool:transp t:tool:transp r:concr" sem2="pt:set sc:tool:transp r:concr"/>поездом</w>.</se><se> <w><ana lex="мальчик" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr" sem2="t:hum r:concr"/>Мальчики</w> (<w><ana lex="спутник" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,inan,m,nom,norm,pl" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутники</w>) <w><ana lex="осматривать" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="der:v d:impf d:pref t:perc" sem2=""/>осматривали</w> <w><ana lex="уральский" gr="A,m,nom,norm,plen,sg" sem="r:rel t:topon" sem2=""/>Уральский</