<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <b/><w><ana lex="v" gr="bastard" sem="" sem2=""/><b>V</b></w><b/>, <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="8" gr="NUM,ciph"/>8</w>-<w>й</w> <w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w>, <w><ana lex="как" gr="CONJ,norm" sem="" sem2=""/>как</w> <w><ana lex="укатить" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="укатить" gr="V,act,indic,intr,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/>укатили</w> <w><ana lex="наш" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>наши</w> «<w><ana lex="отозвать" gr="V,nom,norm,partcp,pass,pf,pl,plen,praet" sem="t:speech ca:caus der:v d:pref" sem2="der:v d:pref"/><ana lex="отозвать" gr="V,intr,nom,norm,partcp,pass,pf,pl,plen,praet" sem="t:speech ca:caus der:v d:pref" sem2="der:v d:pref"/>отозванные</w>», <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="ответ" gr="S,gen,inan,m,norm,sg" sem="t:speech r:abstr" sem2="t:text r:concr r:abstr t:speech pc:text pt:addit"/>ответа</w> <w><ana lex="еще" gr="ADV,norm" sem="" sem2=""/>еще</w> <w>нет</w>.</se><se> <w><ana lex="думать" gr="V,1p,act,indic,intr,ipf,norm,praes,sg" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/><ana lex="думать" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/>Думаю</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="быстро" gr="ADV,norm" sem="dt:speed:max ev der:a" sem2="t:speed:max dt:speed:max ev der:a"/>быстро</w> <w><ana lex="они" gr="SPRO,3p,nom,norm,pl" sem="r:pers" sem2=""/>они</w> <w><ana lex="ехать" gr="V,act,inf,intr,ipf,norm" sem="ca:noncaus t:move d:root" sem2="d:root"/>ехать</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w