<p><se><b/><w><b>19</b></w><b>/</b><w><ana lex="ii" gr="bastard" sem="" sem2=""/><b>II</b></w><b>, </b><w><ana lex="u" gr="bastard" sem="" sem2=""/><b>U</b></w><b/>. <w><ana lex="серо" gr="ADV,norm" sem="dt:physq:color der:a ev:neg" sem2="dt:physq:color der:a ev:neg"/>Серо</w>, <w>холодно</w>, <w><ana lex="дать" gr="V,act,indic,norm,pf,pl,praet" sem="ca:caus d:root t:poss" sem2="d:root"/>дали</w> <w><ana lex="скрыть" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="d:pref" sem2="d:pref"/>скрыты</w>.</se><se> <w><ana lex="все" gr="SPRO,inan,n,nom,norm,sg" sem="" sem2=""/>Все</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w> <w>надо</w> <w><ana lex="надеяться" gr="V,act,inf,intr,ipf,norm" sem="t:ment ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>надеяться</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="через" gr="PR,norm" sem="" sem2=""/>через</w> <w><ana lex="месяц" gr="S,acc,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:space t:astr t:time:period r:abstr top:form r:concr t:fam"/>месяц</w> <w><ana lex="солнышко" gr="S,inan,n,nom,norm,sg" sem="t:space t:astr top:spher top:horiz der:s d:dim r:concr" sem2=""/>солнышко</w> <w><ana lex="монголия" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Монголии</w> <w><ana lex="улыбнуться" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="der:v ca:noncaus" sem2="der:v ca:noncaus"/>улыбнется</w> <w><ana lex="мы" gr="SPRO,1p,dat,norm,pl" sem="r:pers" sem2=""/>нам</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w>, <w>несмотря</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="еще" gr="ADV,norm" sem="" sem2=""/>еще</w> <w><ana lex="больший" gr="A,acc,f,norm,plen,sg" sem="d:compar t:size:max der:a dt:size:max r:qual" sem2=""/><ana lex="большой" gr="A,acc,f,norm,plen,sg" sem="t:size:max r:qual" sem2="t:quant:max t:time:age t:degr:max r:qual"/>большую</w> <w><ana lex="весенний" gr="A,acc,f,norm,plen,sg" sem="dt:time dt:abstr dt:time:season der:s t:time r:rel" sem2