<p><se><w><ana lex="вечер" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечером</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="милый" gr="A,gen,norm,pl,plen" sem="t:humq r:qual" sem2="ev:posit t:social:emot r:qual"/>милых</w> <w><ana lex="яковлев" gr="S,anim,famn,gen,m,norm,pl" sem="t:hum r:propn t:famn" sem2=""/>Яковлевых</w>; <w><ana lex="олечка" gr="S,anim,f,nom,norm,persn,sg" sem="dt:persn t:persn d:dimb r:propn der:s t:hum" sem2=""/>Олечка</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="другой" gr="APRO,nom,norm,pl" sem="r:spec" sem2="r:ord r:spec r:indet"/>другие</w>.</se><se> <w><ana lex="бедный" gr="A,f,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>Бедная</w> <w><ana lex="танечка" gr="S,anim,f,nom,norm,persn,sg" sem="dt:persn t:persn d:dimb r:propn der:s t:hum" sem2=""/>Танечка</w> -- <w><ana lex="безнадежный" gr="A,f,nom,norm,plen,sg" sem="der:s:deverb d:carit dt:abstr r:rel dt:psych" sem2="der:s:deverb d:carit dt:abstr r:rel dt:psych"/>безнадежная</w> <w><ana lex="мечта" gr="S,f,inan,nom,norm,sg" sem="t:ment r:abstr" sem2="t:ment ev:posit r:abstr"/>мечта</w>!</se></p>
