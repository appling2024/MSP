<p><se><b/><w><b>21</b></w><b>/</b><w><ana lex="ii" gr="bastard" sem="" sem2=""/><b>II</b></w><b>, </b><w><ana lex="v" gr="bastard" sem="" sem2=""/><b>V</b></w><b/>. <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w> <w><ana lex="серый" gr="A,n,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>серое</w>, <w><ana lex="ветреный" gr="A,n,nom,norm,plen,sg" sem="r:rel der:s d:habit" sem2="t:humq der:s ev:neg r:qual"/>ветреное</w>, <w><ana lex="холодный" gr="A,n,nom,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодное</w>.</se><se> <w>Юго-юго-восточный</w> <w><ana lex="ветер" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>ветер</w> <w><ana lex="принести" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus ca:0 d:pref"/>принес</w> <w><ana lex="сплошной" gr="A,acc,f,norm,plen,sg" sem="r:rel der:adv" sem2="der:adv r:rel t:degr:max r:qual"/>сплошную</w> <w><ana lex="облачность" gr="S,acc,f,inan,norm,sg" sem="r:abstr der:a" sem2="qc:stuff pt:aggr t:stuff r:concr sc:qtm"/>облачность</w>.</se><se> <w><ana lex="геранец" gr="S,anim,bastard,gen,m,pl" sem="" sem2=""/>Геранцев</w> <w><ana lex="возвратить" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus d:pref t:poss" sem2=""/>возвратил</w> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w> <w><ana lex="письмо" gr="S,acc,inan,n,norm,sg" sem="r:concr t:text" sem2="pt:aggr t:asp r:concr r:abstr sc:letter"/>письмо</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="имя" gr="S,acc,inan,n,norm,sg" sem="r:concr r:abstr t:name" sem2="t:word der:shift r:concr r:abstr t:name"/>имя</w> <w><ana lex="мой" gr="APRO,f,gen,norm,sg" sem="r:poss" sem2=""/>моей</w> <w><ana lex="пше