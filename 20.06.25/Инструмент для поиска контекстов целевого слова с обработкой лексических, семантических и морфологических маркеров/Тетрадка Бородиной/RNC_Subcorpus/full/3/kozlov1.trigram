<p><se><w>Теперь</w> <w><ana lex="оставаться" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="d:pref" sem2=""/>оставалось</w> <w><ana lex="собираться" gr="V,act,inf,intr,ipf,norm" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref t:psych:volit"/>собираться</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="обед" gr="S,acc,inan,m,norm,sg" sem="r:abstr" sem2="t:food sc:food r:abstr pt:aggr t:time r:concr"/>обед</w>, <w><ana lex="как" gr="CONJ,norm" sem="" sem2=""/>как</w> <w><ana lex="вдруг" gr="ADV,norm" sem="" sem2=""/>вдруг</w> <w><ana lex="неурочно" gr="ADV,norm" sem="der:a" sem2=""/>неурочно</w> <w><ana lex="объявиться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus d:pref" sem2=""/>объявился</w> <w><ana lex="убугунов" gr="S,anim,bastard,famn,m,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Убугунов</w>, <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="дорога" gr="S,dat,f,inan,norm,sg" sem="top:stripe t:space r:concr t:fam" sem2="t:move dt:space r:abstr der:shift t:space r:concr"/>дороге</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="юдин" gr="S,acc,anim,famn,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Юдина</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="сообщить" gr="V,act,indic,m,norm,pf,praet,sg" sem="t:speech ca:noncaus d:pref" sem2="d:pref"/>сообщил</w> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="неприятный" gr="A,n,nom,norm,plen,sg" sem="d:neg t:humq ev:neg r:qual" sem2="d:neg t:humq ev:neg r:qual"/>неприятное</w> <w><ana lex="известие" gr="S,inan,n,nom,norm,sg" sem="t:speech r:abstr" sem2="der:v r:propn r:concr t:text t:media"/>известие</w>, <w><ana lex="прийти" gr="V,act,intr,n,nom,norm,partcp,pf,plen,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/><ana lex="придти" gr="V,act,intr,n,nom,norm,partcp,pf,plen,praet,sg" sem="" sem2=""/>пришедшее</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="центр" gr="S,gen,inan,m,norm,sg" sem="t:space r:concr pc:form:geom pt:part" sem2="pc:org t:space pc:hum pc:animal t:org pt:set pt:partb:organ pc:x pt:part sc:cell2 r:concr"/>Центра</w> <w><ana lex="россия" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>России</w>, <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="гпу" gr="S,0,inan,n,norm,sg" sem="r:propn t:org" sem2=""/>ГПУ</w>.</se><se> <w><ana lex="новый" gr="A,n,nom,norm,plen,sg" sem="t:time r:qual" sem2="t:time r:qual"/>Новое</w> <w><ana lex="недоразумение" gr="S,inan,n,nom,norm,sg" sem="r:abstr" sem2="r:abstr t:inter"/>недоразумение</w> -- <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="выпускать" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="der:v t:move d:pref" sem2=""/>выпускают</w> <w><ana lex="далекий" gr="A,comp,norm,plen" sem="t:dist:max r:qual" sem2="dt:dist:max der:shift t:time t:humq r:qual"/>дальше</w> <w><ana lex="урга" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Урги</w> <w><ana lex="мой" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/>моих</w> <w><ana lex="три" gr="NUM,gen,norm" sem="r:card:pauc" sem2=""/>трех</w> <w><ana lex="спутник" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,gen,inan,m,norm,pl" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутников</w>: <w><ana lex="глаголева" gr="S,anim,f,famn,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Глаголева</w>, <w><ana lex="савельева" gr="S,anim,f,famn,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Савельева</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="саранцева" gr="S,anim,f,famn,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Саранцева</w>.</se><se> <w><ana lex="лишиться" gr="V,act,inf,intr,norm,pf" sem="ca:noncaus t:poss" sem2=""/>Лишиться</w> <w><ana lex="сергей" gr="S,acc,anim,m,norm,persn,sg" sem="