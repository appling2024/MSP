ем" gr="ADV,norm" sem="t:degr:max der:apro" sem2="t:degr:min der:apro"/>совсем</w> <w>нет</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="когда" gr="CONJ,norm" sem="" sem2=""/>когда</w> <w><ana lex="объявиться" gr="V,3p,act,fut,indic,intr,norm,pf,pl" sem="ca:noncaus d:pref" sem2=""/>объявятся</w> <w><ana lex="первый" gr="ANUM,nom,norm,pl" sem="r:ord der:num t:ord r:qual" sem2="ev:posit t:hier t:qual r:qual"/>первые</w> <w><ana lex="вестник" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr der:s" sem2=""/><ana lex="вестник" gr="S,inan,m,nom,norm,pl" sem="" sem2="r:concr t:text"/>вестники</w> -- <w><ana lex="пролетный" gr="A,nom,norm,pl,plen" sem="der:v r:rel dt:move" sem2="dt:move dt:space der:v der:s:deverb t:place r:rel"/>пролетные</w> <w><ana lex="птица" gr="S,anim,f,nom,norm,pl" sem="t:animal r:concr hi:class" sem2=""/>птицы</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="северный" gr="A,f,loc,norm,plen,sg" sem="t:place dt:space r:rel der:s" sem2=""/>Северной</w> <w><ana lex="монголия" gr="S,f,inan,loc,norm,sg" sem="r:propn t:topon" sem2=""/>Монголии</w> -- <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w>известно</w>!</se></p>
