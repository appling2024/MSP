<p><se><b/><w><b>13</b></w><b>/</b><w><ana lex="xi" gr="bastard" sem="" sem2=""/><b>XI</b></w><b>, </b><w><ana lex="u" gr="bastard" sem="" sem2=""/><b>U</b></w><b/>. <w><ana lex="полуясный" gr="A,bastard,n,nom,plen,sg" sem="" sem2=""/>Полуясное</w>, <w><ana lex="холодный" gr="A,n,nom,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодное</w> <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утро</w>.</se><se> <w><ana lex="постепенно" gr="ADV,norm" sem="der:a" sem2=""/>Постепенно</w>, <w><ana lex="исподволь" gr="ADV,norm" sem="" sem2=""/>исподволь</w> <w><ana lex="надвигаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v d:pref" sem2=""/>надвигается</w> <w><ana lex="зима" gr="S,f,inan,nom,norm,sg" sem="t:time:season r:abstr t:time" sem2="t:fam"/>зима</w>.</se><se> <w><ana lex="однако" gr="CONJ,norm" sem="" sem2=""/>Однако</w> <w><ana lex="день" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>днем</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="солнце" gr="S,inan,loc,n,norm,sg" sem="top:horiz top:spher t:astr t:space r:concr" sem2="ev:posit t:space r:concr r:abstr t:light"/>солнце</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w>тепло</w>, <w><ana lex="таять" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:changest d:root ca:noncaus" sem2="d:root"/>тает</w>, <w><ana lex="хотя" gr="CONJ,norm" sem="" sem2=""/>хотя</w> <w><ana lex="здесь" gr="ADVPRO,norm" sem="t:place r:dem" sem2="t:time r:dem"/>здесь</w> <w><ana lex="при" gr="PR,norm" sem="" sem2=""/>при</w> <w><ana lex="крайний" gr="A,dat,f,norm,plen,sg" sem="dt:space t:dist r:rel der:s t:ord" sem2="dt:space t:degr:max:magn r:rel der:s r:qual"/>крайней</w> <w><ana lex="сухость" gr="S,dat,f,inan,norm,sg" se