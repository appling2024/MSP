<p><se><w><ana lex="забыть" gr="V,act,indic,m,norm,pf,praet,sg" sem="t:ment ca:noncaus" sem2=""/>Забыл</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="отметить" gr="V,act,inf,norm,pf" sem="d:pref" sem2="d:pref"/>отметить</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="во" gr="PR,norm" sem="" sem2=""/>во</w> <w><ana lex="время" gr="S,acc,inan,n,norm,sg" sem="r:abstr t:param t:time" sem2="t:time:period r:abstr t:time"/>время</w> <w><ana lex="праздник" gr="S,gen,inan,m,norm,pl" sem="t:action r:abstr" sem2="r:abstr"/>праздников</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="наблюдать" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="ca:noncaus d:pref t:perc" sem2="d:pref"/>наблюдал</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="морозный" gr="A,loc,m,norm,plen,sg" sem="dt:temper dt:abstr t:physq:temper r:rel der:s" sem2=""/>морозном</w> <w><ana lex="воздух" gr="S,inan,loc,m,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>воздухе</w> <w><ana lex="открытый" gr="A,acc,inan,m,norm,plen,sg" sem="der:v r:qual" sem2="t:physq:form ev:posit t:humq r:rel der:v r:qual der:shift:v"/>открытый</w> <w><ana lex="китайский" gr="A,acc,inan,m,norm,plen,sg" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>китайский</w> <w><ana lex="театр" gr="S,acc,inan,m,norm,sg" sem="r:abstr" sem2="t:space top:contain t:org r:abstr pt:aggr r:phras t:constr:build r:concr sc:text"/>театр</w>.</se><se> <w><ana lex="исполнитель" gr="S,anim,m,nom,norm,pl" sem="der:v t:hum r:concr d:nag" sem2="der:v t:hum r:concr d:nag"/>Исполнители</w> -- <w><ana lex="монгол" gr="S,anim,m,nom,norm,pl" sem="" sem2=""/>монголы</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="ходуля" gr="S,f,inan,loc,norm,pl" sem="der:v t:tool r:concr" sem2=""/>ходулях</w>, <w><ana lex="костюм" gr="S,inan,m,nom,norm,pl" s