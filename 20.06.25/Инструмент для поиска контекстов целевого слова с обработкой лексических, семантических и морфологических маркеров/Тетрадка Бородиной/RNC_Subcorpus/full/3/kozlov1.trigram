:card:pauc" sem2=""/>две</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="даже" gr="PART,norm" sem="" sem2=""/>даже</w> <w><ana lex="три" gr="NUM,nom,norm" sem="r:card:pauc" sem2=""/>три</w> <w><ana lex="группа" gr="S,f,inan,nom,norm,pl" sem="pt:set sc:x r:concr hi:class" sem2="pt:set t:hier r:abstr t:group sc:hum r:concr"/>группы</w> <w><ana lex="могильный" gr="A,gen,norm,pl,plen" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s"/>могильных</w> <w><ana lex="курган" gr="S,gen,inan,m,norm,pl" sem="top:hill r:propn t:space r:concr t:topon" sem2=""/><ana lex="курган" gr="S,gen,inan,m,norm,pl" sem="top:hill r:propn t:space r:concr t:topon" sem2=""/>курганов</w>, <w>по-видимому</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="древний" gr="A,gen,norm,pl,plen" sem="r:rel" sem2="t:time:age:max r:rel"/>древних</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="который" gr="APRO,loc,norm,pl" sem="r:rel t:ord" sem2=""/>которых</w> <w><ana lex="храниться" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:loc ca:noncaus" sem2="ca:noncaus"/><ana lex="храниться" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:loc ca:noncaus" sem2="ca:noncaus"/>хранились</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="продолжать" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="aux:phase d:pref der:a" sem2=""/>продолжают</w> <w><ana lex="храниться" gr="V,act,inf,intr,ipf,norm" sem="t:loc ca:noncaus" sem2="ca:noncaus"/><ana lex="храниться" gr="V,act,inf,intr,ipf,norm" sem="t:loc ca:noncaus" sem2="ca:noncaus"/>храниться</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="наш" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/>наших</w> <w><ana lex="день" gr="S,gen,inan,m,norm,pl" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дней</w> <w><ana lex="останки" gr="S,acc,inan,norm,pl" sem="pt:aggr:aggrpl pt:residpart der:v sc:partb r:concr" sem2=""/>останки</w> <w><ana lex="китайский" gr="A,gen,norm,pl,plen" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>китайских</w> <w><ana lex="принц" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr" sem2=""/>принцев</w>, <w>вероятно</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="сам" gr="APRO,gen,norm,pl" sem="r:spec" sem2=""/>самих</w> <w><ana lex="император" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr d:nag der:s" sem2=""/>императоров</w>: <w><ana lex="подробный" gr="A,n,nom,norm,plen,sg" sem="r:rel" sem2=""/>подробное</w> <w><ana lex="изучение" gr="S,inan,n,nom,norm,sg" sem="t:ment der:v r:abstr" sem2=""/>изучение</w> <w><ana lex="точно" gr="ADV,norm" sem="dt:like ev:posit der:a" sem2="dt:like der:a"/>точно</w> <w><ana lex="установить" gr="V,3p,act,fut,indic,norm,pf,sg" sem="der:v d:pref" sem2="der:v d:pref"/>установит</w>.</se><se> <w><ana lex="некоторый" gr="APRO,nom,norm,pl" sem="r:indet" sem2=""/>Некоторые</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="этот" gr="APRO,gen,norm,pl" sem="r:dem" sem2=""/>этих</w> <w><ana lex="курган" gr="S,gen,inan,m,norm,pl" sem="top:hill r:propn t:space r:concr t:topon" sem2=""/><ana lex="курган" gr="S,gen,inan,m,norm,pl" sem="top:hill r:propn t:space r:concr t:topon" sem2=""/>курганов</w> <w><ana lex="мы" gr="SPRO,1p,ins,norm,pl" sem="r:pers" sem2=""/>нами</w> <w><ana lex="разработать" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="der:v d:pref" sem2="der:v d:pref"/>разработаны</w>, <w><ana lex="некоторые" gr="SPRO,nom,norm,pl" sem="r:indet" sem2=""/>некоторые</w> <w><ana lex="еще" gr="ADV,norm" sem="" sem2=""/>еще</w> <w><ana lex="продолжать" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="aux:phase d:pref der:a" sem2=""/>продолжают</w> <w><ana lex="разрабатываться" gr="V,act,inf,intr,ipf,norm" sem="der:v d:pref d:impf" sem2=""/>разрабатываться</w>.</se><se> <w><ana lex="тибетский" gr="A,f,nom,norm,plen,sg" sem="dt:topon r:rel der:s t:topon" sem2=""/>Тибетская</w> <w><ana lex="экспедиция" gr="S,f,inan,nom,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиция</w> <w><ana lex="узко" gr="ADV,comp,norm" sem="dt:size:min der:a" sem2="dt:size:min der:a"/><ana lex="уже" gr="ADV,norm" sem="t:time" sem2=""/>уже</w> <w><ana lex="обогатиться" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref"/>обогатилась</w> <w><ana lex="содержание" gr="S,inan,ins,n,norm,sg" sem="der:v r:abstr der:s0" sem2="pt:set t:text r:abstr t:poss der:v pt:aggr sc:money pt:part pc:text r:concr"/>содержанием</w> <w><ana lex="исторический" gr="A,gen,norm,pl,plen" sem="dt:abstr r:rel der:s" sem2="dt:abstr r:rel der:s"/>исторических</w> <w><ana lex="памятник" gr="S,gen,inan,m,norm,pl" sem="r:concr t:workart der:a" sem2="t:constr r:concr der:a"/>памятников</w>.</se><se> <w><ana lex="иметься" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus t:poss" sem2=""/>Имеются</w> <w><ana lex="роскошный" gr="A,nom,norm,pl,plen" sem="der:s r:qual" sem2="ev:posit t:quality der:s r:qual"/>роскошные</w> <w><ana lex="вышивка" gr="S,f,inan,nom,norm,pl" sem="der:v r:abstr der:s0 t:impact:creat" sem2="der:v t:pattern r:concr"/>вышивки</w>: <w><ana lex="фигура" gr="S,f,inan,nom,norm,pl" sem="r:concr t:form:geom" sem2="t:speech t:tool r:abstr t:workart t:loc:body t:tool:card t:word t:tool:game r:concr"/>фигуры</w> <w><ana lex="человек" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr" sem2="t:hum ev:posit r:concr"/>людей</w>, <w><ana lex="животное" gr="S,anim,gen,n,norm,pl" sem="der:subst t:animal der:a r:concr hi:class" sem2="der:subst t:animal r:concr der:a"/>животных</w>, <w><ana lex="орнамент" gr="S,inan,m,nom,norm,pl" sem="t:pattern r:concr" sem2="sc:sound pt:part:addit r:abstr pt:aggr pc:workmus r:concr"/>орнаменты</w>; <w><ana lex="также" gr="PART,norm" sem="" sem2=""/>также</w> <w><ana lex="отдельный" gr="A,nom,norm,pl,plen" sem="r:rel" sem2="r:rel"/>отдельные</w> <w><ana lex="ковровый" gr="A,nom,norm,pl,plen" sem="dt:stuff r:rel der:s" sem2=""/>ковровые</w> <w><ana lex="картина" gr="S,anim,f,famn,nom,norm,pl" sem="" sem2=""/><ana lex="картина" gr="S,f,inan,nom,norm,pl" sem="r:concr t:workart" sem2="pc:workdram t:text r:abstr t:workart t:perc pt:part t:workcin r:concr"/>картины</w> -- <w><ana lex="замечательный" gr="A,nom,norm,pl,plen" sem="der:v ev:posit t:quality r:qual" sem2=""/>замечательные</w> <w><ana lex="тип" gr="S,inan,m,nom,norm,pl" sem="r:abstr" sem2="pt:aggr r:abstr r:phras"/><ana lex="тип" gr="S,anim,m,nom,norm,pl" sem="" sem2="t:hum ev r:concr ev:neg"/>типы</w>.</se><se> <w>Много</w> <w><ana lex="отдельный" gr="A,gen,norm,pl,plen" sem="r:rel" sem2="r:rel"/>отдельных</w>, <w><ana lex="исключительно" gr="ADV,norm" sem="ev:posit dt:degr:max t:degr:max der:a" sem2="ev:posit dt:degr:max der:a"/>исключительно</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="черный" gr="A,gen,norm,pl,plen" sem="t:physq:color r:qual" sem2="t:humq t:physq:color dt:physq:color r:qual der:shift t:race ev:neg t:species ev r:rel"/>черных</w> <w><ana lex="волос" gr="S,gen,inan,m,norm,pl" sem="t:hair top:rope pt:aggr r:concr sc:hair" sem2="pt:aggr t:stuff r:concr t:fam sc:hair"/>волос</w>, <w><ana lex="коса" gr="S,f,gen,inan,norm,pl" sem="t:space pc:hum t:tool:instr r:concr pt:additb" sem2=""/>кос</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="футляр" gr="S,inan,ins,m,norm,pl" sem="top:contain t:tool r:concr" sem2=""/>футлярами</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="шелк" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr" sem2="ev:posit t:stuff sc:tool:cloth r:abstr pt:aggr:aggrpl r:concr"/>шелка</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="талисман" gr="S,inan,ins,m,norm,pl" sem="t:access t:sign r:concr" sem2=""/>талисманами</w>, <w>много</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="без" gr="PR,norm