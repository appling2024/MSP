<p><se><w><ana lex="на" gr="PR,norm" sem="" sem2=""/>На</w> <w><ana lex="базар" gr="S,inan,loc,m,norm,sg" sem="t:space r:concr" sem2="t:sound r:abstr ev:neg"/>базаре</w>, <w><ana lex="как" gr="CONJ,norm" sem="" sem2=""/>как</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="клуб" gr="S,inan,loc,m,norm,sg" sem="qc:stuff top:spher pt:qtm t:org top:form r:concr" sem2="top:contain t:constr:build r:concr"/>клубе</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="невский" gr="A,loc,m,norm,plen,sg" sem="r:rel t:topon" sem2=""/>Невском</w>, <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="встретить" gr="V,act,indic,m,norm,pf,praet,sg" sem="d:pref" sem2="d:pref"/>встретил</w> <w><ana lex="немало" gr="NUM,norm" sem="" sem2=""/>немало</w> <w><ana lex="знакомый" gr="S,anim,gen,m,norm,pl" sem="der:v t:hum r:concr der:subst" sem2=""/>знакомых</w>.</se><se> <w><ana lex="между" gr="PR,norm" sem="" sem2=""/>Между</w> <w><ana lex="прочее" gr="SPRO,ins,n,norm,sg" sem="" sem2=""/>прочим</w>: <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="сангина" gr="S,f,inan,nom,norm,sg" sem="" sem2=""/>Сангина</w> -- <w><ana lex="карнаков" gr="S,anim,bastard,famn,gen,m,sg" sem="t:hum r:propn t:famn" sem2=""/>Карнакова</w>, <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="урочище" gr="S,gen,inan,n,norm,sg" sem="t:space r:concr" sem2=""/>урочища</w> <w><ana lex="баин" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Баин-булак</w> -- <w>Ежо</w>; <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="последний" gr="A,dat,norm,pl,plen" sem="r:rel t:ord" sem2="t:degr:max:magn r:qual r:rel ev:neg t:time"/>последним</w> <w><ana lex="столковаться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="der:v ca:noncaus d:pref" sem2=""/>столковались</w> <w><ana lex="относительно" gr="PR,norm" sem="" sem2=""/>относительно</w> <w><ana le