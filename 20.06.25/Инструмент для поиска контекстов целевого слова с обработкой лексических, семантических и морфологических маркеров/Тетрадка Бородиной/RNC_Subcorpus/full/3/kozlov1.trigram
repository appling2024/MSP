<p><se><w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>А</w> <w><ana lex="весна" gr="S,f,inan,nom,norm,sg" sem="t:time:season r:abstr t:time" sem2=""/>весна</w>, <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="весь" gr="APRO,dat,f,norm,sg" sem="r:spec" sem2=""/>всей</w> <w><ana lex="видимость" gr="S,dat,f,inan,norm,sg" sem="r:abstr der:a" sem2="t:perc r:abstr der:a"/>видимости</w>, <w><ana lex="еще" gr="ADV,norm" sem="" sem2=""/>еще</w> <w><ana lex="далеко" gr="ADV,norm" sem="t:dist:max" sem2=""/>далеко-далеко</w>.</se><se> <w><ana lex="то" gr="SPRO,inan,ins,n,norm,sg" sem="r:dem" sem2=""/>Тем</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="обидно" gr="ADV,comp,norm" sem="dt:quality der:a ev:neg" sem2=""/>обиднее</w> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="пшевочка" gr="S,anim,bastard,gen,m,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Пшевочки</w>.</se><se> <w><ana lex="нет" gr="PART,norm" sem="" sem2=""/>Нет</w> <w><ana lex="худой" gr="A,brev,f,norm,sg" sem="ev:neg t:quality r:qual" sem2="t:appearance r:qual"/>худа</w> <w><ana lex="без" gr="PR,norm" sem="" sem2=""/>без</w> <w><ana lex="добро" gr="S,gen,inan,n,norm,sg" sem="ev:posit r:abstr" sem2="sc:thing t:letter der:shift pt:aggr ev:neg r:concr"/>добра</w>.</se><se> <w><ana lex="она" gr="SPRO,3p,f,nom,norm,sg" sem="r:pers" sem2=""/>Она</w> <w><ana lex="там" gr="ADVPRO,norm" sem="t:place r:dem" sem2=""/>там</w>, <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="юг" gr="S,inan,loc,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr pt:part pc:space"/>юге</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="калган" gr="S,inan,loc,m,norm,sg" sem="t:plant r:concr" sem2=""/>Калгане</w> <w><ana lex="смочь" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="d:pref" sem2=""/>сможет</w> <w><ana lex="увидеть" gr="V,act,inf,norm,pf,tran" sem="ca:noncaus d:pref t:perc" sem2=""/>увидеть</w> <w><ana lex="что"