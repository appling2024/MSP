lex="костяк" gr="S,inan,m,nom,norm,sg" sem="sc:partb pc:hum pc:animal der:s pt:partb r:concr" sem2="pc:group pc:org r:concr pt:part"/>костяк</w>, <w><ana lex="позвонок" gr="S,inan,m,nom,norm,sg" sem="pt:partb pc:animal r:concr pc:hum" sem2=""/>позвонок</w>, <w><ana lex="то" gr="CONJ,norm" sem="" sem2=""/>то</w> <w><ana lex="следовать" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="ca:noncaus t:move der:s" sem2="ca:noncaus t:move der:s"/>следует</w> <w><ana lex="идти" gr="V,act,inf,intr,ipf,norm" sem="ca:noncaus t:move d:root" sem2="ca:noncaus t:move d:root"/>идти</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="лопата" gr="S,f,inan,ins,norm,sg" sem="t:tool:instr r:concr" sem2="t:fam"/>лопатой</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="известный" gr="A,loc,n,norm,plen,sg" sem="r:rel" sem2="ev r:rel"/>известном</w> <w><ana lex="дальнейший" gr="A,loc,n,norm,plen,sg" sem="dt:dist:max der:a d:super r:qual" sem2=""/>дальнейшем</w> <w><ana lex="направление" gr="S,inan,loc,n,norm,sg" sem="r:abstr t:dir" sem2="t:doc t:space der:s0 r:abstr der:v pt:part pc:space r:concr"/>направлении</w>, <w><ana lex="чтобы" gr="CONJ,norm" sem="" sem2=""/>чтобы</w> <w><ana lex="найти" gr="V,act,inf,norm,pf" sem="der:v ca:noncaus t:move t:poss" sem2="der:v ca:noncaus t:move"/>найти</w> <w><ana lex="весь" gr="APRO,acc,inan,norm,pl" sem="r:spec" sem2=""/>все</w> <w><ana lex="часть" gr="S,acc,f,inan,norm,pl" sem="r:concr pc:x pt:part" sem2="pc:org r:abstr sc:part t:org pt:ind pt:aggr:aggrpl t:poss der:shift pc:x pt:part pc:text r:concr"/>части</w>, <w><ana lex="слагать" gr="V,act,ipf,nom,norm,partcp,pl,plen,praes,tran" sem="der:v d:pref" sem2=""/><ana lex="слагать" gr="V,act,ipf,nom,norm,partcp,pl,plen,praes" sem="der:v d:pref" sem2=""/><ana lex="складывать" gr="V,act,ipf,nom,norm,partcp,pl,plen,praes" sem="der:v d:pref d:impf" sem2=""/>слагающие</w> <w><ana lex="целый" gr="A,acc,n,norm,plen,sg" sem="t:degr r:qual" sem2="t:degr r:spec r:qual"/>целое</w> <w>