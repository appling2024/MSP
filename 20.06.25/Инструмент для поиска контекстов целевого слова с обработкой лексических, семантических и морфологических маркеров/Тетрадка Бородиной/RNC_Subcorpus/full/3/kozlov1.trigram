<p><se><w><ana lex="с" gr="PR,norm" sem="" sem2=""/>С</w> <w><ana lex="начало" gr="S,gen,inan,n,norm,sg" sem="pt:phase r:abstr pc:x pt:part pc:pc:x r:concr" sem2="t:asp r:abstr pt:part"/>начала</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="конец" gr="S,gen,inan,m,norm,sg" sem="pt:phase r:concr r:abstr pt:part pc:x" sem2="top:rope t:tool t:space t:be:disapp r:abstr ev:neg r:concr"/>конца</w> <w><ana lex="лунный" gr="A,gen,n,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s"/>лунного</w> <w><ana lex="затмение" gr="S,gen,inan,n,norm,sg" sem="r:abstr" sem2="t:psych r:abstr"/>затмения</w> <w><ana lex="местный" gr="A,nom,norm,pl,plen" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s"/>местные</w> <w><ana lex="лама" gr="S,anim,nom,norm,pl" sem="t:hum t:animal r:concr" sem2=""/>ламы</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="простолюдин" gr="S,anim,m,nom,norm,pl" sem="der:comp t:hum r:concr" sem2=""/>простолюдины</w> -- <w><ana lex="монгол" gr="S,anim,m,nom,norm,pl" sem="" sem2=""/>монголы</w>, <w><ana lex="китаец" gr="S,anim,m,nom,norm,pl" sem="" sem2=""/>китайцы</w> <w><ana lex="неистовствовать" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="der:s" sem2="der:s"/>неистовствовали</w>: <w><ana lex="стучать" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:impact ca:noncaus t:sound d:root" sem2="t:speech ca:noncaus t:physiol d:root"/>стучали</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="бубен" gr="S,acc,inan,m,norm,pl" sem="t:tool:mus r:concr" sem2=""/>бубны</w>, <w><ana lex="барабан" gr="S,acc,inan,m,norm,pl" sem="t:tool:mus r:concr" sem2="t:tool pc:constr:build pc:tool:device top:cylinder pt:part r:concr"/>барабаны</w>, <w><ana lex="звонить" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:impact ca:noncaus t:sound" sem2="ev:neg"/>звонили</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="тарелка" gr="S,acc,f,inan,no