mpact der:v r:abstr der:s0" sem2="t:sport r:abstr"/>стрельба</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="мишень" gr="S,f,gen,inan,norm,sg" sem="t:tool r:concr r:abstr der:shift" sem2=""/>мишени</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w>общем</w> <w><ana lex="удовлетворительно" gr="ADV,norm" sem="der:a" sem2=""/>удовлетворительно</w>!</se><se> <w><ana lex="стрелять" gr="V,act,f,indic,ipf,norm,praet,sg,tran" sem="der:s" sem2="t:impact:destr ca:caus t:be:disapp t:poss ca:0 t:sound der:s ca:noncaus t:physiol"/>Стреляла</w>, <w><ana lex="между" gr="PR,norm" sem="" sem2=""/>между</w> <w><ana lex="прочее" gr="SPRO,ins,n,norm,sg" sem="" sem2=""/>прочим</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="леночка" gr="S,anim,f,nom,norm,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Леночка</w> <w><ana lex="горбунова" gr="S,anim,f,famn,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Горбунова</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w>, <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="мой" gr="APRO,dat,n,norm,sg" sem="r:poss" sem2=""/>моему</w> <w><ana lex="удовольствие" gr="S,dat,inan,n,norm,sg" sem="t:psych:emot r:abstr" sem2="ev:posit r:abstr"/>удовольствию</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="успех" gr="S,inan,ins,m,norm,sg" sem="ev:posit r:abstr" sem2="ev:posit r:abstr"/>успехом</w>!</se><se> <w><ana lex="погода" gr="S,f,inan,nom,norm,sg" sem="r:abstr t:weather" sem2=""/>Погода</w> <w><ana lex="серенький" gr="A,f,nom,norm,plen,sg" sem="d:dim dt:physq:color der:a t:physq:color r:qual" sem2=""/>серенькая</w>, <w><ana lex="сухой" gr="A,f,nom,norm,plen,sg" sem="t:physst r:qual" sem2="t:humq t:physq ev:neg dt:physst der:shift t:appearance r:qual t:sound dt:physq r:rel"/>сухая</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="воздух" gr="S,inan,loc,m,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>воздухе</w> <w><ana