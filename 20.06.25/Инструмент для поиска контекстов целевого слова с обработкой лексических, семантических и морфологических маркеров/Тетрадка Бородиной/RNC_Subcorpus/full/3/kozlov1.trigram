<p><se><w><ana lex="получить" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:noncaus t:poss" sem2=""/>Получил</w> <w><ana lex="донесение" gr="S,acc,inan,n,norm,sg" sem="t:speech r:abstr" sem2=""/>донесение</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w>И</w>. <w>Д</w>. <w><ana lex="тугаринова" gr="S,anim,bastard,f,famn,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Тугаринова</w>: <w><ana lex="они" gr="SPRO,3p,nom,norm,pl" sem="r:pers" sem2=""/>они</w> <w><ana lex="компания" gr="S,f,inan,ins,norm,sg" sem="t:group pt:set r:concr sc:hum" sem2="r:concr t:org"/>компанией</w> <w><ana lex="добыть" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus d:pref t:poss" sem2="der:v d:pref"/>добыли</w> <w><ana lex="два" gr="NUM,f,nom,norm" sem="r:card:pauc" sem2=""/>две</w> <w><ana lex="кабарга" gr="S,anim,f,gen,norm,sg" sem="t:animal r:concr" sem2=""/>кабарги</w>, <w><ana lex="колонка" gr="S,f,inan,nom,norm,sg" sem="d:dim pc:constr r:concr der:s pt:part" sem2="t:text qc:text t:form pt:qtm top:cylinder t:tool:device der:s pt:part top:post r:concr"/>колонка</w>, <w><ana lex="беляк" gr="S,anim,gen,m,norm,sg" sem="t:animal r:concr der:a" sem2="t:hum der:a r:concr ev:neg"/>беляка</w>, <w><ana lex="глухарь" gr="S,anim,gen,m,norm,sg" sem="t:animal r:concr" sem2=""/>глухаря</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="берлога" gr="S,f,gen,inan,norm,sg" sem="top:pit top:contain t:space r:concr" sem2=""/>берлоги</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="найти" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:noncaus t:move t:poss" sem2="der:v ca:noncaus t:move"/>нашли</w>, <w><ana lex="уехать" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus t:move d:pref" sem2=""/>уехали</w> <w><ana lex="опять" gr="ADV,norm" sem="" sem2=""/>опять</w>, <w><ana lex="жаловаться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="t:speech ca:noncaus" sem2="ca:noncaus"/>жалуются</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana