<p><se><b/><w><b>23</b></w><b>/</b><w><ana lex="ii" gr="bastard" sem="" sem2=""/><b>II</b></w><b>, </b><w><ana lex="w" gr="bastard" sem="" sem2=""/><b>W</b></w><b/>. <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="военный" gr="A,m,nom,norm,plen,sg" sem="dt:abstr dt:inter r:rel der:s" sem2="dt:abstr dt:inter r:rel der:s"/>военный</w> <w><ana lex="праздник" gr="S,inan,m,nom,norm,sg" sem="t:action r:abstr" sem2="r:abstr"/>праздник</w>.</se><se> <w><ana lex="погода" gr="S,f,inan,nom,norm,sg" sem="r:abstr t:weather" sem2=""/>Погода</w> <w><ana lex="прекрасный" gr="A,f,nom,norm,plen,sg" sem="ev:posit t:appearance r:qual" sem2="ev:posit t:quality r:qual"/>прекрасная</w> -- <w><ana lex="ясный" gr="A,f,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясная</w>, <w><ana lex="тихий" gr="A,f,nom,norm,plen,sg" sem="d:neg t:sound r:qual" sem2="d:neg t:humq t:speed:min der:shift t:sound r:qual"/>тихая</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w>, <w>вероятно</w>, <w><ana lex="день" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>днем</w> <w><ana lex="быть" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>будет</w> <w><ana lex="довольно" gr="ADV,norm" sem="t:degr dt:humq der:a" sem2="ev:posit dt:humq der:a"/>довольно</w> <w><ana lex="тепло" gr="ADV,norm" sem="ev:posit dt:physq:temper der:a" sem2="ev:posit dt:physq:temper der:a"/>тепло</w>.</se><se> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>Мы</w> <w><ana lex="ждать" gr="V,1p,act,indic,ipf,norm,pl,praes,tran" sem="d:root" sem2="d:root"/>ждем</w> <w><ana lex="почта" gr="S,f,gen,inan,norm,sg" sem="sc:org pt:aggr r:concr t:org pt:ind" sem2="sc:thing r:abstr t:org pt:aggr r:concr sc:text"/>почты</w> -- <w>говорят</w>, <w><ana lex="идти" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:move d:root" sem2="ca:noncaus t:move d:root"/>идет</w> <