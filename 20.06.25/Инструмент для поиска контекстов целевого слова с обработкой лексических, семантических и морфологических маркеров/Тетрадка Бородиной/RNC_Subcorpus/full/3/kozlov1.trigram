<p><se><b/><w><b>12</b></w><b>/</b><w><ana lex="xii" gr="bastard" sem="" sem2=""/><b>XII</b></w><b>, </b><w><ana lex="s" gr="bastard" sem="" sem2=""/><b>S</b></w><b/>. <w><ana lex="холодный" gr="A,n,nom,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>Холодное</w>, <w><ana lex="полуясный" gr="A,bastard,n,nom,plen,sg" sem="" sem2=""/>полуясное</w> <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утро</w>; <w><ana lex="дым" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr" sem2=""/>дым</w> <w><ana lex="над" gr="PR,norm" sem="" sem2=""/>над</w> <w><ana lex="урга" gr="S,f,inan,ins,norm,sg" sem="r:propn t:topon" sem2=""/>Ургой</w> <w><ana lex="стлаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v ca:noncaus" sem2=""/>стелется</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana form="юго-восточном" lex="юго-восточный" gr="A,loc,n,norm,plen,sg" sem="t:place der:comp r:rel dt:space" sem2=""/>юго-восточном</w> <w><ana lex="направление" gr="S,inan,loc,n,norm,sg" sem="r:abstr t:dir" sem2="t:doc t:space der:s0 r:abstr der:v pt:part pc:space r:concr"/>направлении</w>.</se><se> <w><ana lex="над" gr="PR,norm" sem="" sem2=""/>Над</w> <w><ana lex="богдо" gr="ADV,bastard" sem="" sem2=""/>Богдо-улой</w> <w><ana lex="лежать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:noncaus"/>лежит</w> <w><ana lex="высокий" gr="A,acc,n,norm,plen,sg" sem="t:size:max r:qual" sem2="ev:posit der:shift t:size:max t:sound t:degr:max r:qual t:interpretation"/>высокое</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="длинный" gr="A,acc,n,norm,plen,sg" sem="dt:abstr dt:param t:size:max der:s r:qual" sem2="dt:param dt:abstr t:time:dur:max t:size:max der:s r:qual"/>длинное</w>, <w><ana lex="вдоль" gr="PR,norm" sem="" sem2=""/