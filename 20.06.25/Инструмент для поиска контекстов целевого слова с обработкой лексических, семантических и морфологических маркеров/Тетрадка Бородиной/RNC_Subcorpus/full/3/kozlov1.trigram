gr="S,f,inan,nom,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиция</w> <w><ana lex="должный" gr="A,brev,f,norm,sg" sem="" sem2=""/>должна</w> <w><ana lex="быть" gr="V,act,inf,intr,ipf,norm" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>быть</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="менее" gr="ADV,norm" sem="t:degr:min der:adv" sem2="t:degr:min der:adv"/>менее</w> <w><ana lex="славный" gr="A,f,ins,norm,plen,sg" sem="ev:posit t:humq:char r:qual" sem2="dt:abstr ev:posit r:rel der:s"/>славной</w>, <w><ana lex="нежели" gr="CONJ,norm" sem="" sem2=""/>нежели</w> <w><ana lex="два" gr="NUM,f,nom,norm" sem="r:card:pauc" sem2=""/>две</w> <w><ana lex="мой" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>мои</w> <w><ana lex="предыдущий" gr="A,nom,norm,pl,plen" sem="t:place der:comp r:rel" sem2=""/>предыдущие</w>!</se><se> <w><ana lex="помочь" gr="V,2p,act,imper,intr,norm,pf,sg" sem="d:pref" sem2="d:pref"/>Помоги</w>, <w><ana lex="творец" gr="S,anim,m,nom,norm,sg" sem="der:v t:hum r:concr d:nag" sem2=""/>Творец</w> <w><ana lex="вселенная" gr="S,f,gen,inan,norm,sg" sem="t:space r:concr" sem2="t:space r:concr sc:space"/>Вселенной</w>, <w><ana lex="сделать" gr="V,act,inf,norm,pf,tran" sem="d:pref" sem2=""/>сделать</w> <w><ana lex="это" gr="SPRO,acc,inan,n,norm,sg" sem="r:dem" sem2=""/>это</w>.</se><se> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>Я</w> <w><ana lex="стремиться" gr="V,1p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus" sem2="ca:noncaus"/>стремлюсь</w> <w><ana lex="только" gr="PART,norm" sem="" sem2=""/>только</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="свет" gr="S,anim,dat,m,norm,persn,sg" sem="" sem2="t:hum ev:posit r:concr"/><ana lex="свет" gr="S,dat,inan,m,norm,sg" sem="t:space r:concr r:abstr t:light" sem2="t:tool t:pers t:light r:abstr t:weather sc:hum pt:aggr r:concr"/>свету</w> <w><ana lex="и" gr="CONJ,norm