<p><se><w><ana lex="до" gr="PR,norm" sem="" sem2=""/>До</w> <w><ana lex="маймачить" gr="V,bastard,brev,f,ipf,partcp,pass,praet,sg,tran" sem="" sem2=""/><ana lex="майматить" gr="V,bastard,brev,f,ipf,partcp,pass,praet,sg" sem="" sem2=""/><ana lex="майматить" gr="V,bastard,brev,f,partcp,pass,pf,praet,sg" sem="" sem2=""/><ana lex="майматить" gr="V,bastard,brev,f,ipf,partcp,pass,praet,sg,tran" sem="" sem2=""/><ana lex="майматить" gr="V,bastard,brev,f,partcp,pass,pf,praet,sg,tran" sem="" sem2=""/><ana lex="майматить" gr="V,bastard,brev,f,ipf,partcp,pass,praet,sg,tran" sem="" sem2=""/>Маймачена</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="алтана" gr="S,anim,f,gen,norm,persn,pl" sem="" sem2=""/>Алтан-булака</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="докатить" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2=""/>докатили</w> <w><ana lex="скоро" gr="ADV,norm" sem="dt:speed:max der:a t:time" sem2="dt:speed:max der:a t:time"/>скоро</w>, <w><ana lex="получить" gr="V,act,indic,norm,pf,pl,praet" sem="ca:noncaus t:poss" sem2=""/>получили</w> <w><ana lex="весь" gr="APRO,acc,inan,norm,pl" sem="r:spec" sem2=""/>все</w> <w><ana lex="разрешение" gr="S,acc,inan,n,norm,pl" sem="der:v r:abstr der:s0" sem2="der:v t:doc r:concr r:abstr t:param"/>разрешения</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w>, <w>наконец</w>, <w><ana lex="распрощаться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus d:pref" sem2=""/>распрощались</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="учащийся" gr="S,anim,ins,m,norm,pl" sem="der:v t:hum r:concr der:subst" sem2=""/>учащимися</w> <w><ana lex="город" gr="S,gen,inan,m,norm,sg" sem="sc:constr:build t:space r:concr" sem2="t:space r:concr"/>города</w> <w><ana lex="кяхта" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Кяхты</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="свой" gr="APRO,ins,norm,pl" sem="r:poss" sem2="t:social r:poss"/>своими</w> <w><ana lex="спутник" gr="S,anim,ins,m,norm,pl" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,inan,ins,m,norm,pl" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутниками</w> <w><ana lex="во" gr="PR,norm" sem="" sem2=""/>во</w> <w><ana lex="глава" gr="S,f,inan,loc,norm,sg" sem="t:text pc:hum pt:part pc:text pt:partb r:concr" sem2="pc:constr r:concr pt:part"/>главе</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="глаголев" gr="S,anim,famn,ins,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Глаголевым</w> (<w><ana lex="там" gr="ADVPRO,norm" sem="t:place r:dem" sem2=""/>там</w> <w><ana lex="какой" gr="APRO,f,nom,norm,sg" sem="t:neg r:rel ev:neg" sem2=""/><ana form="какая-то" lex="какой-то" gr="APRO,f,nom,norm,sg" sem="r:indet" sem2=""/>какая-то</w> <w><ana lex="история" gr="S,f,inan,nom,norm,sg" sem="r:abstr" sem2="ev:neg r:concr r:abstr t:text"/>история</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="нагрузка" gr="S,f,inan,ins,norm,sg" sem="t:put der:v r:abstr der:s0" sem2="sc:thing r:abstr der:v pt:aggr ev:neg r:concr"/>нагрузкой</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="выгрузка" gr="S,f,inan,ins,norm,sg" sem="der:v t:move r:abstr" sem2=""/>выгрузкой</w> <w><ana lex="наш" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/>нашего</w> <w><ana lex="багаж" gr="S,gen,inan,m,norm,sg" sem="sc:thing pt:aggr r:concr" sem2="pt:set der:shift"/>багажа</w> <w><ana lex="ямщик" gr="S,anim,ins,m,norm,pl" sem="t:hum r:concr der:s t:prof" sem2=""/>ямщиками</w>).</se></p>
<p><se><w><ana lex="путь" gr="S,inan,m,nom,norm,sg" sem="top:stripe t:space r:concr" sem2="ev:posit t:space t:asp r:abstr sc:space pt:aggr:aggrpl pt:aggr top:stripe r:concr der:shift"/>Путь</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="троицкосавск" gr="S,bastard,gen,inan,m,sg" sem="" sem2=""/>Троицкосавска</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="урга" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Урги</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="наемный" gr="A,loc,norm,pl,plen" sem="der:v r:rel" sem2="der:v r:rel"/>наемных</w> <w><ana lex="ямщик" gr="S,anim,loc,m,norm,pl" sem="t:hum r:concr der:s t:prof" sem2=""/>ямщиках</w> (<w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="убугунов" gr="S,anim,bastard,dat,famn,m,sg" sem="t:hum r:propn t:famn" sem2=""/>Убугунову</w>) <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="тарантас" gr="S,inan,loc,m,norm,pl" sem="t:tool:transp r:concr" sem2=""/>тарантасах</w> <w><ana lex="пройти" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="пройти" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="проходить" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2=""/>прошел</w> <w><ana lex="благополучно" gr="ADV,norm" sem="ev:posit der:a" sem2=""/>благополучно</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="26" gr="NUM,ciph"/>26</w>/<w><ana lex="ix" gr="bastard" sem="" sem2=""/>IX</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="1" gr="NUM,ciph"/>1</w> <w><ana lex="октябрь" gr="S,gen,inan,m,norm,sg" sem="t:time:month t:pers r:abstr" sem2="r:abstr"/>октября</w>, <w><ana lex="только" gr="PART,norm" sem="" sem2=""/>только</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="второй" gr="ANUM,0,norm" sem="r:ord der:num r:rel t:ord" sem2="t:hier t:share r:rel der:num"/>второй</w> <w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w> <w><ana lex="пройти" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="пройти" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="проходить" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2=""/>прошел</w> <w><ana lex="упорный" gr="A,m,nom,norm,plen,sg" sem="der:v dt:poss r:rel" sem2="t:humq r:rel r:qual"/>упорный</w> <w><ana lex="дождь" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2="pt:set sc:x r:concr"/>дождь</w>, <w><ana lex="смочить" gr="V,act,m,nom,norm,partcp,pf,plen,praet,sg" sem="der:v t:changest d:pref ca:caus" sem2=""/>смочивший</w> <w><ana lex="мы" gr="SPRO,1p,acc,norm,pl" sem="r:pers" sem2=""/>нас</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="стоянка" gr="S,f,inan,loc,norm,sg" sem="t:neg t:move r:abstr" sem2="der:v t:space r:concr"/>стоянке</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="зимовье" gr="S,acc,inan,n,norm,sg" sem="r:abstr" sem2="der:v t:space r:concr"/>зимовье</w>.</se><se> <w><ana lex="зимовье" gr="S,inan,n,nom,norm,sg" sem="r:abstr" sem2="der:v t:space r:concr"/>Зимовье</w> <w><ana lex="этот" gr="APRO,n,nom,norm,sg" sem="r:dem" sem2=""/>это</w> <w><ana lex="нечто" gr="SPRO,inan,n,nom,norm,sg" sem="r:indet" sem2=""/>нечто</w> <w><ana lex="новый" gr="A,n,nom,norm,plen,sg" sem="t:time r:qual" sem2="t:time r:qual"/>новое</w>, <w><ana lex="непонятный" gr="A,n,nom,norm,plen,sg" sem="d:neg der:a r:qual" sem2="d:neg r:qual"/>непонятное</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="первый" gr="ANUM,gen,m,norm,sg" sem="r:ord der:num t:ord r:qual" sem2="ev:posit t:hier t:qual r:qual"/>первого</w> <w><ana lex="раз" gr="S,gen,inan,m,norm,sg" sem="pt:qtm r:abstr" sem2="pt:qtm r:abstr t:card"/>раза</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="затем" gr="ADV,norm" sem="der:apro t:time r:dem" sem2=""/>затем</w> <w><ana lex="делаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v ca:noncaus" sem2="der:v ca:noncaus"/>делается</w> <w><ana lex="ясный" gr="A,ins,n,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясным</w>.</se><se> <w><ana lex="зимовье" gr="S,inan,n,nom,norm,sg" sem="r:abstr" sem2="der:v t:space r:concr"/>Зимовье</w> -- <w><ana lex="станция" gr="S,f,inan,nom,norm,sg" sem="pt:set sc:constr t:space r:concr top:horiz" sem2="t:constr pc:space r:concr r:abstr t:org"/>станция</w>, <w><ana lex="ночлег" gr="S,acc,inan,m,norm,sg" sem="t:space r:abstr" sem2="der:v t:space r:concr"/>ночлег</w>, <w><ana lex="семья" gr="S,f,inan,nom,norm,sg" sem="t:group pt:set r:concr sc:hum:kin" sem2="pt:set der:shift r:concr sc:animal hi:class"/>семья</w> <w><ana lex="русский" gr="S,anim,gen,m,norm,pl" sem="" sem2=""/>русских</w>, <w><ana lex="приютиться" gr="V,act,gen,intr,norm,partcp,pf,pl,plen,praet" sem="ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>приютившихся</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="один" gr="APRO,f,loc,norm,sg" sem="" sem2="r:indet"/>одной</w> <w><ana lex="хата" gr="S,f,inan,loc,norm,sg" sem="t:constr r:concr" sem2=""/>хате</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="настил" gr="S,inan,ins,m,norm,sg" sem="t:put der:v r:abstr der:s0" sem2="top:horiz der:v t:constr r:concr"/>настилом</w>, <w><ana lex="давать" gr="V,act,ins,ipf,m,norm,partcp,plen,praes,sg,tran" sem="der:v ca:caus d:impf t:poss d:root" sem2="der:v d:root d:impf"/>дающим</w> <w><ana lex="дождевой" gr="A,acc,f,norm,plen,sg" sem="dt:stuff r:rel der:s" sem2=""/>дождевую</w> <w><ana lex="течь" gr="S,acc,f,ina