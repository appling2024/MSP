<p><se> <b/><w><b>9</b></w><b>/</b><w><ana lex="xi" gr="bastard" sem="" sem2=""/><b>XI</b></w><b>, </b><w><ana lex="t" gr="bastard" sem="" sem2=""/><b>T</b></w><b/>. <w><ana lex="опять" gr="ADV,norm" sem="" sem2=""/>Опять</w> <w><ana lex="прекрасный" gr="A,acc,inan,m,norm,plen,sg" sem="ev:posit t:appearance r:qual" sem2="ev:posit t:quality r:qual"/>прекрасный</w> <w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w>, <w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w> <w><ana lex="позднеосенний" gr="A,bastard,f,gen,plen,sg" sem="" sem2=""/>позднеосенней</w> <w><ana lex="центральный" gr="A,f,gen,norm,plen,sg" sem="t:place dt:space r:rel der:s" sem2="dt:space t:hier r:rel der:s"/>Центральной</w> <w><ana lex="азия" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Азии</w> -- <w><ana lex="ночь" gr="S,f,inan,ins,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2=""/>ночью</w> <w>морозно</w> -<w><ana lex="15-17" gr="NUM,ciph"/>15-17</w>°<w><ana lex="с" gr="PR,norm" sem="" sem2=""/>С</w>, <w><ana lex="день" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>днем</w> <w><ana lex="несколько" gr="ADV,norm" sem="t:degr:min der:adv" sem2=""/>несколько</w> <w><ana lex="высокий" gr="A,comp,norm,plen" sem="t:size:max r:qual" sem2="ev:posit der:shift t:size:max t:sound t:degr:max r:qual t:interpretation"/>выше</w> <w><ana lex="ноль" gr="S,gen,inan,m,norm,sg" sem="r:abstr t:card" sem2="t:ciph r:concr"/>нуля</w> (<w><ana lex="оказываться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v ca:noncaus d:pref d:impf" sem2="der:v ca:noncaus d:pref d:impf"/>оказывается</w>, <w><ana lex="низкий" gr="A,comp,norm,plen" sem="t:size:min r:qual" sem2="t:humq t:hier t:level r:qual t:size:min t:sound ev:neg t:interpretation"/>ниже</w>).</se></p>
<p><se><w><ana lex="наш" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>Наш</w> <w><ana lex="убугунов" gr="S,anim,bastard,famn,m,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Убугунов</w> <w><ana lex="мечтать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:ment ca:noncaus d:root" sem2=""/>мечтает</w> <w><ana lex="съездить" gr="V,act,inf,intr,norm,pf" sem="ca:noncaus t:move d:pref" sem2=""/>съездить</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="охота" gr="S,acc,f,inan,norm,sg" sem="t:action t:psych:volit r:abstr" sem2="der:v d:nag r:abstr sc:hum pt:aggr r:concr"/>охоту</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="баин" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Баин-гол</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="куда" gr="ADVPRO,norm" sem="r:rel t:dir" sem2="t:place r:rel"/>куда</w> <w><ana lex="еще" gr="ADV,norm" sem="" sem2=""/>еще</w>.</se><se> <w><ana lex="мечтать" gr="V,1p,act,indic,intr,ipf,norm,pl,praes" sem="t:ment ca:noncaus d:root" sem2=""/>Мечтаем</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="только" gr="PART,norm" sem="" sem2=""/>только</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="горный" gr="A,f,loc,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s"/>горной</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="долинный" gr="A,f,gen,norm,plen,sg" sem="dt:space r:rel der:s" sem2=""/>долинной</w> -- <w><ana lex="сангина" gr="S,f,gen,inan,norm,pl" sem="" sem2=""/>Сангин-охоте</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="цель" gr="S,f,inan,ins,norm,sg" sem="t:space r:concr" sem2="t:ment r:abstr"/>целью</w> <w><ana lex="постре