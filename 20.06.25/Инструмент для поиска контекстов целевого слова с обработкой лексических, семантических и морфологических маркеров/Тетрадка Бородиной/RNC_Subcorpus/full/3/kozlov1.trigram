<p><se><w><ana lex="вчера" gr="ADV,norm" sem="t:time" sem2=""/>Вчера</w>, <w><ana lex="между" gr="PR,norm" sem="" sem2=""/>между</w> <w><ana lex="прочее" gr="SPRO,ins,n,norm,sg" sem="" sem2=""/>прочим</w>, <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="написать" gr="V,act,indic,m,norm,pf,praet,sg,tran" sem="der:v d:pref" sem2=""/>написал</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="альбом" gr="S,acc,inan,m,norm,sg" sem="t:book r:concr" sem2="pt:set sc:workart r:concr t:text"/>альбом</w> <w><ana lex="маринка" gr="S,anim,dat,f,norm,sg" sem="d:dimb t:hum r:propn der:s t:persn" sem2=""/><ana lex="маринка" gr="S,anim,dat,f,norm,persn,sg" sem="d:dimb t:hum r:propn der:s t:persn" sem2=""/>Маринке</w> <w><ana lex="маленький" gr="A,acc,n,norm,plen,sg" sem="t:size:min r:qual" sem2="t:time:age t:size:min r:qual"/>маленькое</w> <w><ana lex="стихотворение" gr="S,acc,inan,n,norm,sg" sem="der:comp r:concr t:text" sem2=""/>стихотворение</w>.</se></p>
<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="канаев" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Канаев</w> <w><ana lex="быть" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>будет</w> <w><ana lex="препарировать" gr="V,act,inf,norm,pf,tran" sem="" sem2=""/><ana lex="препарировать" gr="V,act,inf,ipf,norm,tran" sem="" sem2=""/>препарировать</w> <w><ana lex="крупный" gr="A,gen,norm,pl,plen" sem="t:compos:size:max r:qual" sem2="ev:posit t:humq:char t:degr:max:magn der:shift t:size:max r:qual ev"/>крупных</w> <w><ana lex="птица" gr="S,anim,f,gen,norm,pl" sem="t:animal r:concr hi:class" sem2=""/>птиц</w>, <w><ana lex="добыть" gr="V,gen,norm,partcp,pass,pf,pl,plen,praet" sem="der:v ca:caus d:pref t:poss" sem2="der:v d:pref"/>добытых</w> <w><ana lex="я" gr="SPRO,1p,ins,norm,sg" sem="r:pers" sem2=""/>мною</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="баин" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Баин-булаке</w>.</se></p>
<p><se><w>Надо</w> <w><ana lex="навестить" gr="V,act,inf,norm,pf" sem="ca:noncaus t:move d:pref" sem2=""/>навестить</w> <w><ana form="кое-кого" lex="кое-кто" gr="SPRO,acc,anim,m,norm,sg" sem="r:indet" sem2=""/>кое-кого</w>: <w><ana lex="ринчино" gr="S,bastard,inan,n,nom,sg" sem="" sem2=""/>Ринчино</w>, <w><ana lex="байков" gr="S,anim,famn,gen,m,norm,pl" sem="t:hum r:propn t:famn" sem2=""/>Байковых</w>, <w><ana lex="провизор" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr" sem2=""/>провизоров</w>.</se></p>
<p><se><w><ana lex="мой" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/>Моего</w> <w><ana lex="композитор" gr="S,anim,gen,m,norm,sg" sem="der:s t:hum r:concr d:nag t:prof" sem2=""/>композитора</w> <w><ana lex="просить" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="t:speech ca:caus d:root" sem2="d:root"/>просят</w> <w><ana lex="устроить" gr="V,act,inf,norm,pf" sem="der:v ca:caus d:pref t:be:appear" sem2="der:v d:pref"/>устроить</w> <w><ana lex="концерт" gr="S,acc,inan,m,norm,sg" sem="t:action r:abstr" sem2="t:workmus r:concr"/>концерт</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="принять" gr="V,act,inf,norm,pf" sem="der:v ca:noncaus d:pref t:poss" sem2="der:v d:pref"/>принять</w> <w><ana lex="главный" gr="A,acc,n,norm,plen,sg" sem="t:hier r:qual" sem2="t:hier r:qual"/>главное</w> <w><ana lex="участие" gr="S,acc,inan,n,norm,sg" sem="der:v r:abstr t:inter" sem2="der:v r:abstr t:inter"/>участие</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="концерт" gr="S,inan,loc,m,norm,sg" sem="t:action r:abstr" sem2="t:workmus r:concr"/>концерте</w> -- <w><ana lex="играть" gr="V,act,inf,ipf,norm,tran" sem="d:root" sem2="d:root"/>играть</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="рояль" gr="S,acc,inan,m,norm,pl" sem="t:tool:mus r:concr" sem2=""/>рояли</w>.</se><se> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>Не</w> <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>сегодня</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w>?</se><se>! <w>Надо</w> <w><ana lex="перенести" gr="V,act,inf,norm,pf" sem="der:v ca:caus t:move d:pref" sem2="der:v d:pref"/><ana lex="перенести" gr="V,act,inf,norm,pf" sem="der:v ca:caus t:move d:pref" sem2="der:v d:pref"/><ana lex="переносить" gr="V,act,inf,norm,pf" sem="ca:caus t:move d:pref" sem2="d:pref"/>перенести</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="начало" gr="S,acc,inan,n,norm,sg" sem="pt:phase r:abstr pc:x pt:part pc:pc:x r:concr" sem2="t:asp r:abstr pt:part"/>начало</w> <w><ana lex="новый" gr="A,gen,m,norm,plen,sg" sem="t:time r:qual" sem2="t:time r:qual"/>Нового</w> <w><ana lex="год" gr="S,gen,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:age r:abstr"/>года</w>.</se></p>
<p><se><b/><w><b>27</b></w><b>/</b><w><ana lex="xii" gr="bastard" sem="" sem2=""/><b>XII</b></w><b>, </b><w><ana lex="v" gr="bastard" sem="" sem2=""/><b>V</b></w><b/>. <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w> <w><ana lex="особенно" gr="ADV,norm" sem="t:degr:max der:a" sem2="der:aprt der:a"/>особенно</w> <w><ana lex="ветреный" gr="A,n,nom,norm,plen,sg" sem="r:rel der:s d:habit" sem2="t:humq der:s ev:neg r:qual"/>ветреное</w>, <w><ana lex="холодный" gr="A,n,nom,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодное</w>, <w><ana lex="ветер" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>ветер</w> <w><ana lex="садкий" gr="A,m,nom,norm,plen,sg" sem="der:v r:rel" sem2=""/>садкий</w>, <w><ana lex="крепкий" gr="A,m,nom,norm,plen,sg" sem="t:physq r:qual" sem2="t:humq t:physq t:degr:max:magn der:shift r:qual r:rel t:behav"/>крепкий</w> <w><ana lex="при" gr="PR,norm" sem="" sem2=""/>при</w> -<w><ana lex="27" gr="NUM,ciph"/>27</w>°<w><ana lex="r" gr="bastard" sem="" sem2=""/>R</w>!</se><se> <w><ana lex="удовольствие" gr="S,inan,n,nom,norm,sg" sem="t:psych:emot r:abstr" sem2="ev:posit r:abstr"/>Удовольствие</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="особенный" gr="A,gen,norm,pl,plen" sem="r:rel" sem2=""/>особенных</w>.</se><se> <w><ana lex="да" gr="PART,norm" sem="" sem2=""/>Да</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="поворот" gr="S,inan,ins,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="der:v t:form t:space r:concr r:abstr"/>поворотом</w> <w><ana lex="солнце" gr="S,gen,inan,n,norm,sg" sem="top:horiz top:spher t:astr t:space r:concr" sem2="ev:posit t:space r:concr r:abstr t:light"/>солнца</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="север" gr="S,dat,inan,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr t:fam pt:part pc:space"/><ana lex="север" gr="S,anim,dat,m,norm,persn,sg" sem="" sem2=""/>северу</w> <w><ana lex="начаться" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="ca:noncaus d:pref t:be:appear" sem2=""/>началась</w> <w><ana lex="форменный" gr="A,f,nom,norm,plen,sg" sem="r:rel der:s dt:form" sem2="dt:form der:s t:degr:max r:qual"/>форменная</w> <w><ana lex="зима" gr="S,f,inan,nom,norm,sg" sem="t:time:season r:abstr t:time" sem2="t:fam"/>зима</w>.</se><se> <w><ana lex="два" gr="NUM,acc,inan,m,norm" sem="r:card:pauc" sem2=""/>Два-три</w> <w><ana lex="месяц" gr="S,gen,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:space t:astr t:time:period r:abstr top:form r:concr t:fam"/>месяца</w> <w><ana lex="быть" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>будет</w> <w><ana lex="еще" gr="ADV,norm" sem="" sem2=""/>еще</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w>холодно</w>.</se><se> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>Очень</w> <w><ana lex="любопытный" gr="A,brev,n,norm,sg" sem="t:humq r:qual" sem2="r:qual"/>любопытно</w>, <w><ana lex="скольким" gr="NUM,norm" sem="" sem2=""/>сколько</w> <w><ana lex="время" gr="S,gen,inan,n,norm,sg" sem="r:abstr t:param t:time" sem2="t:time:period r:abstr t:time"/>времени</w> <w><ana lex="пролежать" gr="V,3p,act,fut,indic,norm,pf,sg" sem="t:loc:body ca:noncaus der:v d:pref" sem2="der:v der:pref d:pref"/>пролежит</w> <w><ana lex="мощный" gr="A,acc,inan,m,norm,plen,sg" sem="t:degr:max:magn der:s r:qual" sem2="d:habit der:s t:size:max r:qual"/>мощный</w> <w><ana lex="покров" gr="S,acc,inan,m,norm,sg" sem="t:stuff t:topon qc:stuff der:v r:propn pc:x r:concr" sem2="pt:aggr:aggrpl r:abstr t:inter der:v r:concr t:tool:bedding sc:tool:cloth"/>покров</w> <w><ana lex="снег" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2=""/>снега</w>?</se><se>! <w><ana lex="как" gr="ADVPRO,norm" sem="r:rel t:manner" sem2=""/>Как</w> <w>тяжело</w> <w><ana lex="кочевник" gr="S,anim,dat,m,norm,pl" sem="der:v t:hum r:concr d:nag" sem2=""/>кочевникам</w>, <w><ana lex="скольким" gr="NUM,norm" sem="" sem2=""/>сколько</w> <w><ana lex="остаться" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="t:loc d:pref ca:noncaus" sem2="t:be:exist ca:noncaus d:pref"/>останется</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="они" gr="SPRO,3p,gen,norm,pl" sem="r:pers" sem2=""/>них</w> <w><ana lex="скот" gr="S,gen,inan,m,norm,sg" sem="pt:aggr r:concr sc:animal" sem2=""/><ana lex="скот" gr="S,anim,gen,m,norm,sg" sem="" sem2="t:hum r:concr ev:neg"/>скота</w>?</se></p>
<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="экспедиция" gr="S,f,inan,nom,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиция</w> <w><ana lex="устраивать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="der:v d:pref d:impf" sem2=""/>устраивает</w> <w><ana lex="обед" gr="S,acc,inan,m,norm,sg" sem="r:abstr" sem2="t:food sc:food r:abstr pt:aggr t:time r:concr"/>обед</w>, <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="который" gr="APRO,acc,inan,m,norm,sg" sem="r:rel t:ord" sem2=""/>который</w> <w><ana lex="кроме" gr="PR,norm" sem="" sem2=""/>кроме</w> <w><ana lex="весь" gr="APRO,gen,norm,pl" sem="r:spec" sem2=""/>всех</w> <w><ana lex="свой" gr="APRO,gen,norm,pl" sem="r:poss" sem2="t:social r:poss"/>своих</w> <w><ana lex="пригласить" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="t:speech ca:noncaus d:pref" sem2="t:speech ca:noncaus d:pref"/>приглашены</w> <w><ana lex="бадмажапов" gr="S,anim,bastard,famn,m,nom,pl" sem="t:hum r:propn t:famn" sem2=""/>Бадмажаповы</w> (<w><ana lex="супруг" gr="S,anim,m,nom,norm,pl" sem="" sem2=""/>супруги</w>).</se><se> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>У</w> <w><ana lex="мы" gr="SPRO,1p,gen,norm,pl" sem="r:pers" sem2=""/>нас</w> <w><ana lex="закуска" gr="S,f,inan,nom,norm,pl" sem="t:impact der:v r:abstr der:s0" sem2="t:food sc:food der:v pt:aggr pc:food r:concr"/>закуски</w> (<w><ana lex="консерва" gr="S,anim,gen,m,norm,persn,sg" sem="" sem2=""/><ana lex="консервы" gr="S,inan,nom,norm,pl" sem="t:food pt:aggr:aggrpl r:concr sc:food" sem2=""/><ana lex="консервы" gr="S,acc,inan,norm,pl" sem="t:food pt:aggr:aggrpl r:concr sc:food" sem2=""/>консервы</w>) <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="питие" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr" sem2=""/>пития</w>: <w><ana lex="водка" gr="S,f,inan,nom,norm,sg" sem="t:food t:stuff r:concr t:liq" sem2=""/>водка</w>, <w><ana lex="коньяк" gr="S,inan,m,nom,norm,sg" sem="t:food t:stuff r:concr t:liq" sem2="r:propn t:topon"/>коньяк</w>, <w><ana lex="красный" gr="A,n,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="ev:posit dt:physq:color der:shift r:qual t:species r:rel"/>красное</w> <w><ana lex="вино" gr="S,inan,n,nom,norm,sg" sem="t:food t:stuff r:concr t:liq" sem2="t:food t:stuff r:concr t:liq"/>вино</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="мадера" gr="S,f,inan,nom,norm,sg" sem="t:food t:stuff r:concr t:liq hi:sort" sem2=""/>мадера</w>; <w><ana lex="еда" gr="S,f,inan,nom,norm,sg" sem="der:v t:physiol r:abstr der:s0" sem2="t:food der:v r:concr hi:class"/>еда</w> -- <w><ana lex="плов" gr="S,inan,m,nom,norm,sg" sem="t:food t:stuff r:concr" sem2=""/>плов</w>, <w><ana lex="сладкий" gr="A,acc,n,norm,plen,sg" sem="t:physq:taste r:qual" sem2="ev:posit ev:neg der:shift t:humq r:qual"/>сладкое</w> -- <w><ana lex="компот" gr="S,acc,inan,m,norm,sg" sem="t:food t:stuff r:concr t:liq" sem2=""/>компот</w>, <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="чай" gr="S,dat,inan,m,norm,sg" sem="t:plant:bush r:concr" sem2="t:food t:stuff r:abstr sc:plant t:liq pt:aggr t:plant:bush r:concr"/>чаю</w> -- <w><ana lex="печение" gr="S,inan,n,nom,norm,sg" sem="t:impact der:v r:abstr der:s0" sem2=""/>печенье</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="пастила" gr="S,f,inan,nom,norm,sg" sem="t:food pt:aggr t:stuff r:concr sc:food" sem2=""/>пастила</w>.</se><se> <w>Кажется</w>, <w><ana lex="все" gr="SPRO,inan,n,nom,norm,sg" sem="" sem2=""/>все</w>, <w><ana lex="чем" gr="CONJ,norm" sem="" sem2=""/>чем</w> <w><ana lex="угощать" gr="V,1p,act,indic,ipf,norm,pl,praes,tran" sem="der:v d:pref" sem2=""/>угощаем</w>, -- <w><ana lex="это" gr="PART,norm" sem="" sem2=""/>это</w> <w><ana lex="экспедиционный" gr="A,nom,norm,pl,plen" sem="r:rel der:s" sem2=""/>экспедиционные</w> <w><ana lex="запас" gr="S,inan,m,nom,norm,pl" sem="sc:x der:v pt:aggr r:concr" sem2="pc:tool:cloth der:shift r:abstr sc:hum pt:aggr r:concr"/>запасы</w>.</se><se> <w><ana lex="мой" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>Мои</w> <w><ana lex="спутник" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,inan,m,nom,norm,pl" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутники</w> <w><ana lex="стараться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus d:root" sem2="ca:noncaus d:root"/>стараются</w> <w><ana lex="вовсю" gr="ADV,norm" sem="t:degr:max der:apro" sem2=""/>вовсю</w>, <w><ana lex="чтобы" gr="CONJ,norm" sem="" sem2=""/>чтобы</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="ударить" gr="V,act,inf,norm,pf" sem="t:impact ca:caus ca:0 d:pref" sem2="t:impact ca:noncaus d:pref t:sound"/>ударить</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="грязь" gr="S,acc,f,inan,norm,sg" sem="t:stuff r:concr" sem2="t:stuff r:concr r:abstr"/>грязь</w> <w><ana lex="лицо" gr="S,inan,ins,n,norm,sg" sem="pt:partb r:concr pc:hum" sem2="pc:tool:cloth t:space r:concr r:abstr"/><ana lex="лицо" gr="S,anim,ins,n,norm,sg" sem="" sem2="t:hum r:concr hi:class"/>лицом</w>!</se></p>
<p><se><w><ana lex="приготовление" gr="S,gen,inan,n,norm,pl" sem="der:v r:abstr" sem2=""/>Приготовлений</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="искренний" gr="A,gen,n,norm,plen,sg" sem="r:qual" sem2=""/>искреннего</w> <w><ana lex="желание" gr="S,gen,inan,n,norm,sg" sem="t:psych:volit r:abstr" sem2="r:abstr"/>желания</w> <w><ana lex="сделать" gr="V,act,inf,norm,pf,tran" sem="d:pref" sem2=""/>сделать</w> <w>хорошо</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w>много</w>.</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="заключение" gr="S,acc,inan,n,norm,sg" sem="t:put der:v r:abstr der:s0" sem2="t:text t:ment:result t:put pt:phase r:abstr der:v pc:workmus pt:part pc:text r:concr"/>заключение</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="даже" gr="PART,norm" sem="" sem2=""/>даже</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="чай" gr="S,inan,ins,m,norm,sg" sem="t:plant:bush r:concr" sem2="t:food t:stuff r:abstr sc:plant t:liq pt:aggr t:plant:bush r:concr"/>чаем</w> <w><ana lex="быть" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>будет</w> <w><ana lex="музыка" gr="S,f,inan,nom,norm,sg" sem="r:abstr" sem2="t:sound r:abstr t:fam"/>музыка</w> -- <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="хороший" gr="A,m,nom,norm,plen,sg" sem="ev:posit t:quality r:qual" sem2="ev:posit ev t:degr:max r:qual"/>хороший</w> <w><ana lex="граммофон" gr="S,inan,m,nom,norm,sg" sem="t:tool:device r:concr" sem2=""/>граммофон</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="интересный" gr="A,ins,norm,pl,plen" sem="dt:abstr der:s dt:ment r:qual" sem2="dt:abstr ev:posit der:s dt:ment r:qual"/>интересными</w> <w><ana lex="пластинка" gr="S,f,inan,ins,norm,pl" sem="d:dim top:form r:concr der:s" sem2="t:tool top:disk t:form pc:tool:device top:surface der:s pt:part pc:part d:dim pc:partb r:concr pc:plant"/>пластинками</w>.</se></p>
<p><se><w><ana lex="наш" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>Наш</w> <w><ana lex="обед" gr="S,inan,m,nom,norm,sg" sem="r:abstr" sem2="t:food sc:food r:abstr pt:aggr t:time r:concr"/>обед</w> <w><ana lex="пройти" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="пройти" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="проходить" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2=""/>прошел</w> <w><ana lex="весьма" gr="ADV,norm" sem="t:degr:max" sem2=""/>весьма</w> <w><ana lex="удовлетворительно" gr="ADV,norm" sem="der:a" sem2=""/>удовлетворительно</w>: <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w>сытно</w>, <w><ana lex="чисто" gr="ADV,norm" sem="ev:posit dt:physq der:a" sem2="ev:posit dt:physq der:a"/>чисто</w>, <w><ana lex="аппетитно" gr="ADV,norm" sem="ev:posit der:a" sem2=""/>аппетитно</w> <w><ana lex="приготовить" gr="V,brev,n,norm,partcp,pass,pf,praet,sg" sem="d:pref der:s" sem2="d:pref der:s"/>приготовлено</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="все" gr="SPRO,inan,n,nom,norm,sg" sem="" sem2=""/>все</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>были</w> <w><ana lex="вместе" gr="ADV,norm" sem="t:quant:abs" sem2="t:time"/>вместе</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="приподнять" gr="V,loc,n,norm,partcp,pass,pf,plen,praet,sg" sem="ca:caus t:move d:pref" sem2=""/>приподнятом</w> <w><ana lex="состояние" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr der:s0" sem2="sc:thing ev:posit t:psych r:abstr der:shift sc:money pt:aggr t:physiol r:concr"/>состоянии</w>.</se><se> <w><ana lex="после" gr="PR,norm" sem="" sem2=""/>После</w> <w><ana lex="чай" gr="S,gen,inan,m,norm,sg" sem="t:plant:bush r:concr" sem2="t:food t:stuff r:abstr sc:plant t:liq pt:aggr t:plant:bush r:concr"/>чая</w> <w><ana lex="со" gr="PR,norm" sem="" sem2=""/>со</w> <w><ana lex="сласть" gr="S,f,inan,ins,norm,pl" sem="t:food pt:aggr:aggrpl der:a r:concr sc:food" sem2="ev:posit r:abstr"/>сластями</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="слушание" gr="S,acc,inan,n,norm,pl" sem="der:v t:perc r:abstr" sem2=""/>слушания</w> <w><ana lex="граммофон" gr="S,gen,inan,m,norm,sg" sem="t:tool:device r:concr" sem2=""/>граммофона</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="все" gr="ADV,norm" sem="" sem2=""/>все</w> <w><ana lex="разойтись" gr="V,act,indic,intr,norm,pf,pl,praet" sem="der:v ca:noncaus t:move d:pref" sem2="der:v d:pref"/><ana lex="расходиться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus t:move d:pref" sem2="ca:noncaus t:move d:pref"/>разошлись</w>.</se><se> <w><ana lex="телешка" gr="S,anim,bastard,m,nom,persn,sg" sem="" sem2=""/>Телешка</w> <w><ana lex="подвыпить" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="d:pref" sem2=""/>подвыпил</w>.</se><se> <w>Остальные</w> <w><ana lex="весь" gr="APRO,nom,norm,pl" sem="r:spec" sem2=""/>все</w> -- <w><ana lex="молодец" gr="S,anim,ins,m,norm,pl" sem="t:hum ev:posit r:concr der:a" sem2="t:hum ev:posit r:concr"/><ana lex="молодец" gr="S,anim,ins,m,norm,pl" sem="t:hum ev:posit r:concr der:a" sem2="t:hum ev:posit r:concr"/>молодцами</w>.</se></p>
<p><se><w><ana lex="вечер" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечер</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="провести" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="провести" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="проводить" gr="V,act,indic,norm,pf,pl,praet" sem="ca:caus t:move d:pref" sem2="d:pref"/>провели</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="театр" gr="S,inan,loc,m,norm,sg" sem="r:abstr" sem2="t:space top:contain t:org r:abstr pt:aggr r:phras t:constr:build r:concr sc:text"/>театре</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="нардом" gr="S,bastard,inan,loc,m,sg" sem="" sem2=""/>Нардоме</w>, <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="пьеса" gr="S,f,inan,loc,norm,sg" sem="r:concr t:workdram" sem2="t:workmus r:concr"/>пьесе</w> «<w><ana lex="химка" gr="S,anim,bastard,m,nom,persn,sg" sem="" sem2=""/>Химка</w>», <w><ana lex="удачно" gr="ADV,norm" sem="" sem2="ev:posit der:a"/>удачно</w> (<w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="долго" gr="ADV,norm" sem="t:time:dur:max dt:time:dur:max der:a" sem2=""/>долго</w>) <w><ana lex="сыгранный" gr="A,f,ins,norm,plen,sg" sem="der:v r:rel" sem2=""/>сыгранной</w> <w><ana lex="местный" gr="A,f,ins,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s"/>местной</w> <w><ana lex="труппа" gr="S,f,inan,ins,norm,sg" sem="t:group pt:set r:concr sc:hum" sem2=""/>труппой</w> <w><ana lex="во" gr="PR,norm" sem="" sem2=""/>во</w> <w><ana lex="глава" gr="S,f,inan,loc,norm,sg" sem="t:text pc:hum pt:part pc:text pt:partb r:concr" sem2="pc:constr r:concr pt:part"/>главе</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w>А</w>. <w>В</w>. <w><ana lex="байков" gr="S,anim,famn,ins,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Байковым</w> (<w><ana lex="доктор" gr="S,anim,ins,m,norm,sg" sem="t:hum r:concr" sem2="t:hum r:concr"/>доктором</w>).</se><se> <w><ana lex="вернуться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus t:move" sem2="ca:noncaus"/>Вернулись</w> <w><ana lex="домой" gr="ADV,norm" sem="der:s t:dir" sem2=""/>домой</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="1" gr="NUM,ciph"/>1</w> <w><ana lex="час" gr="S,acc,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>час</w> <w><ana lex="40" gr="NUM,ciph"/>40</w> <w><ana lex="минута" gr="S,f,gen,inan,norm,pl" sem="t:unit t:time:moment r:abstr pc:time" sem2="t:unit der:shift t:time:period r:abstr pc:time"/>минут</w> <w><ana lex="ночь" gr="S,f,gen,inan,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2=""/>ночи</w>, <w><ana lex="без" gr="PR,norm" sem="" sem2=""/>без</w> <w><ana lex="одеяло" gr="S,gen,inan,n,norm,sg" sem="r:concr t:tool:bedding" sem2=""/>одеяла-ковра</w>, <w><ana lex="уворовать" gr="V,gen,m,norm,partcp,pass,pf,plen,praet,sg" sem="der:v d:pref t:poss" sem2=""/>уворованного</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="дрожки" gr="S,gen,inan,norm,pl" sem="top:horiz t:tool:transp r:concr" sem2=""/>дрожек</w> <w><ana lex="во" gr="PR,norm" sem="" sem2=""/>во</w> <w><ana lex="время" gr="S,acc,inan,n,norm,sg" sem="r:abstr t:param t:time" sem2="t:time:period r:abstr t:time"/>время</w> <w><ana lex="обогревание" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr" sem2=""/>обогревания</w> <w><ana lex="кучер" gr="S,anim,gen,m,norm,sg" sem="t:hum r:concr t:prof" sem2=""/>кучера</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="помещение" gr="S,inan,loc,n,norm,sg" sem="top:contain pc:constr:hut r:concr t:room pt:part" sem2="t:put der:v r:abstr der:s0"/>помещении</w> <w><ana lex="нардом" gr="S,bastard,gen,inan,m,sg" sem="" sem2=""/>Нардома</w>.</se></p>
<p><se><b/><w><b>28</b></w><b>/</b><w><ana lex="xii" gr="bastard" sem="" sem2=""/><b>XII</b></w><b>, </b><w><ana lex="t" gr="bastard" sem="" sem2=""/><b>T</b></w><b/>. <w><ana lex="проспать" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:noncaus t:physiol d:pref" sem2="der:v d:pref"/>Проспали</w> <w><ana lex="долго" gr="ADV,norm" sem="t:time:dur:max dt:time:dur:max der:a" sem2=""/>долго</w> -- <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="1" gr="NUM,ciph"/>1</w>/<w><ana lex="4" gr="NUM,ciph"/>4</w> <w><ana lex="10" gr="NUM,ciph"/>10</w>-<w>го</w> <w><ana lex="час" gr="S,gen,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часа</w> <w><ana lex="утро" gr="S,gen,inan,n,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утра</w>.</se><se> <w><ana lex="облачно" gr="ADV,norm" sem="" sem2=""/>Облачно</w>, <w><ana lex="серо" gr="ADV,norm" sem="dt:physq:color der:a ev:neg" sem2="dt:physq:color der:a ev:neg"/>серо</w>, <w><ana lex="туманно" gr="ADV,norm" sem="der:a ev:neg" sem2="der:a ev:neg"/>туманно</w>, <w><ana form="юго-восточный" lex="юго-восточный" gr="A,m,nom,norm,plen,sg" sem="t:place der:comp r:rel dt:space" sem2=""/>юго-восточный</w> <w><ana lex="ветер" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>ветер</w> <w><ana lex="принести" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus ca:0 d:pref"/>принес</w> <w><ana lex="влага" gr="S,acc,f,inan,norm,sg" sem="t:stuff r:concr" sem2=""/>влагу</w>, <w><ana lex="облако" gr="S,inan,n,nom,norm,pl" sem="qc:stuff r:concr" sem2="qc:stuff pt:qtm top:form r:concr"/>облака</w>, <w><ana lex="снег" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2=""/>снег</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="повышение" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr" sem2=""/>повышение</w> <w><ana lex="температура" gr="S,f,gen,inan,norm,sg" sem="r:abstr t:par