" sem="der:v r:abstr der:s0 t:inter" sem2="der:v sc:thing pt:aggr r:concr r:abstr"/>боем</w>.</se><se> <w><ana lex="театр" gr="S,inan,m,nom,norm,sg" sem="r:abstr" sem2="t:space top:contain t:org r:abstr pt:aggr r:phras t:constr:build r:concr sc:text"/>Театр</w> <w><ana lex="бродить" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:move d:root" sem2="ca:noncaus"/>бродит</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="один" gr="APRO,gen,m,norm,sg" sem="" sem2="r:indet"/>одного</w> <w><ana lex="богатый" gr="A,gen,m,norm,plen,sg" sem="r:qual" sem2="der:shift r:qual"/>богатого</w> <w><ana lex="дом" gr="S,gen,inan,m,norm,sg" sem="top:contain t:constr:build r:concr" sem2="sc:hum pt:set t:space t:org t:group der:shift r:concr"/>дома</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="другой" gr="APRO,dat,m,norm,sg" sem="r:spec" sem2="r:ord r:spec r:indet"/>другому</w>, <w><ana lex="наперед" gr="ADV,norm" sem="der:s t:time" sem2=""/>наперед</w> <w><ana lex="высылать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="der:v ca:caus t:move d:pref" sem2=""/>высылает</w> <w><ana lex="красный" gr="A,acc,inan,norm,pl,plen" sem="t:physq:color r:qual" sem2="ev:posit dt:physq:color der:shift r:qual t:species r:rel"/>красные</w> <w><ana lex="карточка" gr="S,acc,f,inan,norm,pl" sem="qc:stuff r:concr" sem2="der:s t:doc r:concr t:workart d:dim"/>карточки-предупреждения</w>.</se><se> <w><ana lex="принять" gr="V,brev,n,norm,partcp,pass,pf,praet,sg" sem="der:v ca:noncaus d:pref t:poss" sem2="der:v d:pref"/>Принято</w>, <w><ana lex="обыкновенно" gr="ADV,norm" sem="der:a t:time" sem2="der:a"/>обыкновенно</w>, <w><ana lex="угощать" gr="V,act,inf,ipf,norm,tran" sem="der:v d:pref" sem2=""/>угощать</w> <w><ana lex="актер" gr="S,acc,anim,m,norm,pl" sem="t:hum r:concr t:prof" sem2="t:hum ev r:concr"/>актеров</w>, <w><ana lex="играть" gr="V,acc,act,anim,ipf,norm,partcp,pl,plen,praes,tran" sem="d:root" sem2="d:root"/>играющих</w> <w><ana lex="во" gr="PR,norm" sem="" sem2=""/>во</w> <w><ana lex="двор" gr="S,inan,loc,m,norm,sg" sem="pt:set t:space r:concr pc:constr:build t:group sc:hum pt:addit" sem2="t:space r:concr pc:constr:build t:org t:constr pt:addit"/>дворе</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="просто" gr="PART,norm" sem="dt:quality der:a" sem2=""/>просто</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="улица" gr="S,f,inan,loc,norm,sg" sem="t:space r:concr pt:part pc:space" sem2="sc:hum pt:aggr t:space r:concr sc:space"/>улице</w>, <w><ana lex="перед" gr="PR,norm" sem="" sem2=""/>перед</w> <w><ana lex="дом" gr="S,inan,ins,m,norm,sg" sem="top:contain t:constr:build r:concr" sem2="sc:hum pt:set t:space t:org t:group der:shift r:concr"/>домом</w>, <w><ana lex="запрудить" gr="V,ins,m,norm,partcp,pass,pf,plen,praet,sg" sem="d:pref" sem2=""/>запруженным</w> <w><ana lex="многочисленный" gr="A,ins,norm,pl,plen" sem="t:quant:max der:comp r:rel" sem2="t:quant:max der:comp r:rel"/>многочисленными</w> <w><ana lex="зритель" gr="S,anim,ins,m,norm,pl" sem="der:v t:hum r:concr d:nag" sem2="der:v t:hum r:concr d:nag"/>зрителями</w>, <w><ana lex="один" gr="APRO,nom,norm,pl" sem="" sem2="r:indet"/>одни</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="который" gr="APRO,gen,norm,pl" sem="r:rel t:ord" sem2=""/>которых</w> <w><ana lex="попадать" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v d:pref" sem2=""/><ana lex="попасть" gr="V,3p,act,fut,indic,intr,norm,pf,pl" sem="d:pref" sem2="d:pref"/><ana lex="попадать" gr="V,3p,act,fut,indic,intr,norm,pf,pl" sem="der:v d:pref" sem2=""/><ana lex="попадать" gr="V,3p,act,indic,ipf,norm,pl,praes" sem="der:v d:pref" sem2=""/><ana lex="попадать" gr="V,3p,act,fut,indic,norm,pf,pl" sem="der:v d:pref" sem2=""/>попадают</w> <w><ana lex="во" gr="PR,norm" sem="" sem2=""/>во</w> <w><ana lex="двор" gr="S,acc,inan,m,norm,sg" sem="pt:set t:space r:concr pc:constr:build t:group sc:hum pt:addit" sem2="t:space r:concr pc:constr:build t:org t:constr pt:addit"/>двор</w>, <w><ana lex="запереть" gr="V,m,nom,norm,partcp,pass,pf,plen,praet,sg" sem="t:impact ca:caus d:pref" sem2="d:pref"/>запертый</w>, <w><ana lex="другой" gr="APRO,nom,norm,pl" sem="r:spec" sem2="r:ord r:spec r:indet"/>другие</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w> <w><ana lex="ограничиваться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v d:pref d:impf" sem2=""/>ограничиваются</w> <w><ana lex="смотрение" gr="S,inan,ins,n,norm,sg" sem="der:v t:perc r:abstr" sem2=""/>смотрением</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="щелочка" gr="S,acc,f,inan,norm,sg" sem="d:dim r:concr der:s" sem2=""/>щелочку</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="слушание" gr="S,inan,ins,n,norm,sg" sem="der:v t:perc r:abstr" sem2=""/>слушанием</w> <w><ana lex="музыка" gr="S,f,gen,inan,norm,sg" sem="r:abstr" sem2="t:sound r:abstr t:fam"/>музыки</w>.</se></p>
<p><se><b/><w><b>13</b></w><b>/</b><w><ana lex="ii" gr="bastard" sem="" sem2=""/><b>II</b></w><b>, </b><w><ana lex="s" gr="bastard" sem="" sem2=""/><b>S</b></w><b/>. <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w> <w><ana lex="холодный" gr="A,n,nom,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодное</w>.</se><se> <w><ana lex="после" gr="PR,norm" sem="" sem2=""/>После</w> <w><ana lex="8-9" gr="NUM,ciph"/>8-9</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w> <w><ana lex="небо" gr="S,acc,inan,n,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/><ana lex="небо" gr="S,acc,inan,n,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/>небо</w>, <w><ana lex="стоять" gr="V,acc,act,intr,ipf,n,norm,partcp,plen,praet,sg" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:noncaus"/>стоявшее</w> <w><ana lex="чистый" gr="A,ins,n,norm,plen,sg" sem="t:physst r:qual" sem2="t:physq ev:posit t:humq t:degr r:qual"/>чистым</w>, <w><ana lex="стать" gr="V,act,indic,intr,n,norm,pf,praet,sg" sem="aux:phase d:root t:move:body" sem2="ca:noncaus t:move d:root t:loc"/>стало</w> <w><ana lex="понемногу" gr="ADV,norm" sem="t:quant:min der:adv" sem2="der:adv"/>понемногу</w> <w><ana lex="покрываться" gr="V,act,inf,intr,ipf,norm" sem="d:pref" sem2=""/>покрываться</w> <w><ana lex="перистый" gr="A,ins,norm,pl,plen" sem="d:habit der:s r:qual" sem2="t:physq:form dt:partb der:s r:qual"/>перистыми</w> <w><ana lex="облако" gr="S,inan,ins,n,norm,pl" sem="qc:stuff r:concr" sem2="qc:stuff pt:qtm top:form r:concr"/>облаками</w>.</se><se> <w><ana lex="впечатление" gr="S,inan,n,nom,norm,sg" sem="t:perc r:abstr" sem2="t:ment r:abstr"/>Впечатление</w> <w><ana lex="настоящий" gr="A,f,gen,norm,plen,sg" sem="r:rel t:time" sem2="ev:posit r:dem t:ver t:degr t:degr:max r:qual r:rel"/>настоящей</w> <w><ana lex="глубокий" gr="A,f,gen,norm,plen,sg" sem="t:size:max r:qual" sem2="t:dist:max dt:size:max t:degr:max:magn der:shift t:degr:max r:qual"/>глубокой</w> <w><ana lex="зима" gr="S,f,gen,inan,norm,sg" sem="t:time:season r:abstr t:time" sem2="t:fam"/>зимы</w>.</se></p>
<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="канаев" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Канаев</w> <w><ana lex="наблюдать" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="ca:noncaus d:pref t:perc" sem2="d:pref"/>наблюдал</w> <w><ana lex="интересный" gr="A,acc,n,norm,plen,sg" sem="dt:abstr der:s dt:ment r:qual" sem2="dt:abstr ev:posit der:s dt:ment r:qual"/>интересное</w> <w><ana lex="явление" gr="S,acc,inan,n,norm,sg" sem="der:v r:abstr der:s0" sem2="pc:workdram t:text r:abstr der:v t:manif pt:part r:concr"/>явление</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="ворон" gr="S,acc,anim,m,norm,sg" sem="t:animal r:concr" sem2=""/>ворона</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="голубь" gr="S,anim,ins,m,norm,sg" sem="t:animal r:concr" sem2=""/>голубем</w>.</se><se> <w><ana lex="первый" gr="ANUM,m,nom,norm,sg" sem="r:ord der:num t:ord r:qual" sem2="ev:posit t:hier t:qual r:qual"/>Первый</w>, <w><ana lex="словно" gr="CONJ,norm" sem="" sem2=""/>словно</w> <w><ana lex="хищник" gr="S,anim,m,nom,norm,sg" sem="t:animal r:concr der:a" sem2=""/>хищник</w>, <w><ana lex="преследовать" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="der:v d:pref" sem2="der:v d:pref"/>преследовал</w> <w><ana lex="второй" gr="ANUM,acc,anim,m,norm,sg" sem="r:ord der:num r:rel t:ord" sem2="t:hier t:share r:rel der:num"/>второго</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w>, <w><ana lex="догнать" gr="V,act,ger,norm,pf,praet" sem="ca:noncaus t:move d:pref" sem2="d:pref"/><ana lex="догнать" gr="V,act,ger,norm,pf,praet" sem="ca:noncaus t:move d:pref" sem2="d:pref"/><ana lex="догонять" gr="V,act,ger,norm,pf,praet" sem="der:v ca:noncaus t:move d:pref" sem2=""/>догнав</w>, <w><ana lex="удар" gr="S,inan,ins,m,norm,sg" sem="t:impact pt:qtm r:abstr" sem2="pc:sound pt:qtm r:abstr ev:neg t:sound:asp t:disease pc:move"/>ударом</w> <w><ana lex="свой" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2="t:social r:poss"/>своего</w> <w><ana lex="сильный" gr="A,gen,m,norm,plen,sg" sem="t:physq d:habit r:qual" sem2="ev:posit t:humq:char der:s t:degr:max r:qual r:rel"/>сильного</w> <w><ana lex="клюв" gr="S,gen,inan,m,norm,sg" sem="pt:partb pc:animal r:concr" sem2=""/>клюва</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="спина" gr="S,acc,f,inan,norm,sg" sem="pc:hum pc:animal top:surface pt:partb top:vertical r:concr" sem2=""/>спину</w> <w><ana lex="сшибить" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:caus t:move d:pref" sem2="d:pref"/>сшиб</w> <w><ana lex="несчастный" gr="A,acc,anim,m,norm,plen,sg" sem="ev r:qual" sem2="ev:neg r:qual"/>несчастного</w> <w><ana lex="голубь" gr="S,acc,anim,m,norm,sg" sem="t:animal r:concr" sem2=""/>голубя</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="земля" gr="S,acc,f,inan,norm,sg" sem="top:spher t:astr t:space r:concr" sem2="t:space sc:space top:horiz t:stuff pt:part pc:space r:concr"/>землю</w>, <w><ana lex="где" gr="ADVPRO,norm" sem="t:place r:rel" sem2="t:place r:indet"/>где</w> <w><ana lex="начать" gr="V,act,indic,m,norm,pf,praet,sg" sem="aux:phase d:pref" sem2="aux:phase d:pref"/>начал</w> <w><ana lex="теребить" gr="V,act,inf,ipf,norm,tran" sem="t:impact ca:caus" sem2="ca:caus t:move"/>теребить</w> <w><ana lex="он" gr="SPRO,3p,acc,m,norm,sg" sem="r:pers" sem2=""/>его</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w>, <w><ana lex="точный" gr="A,comp,norm,plen" sem="r:qual" sem2="r:qual"/>точнее</w>, <w><ana lex="ударять" gr="V,act,inf,ipf,norm,tran" sem="der:shift d:pref" sem2=""/>ударять</w> <w><ana lex="тот" gr="APRO,ins,m,norm,sg" sem="r:dem" sem2=""/>тем</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w> <w><ana lex="клюв" gr="S,inan,ins,m,norm,sg" sem="pt:partb pc:animal r:concr" sem2=""/>клювом</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="голова" gr="S,acc,anim,f,famn,norm,sg" sem="" sem2="t:hum ev:posit ev r:concr"/><ana lex="