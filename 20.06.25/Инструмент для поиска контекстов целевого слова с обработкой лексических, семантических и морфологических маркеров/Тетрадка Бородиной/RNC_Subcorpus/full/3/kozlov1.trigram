<p><se><b/><w><b>12</b></w><b>/</b><w><ana lex="x" gr="bastard" sem="" sem2=""/><b>X</b></w><b>, </b><w><ana lex="t" gr="bastard" sem="" sem2=""/><b>T</b></w><b/>. <w><ana lex="облачно" gr="ADV,norm" sem="" sem2=""/>Облачно</w>, <w><ana lex="снежный" gr="A,brev,n,norm,sg" sem="" sem2="t:physq:color r:qual"/>снежно</w>.</se><se> <w><ana lex="солнце" gr="S,inan,n,nom,norm,sg" sem="top:horiz top:spher t:astr t:space r:concr" sem2="ev:posit t:space r:concr r:abstr t:light"/>Солнце</w> <w><ana lex="прогревать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="der:v t:changest d:pref d:impf" sem2=""/>прогревает</w> <w><ana lex="настолько" gr="ADV,norm" sem="der:adv r:dem" sem2=""/>настолько</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="крыша" gr="S,f,gen,inan,norm,pl" sem="der:v pc:constr:build r:concr pt:part" sem2=""/>крыш</w> <w><ana lex="потечь" gr="V,act,indic,intr,norm,pf,pl,praet" sem="der:v ca:noncaus t:move d:pref" sem2=""/>потекли</w> <w><ana lex="капля" gr="S,f,inan,nom,norm,pl" sem="qc:stuff pt:qtm r:concr" sem2="pt:qtm r:concr"/>капли</w> <w><ana lex="вода" gr="S,f,gen,inan,norm,sg" sem="t:stuff r:concr t:liq" sem2="t:food dt:stuff t:stuff sc:reservoir t:liq sc:space r:abstr pt:aggr:aggrpl sc:qtm t:space pt:part ev:neg sc:spring pc:space r:concr der:shift"/>воды</w>.</se><se> <w><ana lex="выпасть" gr="V,act,intr,m,nom,norm,partcp,pf,plen,praet,sg" sem="ca:noncaus t:move d:pref" sem2="d:pref"/>Выпавший</w> <w><ana lex="снег" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2=""/>снег</w> <w><ana lex="испариться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus d:pref" sem2="ca:noncaus t:be:disapp d:pref"/>испарился</w>.</se><se> <w><ana lex="ветер" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>Ветер</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="север" gr="S,gen,inan,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2