<p><se><w><ana lex="тибетский" gr="A,f,nom,norm,plen,sg" sem="dt:topon r:rel der:s t:topon" sem2=""/>Тибетская</w> <w><ana lex="экспедиция" gr="S,f,inan,nom,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиция</w> <w><ana lex="пока" gr="ADV,norm" sem="t:time" sem2=""/>пока</w> <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="узко" gr="ADV,comp,norm" sem="dt:size:min der:a" sem2="dt:size:min der:a"/><ana lex="уже" gr="ADV,norm" sem="t:time" sem2=""/>уже</w> <w><ana lex="иметь" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="ca:noncaus d:root t:poss" sem2="d:root"/>имеет</w> <w><ana lex="около" gr="PR,norm" sem="" sem2=""/>около</w> <w><ana lex="16" gr="NUM,ciph"/>16</w> <w><ana lex="пуд" gr="S,anim,gen,m,norm,persn,pl" sem="" sem2=""/><ana lex="пуд" gr="S,gen,inan,m,norm,pl" sem="t:unit r:abstr" sem2=""/>пудов</w> <w><ana lex="прекрасный" gr="A,gen,n,norm,plen,sg" sem="ev:posit t:appearance r:qual" sem2="ev:posit t:quality r:qual"/>прекрасного</w> <w><ana lex="серебро" gr="S,gen,inan,n,norm,sg" sem="t:stuff r:concr" sem2="sc:thing t:stuff sc:money:banknote sc:money pt:aggr r:concr"/>серебра</w>: <w><ana lex="почти" gr="ADV,norm" sem="" sem2=""/>почти</w> <w><ana lex="8" gr="NUM,ciph"/>8</w> <w><ana lex="пуд" gr="S,anim,gen,m,norm,persn,pl" sem="" sem2=""/><ana lex="пуд" gr="S,gen,inan,m,norm,pl" sem="t:unit r:abstr" sem2=""/>пудов</w> <w><ana lex="китайский" gr="A,gen,m,norm,plen,sg" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>китайского</w> <w><ana lex="ямбовый" gr="A,bastard,gen,m,plen,sg" sem="" sem2=""/>ямбового</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="столько" gr="NUM,nom,norm" sem="" sem2=""/>столько</w> <w><ana lex="же" gr="CONJ,norm" sem="" sem2=""/>же</w> <w><ana lex="плиточный" gr="A,gen,m,norm,plen,sg" sem="r:rel der:s" sem2=""/>плиточного</w> <w><ana lex="гамбургский" gr="A,gen,m,norm,plen,sg" sem="dt:topon r:rel der:s t:topon"