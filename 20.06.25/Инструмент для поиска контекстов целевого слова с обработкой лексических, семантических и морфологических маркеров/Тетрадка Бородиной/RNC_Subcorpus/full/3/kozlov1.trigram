<p><se><w>Итак</w>, <w><ana lex="вместо" gr="PR,norm" sem="" sem2=""/>вместо</w> <w><ana lex="ясный" gr="A,gen,n,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясного</w> <w><ana lex="небо" gr="S,gen,inan,n,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/><ana lex="небо" gr="S,gen,inan,n,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/>неба</w>, <w><ana lex="высокий" gr="A,gen,n,norm,plen,sg" sem="t:size:max r:qual" sem2="ev:posit der:shift t:size:max t:sound t:degr:max r:qual t:interpretation"/>высокого</w> <w><ana lex="стояние" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr" sem2=""/>стояния</w> <w><ana lex="барометр" gr="S,gen,inan,m,norm,sg" sem="der:comp t:tool:device:measur:metr r:concr" sem2="r:abstr"/>барометра</w> <w><ana lex="сплошной" gr="A,f,nom,norm,plen,sg" sem="r:rel der:adv" sem2="der:adv r:rel t:degr:max r:qual"/>сплошная</w> <w><ana lex="облачность" gr="S,f,inan,nom,norm,sg" sem="r:abstr der:a" sem2="qc:stuff pt:aggr t:stuff r:concr sc:qtm"/>облачность</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="низкий" gr="A,n,nom,norm,plen,sg" sem="t:size:min r:qual" sem2="t:humq t:hier t:level r:qual t:size:min t:sound ev:neg t:interpretation"/>низкое</w> <w><ana lex="показание" gr="S,inan,n,nom,norm,sg" sem="t:speech r:abstr" sem2="t:speech r:abstr"/>показание</w> <w><ana lex="давление" gr="S,gen,inan,n,norm,sg" sem="t:impact der:v r:abstr der:s0" sem2="r:abstr t:param"/>давления</w>.</se><se> <w><ana lex="ночь" gr="S,f,gen,inan,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2=""/>Ночи</w> <w><ana lex="тихий" gr="A,nom,norm,pl,plen" sem="d:neg t:sound r:qual" sem2="d:neg t:humq t:speed:min der:shift t:sound r:qual"/>тихие</w>, <w><ana lex="облачный" gr="A,nom,norm,pl,plen" sem="r:rel der:s" sem2="t:physq r:rel der:s"/>облачные</w>.</se></p>
<p><se><b/><w><b>11</b></w><b>/</b><w><ana lex="iv" gr="bastard" sem="" sem2=""/><b>IV</b></w><b>, </b><w><ana lex="t" gr="bastard" sem="" sem2=""/><b>T</b></w><b/>. <w><ana lex="серенький" gr="A,acc,n,norm,plen,sg" sem="d:dim dt:physq:color der:a t:physq:color r:qual" sem2=""/>Серенькое</w> <w><ana lex="утро" gr="S,acc,inan,n,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утро</w>, <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="свет" gr="S,anim,dat,m,norm,persn,sg" sem="" sem2="t:hum ev:posit r:concr"/><ana lex="свет" gr="S,dat,inan,m,norm,sg" sem="t:space r:concr r:abstr t:light" sem2="t:tool t:pers t:light r:abstr t:weather sc:hum pt:aggr r:concr"/>свету</w> <w><ana lex="пройти" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="пройти" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="проходить" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2=""/>прошел</w> <w><ana lex="дождь" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2="pt:set sc:x r:concr"/>дождь</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="затем" gr="ADV,norm" sem="der:apro t:time r:dem" sem2=""/>затем</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="снежный" gr="A,f,nom,norm,plen,sg" sem="dt:stuff r:rel der:s" sem2="t:physq:color r:qual"/>снежная</w> <w><ana lex="крупа" gr="S,f,inan,nom,norm,sg" sem="pt:aggr t:stuff r:concr sc:fruit" sem2="pt:aggr t:stuff r:concr sc:qtm"/>крупа</w>.</se></p>
<p><se><w>Надо</w> <w><ana lex="подчеркнуть" gr="V,act,inf,norm,pf" sem="der:v d:pref" sem2="der:v d:pref"/>подчеркнуть</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="весь" gr="APRO,nom,norm,pl" sem="r:spec" sem2=""/>все</w> <w><ana lex="автомобиль" gr="S,inan,m,nom,norm,pl" sem="t:tool:transp r:concr" sem2=""/>автомобили</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="калганский" gr="S,anim,dat,famn,m,norm,sg" sem="" sem2=""/>Калганскому</w> <w><ana lex="путь" gr="S,gen,inan,m,norm,sg" sem="top:stripe t:space r:concr" sem2="ev:posit t:space t:asp r:abstr sc:space pt:aggr:aggrpl pt:aggr top:stripe r:concr der:shift"/>пути</w> <w><ana lex="бывать" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="t:be:exist ca:noncaus der:v d:impf" sem2="der:v t:loc der:shift d:impf ca:noncaus"/>бывают</w> <w><ana lex="перегрузить" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="ca:caus t:move d:pref" sem2="d:pref"/>перегружены</w> <w><ana lex="китаец" gr="S,anim,ins,m,norm,pl" sem="" sem2=""/>китайцами</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="невозможность" gr="S,f,gen,inan,norm,sg" sem="d:neg der:a r:abstr t:mod" sem2=""/>невозможности</w>: <w><ana lex="сидеть" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:noncaus"/>сидят</w> <w><ana lex="буквально" gr="ADV,norm" sem="der:a" sem2="der:a t:mod"/>буквально</w> <w><ana lex="китаец" gr="S,anim,m,nom,norm,sg" sem="" sem2=""/>китаец</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="китаец" gr="S,anim,loc,m,norm,sg" sem="" sem2=""/>китайце</w>, <w><ana lex="тогда" gr="ADVPRO,norm" sem="t:time r:dem" sem2="r:dem"/>тогда</w> <w><ana lex="как" gr="ADVPRO,norm" sem="r:rel t:manner" sem2=""/>как</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="отношение" gr="S,dat,inan,n,norm,sg" sem="der:v r:abstr der:s0 t:inter" sem2="der:v t:text r:concr r:abstr t:inter"/>отношению</w> <w><