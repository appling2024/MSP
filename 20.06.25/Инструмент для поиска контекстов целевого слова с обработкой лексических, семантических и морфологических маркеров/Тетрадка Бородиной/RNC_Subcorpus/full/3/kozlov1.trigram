<p><se><w><ana lex="около" gr="PR,norm" sem="" sem2=""/>Около</w> <w><ana lex="4" gr="NUM,ciph"/>4</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дня</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="послать" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:caus t:move d:pref" sem2="d:pref"/>послал</w> <w><ana lex="телеграмма" gr="S,acc,f,inan,norm,sg" sem="der:comp r:concr t:text" sem2=""/>телеграмму</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="москва" gr="S,acc,f,inan,norm,sg" sem="r:propn t:topon" sem2="r:propn t:topon"/>Москву</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="кремль" gr="S,acc,inan,m,norm,sg" sem="t:space t:constr r:concr" sem2=""/>Кремль</w>, <w>Н</w>. <w>П</w>. <w><ana lex="горбунов" gr="S,anim,dat,famn,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Горбунову</w>: «<w><ana lex="на" gr="PR,norm" sem="" sem2=""/>На</w> <w><ana lex="какой" gr="APRO,loc,norm,pl" sem="t:neg r:rel ev:neg" sem2=""/>каких</w> <w><ana lex="начало" gr="S,inan,loc,n,norm,pl" sem="pt:phase r:abstr pc:x pt:part pc:pc:x r:concr" sem2="t:asp r:abstr pt:part"/>началах</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="какой" gr="APRO,acc,inan,norm,pl" sem="t:neg r:rel ev:neg" sem2=""/>какие</w> <w><ana lex="средство" gr="S,acc,inan,n,norm,pl" sem="r:abstr" sem2="sc:money t:tool t:stuff hi:class r:abstr t:poss pt:aggr:aggrpl sc:tool r:concr pc:money"/>средства</w> <w><ana lex="командироваться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="" sem2=""/>командируется</w> <w><ana lex="убугунов" gr="S,anim,bastard,famn,m,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Убугунов</w> ?</se><se>. <w><ana lex="просить" gr="V,1p,act,in