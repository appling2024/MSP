,f,norm,sg" sem="r:pers" sem2=""/>ее</w> <w><ana lex="наружу" gr="ADV,norm" sem="t:dir der:a" sem2="der:a"/>наружу</w>.</se><se> <w><ana lex="монгол" gr="S,anim,m,nom,norm,pl" sem="" sem2=""/>Монголы</w> <w><ana lex="верить" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="t:ment ca:noncaus d:root der:s" sem2="ca:noncaus d:root der:s"/>верят</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="благополучный" gr="A,acc,inan,m,norm,plen,sg" sem="ev:posit r:rel d:bon" sem2=""/>благополучный</w> <w><ana lex="исход" gr="S,acc,inan,m,norm,sg" sem="t:move r:abstr" sem2="pt:phase r:abstr"/>исход</w> <w><ana lex="всякий" gr="APRO,gen,n,norm,sg" sem="r:spec" sem2=""/>всякого</w> <w><ana lex="затмение" gr="S,gen,inan,n,norm,sg" sem="r:abstr" sem2="t:psych r:abstr"/>затмения</w> -- <w><ana lex="солнечный" gr="A,gen,m,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s"/>солнечного</w>, <w><ana lex="лунный" gr="A,gen,m,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s"/>лунного</w> (<w><ana lex="частичный" gr="A,gen,m,norm,plen,sg" sem="r:rel der:s" sem2=""/>частичного</w>, <w><ana lex="полный" gr="A,gen,m,norm,plen,sg" sem="t:content r:qual" sem2="t:degr t:appearance r:qual"/>полного</w>) <w><ana lex="потому" gr="ADVPRO,norm" sem="der:apro r:dem" sem2=""/>потому</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="дракон" gr="S,anim,m,nom,norm,sg" sem="" sem2="t:animal r:concr"/>дракон</w>, <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="воздушный" gr="A,acc,n,norm,plen,sg" sem="dt:stuff r:rel der:s" sem2="dt:stuff r:rel der:s"/>воздушное</w> <w><ana lex="чудовище" gr="S,acc,anim,n,norm,sg" sem="" sem2="t:hum r:concr der:s ev:neg"/>чудовище</w>, <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="иметь" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="ca:noncaus d:root t:poss" sem2="d:root"/>имеет</w> <w><ana lex="желудок" gr="S,gen,inan,m,norm,sg" sem="pc:hum pt:partb:org