<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="я" gr="SPRO,1p,gen,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>был</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="интересный" gr="A,m,nom,norm,plen,sg" sem="dt:abstr der:s dt:ment r:qual" sem2="dt:abstr ev:posit der:s dt:ment r:qual"/>интересный</w> <w><ana lex="гость" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr" sem2="t:hum der:shift r:concr"/>гость</w> -- <w><ana lex="дона" gr="S,anim,f,ins,norm,sg" sem="t:hum r:propn t:persn" sem2=""/>Доной-бэйсэ</w> (<w><ana lex="сайн" gr="S,anim,bastard,m,nom,persn,sg" sem="" sem2=""/>Сайн-нойонского</w> <w><ana lex="хошун" gr="S,gen,inan,m,norm,sg" sem="" sem2=""/>хошуна</w>), <w><ana lex="учитель" gr="S,anim,m,nom,norm,sg" sem="der:v t:hum r:concr d:nag t:prof" sem2="der:v t:hum r:concr d:nag"/>учитель</w> <w><ana lex="сайн" gr="S,anim,bastard,m,nom,persn,sg" sem="" sem2=""/>Сайн-нойона</w>, <w><ana lex="проживать" gr="V,act,ipf,m,nom,norm,partcp,plen,praes,sg,tran" sem="t:be:exist ca:noncaus der:v d:pref d:impf" sem2="der:v d:pref d:impf"/><ana lex="проживать" gr="V,act,intr,ipf,m,nom,norm,partcp,plen,praes,sg" sem="t:be:exist ca:noncaus der:v d:pref d:impf" sem2="der:v d:pref d:impf"/>проживающий</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana form="северо-восточного" lex="северо-восточный" gr="A,gen,n,norm,plen,sg" sem="t:place der:comp r:rel dt:space" sem2=""/>северо-восточного</w> <w><ana lex="подножие" gr="S,gen,inan,n,norm,sg" sem="t:space pc:constr der:s pt:part pc:space r:concr" sem2=""/>подножия</w> <w><ana lex="баг" gr="S,bastard,gen,inan,m,sg" sem="" sem2=""/>Бага-богдо</w>.</se><se> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>Мы</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""