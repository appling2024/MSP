" sem="" sem2=""/>или</w>, <w><ana lex="точный" gr="A,comp,norm,plen" sem="r:qual" sem2="r:qual"/>точнее</w>, <w><ana lex="госторг" gr="S,bastard,inan,m,nom,sg" sem="" sem2=""/>Госторг</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="серебро" gr="S,inan,ins,n,norm,sg" sem="t:stuff r:concr" sem2="sc:thing t:stuff sc:money:banknote sc:money pt:aggr r:concr"/>серебром</w>, <w><ana lex="хотя" gr="CONJ,norm" sem="" sem2=""/>хотя</w> <w><ana lex="бы" gr="PART,norm" sem="" sem2=""/>бы</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="количество" gr="S,inan,loc,n,norm,sg" sem="t:quant r:abstr" sem2="r:abstr"/>количестве</w> <w><ana lex="примерно" gr="ADV,norm" sem="der:a" sem2=""/>примерно</w> <w><ana lex="30-50" gr="NUM,ciph"/>30-50</w>% <w><ana lex="стоимость" gr="S,f,gen,inan,norm,sg" sem="der:v r:abstr" sem2="der:v r:abstr"/>стоимости</w> (<w><ana lex="продажный" gr="A,f,gen,norm,plen,sg" sem="der:v dt:poss r:rel" sem2="der:v dt:poss t:humq ev:neg r:qual"/>продажной</w>) <w><ana lex="верблюд" gr="S,anim,gen,m,norm,pl" sem="t:animal r:concr" sem2=""/>верблюдов</w>.</se></p>
<p><se><w><ana lex="последний" gr="A,ins,m,norm,plen,sg" sem="r:rel t:ord" sem2="t:degr:max:magn r:qual r:rel ev:neg t:time"/>Последним</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>был</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="я" gr="SPRO,1p,acc,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="вечер" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>вечером</w> <w><ana lex="павлов" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Павлов</w> <w>Н</w>. <w>В</w>., <w><ana lex="доложить" gr="V,act,m,nom,norm,partcp,pf,plen,praet,sg" sem="t:speech ca:noncaus ca:caus d:pref t:put" sem2="t:speech ca:noncaus d:pref"/>доложивший</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="свой" gr="APRO,loc,norm,pl" sem="r:poss" sem2="t:social r:poss"/>своих</w> <w><ana lex="материал" gr="S,inan,loc,m,norm,pl" sem="t:stuff r:concr" sem2="t:stuff t:text hi:class r:abstr sc:doc r:concr"/>материалах</w>, <w><ana lex="собрать" gr="V,loc,norm,partcp,pass,pf,pl,plen,praet" sem="d:pref" sem2="ca:caus d:pref t:poss"/>собранных</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="часть" gr="S,f,inan,loc,norm,sg" sem="r:concr pc:x pt:part" sem2="pc:org r:abstr sc:part t:org pt:ind pt:aggr:aggrpl t:poss der:shift pc:x pt:part pc:text r:concr"/>части</w> <w><ana lex="священный" gr="A,gen,m,norm,plen,sg" sem="ev r:rel" sem2="r:rel"/>священного</w> <w><ana lex="массив" gr="S,gen,inan,m,norm,sg" sem="pt:set t:space r:concr sc:space" sem2="pt:set sc:constr:build t:space r:concr sc:plant"/>массива</w> <w><ana lex="богдо" gr="ADV,bastard" sem="" sem2=""/>Богдо-ула</w>.</se><se> <w><ana lex="ночь" gr="S,f,inan,ins,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2=""/>Ночью</w> <w><ana lex="падать" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="ca:noncaus t:move d:root" sem2="d:root"/>падал</w> <w><ana lex="