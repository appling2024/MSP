<p><se><w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="заключение" gr="S,acc,inan,n,norm,sg" sem="t:put der:v r:abstr der:s0" sem2="t:text t:ment:result t:put pt:phase r:abstr der:v pc:workmus pt:part pc:text r:concr"/>заключение</w>: <w><ana lex="алексей" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Алексей</w> <w><ana lex="николаевич" gr="S,anim,m,nom,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Николаевич</w> -- <w><ana lex="лучший" gr="A,f,nom,norm,sg,supr" sem="d:super ev:posit der:a t:quality r:qual" sem2=""/>лучшая</w> <w><ana lex="кладовая" gr="S,f,inan,nom,norm,sg" sem="der:subst top:contain der:a pc:constr:build t:room pt:part pc:room:appart r:concr" sem2="sc:thing der:subst t:space r:concr der:a"/>кладовая</w> <w><ana lex="при" gr="PR,norm" sem="" sem2=""/>при</w> <w><ana lex="прежний" gr="A,dat,f,norm,plen,sg" sem="r:rel t:time" sem2="r:rel t:time"/>прежней</w> <w><ana lex="почта" gr="S,dat,f,inan,norm,sg" sem="sc:org pt:aggr r:concr t:org pt:ind" sem2="sc:thing r:abstr t:org pt:aggr r:concr sc:text"/>почте</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="распоряжение" gr="S,inan,loc,n,norm,sg" sem="t:speech der:v r:abstr der:s0" sem2="t:speech r:abstr"/>распоряжении</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w>.</se><se> <w><ana lex="великолепный" gr="A,n,nom,norm,plen,sg" sem="ev:posit t:quality r:qual" sem2="ev:posit t:appearance r:qual"/>Великолепное</w> <w><ana lex="решение" gr="S,inan,n,nom,norm,sg" sem="t:ment der:v r:abstr der:s0" sem2="t:ment t:psych:volit t:text t:ment:result r:abstr der:v der:shift r:concr"/>решение</w>!</se><se> <w><ana lex="следовать" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="ca:noncaus t:move der:s" sem2="ca:noncaus t:move der:s"/>Следует</w> <w><ana lex="лишь" gr="PART,norm" sem="" sem2=""/>лишь</w> <w><ana lex="она" gr="SPRO,3