<p><se><b/><w><b>15</b></w><b>/</b><w><ana lex="xii" gr="bastard" sem="" sem2=""/><b>XII</b></w><b>, </b><w><ana lex="w" gr="bastard" sem="" sem2=""/><b>W</b></w><b/>. <w>Ясно</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="почти" gr="ADV,norm" sem="" sem2=""/>почти</w> <w><ana lex="ясно" gr="ADV,norm" sem="ev:posit dt:light der:a" sem2="ev:posit dt:light der:a"/>ясно</w>, <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w>морозно</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="проч" gr="S,anim,bastard,m,nom,sg" sem="" sem2=""/><ana lex="проча" gr="S,bastard,f,gen,inan,pl" sem="" sem2=""/>проч</w>.</se><se> <w><ana lex="холод" gr="S,inan,m,nom,norm,sg" sem="t:temper r:abstr t:weather" sem2="t:manif:emot r:abstr t:temper t:physiol t:manif:disease t:fam"/>Холод</w> <w><ana lex="много" gr="ADV,comp,norm" sem="t:quant:max r:spec" sem2="t:degr:max"/><ana lex="больше" gr="ADV,norm" sem="der:adv" sem2="t:quant"/>больше</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="много" gr="ADV,comp,norm" sem="t:quant:max r:spec" sem2="t:degr:max"/><ana lex="больше" gr="ADV,norm" sem="der:adv" sem2="t:quant"/>больше</w> <w><ana lex="проникать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v d:pref" sem2=""/>проникает</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="окно" gr="S,gen,inan,n,norm,sg" sem="t:tool t:space pc:constr:build pt:part top:vertical r:concr top:hole" sem2="t:space r:abstr pc:constr pt:part t:time r:concr"/>окна</w> <w><ana lex="дом" gr="S,gen,inan,m,norm,pl" sem="top:contain t:constr:build r:concr" sem2="sc:hum pt:set t:space t:org t:group der:shift r:concr"/>домов</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="вид" gr="S,anim,famn,loc,m,norm,sg" sem="" sem2=""/><ana lex="вид" gr="S,inan,loc,m,norm,sg" sem="der:v r:abstr" sem2="t:ment t:space r:abstr t:workart der:v t:perc r:concr t:fam"/>виде</w> <w><ana lex="сплошной" gr="A,gen,n