<p><se><b/><w><b>9</b></w><b>/</b><w><ana lex="iii" gr="bastard" sem="" sem2=""/><b>III</b></w><b>, </b><w><ana lex="q" gr="bastard" sem="" sem2=""/><b>Q</b></w><b/>. <w><ana lex="настоящий" gr="A,f,nom,norm,plen,sg" sem="r:rel t:time" sem2="ev:posit r:dem t:ver t:degr t:degr:max r:qual r:rel"/>Настоящая</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="окончательный" gr="A,f,nom,norm,plen,sg" sem="der:v r:rel" sem2="t:degr:max r:qual"/>окончательная</w> <w><ana lex="масленица" gr="S,f,inan,nom,norm,sg" sem="r:abstr" sem2=""/>масленица</w> -- <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="утро" gr="S,gen,inan,n,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утра</w> <w><ana lex="тихий" gr="A,brev,n,norm,sg" sem="d:neg t:sound r:qual" sem2="d:neg t:humq t:speed:min der:shift t:sound r:qual"/>тихо</w>, <w><ana lex="прозрачный" gr="A,brev,n,norm,sg" sem="" sem2="r:qual"/>прозрачно</w>, <w><ana lex="ясный" gr="A,brev,n,norm,sg" sem="r:qual" sem2="r:qual"/>ясно</w>.</se><se> <w><ana lex="васильев" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Васильев</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w>К<sup>о</sup></w><sup/> <w><ana lex="отправиться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus t:move d:pref" sem2=""/>отправились</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="сангина" gr="S,f,gen,inan,norm,pl" sem="" sem2=""/>Сангин</w>: <w><ana lex="кто" gr="SPRO,anim,m,nom,norm,sg" sem="r:rel" sem2=""/>кто</w> <w><ana lex="верхом" gr="ADV,norm" sem="der:s" sem2="der:s"/>верхом</w>, <w><ana lex="кто" gr="SPRO,anim,m,nom,norm,sg" sem="r:rel" sem2=""/>кто</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="автомобиль" gr="S,inan,loc,m,norm,sg" sem="t:tool:transp r:concr" sem2=""/>автомобиле</w>.</se><se> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>Я</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex