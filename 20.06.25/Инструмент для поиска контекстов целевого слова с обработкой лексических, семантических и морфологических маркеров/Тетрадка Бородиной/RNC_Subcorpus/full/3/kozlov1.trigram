" sem="der:v ca:caus t:poss t:impact ca:noncaus d:pref" sem2=""/>покупают</w> <w><ana lex="фураж" gr="S,inan,m,nom,norm,sg" sem="t:food:fodder t:stuff r:concr" sem2=""/>фураж</w> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="лошадь" gr="S,anim,f,gen,norm,pl" sem="t:animal r:concr" sem2=""/>лошадей</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="проч" gr="S,anim,bastard,m,nom,sg" sem="" sem2=""/><ana lex="проча" gr="S,bastard,f,gen,inan,pl" sem="" sem2=""/>проч</w>.</se><se> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>Очень</w> <w>неприятно</w> <w><ana lex="иногда" gr="ADV,norm" sem="r:spec t:time" sem2=""/>иногда</w> <w><ana lex="спать" gr="V,act,inf,intr,ipf,norm" sem="d:root" sem2="d:root"/>спать</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="зимовье" gr="S,acc,inan,n,norm,sg" sem="r:abstr" sem2="der:v t:space r:concr"/>зимовье</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="жарко" gr="ADV,norm" sem="dt:physq:temper ev der:a" sem2=""/>жарко</w> <w><ana lex="натопить" gr="V,f,loc,norm,partcp,pass,pf,plen,praet,sg" sem="der:v d:pref" sem2=""/>натопленной</w> <w><ana lex="хибарка" gr="S,f,inan,loc,norm,sg" sem="d:dim t:constr r:concr der:s" sem2=""/>хибарке</w>, <w>нечем</w> <w><ana lex="дышать" gr="V,act,inf,intr,ipf,norm" sem="ca:noncaus t:physiol d:root" sem2="d:root"/>дышать</w> (<w><ana lex="вследствие" gr="PR,norm" sem="" sem2=""/>вследствие</w> <w><ana lex="переполнение" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr" sem2=""/>переполнения</w> <w><ana lex="человек" gr="S,anim,ins,m,norm,pl" sem="t:hum r:concr" sem2="t:hum ev:posit r:concr"/>людьми</w>).</se><se> <w><ana lex="обыкновенно" gr="ADV,norm" sem="der:a t:time" sem2="der:a"/>Обыкновенно</w> <w><ana lex="весь" gr="APRO,f,nom,norm,sg" sem="r:spec" sem2=""/>вся</w> <w><ana lex="семья" gr="S,f,inan,nom,norm,sg" sem="t:group pt:set r:concr sc:hum:kin" sem2="pt:set der:shift r:concr sc:animal hi:class"/>семья