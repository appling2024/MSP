<p><se><b/><w><b>20</b></w><b>/</b><w><ana lex="ii" gr="bastard" sem="" sem2=""/><b>II</b></w><b>, </b><w><ana lex="s" gr="bastard" sem="" sem2=""/><b>S</b></w><b/>. <w><ana lex="то" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>То</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="ранний" gr="A,comp,norm,plen" sem="t:time r:qual" sem2="t:time r:qual"/>раньше</w>, -- <w><ana lex="холодный" gr="A,m,nom,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодный</w> <w><ana lex="пронизывать" gr="V,act,ipf,m,nom,norm,partcp,plen,praes,sg,tran" sem="der:v d:pref d:impf" sem2=""/>пронизывающий</w> <w><ana lex="ветер" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>ветер</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana form="северо-запада" lex="северо-запад" gr="S,gen,inan,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr pt:part pc:space"/>северо-запада</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="унылый" gr="A,f,nom,norm,plen,sg" sem="dt:abstr dt:psych:emot der:s r:qual" sem2=""/>унылая</w> <w><ana lex="тишина" gr="S,anim,f,famn,nom,norm,sg" sem="" sem2=""/><ana lex="тишина" gr="S,f,inan,nom,norm,sg" sem="t:neg t:sound r:abstr t:fam" sem2="r:abstr"/>тишина</w> <w><ana lex="кругом" gr="ADV,norm" sem="t:place der:s" sem2="der:s"/>кругом</w>.</se><se> <w>Короче</w>, <w>холодно</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w>мертво</w>, <w><ana lex="ни" gr="PART,norm" sem="" sem2=""/>ни</w> <w><ana lex="один" gr="APRO,gen,m,norm,sg" sem="" sem2="r:indet"/>одного</w> <w><ana lex="приятный" gr="A,gen,m,norm,plen,sg" sem="ev:posit r:qual" sem2="ev:posit t:humq r:qual"/>приятного</w> <w><ana lex="звук" gr="S,gen,inan,m,norm,s