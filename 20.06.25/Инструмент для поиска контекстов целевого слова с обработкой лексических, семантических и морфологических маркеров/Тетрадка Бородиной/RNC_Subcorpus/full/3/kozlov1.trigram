<p><se><w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>Мы</w> <w><ana lex="жить" gr="V,1p,act,indic,intr,ipf,norm,pl,praes" sem="t:be:exist ca:noncaus d:root" sem2="d:root"/>живем</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="окраина" gr="S,f,inan,loc,norm,sg" sem="pc:space r:concr der:s pt:part" sem2="pc:space r:concr der:s pt:part"/>окраине</w> <w><ana lex="город" gr="S,gen,inan,m,norm,sg" sem="sc:constr:build t:space r:concr" sem2="t:space r:concr"/>города</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="пользоваться" gr="V,1p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus" sem2="ca:noncaus"/>пользуемся</w> <w><ana lex="лучший" gr="A,ins,norm,pl,supr" sem="d:super ev:posit der:a t:quality r:qual" sem2=""/>лучшими</w> <w><ana lex="сторона" gr="S,f,inan,ins,norm,pl" sem="t:space r:concr pt:part pc:space" sem2="sc:hum t:space t:asp:ment r:abstr pt:set pc:x pt:part pc:space r:concr pc:form:geom"/>сторонами</w> <w><ana lex="это" gr="SPRO,gen,inan,n,norm,sg" sem="r:dem" sem2=""/>этого</w>: <w>во-первых</w>, <w><ana lex="дышать" gr="V,1p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus t:physiol d:root" sem2="d:root"/>дышим</w> <w><ana lex="чистый" gr="A,ins,m,norm,plen,sg" sem="t:physst r:qual" sem2="t:physq ev:posit t:humq t:degr r:qual"/>чистым</w> <w><ana lex="воздух" gr="S,inan,ins,m,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>воздухом</w>, <w>во-вторых</w>, <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="видеть" gr="V,1p,act,indic,ipf,norm,pl,praes,tran" sem="ca:noncaus t:perc d:root" sem2="t:ment ca:noncaus d:root"/>видим</w> <w><ana lex="многолюдство" gr="S,gen,inan,n,norm,sg" sem="r:abstr" sem2=""/>многолюдства</w>.</se><se> <w><ana lex="поездка" gr="S,f,inan,nom,norm,sg" sem="t:move r:abstr" sem2=""/>Поездка</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="город" gr="S,acc,inan,m,norm,sg" sem="sc:constr:build t:space r:concr" sem2="t:space