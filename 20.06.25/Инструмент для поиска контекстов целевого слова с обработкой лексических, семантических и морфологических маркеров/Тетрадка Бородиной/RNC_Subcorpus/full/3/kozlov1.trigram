<p><se><w><ana lex="к" gr="PR,norm" sem="" sem2=""/>К</w> <w><ana lex="10" gr="NUM,ciph"/>10</w> <w><ana lex="час" gr="S,dat,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часам</w> <w><ana lex="утро" gr="S,gen,inan,n,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утра</w> <w><ana lex="небо" gr="S,inan,n,nom,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/><ana lex="небо" gr="S,inan,n,nom,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/>небо</w> <w><ana lex="освободиться" gr="V,act,indic,intr,n,norm,pf,praet,sg" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref"/>освободилось</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="облако" gr="S,gen,inan,n,norm,pl" sem="qc:stuff r:concr" sem2="qc:stuff pt:qtm top:form r:concr"/>облаков</w>, <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="исключение" gr="S,inan,ins,n,norm,sg" sem="t:put der:v r:abstr der:s0" sem2="r:abstr"/>исключением</w> <w><ana lex="горизонт" gr="S,gen,inan,m,norm,sg" sem="t:space r:concr" sem2="t:ment t:space qc:stuff pt:qtm r:abstr pt:aggr r:concr"/>горизонта</w>, <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="который" gr="APRO,dat,m,norm,sg" sem="r:rel t:ord" sem2=""/>которому</w> <w><ana lex="располагаться" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="der:v t:loc d:pref ca:noncaus" sem2=""/>располагались</w> <w><ana lex="кучевой" gr="A,nom,norm,pl,plen" sem="r:rel der:s" sem2=""/>кучевые</w> <w><ana lex="светлый" gr="A,nom,norm,pl,plen" sem="t:physq:color r:qual" sem2="ev:posit r:qual"/>светлые</w> <w><ana lex="облако" gr="S,inan,n,nom,norm,pl" sem="qc:stuff r:concr" sem2="qc:stuff pt:qtm top:form r:concr"/>облака</w>.</se><se> <w><ana lex="солнце" gr="S,inan,n,nom,norm,sg" sem="top:horiz top:spher t:astr t:space r:concr" s