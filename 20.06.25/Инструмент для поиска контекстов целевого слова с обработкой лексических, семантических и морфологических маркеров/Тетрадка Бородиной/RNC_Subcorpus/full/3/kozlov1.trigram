<p>...<se><w><ana lex="после" gr="PR,norm" sem="" sem2=""/>После</w> <w><ana lex="несколько" gr="NUM,gen,norm" sem="" sem2=""/>нескольких</w> <w><ana lex="день" gr="S,gen,inan,m,norm,pl" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дней</w> <w><ana lex="отсутствие" gr="S,gen,inan,n,norm,sg" sem="r:abstr" sem2=""/>отсутствия</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="облава" gr="S,acc,f,inan,norm,sg" sem="r:abstr" sem2="r:abstr"/>облаву</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w>, <w><ana lex="точный" gr="A,comp,norm,plen" sem="r:qual" sem2="r:qual"/>точнее</w>, <w><ana lex="зоологический" gr="A,acc,f,norm,plen,sg" sem="r:rel der:s" sem2="r:rel der:s"/>зоологическую</w> <w><ana lex="экскурсия" gr="S,acc,f,inan,norm,sg" sem="t:action t:move r:abstr" sem2="t:group pt:set r:concr sc:hum"/>экскурсию</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="именно" gr="PART,norm" sem="" sem2=""/>именно</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="воскресение" gr="S,acc,inan,n,norm,sg" sem="t:be:exist der:v r:abstr der:s0" sem2=""/>воскресенье</w>, <w><ana lex="понедельник" gr="S,acc,inan,m,norm,sg" sem="t:time:week r:abstr" sem2="t:fam"/>понедельник</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="вторник" gr="S,acc,inan,m,norm,sg" sem="t:time:week r:abstr" sem2=""/>вторник</w> (<w><ana lex="вечер" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>вечером</w> <w><ana lex="который" gr="APRO,gen,n,norm,sg" sem="r:rel t:ord" sem2=""/>которого</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="узко" gr="ADV,comp,norm" sem="dt:size:min der:a" sem2="dt:size:min der:a"/><ana lex="уже" gr="ADV,norm" sem="t:time" sem2=""/>уже</w> <w><ana lex="возвратиться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="der:v ca:noncaus t:move d:pref" sem2=""/>возвратились</w> <w><ana lex="д