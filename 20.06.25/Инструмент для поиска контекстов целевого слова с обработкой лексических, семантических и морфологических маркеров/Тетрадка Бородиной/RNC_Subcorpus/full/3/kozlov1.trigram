<p><se><w><ana lex="удаться" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref"/>Удастся</w> <w><ana lex="ли" gr="PART,norm" sem="" sem2=""/>ли</w> <w><ana lex="леночка" gr="S,anim,dat,f,norm,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Леночке</w> <w><ana lex="выехать" gr="V,act,inf,intr,norm,pf" sem="ca:noncaus t:move d:pref" sem2="d:pref"/><ana lex="выехать" gr="V,act,inf,norm,pf" sem="ca:noncaus t:move d:pref" sem2="d:pref"/>выехать</w> <w><ana lex="вовремя" gr="ADV,norm" sem="ev:posit der:s t:time" sem2=""/>вовремя</w>, <w><ana lex="что" gr="SPRO,inan,n,nom,norm,sg" sem="r:rel" sem2=""/>что</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="важный" gr="A,brev,n,norm,sg" sem="t:hier r:qual" sem2="t:quality ev:posit t:hier r:qual"/>важно</w>, <w><ana lex="чтобы" gr="CONJ,norm" sem="" sem2=""/>чтобы</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="сидеть" gr="V,act,inf,intr,ipf,norm" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:noncaus"/>сидеть</w> <w><ana lex="дорога" gr="S,f,inan,ins,norm,sg" sem="top:stripe t:space r:concr t:fam" sem2="t:move dt:space r:abstr der:shift t:space r:concr"/>дорогой</w>!</se><se> <w><ana lex="вот" gr="PART,norm" sem="" sem2="r:dem"/>Вот</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="пшевочка" gr="S,anim,bastard,m,nom,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Пшевочка</w> -- <w><ana lex="обещать" gr="V,act,f,indic,norm,pf,praet,sg,tran" sem="t:speech ca:noncaus d:pref der:s" sem2="d:pref der:s"/><ana lex="обещать" gr="V,act,f,indic,ipf,norm,praet,sg,tran" sem="t:speech ca:noncaus d:pref der:s" sem2="d:pref der:s"/>обещала</w> <w><ana lex="прибыть" gr="V,act,inf,intr,norm,pf" sem="ca:noncaus t:move d:pref" sem2="d:pref"/>прибыть</w> <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>сегодня</w> <w><ana lex="и" gr="CONJ,norm" se