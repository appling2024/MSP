<p><se><w><ana lex="наконец" gr="ADV,PARENTH,norm" sem="der:s t:time" sem2=""/>Наконец</w> <w><ana lex="минута" gr="S,f,inan,nom,norm,sg" sem="t:unit t:time:moment r:abstr pc:time" sem2="t:unit der:shift t:time:period r:abstr pc:time"/>минута</w> <w><ana lex="расставание" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr" sem2=""/>расставания</w>.</se><se> <w><ana lex="потянуться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>Потянулись</w> <w><ana lex="телега" gr="S,f,inan,nom,norm,pl" sem="t:tool:transp r:concr" sem2="t:speech r:abstr ev:neg"/>телеги</w>.</se><se> <w><ana lex="они" gr="SPRO,3p,gen,norm,pl" sem="r:pers" sem2=""/>Их</w> <w><ana lex="целый" gr="A,acc,inan,m,norm,plen,sg" sem="t:degr r:qual" sem2="t:degr r:spec r:qual"/>целый</w> <w><ana lex="транспорт" gr="S,acc,inan,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="r:abstr pt:set t:tool:transp pt:aggr sc:tool:transp r:concr"/>транспорт</w>.</se><se> <w><ana lex="впоследствии" gr="ADV,norm" sem="der:s t:time" sem2=""/>Впоследствии</w> <w><ana lex="половина" gr="S,f,inan,nom,norm,sg" sem="t:share r:concr r:abstr pt:part pc:x" sem2="pc:constr:build r:abstr pc:room pt:part pc:group t:hum:kin ev r:concr"/><ana lex="половина" gr="S,anim,f,nom,norm,sg" sem="" sem2=""/>половина</w> -- <w><ana lex="глаголевский" gr="A,bastard,f,nom,plen,sg" sem="" sem2=""/>Глаголевская</w>, <w><ana lex="половина" gr="S,f,inan,nom,norm,sg" sem="t:share r:concr r:abstr pt:part pc:x" sem2="pc:constr:build r:abstr pc:room pt:part pc:group t:hum:kin ev r:concr"/><ana lex="половина" gr="S,anim,f,nom,norm,sg" sem="" sem2=""/>половина</w> -- <w><ana lex="павловский" gr="A,f,nom,norm,plen,sg" sem="" sem2=""/>Павловская</w>.</se><se> <w><ana lex="мальчик" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr" sem2="t:hum r:concr"/>Мальчики</w> <w><ana lex="рассыпанный" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="" sem2=""/><ana lex="рассыпать" gr="V,brev,norm,partcp,pass,pf,pl,praet,tran" sem="ca:caus t