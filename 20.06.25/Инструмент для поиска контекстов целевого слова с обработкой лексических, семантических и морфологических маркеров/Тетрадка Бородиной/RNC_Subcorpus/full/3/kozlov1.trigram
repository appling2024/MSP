<p><se><w><ana lex="до" gr="PR,norm" sem="" sem2=""/>До</w> <w><ana lex="станция" gr="S,f,inan,loc,norm,sg" sem="pt:set sc:constr t:space r:concr top:horiz" sem2="t:constr pc:space r:concr r:abstr t:org"/>станции</w> <w><ana lex="званка" gr="S,anim,bastard,f,nom,sg" sem="" sem2=""/>Званка</w>, <w><ana lex="обитель" gr="S,f,inan,nom,norm,pl" sem="der:v r:concr t:org" sem2="der:v t:space r:concr"/>обители</w> <w><ana lex="державин" gr="S,anim,famn,gen,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Державина</w>, <w><ana lex="я" gr="SPRO,1p,acc,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="провожать" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="der:v t:move d:pref" sem2=""/>провожал</w> <w><ana lex="мой" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>мой</w> <w><ana lex="сын" gr="S,anim,m,nom,norm,sg" sem="" sem2="t:hum der:shift ev r:concr"/>сын</w> <w><ana lex="володя" gr="S,anim,m,nom,norm,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Володя</w>, <w><ana lex="разочаровать" gr="V,m,nom,norm,partcp,pass,pf,plen,praet,sg" sem="der:v ca:caus d:pref t:psych:emot" sem2=""/>разочарованный</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="скорый" gr="A,loc,m,norm,plen,sg" sem="t:speed:max r:qual" sem2="t:time r:rel r:qual"/>скором</w> <w><ana lex="отход" gr="S,inan,loc,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:aggr:aggrpl sc:stuff r:concr"/>отходе</w> <w><ana lex="поезд" gr="S,gen,inan,m,norm,sg" sem="sc:tool:transp t:tool:transp r:concr" sem2="pt:set sc:tool:transp r:concr"/>поезда</w> (<w><ana lex="вместо" gr="PR,norm" sem="" sem2=""/>вместо</w> <w><ana lex="40" gr="NUM,ciph"/>40</w> <w><ana lex="минута" gr="S,f,gen,inan,norm,pl" sem="t:unit t:time:moment r:abstr pc:time" sem2="t:unit der:shift t:time:period r:abstr pc:time"/>минут</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="стоять" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:nonca