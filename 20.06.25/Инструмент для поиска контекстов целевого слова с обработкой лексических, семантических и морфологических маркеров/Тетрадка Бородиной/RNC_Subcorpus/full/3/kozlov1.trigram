<p><se><w><ana lex="день" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>Днем</w> <w><ana lex="довольно" gr="ADV,norm" sem="t:degr dt:humq der:a" sem2="ev:posit dt:humq der:a"/>довольно</w> <w>тепло</w>.</se><se> <w><ana lex="весь" gr="APRO,acc,n,norm,sg" sem="r:spec" sem2=""/>Все</w> <w><ana lex="время" gr="S,acc,inan,n,norm,sg" sem="r:abstr t:param t:time" sem2="t:time:period r:abstr t:time"/>время</w>, <w><ana lex="даже" gr="CONJ,norm" sem="" sem2=""/>даже</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="ночь" gr="S,f,gen,inan,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2=""/>ночи</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="самый" gr="APRO,f,nom,norm,sg" sem="r:spec" sem2="r:spec"/>самая</w> <w><ana lex="ночь" gr="S,f,inan,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2=""/>ночь</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="температура" gr="S,f,inan,ins,norm,sg" sem="r:abstr t:param t:temper" sem2="t:physiol r:abstr t:temper"/>температурой</w> <w><ana lex="высокий" gr="A,comp,norm,plen" sem="t:size:max r:qual" sem2="ev:posit der:shift t:size:max t:sound t:degr:max r:qual t:interpretation"/>выше</w> <w><ana lex="ноль" gr="S,gen,inan,m,norm,sg" sem="r:abstr t:card" sem2="t:ciph r:concr"/>нуля</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="2" gr="NUM,ciph"/>2</w>°<w><ana lex="r" gr="bastard" sem="" sem2=""/>R</w>.</se></p>
