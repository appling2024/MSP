<p><se><w><ana lex="получить" gr="V,act,indic,norm,pf,pl,praet" sem="ca:noncaus t:poss" sem2=""/>Получили</w> <w><ana lex="газетка" gr="S,acc,f,inan,norm,sg" sem="d:dim t:book r:concr der:s" sem2=""/>газетку</w>, <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="который" gr="APRO,f,loc,norm,sg" sem="r:rel t:ord" sem2=""/>которой</w> <w><ana lex="узнать" gr="V,act,indic,norm,pf,pl,praet" sem="d:pref" sem2="t:ment ca:noncaus d:pref"/>узнали</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="состояться" gr="V,act,intr,loc,n,norm,partcp,pf,plen,praet,sg" sem="t:be:exist ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>состоявшемся</w> <w><ana lex="назначение" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr der:s0" sem2="r:abstr"/>назначении</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="место" gr="S,acc,inan,n,norm,sg" sem="qc:space t:space r:concr" sem2="qc:space sc:org t:tool t:space pt:element r:abstr pt:aggr:aggrpl pt:part pc:text r:concr"/>место</w> <w><ana lex="председатель" gr="S,anim,gen,m,norm,sg" sem="t:hum r:concr d:nag" sem2=""/>председателя</w> <w>СНК</w>.</se><se> <w><ana lex="избрать" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="d:pref" sem2=""/>Избран</w> <w>А</w>. <w>И</w>. <w><ana lex="рыков" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Рыков</w>.</se><se> <w><ana lex="каменев" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Каменев</w> <w>Л</w>. <w>Б</w>. <w><ana lex="остаться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="t:loc d:pref ca:noncaus" sem2="t:be:exist ca:noncaus d:pref"/>остался</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="свой" gr="APRO,loc,n,norm,sg" sem="r:poss" sem2="t:social r:poss"/>своем</w> <w><ana lex="прежний" gr="A,loc,n,norm,plen,sg" sem="r:rel t:time" sem2="r:rel t:time"/>прежнем</w> <w><ana lex="место" gr="S,inan,loc,n,norm,sg" sem="qc:space t:space r:concr" sem2="qc:space sc:org t:tool t:space pt:element r:a