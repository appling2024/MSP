<p><se><w><ana lex="с" gr="PR,norm" sem="" sem2=""/>С</w> <w><ana lex="редкий" gr="A,ins,n,norm,plen,sg" sem="t:physq r:qual" sem2="t:time t:dist r:qual"/>редким</w> <w><ana lex="удовольствие" gr="S,inan,ins,n,norm,sg" sem="t:psych:emot r:abstr" sem2="ev:posit r:abstr"/>удовольствием</w> <w><ana lex="просмотреть" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:noncaus d:pref t:perc" sem2="der:v ca:noncaus d:pref t:perc"/>просмотрел</w> <w><ana lex="мой" gr="APRO,acc,f,norm,sg" sem="r:poss" sem2=""/>мою</w> <w><ana lex="любимый" gr="A,acc,f,norm,plen,sg" sem="der:v dt:psych:emot ev:posit t:social:emot r:qual" sem2="der:v dt:psych:emot"/>любимую</w> <w><ana lex="маленький" gr="A,acc,f,norm,plen,sg" sem="t:size:min r:qual" sem2="t:time:age t:size:min r:qual"/>маленькую</w> <w><ana lex="книжечка" gr="S,acc,f,inan,norm,sg" sem="d:dim r:concr t:text der:s" sem2=""/>книжечку</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w>Н</w>. <w>М</w>. <w><ana lex="пржевальск" gr="S,inan,ins,m,norm,sg" sem="r:propn t:topon" sem2=""/>Пржевальском</w>, <w><ana lex="останавливаться" gr="V,act,ger,intr,ipf,norm,praes" sem="der:v d:pref d:impf" sem2=""/>останавливаясь</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="называть" gr="V,ipf,loc,norm,partcp,pass,pl,plen,praes,tran" sem="t:speech der:v d:pref d:impf" sem2=""/>называемых</w> «<w><ana lex="вкусненький" gr="A,loc,norm,pl,plen" sem="t:physq:taste der:a d:dim dt:physq:taste r:qual" sem2=""/>вкусненьких</w>» <w><ana lex="место" gr="S,inan,loc,n,norm,pl" sem="qc:space t:space r:concr" sem2="qc:space sc:org t:tool t:space pt:element r:abstr pt:aggr:aggrpl pt:part pc:text r:concr"/>местах</w>.</se><se> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>Так</w> <w><ana lex="называть" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="t:speech der:v d:pref d:impf" sem2=""/>на