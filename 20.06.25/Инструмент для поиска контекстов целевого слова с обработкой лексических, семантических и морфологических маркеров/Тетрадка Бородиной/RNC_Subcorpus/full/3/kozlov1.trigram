<p><se><w><ana lex="однообразно" gr="ADV,norm" sem="dt:like der:a" sem2=""/>Однообразно</w>, <w><ana lex="монотонно" gr="ADV,norm" sem="der:a dt:sound ev:neg" sem2=""/>монотонно</w> <w><ana lex="идти" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus t:move d:root" sem2="ca:noncaus t:move d:root"/>идут</w> <w><ana lex="день" gr="S,inan,m,nom,norm,pl" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дни</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="день" gr="S,inan,ins,m,norm,pl" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>днями</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="урга" gr="S,f,inan,loc,norm,sg" sem="r:propn t:topon" sem2=""/>Урге</w>, <w><ana lex="словно" gr="CONJ,norm" sem="" sem2=""/>словно</w> <w><ana lex="катиться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:move" sem2="ca:noncaus"/><ana lex="катиться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus t:move" sem2="ca:noncaus"/>катится</w> <w><ana lex="колесо" gr="S,inan,n,nom,norm,sg" sem="t:tool r:concr pc:tool:device pt:part top:disk" sem2="t:tool:transp r:concr"/>колесо</w> <w><ana lex="жизнь" gr="S,f,gen,inan,norm,sg" sem="t:be:exist r:abstr" sem2="t:be:exist r:abstr t:time"/>жизни</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="один" gr="APRO,f,loc,norm,sg" sem="" sem2="r:indet"/>одной</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="тот" gr="APRO,f,loc,norm,sg" sem="r:dem" sem2=""/>той</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w> <w><ana lex="равнинный" gr="A,f,loc,norm,plen,sg" sem="dt:space r:rel der:s" sem2=""/>равнинной</w> <w><ana lex="дорога" gr="S,f,inan,loc,norm,sg" sem="top:stripe t:space r:concr t:fam" sem2="t:move dt:space r:abstr der:shift t:space r:concr"/>дороге</w>.</se><se> <w><ana lex="мой" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>Мои</w> <w><ana lex="мальчик" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr" sem2="t:hum r:concr"/>мальчики</w> <w><ana lex="собираться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref t:psych:volit"/>собираются</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="мандала" gr="S,f,gen,inan,norm,pl" sem="r:concr t:text t:workart" sem2=""/>Мандал</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="рекогносцировка" gr="S,acc,f,inan,norm,sg" sem="r:abstr" sem2="r:abstr"/>рекогносцировку</w>, <w><ana lex="проверить" gr="V,act,inf,norm,pf" sem="d:pref" sem2="d:pref"/>проверить</w> <w><ana lex="показание" gr="S,acc,inan,n,norm,sg" sem="t:speech r:abstr" sem2="t:speech r:abstr"/>показание</w> <w><ana lex="мандальцев" gr="S,anim,bastard,famn,m,nom,sg" sem="" sem2=""/>мандальцев</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="большой" gr="A,loc,n,norm,plen,sg" sem="t:size:max r:qual" sem2="t:quant:max t:time:age t:degr:max r:qual"/>большом</w> <w><ana lex="количество" gr="S,inan,loc,n,norm,sg" sem="t:quant r:abstr" sem2="r:abstr"/>количестве</w> <w><ana lex="вокруг" gr="PR,norm" sem="" sem2=""/>вокруг</w> <w><ana lex="их" gr="APRO,norm" sem="r:poss" sem2=""/>их</w> <w><ana lex="селение" gr="S,gen,inan,n,norm,sg" sem="sc:constr:build der:v t:space r:concr" sem2=""/>селения</w> <w><ana lex="волк" gr="S,anim,gen,m,norm,pl" sem="t:animal r:concr" sem2=""/><ana lex="волк" gr="S,gen,inan,m,norm,pl" sem="" sem2="t:fam"/>волков</w>, <w><ana lex="дикий" gr="A,gen,norm,pl,plen" sem="r:rel" sem2="t:humq r:qual der:shift t:degr:max ev:neg r:rel"/>диких</w> <w><ana lex="коза" gr="S,anim,f,gen,norm,pl" sem="t:animal r:concr" sem2=""/>коз</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="пернатый" gr="A,f,gen,norm,plen,sg" sem="r:rel der:s d:habit" sem2=""/>пернатой</w> <w><ana lex="дичь" gr="S,f,gen,inan,norm,sg" sem="pt:aggr r:concr sc:animal der:a" sem2="t:food t:stuff t:text hi:class der:a sc:qtm sc:space pt:aggr t:space der:s pt:part ev:neg pc:space r:concr"/>дичи</w>.</se><se> <w>Кажется</w>, <w><ana lex="завтра" gr="ADV,norm" sem="t:time" sem2=""/>завтра</w> <w><ana lex="трое" gr="NUM,nom,norm" sem="r:coll:pauc" sem2=""/>трое</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="мой" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/>моих</w> <w><ana lex="спутник" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,gen,inan,m,norm,pl" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутников</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="именно" gr="PART,norm" sem="" sem2=""/>именно</w> <w><ana lex="кондратьев" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Кондратьев</w>, <w><ana lex="павлов" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Павлов</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="котик" gr="S,anim,m,nom,norm,sg" sem="d:dim t:animal r:concr der:s" sem2=""/><ana lex="котик" gr="S,inan,m,nom,norm,sg" sem="" sem2="der:shift t:stuff r:concr t:fam"/>Котик</w>, <w><ana lex="укатить" gr="V,3p,act,fut,indic,norm,pf,pl" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="укатить" gr="V,3p,act,fut,indic,intr,norm,pf,pl" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/>укатят</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="охота" gr="S,acc,f,inan,norm,sg" sem="t:action t:psych:volit r:abstr" sem2="der:v d:nag r:abstr sc:hum pt:aggr r:concr"/>охоту</w>.</se><se> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>Я</w> <w><ana lex="они" gr="SPRO,3p,dat,norm,pl" sem="r:pers" sem2=""/>им</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="завидовать" gr="V,1p,act,indic,intr,ipf,norm,praes,sg" sem="der:v d:pref" sem2=""/>завидую</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="особенность" gr="S,f,inan,loc,norm,sg" sem="r:abstr der:a" sem2="r:abstr der:a"/>особенности</w> <w><ana lex="если" gr="CONJ,norm" sem="" sem2=""/>если</w> <w><ana lex="действительно" gr="ADV,PARENTH,norm" sem="der:a" sem2=""/>действительно</w> <w><ana lex="они" gr="SPRO,3p,nom,norm,pl" sem="r:pers" sem2=""/>они</w> <w><ana lex="увидеть" gr="V,3p,act,fut,indic,norm,pf,pl,tran" sem="ca:noncaus d:pref t:perc" sem2=""/>увидят</w> <w><ana lex="волк" gr="S,acc,anim,m,norm,pl" sem="t:animal r:concr" sem2=""/>волков</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="настрелять" gr="V,3p,act,fut,indic,norm,pf,pl" sem="t:impact ca:caus der:v t:be:disapp d:pref" sem2="der:v d:pref"/>настреляют</w> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w> <w><ana lex="интересный" gr="A,gen,norm,pl,plen" sem="dt:abstr der:s dt:ment r:qual" sem2="dt:abstr ev:posit der:s dt:ment r:qual"/>интересных</w> <w><ana lex="птичка" gr="S,f,gen,inan,norm,pl" sem="" sem2="t:sign r:concr"/><ana lex="птичка" gr="S,anim,f,gen,norm,pl" sem="t:hum ev r:concr der:s d:dim" sem2=""/>птичек</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="птица" gr="S,anim,f,gen,norm,pl" sem="t:animal r:concr hi:class" sem2=""/>птиц</w> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="орнитологический" gr="A,gen,norm,pl,plen" sem="r:rel der:s" sem2="r:rel der:s"/>орнитологических</w> <w><ana lex="коллекция" gr="S,f,gen,inan,norm,pl" sem="pt:set sc:thing r:concr" sem2="pt:set sc:thing sc:plant r:concr sc:animal"/>коллекций</w>.</se><se> «<w><ana lex="елена" gr="S,anim,f,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Елена</w> <w><ana lex="прекрасный" gr="A,f,nom,norm,plen,sg" sem="ev:posit t:appearance r:qual" sem2="ev:posit t:quality r:qual"/>Прекрасная</w>» <w><ana lex="уйти" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/>ушла</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="васильев" gr="S,anim,dat,famn,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Васильеву</w> <w><ana lex="узнать" gr="V,act,inf,norm,pf" sem="d:pref" sem2="t:ment ca:noncaus d:pref"/>узнать</w>, <w><ana lex="когда" gr="CONJ,norm" sem="" sem2=""/>когда</w> <w><ana lex="полпред" gr="S,anim,m,nom,norm,sg" sem="der:comp t:hum r:concr der:abbr" sem2=""/>полпред</w> <w><ana lex="принять" gr="V,3p,act,fut,indic,norm,pf,sg" sem="der:v ca:noncaus d:pref t:poss" sem2="der:v d:pref"/>примет</w> <w><ana lex="я" gr="SPRO,1p,acc,norm,sg" sem="r:pers" sem2=""/>меня</w>.</se></p>
<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="читать" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="d:root" sem2="d:root"/>читал</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="местный" gr="A,f,loc,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space r:rel der:s"/>местной</w> <w><ana lex="газетка" gr="S,f,inan,loc,norm,sg" sem="d:dim t:book r:concr der:s" sem2=""/>газетке</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="чествование" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr" sem2=""/>чествовании</w> <w>С</w>. <w><ana lex="гедина" gr="S,anim,f,famn,nom,norm,sg" sem="" sem2=""/>Гедина</w> <w><ana lex="москва" gr="S,f,inan,ins,norm,sg" sem="r:propn t:topon" sem2="r:propn t:topon"/>Москвой</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="дом" gr="S,inan,loc,m,norm,sg" sem="top:contain t:constr:build r:concr" sem2="sc:hum pt:set t:space t:org t:group der:shift r:concr"/>Доме</w> <w><ana lex="ученый" gr="S,anim,gen,m,norm,pl" sem="der:subst t:hum der:a r:concr t:prof" sem2=""/>ученых</w>.</se></p>
<p><se><w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="юрта" gr="S,f,inan,loc,norm,sg" sem="top:contain t:constr r:concr" sem2=""/>юрте</w> <w><ana lex="произойти" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="t:be:exist ca:noncaus der:v d:pref" sem2="t:be:exist ca:noncaus der:v d:pref"/>произошел</w> <w><ana lex="курьез" gr="S,inan,m,nom,norm,sg" sem="r:abstr" sem2=""/>курьез</w>: <w><ana lex="показывать" gr="V,act,ger,ipf,norm,praes,tran" sem="der:v d:pref d:impf" sem2=""/>показывая</w> <w><ana lex="различный" gr="A,acc,inan,norm,pl,plen" sem="r:qual" sem2=""/>различные</w> <w><ana lex="фотография" gr="S,acc,f,inan,norm,pl" sem="r:concr t:workart" sem2="r:concr t:org r:abstr"/>фотографии</w>, <w>С</w>. <w>А</w>. <w><ana lex="кондратьев" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Кондратьев</w> <w><ana lex="дать" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:caus d:root t:poss" sem2="d:root"/>дал</w> <w><ana lex="товарищ" gr="S,anim,dat,m,norm,pl" sem="t:hum r:concr" sem2="t:hum r:concr"/>товарищам</w> <w><ana lex="фотография" gr="S,acc,f,inan,norm,sg" sem="r:concr t:workart" sem2="r:concr t:org r:abstr"/>фотографию</w> <w><ana lex="свой" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2="t:social r:poss"/>своего</w> <w><ana lex="отец" gr="S,anim,gen,m,norm,sg" sem="" sem2="t:hum der:shift r:concr ev:posit"/>отца</w>, <w><ana lex="со" gr="PR,norm" sem="" sem2=""/>со</w> <w><ana lex="слово" gr="S,inan,ins,n,norm,pl" sem="t:word r:concr r:abstr" sem2="pt:aggr:aggrpl t:text sc:word r:abstr t:speech r:concr"/>словами</w>: «<w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>А</w> <w><ana lex="об" gr="PR,norm" sem="" sem2=""/>об</w> <w><ana lex="этот" gr="APRO,loc,m,norm,sg" sem="r:dem" sem2=""/>этом</w> <w><ana lex="жид" gr="S,anim,loc,m,norm,obsc,sg" sem="" sem2=""/>жиде</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="вы" gr="SPRO,2p,nom,norm,pl" sem="r:pers" sem2=""/>вы</w> <w><ana lex="сказать" gr="V,2p,act,fut,indic,norm,pf,pl,tran" sem="t:speech ca:noncaus" sem2=""/>скажете</w>».</se><se> <w><ana lex="мальчик" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr" sem2="t:hum r:concr"/>Мальчики</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="их" gr="APRO,norm" sem="r:poss" sem2=""/>их</w> <w><ana lex="число" gr="S,inan,loc,n,norm,sg" sem="r:abstr" sem2="pt:set der:shift r:abstr t:time"/>числе</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="мой" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/>моя</w> <w><ana lex="пшевочка" gr="S,anim,bastard,f,nom,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/><ana lex="пшевочка" gr="S,anim,bastard,f,nom,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/><ana lex="пшевочка" gr="S,bastard,f,inan,nom,sg" sem="" sem2=""/>Пшевочка</w>, <w><ana lex="дать" gr="V,act,indic,norm,pf,pl,praet" sem="ca:caus d:root t:poss" sem2="d:root"/>дали</w>, <w><ana lex="каждый" gr="APRO,m,nom,norm,sg" sem="r:spec" sem2=""/>каждый</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="отдельность" gr="S,f,inan,loc,norm,sg" sem="r:abstr der:a" sem2=""/>отдельности</w>, <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="нелестный" gr="A,acc,f,norm,plen,sg" sem="d:neg der:a r:qual" sem2=""/>нелестную</w> <w><ana lex="характеристика" gr="S,acc,f,inan,norm,sg" sem="r:abstr" sem2="der:v r:concr t:text"/>характеристику</w>.</se><se> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>Так</w>, <w>например</w>, <w><ana lex="котик" gr="S,anim,m,nom,norm,sg" sem="d:dim t:animal r:concr der:s" sem2=""/><ana lex="котик" gr="S,inan,m,nom,norm,sg" sem="" sem2="der:shift t:stuff r:concr t:fam"/>Котик</w> <w><ana lex="сказать" gr="V,act,indic,m,norm,pf,praet,sg,tran" sem="t:speech ca:noncaus" sem2=""/>сказал</w> «<w><ana lex="гробовщик" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr der:s t:prof" sem2=""/>гробовщик</w>», <w><ana lex="андрюша" gr="S,anim,m,nom,norm,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Андрюша</w>: «<w><ana lex="этот" gr="APRO,m,nom,norm,sg" sem="r:dem" sem2=""/>Этот</w> <w><ana lex="тип" gr="S,inan,m,nom,norm,sg" sem="r:abstr" sem2="pt:aggr r:abstr r:phras"/><ana lex="тип" gr="S,anim,m,nom,norm,sg" sem="" sem2="t:hum ev r:concr ev:neg"/>тип</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="мочь" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="d:root" sem2=""/>может</w> <w><ana lex="хватать" gr="V,act,inf,ipf,norm" sem="ca:caus d:root t:poss" sem2="ca:caus ca:0 d:root t:poss"/>хватать</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="небо" gr="S,gen,inan,n,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/><ana lex="небо" gr="S,gen,inan,n,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/>неба</w> <w><ana lex="звезда" gr="S,f,gen,inan,norm,pl" sem="t:astr t:space r:concr" sem2="t:form t:sign r:concr"/><ana lex="звезда" gr="S,anim,f,gen,norm,pl" sem="" sem2="t:hum ev r:concr"/>звезд</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="отношение" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr der:s0 t:inter" sem2="der:v t:text r:concr r:abstr t:inter"/>отношении</w> <w><ana lex="музыка" gr="S,f,gen,inan,norm,sg" sem="r:abstr" sem2="t:sound r:abstr t:fam"/>музыки</w> <w><ana lex="он" gr="SPRO,3p,m,nom,norm,sg" sem="r:pers" sem2=""/>он</w>, <w>вероятно</w>, <w><ana lex="играть" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="d:root" sem2="d:root"/>играл</w> <w><ana lex="весь" gr="APRO,acc,f,norm,sg" sem="r:spec" sem2=""/>всю</w> <w><ana lex="жизнь" gr="S,acc,f,inan,norm,sg" sem="t:be:exist r:abstr" sem2="t:be:exist r:abstr t:time"/>жизнь</w> <w><ana lex="только" gr="PART,norm" sem="" sem2=""/>только</w> <