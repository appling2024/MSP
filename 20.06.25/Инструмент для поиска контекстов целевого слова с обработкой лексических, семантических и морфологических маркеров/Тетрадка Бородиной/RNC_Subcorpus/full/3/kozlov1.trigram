<p><se><w><ana lex="весь" gr="APRO,acc,inan,m,norm,sg" sem="r:spec" sem2=""/>Весь</w> <w><ana lex="вечер" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>вечер</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="провести" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="провести" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="проводить" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:caus t:move d:pref" sem2="d:pref"/>провел</w> <w><ana lex="наедине" gr="ADV,norm" sem="der:a" sem2=""/>наедине</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="сам" gr="APRO,ins,m,norm,sg" sem="r:spec" sem2=""/>самим</w> <w><ana lex="себе" gr="SPRO,ins,norm" sem="" sem2=""/>собою</w>.</se><se> <w><ana lex="мысль" gr="S,f,inan,nom,norm,pl" sem="t:ment r:abstr" sem2="t:ment ev:posit r:abstr"/>Мысли</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="близкий" gr="A,nom,norm,pl,plen" sem="t:dist:min r:qual" sem2="t:social:emot r:qual der:shift t:like t:time t:social"/>близкие</w>, <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="место" gr="S,inan,loc,n,norm,sg" sem="qc:space t:space r:concr" sem2="qc:space sc:org t:tool t:space pt:element r:abstr pt:aggr:aggrpl pt:part pc:text r:concr"/>месте</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="далекий" gr="A,nom,norm,pl,plen" sem="t:dist:max r:qual" sem2="dt:dist:max der:shift t:time t:humq r:qual"/>далекие</w>, <w><ana lex="словно" gr="CONJ,norm" sem="" sem2=""/>словно</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="путешествие" gr="S,inan,loc,n,norm,sg" sem="t:move r:abstr" sem2=""/>путешествии</w>, <w><ana lex="весь" gr="APRO,acc,n,norm,sg" sem="r:spec" sem2=""/>все</w> <w><ana lex="время" gr="S,acc,inan,n,norm,sg" sem="r:abstr t:param t:time" sem2="t:time:pe