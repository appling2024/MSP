<p><se> <b/><w><b>7</b></w><b>/</b><w><ana lex="x" gr="bastard" sem="" sem2=""/><b>X</b></w><b>, </b><w><ana lex="q" gr="bastard" sem="" sem2=""/><b>Q</b></w><b/>. <w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>День</w> <w><ana lex="отдых" gr="S,gen,inan,m,norm,sg" sem="r:abstr" sem2=""/>отдыха</w>, <w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w> <w><ana lex="праздничный" gr="A,acc,inan,m,norm,plen,sg" sem="dt:abstr ev r:rel der:s dt:action" sem2=""/>праздничный</w>.</se><se> <w><ana lex="цокто" gr="S,0,anim,bastard,m,sg" sem="t:hum r:propn t:persn" sem2=""/>Цокто</w> <w><ana lex="гармаевич" gr="S,anim,bastard,m,nom,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Гармаевич</w> <w><ana lex="устроить" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus d:pref t:be:appear" sem2="der:v d:pref"/>устроил</w> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="высший" gr="A,loc,norm,pl,supr" sem="der:a d:super r:qual" sem2=""/>высших</w>, <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="старший" gr="A,gen,norm,pl,plen" sem="r:qual" sem2="t:hier r:rel t:ord"/>старших</w>, <w><ana lex="член" gr="S,gen,inan,m,norm,pl" sem="" sem2="pc:hum pc:animal pt:set t:word pc:x pt:part pt:partb r:concr"/><ana lex="член" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr" sem2=""/>членов</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w> <w><ana lex="китайский" gr="A,acc,inan,m,norm,plen,sg" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>китайский</w> <w><ana lex="обед" gr="S,acc,inan,m,norm,sg" sem="r:abstr" sem2="t:food sc:food r:abstr pt:aggr t:time r:concr"/>обед</w>, <w><ana lex="состоять" gr="V,acc,act,inan,intr,ipf,m,norm,partcp,plen,praes,sg" sem="d:p