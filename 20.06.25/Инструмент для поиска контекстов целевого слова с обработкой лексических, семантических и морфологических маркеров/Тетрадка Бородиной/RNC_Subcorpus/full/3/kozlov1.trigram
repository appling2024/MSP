<p><se><w><ana lex="делать" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="d:root" sem2="d:root"/>Делал</w> <w><ana lex="патрон" gr="S,acc,inan,m,norm,pl" sem="t:tool:shell r:concr" sem2="t:tool top:cylinder pt:part top:tube r:concr pc:tool"/>патроны</w>, <w><ana lex="который" gr="APRO,acc,anim,norm,pl" sem="r:rel t:ord" sem2=""/>которых</w> <w>теперь</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="я" gr="SPRO,1p,gen,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="много" gr="ADV,comp,norm" sem="t:quant:max r:spec" sem2="t:degr:max"/><ana lex="более" gr="ADV,norm" sem="t:degr:max der:adv" sem2="t:degr:max"/>более</w> <w><ana lex="нежели" gr="CONJ,norm" sem="" sem2=""/>нежели</w> <w><ana lex="достаточный" gr="A,acc,n,norm,plen,sg" sem="t:quant r:qual" sem2="der:s r:qual"/>достаточное</w> <w><ana lex="количество" gr="S,acc,inan,n,norm,sg" sem="t:quant r:abstr" sem2="r:abstr"/>количество</w>.</se></p>
