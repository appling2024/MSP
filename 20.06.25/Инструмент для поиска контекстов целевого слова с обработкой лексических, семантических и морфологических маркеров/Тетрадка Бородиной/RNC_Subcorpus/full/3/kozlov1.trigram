<p><se><w><ana lex="лучший" gr="A,n,nom,norm,sg,supr" sem="d:super ev:posit der:a t:quality r:qual" sem2=""/>Лучшее</w> <w><ana lex="зимовье" gr="S,inan,n,nom,norm,sg" sem="r:abstr" sem2="der:v t:space r:concr"/>зимовье</w> -- <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="южный" gr="A,gen,n,norm,plen,sg" sem="t:place dt:space r:rel der:s" sem2=""/>южного</w> <w><ana lex="подножие" gr="S,gen,inan,n,norm,sg" sem="t:space pc:constr der:s pt:part pc:space r:concr" sem2=""/>подножия</w> <w><ana lex="манхадай" gr="S,anim,bastard,gen,m,persn,sg" sem="" sem2=""/><ana lex="манхадай" gr="S,anim,bastard,gen,m,persn,sg" sem="" sem2=""/>Манхадая</w>, <w><ana lex="боротай" gr="S,bastard,inan,m,nom,sg" sem="" sem2=""/>Боротай</w>.</se><se> <w><ana lex="два" gr="NUM,f,nom,norm" sem="r:card:pauc" sem2=""/>Две-три</w> <w><ana lex="рядом" gr="ADV,norm" sem="t:dist:min" sem2=""/>рядом</w> <w><ana lex="расположить" gr="V,nom,norm,partcp,pass,pf,pl,plen,praet" sem="t:put ca:caus der:v d:pref" sem2=""/><ana lex="расположить" gr="V,intr,nom,norm,partcp,pass,pf,pl,plen,praet" sem="t:put ca:caus der:v d:pref" sem2=""/>расположенные</w> <w><ana lex="комната" gr="S,f,inan,nom,norm,pl" sem="top:contain pc:constr:build t:room pt:part pc:room:appart r:concr" sem2="top:contain pc:constr:build r:concr t:room pt:part"/>комнаты</w>, <w><ana lex="чистый" gr="A,nom,norm,pl,plen" sem="t:physst r:qual" sem2="t:physq ev:posit t:humq t:degr r:qual"/>чистые</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="железный" gr="A,f,ins,norm,plen,sg" sem="dt:stuff r:rel der:s" sem2="ev:posit r:rel der:shift t:degr:max"/>железной</w> <w><ana lex="печь" gr="S,f,inan,ins,norm,sg" sem="t:tool:device top:contain r:concr" sem2="t:tool:device top:contain r:concr"/>печью</w>, <w><ana lex="лавка" gr="S,f,inan,ins,norm,pl" sem="t:constr r:concr t:org t:tool:furn" sem2=""/>лавками</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="нары" gr="S,inan,ins,norm,pl" sem="r:concr t:tool:furn" sem2=""/>нарами</w> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="спанье" gr="S,gen,inan,n,norm,sg" sem="der:v t:physiol dt:physiol r:abstr" sem2=""/>спанья</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="стол" gr="S,inan,ins,m,norm,pl" sem="top:horiz top:contain r:concr t:tool:furn" sem2="t:space sc:food t:org t:tool:furn pt:aggr r:concr"/>столами</w> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="чаепитие" gr="S,gen,inan,n,norm,pl" sem="r:abstr" sem2=""/>чаепитий</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="еда" gr="S,f,gen,inan,norm,sg" sem="der:v t:physiol r:abstr der:s0" sem2="t:food der:v r:concr hi:class"/>еды</w>.</se><se> <w><ana lex="девочка" gr="S,anim,f,nom,norm,sg" sem="t:hum r:concr" sem2="t:hum ev r:concr"/>Девочка</w> <w><ana lex="леночка" gr="S,anim,f,nom,norm,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Леночка</w> <w><ana lex="12" gr="NUM,ciph"/>12</w> <w><ana lex="год" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:age r:abstr"/>лет</w>, <w><ana lex="она" gr="SPRO,3p,dat,f,norm,sg" sem="r:pers" sem2=""/>ей</w> <w><ana lex="обещать" gr="V,brev,m,norm,partcp,pass,pf,praet,sg,tran" sem="t:speech ca:noncaus d:pref der:s" sem2="d:pref der:s"/>обещан</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="дать" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="ca:caus d:root t:poss" sem2="d:root"/>дан</w> <w><ana lex="гостинец" gr="S,acc,inan,m,norm,sg" sem="der:v t:thing r:concr" sem2=""/>гостинец</w> -- <w><ana lex="сережка" gr="S,f,inan,nom,norm,pl" sem="t:access r:concr der:s pc:hum d:dim pt:addit" sem2="pc:plant pt:part pt:partb d:dim r:concr pc:animal"/>сережки</w> -- <w><ana lex="через" gr="PR,norm" sem="" sem2=""/>через</w> <w><ana lex="ямщик" gr="S,acc,anim,m,norm,sg" sem="t:hum r:concr der:s t:prof" sem2=""/>ямщика</w> <w><ana lex="димитрий" gr="S,anim,gen,m,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Димитрия</w>.</se></p>
<p><se><w>Итак</w>, <w><ana lex="путь" gr="S,inan,m,nom,norm,sg" sem="top:stripe t:space r:concr" sem2="ev:posit t:space t:asp r:abstr sc:space pt:aggr:aggrpl pt:aggr top:stripe r:concr der:shift"/>путь</w> <w><ana lex="совершить" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="d:pref" sem2="d:pref"/>совершен</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="шесть" gr="NUM,acc,norm" sem="r:card" sem2=""/>шесть</w> <w><ana lex="день" gr="S,gen,inan,m,norm,pl" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дней</w>, <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="60" gr="NUM,ciph"/>60</w> <w><ana lex="приблизительно" gr="ADV,norm" sem="der:a" sem2=""/>приблизительно</w> <w><ana lex="верста" gr="S,f,gen,inan,norm,pl" sem="t:unit r:abstr" sem2=""/>верст</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w> -- <w><ana lex="335" gr="NUM,ciph"/>335</w> <w><ana lex="верста" gr="S,f,gen,inan,norm,pl" sem="t:unit r:abstr" sem2=""/>верст</w>!</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w>общем</w> <w><ana lex="проехать" gr="V,act,indic,norm,pf,pl,praet" sem="ca:noncaus t:move d:pref" sem2="ca:noncaus t:move d:pref"/>проехали</w> <w><ana lex="вполне" gr="ADV,norm" sem="dt:full t:degr:max der:a" sem2=""/>вполне</w> <w><ana lex="благополучно" gr="ADV,norm" sem="ev:posit der:a" sem2=""/>благополучно</w>, <w><ana lex="счастливо" gr="ADV,norm" sem="ev:posit dt:humq der:a" sem2=""/>счастливо</w>, <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w>холодно</w>, <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w>поздно</w>!</se><se> <w><ana lex="картина" gr="S,anim,f,famn,nom,norm,sg" sem="" sem2=""/><ana lex="картина" gr="S,f,inan,nom,norm,sg" sem="r:concr t:workart" sem2="pc:workdram t:text r:abstr t:workart t:perc pt:part t:workcin r:concr"/>Картина