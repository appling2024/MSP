<p><se><w><ana lex="наутро" gr="ADV,norm" sem="der:s t:time" sem2=""/>Наутро</w> <w><ana lex="следующий" gr="A,gen,m,norm,plen,sg" sem="der:v r:rel dt:move t:ord" sem2="der:v r:rel dt:move t:ord"/>следующего</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дня</w> <b/><w><b>10</b></w><b>/</b><w><ana lex="ii" gr="bastard" sem="" sem2=""/><b>II</b></w><b>, </b><w><ana lex="q" gr="bastard" sem="" sem2=""/><b>Q</b></w><b/>, <w><ana lex="казаться" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="der:v ca:noncaus t:perc" sem2="t:ment ca:noncaus der:v"/>казалось</w>, <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="я" gr="SPRO,1p,gen,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="все" gr="SPRO,nom,norm,pl" sem="" sem2=""/>все</w> <w><ana lex="надуться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="der:v t:changest d:pref ca:noncaus" sem2="ca:noncaus d:pref t:psych:emot t:behav"/>надулись</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w>пуще</w> <w><ana lex="другой" gr="APRO,gen,norm,pl" sem="r:spec" sem2="r:ord r:spec r:indet"/>других</w> -- <w><ana lex="верочка" gr="S,anim,f,nom,norm,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Верочка</w>!</se><se> <w>Вероятно</w>, <w><ana lex="они" gr="SPRO,3p,dat,norm,pl" sem="r:pers" sem2=""/>им</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="приятный" gr="A,brev,n,norm,sg" sem="ev:posit r:qual" sem2="ev:posit t:humq r:qual"/>приятно</w> <w><ana lex="мой" gr="APRO,n,nom,norm,sg" sem="r:poss" sem2=""/>мое</w> <w><ana lex="вмешательство" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr der:s0" sem2="r:abstr"/>вмешательство</w>.</se><se> <w><ana lex="это" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>Это</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg