<p><se><b/><w><b>19</b></w><b>/</b><w><ana lex="x" gr="bastard" sem="" sem2=""/><b>X</b></w><b>, </b><w><ana lex="t" gr="bastard" sem="" sem2=""/><b>T</b></w><b/>. <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w> <w><ana lex="холодный" gr="A,n,nom,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодное</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="тонкий" gr="A,ins,m,norm,plen,sg" sem="t:size:min r:qual" sem2="t:physq:form t:humq der:shift t:sound r:qual ev"/>тонким</w> <w><ana lex="пронизывающий" gr="A,ins,m,norm,plen,sg" sem="der:v r:rel" sem2=""/>пронизывающим</w> <w><ana lex="ветер" gr="S,inan,ins,m,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>ветром</w>.</se><se> <w><ana lex="стекло" gr="S,inan,n,nom,norm,pl" sem="t:stuff r:concr" sem2="pt:aggr r:concr pt:ind"/>Стекла</w> <w><ana lex="окно" gr="S,gen,inan,n,norm,pl" sem="t:tool t:space pc:constr:build pt:part top:vertical r:concr top:hole" sem2="t:space r:abstr pc:constr pt:part t:time r:concr"/>окон</w> <w><ana lex="покрыться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>покрылись</w> <w><ana lex="узор" gr="S,inan,ins,m,norm,pl" sem="t:pattern r:concr" sem2=""/>узорами</w>, <w><ana lex="отметить" gr="V,ins,norm,partcp,pass,pf,pl,plen,praet" sem="d:pref" sem2="d:pref"/>отмеченными</w> <w><ana lex="пристать" gr="V,act,ins,intr,norm,partcp,pf,pl,plen,praet" sem="d:pref" sem2="d:pref"/>приставшими</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="он" gr="SPRO,3p,ins,m,norm,sg" sem="r:pers" sem2=""/>ним</w> <w><ana lex="снежинка" gr="S,f,inan,ins,norm,pl" sem="qc:stuff pt:qtm r:concr der:s d:sing" sem2=""/>снежинками</w>.</se><se> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>По</w> <w><ana lex="утро" gr="S,dat,inan,n,norm,pl"