<p><se><w><ana lex="3" gr="NUM,ciph"/>3</w>/<w><ana lex="x" gr="bastard" sem="" sem2=""/>X</w>. <w><ana lex="около" gr="PR,norm" sem="" sem2=""/>Около</w> <w><ana lex="4" gr="NUM,ciph"/>4</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дня</w> <w><ana lex="подуть" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="d:pref" sem2="d:pref"/>подул</w> <w><ana lex="сильный" gr="A,m,nom,norm,plen,sg" sem="t:physq d:habit r:qual" sem2="ev:posit t:humq:char der:s t:degr:max r:qual r:rel"/>сильный</w> <w><ana lex="ветер" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>ветер</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="север" gr="S,gen,inan,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr t:fam pt:part pc:space"/><ana lex="север" gr="S,anim,gen,m,norm,persn,sg" sem="" sem2=""/>севера</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="вскоре" gr="ADV,norm" sem="der:adv t:time" sem2=""/>вскоре</w> <w><ana lex="превратиться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus d:pref" sem2=""/>превратился</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="буря" gr="S,acc,f,inan,norm,sg" sem="r:abstr t:weather" sem2="t:manif r:abstr"/>бурю</w>, <w><ana lex="нести" gr="V,acc,act,f,ipf,norm,partcp,plen,praet,sg,tran" sem="ca:caus t:move d:root" sem2="t:move d:root ca:caus t:speech ev:neg ca:noncaus"/>несшую</w> <w><ana lex="туча" gr="S,acc,f,inan,norm,pl" sem="qc:stuff top:form r:concr" sem2="t:quant:max pt:qtm r:concr r:abstr"/>тучи</w> <w><ana lex="пыль" gr="S,f,gen,inan,norm,sg" sem="t:stuff r:concr" sem2=""/>пыли</w>.</se><se> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>К</w> <w><ana lex="ночь" gr="S,f,gen,inan,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2=""/>ноч