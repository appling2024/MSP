<p><se><b/><w><b>30</b></w><b>/</b><w><ana lex="iii" gr="bastard" sem="" sem2=""/><b>III</b></w><b>, </b><w><ana lex="q" gr="bastard" sem="" sem2=""/><b>Q</b></w><b/>. <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w> <w><ana lex="рассвести" gr="V,act,indic,n,norm,pf,praet,sg" sem="der:v ca:noncaus d:pref t:weather" sem2=""/>рассвело</w> <w><ana lex="полуясный" gr="A,bastard,n,nom,plen,sg" sem="" sem2=""/>полуясное</w>, <w><ana lex="довольно" gr="ADV,norm" sem="t:degr dt:humq der:a" sem2="ev:posit dt:humq der:a"/>довольно</w> <w><ana lex="тихий" gr="A,acc,n,norm,plen,sg" sem="d:neg t:sound r:qual" sem2="d:neg t:humq t:speed:min der:shift t:sound r:qual"/>тихое</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="вначале" gr="ADV,norm" sem="der:s t:time" sem2=""/>вначале</w> <w><ana lex="прохладный" gr="A,n,nom,norm,plen,sg" sem="t:physq:temper r:qual" sem2="dt:temper dt:abstr ev der:s r:qual"/>прохладное</w>, <w><ana lex="потом" gr="ADVPRO,norm" sem="t:time" sem2=""/>потом</w>, <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="солнце" gr="S,inan,loc,n,norm,sg" sem="top:horiz top:spher t:astr t:space r:concr" sem2="ev:posit t:space r:concr r:abstr t:light"/>солнце</w>, <w><ana lex="сразу" gr="ADV,norm" sem="t:time" sem2="ev der:s"/>сразу</w> <w><ana lex="обогреть" gr="V,act,indic,n,norm,pf,praet,sg" sem="der:v t:changest dt:physq:temper d:pref ca:caus" sem2="der:shift d:pref"/>обогрело</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="политься" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>полились</w> <w><ana lex="звук" gr="S,inan,m,nom,norm,pl" sem="t:sound r:abstr" sem2="pc:speech pt:qtm r:abstr"/>звуки</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="кустарниковый" gr="A,f,gen,norm,plen,sg" sem="dt:plant r:rel der:s" sem2=""/>кустарниковой</w> <w><ana lex="заросль" gr="S,f,gen,inan,nor