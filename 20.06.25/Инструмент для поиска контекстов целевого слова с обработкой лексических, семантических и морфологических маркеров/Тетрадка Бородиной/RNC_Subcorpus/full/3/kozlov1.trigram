<p><se><b/><w><b>6</b></w><b>/</b><w><ana lex="i" gr="bastard" sem="" sem2=""/><b>I</b></w><b>, </b><w><ana lex="q" gr="bastard" sem="" sem2=""/><b>Q</b></w><b/>. <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w> <w><ana lex="типичный" gr="A,n,nom,norm,plen,sg" sem="r:rel der:s dt:hum" sem2="r:rel der:s dt:hum"/>типичное</w> <w><ana lex="зимний" gr="A,n,nom,norm,plen,sg" sem="dt:time dt:abstr dt:time:season der:s t:time r:rel" sem2=""/>зимнее</w>, <w><ana lex="холодный" gr="A,n,nom,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодное</w>, <w><ana lex="со" gr="PR,norm" sem="" sem2=""/>со</w> <w><ana lex="слоистый" gr="A,ins,norm,pl,plen" sem="t:physq d:habit der:s r:qual" sem2=""/>слоистыми</w> <w><ana lex="облако" gr="S,inan,ins,n,norm,pl" sem="qc:stuff r:concr" sem2="qc:stuff pt:qtm top:form r:concr"/>облаками</w>, <w><ana lex="опоясывать" gr="V,act,ins,ipf,norm,partcp,pl,plen,praes,tran" sem="der:v d:pref d:impf" sem2=""/>опоясывающими</w> <w><ana lex="весь" gr="APRO,acc,inan,m,norm,sg" sem="r:spec" sem2=""/>весь</w> <w><ana lex="горизонт" gr="S,acc,inan,m,norm,sg" sem="t:space r:concr" sem2="t:ment t:space qc:stuff pt:qtm r:abstr pt:aggr r:concr"/>горизонт</w>.</se><se> <w><ana lex="пшевочка" gr="S,anim,bastard,m,nom,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Пшевочка</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="цокто" gr="S,0,anim,bastard,m,sg" sem="t:hum r:propn t:persn" sem2=""/>Цокто</w> <w><ana lex="гармаевич" gr="S,anim,bastard,m,nom,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Гармаевич</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="утро" gr="S,gen,inan,n,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утра</w> <w><ana lex="ехать" gr="V,3p,act,indic,intr,ipf,norm,pl