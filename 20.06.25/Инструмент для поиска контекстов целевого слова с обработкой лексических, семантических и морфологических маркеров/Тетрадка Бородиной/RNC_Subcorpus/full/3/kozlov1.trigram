<p><se><w><ana lex="пользоваться" gr="V,act,ger,intr,ipf,norm,praes" sem="ca:noncaus" sem2="ca:noncaus"/>Пользуясь</w> <w><ana lex="любезность" gr="S,f,inan,ins,norm,sg" sem="t:humq r:abstr der:a" sem2="t:speech ev:posit r:abstr der:a"/>любезностью</w> <w><ana lex="чичаев" gr="S,anim,bastard,famn,gen,m,sg" sem="t:hum r:propn t:famn" sem2=""/>Чичаева</w>, <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="сдать" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus d:pref t:poss" sem2="der:v d:pref"/>сдал</w> <w><ana lex="он" gr="SPRO,3p,dat,m,norm,sg" sem="r:pers" sem2=""/>ему</w> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="вручение" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr" sem2=""/>вручения</w> <w>П</w>. <w>С</w>. <w><ana lex="михно" gr="S,0,anim,bastard,famn" sem="t:hum r:propn t:famn" sem2=""/><ana lex="михно" gr="S,0,anim,bastard,persn" sem="t:hum r:propn t:famn" sem2=""/>Михно</w> <w><ana lex="письмо" gr="S,acc,inan,n,norm,sg" sem="r:concr t:text" sem2="pt:aggr t:asp r:concr r:abstr sc:letter"/>письмо</w>.</se></p>
<p><se><w><ana lex="дополнительный" gr="A,nom,norm,pl,plen" sem="der:v r:rel" sem2="dt:abstr r:rel der:s"/>Дополнительные</w> <w><ana lex="переговоры" gr="S,inan,nom,norm,pl" sem="t:speech t:action r:abstr" sem2="t:speech r:abstr"/>переговоры</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="алексей" gr="S,anim,ins,m,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Алексеем</w> <w><ana lex="николаевич" gr="S,anim,ins,m,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Николаевичем</w> <w><ana lex="выяснить" gr="V,act,indic,norm,pf,pl,praet" sem="t:ment ca:noncaus d:pref der:a" sem2=""/>выяснили</w> <w><ana lex="следующий" gr="A,acc,inan,m,norm,plen,sg" sem="der:v r:rel dt:move t:ord" sem2="der:v r:rel dt:move t:ord"/>следующий</w> <w><ana lex="взгляд" gr="S,acc,inan,m,norm,sg" sem="t:perc r:abstr" sem2="t:ment t:manif:emot r:abstr"/>взгляд</w> <w><ana lex="правительство" gr="S,gen,inan,n,norm,sg" sem="pc:org pt:set t:org der:v t:group sc:hum pt:part r:concr" sem2=""/>правительства</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="экспедиция" gr="S,acc,f,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедицию</w>: <w><ana lex="экспедиция" gr="S,f,inan,nom,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиция</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="должный" gr="A,brev,f,norm,sg" sem="" sem2=""/>должна</w> <w><ana lex="втягиваться" gr="V,act,inf,intr,ipf,norm" sem="der:v d:pref d:impf" sem2=""/>втягиваться</w> <w><ana lex="больший" gr="A,ins,norm,pl,plen" sem="d:compar t:size:max der:a dt:size:max r:qual" sem2=""/><ana lex="большой" gr="A,ins,norm,pl,plen" sem="t:size:max r:qual" sem2="t:quant:max t:time:age t:degr:max r:qual"/>большими</w> <w><ana lex="расход" gr="S,inan,ins,m,norm,pl" sem="sc:money r:abstr t:poss" sem2="r:abstr t:poss"/>расходами</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="монголия" gr="S,acc,f,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Монголию</w>, <w><ana lex="она" gr="SPRO,3p,f,nom,norm,sg" sem="r:pers" sem2=""/>она</w> <w><ana lex="должный" gr="A,brev,f,norm,sg" sem="" sem2=""/>должна</w> <w><ana lex="быть" gr="V,act,inf,intr,ipf,norm" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>быть</w> <w><ana lex="тибетский" gr="A,f,ins,norm,plen,sg" sem="dt:topon r:rel der:s t:topon" sem2=""/>Тибетской</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="экономить" gr="V,act,inf,ipf,norm,tran" sem="ca:noncaus t:poss" sem2=""/>экономить</w> <w><ana lex="сила" gr="S,acc,f,inan,norm,pl" sem="sc:hum t:pers r:abstr pt:aggr:aggrpl t:param r:concr" sem2="pt:aggr sc:hum ev:posit t:quant:max pt:qtm r:abstr pt:aggr:aggrpl der:shift r:concr"/>силы</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="энергия" gr="S,acc,f,inan,norm,sg" sem="r:abstr" sem2="r:abstr"/>энергию</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="материальный" gr="A,acc,inan,norm,pl,plen" sem="dt:stuff r:rel der:s" sem2="dt:stuff r:rel der:s"/>материальные</w> <w><ana lex="средство" gr="S,acc,inan,n,norm,pl" sem="r:abstr" sem2="sc:money t:tool t:stuff hi:class r:abstr t:poss pt:aggr:aggrpl sc:tool r:concr pc:money"/>средства</w> <w><ana lex="только" gr="PART,norm" sem="" sem2=""/>только</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="экспедиция" gr="S,acc,f,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедицию</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="тибет" gr="S,acc,inan,m,norm,sg" sem="r:propn t:topon" sem2=""/>Тибет</w>!</se></p>
<p><se><w><ana lex="это" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>Это</w> <w><ana lex="весьма" gr="ADV,norm" sem="t:degr:max" sem2=""/>весьма</w> <w>приятно</w> <w><ana lex="знать" gr="V,act,inf,ipf,norm,tran" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/>знать</w> <w><ana lex="вовремя" gr="ADV,norm" sem="ev:posit der:s t:time" sem2=""/>вовремя</w>.</se><se> <w><ana lex="следовательно" gr="ADV,PARENTH,norm" sem="" sem2=""/>Следовательно</w>, <w>надо</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="поступить" gr="V,act,inf,intr,norm,pf" sem="der:v d:pref" sem2="der:v d:pref"/>поступить</w> -- <w>надо</w> <w><ana lex="minimum" gr="bastard" sem="" sem2=""/>minimum</w> <w><ana lex="взять" gr="V,act,inf,norm,pf,tran" sem="ca:caus t:poss" sem2="ca:noncaus"/>взять</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="себе" gr="SPRO,ins,norm" sem="" sem2=""/>собою</w> <w><ana lex="багаж" gr="S,gen,inan,m,norm,sg" sem="sc:thing pt:aggr r:concr" sem2="pt:set der:shift"/>багажа</w>, <w><ana lex="все" gr="ADV,norm" sem="" sem2=""/>все</w> <w><ana lex="взвесить" gr="V,act,inf,norm,pf" sem="der:v ca:caus d:pref" sem2="t:ment ca:noncaus der:v d:pref"/>взвесить</w>, <w><ana lex="рассчитать" gr="V,act,inf,norm,pf" sem="der:v d:pref" sem2="der:v d:pref"/><ana lex="рассчитать" gr="V,act,inf,intr,norm,pf" sem="der:v d:pref" sem2="der:v d:pref"/>рассчитать</w>, <w><ana lex="чтобы" gr="CONJ,norm" sem="" sem2=""/>чтобы</w> <w><ana lex="ничто" gr="SPRO,gen,n,norm,sg" sem="r:neg" sem2=""/>ничего</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="бы" gr="PART,norm" sem="" sem2=""/>бы</w> <w><ana lex="лишний" gr="A,gen,m,norm,plen,sg" sem="r:rel" sem2="r:rel ev:neg"/>лишнего</w>, <w><ana lex="вместе" gr="ADV,norm" sem="t:quant:abs" sem2="t:time"/>вместе</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="то" gr="SPRO,inan,ins,n,norm,sg" sem="r:dem" sem2=""/>тем</w> <w><ana lex="чтобы" gr="CONJ,norm" sem="" sem2=""/>чтобы</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w>достаточно</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="экскурсия" gr="S,acc,f,inan,norm,sg" sem="t:action t:move r:abstr" sem2="t:group pt:set r:concr sc:hum"/>экскурсию</w> <w><ana lex="такой" gr="APRO,gen,m,norm,sg" sem="r:dem" sem2="r:indet r:spec t:degr:max"/>такого</w> <w><ana lex="род" gr="S,anim,gen,m,norm,persn,sg" sem="" sem2=""/><ana lex="род" gr="S,gen,inan,m,norm,sg" sem="t:group pt:set r:concr sc:hum r:abstr" sem2="pt:set sc:hum r:concr r:abstr t:like"/>рода</w>: <w><ana lex="урга" gr="S,f,inan,nom,norm,sg" sem="r:propn t:topon" sem2=""/>Урга</w> -- <w><ana lex="излом" gr="S,inan,m,nom,norm,sg" sem="der:v t:space r:concr" sem2="der:v t:space r:concr"/>излом</w> <w><ana lex="тола" gr="S,f,gen,inan,norm,sg" sem="" sem2=""/>Толы</w>, <w><ana lex="это" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>это</w> <w><ana lex="первый" gr="ANUM,n,nom,norm,sg" sem="r:ord der:num t:ord r:qual" sem2="ev:posit t:hier t:qual r:qual"/>первое</w>, <w><ana lex="второй" gr="ANUM,n,nom,norm,sg" sem="r:ord der:num r:rel t:ord" sem2="t:hier t:share r:rel der:num"/>второе</w> -- <w><ana lex="излом" gr="S,inan,m,nom,norm,sg" sem="der:v t:space r:concr" sem2="der:v t:space r:concr"/>излом</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="ихэ" gr="S,0,bastard,f,inan" sem="" sem2=""/>Ихэ</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="бага" gr="S,bastard,f,inan,nom,sg" sem="" sem2=""/>Бага-богдо</w>, <w><ana lex="где" gr="ADVPRO,norm" sem="t:place r:rel" sem2="t:place r:indet"/>где</w> <w><ana lex="база" gr="S,f,inan,nom,norm,sg" sem="pc:constr r:concr pt:part" sem2="r:concr r:abstr pt:part t:org"/>база</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="проч" gr="S,anim,bastard,m,nom,sg" sem="" sem2=""/><ana lex="проча" gr="S,bastard,f,gen,inan,pl" sem="" sem2=""/>проч</w>.</se><se>, <w><ana lex="третий" gr="ANUM,n,nom,norm,sg" sem="r:ord der:num r:rel t:ord" sem2="t:share r:rel der:num"/>третье</w> -- <w><ana lex="часть" gr="S,f,inan,nom,norm,sg" sem="r:concr pc:x pt:part" sem2="pc:org r:abstr sc:part t:org pt:ind pt:aggr:aggrpl t:poss der:shift pc:x pt:part pc:text r:concr"/>часть</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="база" gr="S,f,inan,loc,norm,sg" sem="pc:constr r:concr pt:part" sem2="r:concr r:abstr pt:part t:org"/>базе</w>, <w><ana lex="часть" gr="S,acc,f,inan,norm,sg" sem="r:concr pc:x pt:part" sem2="pc:org r:abstr sc:part t:org pt:ind pt:aggr:aggrpl t:poss der:shift pc:x pt:part pc:text r:concr"/>часть</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="легкий" gr="A,acc,f,norm,plen,sg" sem="ev t:physq:weight r:qual" sem2="ev:posit t:humq t:degr:min der:shift t:appearance r:qual ev r:rel"/>легкую</w> <w><ana lex="экскурсия" gr="S,acc,f,inan,norm,sg" sem="t:action t:move r:abstr" sem2="t:group pt:set r:concr sc:hum"/>экскурсию</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="сого" gr="S,0,anim,bastard,m,persn,sg" sem="" sem2=""/>Сого-нор</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="хара" gr="S,anim,nom,norm,persn,sg" sem="t:hum r:propn t:famn" sem2=""/>Хара-хото</w>, <w><ana lex="четвертый" gr="ANUM,n,nom,norm,sg" sem="r:ord der:num r:rel t:ord" sem2="t:share r:rel der:num"/>четвертое</w> -- <w><ana lex="обратный" gr="A,n,nom,norm,plen,sg" sem="der:v r:rel t:dir" sem2="t:place r:rel"/>обратное</w> <w><ana lex="следование" gr="S,inan,n,nom,norm,sg" sem="der:v t:move r:abstr" sem2=""/>следование</w> <w><ana lex="через" gr="PR,norm" sem="" sem2=""/>через</w> <w><ana lex="база" gr="S,acc,f,inan,norm,sg" sem="pc:constr r:concr pt:part" sem2="r:concr r:abstr pt:part t:org"/>базу</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="урга" gr="S,acc,f,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Ургу</w> (<w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="только" gr="PART,norm" sem="" sem2=""/>только</w> <w><ana lex="экспедиционный" gr="A,ins,m,norm,plen,sg" sem="r:rel der:s" sem2=""/>экспедиционным</w> <w><ana lex="транспорт" gr="S,inan,ins,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="r:abstr pt:set t:tool:transp pt:aggr sc:tool:transp r:concr"/>транспортом</w> -- <w><ana lex="коллекция" gr="S,f,inan,ins,norm,pl" sem="pt:set sc:thing r:concr" sem2="pt:set sc:thing sc:plant r:concr sc:animal"/>коллекциями</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="даже" gr="PART,norm" sem="" sem2=""/>даже</w> <w><ana lex="весь" gr="APRO,f,ins,norm,sg" sem="r:spec" sem2=""/>всей</w> <w><ana lex="экспедиция" gr="S,f,inan,ins,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедицией</w>).</se><se> <w><ana lex="средство" gr="S,gen,inan,n,norm,pl" sem="r:abstr" sem2="sc:money t:tool t:stuff hi:class r:abstr t:poss pt:aggr:aggrpl sc:tool r:concr pc:money"/>Средств</w> <w><ana lex="должный" gr="A,brev,n,norm,sg" sem="" sem2=""/>должно</w> <w><ana lex="быть" gr="V,act,inf,intr,ipf,norm" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>быть</w> <w><ana lex="немного" gr="ADV,norm" sem="t:degr:min ev der:adv" sem2="ev t:time:dur:min t:quant:min der:adv"/>немного</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="этот" gr="APRO,acc,f,norm,sg" sem="r:dem" sem2=""/>эту</w> <w><ana lex="экскурсия" gr="S,acc,f,inan,norm,sg" sem="t:action t:move r:abstr" sem2="t:group pt:set r:concr sc:hum"/>экскурсию</w> <w><ana lex="следовать" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="ca:noncaus t:move der:s" sem2="ca:noncaus t:move der:s"/>следует</w> <w><ana lex="выполнить" gr="V,act,inf,norm,pf" sem="d:pref" sem2="d:pref"/>выполнить</w> <w><ana lex="всенепременно" gr="ADV,norm" sem="der:a" sem2=""/>всенепременно</w>!</se><se> <w><ana lex="следовать" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="ca:noncaus t:move der:s" sem2="ca:noncaus t:move der:s"/>Следует</w> <w><ana lex="вдумчиво" gr="ADV,norm" sem="ev:posit dt:humq der:a" sem2=""/>вдумчиво</w> <w><ana lex="разработать" gr="V,act,inf,norm,pf" sem="der:v d:pref" sem2="der:v d:pref"/>разработать</w> <w><ana lex="план" gr="S,acc,inan,m,norm,sg" sem="r:concr t:workart" sem2="t:ment t:space t:aspect pc:workart r:abstr pt:part"/>план</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="составить" gr="V,act,inf,norm,pf" sem="ca:caus d:pref" sem2="t:put ca:caus d:pref"/>составить</w> <w><ana lex="научный" gr="A,acc,f,norm,plen,sg" sem="r:rel der:s" sem2="r:rel der:s"/>научную</w> <w><ana lex="программа" gr="S,acc,f,inan,norm,sg" sem="t:ment pt:set r:abstr" sem2="pt:set r:concr t:text r:abstr"/>программу</w>.</se><se> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>Я</w> <w><ana lex="ясно" gr="ADV,norm" sem="ev:posit dt:light der:a" sem2="ev:posit dt:light der:a"/>ясно</w> <w><ana lex="представлять" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="der:v d:pref" sem2="der:v d:pref"/>представляю</w> <w><ana lex="себе" gr="SPRO,dat,norm" sem="" sem2=""/>себе</w> <w><ana lex="все" gr="SPRO,acc,inan,n,norm,sg" sem="" sem2=""/>все</w>, <w><ana lex="весь" gr="APRO,acc,f,norm,sg" sem="r:spec" sem2=""/>всю</w> <w><ana lex="картина" gr="S,acc,anim,f,famn,norm,sg" sem="" sem2=""/><ana lex="картина" gr="S,acc,f,inan,norm,sg" sem="r:concr t:workart" sem2="pc:workdram t:text r:abstr t:workart t:perc pt:part t:workcin r:concr"/>картину</w>!</se><se> <w><ana lex="где" gr="ADVPRO,norm" sem="t:place r:rel" sem2="t:place r:indet"/>Где</w> <w>теперь</w> <w><ana lex="владетельный" gr="A,m,nom,norm,plen,sg" sem="der:v dt:poss r:rel" sem2=""/>владетельный</w> <w><ana lex="бэй