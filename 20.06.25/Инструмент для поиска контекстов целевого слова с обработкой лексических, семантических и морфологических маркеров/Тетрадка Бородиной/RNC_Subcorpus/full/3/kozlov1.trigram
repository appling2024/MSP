<p><se><w><ana lex="около" gr="PR,norm" sem="" sem2=""/>Около</w> <w><ana lex="4" gr="NUM,ciph"/>4</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дня</w> <w><ana lex="возвратиться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2=""/>возвратился</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="охота" gr="S,f,gen,inan,norm,sg" sem="t:action t:psych:volit r:abstr" sem2="der:v d:nag r:abstr sc:hum pt:aggr r:concr"/>охоты</w> <w>А</w>. <w><ana lex="симук" gr="S,bastard,gen,inan,m,pl" sem="" sem2=""/>Симуков</w>, <w><ana lex="удачно" gr="ADV,norm" sem="" sem2="ev:posit der:a"/>удачно</w> <w><ana lex="подстрелить" gr="V,act,m,nom,norm,partcp,pf,plen,praet,sg" sem="der:v d:pref" sem2=""/>подстреливший</w> <w><ana lex="два" gr="NUM,acc,anim,m,norm" sem="r:card:pauc" sem2=""/>двух</w> <w><ana lex="гуран" gr="S,acc,anim,m,norm,pl" sem="" sem2=""/>гуранов</w>.</se><se> <w><ana lex="васильев" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Васильев</w> <w>А</w>. <w>Н</w>., <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="сожаление" gr="S,dat,inan,n,norm,sg" sem="t:psych:emot r:abstr" sem2="t:psych:emot r:abstr"/>сожалению</w>, <w><ana form="по-прежнему" lex="по-прежнему" gr="ADV,norm" sem="dt:time der:a" sem2=""/>по-прежнему</w> <w><ana lex="остаться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="t:loc d:pref ca:noncaus" sem2="t:be:exist ca:noncaus d:pref"/>остался</w> <w><ana lex="без" gr="PR,norm" sem="" sem2=""/>без</w> «<w><ana lex="поле" gr="S,gen,inan,n,norm,sg" sem="top:horiz t:space r:concr" sem2="t:plot t:space dt:space pc:workart pc:tool:cloth r:abstr top:surface der:shift top:stripe pt:part r:concr"/>поля</w>».</se><se> <w><ana lex="коза" gr="S,anim,f,gen,norm,pl" sem=