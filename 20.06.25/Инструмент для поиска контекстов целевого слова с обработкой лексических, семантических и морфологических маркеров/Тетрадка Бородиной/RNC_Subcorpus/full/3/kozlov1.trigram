<p><se><b/><w><b>27</b></w><b>/</b><w><ana lex="x" gr="bastard" sem="" sem2=""/><b>X</b></w><b>, </b><w><ana lex="w" gr="bastard" sem="" sem2=""/><b>W</b></w><b/>. <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w> <w><ana lex="серый" gr="A,n,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>серое</w>, <w><ana lex="облачный" gr="A,n,nom,norm,plen,sg" sem="r:rel der:s" sem2="t:physq r:rel der:s"/>облачное</w>, <w><ana lex="довольно" gr="ADV,norm" sem="t:degr dt:humq der:a" sem2="ev:posit dt:humq der:a"/>довольно</w> <w><ana lex="холодный" gr="A,n,nom,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодное</w>, <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="как" gr="ADVPRO,norm" sem="r:rel t:manner" sem2=""/>как</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="северный" gr="A,f,gen,norm,plen,sg" sem="t:place dt:space r:rel der:s" sem2=""/>северной</w> <w><ana lex="сторона" gr="S,f,gen,inan,norm,sg" sem="t:space r:concr pt:part pc:space" sem2="sc:hum t:space t:asp:ment r:abstr pt:set pc:x pt:part pc:space r:concr pc:form:geom"/>стороны</w> <w><ana lex="все" gr="SPRO,inan,n,nom,norm,sg" sem="" sem2=""/>все</w> <w><ana lex="еще" gr="ADV,norm" sem="" sem2=""/>еще</w> <w><ana lex="продолжать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="aux:phase d:pref der:a" sem2=""/>продолжает</w> <w><ana lex="тянуть" gr="V,act,inf,ipf,norm,tran" sem="ca:caus t:move d:root" sem2="d:root"/>тянуть</w> <w><ana lex="ветерок" gr="S,inan,m,nom,norm,sg" sem="d:dim r:concr der:s t:weather" sem2=""/>ветерок</w>, <w><ana lex="пронизывать" gr="V,act,ipf,m,nom,norm,partcp,plen,praes,sg,tran" sem="der:v d:pref d:impf" sem2=""/>пронизывающий</w