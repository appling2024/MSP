<p><se><b/><w><b>27</b></w><b>/</b><w><ana lex="iii" gr="bastard" sem="" sem2=""/><b>III</b></w><b>, </b><w><ana lex="v" gr="bastard" sem="" sem2=""/><b>V</b></w><b/>. <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утро</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="рука" gr="S,f,gen,inan,norm,pl" sem="pt:partb r:concr pc:hum" sem2="sc:hum t:asp r:abstr pt:aggr:aggrpl t:dir r:concr"/>рук</w> <w><ana lex="вон" gr="PART,norm" sem="" sem2=""/>вон</w> <w><ana lex="неприятный" gr="A,n,nom,norm,plen,sg" sem="d:neg t:humq ev:neg r:qual" sem2="d:neg t:humq ev:neg r:qual"/>неприятное</w>: <w><ana lex="холодный" gr="A,n,nom,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодное</w>, <w><ana lex="ветреный" gr="A,n,nom,norm,plen,sg" sem="r:rel der:s d:habit" sem2="t:humq der:s ev:neg r:qual"/>ветреное</w>, <w><ana lex="серо" gr="ADV,norm" sem="dt:physq:color der:a ev:neg" sem2="dt:physq:color der:a ev:neg"/>серо-грязное</w>.</se><se> <w><ana lex="первый" gr="ANUM,f,gen,norm,sg" sem="r:ord der:num t:ord r:qual" sem2="ev:posit t:hier t:qual r:qual"/>Первой</w> <w><ana lex="радостный" gr="A,f,gen,norm,plen,sg" sem="dt:psych:emot ev:posit t:psych:emot der:s r:qual" sem2="dt:psych:emot ev:posit t:psych:emot der:s r:qual"/>радостной</w> <w><ana lex="улыбка" gr="S,f,gen,inan,norm,sg" sem="t:manif:emot r:abstr" sem2=""/>улыбки</w> <w><ana lex="весна" gr="S,f,gen,inan,norm,sg" sem="t:time:season r:abstr t:time" sem2=""/>весны</w> <w><ana lex="как" gr="CONJ,norm" sem="" sem2=""/>как</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="бывать" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus der:v d:impf" sem2="der:v t:loc der:shift d:impf ca:noncaus"/>бывало</w>.</se><se> <w><ana lex="что" gr="SPRO,acc,inan,n,norm,sg" sem="r:rel"