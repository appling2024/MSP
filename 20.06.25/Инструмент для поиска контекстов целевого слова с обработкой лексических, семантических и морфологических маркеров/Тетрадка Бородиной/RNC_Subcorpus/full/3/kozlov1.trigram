<p><se><b/><w><b>9</b></w><b>/</b><w><ana lex="iv" gr="bastard" sem="" sem2=""/><b>IV</b></w><b>, </b><w><ana lex="s" gr="bastard" sem="" sem2=""/><b>S</b></w><b/>. <w><ana lex="облачность" gr="S,f,inan,nom,norm,sg" sem="r:abstr der:a" sem2="qc:stuff pt:aggr t:stuff r:concr sc:qtm"/>Облачность</w> <w><ana lex="вообще" gr="ADV,PARENTH,norm" sem="dt:general der:a" sem2=""/>вообще</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="начальный" gr="A,f,loc,norm,plen,sg" sem="r:rel der:s" sem2="r:rel der:s"/>начальной</w> <w><ana lex="треть" gr="S,f,inan,loc,norm,sg" sem="t:share der:anum r:concr r:abstr pt:part" sem2=""/>трети</w> <w><ana lex="апрель" gr="S,gen,inan,m,norm,sg" sem="t:time:month r:abstr" sem2=""/><ana lex="апрель" gr="S,anim,gen,m,norm,persn,sg" sem="" sem2=""/>апреля</w> <w><ana lex="преобладать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="d:pref" sem2=""/>преобладает</w>.</se><se> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>До</w> <w><ana lex="приход" gr="S,gen,inan,m,norm,sg" sem="t:group pt:set t:move der:s0 r:abstr der:v t:space sc:hum r:concr" sem2="r:abstr t:poss"/>прихода</w> <w><ana lex="вчерашний" gr="A,gen,norm,pl,plen" sem="der:adv r:rel t:time" sem2="der:adv r:rel t:time"/>вчерашних</w> <w><ana lex="мрачный" gr="A,gen,norm,pl,plen" sem="dt:light dt:neg t:physq:light dt:abstr der:s r:qual" sem2="dt:light dt:neg dt:abstr ev:neg der:s r:qual t:psych:emot"/>мрачных</w> <w><ana lex="туча" gr="S,f,gen,inan,norm,pl" sem="qc:stuff top:form r:concr" sem2="t:quant:max pt:qtm r:concr r:abstr"/>туч</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="север" gr="S,gen,inan,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr t:fam pt:part pc:space"/><ana lex="север" gr="S,anim,gen,m,norm,persn,sg" sem="" sem2=""/>севера</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="довольно" gr="ADV,norm" sem="t:degr dt