<p><se><w>Итак</w>, <w><ana lex="ближний" gr="A,m,nom,norm,plen,sg" sem="t:dist:min r:rel" sem2="t:social r:rel"/>ближний</w> <w><ana lex="район" gr="S,inan,m,nom,norm,sg" sem="t:space r:concr" sem2="t:space r:concr pt:part pc:space"/>район</w> (<w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="юг" gr="S,gen,inan,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr pt:part pc:space"/>юга</w>) -- <w><ana lex="гора" gr="S,f,inan,nom,norm,sg" sem="top:hill t:space r:concr" sem2="sc:x pt:set t:space t:form r:abstr t:quant:max r:concr"/>гора</w> <w><ana lex="бага" gr="S,bastard,f,inan,nom,sg" sem="" sem2=""/>Бага-богдо</w> -- <w><ana lex="особенно" gr="ADV,norm" sem="t:degr:max der:a" sem2="der:aprt der:a"/>особенно</w> <w><ana lex="богатый" gr="A,brev,m,norm,sg" sem="r:qual" sem2="der:shift r:qual"/>богат</w> <w><ana lex="ископаемый" gr="A,ins,norm,pl,plen" sem="r:rel" sem2="r:rel"/>ископаемыми</w>.</se><se> <w><ana lex="американский" gr="A,f,nom,norm,plen,sg" sem="dt:topon r:rel der:s t:topon" sem2=""/>Американская</w> <w><ana lex="экспедиция" gr="S,f,inan,nom,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиция</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="автомобиль" gr="S,inan,loc,m,norm,pl" sem="t:tool:transp r:concr" sem2=""/>автомобилях</w> <w><ana lex="нынче" gr="ADV,norm" sem="der:adv t:time" sem2=""/>нынче</w> <w><ana lex="второй" gr="ANUM,0,norm" sem="r:ord der:num r:rel t:ord" sem2="t:hier t:share r:rel der:num"/>второй</w> <w><ana lex="год" gr="S,acc,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:age r:abstr"/>год</w> <w><ana lex="производить" gr="V,act,f,indic,ipf,norm,praet,sg,tran" sem="d:pref" sem2="ca:caus d:pref t:be:appear"/>производила</w> <w><ana lex="свой" gr="APRO,acc,inan,norm,pl" sem="r:poss" sem2="t:social r:poss"/>свои</w> <w><ana lex="исследование" gr="S,acc,inan,n,norm,pl" sem="t:ment der: