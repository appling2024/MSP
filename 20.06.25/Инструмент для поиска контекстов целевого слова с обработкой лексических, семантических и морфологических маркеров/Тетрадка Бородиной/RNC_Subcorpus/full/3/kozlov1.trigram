<p><se><w><ana lex="по" gr="PR,norm" sem="" sem2=""/>По</w> <w><ana lex="возвращение" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr t:poss" sem2=""/>возвращении</w> <w><ana lex="домой" gr="ADV,norm" sem="der:s t:dir" sem2=""/>домой</w> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>мы</w> <w><ana lex="сесть" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus der:shift d:root t:move:body t:changest" sem2="d:root"/>сели</w> <w><ana lex="ужинать" gr="V,act,inf,ipf,norm,tran" sem="ca:noncaus t:physiol der:s d:pref" sem2=""/><ana lex="ужинать" gr="V,act,inf,intr,ipf,norm" sem="ca:noncaus t:physiol der:s d:pref" sem2=""/>ужинать</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="после" gr="ADV,norm" sem="t:time" sem2=""/>после</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="наш" gr="APRO,f,loc,norm,sg" sem="r:poss" sem2=""/>нашей</w> <w><ana lex="комната" gr="S,f,inan,loc,norm,sg" sem="top:contain pc:constr:build t:room pt:part pc:room:appart r:concr" sem2="top:contain pc:constr:build r:concr t:room pt:part"/>комнате</w> <w><ana lex="вести" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="ca:caus t:move d:root" sem2="aux:caus ca:caus t:move d:root ca:bgr"/>вели</w> <w><ana lex="интимный" gr="A,acc,f,norm,plen,sg" sem="r:qual" sem2=""/>интимную</w> <w><ana lex="беседа" gr="S,acc,f,inan,norm,sg" sem="t:speech r:abstr" sem2="r:abstr"/>беседу</w> (<w><ana lex="как" gr="CONJ,norm" sem="" sem2=""/>как</w> <w><ana lex="всегда" gr="ADVPRO,norm" sem="r:spec t:time" sem2=""/>всегда</w>, <w><ana lex="втроем" gr="ADV,norm" sem="t:quant:abs r:numcoll der:num" sem2=""/>втроем</w>).</se><se> <w><ana lex="наш" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>Наш</w> <w><ana lex="друг" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr" sem2="t:hum r:concr"/>друг</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="сведущий" gr="A,brev,m,norm,sg" sem="der:v ev:posit t:humq dt:ment r:qual" sem2=""/>сведущ</w>,