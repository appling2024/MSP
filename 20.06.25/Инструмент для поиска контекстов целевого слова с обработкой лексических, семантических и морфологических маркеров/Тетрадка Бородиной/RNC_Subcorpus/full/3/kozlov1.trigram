lex="он" gr="SPRO,3p,m,nom,norm,sg" sem="r:pers" sem2=""/>он</w> <w><ana lex="поднести" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus t:move d:pref"/><ana lex="поднести" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus t:move d:pref"/>поднес</w> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w> <w><ana lex="два" gr="NUM,acc,f,inan,norm" sem="r:card:pauc" sem2=""/>две</w> <w><ana lex="интересный" gr="A,acc,inan,norm,pl,plen" sem="dt:abstr der:s dt:ment r:qual" sem2="dt:abstr ev:posit der:s dt:ment r:qual"/>интересные</w> <w><ana lex="вещица" gr="S,f,gen,inan,norm,sg" sem="t:thing r:concr der:s d:dim" sem2=""/>вещицы</w>: <w><ana lex="оригинальный" gr="A,f,gen,norm,plen,sg" sem="r:rel der:s" sem2="r:rel der:s"/>оригинальной</w> <w><ana lex="форма" gr="S,f,gen,inan,norm,sg" sem="r:abstr" sem2="t:tool sc:partb t:form r:abstr sc:tool:cloth pt:aggr:aggrpl pt:aggr r:concr ev:posit"/>формы</w> <w><ana lex="табакерка" gr="S,acc,f,inan,norm,sg" sem="top:contain t:tool r:concr der:s" sem2=""/>табакерку</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="слоновый" gr="A,f,gen,norm,plen,sg" sem="r:rel der:s dt:animal" sem2=""/>слоновой</w> <w><ana lex="кость" gr="S,f,gen,inan,norm,sg" sem="pt:partb:inner pc:animal r:concr pc:hum" sem2="sc:workart t:tool t:stuff pt:aggr:aggrpl pt:aggr sc:partb r:concr"/>кости</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="монгольский" gr="A,acc,f,norm,plen,sg" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>монгольскую</w> <w><ana lex="спичечница" gr="S,acc,f,inan,norm,sg" sem="top:contain t:tool r:concr der:s" sem2=""/>спичечницу</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="крючок" gr="S,inan,ins,m,norm,sg" sem="d:dim t:tool top:form r:concr der:s" sem2="t:form r:concr r:abstr"/>крючком</w> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="вынимание" gr=