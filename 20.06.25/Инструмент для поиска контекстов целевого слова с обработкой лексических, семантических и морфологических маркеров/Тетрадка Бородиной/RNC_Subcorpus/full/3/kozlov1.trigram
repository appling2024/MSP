<p><se><w><ana lex="наконец" gr="ADV,PARENTH,norm" sem="der:s t:time" sem2=""/>Наконец-то</w> <w><ana lex="увести" gr="V,act,indic,norm,pf,pl,praet" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus t:move t:poss d:pref"/>увели</w> <w><ana lex="со" gr="PR,norm" sem="" sem2=""/>со</w> <w><ana lex="двор" gr="S,gen,inan,m,norm,sg" sem="pt:set t:space r:concr pc:constr:build t:group sc:hum pt:addit" sem2="t:space r:concr pc:constr:build t:org t:constr pt:addit"/>двора</w> <w><ana lex="наш" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/>наших</w> <w><ana lex="верблюд" gr="S,anim,gen,m,norm,pl" sem="t:animal r:concr" sem2=""/>верблюдов</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="называть" gr="V,acc,inan,ipf,m,norm,partcp,pass,plen,praes,sg,tran" sem="t:speech der:v d:pref d:impf" sem2=""/>называемый</w> <w><ana lex="госторг" gr="S,acc,bastard,inan,m,sg" sem="" sem2=""/>Госторг</w>.</se><se> <w><ana lex="там" gr="ADVPRO,norm" sem="t:place r:dem" sem2=""/>Там</w> <w><ana lex="они" gr="SPRO,3p,dat,norm,pl" sem="r:pers" sem2=""/>им</w> <w><ana lex="вначале" gr="ADV,norm" sem="der:s t:time" sem2=""/>вначале</w> <w><ana lex="приготовить" gr="V,act,indic,norm,pf,pl,praet" sem="d:pref der:s" sem2="d:pref der:s"/>приготовили</w> <w><ana lex="мягкий" gr="A,acc,f,norm,plen,sg" sem="t:physq r:qual" sem2="ev:posit t:humq t:physq der:shift t:sound r:qual t:species r:rel"/>мягкую</w> <w><ana lex="подстилка" gr="S,acc,f,inan,norm,sg" sem="der:v t:loc r:abstr der:s0" sem2="qc:stuff der:v t:stuff r:concr"/>подстилку</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="корм" gr="S,acc,inan,m,norm,sg" sem="der:v t:physiol r:abstr der:s0" sem2="hi:class sc:food der:v t:food:fodder pt:aggr r:concr"/>корм</w> -- <w><ana lex="полный" gr="A,m,nom,norm,plen,sg" sem="t:content r:qual" sem2="t:degr t:appearance r:qual"/>полный</w> <w><ana lex="отдых" gr="S,inan,m,nom,norm,sg" sem="r:abstr" sem2=""/>отдых</w>, <w><ana lex="внимательный" gr="A,n,nom,norm,plen,sg" sem="t:humq r:qual" sem2="t:humq r:qual"/>внимательное</w> <w><ana lex="отношение" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr der:s0 t:inter" sem2="der:v t:text r:concr r:abstr t:inter"/>отношение</w>, <w><ana lex="затем" gr="ADV,norm" sem="der:apro t:time r:dem" sem2=""/>затем</w>, <w>вероятно</w>, <w><ana lex="поставить" gr="V,3p,act,fut,indic,norm,pf,pl" sem="der:v d:pref" sem2=""/>поставят</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="работа" gr="S,acc,f,inan,norm,sg" sem="der:v r:abstr" sem2="sc:x t:text t:workdram t:workmus r:abstr t:workart der:v pt:aggr t:workcin r:concr"/>работу</w> -- <w><ana lex="везти" gr="V,act,inf,ipf,norm" sem="ca:caus t:move d:root ca:noncaus" sem2="ca:caus d:root"/>везти</w> <w><ana lex="вьюк" gr="S,acc,inan,m,norm,pl" sem="sc:thing der:v t:tool top:contain pt:qtm pt:set r:concr" sem2=""/>вьюки</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="калган" gr="S,acc,inan,m,norm,sg" sem="t:plant r:concr" sem2=""/>Калган</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="обратно" gr="ADV,norm" sem="dt:dir t:dir der:a" sem2=""/>обратно</w>!</se></p>
<p><se><w><ana lex="вечер" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечером</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="монотонный" gr="A,gen,n,norm,plen,sg" sem="der:comp ev:neg t:sound r:qual" sem2=""/>монотонного</w> <w><ana lex="времяпрепровождение" gr="S,gen,inan,n,norm,sg" sem="der:comp r:abstr" sem2=""/>времяпрепровождения</w> <w><ana lex="играть" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="d:root" sem2="d:root"/>играли</w> «<w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="дурачок" gr="S,anim,gen,m,norm,sg" sem="d:masc ev:neg der:s d:dim t:hum r:concr" sem2="d:masc ev:neg der:s d:dim t:hum ev r:concr"/>дурачка</w>».</se></p>
<p><se><w><ana lex="погода" gr="S,f,inan,nom,norm,sg" sem="r:abstr t:weather" sem2=""/>Погода</w> <w><ana form="по-прежнему" lex="по-прежнему" gr="ADV,norm" sem="dt:time der:a" sem2=""/>по-прежнему</w> <w><ana lex="продолжать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="aux:phase d:pref der:a" sem2=""/>продолжает</w> <w><ana lex="стоять" gr="V,act,inf,intr,ipf,norm" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:noncaus"/>стоять</w> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="здешний" gr="A,gen,norm,pl,plen" sem="t:place r:rel der:adv" sem2=""/>здешних</w> <w><ana lex="место" gr="S,gen,inan,n,norm,pl" sem="qc:space t:space r:concr" sem2="qc:space sc:org t:tool t:space pt:element r:abstr pt:aggr:aggrpl pt:part pc:text r:concr"/>мест</w> <w><ana lex="довольно" gr="ADV,norm" sem="t:degr dt:humq der:a" sem2="ev:posit dt:humq der:a"/>довольно</w> <w><ana lex="мягкий" gr="A,f,nom,norm,plen,sg" sem="t:physq r:qual" sem2="ev:posit t:humq t:physq der:shift t:sound r:qual t:species r:rel"/>мягкая</w>, <w><ana lex="температура" gr="S,f,inan,nom,norm,sg" sem="r:abstr t:param t:temper" sem2="t:physiol r:abstr t:temper"/>температура</w> <w><ana lex="редко" gr="ADV,norm" sem="t:freq dt:time der:a" sem2=""/>редко</w> <w><ana lex="спускаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/>спускается</w> <w><ana lex="низкий" gr="A,comp,norm,plen" sem="t:size:min r:qual" sem2="t:humq t:hier t:level r:qual t:size:min t:sound ev:neg t:interpretation"/>ниже</w> -<w><ana lex="20" gr="NUM,ciph"/>20</w>°<w><ana lex="r" gr="bastard" sem="" sem2=""/>R</w>, <w><ana lex="частый" gr="A,comp,norm,plen" sem="t:physq r:qual" sem2="t:dist r:qual"/>чаще</w> <w><ana lex="стоять" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:noncaus"/><ana lex="стоить" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="d:root" sem2="d:root"/>стоит</w> <w><ana lex="высокий" gr="A,comp,norm,plen" sem="t:size:max r:qual" sem2="ev:posit der:shift t:size:max t:sound t:degr:max r:qual t:interpretation"/>выше</w>, <w><ana lex="даже" gr="CONJ,norm" sem="" sem2=""/>даже</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="утренний" gr="A,f,loc,norm,plen,sg" sem="dt:abstr dt:time r:rel der:s" sem2=""/>утренней</w> <w><ana lex="зара" gr="S,f,inan,loc,norm,sg" sem="" sem2=""/><ana lex="зара" gr="S,anim,f,loc,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/><ana lex="заря" gr="S,f,inan,loc,norm,sg" sem="r:abstr t:light t:weather" sem2="ev:posit t:sound r:abstr"/>заре</w>.</se><se> <w><ana lex="ночь" gr="S,f,gen,inan,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2=""/>Ночи</w> <w><ana lex="превосходный" gr="A,nom,norm,pl,plen" sem="ev:posit t:quality r:qual" sem2="r:qual"/>превосходные</w>: <w><ana lex="тихий" gr="A,nom,norm,pl,plen" sem="d:neg t:sound r:qual" sem2="d:neg t:humq t:speed:min der:shift t:sound r:qual"/>тихие</w>, <w><ana lex="дивно" gr="ADV,norm" sem="ev:posit dt:degr der:a" sem2=""/>дивно-прозрачные</w>, <w><ana lex="яркозвездный" gr="A,bastard,nom,pl,plen" sem="" sem2=""/>яркозвездные</w>.</se><se> <w><ana lex="млечный" gr="A,m,nom,norm,plen,sg" sem="dt:stuff r:rel der:s" sem2=""/>Млечный</w> <w><ana lex="путь" gr="S,inan,m,nom,norm,sg" sem="top:stripe t:space r:concr" sem2="ev:posit t:space t:asp r:abstr sc:space pt:aggr:aggrpl pt:aggr top:stripe r:concr der:shift"/>Путь</w>, <w><ana lex="созвездие" gr="S,inan,n,nom,norm,pl" sem="t:space t:astr sc:space:astr pt:set der:s r:concr" sem2="t:group pt:set r:concr sc:hum der:s"/>созвездия</w> <w><ana lex="орион" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Орион</w>, <w><ana lex="орел" gr="S,inan,m,nom,norm,sg" sem="r:propn t:topon" sem2="der:shift r:concr t:fam"/><ana lex="орел" gr="S,inan,m,nom,norm,sg" sem="r:propn t:topon" sem2="der:shift r:concr t:fam"/><ana lex="орел" gr="S,anim,m,nom,norm,sg" sem="t:animal r:concr" sem2=""/>Орел</w>, <w><ana lex="лебедь" gr="S,anim,m,nom,norm,sg" sem="t:animal r:concr" sem2=""/><ana lex="лебедь" gr="S,anim,famn,m,nom,norm,sg" sem="t:animal r:concr" sem2=""/>Лебедь</w>, <w><ana lex="вега" gr="S,f,inan,nom,norm,sg" sem="t:letter r:concr" sem2="t:topon:astr r:propn"/>Вега</w> -- <w><ana lex="один" gr="APRO,n,nom,norm,sg" sem="" sem2="r:indet"/>одно</w> <w><ana lex="сплошной" gr="A,n,nom,norm,plen,sg" sem="r:rel der:adv" sem2="der:adv r:rel t:degr:max r:qual"/>сплошное</w> <w><ana lex="небесный" gr="A,n,nom,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space ev:posit r:rel der:s"/>небесное</w> <w><ana lex="очарование" gr="S,inan,n,nom,norm,sg" sem="ev:posit r:abstr" sem2=""/>очарование</w>.</se></p>
<p><se><w><ana lex="поздний" gr="A,ins,m,norm,plen,sg" sem="t:time r:qual" sem2="t:time r:qual"/>Поздним</w> <w><ana lex="вечер" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>вечером</w>, <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="9" gr="NUM,ciph"/>9</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="11" gr="NUM,ciph"/>11</w>ј <w><ana lex="час" gr="S,gen,inan,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часа</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="доставить" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:caus t:move d:pref" sem2="d:pref"/>доставил</w> <w><ana lex="огромный" gr="A,acc,inan,m,norm,plen,sg" sem="t:size:max r:qual" sem2="t:quant:max t:degr:max r:qual"/>огромный</w> <w><ana lex="интерес" gr="S,acc,inan,m,norm,sg" sem="t:ment r:abstr" sem2="r:abstr ev:neg"/>интерес</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="высокий" gr="A,acc,n,norm,plen,sg" sem="t:size:max r:qual" sem2="ev:posit der:shift t:size:max t:sound t:degr:max r:qual t:interpretation"/>высокое</w> <w><ana lex="удовольствие" gr="S,acc,inan,n,norm,sg" sem="t:psych:emot r:abstr" sem2="ev:posit r:abstr"/>удовольствие</w> <w><ana lex="два" gr="NUM,dat,norm" sem="r:card:pauc" sem2=""/>двум</w> <w><ana lex="милый" gr="A,dat,norm,pl,plen" sem="t:humq r:qual" sem2="ev:posit t:social:emot r:qual"/>милым</w> <w><ana lex="девушка" gr="S,anim,dat,f,norm,pl" sem="t:hum r:concr der:s" sem2="t:hum r:concr der:s"/>девушкам</w> <w><ana lex="цокто" gr="S,0,anim,bastard,m,sg" sem="t:hum r:propn t:persn" sem2=""/>Цокто</w> <w><ana lex="гармаевич" gr="S,anim,bastard,gen,m,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Гармаевича</w> -- <w><ana lex="маруся" gr="S,anim,f,loc,norm,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/>Марусе</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="нате" gr="PART,norm" sem="" sem2=""/>Нате</w>, <w><ana lex="показать" gr="V,act,ger,norm,pf,praet" sem="der:v ca:caus d:pref t:perc" sem2="der:v ca:caus d:pref t:perc"/>показав</w> <w><ana lex="они" gr="SPRO,3p,dat,norm,pl" sem="r:pers" sem2=""/>им</w> <w><ana lex="стереоскоп" gr="S,acc,inan,m,norm,sg" sem="der:comp r:concr t:tool:device:measur:optic" sem2=""/>стереоскоп</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="вид" gr="S,anim,famn,ins,m,norm,pl" sem="" sem2=""/><ana lex="вид" gr="S,inan,ins,m,norm,pl" sem="der:v r:abstr" sem2="t:ment t:space r:abstr t:workart der:v t:perc r:concr t:fam"/>видами</w>, <w><ana lex="тип" gr="S,inan,ins,m,norm,pl" sem="r:abstr" sem2="pt:aggr r:abstr r:phras"/><ana lex="тип" gr="S,anim,ins,m,norm,pl" sem="" sem2="t:hum ev r:concr ev:neg"/>типами</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="образец" gr="S,inan,ins,m,norm,pl" sem="t:thing r:concr" sem2="r:abstr"/>образцами</w> <w><ana lex="государственный" gr="A,gen,n,norm,plen,sg" sem="dt:space r:rel der:s" sem2="ev:posit r:rel der:s t:humq:char"/>государственного</w> <w><ana lex="достояние" gr="S,gen,inan,n,norm,sg" sem="r:abstr t:poss" sem2="sc:thing pt:aggr r:concr r:abstr t:poss"/>достояния</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="область" gr="S,f,inan,loc,norm,sg" sem="t:space r:concr pt:part pc:space" sem2="t:space r:concr r:abstr pt:part pc:space"/>области</w> <w><ana lex="художественный" gr="A,gen,n,norm,plen,sg" sem="r:rel der:s" sem2="ev:posit r:rel"/>художественного</w> <w><ana lex="творчество" gr="S,gen,inan,n,norm,sg" sem="t:ment r:abstr t:be:appear" sem2=""/>творчества</w>, <w><ana lex="равный" gr="A,brev,n,norm,sg" sem="t:like r:qual" sem2=""/>равно</w> <w><ana lex="познакомить" gr="V,act,ger,norm,pf,praet,tran" sem="d:pref" sem2=""/>познакомив</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="улица" gr="S,f,inan,ins,norm,pl" sem="t:space r:concr pt:part pc:space" sem2="sc:hum pt:aggr t:space r:concr sc:space"/>улицами</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="выдающийся" gr="A,ins,norm,pl,plen" sem="der:v:part t:degr:max r:qual" sem2=""/>выдающимися</w> <w><ana lex="здание" gr="S,inan,ins,n,norm,pl" sem="der:v top:contain t:constr r:concr" sem2=""/>зданиями</w> <w><ana lex="столица" gr="S,f,gen,inan,norm,sg" sem="sc:constr:build t:space r:concr" sem2=""/>столицы</w>, <w><ana lex="иностранный" gr="A,gen,norm,pl,plen" sem="der:comp r:rel" sem2="der:comp r:rel"/>иностранных</w> <w><ana lex="город" gr="S,gen,inan,m,norm,pl" sem="sc:constr:build t:space r:concr" sem2="t:space r:concr"/>городов</w>, <w><ana lex="парад" gr="S,inan,ins,m,norm,pl" sem="t:action r:abstr" sem2="r:abstr"/>парадами</w> <w><ana lex="войско" gr="S,gen,inan,n,norm,pl" sem="t:group pt:aggr:aggrpl der:v r:concr sc:hum" sem2="sc:hum der:v t:org pt:set pt:part r:concr"/>войск</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="проч" gr="S,anim,bastard,m,nom,sg" sem="" sem2=""/><ana lex="проча" gr="S,bastard,f,gen,inan,pl" sem="" sem2=""/>проч</w>.</se><se>, <w><ana lex="проч" gr="S,anim,bastard,m,nom,sg" sem="" sem2=""/>проч</w>.</se><se> <w><ana lex="чуткий" gr="A,nom,norm,pl,plen" sem="r:rel" sem2="ev:posit t:humq r:qual"/>Чуткие</w> <w><ana lex="девушка" gr="S,anim,f,nom,norm,pl" sem="t:hum r:concr der:s" sem2="t:hum r:concr der:s"/>девушки</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>были</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="неописуемый" gr="A,loc,m,norm,plen,sg" sem="der:v d:impot r:rel" sem2="t:degr:max:magn der:v d:impot r:qual"/>неописуемом</w> <w><ana lex="восторг" gr="S,inan,loc,m,norm,sg" sem="t:psych:emot r:abstr" sem2=""/>восторге</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="благодарить" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="t:speech ca:noncaus" sem2=""/>благодарили</w>.</se></p>
<p><se><b/><w><b>18</b></w><b>/</b><w><ana lex="xii" gr="bastard" sem="" sem2=""/><b>XII</b></w><b>, </b><w><ana lex="u" gr="bastard" sem="" sem2=""/><b>U</b></w><b/>. <w><ana lex="приятный" gr="A,n,nom,norm,plen,sg" sem="ev:posit r:qual" sem2="ev:posit t:humq r:qual"/>Приятное</w> <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утро</w>, <w><ana lex="хотя" gr="CONJ,norm" sem="" sem2=""/>хотя</w> <w><ana lex="порывистый" gr="A,acc,inan,m,norm,plen,sg" sem="t:physq der:s:deverb dt:space r:qual" sem2="t:humq der:shift:n t:physq dt:space r:qual der:s:deverb"/>порывистый</w>, <w><ana lex="меняться" gr="V,acc,act,inan,intr,ipf,m,norm,partcp,plen,praes,sg" sem="ca:noncaus" sem2="ca:noncaus"/>меняющийся</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="направление" gr="S,inan,loc,n,norm,pl" sem="r:abstr t:dir" sem2="t:doc t:space der:s0 r:abstr der:v pt:part pc:space r:concr"/>направлениях</w> <w><ana lex="ветер" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>ветер</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="портить" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="d:root" sem2=""/>портит</w> <w><ana lex="он" gr="SPRO,3p,acc,m,norm,sg" sem="r:pers" sem2=""/>его</w>.</se><se> <w>Ясно</w>, <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="горизонт" gr="S,dat,inan,m,norm,sg" sem="t:space r:concr" sem2="t:ment t:space qc:stuff pt:qtm r:abstr pt:aggr r:concr"/>горизонту</w> <w><ana lex="проноситься" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/><ana lex="проноситься" gr="V,3p,act,fut,indic,intr,norm,pf,pl" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/><ana lex="проноситься" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/><ana lex="проноситься" gr="V,3p,act,fut,indic,intr,norm,pf,pl" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/><ana lex="пронестись" gr="V,3p,act,fut,indic,intr,norm,pf,pl" sem="der:v ca:noncaus t:move d:pref" sem2="der:v d:pref"/>проносятся</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="вид" gr="S,anim,famn,loc,m,norm,sg" sem="" sem2=""/><ana lex="вид" gr="S,inan,loc,m,norm,sg" sem="der:v r:abstr" sem2="t:ment t:space r:abstr t:workart der:v t:perc r:concr t:fam"/>виде</w> <w><ana lex="кружево" gr="S,gen,inan,n,norm,pl" sem="t:pattern t:stuff r:concr sc:tool:cloth" sem2=""/>кружев</w> <w><ana lex="тонко" gr="ADV,norm" sem="dt:size:min ev:posit der:a" sem2="dt:size:min ev der:a"/>тонко-перистые</w> <w><ana lex="облачко" gr="S,gen,inan,n,norm,sg" sem="d:dim r:concr der:s" sem2=""/>облачка</w>.</se><se> <w><ana lex="дать" gr="V,act,indic,norm,pf,pl,praet" sem="ca:caus d:root t:poss" sem2="d:root"/>Дали</w> <w><ana lex="открыть" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="t:impact ca:caus d:pref" sem2="t:speech ca:noncaus d:pref"/>открыты</w>.</se><se> <w><ana lex="приближаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v d:pref" sem2=""/>Приближается</w> <w><ana lex="новый" gr="A,m,nom,norm,plen,sg" sem="t:time r:qual" sem2="t:time r:qual"/>новый</w> <w><ana lex="ранний" gr="A,m,nom,norm,plen,sg" sem="t:time r:qual" sem2="t:time r:qual"/>ранний</w> <w><ana lex="праздник" gr="S,inan,m,nom,norm,sg" sem="t:action r:abstr" sem2="r:abstr"/>праздник</w>, <w><ana lex="отдаленный" gr="A,gen,norm,pl,plen" sem="t:dist:max r:rel" sem2="r:rel"/>отдаленных</w> <w><ana lex="ученик" gr="S,anim,gen,m,norm,pl" sem="der:v t:hum r:concr d:nag" sem2="der:v t:hum r:concr d:nag"/>учеников</w> <w><ana lex="решить" gr="V,act,indic,norm,pf,pl,praet" sem="t:ment ca:noncaus" sem2="t:ment ca:noncaus t:psych:volit"/>решили</w> <w><ana lex="узко" gr="ADV,comp,norm" sem="dt:size:min der:a" sem2="dt:size:min der:a"/><ana lex="уже" gr="ADV,norm" sem="t:time" sem2=""/>уже</w> <w><ana lex="отпустить" gr="V,act,inf,norm,pf" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus ca:0 d:pref ca:bgr"/>отпустить</w>!</se></p>
<p><se><w><ana lex="мой" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>Мой</w> <w><ana lex="спутник" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,inan,m,nom,norm,sg" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутник</w> <w><ana lex="бохин" gr="S,anim,bastard,famn,m,nom,sg" sem="t:hum r:propn t:famn" sem2=""/><ana lex="бохин" gr="S,bastard,inan,m,nom,sg" sem="" sem2=""/>Бохин</w> <w><ana lex="подыскать" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v d:pref" sem2=""/>подыскал</w> <w><ana lex="себе" gr="SPRO,dat,norm" sem="" sem2=""/>себе</w> <w><ana lex="место" gr="S,acc,inan,n,norm,sg" sem="qc:space t:space r:concr" sem2="qc:space sc:org t:tool t:space pt:element r:abstr pt:aggr:aggrpl pt:part pc:text r:concr"/>место</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="свой" gr="APRO,f,loc,norm,sg" sem="r:poss" sem2="t:social r:poss"/>своей</w> <w><ana lex="область" gr="S,f,inan,loc,norm,sg" sem="t:space r:concr pt:part pc:space" sem2="t:space r:concr r:abstr pt:part pc:space"/>области</w> -- <w><ana lex="делопроизводитель" gr="S,anim,ins,m,norm,sg" sem="der:comp t:hum r:concr d:nag" sem2=""/>делопроизводителем</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="санитарный" gr="A,f,loc,norm,plen,sg" sem="r:rel der:s" sem2="r:rel der:s dt:hum"/>санитарной</w> <w><ana lex="часть" gr="S,f,inan,loc,norm,sg" sem="r:concr pc:x pt:part" sem2="pc:org r:abstr sc:part t:org pt:ind pt:aggr:aggrpl t:poss der:shift pc:x pt:part pc:text r:concr"/>части</w>.</se><se> <w><ana lex="если" gr="CONJ,norm" sem="" sem2=""/>Если</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="быть" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>будет</w> <w><ana lex="пить" gr="V,act,inf,ipf,norm,tran" sem="ca:caus t:physiol d:root" sem2="d:root"/>пить</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="он" gr="SPRO,3p,ins,m,norm,sg" sem="r:pers" sem2=""/>ним</w> <w><ana lex="быть" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>будет</w> <w><ana lex="надзор" gr="S,inan,m,nom,norm,sg" sem="der:v r:abstr der:s0" sem2="der:v t:org d:nag sc:hum pt:aggr r:concr"/>надзор</w>, <w><ana lex="выйти" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="der:v t:move d:pref" sem2=""/><ana lex="выйти" gr="V,3p,act,fut,indic,norm,pf,sg" sem="der:v t:move d:pref" sem2=""/><ana lex="выходить" gr="V,3p,act,fut,indic,norm,pf,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v d:pref"/>выйдет</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="стезя" gr="S,acc,f,inan,norm,sg" sem="top:stripe t:space r:concr" sem2=""/>стезю</w> <w><ana lex="настоящий" gr="A,gen,m,norm,plen,sg" sem="r:rel t:time" sem2="ev:posit r:dem t:ver t:degr t:degr:max r:qual r:rel"/>настоящего</w> <w><ana lex="работник" gr="S,anim,gen,m,norm,sg" sem="der:v t:hum ev:posit r:concr d:nag" sem2="der:v t:hum r:concr d:nag t:prof"/>работника</w>.</se></p>
<p><se><w><ana lex="кондратьев" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Кондратьев</w> <w><ana lex="продолжать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="aux:phase d:pref der:a" sem2=""/>продолжает</w> <w><ana lex="успешно" gr="ADV,norm" sem="ev:posit der:a" sem2=""/>успешно</w> <w><ana lex="работать" gr="V,act,inf,intr,ipf,norm" sem="der:s" sem2="der:s"/>работать</w>!</se><se> <w><ana lex="канаев" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Канаев</w> <w><ana lex="понемногу" gr="ADV,norm" sem="t:quant:min der:adv" sem2="der:adv"/>понемногу</w> <w><ana lex="делать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="d:root" sem2="d:root"/>делает</w> <w><ana lex="птица" gr="S,acc,anim,f,norm,pl" sem="t:animal r:concr hi:class" sem2=""/>птиц</w> (<w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="шкурка" gr="S,acc,f,inan,norm,pl" sem="qc:stuff d:dim pc:animal r:concr der:s" sem2="t:stuff r:concr der:s pc:gruit"/>шкурки</w>).</se><se> <w>Прочие</w>, <w><ana lex="кроме" gr="PR,norm" sem="" sem2=""/>кроме</w> <w><ana lex="ночной" gr="A,gen,norm,pl,plen" sem="dt:abstr dt:time r:rel der:s t:time" sem2=""/>ночных</w> <w><ana lex="дежурство" gr="S,gen,inan,n,norm,pl" sem="der:v r:abstr" sem2=""/>дежурств</w>, <w><ana lex="праздновать" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="" sem2=""/>празднуют</w>.</se><se> <w><ana lex="галсан" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Галсан</w> <w><ana lex="собираться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref t:psych:volit"/>собирается</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="верхнеудинск" gr="S,acc,inan,m,norm,sg" sem="r:propn t:topon" sem2=""/>Верхнеудинск</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="хамбо" gr="S,0,bastard,inan" sem="" sem2=""/>хамбо-ламе</w>.</se></p>
