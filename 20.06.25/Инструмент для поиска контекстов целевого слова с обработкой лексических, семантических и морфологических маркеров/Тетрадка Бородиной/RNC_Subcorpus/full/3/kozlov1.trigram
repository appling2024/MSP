<p><se><w><ana lex="бесконечно" gr="ADV,norm" sem="dt:time:dur t:degr:max der:a" sem2=""/>Бесконечно</w> <w>жаль</w> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w> <w><ana lex="всегда" gr="ADVPRO,norm" sem="r:spec t:time" sem2=""/>всегда</w> <w><ana lex="бывать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="t:be:exist ca:noncaus der:v d:impf" sem2="der:v t:loc der:shift d:impf ca:noncaus"/>бывает</w> <w><ana lex="тот" gr="APRO,gen,norm,pl" sem="r:dem" sem2=""/>тех</w> <w><ana lex="три" gr="NUM,gen,norm" sem="r:card:pauc" sem2=""/>трех</w> <w><ana lex="мой" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/>моих</w> <w><ana lex="спутник" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,gen,inan,m,norm,pl" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутников</w>, <w><ana lex="который" gr="APRO,nom,norm,pl" sem="r:rel t:ord" sem2=""/>которые</w> <w><ana lex="обреченный" gr="A,brev,norm,pl" sem="" sem2=""/>обречены</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="возвращение" gr="S,dat,inan,n,norm,sg" sem="der:v r:abstr t:poss" sem2=""/>возвращению</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="родной" gr="A,acc,inan,norm,pl,plen" sem="t:humq:char r:qual" sem2="ev:posit t:social:emot t:humq:char r:qual"/>родные</w> <w><ana lex="место" gr="S,acc,inan,n,norm,pl" sem="qc:space t:space r:concr" sem2="qc:space sc:org t:tool t:space pt:element r:abstr pt:aggr:aggrpl pt:part pc:text r:concr"/>места</w>.</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="другой" gr="APRO,loc,norm,pl" sem="r:spec" sem2="r:ord r:spec r:indet"/>других</w> <w><ana lex="случай" gr="S,inan,loc,m,norm,pl" sem="pt:qtm r:abstr" sem2="t:time:moment r:abstr"/>случаях</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="особенность" gr="S,f,inan,loc,norm,sg" sem="r:abstr der:a" sem2="r:abstr der:a"/>особенности</w> <w><ana lex="после" gr="PR,norm" sem="" sem2=""/>после</w> <w><ana lex="возвращение" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr t:poss" sem2=""/>возвращения</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="путешествие" gr="S,acc,inan,n,norm,pl" sem="t:move r:abstr" sem2=""/>путешествия</w>, <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="стремиться" gr="V,2p,act,indic,intr,ipf,norm,praes,sg" sem="ca:noncaus" sem2="ca:noncaus"/>стремишься</w> <w><ana lex="домой" gr="ADV,norm" sem="der:s t:dir" sem2=""/>домой</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w>теперь</w>...</se></p>
<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="вечер" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>вечером</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="долго" gr="ADV,norm" sem="t:time:dur:max dt:time:dur:max der:a" sem2=""/>долго</w> <w><ana lex="сидеть" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:noncaus"/>сидел</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="свой" gr="APRO,gen,norm,pl" sem="r:poss" sem2="t:social r:poss"/>своих</w> <w><ana lex="спутник" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,gen,inan,m,norm,pl" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутников</w>.</se><se> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>Мы</w> <w><ana lex="говорить" gr="V,act,indic,ipf,norm,pl,praet,tran" sem="t:speech ca:noncaus d:root" sem2="d:root"/>говорили</w> <w><ana lex="об" gr="PR,norm" sem="" sem2=""/>об</w> <w><ana lex="азия" gr="S,f,inan,loc,norm,sg" sem="r:propn t:topon" sem2=""/>Азии</w>, <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="ее" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,n,nom,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,f,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,m,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,n,nom,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,f,gen,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,n,norm,sg" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,f,gen,norm,pl" sem="r:poss" sem2=""/><ana lex="ее" gr="APRO,ge