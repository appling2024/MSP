<p><se><w><ana lex="после" gr="PR,norm" sem="" sem2=""/>После</w> <w><ana lex="данзан" gr="S,anim,gen,m,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Данзана</w> (<w><ana lex="во" gr="PR,norm" sem="" sem2=""/>во</w> <w><ana lex="двор" gr="S,inan,loc,m,norm,sg" sem="pt:set t:space r:concr pc:constr:build t:group sc:hum pt:addit" sem2="t:space r:concr pc:constr:build t:org t:constr pt:addit"/>дворе</w> <w><ana lex="который" gr="APRO,gen,m,norm,sg" sem="r:rel t:ord" sem2=""/>которого</w> <w><ana lex="возводиться" gr="V,act,f,indic,intr,ipf,norm,praet,sg" sem="d:pref" sem2=""/>возводилась</w> <w><ana lex="обширный" gr="A,f,nom,norm,plen,sg" sem="t:size:max r:rel" sem2="t:quant:max r:rel"/>обширная</w> <w><ana lex="постройка" gr="S,f,inan,nom,norm,sg" sem="der:v r:abstr der:s0 t:impact:creat" sem2="der:v top:contain t:constr:hut r:concr"/>постройка</w> <w><ana lex="китайский" gr="A,gen,m,norm,plen,sg" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>китайского</w> <w><ana lex="тип" gr="S,gen,inan,m,norm,sg" sem="r:abstr" sem2="pt:aggr r:abstr r:phras"/><ana lex="тип" gr="S,anim,gen,m,norm,sg" sem="" sem2="t:hum ev r:concr ev:neg"/>типа</w>.</se><se> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>Не</w> <w><ana lex="китайский" gr="A,gen,m,norm,plen,sg" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>китайского</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="русский" gr="A,gen,m,norm,plen,sg" sem="dt:topon r:rel der:s t:topon" sem2=""/>русского</w>!</se><se>) <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="направиться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2="ca:noncaus d:pref"/>направился</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="выход" gr="S,dat,inan,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="t:quant ev:posit t:space r:abstr der:v pc:constr pt:part r:concr"/>выходу</w> (<w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><a