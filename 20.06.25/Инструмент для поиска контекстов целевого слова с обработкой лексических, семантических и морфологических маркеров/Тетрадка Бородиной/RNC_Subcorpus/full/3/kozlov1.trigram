<p><se><w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>Я</w> <w><ana lex="хотеть" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="ca:noncaus t:psych:volit d:root" sem2="d:root"/>хотел</w> <w><ana lex="спать" gr="V,act,inf,intr,ipf,norm" sem="d:root" sem2="d:root"/>спать</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="рано" gr="ADV,norm" sem="dt:time ev:neg der:a t:time" sem2="dt:time der:a t:time"/>рано</w> <w><ana lex="улечься" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus d:pref t:move:body" sem2="ca:noncaus d:pref"/>улегся</w>.</se><se> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>Так</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w>приятно</w> <w><ana lex="лечь" gr="V,act,inf,intr,norm,pf" sem="ca:noncaus d:root t:move:body" sem2="d:root"/>лечь</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="свой" gr="APRO,acc,f,norm,sg" sem="r:poss" sem2="t:social r:poss"/>свою</w> <w><ana lex="постель" gr="S,acc,f,inan,norm,sg" sem="t:space r:concr t:tool:furn" sem2="sc:linen pt:aggr sc:bedding r:concr t:tool:bedding"/>постель</w>, <w><ana lex="теплый" gr="A,acc,f,norm,plen,sg" sem="dt:temper dt:abstr t:physq:temper der:s r:qual" sem2="ev:posit t:physq:color dt:temper t:physq:temper dt:abstr der:s r:qual r:rel"/>теплую</w>, <w><ana lex="мягкий" gr="A,acc,f,norm,plen,sg" sem="t:physq r:qual" sem2="ev:posit t:humq t:physq der:shift t:sound r:qual t:species r:rel"/>мягкую</w>, <w><ana lex="уютный" gr="A,acc,f,norm,plen,sg" sem="ev:posit r:rel der:s d:habit" sem2=""/>уютную</w> <w><ana lex="после" gr="PR,norm" sem="" sem2=""/>после</w> <w><ana lex="жесткий" gr="A,dat,f,norm,plen,sg" sem="t:physq r:qual" sem2="t:humq t:physq der:shift r:qual t:species r:rel"/>жесткой</w> <w><ana lex="кровать" gr="S,dat,f,inan,norm,sg" sem="r:concr t:tool:furn" sem2=""/>кровати</w> <w><ana lex="в" gr