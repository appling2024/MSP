<p><se><w><ana lex="что" gr="SPRO,acc,inan,n,norm,sg" sem="r:rel" sem2=""/><ana form="Что-то" lex="что-то" gr="SPRO,acc,inan,n,norm,sg" sem="r:indet" sem2=""/>Что-то</w> <w><ana lex="поделывать" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="der:v d:pref" sem2=""/>поделывают</w> <w><ana lex="мой" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>мои</w> «<w><ana lex="археолог" gr="S,anim,m,nom,norm,pl" sem="der:comp t:hum r:concr t:prof" sem2=""/>археологи</w>» <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="север" gr="S,inan,loc,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr t:fam pt:part pc:space"/><ana lex="север" gr="S,anim,loc,m,norm,persn,sg" sem="" sem2=""/>севере</w>?</se><se> <w><ana lex="чем" gr="CONJ,norm" sem="" sem2=""/>Чем</w> <w><ana lex="они" gr="SPRO,3p,nom,norm,pl" sem="r:pers" sem2=""/>они</w> <w><ana lex="я" gr="SPRO,1p,acc,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="порадовать" gr="V,3p,act,fut,indic,norm,pf,pl,tran" sem="der:v ca:caus d:pref t:psych:emot" sem2=""/>порадуют</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="весна" gr="S,dat,f,inan,norm,sg" sem="t:time:season r:abstr t:time" sem2=""/>весне</w>?</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="какой" gr="APRO,acc,f,norm,sg" sem="t:neg r:rel ev:neg" sem2=""/>какую</w> <w><ana lex="форма" gr="S,acc,f,inan,norm,sg" sem="r:abstr" sem2="t:tool sc:partb t:form r:abstr sc:tool:cloth pt:aggr:aggrpl pt:aggr r:concr ev:posit"/>форму</w> <w><ana lex="вылиться" gr="V,3p,act,fut,indic,intr,norm,pf,pl" sem="ca:noncaus t:move d:pref" sem2="ca:noncaus d:pref"/>выльются</w> <w><ana lex="весь" gr="APRO,nom,norm,pl" sem="r:spec" sem2=""/>все</w> <w><ana lex="мой" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>мои</w> <w><ana lex="радужный" gr="A,nom,norm,pl,plen" sem="dt:space r:rel der:s" sem2="dt:space ev:posit der:s"/>радужные</w> <w><ana lex="ожидание" gr="S,inan,n,nom,norm,pl" sem="t:ment der:v r:abstr der:s0" sem