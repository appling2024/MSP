<p><se><w><ana lex="день" gr="S,inan,m,nom,norm,pl" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>Дни</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="день" gr="S,inan,ins,m,norm,pl" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>днями</w> <w><ana lex="следовать" gr="V,3p,act,indic,ipf,norm,pl,praes" sem="ca:noncaus t:move der:s" sem2="ca:noncaus t:move der:s"/>следуют</w> <w><ana lex="однообразный" gr="A,f,ins,norm,plen,sg" sem="der:comp r:rel t:like" sem2=""/>однообразной</w> <w><ana lex="череда" gr="S,f,inan,ins,norm,sg" sem="t:plant sc:plant r:concr pt:aggr" sem2="pt:set sc:x t:form r:concr r:abstr"/>чередой</w>.</se><se> <w><ana lex="холод" gr="S,inan,m,nom,norm,sg" sem="t:temper r:abstr t:weather" sem2="t:manif:emot r:abstr t:temper t:physiol t:manif:disease t:fam"/>Холод</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="снег" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2=""/>снег</w> <w><ana lex="являться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v ca:noncaus" sem2="der:v ca:noncaus"/>являются</w> <w><ana lex="неизбежно" gr="ADV,norm" sem="der:a" sem2=""/>неизбежно</w>.</se><se> <w><ana lex="убугунов" gr="S,anim,bastard,famn,m,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Убугунов</w> <w><ana lex="сообщить" gr="V,act,indic,m,norm,pf,praet,sg" sem="t:speech ca:noncaus d:pref" sem2="d:pref"/>сообщил</w> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w>слышно</w> <w><ana lex="о" gr="PR,norm" sem="" sem2=""/>о</w> <w><ana lex="скорый" gr="A,loc,m,norm,plen,sg" sem="t:speed:max r:qual" sem2="t:time r:rel r:qual"/>скором</w> <w><ana lex="приезд" gr="S,inan,loc,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2=""/>приезде</w> «<w><ana lex="ваш" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/>вашего</w> <w><ana lex="коллега" gr="S,anim,gen,norm