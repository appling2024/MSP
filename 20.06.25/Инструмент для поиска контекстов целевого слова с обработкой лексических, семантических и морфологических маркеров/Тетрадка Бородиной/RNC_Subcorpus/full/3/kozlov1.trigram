<p><se><w><ana lex="весь" gr="APRO,acc,inan,m,norm,sg" sem="r:spec" sem2=""/>Весь</w> <w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w>, <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="начало" gr="S,gen,inan,n,norm,sg" sem="pt:phase r:abstr pc:x pt:part pc:pc:x r:concr" sem2="t:asp r:abstr pt:part"/>начала</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="конец" gr="S,gen,inan,m,norm,sg" sem="pt:phase r:concr r:abstr pt:part pc:x" sem2="top:rope t:tool t:space t:be:disapp r:abstr ev:neg r:concr"/>конца</w>, <w><ana lex="гость" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr" sem2="t:hum der:shift r:concr"/>гости</w>, <w><ana lex="гость" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr" sem2="t:hum der:shift r:concr"/>гости</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="гость" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr" sem2="t:hum der:shift r:concr"/>гости</w>: <w><ana lex="сначала" gr="ADV,norm" sem="der:s t:time" sem2=""/>сначала</w> <w><ana lex="бурят" gr="S,anim,m,nom,norm,pl" sem="" sem2=""/>буряты</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="потом" gr="ADVPRO,norm" sem="t:time" sem2=""/>потом</w> <w><ana lex="русский" gr="S,anim,m,nom,norm,pl" sem="" sem2=""/>русские</w>.</se></p>
<p><se><w><ana lex="с" gr="PR,norm" sem="" sem2=""/>С</w> <w><ana lex="полночь" gr="S,dat,f,inan,norm,sg" sem="ev:posit r:abstr t:time" sem2="t:space r:concr r:abstr"/>полночи</w> <w><ana lex="появиться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus d:pref t:be:appear" sem2="ca:noncaus d:pref"/>появились</w> <w><ana lex="слоистый" gr="A,nom,norm,pl,plen" sem="t:physq d:habit der:s r:qual" sem2=""/>слоистые</w> <w><ana lex="облако" gr="S,inan,n,nom,norm,pl" sem="qc:stuff r:concr" sem2="qc:stuff pt:qtm top:form r:concr"/>облака</w>, <w><ana lex="подуть" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="d:pref" sem2="d:pref"/>подул</w> <w><ana lex="ветер" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>ветер</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w>ССЗ</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="температура" gr="S,f,inan,nom,norm,sg" sem="r:abstr t:param t:temper" sem2="t:physiol r:abstr t:temper"/>температура</w> <w><ana lex="понизиться" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="dt:size:min t:changest d:pref der:a ca:noncaus" sem2=""/>понизилась</w> <w><ana lex="почти" gr="ADV,norm" sem="" sem2=""/>почти</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> -<w><ana lex="20" gr="NUM,ciph"/>20</w>°<w><ana lex="r" gr="bastard" sem="" sem2=""/>R</w>.</se></p>
<p><se> <b/><w><b>6</b></w><b>/</b><w><ana lex="ii" gr="bastard" sem="" sem2=""/><b>II</b></w><b>, </b><w><ana lex="s" gr="bastard" sem="" sem2=""/><b>S</b></w><b/>. <w><ana lex="облачный" gr="A,acc,n,norm,plen,sg" sem="r:rel der:s" sem2="t:physq r:rel der:s"/>Облачное</w>, <w><ana lex="серый" gr="A,acc,n,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>серое</w>, <w><ana lex="холодный" gr="A,acc,n,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодное</w> <w><ana lex="утро" gr="S,acc,inan,n,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утро</w>.</se></p>
<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w>, <w><ana lex="как" gr="ADVPRO,norm" sem="r:rel t:manner" sem2=""/>как</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="вчера" gr="ADV,norm" sem="t:time" sem2=""/>вчера</w>, <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w>много</w> <w><ana lex="гость" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr" sem2="t:hum der:shift r:concr"/>гостей</w> -- <w><ana lex="исключительно" gr="PART,norm" sem="" sem2=""/>исключительно</w> <w><ana lex="монгол" gr="S,anim,m,nom,norm,pl" sem="" sem2=""/>монголы</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="бурят" gr="S,anim,m,nom,norm,pl" sem="" sem2=""/>буряты</w>, <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="больший" gr="A,f,loc,norm,plen,sg" sem="d:compar t:size:max der:a dt:size:max r:qual" sem2=""/>большей</w> <w><ana lex="часть" gr="S,f,inan,loc,norm,sg" sem="r:concr pc:x pt:part" sem2="pc:org r:abstr sc:part t:org pt:ind pt:aggr:aggrpl t:poss der:shift pc:x pt:part pc:text r:concr"/>части</w> <w><ana lex="приходить" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="ca:noncaus t:move d:pref" sem2=""/>приходили</w> <w><ana lex="больший" gr="A,ins,norm,pl,plen" sem="d:compar t:size:max der:a dt:size:max r:qual" sem2=""/><ana lex="большой" gr="A,ins,norm,pl,plen" sem="t:size:max r:qual" sem2="t:quant:max t:time:age t:degr:max r:qual"/>большими</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="меньший" gr="A,ins,norm,pl,plen" sem="r:qual" sem2="r:rel t:ord"/><ana lex="меньшой" gr="A,ins,norm,pl,plen" sem="r:rel t:ord" sem2=""/>меньшими</w> <w><ana lex="компания" gr="S,f,inan,ins,norm,pl" sem="t:group pt:set r:concr sc:hum" sem2="r:concr t:org"/>компаниями</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w>, <w><ana lex="редко" gr="ADV,norm" sem="t:freq dt:time der:a" sem2=""/>редко</w>, <w><ana lex="быть" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>были</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="одиночка" gr="S,acc,anim,norm,sg" sem="t:hum r:concr der:a" sem2="t:hum t:animal r:concr der:a"/>одиночку</w>.</se><se> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>Так</w>, <w>например</w>, <w><ana lex="знатный" gr="A,m,nom,norm,plen,sg" sem="der:v ev:posit dt:ment t:humq:char r:qual" sem2="ev:posit r:rel t:degr:max r:qual ev t:quality"/>знатный</w> <w><ana lex="чиновник" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr der:s" sem2="t:hum r:concr ev:neg"/>чиновник</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="соболий" gr="A,f,loc,norm,plen,sg" sem="r:poss der:s dt:animal" sem2=""/>собольей</w> <w><ana lex="шапка" gr="S,f,inan,loc,norm,sg" sem="top:cap t:tool:cloth r:concr" sem2="t:text qc:stuff qc:aggr:aggrpl t:form pt:qtm top:cap pt:part pc:text r:concr"/>шапке</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="перо" gr="S,inan,ins,n,norm,sg" sem="pt:qtm pc:animal r:concr qc:aggr:aggrpl" sem2="t:stuff sc:part pc:plant r:abstr pt:ind pt:aggr sc:partb t:tool:instr pt:part r:concr pc:animal"/>пером</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="гунский" gr="A,bastard,ins,m,plen,sg" sem="" sem2=""/><ana lex="гунский" gr="A,bastard,ins,m,plen,sg" sem="" sem2=""/><ana lex="гунский" gr="A,bastard,ins,m,plen,sg" sem="" sem2=""/><ana lex="гунский" gr="A,bastard,ins,m,plen,sg" sem="" sem2=""/>гунским</w> <w><ana lex="шарик" gr="S,inan,ins,m,norm,sg" sem="top:spher t:form r:concr der:s d:dim" sem2="t:ment t:space t:cell2 top:spher der:shift t:tool:instr der:s d:dim r:concr"/>шариком</w>.</se></p>
<p><se><w><ana lex="произойти" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="t:be:exist ca:noncaus der:v d:pref" sem2="t:be:exist ca:noncaus der:v d:pref"/>Произошла</w> <w><ana lex="смена" gr="S,f,inan,nom,norm,sg" sem="der:v r:abstr der:s0" sem2="pt:set der:v t:time:period r:abstr sc:tool:cloth t:group sc:hum r:concr"/>смена</w> <w><ana lex="повар" gr="S,anim,gen,m,norm,pl" sem="der:v t:hum r:concr t:prof" sem2=""/>поваров</w>: <w><ana lex="пахомов" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Пахомов</w> <w><ana lex="сдать" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus d:pref t:poss" sem2="der:v d:pref"/>сдал</w> (<w><ana lex="исправно" gr="ADV,norm" sem="ev:posit dt:quality der:a" sem2=""/>исправно</w>), <w><ana lex="симук" gr="S,bastard,gen,inan,m,pl" sem="" sem2=""/>Симуков</w> <w><ana lex="принять" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:noncaus d:pref t:poss" sem2="der:v d:pref"/>принял</w> (<w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="7" gr="NUM,ciph"/>7</w>/<w>III</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w>.<w>г</w>.</se>).</p>
<p><se><w><ana lex="визитер" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr d:nag der:s" sem2=""/>Визитеров</w> <w><ana lex="продолжать" gr="V,act,indic,ipf,n,norm,praet,sg,tran" sem="aux:phase d:pref der:a" sem2=""/>продолжало</w> <w><ana lex="прибывать" gr="V,act,inf,intr,ipf,norm" sem="der:v t:move d:impf d:pref" sem2=""/>прибывать</w> <w><ana lex="все" gr="ADV,norm" sem="" sem2=""/>все</w> <w>больше</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w>больше</w>.</se><se> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>С</w> <w><ana lex="компания" gr="S,f,inan,ins,norm,sg" sem="t:group pt:set r:concr sc:hum" sem2="r:concr t:org"/>компанией</w> <w><ana lex="свой" gr="APRO,gen,norm,pl" sem="r:poss" sem2="t:social r:poss"/>своих</w> <w><ana lex="собрат" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr der:s" sem2=""/>собратьев</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>был</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="убугунов" gr="S,anim,bastard,famn,m,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Убугунов</w>.</se><se> <w>Интересно</w>, <w><ana lex="между" gr="PR,norm" sem="" sem2=""/>между</w> <w><ana lex="прочее" gr="SPRO,ins,n,norm,sg" sem="" sem2=""/>прочим</w>, <w><ana lex="какой" gr="APRO,gen,n,norm,sg" sem="t:neg r:rel ev:neg" sem2=""/>какого</w> <w><ana lex="мнение" gr="S,gen,inan,n,norm,sg" sem="t:ment r:abstr" sem2=""/>мнения</w> <w><ana lex="держаться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v ca:noncaus" sem2="der:v ca:noncaus"/>держатся</w> <w><ana lex="многий" gr="APRO,nom,norm,pl" sem="" sem2=""/>многие</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="наш" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/>наших</w> <w><ana lex="знакомый" gr="S,anim,gen,m,norm,pl" sem="der:v t:hum r:concr der:subst" sem2=""/>знакомых</w>, <w><ana lex="причем" gr="CONJ,norm" sem="" sem2=""/>причем</w> <w><ana lex="один" gr="APRO,m,nom,norm,sg" sem="" sem2="r:indet"/>один</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="они" gr="SPRO,3p,gen,norm,pl" sem="r:pers" sem2=""/>них</w>, <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="свой" gr="APRO,dat,n,norm,sg" sem="r:poss" sem2="t:social r:poss"/>своему</w> <w><ana lex="положение" gr="S,dat,inan,n,norm,sg" sem="t:space r:abstr" sem2="t:ment pt:set t:text r:abstr t:loc:body t:loc r:concr sc:text"/>положению</w> <w><ana lex="стоить" gr="V,act,ipf,m,nom,norm,partcp,plen,praes,sg" sem="d:root" sem2="d:root"/><ana lex="стоять" gr="V,act,intr,ipf,m,nom,norm,partcp,plen,praes,sg" sem="t:loc:body ca:noncaus d:root" sem2="t:loc d:root ca:noncaus"/>стоящий</w> <w><ana lex="близко" gr="ADV,norm" sem="t:dist:min dt:dist:min der:a" sem2=""/>близко</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="оба" gr="NUM,dat,m,norm" sem="r:card:pauc" sem2=""/>обоим</w> <w><ana lex="лагерь" gr="S,dat,inan,m,norm,pl" sem="t:space r:concr" sem2="t:group pt:set t:space r:concr sc:hum"/>лагерям</w>, <w><ana lex="заверять" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="t:ment der:v d:pref" sem2=""/>заверял</w> <w><ana lex="мой" gr="APRO,acc,anim,norm,pl" sem="r:poss" sem2=""/>моих</w> <w><ana lex="друг" gr="S,acc,anim,m,norm,pl" sem="t:hum r:concr" sem2="t:hum r:concr"/>друзей</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="результат" gr="S,inan,m,nom,norm,sg" sem="r:abstr" sem2="r:abstr"/>результат</w> <w><ana lex="зимовка" gr="S,f,gen,inan,norm,sg" sem="der:v r:abstr der:s0" sem2="der:v t:space r:concr"/>зимовки</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="урга" gr="S,f,inan,loc,norm,sg" sem="r:propn t:topon" sem2=""/>Урге</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="отозвание" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr" sem2=""/>отозвание</w> <w><ana lex="три" gr="NUM,gen,norm" sem="r:card:pauc" sem2=""/>трех</w> <w><ana lex="достойный" gr="A,gen,norm,pl,plen" sem="ev r:qual" sem2="ev r:qual"/>достойных</w> <w>нужно</w> <w><ana lex="приписать" gr="V,act,inf,norm,pf" sem="der:v d:pref" sem2="der:v d:pref"/>приписать</w> <w><ana lex="исключительный" gr="A,dat,m,norm,plen,sg" sem="ev:neg r:qual" sem2="ev t:degr:max r:qual"/>исключительному</w> <w><ana lex="этот" gr="APRO,dat,m,norm,sg" sem="r:dem" sem2=""/>этому</w> <w><ana lex="человек" gr="S,anim,dat,m,norm,sg" sem="t:hum r:concr" sem2="t:hum ev:posit r:concr"/>человеку</w>.</se><se> <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>А</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="сей" gr="APRO,gen,norm,pl" sem="r:dem" sem2=""/>сих</w> <w><ana lex="пора" gr="S,f,gen,inan,norm,pl" sem="t:space r:abstr t:time pc:partb r:concr top:hole" sem2="t:space r:concr r:abstr t:time"/>пор</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="большинство" gr="S,inan,n,nom,norm,sg" sem="sc:x der:a sc:hum pt:aggr pc:x pt:part r:concr" sem2=""/>большинство</w> <w><ana lex="мой" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/>моих</w> <w><ana lex="спутник" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,gen,inan,m,norm,pl" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутников</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>были</w> <w><ana lex="совсем" gr="ADV,norm" sem="t:degr:max der:apro" sem2="t:degr:min der:apro"/>совсем</w> <w><ana lex="иной" gr="APRO,gen,n,norm,sg" sem="r:spec" sem2="r:spec"/>иного</w> <w><ana lex="мнение" gr="S,gen,inan,n,norm,sg" sem="t:ment r:abstr" sem2=""/>мнения</w>.</se><se> <w><ana lex="вот" gr="PART,norm" sem="" sem2="r:dem"/>Вот</w> <w><ana lex="тут" gr="ADVPRO,norm" sem="t:place r:dem" sem2=""/>тут</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="разобраться" gr="V,2p,act,imper,intr,norm,pf,sg" sem="ca:noncaus d:pref" sem2="t:ment ca:noncaus d:pref"/>разберись</w>!</se></p>
<p><se><w><ana lex="около" gr="PR,norm" sem="" sem2=""/>Около</w> <w><ana lex="три" gr="NUM,gen,norm" sem="r:card:pauc" sem2=""/>трех</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дня</w> <w><ana lex="вдруг" gr="ADV,norm" sem="" sem2=""/>вдруг</w> <w><ana lex="подкатить" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:noncaus ca:0 t:move d:pref"/>подкатил</w> <w><ana lex="автомобиль" gr="S,inan,m,nom,norm,sg" sem="t:tool:transp r:concr" sem2=""/>автомобиль</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="два" gr="NUM,ins,norm" sem="r:card:pauc" sem2=""/>двумя</w> <w><ana lex="нарядный" gr="A,ins,norm,pl,plen" sem="dt:tool r:rel der:s dt:tool:cloth" sem2="dt:tool r:rel der:s dt:tool:cloth"/>нарядными</w> <w><ana lex="княгиня" gr="S,anim,f,ins,norm,pl" sem="t:hum d:fem r:concr der:s" sem2=""/>княгинями</w>: <w><ana lex="один" gr="APRO,f,nom,norm,sg" sem="" sem2="r:indet"/>одна</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="они" gr="SPRO,3p,gen,norm,pl" sem="r:pers" sem2=""/>них</w> <w><ana lex="жена" gr="S,anim,f,nom,norm,sg" sem="" sem2="t:hum r:concr"/>жена</w> <w><ana lex="цецен" gr="S,bastard,inan,m,nom,sg" sem="" sem2=""/>Цецен-вана</w>, <w>кстати</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="симпатичный" gr="A,f,nom,norm,plen,sg" sem="ev:posit t:appearance der:s dt:hum r:qual" sem2=""/>симпатичная</w>.</se><se> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>И</w> <w><ana lex="весь" gr="APRO,nom,norm,pl" sem="r:spec" sem2=""/>все</w> <w><ana lex="они" gr="SPRO,3p,nom,norm,pl" sem="r:pers" sem2=""/>они</w>, <w><ana lex="монгол" gr="S,anim,m,nom,norm,pl" sem="" sem2=""/>монголы</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> 