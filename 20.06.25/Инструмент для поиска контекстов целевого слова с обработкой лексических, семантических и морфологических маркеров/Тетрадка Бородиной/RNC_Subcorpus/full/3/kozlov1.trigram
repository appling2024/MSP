<p><se><w><ana lex="теплый" gr="A,m,nom,norm,plen,sg" sem="dt:temper dt:abstr t:physq:temper der:s r:qual" sem2="ev:posit t:physq:color dt:temper t:physq:temper dt:abstr der:s r:qual r:rel"/>Теплый</w>, <w><ana lex="приятный" gr="A,m,nom,norm,plen,sg" sem="ev:posit r:qual" sem2="ev:posit t:humq r:qual"/>приятный</w> <w><ana lex="день" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w> <w><ana lex="я" gr="SPRO,1p,acc,norm,sg" sem="r:pers" sem2=""/>меня</w> <w><ana lex="всегда" gr="ADVPRO,norm" sem="r:spec t:time" sem2=""/>всегда</w> <w><ana lex="манить" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="d:root" sem2="d:root"/>манит</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="ясный" gr="A,dat,m,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясному</w> <w><ana lex="заветный" gr="A,dat,m,norm,plen,sg" sem="der:s:deverb dt:abstr r:rel dt:speech" sem2="der:s:deverb dt:abstr r:rel dt:speech"/>заветному</w> <w><ana lex="юг" gr="S,dat,inan,m,norm,sg" sem="t:space r:concr r:abstr t:dir" sem2="t:space r:concr pt:part pc:space"/>югу</w>, <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="смочь" gr="V,1p,act,fut,indic,intr,norm,pf,sg" sem="d:pref" sem2=""/>смогу</w> <w><ana lex="переносить" gr="V,act,inf,norm,pf" sem="ca:caus t:move d:pref" sem2="d:pref"/><ana lex="переносить" gr="V,act,inf,ipf,norm,tran" sem="ca:caus t:move d:pref" sem2="d:pref"/><ana lex="перенести" gr="V,act,inf,norm,pf,tran" sem="der:v ca:caus t:move d:pref" sem2="der:v d:pref"/><ana lex="переносить" gr="V,act,inf,ipf,norm,tran" sem="ca:caus t:move d:pref" sem2="d:pref"/><ana lex="переносить" gr="V,act,inf,norm,pf,tran" sem="ca:caus t:move d:pref" sem2="d:pref"/>переносить</w> <w><ana lex="долгий" gr="A,comp,norm,plen" sem="t:time:dur:max r:qual" sem2="t:size:max r:qual"/>дольше</w> <w><ana lex="разлука" gr="S,f,gen,inan,norm,sg" sem="der:v t: