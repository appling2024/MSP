<p><se><w><ana lex="такой" gr="APRO,ins,m,norm,sg" sem="r:dem" sem2="r:indet r:spec t:degr:max"/>Таким</w> <w><ana lex="образ" gr="S,inan,ins,m,norm,sg" sem="t:ment r:concr r:abstr t:workart" sem2="t:asp r:abstr"/>образом</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="1" gr="NUM,ciph"/>1</w>-<w>й</w> <w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w> <w><ana lex="ехать" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus t:move d:root" sem2="d:root"/>едут</w> <w><ana lex="друг" gr="S,anim,m,nom,norm,sg" sem="t:hum r:concr" sem2="t:hum r:concr"/>друг</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="друг" gr="S,anim,dat,m,norm,sg" sem="t:hum r:concr" sem2="t:hum r:concr"/>другу</w> <w><ana lex="наш" gr="APRO,nom,norm,pl" sem="r:poss" sem2=""/>наши</w> <w><ana lex="соотечественник" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr der:s" sem2=""/>соотечественники</w> -- <w><ana lex="бурят" gr="S,anim,m,nom,norm,pl" sem="" sem2=""/>буряты</w>.</se><se> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>И</w> <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>сегодня</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="дом" gr="S,inan,loc,m,norm,sg" sem="top:contain t:constr:build r:concr" sem2="sc:hum pt:set t:space t:org t:group der:shift r:concr"/>доме</w> <w><ana lex="цокто" gr="S,0,anim,bastard,m,sg" sem="t:hum r:propn t:persn" sem2=""/>Цокто</w> <w><ana lex="гармаевич" gr="S,anim,bastard,gen,m,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Гармаевича</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="иметь" gr="V,act,indic,ipf,m,norm,praet,sg,tran" sem="ca:noncaus d:root t:poss" sem2="d:root"/>имел</w> <w><ana lex="возможность" gr="S,acc,f,inan,norm,sg" sem="der:a r:abstr t:mod" sem2="r:abstr der:a"/>возможность</w> <w><ana lex="видеть" gr="V,act,inf,ipf,norm,tran" sem="ca:noncaus t:perc d:root" sem2="t:ment ca:noncaus d:root"/>видеть</w> <w>много</w> <w><ana lex="лицо" gr="S,gen,inan,n,norm,pl" sem="pt:partb r:concr pc:hum" sem2="pc:tool:cloth t:space r:concr r:abstr"/><ana lex="лицо" gr="S,anim,gen,n,norm,pl" sem="" sem2="t:hum r:concr hi:class"/>лиц</w> <w><ana lex="интересный" gr="A,gen,norm,pl,plen" sem="dt:abstr der:s dt:ment r:qual" sem2="dt:abstr ev:posit der:s dt:ment r:qual"/>интересных</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="неинтересный" gr="A,gen,norm,pl,plen" sem="dt:qual d:neg der:a t:qual r:qual" sem2=""/>неинтересных</w>.</se><se> <w><ana lex="один" gr="APRO,m,nom,norm,sg" sem="" sem2="r:indet"/>Один</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>был</w> <w><ana lex="бесконечно" gr="ADV,norm" sem="dt:time:dur t:degr:max der:a" sem2=""/>бесконечно</w> <w><ana lex="любезный" gr="A,brev,m,norm,sg" sem="ev:posit t:humq r:qual" sem2="t:hum ev:posit t:social:emot r:qual"/>любезен</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="внимательный" gr="A,brev,m,norm,sg" sem="t:humq r:qual" sem2="t:humq r:qual"/>внимателен</w> <w><ana lex="ко" gr="PR,norm" sem="" sem2=""/>ко</w> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w>, <w><ana lex="заметить" gr="V,act,ger,norm,pf,praet" sem="ca:noncaus d:pref t:perc" sem2="d:pref"/>заметив</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="мой" gr="APRO,acc,f,norm,sg" sem="r:poss" sem2=""/>мою</w> <w><ana lex="книга" gr="S,acc,f,inan,norm,sg" sem="t:media r:concr t:text" sem2="pc:text t:book r:concr t:text pt:part"/>книгу</w> <w><ana lex="он" gr="SPRO,3p,m,nom,norm,sg" sem="r:pers" sem2=""/>он</w> <w><ana lex="некогда" gr="ADVPRO,norm" sem="der:advpro r:indet t:time" sem2="der:advpro r:indet t:time"/>некогда</w> <w><ana lex="поступиться" gr="V,act,indic,intr,m,nor