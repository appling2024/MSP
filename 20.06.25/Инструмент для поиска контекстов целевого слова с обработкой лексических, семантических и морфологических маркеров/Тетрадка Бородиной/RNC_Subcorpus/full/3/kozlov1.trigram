<p><se><b/><w><b>10</b></w><b>/</b><w><ana lex="xii" gr="bastard" sem="" sem2=""/><b>XII</b></w><b>, </b><w><ana lex="r" gr="bastard" sem="" sem2=""/><b>R</b></w><b/>. <w><ana lex="после" gr="PR,norm" sem="" sem2=""/>После</w> <w><ana lex="тихий" gr="A,f,loc,norm,plen,sg" sem="d:neg t:sound r:qual" sem2="d:neg t:humq t:speed:min der:shift t:sound r:qual"/>тихой</w>, <w><ana lex="морозный" gr="A,f,loc,norm,plen,sg" sem="dt:temper dt:abstr t:physq:temper r:rel der:s" sem2=""/>морозной</w>, <w><ana lex="звездный" gr="A,f,loc,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space t:physq:form r:rel der:s"/>звездной</w> <w><ana lex="ночь" gr="S,f,inan,loc,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2=""/>ночи</w> <w><ana lex="наступить" gr="V,act,indic,intr,n,norm,pf,praet,sg" sem="der:v d:pref" sem2=""/>наступило</w> <w><ana lex="такой" gr="APRO,n,nom,norm,sg" sem="r:dem" sem2="r:indet r:spec t:degr:max"/>такое</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w> <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утро</w>.</se></p>
