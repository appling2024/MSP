<p><se><w><ana lex="на" gr="PR,norm" sem="" sem2=""/>На</w> <w><ana lex="обед" gr="S,inan,loc,m,norm,sg" sem="r:abstr" sem2="t:food sc:food r:abstr pt:aggr t:time r:concr"/>обеде</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w>П</w>. <w>С</w>. <w><ana lex="михно" gr="S,0,anim,bastard,famn" sem="t:hum r:propn t:famn" sem2=""/><ana lex="михно" gr="S,0,anim,bastard,persn" sem="t:hum r:propn t:famn" sem2=""/>Михно</w>: <w><ana lex="красный" gr="A,f,nom,norm,plen,sg" sem="t:physq:color r:qual" sem2="ev:posit dt:physq:color der:shift r:qual t:species r:rel"/>красная</w> <w><ana lex="роза" gr="S,f,inan,nom,norm,sg" sem="t:plant r:concr" sem2="r:concr t:workart"/><ana lex="роза" gr="S,anim,f,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>роза</w>, <w><ana lex="милый" gr="A,n,nom,norm,plen,sg" sem="t:humq r:qual" sem2="ev:posit t:social:emot r:qual"/>милое</w>, <w><ana lex="непринужденный" gr="A,n,nom,norm,plen,sg" sem="d:neg t:humq der:a r:qual" sem2=""/>непринужденное</w> <w><ana lex="гостеприимство" gr="S,inan,n,nom,norm,sg" sem="der:comp t:humq r:abstr" sem2=""/>гостеприимство</w>.</se><se> <w><ana lex="рассказ" gr="S,inan,m,nom,norm,pl" sem="der:v r:concr t:text" sem2="t:speech r:abstr"/>Рассказы</w>, <w><ana lex="пересказ" gr="S,inan,m,nom,norm,pl" sem="t:speech der:v r:abstr der:s0" sem2="t:speech r:abstr"/>пересказы</w>, <w><ana lex="впечатление" gr="S,inan,n,nom,norm,pl" sem="t:perc r:abstr" sem2="t:ment r:abstr"/>впечатления</w>.</se><se> <w><ana lex="музей" gr="S,inan,m,nom,norm,sg" sem="r:concr t:org" sem2=""/>Музей</w> -- <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="домой" gr="ADV,norm" sem="der:s t:dir" sem2=""/>домой</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="синицын" gr="S,anim,famn,ins,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Синицыным</w>.</se></p>
<p><se><w><ana lex="чтение" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr der:s0" sem2="der:v t:action r:concr t:text r:abstr"/>Чтение</w> <w><ana lex="лекция" gr="S,f,gen,inan,norm,sg" sem="t:action r:abstr" sem2="r:concr t:text"/>лекции</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="четверг" gr="S,acc,inan,m,norm,sg" sem="t:time:week r:abstr" sem2=""/>четверг</w>, <w><ana lex="23" gr="NUM,ciph"/>23</w>/<w>VIII</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="5" gr="NUM,ciph"/>5</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w> <w><ana lex="день" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дня</w>.</se><se> <w>Надо</w> <w><ana lex="обдумать" gr="V,act,inf,norm,pf" sem="t:ment ca:noncaus der:v d:pref" sem2=""/>обдумать</w>!</se></p>
