<p><se><b/><w><b>7</b></w><b>/</b><w><ana lex="iv" gr="bastard" sem="" sem2=""/><b>IV</b></w><b>, </b><w><ana lex="r" gr="bastard" sem="" sem2=""/><b>R</b></w><b/>. <w><ana lex="ночь" gr="S,f,inan,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2=""/>Ночь</w> <w><ana lex="великолепный" gr="A,f,nom,norm,plen,sg" sem="ev:posit t:quality r:qual" sem2="ev:posit t:appearance r:qual"/>великолепная</w>, <w><ana lex="тихий" gr="A,f,nom,norm,plen,sg" sem="d:neg t:sound r:qual" sem2="d:neg t:humq t:speed:min der:shift t:sound r:qual"/>тихая</w>, <w><ana lex="яркозвездный" gr="A,bastard,f,nom,plen,sg" sem="" sem2=""/>яркозвездная</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="довольно" gr="ADV,norm" sem="t:degr dt:humq der:a" sem2="ev:posit dt:humq der:a"/>довольно</w> <w><ana lex="теплый" gr="A,f,nom,norm,plen,sg" sem="dt:temper dt:abstr t:physq:temper der:s r:qual" sem2="ev:posit t:physq:color dt:temper t:physq:temper dt:abstr der:s r:qual r:rel"/>теплая</w>, <w><ana lex="лишь" gr="PART,norm" sem="" sem2=""/>лишь</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="восход" gr="S,inan,loc,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="r:abstr t:time"/>восходе</w> <w><ana lex="солнце" gr="S,gen,inan,n,norm,sg" sem="top:horiz top:spher t:astr t:space r:concr" sem2="ev:posit t:space r:concr r:abstr t:light"/>солнца</w> <w><ana lex="t" gr="bastard" sem="" sem2=""/>t</w> <w><ana lex="понизиться" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="dt:size:min t:changest d:pref der:a ca:noncaus" sem2=""/>понизилась</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> -<w><ana lex="4.0" gr="NUM,ciph"/>4.0</w>°<w><ana lex="r" gr="bastard" sem="" sem2=""/>R</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="потом" gr="ADVPRO,norm" sem="t:time" sem2=""/>потом</w> <w><ana lex="стать" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="aux:phase d:root t:move:body" sem2="ca:noncaus t:move d:root t:loc"/>стала</w> <w><ana lex="быстро" gr="ADV,norm" sem="dt:speed:max ev der:a" sem2="t:speed:max dt:speed:max ev der:a"/>быстро</w> <w><ana lex="повышаться" gr="V,act,inf,intr,ipf,norm" sem="der:v d:pref" sem2=""/>повышаться</w>.</se><se> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>За</w> <w><ana lex="вчерашний" gr="A,acc,inan,norm,pl,plen" sem="der:adv r:rel t:time" sem2="der:adv r:rel t:time"/>вчерашние</w>, <w><ana lex="минувший" gr="A,acc,inan,norm,pl,plen" sem="der:v r:rel dt:move t:time" sem2=""/>минувшие</w> <w><ana lex="сутки" gr="S,acc,inan,norm,pl" sem="t:unit t:time:period r:abstr" sem2=""/>сутки</w> <w>много</w> <w><ana lex="поубавиться" gr="V,act,indic,intr,n,norm,pf,praet,sg" sem="t:changest d:pref" sem2=""/>поубавилось</w> <w><ana lex="снег" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2=""/>снега</w>, <w><ana lex="южный" gr="A,nom,norm,pl,plen" sem="t:place dt:space r:rel der:s" sem2=""/>южные</w> <w><ana lex="склон" gr="S,inan,m,nom,norm,pl" sem="t:space top:slope der:v top:form pt:part pc:space r:concr" sem2=""/>склоны</w> <w><ana lex="почти" gr="ADV,norm" sem="" sem2=""/>почти</w> <w><ana lex="совершенно" gr="ADV,norm" sem="dt:degr:max t:degr:max der:a" sem2=""/>совершенно</w> <w><ana lex="оголить" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="d:pref" sem2="d:pref"/>оголены</w>, <w><ana lex="да" gr="CONJ,norm" sem="" sem2=""/>да</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="нижний" gr="A,m,nom,norm,plen,sg" sem="t:place r:qual" sem2="t:place t:species t:level r:rel r:qual"/>нижний</w> <w><ana lex="пояс" gr="S,inan,m,nom,norm,sg" sem="top:rope t:access r:concr pc:tool:cloth pt:part:addit pt:addit" sem2="qc:space top:rope t:space pc:hum pc:animal pt:part:addit top:ring der:shift sc:partb pt:part pt:qtm pt:partb pc:partb pc:space r:concr"/>пояс</w> <w><ana lex="богдо" gr="ADV,bastard" sem="" sem2=""/>Богдо-улы</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="значительный" gr="A,f,loc,norm,plen,sg" sem="t:quant:max der:v t:degr:max r:qual" sem2="der:v r:rel d:habit"/>значительной</w> <w><ana lex="мера" gr="S,f,inan,loc,norm,sg" sem="t:unit r:abstr pt:class" sem2="t:unit r:abstr"/><ana lex="меря" gr="S,f,inan,loc,norm,sg" sem="pt:aggr r:concr" sem2=""/>мере</w> <w><ana lex="попестреть" gr="V,act,bastard,indic,intr,ipf,m,praet,sg" sem="" sem2=""/><ana lex="попестреть" gr="V,act,bastard,indic,ipf,m,praet,sg" sem="" sem2=""/><ana lex="попестреть" gr="V,act,bastard,indic,intr,ipf,m,praet,sg" sem="" sem2=""/><ana lex="попестреть" gr="V,act,bastard,indic,ipf,m,praet,sg" sem="" sem2=""/><ana lex="попестреть" gr="V,act,bastard,indic,m,pf,praet,sg" sem="" sem2=""/><ana lex="попестреть" gr="V,act,bastard,indic,m,pf,praet,sg" sem="" sem2=""/><ana lex="попестреть" gr="V,act,bastard,indic,intr,m,pf,praet,sg" sem="" sem2=""/>попестрел</w>.</se></p>
<p><se><w><ana lex="с" gr="PR,norm" sem="" sem2=""/>С</w> <w>А</w>. <w>Н</w>. <w><ana lex="васильев" gr="S,anim,famn,ins,m,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Васильевым</w> <w><ana lex="произойти" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="t:be:exist ca:noncaus der:v d:pref" sem2="t:be:exist ca:noncaus der:v d:pref"/>произошла</w> <w><ana lex="маленький" gr="A,f,nom,norm,plen,sg" sem="t:size:min r:qual" sem2="t:time:age t:size:min r:qual"/>маленькая</w> <w><ana lex="неприятность" gr="S,f,inan,nom,norm,sg" sem="r:abstr der:a" sem2="der:a r:abstr ev:neg"/>неприятность</w> -- <w><ana lex="он" gr="SPRO,3p,m,nom,norm,sg" sem="r:pers" sem2=""/>он</w> <w><ana lex="упасть" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2=""/>упал</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="ледяной" gr="A,acc,f,norm,plen,sg" sem="dt:stuff r:rel der:s" sem2="t:degr:max:magn t:physq:temper r:qual dt:stuff der:shift der:s ev:neg r:rel"/>ледяную</w> <w><ana lex="скользкий" gr="A,acc,f,norm,plen,sg" sem="t:physq r:qual" sem2="der:shift t:humq ev ev:neg r:qual"/>скользкую</w> <w><ana lex="поверхность" gr="S,acc,f,inan,norm,sg" sem="top:surface t:space r:concr" sem2="r:abstr top:surface der:shift pt:part ev:neg pc:reservoir pc:space r:concr"/>поверхность</w>, <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="ружье" gr="S,acc,inan,n,norm,sg" sem="t:tool:weapon r:concr" sem2=""/>ружье</w>, <w><ana lex="причинить" gr="V,acc,act,n,norm,partcp,pf,plen,praet,sg" sem="d:pref" sem2=""/>причинившее</w> <w><ana lex="он" gr="SPRO,3p,dat,m,norm,sg" sem="r:pers" sem2=""/>ему</w> <w><ana lex="сильный" gr="A,acc,f,norm,plen,sg" sem="t:physq d:habit r:qual" sem2="ev:posit t:humq:char der:s t:degr:max r:qual r:rel"/>сильную</w>, <w><ana lex="тяжелый" gr="A,acc,f,norm,plen,sg" sem="t:physq:weight r:qual" sem2="t:humq der:metaph r:qual dt:physq:weight t:physq der:shift t:degr:max ev:neg r:rel"/>тяжелую</w> <w><ana lex="боль" gr="S,acc,