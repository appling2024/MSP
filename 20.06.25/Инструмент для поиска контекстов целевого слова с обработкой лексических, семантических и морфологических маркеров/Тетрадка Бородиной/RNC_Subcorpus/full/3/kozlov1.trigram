<p><se><w><ana lex="интересный" gr="A,acc,inan,norm,pl,plen" sem="dt:abstr der:s dt:ment r:qual" sem2="dt:abstr ev:posit der:s dt:ment r:qual"/>Интересные</w> <w><ana lex="сведение" gr="S,acc,inan,n,norm,pl" sem="t:ment r:abstr" sem2="t:speech t:ment r:abstr"/>сведения</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="повод" gr="S,dat,inan,m,norm,sg" sem="der:v top:rope t:tool r:concr r:abstr" sem2=""/><ana lex="повод" gr="S,dat,inan,m,norm,sg" sem="der:v top:rope t:tool r:concr r:abstr" sem2=""/>поводу</w> <w><ana lex="пролет" gr="S,gen,inan,m,norm,sg" sem="t:move der:s0 r:abstr der:v t:space r:concr" sem2="pc:constr t:space r:concr pt:part pc:space"/>пролета</w> <w><ana lex="плавать" gr="V,act,gen,intr,ipf,norm,partcp,pl,plen,praes" sem="der:v ca:noncaus t:move d:impf d:root" sem2="der:v d:root d:impf"/>плавающих</w> <w><ana lex="птица" gr="S,anim,f,gen,norm,pl" sem="t:animal r:concr hi:class" sem2=""/>птиц</w>.</se><se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="урга" gr="S,f,inan,loc,norm,sg" sem="r:propn t:topon" sem2=""/>Урге</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="долина" gr="S,f,inan,loc,norm,sg" sem="t:space r:concr der:s t:fam" sem2=""/>долине</w> <w><ana lex="тола" gr="S,f,gen,inan,norm,sg" sem="" sem2=""/>Толы</w>, <w><ana lex="вблизи" gr="PR,norm" sem="" sem2=""/>вблизи</w> <w><ana lex="самый" gr="APRO,f,gen,norm,sg" sem="r:spec" sem2="r:spec"/><ana lex="сам" gr="APRO,f,gen,norm,sg" sem="r:spec" sem2=""/>самой</w> <w><ana lex="электрический" gr="A,f,gen,norm,plen,sg" sem="r:rel der:s" sem2="r:rel"/>электрической</w> <w><ana lex="станция" gr="S,f,gen,inan,norm,sg" sem="pt:set sc:constr t:space r:concr top:horiz" sem2="t:constr pc:space r:concr r:abstr t:org"/>станции</w>, <w><ana lex="останавливаться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v d:pref d:impf" sem2=""/>останавливаются</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="отдых" gr="S,acc,inan,m,norm,sg" sem="r:abstr" sem2=""/>отдых</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="располагаться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v t:loc d:pref ca:noncaus" sem2=""/>располагаются</w> <w><ana lex="вдоль" gr="PR,norm" sem="" sem2=""/>вдоль</w> <w><ana lex="родниковый" gr="A,gen,norm,pl,plen" sem="dt:space r:rel der:s" sem2=""/>родниковых</w> <w><ana lex="вода" gr="S,f,gen,inan,norm,pl" sem="t:stuff r:concr t:liq" sem2="t:food dt:stuff t:stuff sc:reservoir t:liq sc:space r:abstr pt:aggr:aggrpl sc:qtm t:space pt:part ev:neg sc:spring pc:space r:concr der:shift"/>вод</w> <w><ana lex="дикий" gr="A,nom,norm,pl,plen" sem="r:rel" sem2="t:humq r:qual der:shift t:degr:max ev:neg r:rel"/>дикие</w> <w><ana lex="серый" gr="A,nom,norm,pl,plen" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>серые</w> <w><ana lex="гусь" gr="S,anim,m,nom,norm,pl" sem="t:animal r:concr" sem2=""/>гуси</w>.</se><se> <w><ana lex="птица" gr="S,anim,f,nom,norm,pl" sem="t:animal r:concr hi:class" sem2=""/>Птицы</w> <w><ana lex="отлично" gr="ADV,norm" sem="ev:posit dt:degr:max der:a" sem2=""/>отлично</w> <w><ana lex="знать" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="t:ment ca:noncaus d:root" sem2="t:ment ca:noncaus d:root"/>знают</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="здесь" gr="ADVPRO,norm" sem="t:place r:dem" sem2="t:time r:dem"/>здесь</w> <w><ana lex="они" gr="SPRO,acc,anim,norm,pl" sem="r:pers" sem2=""/>их</w> <w><ana lex="никто" gr="SPRO,anim,m,nom,norm,sg" sem="r:neg" sem2=""/>никто</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="стрелять" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="der:s" sem2="t:impact:destr ca:caus t:be:disapp t:poss ca:0 t:sound der:s ca:noncaus t:physiol"/>стреляет</w>.</se><se> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>На</w> <w><ana lex="мальчишка" gr="S,anim,gen,m,norm,pl" sem="t:hum ev r:concr der:s d:dim" sem2=""/>мальчишек</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w>, <w><ana lex="бросать" gr="V,acc,act,anim,ipf,norm,partcp,pl,plen,praes,tran" sem="d:root" sem2=""/>бросающих</w> <w><ana lex="камень" gr="S,acc,inan,m,norm,pl" sem="t:stone t:stuff r:concr" sem2="t:jewel r:concr"/>камни</w> (<w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="нередко" gr="ADV,norm" sem="t:freq der:a" sem2=""/>нередко</w> <w><ana lex="убивать" gr="V,act,gen,ipf,norm,partcp,pl,plen,praes,tran" sem="der:v ca:caus t:be:disapp t:impact d:pref d:impf" sem2=""/>убивающих</w> <w><ana lex="гусь" gr="S,anim,gen,m,norm,pl" sem="t:animal r:concr" sem2=""/>гусей</w>), <w><ana lex="птица" gr="S,anim,f,nom,norm,pl" sem="t:animal r:concr hi:class" sem2=""/>птицы</w> <w><ana lex="мало" gr="ADV,norm" sem="dt:size:min r:spec t:quant:min der:a" sem2=""/>мало</w> <w><ana lex="обращать" gr="V,3p,act,indic,ipf,norm,pl,praes,tran" sem="der:v d:pref" sem2=""/>обращают</w> <w><ana lex="внимание" gr="S,gen,inan,n,norm,sg" sem="t:ment r:abstr" sem2="r:abstr"/>внимания</w>.</se></p>
<p><se><w><ana lex="вечер" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечер</w> <w><ana lex="довольно" gr="ADV,norm" sem="t:degr dt:humq der:a" sem2="ev:posit dt:humq der:a"/>довольно</w> <w><ana lex="теплый" gr="A,m,nom,norm,plen,sg" sem="dt:temper dt:abstr t:physq:temper der:s r:qual" sem2="ev:posit t:physq:color dt:temper t:physq:temper dt:abstr der:s r:qual r:rel"/>теплый</w>, <w><ana lex="небо" gr="S,inan,n,nom,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/><ana lex="небо" gr="S,inan,n,nom,norm,sg" sem="t:space pc:hum top:surface pt:part pt:partb:inner r:concr" sem2="sc:hum:supernat pt:aggr t:space r:concr"/>небо</w> <w><ana lex="подернуть" gr="V,brev,n,norm,partcp,pass,pf,praet,sg" sem="d:pref" sem2=""/>подернуто</w> <w><ana lex="перистый" gr="A,ins,norm,pl,plen" sem="d:habit der:s r:qual" sem2="t:physq:form dt:partb der:s r:qual"/>перистыми</w> <w><ana lex="облако" gr="S,inan,ins,n,norm,pl" sem="qc:stuff r:concr" sem2="qc:stuff pt:qtm top:form r:concr"/>облаками</w>.</se></p>
<p><se><b/><w><b>16</b></w><b>/</b><w><ana lex="x" gr="bastard" sem="" sem2=""/><b>X</b></w><b>, </b><w><ana lex="u" gr="bastard" sem="" sem2=""/><b>U</b></w><b/>. <w><ana lex="ночь" gr="S,f,inan,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2=""/>Ночь</w> <w><ana lex="полуясный" gr="A,bastard,f,nom,plen,sg" sem="" sem2=""/>полуясная</w>, <w><ana lex="minimum" gr="bastard" sem="" sem2=""/>minimum</w> <w><ana lex="t" gr="bastard" sem="" sem2=""/>t</w>, <w>вероятно</w>, <w><ana lex="около" gr="PR,norm" sem="" sem2=""/>около</w> <w><ana lex="1.0" gr="NUM,ciph"/>1.0</w>°<w><ana lex="с" gr="PR,norm" sem="" sem2=""/>С</w>, <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="как" gr="ADVPRO,norm" sem="r:rel t:manner" sem2=""/>как</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="7" gr="NUM,ciph"/>7</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w> <w><ana lex="утро" gr="S,gen,inan,n,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утра</w> <w><ana lex="t" gr="bastard" sem="" sem2=""/>t</w> <w><ana lex="воздух" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>воздуха</w> -<w><ana lex="0,7" gr="NUM,ciph"/>0,7</w>°<w>С</w>. <w><ana lex="утро" gr="S,inan,ins,n,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Утром</w> <w><ana lex="тонко" gr="ADV,norm" sem="dt:size:min ev:posit der:a" sem2="dt:size:min ev der:a"/>тонко-перистые</w> <w><ana lex="облако" gr="S,inan,n,nom,norm,pl" sem="qc:stuff r:concr" sem2="qc:stuff pt:qtm top:form r:concr"/>облака</w> <w><ana lex="вскоре" gr="ADV,norm" sem="der:adv t:time" sem2=""/>вскоре</w> <w><ana lex="смениться" gr="V,act,indic,intr,norm,pf,pl,praet" sem="ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>сменились</w> <w><ana form="слоисто-кучевыми" lex="слоисто-кучевой" gr="A,ins,norm,pl,plen" sem="der:c