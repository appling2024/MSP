. <w>Н</w>. <w><ana lex="ринчина" gr="S,acc,bastard,inan,m,sg" sem="" sem2=""/>Ринчино</w>.</se><se> <w><ana lex="узко" gr="ADV,comp,norm" sem="dt:size:min der:a" sem2="dt:size:min der:a"/><ana lex="уже" gr="ADV,norm" sem="t:time" sem2=""/>Уже</w> <w><ana lex="довольно" gr="ADV,norm" sem="t:degr dt:humq der:a" sem2="ev:posit dt:humq der:a"/>довольно</w> <w><ana lex="поздно" gr="ADV,norm" sem="dt:time der:a t:time" sem2="dt:time ev:neg der:a t:time"/>поздно</w> <w><ana lex="весь" gr="APRO,f,nom,norm,sg" sem="r:spec" sem2=""/>вся</w> <w><ana lex="компания" gr="S,f,inan,nom,norm,sg" sem="t:group pt:set r:concr sc:hum" sem2="r:concr t:org"/>компания</w>, <w><ana lex="случайно" gr="ADV,PARENTH,norm" sem="der:a" sem2=""/>случайно</w> <w><ana lex="собраться" gr="V,act,f,intr,nom,norm,partcp,pf,plen,praet,sg" sem="ca:noncaus t:move d:pref" sem2="ca:noncaus d:pref t:psych:volit"/>собравшаяся</w> (<w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="наш" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/>наша</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="цокто" gr="S,0,anim,bastard,m,sg" sem="t:hum r:propn t:persn" sem2=""/>Цокто</w> <w><ana lex="гармаевич" gr="S,anim,bastard,m,nom,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Гармаевич</w>), <w><ana lex="прикатить" gr="V,act,bastard,f,indic,ipf,praet,sg,tran" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="прикатить" gr="V,act,bastard,f,indic,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="прикатить" gr="V,act,bastard,f,indic,pf,praet,sg,tran" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="прикатить" gr="V,act,bastard,f,indic,intr,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/>прикатила</w> <w><ana lex="домой" gr="ADV,norm" sem="der:s t:dir" sem2=""/>домой</w>.</se></p>
<p><se><b/><w><b>18</b></w><b>/</b><w><ana lex="iii" gr="bastard" sem="" sem2=""/><b>III</b></w><b>, </b><w><ana lex="u" gr="bastard" sem="" sem2=""/><b>U</b></w><b/>. <w><ana lex="минувший" gr="A,f,nom,norm,plen,sg" sem="der:v r:rel dt:move t:time" sem2=""/>Минувшая</w> <w><ana lex="ночь" gr="S,f,inan,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2=""/>ночь</w> <w><ana lex="прекрасный" gr="A,f,nom,norm,plen,sg" sem="ev:posit t:appearance r:qual" sem2="ev:posit t:quality r:qual"/>прекрасная</w>, <w><ana lex="ясный" gr="A,f,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>ясная</w>, <w><ana lex="тихий" gr="A,f,nom,norm,plen,sg" sem="d:neg t:sound r:qual" sem2="d:neg t:humq t:speed:min der:shift t:sound r:qual"/>тихая</w>, <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утро</w> <w><ana lex="также" gr="PART,norm" sem="" sem2=""/>также</w>.</se><se> <w><ana lex="невольно" gr="ADV,norm" sem="der:a" sem2=""/>Невольно</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="наблюдать" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="ca:noncaus d:pref t:perc" sem2="d:pref"/>наблюдаю</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="состояние" gr="S,inan,ins,n,norm,sg" sem="der:v r:abstr der:s0" sem2="sc:thing ev:posit t:psych r:abstr der:shift sc:money pt:aggr t:physiol r:concr"/>состоянием</w> <w><ana lex="гора" gr="S,f,gen,inan,norm,pl" sem="top:hill t:space r:concr" sem2="sc:x pt:set t:space t:form r:abstr t:quant:max r:concr"/>гор</w>, <w><ana lex="их" gr="APRO,norm" sem="r:poss" sem2=""/>их</w> <w><ana lex="южный" gr="A,gen,norm,pl,plen" sem="t:place dt:space r:rel der:s" sem2=""/>южных</w> <w><ana lex="скат" gr="S,gen,inan,m,norm,pl" sem="t:animal:fish der:v pc:constr pt:part pc:part pc:space r:concr" sem2="pc:tool:transp r:concr pt:part"/><ana lex="скат" gr="S,anim,gen,m,norm,pl" sem="" sem2=""/>скатов</w>.</se><se> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>С</w> <w><ana lex="каждый" gr="APRO,ins,m,norm,sg" sem="r:spec" sem2=""/>каждым</w> <w><ana lex="день" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>днем</w> <w><ana lex="они" gr="SPRO,3p,nom,norm,pl" sem="r:pers" sem2=""/>они</w> <w><ana lex="выглядеть" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v d:pref" sem2=""/><ana lex="выглядеть" gr="V,3p,act,fut,indic,norm,pf,pl,tran" sem="der:v d:pref" sem2=""/>выглядят</w> <w><ana lex="темный" gr="A,comp,norm,plen" sem="t:physq:color r:qual" sem2="t:humq t:physq:color ev:neg r:qual"/>темнее</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="темный" gr="A,comp,norm,plen" sem="t:physq:color r:qual" sem2="t:humq t:physq:color ev:neg r:qual"/>темнее</w>.</se><se> <w>Интересно</w>, <w><ana lex="как" gr="CONJ,norm" sem="" sem2=""/>как</w> <w><ana lex="быть" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>будет</w> <w><ana lex="проходить" gr="V,act,inf,ipf,norm,tran" sem="der:v ca:noncaus t:move d:pref" sem2=""/><ana lex="проходить" gr="V,act,inf,norm,pf,tran" sem="der:v ca:noncaus t:move d:pref" sem2=""/><ana lex="проходить" gr="V,act,inf,intr,ipf,norm" sem="der:v ca:noncaus t:move d:pref" sem2=""/><ana lex="проходить" gr="V,act,inf,intr,norm,pf" sem="der:v ca:noncaus t:move d:pref" sem2=""/><ana lex="пройти" gr="V,act,inf,intr,norm,pf" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/>проходить</w> <w><ana lex="весна" gr="S,f,inan,nom,norm,sg" sem="t:time:season r:abstr t:time" sem2=""/>весна</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="монголия" gr="S,f,inan,loc,norm,sg" sem="r:propn t:topon" sem2=""/>Монголии</w> <w><ana lex="именно" gr="PART,norm" sem="" sem2=""/>именно</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="этот" gr="APRO,loc,m,norm,sg" sem="r:dem" sem2=""/>этом</w> <w><ana lex="обильный" gr="A,loc,m,norm,plen,sg" sem="t:quant:max r:qual" sem2="t:quant:max r:qual"/>обильном</w> <w><ana lex="снег" gr="S,inan,ins,m,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2=""/>снегом</w> <w><ana lex="год" gr="S,inan,loc2,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:age r:abstr"/>году</w>?</se><se> <w>Действительно</w>, <w><ana lex="снег" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2=""/>снега</w> <w><ana lex="огромный" gr="A,n,nom,norm,plen,sg" sem="t:size:max r:qual" sem2="t:quant:max t:degr:max r:qual"/>огромное</w>, <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="монголия" gr="S,f,inan,loc,norm,sg" sem="r:propn t:topon" sem2=""/>Монголии</w> <w><ana lex="невероятный" gr="A,n,nom,norm,plen,sg" sem="dt:qual d:neg r:rel der:a" sem2="d:neg t:degr:max r:qual"/>невероятное</w> <w><ana lex="количество" gr="S,inan,n,nom,norm,sg" sem="t:quant r:abstr" sem2="r:abstr"/>количество</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="особенность" gr="S,f,inan,loc,norm,sg" sem="r:abstr der:a" sem2="r:abstr der:a"/>особенности</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="гора" gr="S,f,inan,loc,norm,pl" sem="top:hill t:space r:concr" sem2="sc:x pt:set t:space t:form r:abstr t:quant:max r:concr"/>горах</w>.</se><se> <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>Но</w> <w><ana lex="здесь" gr="ADVPRO,norm" sem="t:place r:dem" sem2="t:time r:dem"/>здесь</w> <w><ana lex="снег" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr r:abstr t:weather" sem2=""/>снег</w> <w><ana lex="испаряться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v d:pref" sem2=""/>испаряется</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="когда" gr="CONJ,norm" sem="" sem2=""/>когда</w> <w><ana lex="он" gr="SPRO,3p,acc,m,norm,sg" sem="r:pers" sem2=""/>его</w> <w><ana lex="немного" gr="ADV,norm" sem="t:degr:min ev der:adv" sem2="ev t:time:dur:min t:quant:min der:adv"/>немного</w> -- <w>трудно</w> <w><ana lex="заметить" gr="V,act,inf,norm,pf" sem="ca:noncaus d:pref t:perc" sem2="d:pref"/>заметить</w>, <w><ana lex="как" gr="ADVPRO,norm" sem="r:rel t:manner" sem2=""/>как</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="когда" gr="CONJ,norm" sem="" sem2=""/>когда</w> <w><ana lex="он" gr="SPRO,3p,gen,m,norm,sg" sem="r:pers" sem2=""/>его</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="стать" gr="V,act,indic,intr,n,norm,pf,praet,sg" sem="aux:phase d:root t:move:body" sem2="ca:noncaus t:move d:root t:loc"/>стало</w>.</se><se> <w>Теперь</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w> <w><ana lex="при" gr="PR,norm" sem="" sem2=""/>при</w> <w><ana lex="баснословный" gr="A,loc,n,norm,plen,sg" sem="der:comp r:rel" sem2="der:comp ev r:rel t:degr:max"/>баснословном</w> <w><ana lex="обилие" gr="S,inan,loc,n,norm,sg" sem="t:quant:max r:abstr" sem2="r:abstr"/>обилии</w> <w><ana lex="снеговой" gr="A,gen,m,norm,plen,sg" sem="r:rel der:s" sem2=""/>снегового</w> <w><ana lex="осадок" gr="S,gen,inan,m,norm,sg" sem="der:v t:stuff r:concr" sem2="r:abstr"/>осадка</w>, <w><ana lex="часто" gr="ADV,norm" sem="t:freq der:a" sem2=""/>часто</w> <w><ana lex="сбить" gr="V,acc,anim,m,norm,partcp,pass,pf,plen,praet,sg" sem="t:impact:creat ca:caus t:move d:pref" sem2="t:impact ca:caus d:pref"/>сбитого</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="сугроб" gr="S,acc,inan,m,norm,pl" sem="qc:stuff pt:qtm r:concr" sem2=""/>сугробы</w>, <w>вероятно</w>, <w><ana lex="произойти" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus der:v d:pref" sem2="t:be:exist ca:noncaus der:v d:pref"/>произойдет</w> <w><ana lex="то" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>то</w>, <w><ana lex="что" gr="SPRO,inan,n,nom,norm,sg" sem="r:rel" sem2=""/>что</w> <w><ana lex="весна" gr="S,f,inan,ins,norm,sg" sem="t:time:season r:abstr t:time" sem2=""/>весною</w> <w><ana lex="происходить" gr="V,3p,act,indic,intr,ipf,