w><ana lex="выделяться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v d:pref" sem2=""/>выделяются</w> <w><ana lex="площадь" gr="S,f,inan,nom,norm,pl" sem="t:space r:concr" sem2="t:space sc:room r:abstr t:room pt:aggr t:param r:concr"/>площади</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="поле" gr="S,inan,ins,n,norm,pl" sem="top:horiz t:space r:concr" sem2="t:plot t:space dt:space pc:workart pc:tool:cloth r:abstr top:surface der:shift top:stripe pt:part r:concr"/>полями</w> <w><ana lex="хлеб" gr="S,gen,inan,m,norm,sg" sem="t:food pt:aggr t:stuff r:concr sc:food" sem2="t:food sc:fruit sc:food t:plant r:abstr pt:aggr sc:plant r:concr"/>хлеба</w>.</se><se> <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers" sem2=""/>Мы</w> <w><ana lex="ехать" gr="V,act,indic,intr,ipf,norm,pl,praet" sem="ca:noncaus t:move d:root" sem2="d:root"/>ехали</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="серый" gr="A,acc,inan,m,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq dt:physq:color r:qual der:shift t:appearance dt:humq ev:neg"/>серый</w> <w><ana lex="день" gr="S,acc,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>день</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="то" gr="SPRO,inan,n,nom,norm,sg" sem="r:dem" sem2=""/>то</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="прекрасный" gr="A,brev,n,norm,sg" sem="ev:posit t:appearance r:qual" sem2="ev:posit t:quality r:qual"/>прекрасно</w>, <w><ana lex="мочь" gr="V,1p,act,indic,intr,ipf,norm,praes,sg" sem="d:root" sem2=""/>могу</w> <w><ana lex="представить" gr="V,act,inf,norm,pf" sem="d:pref" sem2="d:pref"/>представить</w> <w><ana lex="себе" gr="SPRO,dat,norm" sem="" sem2=""/>себе</w> <w><ana lex="этот" gr="APRO,acc,f,norm,sg" sem="r:dem" sem2=""/>эту</w> <w><ana lex="местность" gr="S,acc,f,inan,norm,sg" sem="t:spac