<p><se><b/><w><b>29</b></w><b>/</b><w><ana lex="xi" gr="bastard" sem="" sem2=""/><b>XI</b></w><b>, </b><w><ana lex="v" gr="bastard" sem="" sem2=""/><b>V</b></w><b/>. <w>Ясно</w>, <w>светло</w>, <w><ana lex="мороз" gr="S,anim,famn,m,nom,norm,sg" sem="" sem2=""/><ana lex="мороз" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:temper" sem2="t:fam r:abstr t:weather"/>мороз</w> -<w><ana lex="37,5" gr="NUM,ciph"/>37,5</w>°<w>С</w>. <w><ana lex="вот" gr="PART,norm" sem="" sem2="r:dem"/>Вот</w> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="здорово" gr="ADV,norm" sem="der:a" sem2="ev:posit t:degr:max"/>здорово</w>!</se><se> <w><ana lex="еще" gr="ADV,norm" sem="" sem2=""/>Еще</w> <w><ana lex="задолго" gr="ADV,norm" sem="der:adv t:time" sem2=""/>задолго</w> <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="рассвет" gr="S,gen,inan,m,norm,sg" sem="r:abstr t:time" sem2="ev:posit pt:phase r:abstr"/>рассвета</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="просыпаться" gr="V,1p,act,indic,intr,ipf,norm,praes,sg" sem="t:physiol ca:noncaus t:move d:pref" sem2=""/>просыпаюсь</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="мечтать" gr="V,1p,act,indic,intr,ipf,norm,praes,sg" sem="t:ment ca:noncaus d:root" sem2=""/>мечтаю</w>, <w><ana lex="мечтать" gr="V,1p,act,indic,intr,ipf,norm,praes,sg" sem="t:ment ca:noncaus d:root" sem2=""/>мечтаю</w>.</se><se> <w><ana lex="луна" gr="S,f,inan,nom,norm,sg" sem="top:horiz top:spher t:astr t:space r:concr" sem2="t:space r:concr t:astr top:spher top:horiz pt:addit"/>Луна</w> <w><ana lex="узко" gr="ADV,comp,norm" sem="dt:size:min der:a" sem2="dt:size:min der:a"/><ana lex="уже" gr="ADV,norm" sem="t:time" sem2=""/>уже</w> <w><ana lex="давно" gr="ADV,norm" sem="t:time" sem2=""/>давно</w> <w><ana lex="скрыться" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="ca:noncaus d:pref" sem2="ca:noncaus t:move d:pref"/>скрылась</w> <w><a