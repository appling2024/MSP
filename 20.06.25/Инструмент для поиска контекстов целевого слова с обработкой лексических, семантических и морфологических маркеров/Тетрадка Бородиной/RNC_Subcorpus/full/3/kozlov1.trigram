<se> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="заключение" gr="S,acc,inan,n,norm,sg" sem="t:put der:v r:abstr der:s0" sem2="t:text t:ment:result t:put pt:phase r:abstr der:v pc:workmus pt:part pc:text r:concr"/>заключение</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>очень</w> <w><ana lex="мило" gr="ADV,norm" sem="ev:posit dt:humq der:a" sem2="ev:posit dt:humq der:a"/>мило</w> <w><ana lex="предложить" gr="V,act,indic,m,norm,pf,praet,sg" sem="t:speech ca:noncaus d:pref" sem2="t:speech ca:noncaus d:pref"/>предложил</w> <w><ana lex="свой" gr="APRO,acc,inan,norm,pl" sem="r:poss" sem2="t:social r:poss"/>свои</w> <w><ana lex="услуга" gr="S,acc,f,inan,norm,pl" sem="r:abstr t:inter" sem2="pt:aggr r:abstr"/>услуги</w> <w><ana lex="вообще" gr="ADV,PARENTH,norm" sem="dt:general der:a" sem2=""/>вообще</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="оказание" gr="S,dat,inan,n,norm,sg" sem="der:v r:abstr" sem2=""/>оказанию</w> <w><ana lex="исполнение" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr" sem2=""/>исполнения</w> <w><ana lex="поручение" gr="S,gen,inan,n,norm,pl" sem="der:v r:abstr der:s0" sem2="r:abstr"/>поручений</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="область" gr="S,f,inan,loc,norm,sg" sem="t:space r:concr pt:part pc:space" sem2="t:space r:concr r:abstr pt:part pc:space"/>области</w> <w><ana lex="пополнение" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0" sem2="t:group pt:set der:v r:concr sc:hum"/>пополнения</w> <w><ana lex="снаряжение" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0 t:poss" sem2="der:v t:tool r:concr pt:aggr sc:tool"/>снаряжения</w> <w><ana lex="экспедиция" gr="S,f,gen,inan,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="pt:set t:move t:action t:org r:abstr t:group sc:hum r:concr"/>экспедиции</w>.</se><se> <w><ana lex="николай" gr="S,anim,m,nom,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Николай</w> <w><ana lex="иванович" gr="S,anim,m,nom,norm,patrn,sg" sem="t:hum t:patrn r:propn der:s" sem2=""/>Иванович</w> <w><ana lex="пописывать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="der:v d:pref" sem2=""/>пописывает</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="английский" gr="A,loc,norm,pl,plen" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>английских-американских</w> <w><ana lex="журнал" gr="S,inan,loc,m,norm,pl" sem="t:media r:concr t:text" sem2="t:book r:concr"/>журналах</w>, <w><ana lex="давать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="der:v ca:caus d:impf t:poss d:root" sem2="der:v d:root d:impf"/>дает</w> <w><ana lex="они" gr="SPRO,3p,dat,norm,pl" sem="r:pers" sem2=""/>им</w> <w><ana lex="известный" gr="A,acc,inan,norm,pl,plen" sem="r:rel" sem2="ev r:rel"/>известные</w> <w><ana lex="любопытный" gr="A,acc,inan,norm,pl,plen" sem="t:humq r:qual" sem2="r:qual"/>любопытные</w> <w><ana lex="сведение" gr="S,acc,inan,n,norm,pl" sem="t:ment r:abstr" sem2="t:speech t:ment r:abstr"/>сведения</w>.</se></p>
<p><se><w><ana lex="с" gr="PR,norm" sem="" sem2=""/>С</w> <w><ana lex="вечер" gr="S,gen,inan,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>вечера</w> <w><ana lex="пшевочка" gr="S,anim,bastard,f,nom,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/><ana lex="пшевочка" gr="S,anim,bastard,f,nom,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/><ana lex="пшевочка" gr="S,bastard,f,inan,nom,sg" sem="" sem2=""/>Пшевочка</w> <w><ana lex="уйти" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/>ушла</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="юрта" gr="S,acc,f,inan,norm,sg" sem="top:contain t:constr r:concr" sem2=""/>юрту</w> <w><ana lex="ночевать" gr="V,act,inf,intr,ipf,norm" sem="der:s" sem2=""/>ночевать</w>: <w><ana lex="она" gr="SPRO,3p,f,nom,norm,sg" sem="r:pers" sem2=""/>она</w> <w><ana lex="ночной" gr="A,f,nom,norm,plen,sg" sem="dt:abstr dt:time r:rel der:s t:time" sem2=""/>ночная</w> <w><ana lex="дежурная" gr="S,anim,f,nom,norm,sg" sem="t:hum d:fem r:concr der:a der:subst" sem2=""/>дежурная</w>.</se></p>
<p><se><b/><w><b>11</b></w><b>/</b><w><ana lex="xii" gr="bastard" sem="" sem2=""/><b>XII</b></w><b>, </b><w><ana lex="u" gr="bastard" sem="" sem2=""/><b>U</b></w><b/>. <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>В</w> <w><ana lex="8" gr="NUM,ciph"/>8</w> <w><ana lex="час" gr="S,gen,inan,m,norm,pl" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:moment r:abstr"/>часов</w> <w><ana lex="прийти" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/><ana lex="придти" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="" sem2=""/>пришла</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="дежурство" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr" sem2=""/>дежурства</w> <w><ana lex="мой" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/>моя</w> <w><ana lex="пшевочка" gr="S,anim,bastard,f,nom,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/><ana lex="пшевочка" gr="S,anim,bastard,f,nom,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/><ana lex="пшевочка" gr="S,bastard,f,inan,nom,sg" sem="" sem2=""/>Пшевочка</w>, <w><ana lex="говорить" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="t:speech ca:noncaus d:root" sem2="d:root"/>говорит</w>: «<w><ana lex="очень" gr="ADV,norm" sem="t:degr:max" sem2=""/>Очень</w> <w><ana lex="хотеть" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="ca:noncaus t:psych:volit d:root" sem2="d:root"/>хочу</w> <w><ana lex="есть" gr="V,act,inf,ipf,norm,tran" sem="ca:caus t:physiol d:root" sem2="t:be:exist ca:noncaus d:root"/>есть</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="пить" gr="V,act,inf,ipf,norm,tran" sem="ca:caus t:physiol d:root" sem2="d:root"/>пить</w> <w><ana lex="чай" gr="S,acc,inan,m,norm,sg" sem="t:plant:bush r:concr" sem2="t:food t:stuff r:abstr sc:plant t:liq pt:aggr t:plant:bush r:concr"/>чай</w>!</se><se>». <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>А</w> <w><ana lex="удовлетворить" gr="V,act,ger,norm,pf,praet" sem="d:pref" sem2="d:pref"/>удовлетворив</w> <w><ana lex="себе" gr="SPRO,acc,norm" sem="" sem2=""/>себя</w> <w><ana lex="первое" gr="S,inan,ins,n,norm,pl" sem="t:food der:subst der:anum t:stuff sc:food t:liq pt:aggr pc:food r:concr" sem2=""/>первыми</w>, <w><ana lex="захотеть" gr="V,act,f,indic,norm,pf,praet,sg,tran" sem="d:pref" sem2=""/>захотела</w> <w><ana lex="спать" gr="V,act,inf,intr,ipf,norm" sem="d:root" sem2="d:root"/>спать</w>!</se><se> <w><ana lex="вполне" gr="ADV,norm" sem="dt:full t:degr:max der:a" sem2=""/>Вполне</w> <w><ana lex="естественный" gr="A,brev,n,norm,sg" sem="" sem2=""/>естественно</w>!</se> </p>
<p><se><w><ana lex="прежний" gr="A,f,nom,norm,plen,sg" sem="r:rel t:time" sem2="r:rel t:time"/>Прежняя</w> <w><ana lex="монотонный" gr="A,f,nom,norm,plen,sg" sem="der:comp ev:neg t:sound r:qual" sem2=""/>монотонная</w> <w><ana lex="картина" gr="S,anim,f,famn,nom,norm,sg" sem="" sem2=""/><ana lex="картина" gr="S,f,inan,nom,norm,sg" sem="r:concr t:workart" sem2="pc:workdram t:text r:abstr t:workart t:perc pt:part t:workcin r:concr"/>картина</w> <w><ana lex="монгольский" gr="A,f,gen,norm,plen,sg" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>монгольской</w> <w><ana lex="зимний" gr="A,f,gen,norm,plen,sg" sem="dt:time dt:abstr dt:time:season der:s t:time r:rel" sem2=""/>зимней</w> <w><ana lex="природа" gr="S,f,gen,inan,norm,sg" sem="pt:aggr t:space r:concr sc:space" sem2="pt:aggr t:space r:concr r:abstr sc:space"/>природы</w>: <w>серо</w>, <w>бело</w>, <w><ana lex="однообразно" gr="ADV,norm" sem="dt:like der:a" sem2=""/>однообразно</w>.</se><se> <w><ana lex="перед" gr="PR,norm" sem="" sem2=""/>Перед</w> <w><ana lex="дом" gr="S,inan,ins,m,norm,sg" sem="top:contain t:constr:build r:concr" sem2="sc:hum pt:set t:space t:org t:group der:shift r:concr"/>домом</w> <w><ana lex="наш" gr="APRO,ins,m,norm,sg" sem="r:poss" sem2=""/>нашим</w> <w><ana lex="тянуться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v t:changest ca:noncaus" sem2="der:v ca:noncaus t:move"/>тянутся</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="долина" gr="S,acc,anim,f,famn,norm,sg" sem="" sem2=""/><ana lex="долина" gr="S,acc,f,inan,norm,sg" sem="t:space r:concr der:s t:fam" sem2=""/>долину</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="долина" gr="S,f,gen,inan,norm,sg" sem="t:space r:concr der:s t:fam" sem2=""/>долины</w> <w><ana lex="тола" gr="S,f,gen,inan,norm,sg" sem="" sem2=""/>Толы</w> <w><ana lex="вереница" gr="S,f,gen,inan,norm,sg" sem="pt:set sc:x r:concr" sem2=""/>вереницы</w> <w><ana lex="караван" gr="S,gen,inan,m,norm,pl" sem="pt:set r:concr sc:animal" sem2="pt:set sc:tool:transp sc:stuff r:concr sc:aggr"/>караванов</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="предмет" gr="S,inan,ins,m,norm,pl" sem="t:thing r:concr" sem2="t:ment t:thing r:concr r:abstr"/>предметами</w> <w><ana lex="торговый" gr="A,gen,m,norm,plen,sg" sem="dt:poss dt:abstr r:rel der:s" sem2="der:v dt:poss r:rel"/>торгового</w> <w><ana lex="обмен" gr="S,gen,inan,m,norm,sg" sem="der:v r:abstr der:s0 t:poss" sem2="der:v r:abstr t:inter"/>обмена</w> <w><ana lex="монголия" gr="S,f,gen,inan,norm,sg" sem="r:propn t:topon" sem2=""/>Монголии</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="китай" gr="S,inan,ins,m,norm,sg" sem="r:propn t:topon" sem2=""/>Китаем</w>.</se><se> <w><ana lex="тут" gr="ADVPRO,norm" sem="t:place r:dem" sem2=""/>Тут</w> <w><ana lex="же" gr="PART,norm" sem="" sem2=""/>же</w>, <w><ana lex="между" gr="PR,norm" sem="" sem2=""/>между</w> <w><ana lex="калган" gr="S,inan,ins,m,norm,sg" sem="t:plant r:concr" sem2=""/>Калганом</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="урга" gr="S,f,inan,ins,norm,sg" sem="r:propn t:topon" sem2=""/>Ургой</w>, <w><ana lex="поддерживаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:v d:pref d:impf" sem2=""/>поддерживается</w> <w><ana lex="постоянный" gr="A,n,nom,norm,plen,sg" sem="r:rel t:time" sem2="t:time:dur t:humq r:rel r:qual"/>постоянное</w> <w><ana lex="автомобильный" gr="A,n,nom,norm,plen,sg" sem="r:rel der:s dt:tool:transp dt:tool" sem2=""/>автомобильное</w> <w><ana lex="сообщение" gr="S,inan,n,nom,norm,sg" sem="t:speech der:v r:abstr der:s0" sem2="r:abstr"/>сообщение</w>.</se><se> <w><ana lex="случаться" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="" sem2=""/>Случается</w>, <w>конечно</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="автомобиль" gr="S,inan,m,nom,norm,pl" sem="t:tool:transp r:concr" sem2=""/>автомобили</w> <w><ana lex="портиться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="ca:noncaus" sem2=""/>портятся</w>, <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="тогда" gr="ADVPRO,norm" sem="t:time r:dem" sem2="r:dem"/>тогда</w> <w><ana lex="пассажир" gr="S,anim,dat,m,norm,pl" sem="t:hum r:concr" sem2=""/>пассажирам</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="особенно" gr="ADV,norm" sem="t:degr:max der:a" sem2="der:aprt der:a"/>особенно</w> <w><ana lex="сладкий" gr="A,brev,n,norm,sg" sem="t:physq:taste r:qual" sem2="ev:posit ev:neg der:shift t:humq r:qual"/>сладко</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="приятный" gr="A,brev,n,norm,sg" sem="ev:posit r:qual" sem2="ev:posit t:humq r:qual"/>приятно</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="особенность" gr="S,f,inan,loc,norm,sg" sem="r:abstr der:a" sem2="r:abstr der:a"/>особенности</w> <w><ana lex="где" gr="ADVPRO,norm" sem="t:place r:rel" sem2="t:place r:indet"/><ana form="где-либо" lex="где-либо" gr="ADVPRO,norm" sem="t:place r:indet der:advpro" sem2=""/>где-либо</w> <w><ana lex="вдали" gr="ADV,norm" sem="dt:dist:max t:dist:max der:s" sem2=""/>вдали</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="станция" gr="S,f,gen,inan,norm,pl" sem="pt:set sc:constr t:space r:concr top:horiz" sem2="t:constr pc:space r:concr r:abstr t:org"/>станций</w>.</se><se> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>И</w> <w><ana lex="этот" gr="APRO,n,nom,norm,sg" sem="r:dem" sem2=""/>это</w> <w><ana lex="явление" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr der:s0" sem2="pc:workdram t:text r:abstr der:v t:manif pt:part r:concr"/>явление</w> <w><ana lex="много" gr="ADV,comp,norm" sem="t:quant:max r:spec" sem2="t:degr:max"/><ana lex="более" gr="ADV,norm" sem="t:degr:max der:adv" sem2="t:degr:max"/>более</w> <w><ana lex="или" gr="CONJ,norm" sem="" sem2=""/>или</w> <w><ana lex="менее" gr="ADV,norm" sem="t:degr:min der:adv" sem2="t:degr:min der:adv"/>менее</w> <w><ana lex="обычно" gr="ADV,norm" sem="der:a t:time" sem2="der:a"/>обычно</w> <w><ana lex="зима" gr="S,f,inan,ins,norm,sg" sem="t:time:season r:abstr t:time" sem2="t:fam"/>зимой</w>.</se><se> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>По</w> <w><ana lex="слово" gr="S,dat,inan,n,norm,pl" sem="t:word r:concr r:abstr" sem2="pt:aggr:aggrpl t:text sc:word r:abstr t:speech r:concr"/>словам</w> <w>А</w>. <w>А</w>. <w><ana lex="дудукалов" gr="S,anim,bastard,famn,gen,m,sg" sem="t:hum r:propn t:famn" sem2=""/>Дудукалова</w>, <w><ana lex="пережить" gr="V,act,gen,m,norm,partcp,pf,plen,praet,sg" sem="t:be:exist ca:noncaus der:v d:pref" sem2="der:v t:be:exist d:pref ca:noncaus"/>пережившего</w> <w><ana lex="такой" gr="APRO,acc,f,norm,sg" sem="r:dem" sem2="r:indet r:spec t:degr:max"/>такую</w> <w><ana lex="авария" gr="S,acc,f,inan,norm,sg" sem="r:abstr" sem2=""/>аварию</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="монгольский" gr="A,f,gen,norm,plen,sg" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>монгольской</w> <w><ana lex="степь" gr="S,f,gen,inan,norm,sg" sem="pt:set t:space r:concr sc:plant" sem2=""/>степи</w>, <w><ana lex="положение" gr="S,inan,n,nom,norm,sg" sem="t:space r:abstr" sem2="t:ment pt:set t:text r:abstr t:loc:body t:loc r:concr sc:text"/>положение</w> <w><ana lex="пассажир" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr" sem2=""/>пассажиров</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="такой" gr="APRO,loc,m,norm,sg" sem="r:dem" sem2="r:indet r:spec t:degr:max"/>таком</w> <w><ana lex="случай" gr="S,inan,loc,m,norm,sg" sem="pt:qtm r:abstr" sem2="t:time:moment r:abstr"/>случае</w> <w><ana lex="мочь" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="d:root" sem2=""/>может</w> <w><ana lex="быть" gr="V,act,inf,intr,ipf,norm" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>быть</w> <w><ana lex="близкий" gr="A,ins,m,norm,plen,sg" sem="t:dist:min r:qual" sem2="t:social:emot r:qual der:shift t:like t:time t:social"/>близким</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="катастрофический" gr="A,dat,m,norm,plen,sg" sem="ev:neg der:s t:degr:max r:qual" sem2=""/>катастрофическому</w>!</se></p>
<p><se><w><ana lex="мой" gr="APRO,m,nom,norm,sg" sem="r:poss" sem2=""/>Мой</w> <w><ana lex="кондратьев" gr="S,anim,famn,m,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Кондратьев</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="последний" gr="A,acc,inan,norm,pl,plen" sem="r:rel t:ord" sem2="t:degr:max:magn r:qual r:rel ev:neg t:time"/>последние</w> <w><ana lex="день" gr="S,acc,inan,m,norm,pl" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>дни</w> <w><ana lex="занять" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="ca:noncaus d:pref t:poss" sem2="d:pref"/>занят</w> <w><ana lex="усердно" gr="ADV,norm" sem="ev:posit dt:humq der:a" sem2=""/>усердно</w> <w><ana lex="переговоры" gr="S,inan,ins,norm,pl" sem="t:speech t:action r:abstr" sem2="t:speech r:abstr"/>переговорами</w> <w><ana lex="относительно" gr="PR,norm" sem="" sem2=""/>относительно</w> <w><ana lex="продажа" gr="S,acc,f,inan,norm,pl" sem="der:v r:abstr der:s0 t:poss" sem2="r:abstr t:poss"/>продажи</w> <w><ana lex="верблюд" gr="S,anim,gen,m,norm,pl" sem="t:animal r:concr" sem2=""/>верблюдов</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="то" gr="SPRO,inan,ins,n,norm,sg" sem="r:dem" sem2=""/>тем</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="менее" gr="ADV,norm" sem="t:degr:min der:adv" sem2="t:degr:min der:adv"/>менее</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="забывать" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="t:ment der:v d:pref d:impf" sem2=""/>забывает</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="свой" gr="APRO,gen,norm,pl" sem="r:poss" sem2="t:social r:poss"/>своих</w> <w><ana lex="основной" gr="A,gen,norm,pl,plen" sem="t:hier r:rel" sem2=""/><ana lex="основный" gr="A,gen,norm,pl,plen" sem="r:rel der:s" sem2=""/>основных</w> <w><ana lex="занятие" gr="S,gen,inan,n,norm,pl" sem="der:v r:abstr der:s0 t:poss" sem2="pt:qtm r:abstr"/>занятий</w> -- <w><ana lex="добыча" gr="S,f,gen,inan,norm,sg" sem="der:v r:abstr der:s0 t:poss" sem2="sc:thing r:abstr pt:ind der:v t:poss pt:aggr r:concr"/>добычи</w> <w><ana lex="материал" gr="S,gen,inan,m,norm,pl" sem="t:stuff r:concr" sem2="t:stuff t:text hi:class r:abstr sc:doc r:concr"/>материалов</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="область" gr="S,f,inan,loc,norm,sg" sem="t:space r:concr pt:part pc:space" sem2="t:space r:concr r:abstr pt:part pc:space"/>области</w> <w><ana lex="монгольский" gr="A,gen,m,norm,plen,sg" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>монгольского</w> <w><ana lex="поэтическо" gr="S,0,anim,bastard,m,persn" sem="" sem2=""/>поэтическо-духовного</w> <w><ana lex="творчество" gr="S,gen,inan,n,norm,sg" sem="t:ment r:abstr t:be:appear" sem2=""/>творчества</w>.</se></p>
<p><se><w><ana lex="мой" gr="APRO,f,nom,norm,sg" sem="r:poss" sem2=""/>Моя</w> <w><ana lex="пшевочка" gr="S,anim,bastard,f,nom,persn,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/><ana lex="пшевочка" gr="S,anim,bastard,f,nom,sg" sem="d:dimb t:hum r:propn t:persn" sem2=""/><ana lex="пшевочка" gr="S,bastard,f,inan,nom,sg" sem="" sem2=""/>Пшевочка</w> <w><ana lex="работать" gr="V,3p,act,indic,intr,ipf,norm,praes,sg" sem="der:s" sem2="der:s"/>работает</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="изучение" gr="S,dat,inan,n,norm,sg" sem="t:ment der:v r:abstr" sem2=""/>изучению</w> <w><ana lex="тибетский" gr="A,gen,m,norm,plen,sg" sem="dt:topon r:rel der:s t:topon" sem2=""/>тибетского</w> <w><ana lex="язык" gr="S,anim,gen,m,norm,sg" sem="" sem2="t:hum r:concr"/><ana lex="язык" gr="S,gen,inan,m,norm,sg" sem="pt:partb pc:animal r:concr r:abstr pc:hum" sem2="t:food sc:hum t:form sc:word r:abstr der:shift pt:set pt:aggr pc:tool:mus pt:part top:rod r:concr pc:tool"/>языка</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="галсан" gr="S,anim,ins,m,norm,persn,sg" sem="t:hum r:propn t:persn" sem2=""/>Галсаном</w> (<w><ana lex="тибетец" gr="S,anim,ins,m,norm,sg" sem="" sem2=""/>тибетцем</w>).</se></p>
<p><se><w><ana lex="по" gr="PR,norm" sem="" sem2=""/>По</w> <w><ana lex="часть" gr="S,f,inan,loc,norm,sg" sem="r:concr pc:x pt:part" sem2="pc:org r:abstr sc:part t:org pt:ind pt:aggr:aggrpl t:poss der:shift pc:x pt:part pc:text r:concr"/>части</w> <w><ana lex="продажа" gr="S,f,gen,inan,norm,sg" sem="der:v r:abstr der:s0 t:poss" sem2="r:abstr t:poss"/>продажи</w> <w><ana lex="верблюд" gr="S,anim,gen,m,norm,pl" sem="t:animal r:concr" sem2=""/>верблюдов</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="мы" gr="SPRO,1p,gen,norm,pl" sem="r:pers" sem2=""/>нас</w> <w><ana lex="прибавиться" gr="V,act,indic,intr,n,norm,pf,praet,sg" sem="ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>прибавилось</w> <w><ana lex="покупатель" gr="S,anim,gen,m,norm,pl" sem="der:v t:hum r:concr d:nag" sem2=""/>покупателей</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="один" gr="ANUM,acc,f,norm,sg" sem="r:card r:card:pauc der:num" sem2=""/>одну</w> <w><ana lex="единица" gr="S,acc,anim,f,norm,sg" sem="" sem2=""/><ana lex="единица" gr="S,acc,f,inan,norm,sg" sem="t:ciph r:concr der:num" sem2="t:schoolmark pt:element hi:class der:num r:abstr pc:set t:unit r:concr"/>единицу</w>, <w><ana lex="а" gr="CONJ,norm" sem="" sem2=""/>а</w> <w><ana lex="именно" gr="PART,norm" sem="" sem2=""/>именно</w> <w><ana lex="объявиться" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="ca:noncaus d:pref" sem2=""/>объявилась</w> <w><ana lex="солидный" gr="A,f,nom,norm,plen,sg" sem="t:physq ev r:qual" sem2="t:time:age t:humq ev t:size:max r:qual"/>солидная</w> <w><ana lex="китайский" gr="A,f,nom,norm,plen,sg" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>китайская</w> <w><ana lex="компания" gr="S,f,inan,nom,norm,sg" sem="t:group pt:set r:concr sc:hum" sem2="r:concr t:org"/>компания</w>, <w><ana lex="член" gr="S,inan,m,nom,norm,pl" sem="" sem2="pc:hum pc:animal pt:set t:word pc:x pt:part pt:partb r:concr"/><ana lex="член" gr="S,anim,m,nom,norm,pl" sem="t:hum r:concr" sem2=""/>члены</w> <w><ana lex="который" gr="APRO,f,gen,norm,sg" sem="r:rel t:ord" sem2=""/>которой</w> <w><ana lex="узко" gr="ADV,comp,norm" sem="dt:size:min der:a" sem2="dt:size:min der:a"/><ana lex="уже" gr="ADV,norm" sem="t:time" sem2=""/>уже</w> <w><ana lex="побывать" gr="V,act,indic,intr,norm,pf,pl,praet" sem="der:v ca:noncaus t:move d:pref" sem2="der:v d:pref"/>побывали</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="наш" gr="APRO,loc,m,norm,sg" sem="r:poss" sem2=""/>нашем</w> <w><ana lex="пастушеский" gr="A,loc,m,norm,plen,sg" sem="r:rel der:s dt:hum" sem2=""/>пастушеском</w> <w><ana lex="лагерь" gr="S,inan,loc,m,norm,sg" sem="t:space r:concr" sem2="t:group pt:set t:space r:concr sc:hum"/>лагере</w>, <w><ana lex="самый" gr="APRO,ins,m,norm,sg" sem="r:spec" sem2="r:spec"/>самым</w> <w><ana lex="тщательный" gr="A,ins,m,norm,plen,sg" sem="r:rel der:s" sem2=""/>тщательным</w> <w><ana lex="образ" gr="S,inan,ins,m,norm,sg" sem="t:ment r:concr r:abstr t:workart" sem2="t:asp r:abstr"/>образом</w> <w><ana lex="обследовать" gr="V,act,ger,norm,pf,praet,tran" sem="d:pref" sem2=""/>обследовав</w> <w><ana lex="верблюд" gr="S,acc,anim,m,norm,pl" sem="t:animal r:concr" sem2=""/>верблюдов</w>.</se><se> <w><ana lex="такой" gr="APRO,ins,m,norm,sg" sem="r:dem" sem2="r:indet r:spec t:degr:max"/>Таким</w> <w><ana lex="образ" gr="S,inan,ins,m,norm,sg" sem="t:ment r:concr r:abstr t:workart" sem2="t:asp r:abstr"/>образом</w>, <w><ana lex="торговаться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="t:speech ca:noncaus" sem2="t:speech ca:noncaus"/>торгуются</w> <w><ana lex="четыре" gr="NUM,nom,norm" sem="r:card:pauc" sem2=""/>четыре</w> <w><ana lex="компания" gr="S,f,gen,inan,norm,sg" sem="t:group pt:set r:concr sc:hum" sem2="r:concr t:org"/>компании</w>: <w><ana lex="три" gr="NUM,nom,norm" sem="r:card:pauc" sem2=""/>три</w> <w><ana lex="русский" gr="A,nom,norm,pl,plen" sem="dt:topon r:rel der:s t:topon" sem2=""/>русские</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w