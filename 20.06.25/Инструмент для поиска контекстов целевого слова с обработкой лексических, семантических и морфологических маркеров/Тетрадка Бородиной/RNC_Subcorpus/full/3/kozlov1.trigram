<p><se><w><ana lex="около" gr="PR,norm" sem="" sem2=""/>Около</w> <w><ana lex="полдень" gr="S,gen,inan,m,norm,sg" sem="r:abstr t:time" sem2="t:space r:concr"/>полудня</w> <w><ana lex="ко" gr="PR,norm" sem="" sem2=""/>ко</w> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w> <w><ana lex="заходить" gr="V,act,indic,m,norm,pf,praet,sg,tran" sem="ca:noncaus t:move d:pref" sem2=""/><ana lex="заходить" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2=""/><ana lex="заходить" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2=""/><ana lex="зайти" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/><ana lex="заходить" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="ca:noncaus t:move d:pref" sem2=""/><ana lex="заходить" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="ca:noncaus t:move d:pref" sem2=""/>заходил</w> <w><ana lex="убугунов" gr="S,anim,bastard,famn,m,nom,sg" sem="t:hum r:propn t:famn" sem2=""/>Убугунов</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="сообщить" gr="V,act,indic,m,norm,pf,praet,sg" sem="t:speech ca:noncaus d:pref" sem2="d:pref"/>сообщил</w>: <w><ana lex="1" gr="NUM,ciph"/>1</w>) <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="китаец" gr="S,anim,m,nom,norm,pl" sem="" sem2=""/>китайцы</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="ответ" gr="S,acc,inan,m,norm,sg" sem="t:speech r:abstr" sem2="t:text r:concr r:abstr t:speech pc:text pt:addit"/>ответ</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="ультиматум" gr="S,acc,inan,m,norm,sg" sem="t:speech r:abstr" sem2=""/>ультиматум</w> <w><ana lex="предложить" gr="V,act,indic,norm,pf,pl,praet" sem="t:speech ca:noncaus d:pref" sem2="t:speech ca:noncaus d:pref"/>предложили</w> <w><ana lex="карахан" gr="S,anim,bastard,dat,m,persn,sg" sem="t:hum r:propn t:famn t:persn" sem2=""/>Карахану</w> <w><ana lex="требование" gr="S,acc,inan,n,norm,sg" sem="t:speech der:v r:abstr der:s0" sem2="t:ment der:v t:doc r:abstr t:speech r:concr"/>требование</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="3" gr="NUM,ciph"/>3</w>-<w><ana lex="дневный" gr="A,acc,inan,m,norm,plen,sg" sem="dt:abstr dt:time r:rel der:s t:time" sem2=""/>дневный</w> <w><ana lex="срок" gr="S,acc,inan,m,norm,sg" sem="t:time:period r:abstr t:param" sem2="t:time:moment r:abstr"/>срок</w> <w><ana lex="оставить" gr="V,act,inf,norm,pf" sem="t:loc d:pref ca:caus" sem2="d:pref"/>оставить</w> <w><ana lex="китай" gr="S,acc,inan,m,norm,sg" sem="r:propn t:topon" sem2=""/>Китай</w>, <w><ana lex="территория" gr="S,acc,f,inan,norm,sg" sem="t:space r:concr" sem2=""/>территорию</w> <w><ana lex="китай" gr="S,gen,inan,m,norm,sg" sem="r:propn t:topon" sem2=""/>Китая</w>.</se><se> <w><ana lex="2" gr="NUM,ciph"/>2</w>) <w><ana lex="что" gr="SPRO,inan,n,nom,norm,sg" sem="r:rel" sem2=""/>Что</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="ответ" gr="S,acc,inan,m,norm,sg" sem="t:speech r:abstr" sem2="t:text r:concr r:abstr t:speech pc:text pt:addit"/>ответ</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="запрос" gr="S,acc,inan,m,norm,sg" sem="t:speech der:v r:abstr der:s0" sem2="der:v t:doc t:ment r:concr r:abstr"/>запрос</w> <w><ana lex="к" gr="PR,norm" sem="" sem2=""/>к</w> <w><ana lex="горбунова" gr="S,anim,f,famn,loc,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Горбуновой</w> <w><ana lex="последний" gr="A,f,nom,norm,plen,sg" sem="r:rel t:ord" sem2="t:degr:max:magn r:qual r:rel ev:neg t:time"/>последняя</w> <w><ana lex="ответить" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="t:speech ca:noncaus d:pref" sem2="d:pref"/>ответила</w>: «<w><ana lex="скоро" gr="ADV,norm" sem="dt:speed:max der:a t:time" sem2="dt:speed:max der:a t:time"/>Скоро</w> <w><ana lex="вырешиться" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="d:pref" sem2=""/>вырешится</w>, <w><ana lex="надеяться" gr="V,1p,act,indic,intr,ipf,norm,praes,sg" sem="t:ment ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>надеюсь</w>!</se><se>». <w><ana lex="после" gr="PR,norm" sem="" sem2=""/>После</w> <w><ana lex="это" gr="SPRO,gen,inan,n,norm,sg" sem="r:dem" sem2=""/>этого</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="компания" gr="S,f,inan,loc,norm,sg" sem="t:group pt:set r:concr sc:hum" sem2="r:concr t:org"/>компании</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="бадмажапов" gr="S,anim,bastard,famn,ins,m,sg" sem="t:hum r:propn t:famn" sem2=""/>Бадмажаповым</w> <w><ana lex="уехать" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2=""/>уехал</w> <w><ana lex="на" gr="PR,norm" sem="" sem2=""/>на</w> <w><ana lex="китайский" gr="A,acc,inan,m,norm,plen,sg" sem="dt:topon dt:hum:etn r:rel der:s t:topon" sem2=""/>китайский</w> <w><ana lex="обед" gr="S,acc,inan,m,norm,sg" sem="r:abstr" sem2="t:food sc:food r:abstr pt:aggr t:time r:concr"/>обед</w>.</se><se> <w><ana lex="там" gr="ADVPRO,norm" sem="t:place r:dem" sem2=""/>Там</w> <w><ana lex="быть" gr="V,act,indic,intr,ipf,m,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>был</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="бербридж" gr="S,bastard,inan,m,nom,sg" sem="" sem2=""/><ana lex="бербридж" gr="S,bastard,inan,m,nom,sg" sem="" sem2=""/>Бербридж</w>.</se><se> <w><ana lex="обед" gr="S,inan,m,nom,norm,sg" sem="r:abstr" sem2="t:food sc:food r:abstr pt:aggr t:time r:concr"/>Обед</w> <w><ana lex="отличный" gr="A,m,nom,norm,plen,sg" sem="der:v r:rel" sem2="ev:posit t:quality r:qual"/>отличный</w>, <w><ana lex="вкусно" gr="ADV,norm" sem="ev:posit dt:physq:taste der:a" sem2=""/>вкусно</w>, <w><ana lex="весело" gr="ADV,norm" sem="dt:psych:emot ev:posit der:a" sem2=""/>весело</w>, <w><ana lex="оживленно" gr="ADV,norm" sem="ev:posit der:aprt" sem2=""/>оживленно</w>!</se></p>
<p><se><w><ana lex="на" gr="PR,norm" sem="" sem2=""/>На</w> <w><ana lex="бивак" gr="S,inan,loc,m,norm,sg" sem="t:space r:concr" sem2="t:space r:concr"/>биваке</w> <w><ana lex="ко" gr="PR,norm" sem="" sem2=""/>ко</w> <w><ana lex="я" gr="SPRO,1p,dat,norm,sg" sem="r:pers" sem2=""/>мне</w> <w><ana lex="явиться" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="ca:noncaus" sem2="ca:noncaus t:move"/>явился</w> <w><ana lex="канаич" gr="S,anim,bastard,m,nom,patrn,sg" sem="" sem2=""/>Канаич</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="объятие" gr="S,inan,loc,n,norm,pl" sem="r:abstr" sem2=""/>объятиях</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="два" gr="NUM,ins,norm" sem="r:card:pauc" sem2=""/>двумя</w> <w><ana lex="даурский" gr="A,ins,norm,pl,plen" sem="r:rel der:s" sem2=""/>даурскими</w> <w><ana lex="галочка" gr="S,f,inan,ins,norm,pl" sem="" sem2="d:dim t:form t:sign r:concr der:s"/><ana lex="галочка" gr="S,anim,f,ins,norm,persn,pl" sem="d:dim t:animal r:concr der:s" sem2=""/>галочками</w>.</se></p>
<p><se><w><ana lex="вечер" gr="S,inan,m,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>Вечер</w> <w><ana lex="часть" gr="S,f,inan,ins,norm,sg" sem="r:concr pc:x pt:part" sem2="pc:org r:abstr sc:part t:org pt:ind pt:aggr:aggrpl t:poss der:shift pc:x pt:part pc:text r:concr"/>частью</w> <w><ana lex="провести" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="провести" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="der:v ca:caus t:move d:pref" sem2="der:v ca:caus d:pref"/><ana lex="проводить" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="ca:caus t:move d:pref" sem2="d:pref"/>проведен</w> <w><ana lex="я" gr="SPRO,1p,ins,norm,sg" sem="r:pers" sem2=""/>мною</w> <w><ana lex="среди" gr="PR,norm" sem="" sem2=""/>среди</w> <w><ana lex="мой" gr="APRO,gen,norm,pl" sem="r:poss" sem2=""/>моих</w> <w><ana lex="спутник" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr der:s" sem2=""/><ana lex="спутник" gr="S,gen,inan,m,norm,pl" sem="" sem2="t:space t:astr r:abstr t:tool:device der:shift r:concr"/>спутников</w>, <w><ana lex="часть" gr="S,f,inan,ins,norm,sg" sem="r:concr pc:x pt:part" sem2="pc:org r:abstr sc:part t:org pt:ind pt:aggr:aggrpl t:poss der:shift pc:x pt:part pc:text r:concr"/>частью</w> <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="себе" gr="SPRO,gen,norm" sem="" sem2=""/>себя</w> <w><ana lex="дома" gr="ADV,norm" sem="t:place der:s" sem2=""/>дома</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="чтение" gr="S,inan,ins,n,norm,sg" sem="der:v r:abstr der:s0" sem2="der:v t:action r:concr t:text r:abstr"/>чтением</w> «<w><ana lex="архив" gr="S,gen,inan,m,norm,sg" sem="r:concr t:org" sem2="pc:org t:org pt:set pt:part r:concr sc:text"/>Архива</w> <w><ana lex="революция" gr="S,f,gen,inan,norm,sg" sem="r:abstr" sem2="r:abstr"/>революции</w>».</se><se> <w><ana lex="обстоятельный" gr="A,m,nom,norm,plen,sg" sem="ev:posit r:rel" sem2="ev:posit t:humq r:qual"/>Обстоятельный</w> <w><ana lex="труд" gr="S,inan,m,nom,norm,sg" sem="r:abstr" sem2="t:media t:text r:abstr t:discipl r:propn r:concr"/>труд</w>, <w><ana lex="богатый" gr="A,m,nom,norm,plen,sg" sem="r:qual" sem2="der:shift r:qual"/>богатый</w> <w><ana lex="материал" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr" sem2="t:stuff t:text hi:class r:abstr sc:doc r:concr"/>материал</w> <w><ana lex="для" gr="PR,norm" sem="" sem2=""/>для</w> <w><ana lex="история" gr="S,f,inan,loc,norm,sg" sem="r:abstr" sem2="ev:neg r:concr r:abstr t:text"/>истории</w> <w><ana lex="русский" gr="A,f,gen,norm,plen,sg" sem="dt:topon r:rel der:s t:topon" sem2=""/>русской</w> <w><ana lex="революция" gr="S,f,gen,inan,norm,sg" sem="r:abstr" sem2="r:abstr"/>революции</w>.</se></p>
<p><se><b/><w><b>26</b></w><b>/</b><w><ana lex="iii" gr="bastard" sem="" sem2=""/><b>III</b></w><b>, </b><w><ana lex="s" gr="bastard" sem="" sem2=""/><b>S</b></w><b/>. <w><ana lex="ясный" gr="A,n,nom,norm,plen,sg" sem="r:qual" sem2="r:qual"/>Ясное</w>, <w><ana lex="прозрачный" gr="A,n,nom,norm,plen,sg" sem="t:physq r:rel" sem2="t:physq r:rel r:qual"/>прозрачное</w> <w><ana lex="утро" gr="S,inan,n,nom,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action r:abstr"/>утро</w>, <w><ana lex="тянуть" gr="V,3p,act,indic,ipf,norm,praes,sg,tran" sem="ca:caus t:move d:root" sem2="d:root"/>тянет</w> <w><ana lex="струя" gr="S,f,inan,nom,norm,sg" sem="qc:stuff pt:qtm top:line r:concr" sem2="qc:stuff pt:qtm r:abstr pt:aggr:aggrpl sc:qtm r:concr"/>струя</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana form="юго-востока" lex="юго-восток" gr="S,gen,inan,m,norm,sg" sem="der:comp t:space r:concr r:abstr t:dir" sem2="der:comp t:space r:concr pt:part pc:space"/>юго-востока</w>.</se><se> <w><ana lex="богдо" gr="ADV,bastard" sem="" sem2=""/>Богдо-ула</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="безмятежный" gr="A,loc,m,norm,plen,sg" sem="d:carit der:s r:qual" sem2=""/>безмятежном</w> <w><ana lex="покой" gr="S,inan,loc,m,norm,sg" sem="t:letter t:move r:abstr t:room t:neg r:concr" sem2="t:neg t:psych r:abstr"/>покое</w>.</se><se> <w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w><ana lex="день" gr="S,inan,ins,m,norm,sg" sem="pc:day r:abstr pt:part t:time" sem2="t:action t:unit t:time:period r:abstr"/>днем</w>, <w>вероятно</w>, <w><ana lex="температура" gr="S,f,inan,nom,norm,sg" sem="r:abstr t:param t:temper" sem2="t:physiol r:abstr t:temper"/>температура</w> <w><ana lex="значительно" gr="ADV,norm" sem="dt:size:max t:degr:max der:a" sem2="dt:size:max der:a"/>значительно</w> <w><ana lex="подняться" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus d:pref"/>поднимется</w> -- <w><ana lex="посмотреть" gr="V,1p,act,fut,indic,norm,pf,pl,tran" sem="ca:noncaus d:pref t:perc" sem2="d:pref"/><ana lex="посмотреть" gr="V,1p,act,imper,norm,pf,pl,tran" sem="ca:noncaus d:pref t:perc" sem2="d:pref"/>посмотрим</w>!</se><se> <w><ana lex="нет" gr="PART,norm" sem="" sem2=""/>Нет</w>!</se><se> <w><ana lex="весна" gr="S,f,inan,nom,norm,sg" sem="t:time:season r:abstr t:time" sem2=""/>Весна</w> <w><ana lex="где" gr="ADVPRO,norm" sem="t:place r:rel" sem2="t:place r:indet"/><ana form="где-то" lex="где-то" gr="ADVPRO,norm" sem="t:place r:indet der:advpro" sem2=""/>где-то</w> <w><ana lex="задержаться" gr="V,act,f,indic,intr,norm,pf,praet,sg" sem="der:v ca:noncaus d:pref" sem2="der:v ca:noncaus d:pref"/>задержалась</w>, <w><ana lex="у" gr="PR,norm" sem="" sem2=""/>у</w> <w><ana lex="мы" gr="SPRO,1p,gen,norm,pl" sem="r:pers" sem2=""/>нас</w> <w><ana lex="весна" gr="S,f,gen,inan,norm,sg" sem="t:time:season r:abstr t:time" sem2=""/>весны</w> <w>нет</w>, <w><ana lex="один" gr="APRO,n,nom,norm,sg" sem="" sem2="r:indet"/>одно</w> <w><ana lex="холодный" gr="A,n,nom,norm,plen,sg" sem="dt:weather dt:temper t:physq:temper dt:abstr der:s r:qual" sem2="dt:weather t:humq t:physq:color dt:temper t:physq:temper ev:neg dt:abstr der:shift der:s r:qual r:rel"/>холодное</w> <w><ana lex="недоразумение" gr="S,inan,n,nom,norm,sg" sem="r:abstr" sem2="r:abstr t:inter"/>недоразумение</w>!</se><se> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>С</w> <w><ana lex="горе" gr="S,gen,inan,n,norm,sg" sem="t:psych:emot r:abstr" sem2="r:abstr"/>горя</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="читать" gr="V,1p,act,indic,ipf,norm,praes,sg,tran" sem="d:root" sem2="d:root"/>читаю</w> «<w><ana lex="архив" gr="S,inan,m,nom,norm,sg" sem="r:concr t:org" sem2="pc:org t:org pt:set pt:part r:concr sc:text"/>Архив</w> <w><ana lex="революция" gr="S,f,gen,inan,norm,sg" sem="r:abstr" sem2="r:abstr"/>революции</w>», <w><ana lex="укладывать" gr="V,1p,act,indic,ipf,nor