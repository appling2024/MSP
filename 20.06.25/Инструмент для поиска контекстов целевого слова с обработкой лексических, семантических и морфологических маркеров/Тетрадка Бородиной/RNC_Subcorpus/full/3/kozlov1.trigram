<p><se><w><ana lex="при" gr="PR,norm" sem="" sem2=""/>При</w> <w><ana lex="завод" gr="S,inan,loc,m,norm,sg" sem="r:concr t:org" sem2="t:impact t:tool r:abstr der:s0 t:org pc:tool:device der:v pt:part r:concr"/>заводе</w> <w><ana lex="звездный" gr="A,gen,m,norm,plen,sg" sem="dt:space r:rel der:s" sem2="dt:space t:physq:form r:rel der:s"/>звездного</w> <w><ana lex="хронометр" gr="S,gen,inan,m,norm,sg" sem="der:comp t:tool:device:measur:metr r:concr" sem2=""/>хронометра</w>, <w><ana lex="узко" gr="ADV,comp,norm" sem="dt:size:min der:a" sem2="dt:size:min der:a"/><ana lex="уже" gr="ADV,norm" sem="t:time" sem2=""/>уже</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="конец" gr="S,inan,loc,m,norm,sg" sem="pt:phase r:concr r:abstr pt:part pc:x" sem2="top:rope t:tool t:space t:be:disapp r:abstr ev:neg r:concr"/>конце</w> <w><ana lex="самый" gr="APRO,gen,m,norm,sg" sem="r:spec" sem2="r:spec"/><ana lex="сам" gr="APRO,gen,m,norm,sg" sem="r:spec" sem2=""/>самого</w> <w><ana lex="завод" gr="S,gen,inan,m,norm,sg" sem="r:concr t:org" sem2="t:impact t:tool r:abstr der:s0 t:org pc:tool:device der:v pt:part r:concr"/>завода</w>, <w><ana lex="что" gr="SPRO,inan,n,nom,norm,sg" sem="r:rel" sem2=""/><ana form="что-то" lex="что-то" gr="SPRO,inan,n,nom,norm,sg" sem="r:indet" sem2=""/>что-то</w> <w><ana lex="соскользнуть" gr="V,act,indic,intr,n,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2=""/>соскользнуло</w>, <w><ana lex="треснуть" gr="V,act,indic,n,norm,pf,praet,sg,tran" sem="der:v ca:noncaus d:semelf t:sound" sem2="der:v ca:caus t:impact t:changest d:semelf ca:noncaus"/><ana lex="треснуть" gr="V,act,indic,intr,n,norm,pf,praet,sg" sem="der:v ca:noncaus d:semelf t:sound" sem2="der:v ca:caus t:impact t:changest d:semelf ca:noncaus"/>треснуло</w>.</se><se> <w><ana lex="хронометр" gr="S,inan,m,nom,norm,sg" sem="der:comp t:tool:device:measur:metr r:concr" sem2=""/>Хронометр</w> <w><ana lex="стать" gr="V,act,indic,intr,m,norm,pf,praet,sg" sem="aux:phase d:root t: