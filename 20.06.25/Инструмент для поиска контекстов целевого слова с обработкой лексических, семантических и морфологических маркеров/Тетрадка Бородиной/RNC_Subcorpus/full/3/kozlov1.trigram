ube r:concr"/>переходов</w> <w><ana lex="за" gr="PR,norm" sem="" sem2=""/>за</w> <w><ana lex="5-6" gr="NUM,ciph"/>5-6</w> <w><ana lex="вниз" gr="ADV,norm" sem="der:s t:dir" sem2="der:s"/>вниз</w> <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="долина" gr="S,f,inan,loc,norm,sg" sem="t:space r:concr der:s t:fam" sem2=""/>долине</w> <w><ana lex="тола" gr="S,f,gen,inan,norm,sg" sem="" sem2=""/>Толы</w>, <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="менее" gr="ADV,norm" sem="t:degr:min der:adv" sem2="t:degr:min der:adv"/>менее</w> <w><ana lex="снежный" gr="A,loc,m,norm,plen,sg" sem="dt:stuff r:rel der:s" sem2="t:physq:color r:qual"/>снежном</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="много" gr="ADV,comp,norm" sem="t:quant:max r:spec" sem2="t:degr:max"/><ana lex="более" gr="ADV,norm" sem="t:degr:max der:adv" sem2="t:degr:max"/>более</w> <w><ana lex="защитить" gr="V,loc,n,norm,partcp,pass,pf,plen,praet,sg" sem="d:pref" sem2="d:pref"/>защищенном</w> <w><ana lex="от" gr="PR,norm" sem="" sem2=""/>от</w> <w><ana lex="ветер" gr="S,gen,inan,m,norm,sg" sem="r:abstr t:weather" sem2="t:fam"/>ветра</w> <w><ana lex="место" gr="S,inan,loc,n,norm,sg" sem="qc:space t:space r:concr" sem2="qc:space sc:org t:tool t:space pt:element r:abstr pt:aggr:aggrpl pt:part pc:text r:concr"/>месте</w> <w><ana lex="обосноваться" gr="V,act,inf,intr,norm,pf" sem="der:v ca:noncaus d:pref" sem2=""/>обосноваться</w>, <w>хорошо</w> <w><ana lex="устроиться" gr="V,act,inf,intr,norm,pf" sem="der:v d:pref t:be:appear" sem2=""/>устроиться</w>, <w><ana lex="экскурсировать" gr="V,act,bastard,inf,ipf" sem="" sem2=""/>экскурсировать</w> <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="цель" gr="S,f,inan,ins,norm,sg" sem="t:space r:concr" sem2="t:ment r:abstr"/>целью</w> <w><ana lex="добыча" gr="S,f,gen,inan,norm,sg" sem="der:v r:abstr der:s0 t:poss" sem2="sc:thing r:abstr pt:ind der:v t:poss pt:aggr r:concr"/>добычи</w> <w><ana lex="птица" g