<p><se><b/><w><b>2</b></w><b>/</b><w><ana lex="x" gr="bastard" sem="" sem2=""/><b>X</b></w><b>.</b> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>Я</w> <w><ana lex="навестить" gr="V,act,indic,m,norm,pf,praet,sg" sem="ca:noncaus t:move d:pref" sem2=""/>навестил</w> <w>В</w>. <w>И</w>. <w><ana lex="юдина" gr="S,anim,f,famn,nom,norm,sg" sem="t:hum r:propn t:famn" sem2=""/>Юдина</w>, <w><ana lex="наш" gr="APRO,gen,m,norm,sg" sem="r:poss" sem2=""/>нашего</w> <w><ana lex="русский" gr="A,gen,m,norm,plen,sg" sem="dt:topon r:rel der:s t:topon" sem2=""/>русского</w> <w><ana lex="консул" gr="S,anim,gen,m,norm,sg" sem="t:hum r:concr" sem2="t:hum r:concr"/>консула</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="монголия" gr="S,f,inan,loc,norm,sg" sem="r:propn t:topon" sem2=""/>Монголии</w>.</se><se> <w><ana lex="первый" gr="ANUM,n,nom,norm,sg" sem="r:ord der:num t:ord r:qual" sem2="ev:posit t:hier t:qual r:qual"/>Первое</w> <w><ana lex="впечатление" gr="S,inan,n,nom,norm,sg" sem="t:perc r:abstr" sem2="t:ment r:abstr"/>впечатление</w> <w><ana lex="отличный" gr="A,n,nom,norm,plen,sg" sem="der:v r:rel" sem2="ev:posit t:quality r:qual"/>отличное</w>.</se><se> <w><ana lex="надеяться" gr="V,1p,act,indic,intr,ipf,norm,praes,sg" sem="t:ment ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>Надеюсь</w>, <w><ana lex="с" gr="PR,norm" sem="" sem2=""/>с</w> <w><ana lex="он" gr="SPRO,3p,ins,m,norm,sg" sem="r:pers" sem2=""/>ним</w> <w>можно</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="только" gr="PART,norm" sem="" sem2=""/>только</w> <w><ana lex="симпатично" gr="ADV,norm" sem="ev:posit dt:humq der:a" sem2=""/>симпатично</w> <w><ana lex="разговаривать" gr="V,act,inf,intr,ipf,norm" sem="t:speech ca:noncaus d:pref d:impf der:s" sem2=""/>разговаривать</w>, <w><ana lex="но" gr="CONJ,norm" sem="" sem2=""/>но</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="дело" gr="S,acc,inan,n,norm,sg" sem="r:abstr" sem2="sc:doc ev:pos