bedding sc:tool:cloth"/>покровом</w> <w><ana lex="древесный" gr="A,f,gen,norm,plen,sg" sem="dt:plant r:rel der:s" sem2="dt:stuff r:rel der:s"/>древесной</w> <w><ana lex="растительность" gr="S,f,gen,inan,norm,sg" sem="pt:aggr sc:plant r:concr hi:class" sem2="t:hair pc:hum pt:aggr r:concr sc:hair"/>растительности</w>.</se><se> <w><ana lex="воздух" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>Воздух</w> <w><ana lex="прозрачный" gr="A,brev,m,norm,sg" sem="" sem2="r:qual"/>прозрачен</w>, <w><ana lex="по" gr="PR,norm" sem="" sem2=""/>по</w> <w><ana lex="долина" gr="S,f,inan,loc,norm,sg" sem="t:space r:concr der:s t:fam" sem2=""/>долине</w> <w><ana lex="двигаться" gr="V,3p,act,indic,intr,ipf,norm,pl,praes" sem="der:v ca:noncaus t:move" sem2="der:v ca:noncaus"/>двигаются</w> <w><ana lex="пеший" gr="A,nom,norm,pl,plen" sem="r:rel" sem2=""/>пешие</w> <w><ana lex="и" gr="CONJ,norm" sem="" sem2=""/>и</w> <w><ana lex="конный" gr="A,nom,norm,pl,plen" sem="r:rel der:s dt:animal" sem2="r:rel der:s dt:animal"/>конные</w>, <w><ana lex="преимущественно" gr="ADV,norm" sem="dt:hier der:a" sem2=""/>преимущественно</w> <w><ana lex="солдат" gr="S,anim,m,nom,norm,pl" sem="t:hum t:armpos r:concr" sem2="t:hum r:concr"/>солдаты-цирики</w>.</se><se> <w>Интересно</w>, <w><ana lex="между" gr="PR,norm" sem="" sem2=""/>между</w> <w><ana lex="прочее" gr="SPRO,ins,n,norm,sg" sem="" sem2=""/>прочим</w>, <w><ana lex="что" gr="CONJ,norm" sem="" sem2=""/>что</w> <w><ana lex="обучение" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr der:s0" sem2=""/>обучение</w> <w><ana lex="строевой" gr="A,0,norm,plen" sem="r:rel der:s" sem2="t:physq t:physq:form r:rel"/>строевой</w> <w><ana lex="линия" gr="S,f,gen,inan,norm,sg" sem="top:line t:space r:concr" sem2="sc:x sc:hum t:space t:form top:line r:abstr pt:set der:shift t:conctr top:stripe pt:part t:unit r:concr"/>линии</w> <w><ana lex="в" gr="PR,norm" sem="" sem2=""/>в</w> <w><ana lex="пехотный" gr="A,loc,m,norm,plen,sg" sem="r:rel d