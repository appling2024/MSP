<p><se><w><ana lex="сегодня" gr="ADV,norm" sem="der:comp t:time" sem2=""/>Сегодня</w> <w>надо</w> <w><ana lex="непременно" gr="ADV,norm" sem="der:a" sem2=""/>непременно</w> <w><ana lex="ждать" gr="V,act,inf,ipf,norm,tran" sem="d:root" sem2="d:root"/>ждать</w> <w><ana lex="ответ" gr="S,gen,inan,m,norm,sg" sem="t:speech r:abstr" sem2="t:text r:concr r:abstr t:speech pc:text pt:addit"/>ответа</w> <w><ana lex="из" gr="PR,norm" sem="" sem2=""/>из</w> <w><ana lex="центр" gr="S,gen,inan,m,norm,sg" sem="t:space r:concr pc:form:geom pt:part" sem2="pc:org t:space pc:hum pc:animal t:org pt:set pt:partb:organ pc:x pt:part sc:cell2 r:concr"/>Центра</w>, <w><ana lex="иначе" gr="CONJ,norm" sem="" sem2=""/>иначе</w> <w><ana lex="я" gr="SPRO,1p,nom,norm,sg" sem="r:pers" sem2=""/>я</w> <w><ana lex="не" gr="PART,norm" sem="" sem2=""/>не</w> <w><ana lex="мочь" gr="V,1p,act,indic,intr,ipf,norm,praes,sg" sem="d:root" sem2=""/>могу</w> <w><ana lex="представить" gr="V,act,inf,norm,pf" sem="d:pref" sem2="d:pref"/>представить</w> <w><ana lex="себе" gr="SPRO,dat,norm" sem="" sem2=""/>себе</w>, <w><ana lex="до" gr="PR,norm" sem="" sem2=""/>до</w> <w><ana lex="какой" gr="APRO,0,norm" sem="t:neg r:rel ev:neg" sem2=""/>какой</w> <w><ana lex="пора" gr="S,f,gen,inan,norm,sg" sem="t:space r:abstr t:time pc:partb r:concr top:hole" sem2="t:space r:concr r:abstr t:time"/>поры</w> <w><ana lex="он" gr="SPRO,3p,m,nom,norm,sg" sem="r:pers" sem2=""/>он</w> <w><ana lex="быть" gr="V,3p,act,fut,indic,intr,norm,pf,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>будет</w> <w><ana lex="тянуть" gr="V,act,inf,ipf,norm,tran" sem="ca:caus t:move d:root" sem2="d:root"/>тянуть</w>.</se><se> <w><ana lex="время" gr="S,gen,inan,n,norm,sg" sem="r:abstr t:param t:time" sem2="t:time:period r:abstr t:time"/>Времени</w> <w><ana lex="пройти" gr="V,act,indic,n,norm,pf,praet,sg" sem="der:v ca:noncaus t:move d:pref" sem2="der:v ca:noncaus t:move d:pref"/><ana lex="пройти" gr="V,act,indic,intr,n,norm,pf,praet,sg" s