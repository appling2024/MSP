<p class="h3"><se><w><ana lex="1.3" gr="NUM,ciph"/>1.3</w>.</se><se> <w><ana lex="получение" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr t:poss"/>Получение</w> <w><ana lex="1,3,5" gr="NUM,ciph"/>1,3,5</w>-<w><ana lex="триарил" gr="S,bastard,inan,m,nom,sg"/>триарил</w>-<w><ana lex="2,4" gr="NUM,ciph"/>2,4</w>-<w><ana lex="диазапентадиен" gr="S,bastard,gen,inan,m,pl"/>диазапентадиенов</w>-<w><ana lex="1,4" gr="NUM,ciph"/>1,4</w></se></p>

<p><se><w>Известно</w>, <w><ana lex="что" gr="CONJ,norm"/>что</w> <w><ana lex="обычно" gr="ADV,norm" sem="der:a t:time" sem2="der:a"/>обычно</w> <w><ana lex="ароматический" gr="A,nom,norm,pl,plen" sem="dt:stuff r:rel der:s"/>ароматические</w> <w><ana lex="альдегид" gr="S,inan,m,nom,norm,pl" sem="t:stuff r:concr"/>альдегиды</w> <w><ana lex="реагировать" gr="V,3p,act,indic,ipf,norm,pl,praes"/>реагируют</w> <w><ana lex="с" gr="PR,norm"/>с</w> <w><ana lex="аммиак" gr="S,inan,ins,m,norm,sg" sem="t:stuff r:concr"/>аммиаком</w> <w><ana lex="с" gr="PR,norm"/>с</w> <w><ana lex="образование" gr="S,inan,ins,n,norm,sg" sem="der:v r:abstr der:s0 t:be:appear" sem2="t:spot der:v r:concr r:abstr"/>образованием</w> <w><ana lex="1,3,5" gr="NUM,ciph"/>1,3,5</w>-<w><ana lex="триарил" gr="S,bastard,inan,m,nom,sg"/>триарил</w>-<w><ana lex="2,4" gr="NUM,ciph"/>2,4</w>-<w><ana lex="диазапентадиен" gr="S,bastard,gen,inan,m,pl"/>диазапентадиенов</w>-<w><ana lex="1,4" gr="NUM,ciph"/>1,4</w>, (<b/><w><ana lex="4" gr="NUM,ciph"/>4</w><b/>) (<w><ana lex="схема" gr="S,f,inan,nom,norm,sg" sem="pt:aggr r:abstr" sem2="t:ment t:pattern r:concr r:abstr t:text"/>схема</w> <w><ana lex="3" gr="NUM,ciph"/>3</w>).</se> </p>
<p><se><w><ana lex="1,3,5" gr="NUM,ciph"/>1,3,5</w>-<w><ana lex="трифенил" gr="S,bastard,inan,m,nom,sg"/>Трифенил</w>-<w><ana lex="2,4" gr="NUM,ciph"/>2,4</w>-<w><ana lex="диазапентадиен" gr="S,bastard,inan,m,nom,sg"/>диазапентадиен</w>-<w><ana lex="2,5" gr="NUM,ciph"/>2,5</w> (<b/><w><ana lex="4" gr="NUM,ciph"/>4</w><b/><w><ana lex="а" gr="CONJ,norm"/>а</w><b/>), <w><ana lex="иметь" gr="V,act,ipf,m,nom,norm,partcp,plen,praes,sg" sem="ca:noncaus d:root t:poss" sem2="d:root"/>имеющий</w> <w><ana lex="тривиальный" gr="A,acc,n,norm,plen,sg" sem="r:rel"/>тривиальное</w> <w><ana lex="название" gr="S,acc,inan,n,norm,sg" sem="r:abstr t:name" sem2="der:v r:concr r:abstr t:name"/>название</w> <w><ana lex="гидробензамид" gr="S,bastard,inan,m,nom,sg"/><ana lex="гидробензамид" gr="S,anim,bastard,m,nom,persn,sg"/><ana lex="гидробензамид" gr="S,anim,bastard,m,nom,persn,sg"/>гидробензамид</w>, <w><ana lex="впервые" gr="ADV,norm" sem="dt:ord der:anum"/>впервые</w> <w><ana lex="быть" gr="V,act,indic,ipf,m,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>был</w> <w><ana lex="получать" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="der:v d:pref"/>получен</w> <w><ana lex="еще" gr="ADV,norm"/>еще</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="1837" gr="NUM,ciph"/>1837</w> <w><ana lex="год" gr="S,inan,loc2,m,norm,sg" sem="t:unit t:time:period r:abstr" sem2="t:time:period t:time:age r:abstr"/>году</w> <w><ana lex="как" gr="CONJ,norm"/>как</w> <w><ana lex="продукт" gr="S,acc,inan,m,norm,sg" sem="t:thing r:concr" sem2="t:food hi:class sc:food r:abstr pt:aggr:aggrpl r:concr"/>продукт</w> <w><ana lex="реакция" gr="S,f,gen,inan,norm,sg" sem="der:v r:abstr der:s0" sem2="t:changest t:physiol r:abstr"/>реакции</w> <w><ana lex="бензальдегид" gr="S,bastard,gen,inan,m,sg" sem="t:stuff r:concr"/>бензальдегида</w> <w><ana lex="с" gr="PR,norm"/>с</w> <w><ana lex="аммиак" gr="S,inan,ins,m,norm,sg" sem="t:stuff r:concr"/>аммиаком</w> [<w><ana lex="32" gr="NUM,ciph"/>32</