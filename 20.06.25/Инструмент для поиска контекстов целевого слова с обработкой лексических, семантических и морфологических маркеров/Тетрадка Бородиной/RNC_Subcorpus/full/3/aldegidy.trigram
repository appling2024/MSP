<p><se><w><ana lex="чтобы" gr="CONJ,norm"/>Чтобы</w> <w><ana lex="избегать" gr="V,act,inf,norm,pf" sem="der:v d:pref" sem2="der:v d:pref"/>избежать</w> <w><ana lex="это" gr="SPRO,gen,n,norm,sg" sem="r:dem"/><ana lex="это" gr="SPRO,gen,inan,n,norm,sg" sem="r:dem"/>этого</w>, <w><ana lex="реакция" gr="S,f,inan,nom,norm,sg" sem="der:v r:abstr der:s0" sem2="t:changest t:physiol r:abstr"/>реакция</w> <w><ana lex="быть" gr="V,act,f,indic,ipf,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>была</w> <w><ana lex="проводить" gr="V,brev,f,norm,partcp,pass,pf,praet,sg" sem="ca:caus t:move d:pref" sem2="d:pref"/><ana lex="проводить" gr="V,brev,f,norm,partcp,pass,pf,praet,sg" sem="ca:caus t:move d:pref" sem2="d:pref"/>проведена</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="безводный" gr="A,loc,m,norm,plen,sg" sem="dt:stuff d:carit r:rel der:s" sem2="dt:stuff d:carit r:rel der:s"/>безводном</w> <w><ana lex="спирт" gr="S,inan,loc,m,norm,sg" sem="t:food t:stuff r:concr t:liq" sem2="t:stuff r:concr hi:class"/>спирте</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="присутствие" gr="S,inan,loc,n,norm,sg" sem="r:abstr" sem2="der:v t:space r:concr r:abstr t:org"/>присутствии</w> <w><ana lex="пиридин" gr="S,gen,inan,m,norm,sg"/>пиридина</w> <w><ana lex="для" gr="PR,norm"/>для</w> <w><ana lex="уменьшение" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr"/>уменьшения</w> <w><ana lex="кислотность" gr="S,f,gen,inan,norm,sg" sem="r:abstr der:s"/>кислотности</w> <w><ana lex="среда" gr="S,f,gen,inan,norm,sg" sem="t:time:week t:stuff r:concr r:abstr" sem2="t:space r:abstr sc:space sc:hum pt:aggr r:concr"/>среды</w> <w><ana lex="и" gr="CONJ,norm"/>и</w> <w><ana lex="с" gr="PR,norm"/>с</w> <w><ana lex="использование" gr="S,inan,ins,n,norm,sg" sem="der:v r:abstr"/>использованием</w> <w><ana lex="ni" gr="bastard"/>Ni</w> (<w><ana lex="oac" gr="bastard"/>OAc</w>) <sub><w><ana lex="2" gr="NUM,ciph"/>2</w></sub>*<w><ana lex="acoh" gr="bastard"/>AcOH</w>.</se><se> <w><a