ин" gr="S,anim,bastard,gen,m,persn,pl"/>триазинов</w> <w><ana lex="основной" gr="A,ins,norm,pl,plen" sem="t:hier r:rel"/><ana lex="основный" gr="A,ins,norm,pl,plen" sem="r:rel der:s"/>основными</w> <w><ana lex="продукт" gr="S,inan,ins,m,norm,pl" sem="t:thing r:concr" sem2="t:food hi:class sc:food r:abstr pt:aggr:aggrpl r:concr"/>продуктами</w> <w><ana lex="являть" gr="V,3p,indic,ipf,norm,pass,pl,praes" sem="der:v d:root"/><ana lex="являться" gr="V,3p,act,indic,ipf,norm,pl,praes" sem="der:v ca:noncaus" sem2="der:v ca:noncaus"/>являются</w> <w><ana lex="не" gr="PART,norm"/>не</w> <w><ana lex="енамин" gr="S,anim,bastard,m,nom,persn,pl"/>енамины</w> <b/><w><ana lex="96" gr="NUM,ciph"/>96</w><b/>, <w><ana lex="а" gr="CONJ,norm"/>а</w> <w><ana lex="диимин" gr="S,bastard,inan,m,nom,pl"/>диимины</w> <b/><w><ana lex="93" gr="NUM,ciph"/>93</w><b/> [<w><ana lex="20,28" gr="NUM,ciph"/>20,28</w>].</se></p>

