<p><se><b/><w><ana lex="мезо" gr="S,bastard,inan,n,nom,sg"/>Мезо</w><b>-</b><w><ana lex="1,2" gr="NUM,ciph"/>1,2</w><b>-</b><w>ди</w><b> (</b><w><ana lex="4" gr="NUM,ciph"/>4</w><b>-</b><w><ana lex="бромфенил" gr="S,bastard,inan,m,nom,sg" sem="t:stuff r:concr"/>бромфенил</w><b>) </b><w><ana lex="этан" gr="S,inan,m,nom,norm,sg"/>этан</w><b>-</b><w><ana lex="1,2" gr="NUM,ciph"/>1,2</w><b>-</b><w><ana lex="диамин" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr"/>диамин</w><b/> (<b/><w><ana lex="ivж" gr="bastard"/>IVж</w><b/>): <w><ana lex="из" gr="PR,norm"/>из</w> <w><ana lex="1" gr="NUM,ciph"/>1</w><w>г</w> <b/><w><ana lex="7" gr="NUM,ciph"/>7</w><b/><w>ж</w><b/> <w><ana lex="получать" gr="V,brev,n,norm,partcp,pass,pf,praet,sg" sem="der:v d:pref"/>получено</w> <w><ana lex="0,37" gr="NUM,ciph"/>0,37</w> <w>г</w> (<w><ana lex="54" gr="NUM,ciph"/>54</w>%) <w><ana lex="диамин" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr"/>диамина</w> <b/><w><ana lex="ivж" gr="bastard"/>IVж</w><b/> <w>с</w> <w>Т</w> <w>пл</w>.</se><se> <w><ana lex="123-124" gr="NUM,ciph"/>123-124</w>°<w><ana lex="c" gr="bastard"/>C</w>. <w><ana lex="спектральный" gr="A,nom,norm,pl,plen" sem="r:rel der:s"/>Спектральные</w> <w><ana lex="данные" gr="S,inan,nom,norm,pl" sem="t:ment der:v pt:aggr:aggr_pl r:abstr" sem2="der:v pt:aggr:aggr_pl t:humq r:abstr"/>данные</w> <w><ana lex="получать" gr="V,gen,n,norm,partcp,pass,pf,plen,praet,sg" sem="der:v d:pref"/>полученного</w> <w><ana lex="соединение" gr="S,gen,inan,n,norm,sg" sem="pt:set der:v r:abstr der:s0" sem2="pt:set t:space hi:class t:org der:v t:stuff sc:hum pt:part r:concr"/>соединения</w> <w><ana lex="полностью" gr="ADV,norm" sem="dt:full t:degr:max der:a"/>полностью</w> <w><ana lex="соответствовать" gr="V,3p,act,indic,ipf,norm,pl,praes" sem="d:pref der:s"/>соответствуют</w> <w><ana lex="приводить" gr="V,dat,norm,partcp,pass,pf,pl,plen,praet" sem="aux:caus ca:caus t:move d:pref"/>приведенным</w> <w><ana lex="высоко" gr="ADV,comp,norm" sem="t:place dt:si