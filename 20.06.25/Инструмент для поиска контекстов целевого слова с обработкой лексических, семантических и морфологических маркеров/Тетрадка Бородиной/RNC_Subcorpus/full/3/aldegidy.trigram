	<p class="verse"><se><w><ana lex="по" gr="PR,norm"/>По</w> <w><ana lex="данный" gr="APRO,f,loc,norm,sg" sem="r:dem"/>данной</w> <w><ana lex="методика" gr="S,f,inan,loc,norm,sg" sem="r:abstr" sem2="r:abstr"/>методике</w> <w><ana lex="получать" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="der:v d:pref"/>получены</w>: <br/> </se></p>
<p><se><b/><w><ana lex="n" gr="bastard"/>N</w><b>-</b><w><ana lex="бензоил" gr="S,inan,m,nom,norm,sg"/>бензоил</w><b>-</b><w><ana lex="мезо" gr="S,bastard,inan,n,nom,sg"/>мезо</w><b>-</b><w><ana lex="1,2" gr="NUM,ciph"/>1,2</w><b>-</b><w><ana lex="дифенил" gr="S,inan,m,nom,norm,sg"/>дифенил</w><b>-</b><w><ana lex="1,2" gr="NUM,ciph"/>1,2</w><b>-</b><w><ana lex="диаминоэтан" gr="S,bastard,inan,m,nom,sg" sem="t:stuff r:concr"/>диаминоэтан</w><b/> (<b/><w><ana lex="iiiа" gr="bastard"/>IIIа</w><b/>): <w><ana lex="из" gr="PR,norm"/>из</w> <w><ana lex="25" gr="NUM,ciph"/>25</w> <w>г</w> (<w><ana lex="0,061" gr="NUM,ciph"/>0,061</w> <w><ana lex="моль" gr="S,anim,f,nom,norm,sg" sem="sc:animal t:animal r:concr pt:aggr pt:ind"/><ana lex="моль" gr="S,f,inan,nom,norm,sg" sem="t:unit pt:aggr r:concr sc:qtm r:abstr"/>моль</w>) <b/><w><ana lex="iiа" gr="bastard"/>IIа</w><b/>, <w><ana lex="55" gr="NUM,ciph"/>55</w> <w><ana lex="мл" gr="S,0,inan,m,norm" sem="der:abbr t:unit r:abstr"/>мл</w> <w><ana lex="конц" gr="S,anim,bastard,m,nom,persn,sg" sem="t:hum r:propn t:famn"/>конц</w>. <w><ana lex="серный" gr="A,f,gen,norm,plen,sg" sem="t:physq dt:stuff r:rel der:s"/>серной</w> <w><ana lex="кислота" gr="S,f,gen,inan,norm,sg" sem="der:a t:stuff r:concr hi:class" sem2="t:taste r:abstr der:a"/>кислоты</w> <w><ana lex="и" gr="CONJ,norm"/>и</w> <w><ana lex="200" gr="NUM,ciph"/>200</w> <w><ana lex="мл" gr="S,0,inan,m,norm" sem="der:abbr t:unit r:abstr"/>мл</w> <w><ana lex="вода" gr="S,f,gen,inan,norm,sg" sem="t:stuff r:concr t:liq" sem2="t:food dt:stuff t:stuff sc:reservoir t:liq sc:space r:abstr pt:aggr:aggrpl sc:qtm t:space pt:part ev:neg sc:spring pc:space r:concr der:shift"/>воды</w> <w><ana lex="при" gr="PR,norm"/>при</w> <w><ana lex="кипячение" gr="S,inan,loc,n,norm,sg" sem="t:impact der:v r:abstr"/>кипячении</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="течение" gr="S,acc,inan,n,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="qc:stuff der:v t:move r:concr r:abstr"/>течение</w> <w><ana lex="12" gr="NUM,ciph"/>12</w> <w>ч</w> <w><ana lex="получать" gr="V,brev,n,norm,partcp,pass,pf,praet,sg" sem="der:v d:pref"/>получено</w> <w><ana lex="12" gr="NUM,ciph"/>12</w> <w>г</w> (<w><ana lex="63" gr="NUM,ciph"/>63</w>%) <b/><w><ana lex="iiiа" gr="bastard"/>IIIа</w><b/>. <w>с</w> <w>Т</w> <w>пл</w>.</se><se> <w><ana lex="204" gr="NUM,ciph"/>204</w>°<w>C</w>. <w><ana lex="спектр" gr="S,inan,m,nom,norm,sg" sem="pt:aggr r:abstr" sem2="t:color pt:aggr r:abstr"/>Спектр</w> <w><ana lex="ямр" gr="S,anim,bastard,m,nom,persn,sg"/><ana lex="ямр" gr="S,anim,bastard,m,nom,persn,sg"/>ЯМР</w> <sup><w><ana lex="1" gr="NUM,ciph"/>1</w></sup><w><ana lex="h" gr="bastard"/>H</w> (<w><ana lex="300,13" gr="NUM,ciph"/>300,13</w> <w><ana lex="мгц" gr="S,0,inan,m,norm"/>МГц</w>, <w><ana lex="дмсо" gr="S,0,anim,bastard,m,persn,sg"/><ana lex="дмсо" gr="S,0,bastard,inan,m,sg" sem="der:abbr t:stuff r:concr t:term"/>ДМСО</w>-<w><ana lex="d" gr="bastard"/>d</w><sup><w><ana lex="6" gr="NUM,ciph"/>6</w></sup>/<w><ana lex="ccl" gr="bastard"/>CCl</w><sub><w><ana lex="4" gr="NUM,ciph"/>4</w></sub>, <w><ana lex="ґ" gr="bastard"/>ґ</w>, <w><ana lex="м" gr="S,0,inan,m,norm"/>м</w>.<w>д</w>.</se><se>, <w><ana lex="j" gr="bastard"/>J</w>/<w><ana lex="гц" gr="S,0,inan,m,norm"/>Гц</w>): <w><ana lex="3.00" gr="NUM,ciph"/>3.00</w> (<w><ana lex="ушир" gr="S,anim,bastard,m,nom,persn,sg"/>ушир</w>. <w>с</w>, <w><ana lex="2" gr="NUM,ciph"/>2</w><w>H</w>) (<w><ana lex="nh" gr="bastard"/>NH</w><sub><w><ana lex="2" gr="NUM,ciph"/>2</w></sub>), <w><ana lex="4,55" gr="NUM,ciph"/>4,55</w> <w><ana lex="м" gr="S,0,inan,m,norm"/>м</w>.<w>д</w>.</se><se> (<w><ana lex="д" gr="bastard"/>д</w>, <w><ana lex="j" gr="bastard"/>J</w> = <w><ana lex="8" gr="NUM,ciph"/>8</w> <w><ana lex="гц" gr="S,0,inan,m,norm"/>Гц</w>, <w><ana lex="1" gr="NUM,ciph"/>1</w><w>H</w>) (<w><ana lex="ch" gr="bastard"/>CH</w>-<w><ana lex="nh" gr="bastard"/>NH</w><sub><w><ana lex="2" gr="NUM,ciph"/>2</w></sub>), <w><ana lex="5,45" gr="NUM,c