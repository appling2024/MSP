<p><se><w><ana lex="альдегид" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr"/>Альдегид</w> <w><ana lex="и" gr="CONJ,norm"/>и</w> <w><ana lex="ацетат" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr hi:class"/>ацетат</w> <w><ana lex="аммоний" gr="S,anim,gen,m,norm,persn,sg"/><ana lex="аммоний" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr"/>аммония</w> <w><ana lex="нагревать" gr="V,3p,act,indic,ipf,norm,pl,praes" sem="der:v t:changest d:pref d:impf"/>нагревают</w> <w><ana lex="до" gr="PR,norm"/>до</w> <w><ana lex="120" gr="NUM,ciph"/>120</w>°<w><ana lex="c" gr="bastard"/>C</w> <w><ana lex="и" gr="CONJ,norm"/>и</w> <w><ana lex="перемешивать" gr="V,3p,act,indic,ipf,norm,pl,praes" sem="der:v d:pref d:impf"/><ana lex="перемешивать" gr="V,3p,act,indic,ipf,norm,pl,praes" sem="der:v d:pref d:impf"/>перемешивают</w> <w><ana lex="при" gr="PR,norm"/>при</w> <w><ana lex="этот" gr="APRO,f,loc,norm,sg" sem="r:dem"/>этой</w> <w><ana lex="температура" gr="S,f,inan,loc,norm,sg" sem="r:abstr t:param t:temper" sem2="t:physiol r:abstr t:temper"/>температуре</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="течение" gr="S,acc,inan,n,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="qc:stuff der:v t:move r:concr r:abstr"/>течение</w> <w><ana lex="3" gr="NUM,ciph"/>3</w> <w>ч</w>.</se><se> <w><ana lex="реакционный" gr="A,acc,f,norm,plen,sg" sem="r:rel der:s"/>Реакционную</w> <w><ana lex="смесь" gr="S,acc,f,inan,norm,sg" sem="pt:set sc:x r:concr hi:class" sem2="t:stuff r:concr"/>смесь</w> <w><ana lex="охлаждать" gr="V,3p,act,indic,ipf,norm,pl,praes" sem="d:pref der:a"/>охлаждают</w>, <w><ana lex="осадок" gr="S,acc,inan,m,norm,sg" sem="der:v t:stuff r:concr" sem2="r:abstr"/>осадок</w> <w><ana lex="отфильтровывать" gr="V,3p,act,indic,ipf,norm,pl,praes" sem="der:v d:pref d:impf"/>отфильтровывают</w>, <w><ana lex="промывать" gr="V,3p,act,indic,ipf,norm,pl,praes" sem="t:impact der:v d:pref d:impf"/>промывают</w> <w><ana lex="вода" gr="S,f,inan,ins,norm,sg" sem="t:stuff r:concr t:liq" sem2="t