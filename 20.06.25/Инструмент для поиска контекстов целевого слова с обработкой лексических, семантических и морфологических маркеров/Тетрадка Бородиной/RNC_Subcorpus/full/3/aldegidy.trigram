<p><se><w><ana lex="попытка" gr="S,f,inan,nom,norm,sg" sem="r:abstr" sem2="r:abstr"/>Попытка</w> <w><ana lex="автор" gr="S,anim,gen,m,norm,pl" sem="t:hum r:concr d:nag"/>авторов</w> [<w><ana lex="50" gr="NUM,ciph"/>50</w>] <w><ana lex="использовать" gr="V,act,inf,norm,pf" sem="der:v d:pref"/>использовать</w> <w><ana lex="ультрафиолетовый" gr="A,acc,n,norm,plen,sg" sem="der:comp r:rel"/>ультрафиолетовое</w> <w><ana lex="излучение" gr="S,acc,inan,n,norm,sg" sem="der:v r:abstr"/>излучение</w> <w><ana lex="для" gr="PR,norm"/>для</w> <w><ana lex="конротаторный" gr="A,bastard,f,gen,plen,sg"/>конротаторной</w> <w><ana lex="циклизация" gr="S,f,gen,inan,norm,sg" sem="r:abstr"/>циклизации</w> <w><ana lex="анион" gr="S,gen,inan,m,norm,sg"/>аниона</w> <w><ana lex="трифенилдиазапентадиен" gr="S,bastard,gen,inan,m,sg"/>трифенилдиазапентадиена</w>, <w><ana lex="получать" gr="V,gen,m,norm,partcp,pass,pf,plen,praet,sg" sem="der:v d:pref"/>полученного</w> <w><ana lex="при" gr="PR,norm"/>при</w> -<w><ana lex="70" gr="NUM,ciph"/>70</w>°<w><ana lex="c" gr="bastard"/>C</w>, <w><ana lex="сразу" gr="ADV,norm" sem="t:time" sem2="ev der:s"/>сразу</w> <w><ana lex="в" gr="PR,norm"/>в</w> <i/><w><ana lex="транс" gr="S,acc,inan,m,norm,sg" sem="t:psych r:abstr"/>транс</w><i/>-<w><ana lex="имидазолин" gr="S,acc,bastard,inan,m,sg"/>имидазолин</w> <w><ana lex="приводить" gr="V,act,f,indic,norm,pf,praet,sg" sem="aux:caus ca:caus t:move d:pref"/>привела</w> <w><ana lex="к" gr="PR,norm"/>к</w> <w><ana lex="продукт" gr="S,dat,inan,m,norm,sg" sem="t:thing r:concr" sem2="t:food hi:class sc:food r:abstr pt:aggr:aggrpl r:concr"/>продукту</w> <b/><w><ana lex="8" gr="NUM,ciph"/>8</w><b/><w><ana lex="a" gr="bastard"/>a</w><b/>, <w><ana lex="но" gr="CONJ,norm"/>но</w> <w><ana lex="с" gr="PR,norm"/>с</w> <w><ana lex="низкий" gr="A,ins,m,norm,plen,sg" sem="t:size:min r:qual" sem2="t:humq t:hier t:level r:qual t:size:min t:sound ev:neg t:interpretation"/>низким</w> <w><ana lex="выход" gr="S,inan,ins,m,norm,sg" sem