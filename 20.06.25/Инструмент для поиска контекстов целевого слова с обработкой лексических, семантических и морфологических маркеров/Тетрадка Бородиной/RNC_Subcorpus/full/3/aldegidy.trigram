<p><se><w><ana lex="мы" gr="SPRO,1p,ins,norm,pl" sem="r:pers"/><ana lex="мы" gr="SPRO,1p,anim,ins,norm,pl" sem="r:pers"/>Нами</w> <w><ana lex="быть" gr="V,act,f,indic,ipf,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>была</w> <w><ana lex="поставлять" gr="V,brev,f,norm,partcp,pass,pf,praet,sg" sem="der:v d:pref"/>поставлена</w> <w><ana lex="задача" gr="S,f,inan,nom,norm,sg" sem="t:ment r:abstr" sem2="t:ment r:abstr"/>задача</w> <w><ana lex="изучать" gr="V,act,inf,norm,pf" sem="der:v d:pref"/>изучить</w> <w><ana lex="возможность" gr="S,acc,f,inan,norm,sg" sem="der:a r:abstr t:mod" sem2="r:abstr der:a"/>возможность</w> <w><ana lex="управление" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0" sem2="sc:tool:device r:abstr t:org pc:tool:device der:v pt:aggr pt:part r:concr"/>управления</w> <w><ana lex="реакция" gr="S,f,inan,ins,norm,sg" sem="der:v r:abstr der:s0" sem2="t:changest t:physiol r:abstr"/>реакцией</w> <w><ana lex="ароматический" gr="A,gen,norm,pl,plen" sem="dt:stuff r:rel der:s"/>ароматических</w> <w><ana lex="альдегид" gr="S,gen,inan,m,norm,pl" sem="t:stuff r:concr"/>альдегидов</w> <w><ana lex="с" gr="PR,norm"/>с</w> <w><ana lex="аммиак" gr="S,inan,ins,m,norm,sg" sem="t:stuff r:concr"/>аммиаком</w>.</se><se> <w><ana lex="основной" gr="A,nom,norm,pl,plen" sem="t:hier r:rel"/><ana lex="основный" gr="A,nom,norm,pl,plen" sem="r:rel der:s"/>Основные</w> <w><ana lex="продукт" gr="S,inan,m,nom,norm,pl" sem="t:thing r:concr" sem2="t:food hi:class sc:food r:abstr pt:aggr:aggrpl r:concr"/>продукты</w> <w><ana lex="этот" gr="APRO,f,gen,norm,sg" sem="r:dem"/>этой</w> <w><ana lex="реакция" gr="S,f,gen,inan,norm,sg" sem="der:v r:abstr der:s0" sem2="t:changest t:physiol r:abstr"/>реакции</w>, <w><ana lex="такой" gr="APRO,nom,norm,pl" sem="r:dem" sem2="r:indet r:spec t:degr:max"/>такие</w> <w><ana lex="как" gr="CONJ,norm"/>как</w>, <w>например</w>, <w><ana lex="гексагидротриазина" gr="S,anim,bastard,f,gen,persn,sg"/><ana lex="гексагидротриази