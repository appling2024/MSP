raet,sg" sem="ca:noncaus d:pref"/>удалось</w> <w><ana lex="доказывать" gr="V,act,inf,norm,pf" sem="der:v d:pref d:impf"/>доказать</w>, <w><ana lex="проводить" gr="V,act,ger,ipf,norm,praes" sem="ca:caus t:move d:pref" sem2="d:pref"/><ana lex="проводить" gr="V,act,ger,ipf,norm,praes" sem="ca:caus t:move d:pref" sem2="d:pref"/>проводя</w> <w><ana lex="пмр" gr="S,0,norm"/>ПМР</w>-<w><ana lex="эксперимент" gr="S,inan,m,nom,norm,sg" sem="r:abstr" sem2="r:abstr"/>эксперимент</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="абсолютный" gr="A,loc,m,norm,plen,sg" sem="r:rel der:s" sem2="t:degr:max:magn der:s r:qual"/>абсолютном</w> <w><ana lex="дмсо" gr="S,0,anim,bastard,m,persn,sg"/><ana lex="дмсо" gr="S,0,bastard,inan,m,sg" sem="der:abbr t:stuff r:concr t:term"/>ДМСО</w>-<w><ana lex="d" gr="bastard"/>d</w><sup><w><ana lex="6" gr="NUM,ciph"/>6</w></sup>, <w><ana lex="а" gr="CONJ,norm"/>а</w> <w><ana lex="также" gr="PART,norm"/>также</w> <w><ana lex="с" gr="PR,norm"/>с</w> <w><ana lex="привлечение" gr="S,inan,ins,n,norm,sg" sem="der:v r:abstr"/>привлечением</w> <w><ana lex="данные" gr="S,gen,inan,norm,pl" sem="t:ment der:v pt:aggr:aggr_pl r:abstr" sem2="der:v pt:aggr:aggr_pl t:humq r:abstr"/>данных</w> <w><ana lex="элементный" gr="A,gen,m,norm,plen,sg" sem="r:rel der:s"/>элементного</w> <w><ana lex="анализ" gr="S,gen,inan,m,norm,sg" sem="r:abstr" sem2="t:ment r:abstr"/>анализа</w>.</se><se> <w><ana lex="этот" gr="APRO,m,nom,norm,sg" sem="r:dem"/>Этот</w> <w><ana lex="факт" gr="S,inan,m,nom,norm,sg" sem="r:abstr" sem2="t:ment r:abstr"/>факт</w> <w><ana lex="позволять" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v d:pref"/>позволил</w> <w><ana lex="предполагать" gr="V,act,inf,norm,pf" sem="t:ment ca:noncaus der:v d:pref" sem2="t:ment ca:noncaus der:v d:pref"/>предположить</w>, <w><ana lex="что" gr="CONJ,norm"/>что</w> <w><ana lex="растворитель" gr="S,inan,m,nom,norm,pl" sem="der:v t:stuff r:concr hi:class"/>растворители</w>, <w><ana lex="способный" gr="A,nom,norm,pl,plen" sem="t:humq d:potent r:qual" sem2="t:humq r:qual"/>способные</w> <w><ana lex="образовывать" gr="V,act,inf,ipf,norm" sem="der:v d:pref d:impf"/>образовывать</w> <w><ana lex="водородный" gr="A,acc,inan,norm,pl,plen" sem="dt:stuff r:rel der:s"/>водородные</w> <w><ana lex="связь" gr="S,acc,f,inan,norm,pl" sem="r:abstr t:inter" sem2="sc:org pt:set r:abstr sc:thing t:inter der:v pt:aggr pc:constr pt:part r:concr"/>связи</w> (<w><ana lex="спирт" gr="S,inan,m,nom,norm,pl" sem="t:food t:stuff r:concr t:liq" sem2="t:stuff r:concr hi:class"/>спирты</w>, <w><ana lex="дмсо" gr="S,0,anim,bastard,m,persn"/><ana lex="дмсо" gr="S,0,anim,bastard,famn,m"/>ДМСО</w>), <w><ana lex="стабилизировать" gr="V,3p,act,fut,indic,norm,pf,pl"/>стабилизируют</w> <w><ana lex="структура" gr="S,acc,f,inan,norm,sg" sem="r:abstr" sem2="r:concr t:org"/>структуру</w> <w><ana lex="гексагидротриазин" gr="S,bastard,gen,inan,m,pl" sem="t:stuff r:concr"/><ana lex="гексагидротриазин" gr="S,anim,bastard,gen,m,persn,pl"/>гексагидротриазинов</w> <b/><w><ana lex="3" gr="NUM,ciph"/>3</w><b/>.</se></p>

<p class="h2"><se><w><ana lex="2" gr="NUM,ciph"/>2</w>.<w><ana lex="изучение" gr="S,inan,n,nom,norm,sg" sem="t:ment der:v r:abstr"/>Изучение</w> <w><ana lex="реакция" gr="S,f,gen,inan,norm,sg" sem="der:v r:abstr der:s0" sem2="t:changest t:physiol r:abstr"/>реакции</w> <w><ana lex="ароматический" gr="A,gen,norm,pl,plen" sem="dt:stuff r:rel der:s"/>ароматических</w> <w><ana lex="альдегид" gr="S,gen,inan,m,norm,pl" sem="t:stuff r:concr"/>альдегидов</w> <w><ana lex="с" gr="PR,norm"/>с</w> <w><ana lex="ацетат" gr="S,inan,ins,m,norm,sg" sem="t:stuff r:concr hi:class"/>ацетатом</w> <w><ana lex="аммоний" gr="S,anim,gen,m,norm,persn,sg"/><ana lex="аммоний" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr"/>аммония</w></se></p>

