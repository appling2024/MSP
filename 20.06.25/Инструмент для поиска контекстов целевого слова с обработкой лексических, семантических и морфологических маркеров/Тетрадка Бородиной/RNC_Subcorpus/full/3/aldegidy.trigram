е" gr="S,gen,inan,n,norm,sg" sem="pt:set der:v r:abstr der:s0" sem2="pt:set t:space hi:class t:org der:v t:stuff sc:hum pt:part r:concr"/>соединения</w> <b/><w><ana lex="7" gr="NUM,ciph"/>7</w><b/><w>п</w><b/> <w><ana lex="быть" gr="V,act,f,indic,ipf,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>была</w> <w><ana lex="предлагать" gr="V,brev,f,norm,partcp,pass,pf,praet,sg" sem="der:v d:pref t:impact:creat"/>предложена</w> <w><ana lex="цис" gr="S,anim,bastard,m,nom,persn,sg"/><ana lex="цис" gr="S,anim,bastard,famn,m,nom,sg"/><ana lex="цис" gr="S,bastard,inan,m,nom,sg"/><ana lex="цис" gr="S,anim,bastard,m,nom,persn,sg"/>цис</w>-<w><ana lex="конфигурация" gr="S,f,inan,nom,norm,sg" sem="t:form r:concr r:abstr" sem2="r:abstr"/>конфигурация</w> <w><ana lex="из" gr="PR,norm"/><ana lex="из-за" gr="PR,norm"/>из</w>-<w><ana lex="за" gr="PR,norm"/>за</w> <w><ana lex="сильный" gr="A,gen,m,norm,plen,sg" sem="t:physq d:habit r:qual" sem2="ev:posit t:humq:char der:s t:degr:max r:qual r:rel"/>сильного</w> <w><ana lex="сдвиг" gr="S,gen,inan,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="t:move r:abstr"/>сдвига</w> <w><ana lex="характеристичный" gr="A,gen,norm,pl,plen" sem="r:rel der:s"/>характеристичных</w> <w><ana lex="протон" gr="S,gen,inan,m,norm,pl" sem="qc:stuff pt:element pc:stuff r:concr"/>протонов</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="слабый" gr="A,acc,n,norm,plen,sg" sem="t:physq r:qual" sem2="t:humq t:degr:min r:qual t:physq der:shift ev:neg"/>слабое</w> <w><ana lex="поле" gr="S,acc,inan,n,norm,sg" sem="top:horiz t:space r:concr" sem2="t:plot t:space dt:space pc:workart pc:tool:cloth r:abstr top:surface der:shift top:stripe pt:part r:concr"/>поле</w>, <w><ana lex="а" gr="CONJ,norm"/>а</w> <w><ana lex="для" gr="PR,norm"/>для</w> <b/><w><ana lex="8" gr="NUM,ciph"/>8</w><b/><w>д</w><b/> -- <w><ana lex="транс" gr="S,inan,m,nom,norm,sg" sem="t:psych r:abstr"/>транс</w>-<w><ana lex="конфигурация" gr="S,f,inan,nom,norm,sg" sem="t:for