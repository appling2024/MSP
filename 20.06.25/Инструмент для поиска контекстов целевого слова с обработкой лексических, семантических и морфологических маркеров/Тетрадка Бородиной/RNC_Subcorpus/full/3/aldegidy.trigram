<p><se><b/><w><ana lex="4" gr="NUM,ciph"/>4</w><b>-</b><w><ana lex="бромбензальдегид" gr="S,bastard,inan,m,nom,sg"/>бромбензальдегид</w><b> (</b><w><ana lex="1" gr="NUM,ciph"/>1</w><b/><w><ana lex="ж" gr="CONJ,norm"/>ж</w><b>): </b><w><ana lex="1,3,5" gr="NUM,ciph"/>1,3,5</w>-<w><ana lex="трис" gr="S,anim,bastard,m,nom,persn,sg"/><ana lex="трис" gr="S,anim,bastard,m,nom,persn,sg"/><ana lex="трис" gr="S,bastard,inan,m,nom,sg"/>трис</w> (<w><ana lex="4" gr="NUM,ciph"/>4</w>-<w><ana lex="бромфенил" gr="S,bastard,inan,m,nom,sg" sem="t:stuff r:concr"/>бромфенил</w>) -<w><ana lex="2,4" gr="NUM,ciph"/>2,4</w>-<w><ana lex="диазапентадиен" gr="S,bastard,inan,m,nom,sg"/>диазапентадиен</w>-<w><ana lex="1,4" gr="NUM,ciph"/>1,4</w> (<w><ana lex="4" gr="NUM,ciph"/>4</w><w>ж</w>) <w><ana lex="получать" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="der:v d:pref"/>получен</w> <w><ana lex="при" gr="PR,norm"/>при</w> <w><ana lex="реакция" gr="S,dat,f,inan,norm,sg" sem="der:v r:abstr der:s0" sem2="t:changest t:physiol r:abstr"/>реакции</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="течение" gr="S,acc,inan,n,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="qc:stuff der:v t:move r:concr r:abstr"/>течение</w> <w><ana lex="4" gr="NUM,ciph"/>4</w> <w><ana lex="сутки" gr="S,gen,inan,norm,pl" sem="t:unit t:time:period r:abstr"/>суток</w> <w><ana lex="при" gr="PR,norm"/>при</w> <w><ana lex="упаривание" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr"/>упаривании</w> <w><ana lex="маточный" gr="A,gen,m,norm,plen,sg" sem="r:rel der:s"/>маточного</w> <w><ana lex="раствор" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:abstr t:liq der:v t:space r:concr" sem2="der:v t:space r:concr t:stuff"/>раствора</w>.</se><se> <w><ana lex="выход" gr="S,inan,m,nom,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="t:quant ev:posit t:space r:abstr der:v pc:constr pt:part r:concr"/>Выход</w> <w><ana lex="0,81" gr="NUM,ciph"/>0,81</w><w>г</w> (<w><ana lex="85" gr="NUM,ciph"/>85</w>%).</se></p>
<p><se><b/><w><ana lex="3" gr="NUM,ciph"/>3</w><b>-</b><w><ana lex="нитробензальдегид" gr="S,bastard,inan,m,nom,sg"/>нитробензальдегид</w><b> (</b><w><ana lex="1" gr="NUM,ciph"/>1</w><b/><w><ana lex="к" gr="PR,norm"/>к</w><b>): </b><w><ana lex="после" gr="PR,norm"/>после</w> <w><ana lex="4" gr="NUM,ciph"/>4</w> <w><ana lex="сутки" gr="S,gen,inan,norm,pl" sem="t:unit t:time:period r:abstr"/>суток</w> <w><ana lex="реакция" gr="S,f,gen,inan,norm,sg" sem="der:v r:abstr der:s0" sem2="t:changest t:physiol r:abstr"/>реакции</w> <w><ana lex="получать" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="der:v d:pref"/>получен</w> <w><ana lex="цис" gr="S,anim,bastard,m,nom,persn,sg"/><ana lex="цис" gr="S,anim,bastard,famn,m,nom,sg"/><ana lex="цис" gr="S,bastard,inan,m,nom,sg"/><ana lex="цис" gr="S,anim,bastard,m,nom,persn,sg"/>цис</w>-<w><ana lex="2,4,5" gr="NUM,ciph"/>2,4,5</w>-<w><ana lex="трис" gr="S,anim,bastard,m,nom,persn,sg"/><ana lex="трис" gr="S,anim,bastard,m,nom,persn,sg"/><ana lex="трис" gr="S,bastard,inan,m,nom,sg"/>трис</w> (<w><ana lex="3" gr="NUM,ciph"/>3</w>-<w><ana lex="нитрофенил" gr="S,bastard,inan,m,nom,sg" sem="t:stuff r:concr"/>нитрофенил</w>) <w><ana lex="имидазолин" gr="S,bastard,inan,m,nom,sg"/>имидазолин</w> (<b/><w><ana lex="7" gr="NUM,ciph"/>7</w><b/><w>к</w><b/>) <w><ana lex="с" gr="PR,norm"/>с</w> <w><ana lex="73" gr="NUM,ciph"/>73</w>% <w><ana lex="выход" gr="S,inan,ins,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="t:quant ev:posit t:space r:abstr der:v pc:constr pt:part r:concr"/>выходом</w> (<w><ana lex="0.8" gr="NUM,ciph"/>0.8</w><w>г</w>).</se><se> <w><ana lex="соединение" gr="S,acc,inan,n,norm,sg" sem="pt:set der:v r:abstr der:s0" sem2="pt:set t:space hi:class t:org der:v t:stuff sc:hum pt:part r:concr"/>Соединение</w> <b/><w><ana lex="7" gr="NUM,ciph"/>7</w><b/><w>к</w><b/> <w><ana lex="быть" gr="V,act,indic,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="выделять" gr="V,brev,n,norm,partcp,pass,pf,praet,sg" sem="der:v d:pref"/>выделено</w> <w><ana lex="из" gr="PR,norm"/>из</w> <w><ana lex="маточный" gr="A,gen,m,norm,plen,sg" sem="r:rel der:s"/>маточного</w> <w><ana lex="раствор" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:abstr t:liq der:v t:space r:concr" sem2="der:v t:space r:concr t:stuff"/>раствора</w> <w><ana lex="после" gr="PR,norm"/>после</w> <w><ana lex="упаривание" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr"/>упаривания</w> <w><ana lex="и" gr="CONJ,norm"/>и</w> <w><ana lex="перекристаллизация" gr="S,f,gen,inan,norm,sg" sem="der:v r:abstr"/>перекристаллизации</w> <w><ana lex="из" gr="PR,norm"/>из</w> <w><ana lex="смесь" gr="S,f,inan,loc,norm,sg" sem="pt:set sc:x r:concr hi:class" sem2="t:stuff r:concr"/>смеси</w> <w><ana lex="этилацетат" gr="S,inan,m,nom,norm,sg"/>этилацетат</w>/<w><ana lex="гексан" gr="S,inan,m,nom,norm,sg"/>гексан</w> (<w><ana lex="2" gr="NUM,ciph"/>2</w>: <w><ana lex="1" gr="NUM,ciph"/>1</w> <w><ana lex="по" gr="PR,norm"/>по</w> <w><ana lex="объем" gr="S,dat,inan,m,norm,sg" sem="r:abstr t:param" sem2="r:abstr"/>объему</w>).</se></p>
