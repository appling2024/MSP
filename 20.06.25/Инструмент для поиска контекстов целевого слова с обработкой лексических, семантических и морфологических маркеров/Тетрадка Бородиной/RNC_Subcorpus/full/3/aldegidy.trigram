t,indic,ipf,norm,praes,sg" sem="ca:noncaus d:root t:poss" sem2="d:root"/>имеет</w> <w><ana lex="особый" gr="A,acc,n,norm,plen,sg" sem="r:rel"/>особое</w> <w><ana lex="значение" gr="S,acc,inan,n,norm,sg" sem="r:abstr" sem2="r:abstr"/>значение</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="медицинский" gr="A,f,gen,norm,plen,sg" sem="r:rel der:s"/>медицинской</w> <w><ana lex="химия" gr="S,f,gen,inan,norm,sg" sem="r:abstr" sem2="pt:aggr r:concr r:abstr hi:class"/>химии</w> <w><ana lex="для" gr="PR,norm"/>для</w> <w><ana lex="создание" gr="S,gen,n,norm,sg" sem="der:v r:abstr der:s0 t:impact:creat" sem2="t:text t:hum:supernat t:workdram t:workmus t:workart der:v t:workcin r:concr"/><ana lex="создание" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0 t:impact:creat" sem2="t:text t:hum:supernat t:workdram t:workmus t:workart der:v t:workcin r:concr"/><ana lex="создание" gr="S,anim,gen,n,norm,sg"/>создания</w> <w><ana lex="соединение" gr="S,gen,inan,n,norm,pl" sem="pt:set der:v r:abstr der:s0" sem2="pt:set t:space hi:class t:org der:v t:stuff sc:hum pt:part r:concr"/>соединений</w> <w><ana lex="с" gr="PR,norm"/>с</w> <w><ana lex="потенциальный" gr="A,ins,norm,pl,plen" sem="r:rel der:s" sem2="r:rel"/>потенциальными</w> <w><ana lex="свойство" gr="S,inan,ins,n,norm,pl" sem="r:abstr t:inter"/>свойствами</w> <w><ana lex="нейропротектор" gr="S,bastard,gen,inan,m,pl"/>нейропротекторов</w>.</se><se> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>Так</w>, <w><ana lex="согласно" gr="PR,norm"/>согласно</w> <w><ana lex="современный" gr="A,dat,norm,pl,plen" sem="r:rel der:s t:time" sem2="r:rel der:s t:time"/>современным</w> <w><ana lex="представление" gr="S,dat,inan,n,norm,pl" sem="t:ment der:v r:abstr der:s0" sem2="t:speech t:ment r:abstr"/>представлениям</w> <w><ana lex="о" gr="PR,norm"/>о</w> <w><ana lex="патогенез" gr="S,inan,loc,m,norm,sg" sem="r:abstr"/>патогенезе</w> <w><ana lex="один" gr="APRO,gen,m,norm,sg" sem2="r:indet"/>одного</w> <w><ana lex="из" gr="PR,norm"/>из</w> <w><ana lex="важный" gr="A,gen,norm,pl,supr" sem="t:hier r:qual" sem2="t:quality ev:posit t:hier r:qual"/>важнейших</w> <w><ana lex="нейродегенеративный" gr="A,bastard,gen,pl,plen"/><ana lex="нейродегенеративный" gr="A,bastard,gen,pl,plen"/>нейродегенеративных</w> <w><ana lex="заболевание" gr="S,gen,inan,n,norm,pl" sem="der:v r:abstr pt:class t:disease" sem2="der:v pc:disease pt:qtm r:abstr"/>заболеваний</w> -- <w><ana lex="болезнь" gr="S,f,gen,inan,norm,sg" sem="r:abstr pt:class t:disease"/>болезни</w> <w><ana lex="альцгеймер" gr="S,anim,bastard,gen,m,sg" sem="t:hum r:propn t:famn"/>Альцгеймера</w> -- <w><ana lex="ключевой" gr="A,ins,n,norm,plen,sg" sem="dt:space r:rel der:s dt:tool" sem2="der:shift t:hier"/>ключевым</w> <w><ana lex="звено" gr="S,inan,ins,n,norm,sg" sem="r:concr pc:tool pt:part" sem2="sc:thing pc:org pt:set t:group pc:constr pc:x pt:part pc:group sc:hum r:concr"/>звеном</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="развитие" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr der:s0" sem2="t:humq r:abstr"/>развитии</w> <w><ana lex="этот" gr="APRO,gen,n,norm,sg" sem="r:dem"/>этого</w> <w><ana lex="заболевание" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr pt:class t:disease" sem2="der:v pc:disease pt:qtm r:abstr"/>заболевания</w> <w><ana lex="являть" gr="V,3p,indic,ipf,norm,pass,praes,sg" sem="der:v d:root"/><ana lex="являться" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="der:v ca:noncaus" sem2="der:v ca:noncaus"/>является</w> <w><ana lex="образование" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr der:s0 t:be:appear" sem2="t:spot der:v r:concr r:abstr"/>образование</w> <w><ana lex="патологический" gr="A,f,gen,norm,plen,sg" sem="r:rel der:s ev:neg" sem2="t:degr ev:neg r:qual"/>патологической</w> <w><ana lex="бета" gr="S,f,inan,nom,norm,sg" sem="t:letter r:concr"/>бета</w>-<w><ana lex="форма" gr="S,f,inan,nom,norm,pl" sem="r:abstr" sem2="t:tool sc:partb t:form r:abstr sc:tool:cloth pt:aggr:aggrpl pt:aggr r:co