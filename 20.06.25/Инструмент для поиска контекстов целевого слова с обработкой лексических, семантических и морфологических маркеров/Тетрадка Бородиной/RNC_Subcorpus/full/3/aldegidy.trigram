<p><se><w><ana lex="изучать" gr="V,act,ger,ipf,norm,praes" sem="der:v d:pref"/>Изучая</w> <w><ana lex="длина" gr="S,f,gen,inan,norm,sg" sem="r:abstr t:param"/>длины</w> <w><ana lex="связь" gr="S,f,gen,inan,norm,pl" sem="r:abstr t:inter" sem2="sc:org pt:set r:abstr sc:thing t:inter der:v pt:aggr pc:constr pt:part r:concr"/>связей</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="получать" gr="V,loc,m,norm,partcp,pass,pf,plen,praet,sg" sem="der:v d:pref"/>полученном</w> <w><ana lex="комплекс" gr="S,inan,loc,m,norm,sg" sem="pt:set r:abstr" sem2="sc:org sc:x hi:class pt:set sc:constr:build r:concr"/>комплексе</w> (<w><ana lex="рис" gr="S,inan,m,nom,norm,sg" sem="t:food pt:aggr r:concr sc:fruit t:fruit" sem2="t:plant sc:plant r:concr pt:aggr"/>рис</w>.</se><se><w><ana lex="5" gr="NUM,ciph"/>5</w>) <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers"/><ana lex="мы" gr="SPRO,1p,anim,nom,norm,pl" sem="r:pers"/>мы</w> <w><ana lex="обнаруживать" gr="V,act,indic,norm,pf,pl,praet" sem="der:v d:pref d:impf"/>обнаружили</w>, <w><ana lex="что" gr="SPRO,n,nom,norm,sg" sem="r:rel"/><ana lex="что" gr="SPRO,inan,n,nom,norm,sg" sem="r:rel"/>что</w> <w><ana lex="наиболее" gr="ADV,norm" sem="t:degr:max der:adv"/>наиболее</w> <w><ana lex="сильный" gr="A,n,nom,norm,plen,sg" sem="t:physq d:habit r:qual" sem2="ev:posit t:humq:char der:s t:degr:max r:qual r:rel"/>сильное</w> <w><ana lex="взаимодействие" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr t:inter" sem2="der:v r:abstr t:inter"/>взаимодействие</w> <w><ana lex="каждый" gr="APRO,acc,inan,m,norm,sg" sem="r:spec"/>каждый</w> <w><ana lex="атом" gr="S,acc,inan,m,norm,sg" sem="pt:element pc:stuff r:concr"/>атом</w> <w><ana lex="никель" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr"/>никеля</w> <w><ana lex="иметь" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="ca:noncaus d:root t:poss" sem2="d:root"/>имеет</w> <w><ana lex="с" gr="PR,norm"/>с</w> <w><ana lex="атом" gr="S,inan,ins,m,norm,sg" sem="pt:element pc:stuff r:concr"/>атомом</w> <w><an