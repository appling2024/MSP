<p><se><w><ana lex="мы" gr="SPRO,1p,ins,norm,pl" sem="r:pers"/><ana lex="мы" gr="SPRO,1p,anim,ins,norm,pl" sem="r:pers"/>Нами</w> <w><ana lex="также" gr="PART,norm"/>также</w> <w><ana lex="быть" gr="V,act,indic,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>было</w> <w><ana lex="показывать" gr="V,brev,n,norm,partcp,pass,pf,praet,sg" sem="der:v d:pref d:impf"/>показано</w>, <w><ana lex="что" gr="CONJ,norm"/>что</w> <w><ana lex="во" gr="PR,norm"/>во</w> <w><ana lex="весь" gr="APRO,gen,norm,pl" sem="r:spec"/>всех</w> <w><ana lex="перечислять" gr="V,gen,norm,partcp,pass,pf,pl,plen,praet" sem="der:v d:pref"/>перечисленных</w> <w><ana lex="высоко" gr="ADV,comp,norm" sem="t:place dt:size:max der:a" sem2="dt:size:max t:dir der:a"/><ana lex="выше" gr="ADV,norm" sem="t:dir der:adv" sem2="t:place"/>выше</w> <w><ana lex="растворитель" gr="S,inan,loc,m,norm,pl" sem="der:v t:stuff r:concr hi:class"/>растворителях</w> <w><ana lex="при" gr="PR,norm"/>при</w> <w><ana lex="взаимодействие" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr t:inter" sem2="der:v r:abstr t:inter"/>взаимодействии</w> <w><ana lex="аммиак" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr"/>аммиака</w> <w><ana lex="с" gr="PR,norm"/>с</w> <w><ana lex="ароматический" gr="A,ins,norm,pl,plen" sem="dt:stuff r:rel der:s"/>ароматическими</w> <w><ana lex="альдегид" gr="S,inan,ins,m,norm,pl" sem="t:stuff r:concr"/>альдегидами</w>, <w><ana lex="содержать" gr="V,act,ins,ipf,norm,partcp,pl,plen,praes" sem="ca:caus d:pref t:poss" sem2="d:pref"/>содержащими</w> <w><ana lex="донорный" gr="A,nom,norm,pl,plen" sem="r:rel der:s"/>донорные</w> <w><ana lex="заместитель" gr="S,anim,m,nom,norm,pl" sem="der:v t:hum r:concr d:nag" sem2="der:v t:hum r:concr d:nag"/>заместители</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="кольцо" gr="S,inan,loc,n,norm,sg" sem="t:tool top:form r:concr top:ring" sem2="t:access t:put r:concr t:form r:abstr pc:hum pt:addit"/>кольце</w>, <w><ana lex="быть" gr="V,act,indi