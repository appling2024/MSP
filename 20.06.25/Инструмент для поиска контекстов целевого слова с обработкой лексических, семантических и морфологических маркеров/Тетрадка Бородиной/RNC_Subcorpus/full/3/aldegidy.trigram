<p><se><w><ana lex="такой" gr="APRO,ins,m,norm,sg" sem="r:dem" sem2="r:indet r:spec t:degr:max"/>Таким</w> <w><ana lex="образ" gr="S,inan,ins,m,norm,sg" sem="t:ment r:concr r:abstr t:workart" sem2="t:asp r:abstr"/><ana lex="образ" gr="S,inan,ins,m,norm,sg" sem="t:ment r:concr r:abstr t:workart" sem2="t:asp r:abstr"/><ana lex="образ" gr="S,inan,ins,m,norm,sg" sem="t:ment r:concr r:abstr t:workart" sem2="t:asp r:abstr"/>образом</w>, <w><ana lex="сравнивать" gr="V,act,ger,ipf,norm,praes" sem="der:v d:pref d:impf"/><ana lex="сравнивать" gr="V,act,ger,ipf,norm,praes" sem="der:v d:pref d:impf"/><ana lex="сравнивать" gr="V,act,ger,ipf,norm,praes" sem="der:v d:pref d:impf"/>сравнивая</w> <w><ana lex="реакция" gr="S,f,gen,inan,norm,sg" sem="der:v r:abstr der:s0" sem2="t:changest t:physiol r:abstr"/>реакции</w> <w><ana lex="образование" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0 t:be:appear" sem2="t:spot der:v r:concr r:abstr"/>образования</w> <w><ana lex="имидазол" gr="S,bastard,gen,inan,m,pl" sem="t:stuff r:concr"/>имидазолов</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="расплав" gr="S,inan,loc,m,norm,sg" sem="t:impact der:v r:abstr der:s0" sem2="der:v t:stuff r:concr"/>расплаве</w> <w><ana lex="соединение" gr="S,gen,inan,n,norm,sg" sem="pt:set der:v r:abstr der:s0" sem2="pt:set t:space hi:class t:org der:v t:stuff sc:hum pt:part r:concr"/>соединения</w> <b/><w><ana lex="4" gr="NUM,ciph"/>4</w><b/> <w><ana lex="или" gr="CONJ,norm"/>или</w> <b/><w><ana lex="7" gr="NUM,ciph"/>7</w><b/> <w><ana lex="при" gr="PR,norm"/>при</w> <w><ana lex="нагревание" gr="S,inan,loc,n,norm,sg" sem="der:v t:changest r:abstr"/>нагревании</w> <w><ana lex="и" gr="CONJ,norm"/>и</w> <w><ana lex="под" gr="PR,norm"/>под</w> <w><ana lex="действие" gr="S,inan,ins,n,norm,sg" sem="r:abstr" sem2="t:text r:abstr der:v pt:part pc:text r:concr"/>действием</w> <w><ana lex="микроволновый" gr="A,gen,n,norm,plen,sg" sem="der:comp r:rel"/>микроволнового</w> <w><ana lex="излучение" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr"/>излучения</w>, <w>можно</w> <w><ana lex="сделать" gr="V,act,inf,norm,pf" sem="d:pref"/>сделать</w> <w><ana lex="вывод" gr="S,acc,inan,m,norm,sg" sem="t:ment der:v r:abstr der:s0" sem2="t:ment t:tool r:abstr pc:tool:device der:v pt:part r:concr"/>вывод</w>, <w><ana lex="что" gr="CONJ,norm"/>что</w> <w><ana lex="микроволновый" gr="A,f,nom,norm,plen,sg" sem="der:comp r:rel"/>микроволновая</w> <w><ana lex="компонента" gr="S,f,inan,nom,norm,sg"/>компонента</w> <w><ana lex="играть" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="d:root" sem2="d:root"/>играет</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="данный" gr="APRO,loc,m,norm,sg" sem="r:dem"/>данном</w> <w><ana lex="случай" gr="S,inan,loc,m,norm,sg" sem="pt:qtm r:abstr" sem2="t:time:moment r:abstr"/>случае</w> <w><ana lex="существенный" gr="A,acc,f,norm,plen,sg" sem="ev r:rel"/>существенную</w> <w><ana lex="роль" gr="S,acc,f,inan,norm,sg" sem="r:abstr" sem2="der:shift r:concr t:text r:abstr"/>роль</w>, <w><ana lex="поскольку" gr="CONJ,norm"/>поскольку</w> <w><ana lex="позволять" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="der:v d:pref"/>позволяет</w> <w><ana lex="значительно" gr="ADV,norm" sem="dt:size:max t:degr:max der:a" sem2="dt:size:max der:a"/>значительно</w> <w><ana lex="сокращать" gr="V,act,inf,norm,pf" sem="d:pref der:a"/>сократить</w> <w><ana lex="время" gr="S,acc,inan,n,norm,sg" sem="r:abstr t:param t:time" sem2="t:time:period r:abstr t:time"/>время</w> <w><ana lex="протекание" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr"/>протекания</w> <w><ana lex="данный" gr="APRO,f,gen,norm,sg" sem="r:dem"/>данной</w> <w><ana lex="реакция" gr="S,f,gen,inan,norm,sg" sem="der:v r:abstr der:s0" sem2="t:changest t:physiol r:abstr"/>реакции</w>.</se></p>

<p class="h2"><se><w><ana lex="6" gr="NUM,ciph"/>6</w>. <w><ana lex="раскрытие" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr"/>Раскрытие</w> <w><ana lex="имидазолиновый" gr="A,bastard,gen,m,plen,sg" sem="dt:stuff r:rel der:s"/><ana lex="имидазолиновой" gr="A,bastard,gen,m,plen,sg"/>имидазолинового</w> <w><ana lex="цикл" gr="S,gen,inan,m,norm,sg" sem="r:abstr" sem2="sc:workart t:text r:abstr pt:set pt:aggr t:work r:concr sc:text"/>цикла</w> <w><ana lex="под" gr="PR,norm"/>под</w> <w><ana lex="действие" gr="S,inan,ins,n,norm,sg" sem="r:abstr" sem2="t:text r:abstr der:v pt:part pc:text r:concr"/>действием</w> <w><ana lex="альдегид" gr="S,gen,inan,m,norm,pl" sem="t:stuff r:concr"/>альдегидов</w></se></p>

<p><se><w><ana lex="ранее" gr="ADV,norm" sem="der:adv t:time"/>Ранее</w> <w><ana lex="изучать" gr="V,act,ger,ipf,norm,praes" sem="der:v d:pref"/>изучая</w> <w><ana lex="реакция" gr="S,acc,f,inan,norm,sg" sem="der:v r:abstr der:s0" sem2="t:changest t:physiol r:abstr"/>реакцию</w> <w><ana lex="ароматический" gr="A,gen,norm,pl,plen" sem="dt:stuff r:rel der:s"/>ароматических</w> <w><ana lex="альдегид" gr="S,gen,inan,m,norm,pl" sem="t:stuff r:concr"/>альдегидов</w> <w><ana lex="с" gr="PR,norm"/>с</w> <w><ana lex="ацетат" gr="S,inan,ins,m,norm,sg" sem="t:stuff r:concr hi:class"/>ацетатом</w> <w><ana lex="аммоний" gr="S,anim,gen,m,norm,persn,sg"/><ana lex="аммоний" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr"/>аммония</w>, <w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers"/><ana lex="мы" gr="SPRO,1p,anim,nom,norm,pl" sem="r:pers"/>мы</w> <w><ana lex="предполагать" gr="V,act,indic,norm,pf,pl,praet" sem="t:ment ca:noncaus der:v d:pref" sem2="t:ment ca:noncaus der:v d:pref"/>предположили</w>, <w><ana lex="что" gr="CONJ,norm"/>что</w> <w><ana lex="процесс" gr="S,inan,m,nom,norm,sg" sem="r:abstr" sem2="t:manif:disease r:abstr"/>процесс</w> <w><ana lex="проходить" gr="V,3p,act,fut,indic,norm,pf,sg" sem="der:v ca:noncaus t:move d:pref"/><ana lex="проходить" gr="V,3p,act,fut,indic,norm,pf,sg" sem="der:v ca:noncaus t:move d:pref"/><ana lex="проходить" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="der:v ca:noncaus t:move d:pref"/><ana lex="проходить" gr="V,3p,act,fut,indic,norm,pf,sg" sem="der:v ca:noncaus t:move d:pref"/><ana lex="проходить" gr="V,3p,act,fut,indic,norm,pf,sg" sem="der:v ca:noncaus t:move d:pref"/>проходит</w> <w><ana lex="через" gr="PR,norm"/>через</w> <w><ana lex="стадия" gr="S,acc,f,inan,norm,sg" sem="r:abstr"/>стадию</w> <w><ana lex="образование" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0 t:be:appear" sem2="t:spot der:v r:concr r:abstr"/>образования</w> <w><ana lex="имидазолин" gr="S,bastard,gen,inan,m,sg"/>имидазолина</w> <b/><w><ana lex="7" gr="NUM,ciph"/>7</w><b/>, <w><ana lex="который" gr="APRO,m,nom,norm,sg" sem="r:rel t:ord"/>который</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="расплав" gr="S,inan,loc,m,norm,sg" sem="t:impact der:v r:abstr der:s0" sem2="der:v t:stuff r:concr"/>расплаве</w> <w><ana lex="ацетат" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr hi:class"/>ацетата</w> <w><ana lex="аммоний" gr="S,anim,gen,m,norm,persn,sg"/><ana lex="аммоний" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr"/>аммония</w> <w><ana lex="раскрывать" gr="V,3p,indic,ipf,norm,pass,praes,sg" sem="der:v d:pref d:impf"/><ana lex="раскрываться" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="d:pref"/>раскрывается</w> <w><ana lex="избыток" gr="S,inan,ins,m,norm,sg" sem="pt:qtm pt:overpart r:concr pc:x" sem2="t:quant:max r:abstr"/>избытком</w> <w><ana lex="альдегид" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr"/>альдегида</w>, <w><ana lex="приводить" gr="V,act,ger,ipf,norm,praes" sem="aux:caus ca:caus t:move d:pref"/>приводя</w> <w><ana lex="к" gr="PR,norm"/>к</w> <w><ana lex="соединение" gr="S,dat,inan,n,norm,sg" sem="pt:set der:v r:abstr der:s0" sem2="pt:set t:space hi:class t:org der:v t:stuff sc:hum pt:part r:concr"/>соединению</w> <b/><w>II</w><b> </b> (<w><ana lex="схема" gr="S,f,inan,nom,norm,sg" sem="pt:aggr r:abstr" sem2="t:ment t:pattern r:concr r:abstr t:text"/>схема</w> <w><ana lex="13" gr="NUM,ciph"/>13</w>): </se></p>
<p><se><w><ana lex="мы" gr="SPRO,1p,nom,norm,pl" sem="r:pers"/><ana lex="мы" gr="SPRO,1p,anim,nom,norm,pl" sem="r:pers"/>Мы</w> <w><ana lex="проводить" gr="V,act,indic,norm,pf,pl,praet" sem="ca:caus t:move d:pref" sem2="d:pref"/><ana lex="проводить" gr="V,act,indic,norm,pf,pl,praet" sem="ca:caus t:move d:pref" sem2="d:pref"/>провели</w> <w><ana lex="исследование" gr="S,acc,inan,n,norm,sg" sem="t:ment der:v r:abstr"/>исследование</w> <w><ana lex="раскрытие" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr"/>раскрытия</w> <w><ana lex="цикл" gr="S,gen,inan,m,norm,sg" sem="r:abstr" sem2="sc:workart t:text r:abstr pt:set pt:aggr t:work r:concr sc:text"/>цикла</w> <b/><w><ana lex="7" gr="NUM,ciph"/>7</w><b> </b><w><ana lex="под" gr="PR,norm"/>под</w> <w><ana lex="действие" gr="S,inan,ins,n,norm,sg" sem="r:abstr" sem2="t:text r:abstr der:v pt:part pc:text r:concr"/>действием</w> <w><ana lex="некоторый" gr="APRO,gen,norm,pl" sem="r:indet"/>некоторых</w> <w><ana lex="альдегид" gr="S,gen,inan,m,norm,pl" sem="t:stuff r:concr"/>альдегидов</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="различный" gr="A,loc,norm,pl,plen" sem="r:qual"/>различных</w> <w><ana lex="условие" gr="S,inan,loc,n,norm,pl" sem="r:abstr" sem2="r:abstr"/>условиях</w>.</se><se> <w><ana lex="быть" gr="V,act,indic,ipf,n,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>Было</w> <w><ana lex="находить" gr="V,brev,n,norm,partcp,pass,pf,praet,sg" sem="der:v d:pref" sem2="der:v ca:noncaus t:move d:pref"/>найдено</w>, <w><ana lex="что" gr="CONJ,norm"/>что</w> <w><ana lex="при" gr="PR,norm"/>при</w> <w><ana lex="проведение" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr"/>проведении</w> <w><ana lex="реакция" gr="S,f,gen,inan,norm,sg" sem="der:v r:abstr der:s0" sem2="t:changest t:physiol r:abstr"/>реакции</w> <w><ana lex="имидазолин" gr="S,bastard,gen,inan,m,sg"/>имидазолина</w> <b/><w><ana lex="7" gr="NUM,ciph"/>7</w><b/><w><ana lex="а" gr="CONJ,norm"/>а</w><b/> <w><ana lex="и" gr="CONJ,norm"/>и</w> <w><ana lex="альдегид" gr="S,gen,inan,m,norm,pl" sem="t:stuff r:concr"/>альдегидов</w> <b/><w><ana lex="1" gr="NUM,ciph"/>1</w><b/><w><ana lex="а" gr="CONJ,norm"/>а</w><b>-</b><w><ana lex="и" gr="CONJ,norm"/>и</w><b/> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="расплав" gr="S,inan,loc,m,norm,sg" sem="t:impact der:v r:abstr der:s0" sem2="der:v t:stuff r:concr"/>расплаве</w> <w><ana lex="ацетат" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr hi:class"/>ацетата</w> <w><ana lex="аммоний" gr="S,anim,gen,m,norm,persn,sg"/><ana lex="аммоний" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr"/>аммония</w> <w><ana lex="образовываться" gr="V,3p,act,fut,indic,norm,pf,pl" sem="der:v d:pref d:impf"/><ana lex="образовывать" gr="V,3p,indic,ipf,norm,pass,pl,praes" sem="der:v d:pref d:impf"/>образуются</w> <w><ana lex="соответствующий" gr="A,nom,norm,pl,plen" sem="der:v r:rel"/>соответствующие</w> <w><ana lex="соединение" gr="S,inan,n,nom,norm,pl" sem="pt:set der:v r:abstr der:s0" sem2="pt:set t:space hi:class t:org der:v t:stuff sc:hum pt:part r:concr"/>соединения</w> <b/><w>II</w><b/>, <w><ana lex="однако" gr="CONJ,norm"/><ana lex="однако" gr="CONJ,norm"/>однако</w> <w><ana lex="выход" gr="S,inan,m,nom,norm,pl" sem="der:v t:move r:abstr der:s0" sem2="t:quant ev:posit t:space r:abstr der:v pc:constr pt:part r:concr"/>выходы</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="ряд" gr="S,inan,loc,m,norm,sg" sem="pt:set sc:x r:concr r:abstr" sem2="sc:x sc:hum t:form r:abstr pt:set pt:aggr sc:constr r:concr"/>ряде</w> <w><ana lex="случай" gr="S,gen,inan,m,norm,pl" sem="pt:qtm r:abstr" sem2="t:time:moment r:abstr"/>случаев</w> <w><ana lex="быть" gr="V,act,indic,ipf,norm,pl,praet" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>были</w> <w><ana lex="невысокий" gr="A,brev,norm,pl" sem="d:neg t:size der:a dt:size:max r:qual"/>невысоки</w>.</se><se> <w><ana lex="причина" gr="S,f,inan,nom,norm,sg" sem="r:abstr"/>Причина</w> <w><ana lex="этот" gr="APRO,gen,m,norm,sg" sem="r:dem"/>этого</w> <w><ana lex="заключать" gr="V,3p,indic,ipf,norm,pass,praes,sg" sem="der:v d:pref"/><ana lex="заключаться" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="ca:noncaus d:pref" sem2="ca:noncaus d:pref"/>заключается</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="частичный" gr="A,loc,n,norm,plen,sg" sem="r:rel der:s"/>частичном</w> <w><ana lex="взаимодействие" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr t:inter" sem2="der:v r:abstr t:inter"/>взаимодействии</w> <w><ana lex="альдегид" gr="S,gen,inan,m,norm,pl" sem="t:stuff r:concr"/>альдегидов</w> <w><ana lex="с" gr="PR,norm"/>с</w> <w><ana lex="ацетат" gr="S,inan,ins,m,norm,sg" sem="t:stuff r:concr hi:class"/>ацетатом</w> <w><ana lex="аммоний" gr="S,anim,gen,m,norm,persn,sg"/><ana lex="аммоний" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr"/>аммония</w>, <w><ana lex="приводить" gr="V,act,ipf,loc,m,norm,partcp,plen,praes,sg" sem="aux:caus ca:caus t:move d:pref"/>приводящем</w> <w><ana lex="к" gr="PR,norm"/>к</w> <w><ana lex="побочный" gr="A,dat,norm,pl,plen" sem="r:rel" sem2="r:rel"/>побочным</w> <w><ana lex="продукт" gr="S,dat,inan,m,norm,pl" sem="t:thing r:concr" sem2="t:food hi:class sc:food r:abstr pt:aggr:aggrpl r:concr"/>продуктам</w>, <w><ana lex="который" gr="APRO,nom,norm,pl" sem="r:rel t:ord"/>которые</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max"/>очень</w> <w>трудно</w> <w><ana lex="отделять" gr="V,act,inf,norm,pf" sem="der:v d:pref" sem2="der:v d:pref"/>отделить</w> <w><ana lex="от" gr="PR,norm"/>от</w> <w><ana lex="целевой" gr="A,gen,norm,pl,plen" sem="dt:abstr r:rel der:s" sem2="dt:abstr r:rel der:s t:dir"/>целевых</w> <w><ana lex="соединение" gr="S,gen,inan,n,norm,pl" sem="pt:set der:v r:abstr der:s0" sem2="pt:set t:space hi:class t:org der:v t:stuff sc:hum pt:part r:concr"/>соединений</w> <b/><w>II</w><b/> (<w><ana lex="таблица" gr="S,f,inan,nom,norm,sg" sem="r:concr t:text"/>таблица</w> <w><ana lex="10" gr="NUM,ciph"/>10</w>).</se><se> <w><ana lex="быть" gr="V,act,indic,ipf,