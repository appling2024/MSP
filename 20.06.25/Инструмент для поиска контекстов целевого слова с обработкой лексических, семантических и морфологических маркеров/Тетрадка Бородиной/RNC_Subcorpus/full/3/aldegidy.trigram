<p><se><w><ana lex="ar" gr="bastard"/>Ar</w>= <b/><w><ana lex="a" gr="bastard"/>a</w><b/> -- <w><ana lex="ph" gr="bastard"/>Ph</w>, <b/><w>б</w><b/> -- <w><ana lex="4" gr="NUM,ciph"/>4</w>-<w><ana lex="метоксифенил" gr="S,bastard,inan,m,nom,sg" sem="t:stuff r:concr"/>метоксифенил</w>, <b/><w><ana lex="в" gr="PR,norm"/>в</w><b/>- <w><ana lex="2" gr="NUM,ciph"/>2</w>-<w><ana lex="тиенил" gr="S,bastard,inan,m,nom,sg"/>тиенил</w>, <b/><w><ana lex="ж" gr="PART,norm"/>ж</w><b/> -- <w><ana lex="4" gr="NUM,ciph"/>4</w>-<w><ana lex="бромфенил" gr="S,bastard,inan,m,nom,sg" sem="t:stuff r:concr"/>бромфенил</w>, <b/><w><ana lex="к" gr="PR,norm"/>к</w><b/> -- <w><ana lex="3" gr="NUM,ciph"/>3</w>-<w><ana lex="нитрофенил" gr="S,bastard,inan,m,nom,sg" sem="t:stuff r:concr"/>нитрофенил</w>, <b/><w><ana lex="с" gr="PR,norm"/>с</w><b/>- <w><ana lex="4" gr="NUM,ciph"/>4</w>-<w><ana lex="фторфенил" gr="S,bastard,inan,m,nom,sg"/>фторфенил</w></se></p>
<p><se><w><ana lex="более" gr="ADV,norm" sem="t:degr:max der:adv" sem2="t:degr:max"/>Более</w> <w><ana lex="высокий" gr="A,nom,norm,pl,plen" sem="t:size:max r:qual" sem2="ev:posit der:shift t:size:max t:sound t:degr:max r:qual t:interpretation"/>высокие</w> <w><ana lex="выход" gr="S,inan,m,nom,norm,pl" sem="der:v t:move r:abstr der:s0" sem2="t:quant ev:posit t:space r:abstr der:v pc:constr pt:part r:concr"/>выходы</w> <w><ana lex="объяснять" gr="V,3p,indic,ipf,norm,pass,pl,praes" sem="d:pref der:a"/><ana lex="объясняться" gr="V,3p,act,indic,ipf,norm,pl,praes" sem="der:v ca:noncaus d:pref" sem2="t:speech ca:noncaus der:v d:pref"/>объясняются</w> <w><ana lex="то" gr="SPRO,inan,ins,n,norm,sg" sem="r:dem"/>тем</w>, <w><ana lex="что" gr="CONJ,norm"/>что</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="ход" gr="S,inan,loc,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="t:space t:tool:device r:abstr pc:tool:device der:v pc:tool:transp t:move pt:part r:concr"/><ana lex="ход" gr="S,inan,loc,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="t:space t:tool:device r:abstr pc:tool:device der:v pc:tool:transp t:move pt:part r:concr"/><ana lex="ход" gr="S,inan,loc,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="t:space t:tool:device r:abstr pc:tool:device der:v pc:tool:transp t:move pt:part r:concr"/><ana lex="ходя" gr="S,anim,loc,m,norm,sg"/><ana lex="ход" gr="S,inan,loc,m,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="t:space t:tool:device r:abstr pc:tool:device der:v pc:tool:transp t:move pt:part r:concr"/>ходе</w> <w><ana lex="циклизация" gr="S,f,gen,inan,norm,sg" sem="r:abstr"/>циклизации</w> <w><ana lex="соединение" gr="S,gen,inan,n,norm,pl" sem="pt:set der:v r:abstr der:s0" sem2="pt:set t:space hi:class t:org der:v t:stuff sc:hum pt:part r:concr"/>соединений</w> <b/><w><ana lex="4" gr="NUM,ciph"/>4</w><b/> <w><ana lex="образовываться" gr="V,3p,act,fut,indic,norm,pf,pl" sem="der:v d:pref d:impf"/><ana lex="образовывать" gr="V,3p,indic,ipf,norm,pass,pl,praes" sem="der:v d:pref d:impf"/>образуются</w> <w><ana lex="побочный" gr="A,nom,norm,pl,plen" sem="r:rel" sem2="r:rel"/>побочные</w> <w><ana lex="продукт" gr="S,inan,m,nom,norm,pl" sem="t:thing r:concr" sem2="t:food hi:class sc:food r:abstr pt:aggr:aggrpl r:concr"/>продукты</w> <w><ana lex="разложение" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr"/>разложения</w>, <w><ana lex="что" gr="SPRO,gen,inan,n,norm,sg" sem="r:rel"/><ana lex="что" gr="SPRO,gen,n,norm,sg" sem="r:rel"/>чего</w> <w>нет</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="случай" gr="S,inan,loc,m,norm,sg" sem="pt:qtm r:abstr" sem2="t:time:moment r:abstr"/>случае</w> <w><ana lex="использование" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr"/>использования</w> <w><ana lex="готовый" gr="A,gen,norm,pl,plen" sem="der:v r:rel"/>готовых</w> <w><ana lex="имидазолин" gr="S,bastard,gen,inan,m,pl"/>имидазолинов</w>.</se><se> <w><ana lex="данный" gr="APRO,n,nom,norm,sg" sem="r:dem"/>Данное</w> <w><ana lex="окисление" gr="S,inan,n,nom,norm,sg" sem="r:abstr"/>окисление</w> <w><ana lex="представлять" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="der:v d:pref" sem2="der:v d:pref"/>представляет</w> <w><ana lex="самостоятельный" gr="A,acc,inan,m,norm,plen,sg" sem="der:comp r:rel" sem2="der:comp t:humq r:rel r:qual"/>самостоятельный</w> <w><ana lex="интерес" gr="S,acc,inan,m,norm,sg" sem="t:ment r:abstr" sem2="r:abstr ev:neg"/>интерес</w>, <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>так</w> <w><ana lex="как" gr="ADVPRO,norm" sem="r:rel t:manner"/>как</w>, <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="частность" gr="S,f,inan,loc,norm,sg" sem="r:abstr der:a" sem2="r:abstr der:a"/>частности</w>, <w><ana lex="позволять" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="der:v d:pref"/>позволяет</w> <w><ana lex="с" gr="PR,norm"/>с</w> <w><ana lex="хороший" gr="A,ins,m,norm,plen,sg" sem="ev:posit t:quality r:qual" sem2="ev:posit ev t:degr:max r:qual"/>хорошим</w> <w><ana lex="выход" gr="S,i