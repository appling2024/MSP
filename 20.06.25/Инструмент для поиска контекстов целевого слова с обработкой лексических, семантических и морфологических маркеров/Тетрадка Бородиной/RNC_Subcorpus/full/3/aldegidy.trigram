lex="в" gr="PR,norm"/>в</w> <w><ana lex="смесь" gr="S,f,gen,inan,norm,sg" sem="pt:set sc:x r:concr hi:class" sem2="t:stuff r:concr"/>смеси</w> <w><ana lex="некоторый" gr="APRO,gen,norm,pl" sem="r:indet"/>некоторых</w> <w><ana lex="продукт" gr="S,gen,inan,m,norm,pl" sem="t:thing r:concr" sem2="t:food hi:class sc:food r:abstr pt:aggr:aggrpl r:concr"/>продуктов</w>.</se><se> <w><ana lex="так" gr="ADVPRO,norm" sem="der:a dt:degr r:dem" sem2="der:apro dt:degr r:dem"/>Так</w>, <w><ana lex="гексагидротриазина" gr="S,anim,bastard,f,gen,persn,sg"/><ana lex="гексагидротриазина" gr="S,bastard,f,gen,inan,sg"/>гексагидротриазины</w> <b/><w><ana lex="3" gr="NUM,ciph"/>3</w><b/><w>л</w><b/> <w><ana lex="и" gr="CONJ,norm"/>и</w> <b/><w><ana lex="3" gr="NUM,ciph"/>3</w><b/><w>п</w><b/>, <w><ana lex="получать" gr="V,nom,norm,partcp,pass,pf,pl,plen,praet" sem="der:v d:pref"/>полученные</w> <w><ana lex="из" gr="PR,norm"/>из</w> <w><ana lex="2" gr="NUM,ciph"/>2</w>-<w><ana lex="нитробензальдегид" gr="S,bastard,gen,inan,m,sg"/>нитробензальдегида</w> <b/><w><ana lex="1" gr="NUM,ciph"/>1</w><b/><w>л</w><b/> <w><ana lex="и" gr="CONJ,norm"/>и</w> <w><ana lex="2,6" gr="NUM,ciph"/>2,6</w>-<w><ana lex="дихлорбензальдегид" gr="S,bastard,gen,inan,m,sg"/>дихлорбензальдегида</w> <b/><w><ana lex="1" gr="NUM,ciph"/>1</w><b/><w>п</w><b/>, <w><ana lex="при" gr="PR,norm"/>при</w> <w><ana lex="попытка" gr="S,f,inan,loc,norm,sg" sem="r:abstr" sem2="r:abstr"/>попытке</w> <w><ana lex="зарегистрировать" gr="V,act,inf,norm,pf" sem="der:v d:pref"/>зарегистрировать</w> <w><ana lex="они" gr="SPRO,acc,anim,norm,pl" sem="r:pers"/>их</w> <w><ana lex="ямр" gr="S,anim,bastard,m,nom,persn,sg"/><ana lex="ямр" gr="S,anim,bastard,m,nom,persn,sg"/>ЯМР</w> <sup><w><ana lex="1" gr="NUM,ciph"/>1</w></sup><w><ana lex="h" gr="bastard"/>H</w> <w><ana lex="спектр" gr="S,inan,m,nom,norm,sg" sem="pt:aggr r:abstr" sem2="t:color pt:aggr r:abstr"/>спектр</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="cdcl" gr="bastard"/>CDCl</w