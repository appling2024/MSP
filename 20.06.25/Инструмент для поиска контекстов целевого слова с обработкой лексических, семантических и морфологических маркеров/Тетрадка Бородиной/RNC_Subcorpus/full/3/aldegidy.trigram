str"/>излучения</w> <w><ana lex="возможный" gr="A,brev,n,norm,sg" sem="t:mod r:qual"/>возможно</w> <w><ana lex="лишь" gr="PART,norm"/>лишь</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="очень" gr="ADV,norm" sem="t:degr:max"/>очень</w> <w><ana lex="жесткий" gr="A,loc,norm,pl,plen" sem="t:physq r:qual" sem2="t:humq t:physq der:shift r:qual t:species r:rel"/>жестких</w> <w><ana lex="условие" gr="S,inan,loc,n,norm,pl" sem="r:abstr" sem2="r:abstr"/>условиях</w> -- <w><ana lex="нагревание" gr="S,inan,n,nom,norm,sg" sem="der:v t:changest r:abstr"/>нагревание</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="расплав" gr="S,inan,loc,m,norm,sg" sem="t:impact der:v r:abstr der:s0" sem2="der:v t:stuff r:concr"/>расплаве</w> [<w><ana lex="39,64" gr="NUM,ciph"/>39,64</w>] <w><ana lex="или" gr="CONJ,norm"/>или</w> <w><ana lex="кипячение" gr="S,inan,n,nom,norm,sg" sem="t:impact der:v r:abstr"/>кипячение</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="дмсо" gr="S,0,anim,bastard,m,persn,sg"/><ana lex="дмсо" gr="S,0,bastard,inan,m,sg" sem="der:abbr t:stuff r:concr t:term"/>ДМСО</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="присутствие" gr="S,inan,loc,n,norm,sg" sem="r:abstr" sem2="der:v t:space r:concr r:abstr t:org"/>присутствии</w> <w><ana lex="основание" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0 t:be:appear" sem2="t:stuff hi:class r:abstr pc:x pt:part r:concr pc:form:geom"/>основания</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="ток" gr="S,inan,loc,m,norm,sg" sem="t:space der:s0 r:abstr der:v t:constr t:move r:concr" sem2="t:move qc:stuff pt:qtm r:abstr der:v t:space r:concr"/><ana lex="ток" gr="S,inan,loc,m,norm,sg" sem="t:space der:s0 r:abstr der:v t:constr t:move r:concr" sem2="t:move qc:stuff pt:qtm r:abstr der:v t:space r:concr"/><ana lex="ток" gr="S,inan,loc,m,norm,sg" sem="t:space der:s0 r:abstr der:v t:constr t:move r:concr" sem2="t:move qc:stuff pt:qtm r:abstr der:v t:space r:concr"/>токе</w> <w><ana lex="кислород" gr="S,gen,inan,m,nor