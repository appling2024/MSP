<p><se><b/><w><ana lex="мезо" gr="S,bastard,inan,n,nom,sg"/>Мезо</w><b>-</b><w><ana lex="1,2" gr="NUM,ciph"/>1,2</w><b>-</b><w><ana lex="дифенилэтан" gr="S,bastard,inan,m,nom,sg"/>дифенилэтан</w><b>-</b><w><ana lex="1,2" gr="NUM,ciph"/>1,2</w><b>-</b><w><ana lex="диамин" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr"/>диамин</w><b> </b> (<b/><w><ana lex="ivа" gr="bastard"/>IVа</w><b/>): <w><ana lex="из" gr="PR,norm"/>из</w> <w><ana lex="1" gr="NUM,ciph"/>1</w> <w>г</w> <b/><w><ana lex="7" gr="NUM,ciph"/>7</w><b/><w>а</w><b/> <w><ana lex="получать" gr="V,brev,n,norm,partcp,pass,pf,praet,sg" sem="der:v d:pref"/>получено</w> <w><ana lex="0.38" gr="NUM,ciph"/>0.38</w> <w>г</w>.</se><se> (<w><ana lex="55" gr="NUM,ciph"/>55</w>%) <w><ana lex="диамин" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr"/>диамина</w> <b/><w><ana lex="ivа" gr="bastard"/>IVа</w><b/> <w>с</w> <w>Т</w> <w>пл</w>.</se><se> <w><ana lex="123" gr="NUM,ciph"/>123</w>°<w><ana lex="c" gr="bastard"/>C</w>. <w><ana lex="спектральный" gr="A,nom,norm,pl,plen" sem="r:rel der:s"/>Спектральные</w> <w><ana lex="данные" gr="S,inan,nom,norm,pl" sem="t:ment der:v pt:aggr:aggr_pl r:abstr" sem2="der:v pt:aggr:aggr_pl t:humq r:abstr"/>данные</w> <w><ana lex="получать" gr="V,gen,n,norm,partcp,pass,pf,plen,praet,sg" sem="der:v d:pref"/>полученного</w> <w><ana lex="соединение" gr="S,gen,inan,n,norm,sg" sem="pt:set der:v r:abstr der:s0" sem2="pt:set t:space hi:class t:org der:v t:stuff sc:hum pt:part r:concr"/>соединения</w> <w><ana lex="полностью" gr="ADV,norm" sem="dt:full t:degr:max der:a"/>полностью</w> <w><ana lex="соответствовать" gr="V,3p,act,indic,ipf,norm,pl,praes" sem="d:pref der:s"/>соответствуют</w> <w><ana lex="приводить" gr="V,dat,norm,partcp,pass,pf,pl,plen,praet" sem="aux:caus ca:caus t:move d:pref"/>приведенным</w> <w><ana lex="высоко" gr="ADV,comp,norm" sem="t:place dt:size:max der:a" sem2="dt:size:max t:dir der:a"/><ana lex="выше" gr="ADV,norm" sem="t:dir der:adv" sem2="t:place"/>выше</w> <w><ana lex="дл