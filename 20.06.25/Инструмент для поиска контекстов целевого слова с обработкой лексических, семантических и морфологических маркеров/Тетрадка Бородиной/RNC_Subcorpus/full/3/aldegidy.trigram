<p><se><w><ana lex="рентгеноструктурный" gr="A,m,nom,norm,plen,sg" sem="der:comp r:rel"/>Рентгеноструктурный</w> <w><ana lex="анализ" gr="S,inan,m,nom,norm,sg" sem="r:abstr" sem2="t:ment r:abstr"/>анализ</w>: <w><ana lex="кристалл" gr="S,inan,m,nom,norm,pl" sem="qc:stuff pt:qtm r:concr"/>кристаллы</w> <w><ana lex="орторомбический" gr="A,nom,norm,pl,plen" sem="der:comp r:rel"/>орторомбические</w>, <w><ana lex="пространство" gr="S,gen,inan,n,norm,pl" sem="t:space r:concr hi:class" sem2="top:gape t:space r:concr r:abstr hi:class"/>пространств</w>. <w><ana lex="группа" gr="S,f,inan,nom,norm,sg" sem="pt:set sc:x r:concr hi:class" sem2="pt:set t:hier r:abstr t:group sc:hum r:concr"/>группа</w> <w><ana lex="p" gr="bastard"/>P</w> <w><ana lex="21" gr="NUM,ciph"/>21</w> <w><ana lex="21" gr="NUM,ciph"/>21</w> <w><ana lex="21" gr="NUM,ciph"/>21</w> (<w><ana lex="no" gr="bastard"/>no</w>.</se><se> <w><ana lex="19" gr="NUM,ciph"/>19</w>), <w><ana lex="параметр" gr="S,inan,m,nom,norm,pl" sem="r:abstr t:param hi:class"/>параметры</w> <w><ana lex="решетка" gr="S,f,gen,inan,norm,sg" sem="t:tool r:concr top:lattice"/>решетки</w> <w><ana lex="a" gr="bastard"/>a</w> = <w><ana lex="16.1421" gr="NUM,ciph"/>16.1421</w> (<w><ana lex="32" gr="NUM,ciph"/>32</w>) <w><ana lex="a" gr="bastard"/>Е</w>, <w><ana lex="b" gr="bastard"/>b</w> = <w><ana lex="16.6461" gr="NUM,ciph"/>16.6461</w> (<w><ana lex="33" gr="NUM,ciph"/>33</w>) <w><ana lex="a" gr="bastard"/>Е</w>, <w><ana lex="c" gr="bastard"/>c</w> = <w><ana lex="25.4162" gr="NUM,ciph"/>25.4162</w> (<w><ana lex="51" gr="NUM,ciph"/>51</w>) <w>Е</w>, <w><ana lex="объем" gr="S,inan,m,nom,norm,sg" sem="r:abstr t:param" sem2="r:abstr"/>объем</w> <w><ana lex="ячейка" gr="S,f,gen,inan,norm,sg" sem="t:space top:contain top:pit der:s d:dim pt:element r:concr pc:tool" sem2="pt:set t:space pt:element t:org t:group der:shift pc:constr sc:hum pt:part der:s d:dim r:concr top:niche"/>ячейки</w> <w><ana lex="6829,41" gr="NUM,ciph"/>6829,41</w> (<w><ana lex="23