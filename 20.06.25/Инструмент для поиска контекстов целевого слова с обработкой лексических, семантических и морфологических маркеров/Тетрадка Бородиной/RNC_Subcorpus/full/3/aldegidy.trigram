<p><se><w><ana lex="рис" gr="S,inan,m,nom,norm,sg" sem="t:food pt:aggr r:concr sc:fruit t:fruit" sem2="t:plant sc:plant r:concr pt:aggr"/>Рис</w>.</se><se> <w><ana lex="3" gr="NUM,ciph"/>3</w> <w><ana lex="рентгеноструктурный" gr="A,m,nom,norm,plen,sg" sem="der:comp r:rel"/>Рентгеноструктурный</w> <w><ana lex="анализ" gr="S,inan,m,nom,norm,sg" sem="r:abstr" sem2="t:ment r:abstr"/>анализ</w> <w><ana lex="соединение" gr="S,inan,n,nom,norm,pl" sem="pt:set der:v r:abstr der:s0" sem2="pt:set t:space hi:class t:org der:v t:stuff sc:hum pt:part r:concr"/>соединения</w> <b/><w><ana lex="8" gr="NUM,ciph"/>8</w><b/><w>д</w><b/></se></p>

<p class="h2"><se><w><ana lex="5" gr="NUM,ciph"/>5</w>. <w><ana lex="циклизация" gr="S,f,inan,nom,norm,sg" sem="r:abstr"/>Циклизация</w> <w><ana lex="1,3,5" gr="NUM,ciph"/>1,3,5</w>-<w><ana lex="триарил" gr="S,bastard,inan,m,nom,sg"/>триарил</w>-<w><ana lex="2,4" gr="NUM,ciph"/>2,4</w>-<w><ana lex="диазапентадиен" gr="S,bastard,gen,inan,m,pl"/>диазапентадиенов</w>-<w><ana lex="1,4" gr="NUM,ciph"/>1,4</w> <w><ana lex="под" gr="PR,norm"/>под</w> <w><ana lex="действие" gr="S,inan,ins,n,norm,sg" sem="r:abstr" sem2="t:text r:abstr der:v pt:part pc:text r:concr"/>действием</w> <w><ana lex="микроволновый" gr="A,gen,n,norm,plen,sg" sem="der:comp r:rel"/>микроволнового</w> <w><ana lex="излучение" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr"/>излучения</w></se></p>

