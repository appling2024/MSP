<p><se><w><ana lex="необычный" gr="A,m,nom,norm,plen,sg" sem="d:neg r:qual"/>Необычный</w> <w><ana lex="результат" gr="S,inan,m,nom,norm,sg" sem="r:abstr" sem2="r:abstr"/>результат</w> <w><ana lex="быть" gr="V,act,indic,ipf,m,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>был</w> <w><ana lex="получать" gr="V,brev,m,norm,partcp,pass,pf,praet,sg" sem="der:v d:pref"/>получен</w> <w><ana lex="при" gr="PR,norm"/>при</w> <w><ana lex="проведение" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr"/>проведении</w> <w><ana lex="реакция" gr="S,f,gen,inan,norm,sg" sem="der:v r:abstr der:s0" sem2="t:changest t:physiol r:abstr"/>реакции</w> <w><ana lex="ацетат" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr hi:class"/>ацетата</w> <w><ana lex="аммоний" gr="S,anim,gen,m,norm,persn,sg"/><ana lex="аммоний" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr"/>аммония</w> <w><ana lex="с" gr="PR,norm"/>с</w> <w><ana lex="4" gr="NUM,ciph"/>4</w>-<w><ana lex="пиридинкарбальдегид" gr="S,bastard,inan,ins,m,sg"/>пиридинкарбальдегидом</w> <b/><w><ana lex="1" gr="NUM,ciph"/>1</w><b/><w><ana lex="м" gr="S,0,inan,m,norm"/>м</w><b/>.</se><se> <w><ana lex="основной" gr="A,ins,m,norm,plen,sg" sem="t:hier r:rel"/><ana lex="основный" gr="A,ins,m,norm,plen,sg" sem="r:rel der:s"/>Основным</w> <w><ana lex="продукт" gr="S,inan,ins,m,norm,sg" sem="t:thing r:concr" sem2="t:food hi:class sc:food r:abstr pt:aggr:aggrpl r:concr"/>продуктом</w> <w><ana lex="реакция" gr="S,f,gen,inan,norm,sg" sem="der:v r:abstr der:s0" sem2="t:changest t:physiol r:abstr"/>реакции</w> <w><ana lex="являть" gr="V,3p,indic,ipf,norm,pass,praes,sg" sem="der:v d:root"/><ana lex="являться" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="der:v ca:noncaus" sem2="der:v ca:noncaus"/>является</w> <w><ana lex="соответствовать" gr="V,act,ipf,m,nom,norm,partcp,plen,praes,sg" sem="d:pref der:s"/>соответствующий</w> <w><ana lex="2,4,5" gr="NUM,ciph"/>2,4,5</w>-<w><ana lex="три" gr="NUM,acc,inan,norm" sem="r:card:pauc"/>три</w> (<w><ana lex="4" gr="NUM,ciph"/>4</w>-<w><ana lex="пиридинил" gr="S,bastard,inan,m,nom,sg"/>пиридинил</w>) <w><ana lex="имидазол" gr="S,bastard,inan,m,nom,sg" sem="t:stuff r:concr"/>имидазол</w> <b/><w><ana lex="14" gr="NUM,ciph"/>14</w><b/><w><ana lex="м" gr="S,0,inan,m,norm"/>м</w><b/>, <w><ana lex="кристаллизовать" gr="V,ipf,m,nom,norm,partcp,pass,plen,praes,sg" sem="t:impact ca:caus"/><ana lex="кристаллизоваться" gr="V,act,ipf,m,nom,norm,partcp,plen,praes,sg" sem="der:v t:changest der:s ca:noncaus" sem2="ca:noncaus"/>кристаллизующийся</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="вид" gr="S,anim,famn,loc,m,norm,sg"/><ana lex="вид" gr="S,inan,loc,m,norm,sg" sem="der:v r:abstr" sem2="t:ment t:space r:abstr t:workart der:v t:perc r:concr t:fam"/><ana lex="вид" gr="S,inan,loc,m,norm,sg" sem="der:v r:abstr" sem2="t:ment t:space r:abstr t:workart der:v t:perc r:concr t:fam"/>виде</w> <w><ana lex="гидрат" gr="S,gen,inan,m,norm,sg"/>гидрата</w>.</se><se> <w><ana lex="его" gr="APRO,0,norm" sem="r:poss"/>Его</w> <w><ana lex="структура" gr="S,f,inan,nom,norm,sg" sem="r:abstr" sem2="r:concr t:org"/>структура</w> <w><ana lex="также" gr="PART,norm"/>также</w> <w><ana lex="быть" gr="V,act,f,indic,ipf,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>была</w> <w><ana lex="подтверждать" gr="V,brev,f,norm,partcp,pass,pf,praet,sg" sem="der:v d:pref"/>подтверждена</w> <w><ana lex="метод" gr="S,inan,ins,m,norm,sg" sem="r:abstr" sem2="r:abstr"/>методом</w> <w><ana lex="рентгеноструктурный" gr="A,gen,m,norm,plen,sg" sem="der:comp r:rel"/>рентгеноструктурного</w> <w><ana lex="анализ" gr="S,gen,inan,m,norm,sg" sem="r:abstr" sem2="t:ment r:abstr"/>анализа</w> (<w><ana lex="рис" gr="S,inan,m,nom,norm,sg" sem="t:food pt:aggr r:concr sc:fruit t:fruit" sem2="t:plant sc:plant r:concr pt:aggr"/>Рис</w>.</se><se><w><ana lex="2" gr="NUM,ciph"/>2</w>).</se> </p>
<p><se><w><ana lex="избранный" gr="A,nom,norm,pl,plen" sem="der:v r:rel" sem2="r:qual"/>Избранные</w> <w><ana lex="длина" gr="S,f,gen,inan,norm,sg" sem="r:abstr t:param"/>длины</w> <w><ana lex="связь" gr="S,f,gen,inan,norm,pl" sem="r:abstr t:inter" sem2="sc:org pt:set r:abstr sc:thing t:inter der:v pt:aggr pc:constr pt:part r:concr"/>связей</w> <w><ana lex="и" gr="CONJ,norm"/>и</w> <w><ana lex="торсионный" gr="A,nom,norm,pl,plen" sem="r:rel der:s"/>торсионные</w> <w><ana lex="угол" gr="S,inan,m,nom,norm,pl" sem="t:form t:space r:concr" sem2="t:space r:concr pc:room pt:part pc:space"/>углы</w>: <w><ana lex="n" gr="bastard"/>N</w><w><ana lex="2" gr="NUM,ciph"/>2</w>-<w><ana lex="c" gr="bastard"/>C</w><w><ana lex="1" gr="NUM,ciph"/>1</w> = <w><ana lex="1.316" gr="NUM,ciph"/>1.316</w> <w><ana lex="a" gr="bastard"/>Е</w>, <w><ana lex="n" gr="bastard"/>N</w><w>1</w>-<w><ana lex="c" gr="bastard"/>C</w><w><ana lex="1" gr="NUM,ciph"/>1</w> = <w><ana lex="1.353" gr="NUM,ciph"/>1.353</w> <w><ana lex="a" gr="bastard"/>Е</w>, <w><ana lex="n" gr="bastard"/>N</w><w>1</w>-<w><ana lex="c" gr="bastard"/>C</w><w><ana lex="2" gr="NUM,ciph"/>2</w> = <w><ana lex="1.361" gr="NUM,ciph"/>1.361</w> <w><ana lex="a" gr="bastard"/>Е</w>, <w><ana lex="c" gr="bastard"/>C</w><w><ana lex="2" gr="NUM,ciph"/>2</w>-<w><ana lex="c" gr="bastard"/>C</w><w><ana lex="3" gr="NUM,ciph"/>3</w> = <w><ana lex="1.378" gr="NUM,ciph"/>1.378</w> <w><ana lex="a" gr="bastard"/>Е</w>, <w><ana lex="n" gr="bastard"/>N</w><w><ana lex="2" gr="NUM,ciph"/>2</w>-<w><ana lex="c" gr="bastard"/>C</w><w><ana lex="3" gr="NUM,ciph"/>3</w> = <w><ana lex="1.382" gr="NUM,ciph"/>1.382</w> <w><ana lex="a" gr="bastard"/>Е</w>, <w><ana lex="c" gr="bastard"/>C</w><w><ana lex="4" gr="NUM,ciph"/>4</w>-<w><ana lex="c" gr="bastard"/>C</w><w><ana lex="1" gr="NUM,ciph"/>1</w> = <w><ana lex="1.465" gr="NUM,ciph"/>1.465</w> <w><ana lex="a" gr="bastard"/>Е</w>, <w><ana lex="c" gr="bastard"/>C</w><w><ana lex="14" gr="NUM,ciph"/>14</w>-<w><ana lex="c" gr="bastard"/>C</w><w><ana lex="3" gr="NUM,ciph"/>3</w> = <w><ana lex="1.465" gr="NUM,ciph"/>1.465</w> <w><ana lex="a" gr="bastard"/>Е</w>, <w><ana lex="c" gr="bastard"/>C</w><w><ana lex="2" gr="NUM,ciph"/>2</w>-<w><ana lex="c" gr="bastard"/>C</w><w><ana lex="9" gr="NUM,ciph"/>9</w> = <w><ana lex="1.479" gr="NUM,ciph"/>1.479</w> <w><ana lex="a" gr="bastard"/>Е</w>,  <w><ana lex="c" gr="bastard"/>C</w><w><ana lex="8" gr="NUM,ciph"/>8</w><w><ana lex="c" gr="bastard"/>C</w><w><ana lex="4" gr="NUM,ciph"/>4</w><w><ana lex="c" gr="bastard"/>C</w><w><ana lex="1" gr="NUM,ciph"/>1</w><w><ana lex="n" gr="bastard"/>N</w><w><ana lex="1" gr="NUM,ciph"/>1</w> = <w><ana lex="10.65" gr="NUM,ciph"/>10.65</w> (<w><ana lex="32" gr="NUM,ciph"/>32</w>) °,  <w><ana lex="c" gr="bastard"/>C</w><w><ana lex="3" gr="NUM,ciph"/>3</w><w><ana lex="c" gr="bastard"/>C</w><w><ana lex="2" gr="NUM,ciph"/>2</w><w><ana lex="c" gr="bastard"/>C</w><w><ana lex="9" gr="NUM,ciph"/>9</w><w><ana lex="c" gr="bastard"/>C</w><w><ana lex="10" gr="NUM,ciph"/>10</w> = <w><ana lex="91.88" gr="NUM,ciph"/>91.88</w> (<w><ana lex="29" gr="NUM,ciph"/>29</w>) °,  <w><ana lex="c" gr="bastard"/>C</w><w><ana lex="2" gr="NUM,ciph"/>2</w><w><ana lex="c" gr="bastard"/>C</w><w><ana lex="3" gr="NUM,ciph"/>3</w><w><ana lex="c" gr="bastard"/>C</w><w><ana lex="14" gr="NUM,ciph"/>14</w><w><ana lex="c" gr="bastard"/>C</w><w><ana lex="15" gr="NUM,ciph"/>15</w> = <w><ana lex="9.47" gr="NUM,ciph"/>9.47</w> (<w><ana lex="35" gr="NUM,ciph"/>35</w>) </se></p>
<p><se><w><ana lex="такой" gr="APRO,ins,m,norm,sg" sem="r:dem" sem2="r:indet r:spec t:degr:max"/>Таким</w> <w><ana lex="образ" gr="S,inan,ins,m,norm,sg" sem="t:ment r:concr r:abstr t:workart" sem2="t:asp r:abstr"/><ana lex="образ" gr="S,inan,ins,m,norm,sg" sem="t:ment r:concr r:abstr t:workart" sem2="t:asp r:abstr"/><ana lex="образ" gr="S,inan,ins,m,norm,sg" sem="t:ment r:concr r:abstr t:workart" sem2="t:asp r:abstr"/>образом</w>, <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="этот" gr="APRO,loc,m,norm,sg" sem="r:dem"/>этом</w> <w><ana lex="случай" gr="S,inan,loc,m,norm,sg" sem="pt:qtm r:abstr" sem2="t:time:moment r:abstr"/>случае</w> <w><ana lex="преобладающий" gr="A,ins,m,norm,plen,sg" sem="der:v r:rel"/>преобладающим</w> <w><ana lex="процесс" gr="S,inan,ins,m,norm,sg" sem="r:abstr" sem2="t:manif:disease r:abstr"/>процессом</w> <w><ana lex="становиться" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="ca:noncaus"/>становится</w> <w><ana lex="окисление" gr="S,acc,inan,n,norm,sg" sem="r:abstr"/>окисление</w> <w><ana lex="дигидроимидазол" gr="S,bastard,gen,inan,m,sg"/>дигидроимидазола</w> <b/><w><ana lex="7" gr="NUM,ciph"/>7</w><b/><w><ana lex="м" gr="S,0,inan,m,norm"/>м</w><b/> <w><ana lex="до" gr="PR,norm"/>до</w> <w><ana lex="имидазол" gr="S,bastard,gen,inan,m,sg" sem="t:stuff r:concr"/>имидазола</w> <b/><w><ana lex="14" gr="NUM,ciph"/>14</w><b/><w><ana lex="м" gr="S,0,inan,m,norm"/>м</w><b/> (<w><ana lex="кислород" gr="S,inan,ins,m,norm,sg" sem="der:comp t:stuff r:concr"/>кислородом</w> <w><ana lex="воздух" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/><ana lex="воздух" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/><ana lex="воздух" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>воздуха</w>), <w><ana lex="а" gr="CONJ,norm"/>а</w> <w><ana lex="не" gr="PART,norm"/>не</w> <w><ana lex="последующий" gr="A,n,nom,norm,plen,sg" sem="der:v r:rel dt:move t:ord"/>последующее</w> <w><ana lex="раскрытие" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr"/>раскрытие</w> <w><ana lex="пятичленный" gr="A,bastard,gen,m,plen,sg"/>пятичленного</w> <w><ana lex="цикл" gr="S,gen,inan,m,norm,sg" sem="r:abstr" sem2="sc:workart t:text r:abstr pt:set pt:aggr t:work r:concr sc:text"/>цикла</w> <w><ana lex="по" gr="PR,norm"/>по</w> <w><ana lex="общий" gr="A,f,loc,norm,plen,sg" sem="r:rel t:general" sem2="t:social r:rel"/>общей</w> <w><ana lex="схема" gr="S,f,inan,loc,norm,sg" sem="pt:aggr r:abstr" sem2="t:ment t:pattern r:concr r:abstr t:text"/>схеме</w>) (<w><ana lex="схема" gr="S,f,inan,nom,norm,sg" sem="pt:aggr r:abstr" sem2="t:ment t:pattern r:concr r:abstr t:text"/>схема</w> <w><ana lex="17" gr="NUM,ciph"/>17</w>).</se></p>
<p><se><w><ana lex="результат" gr="S,inan,m,nom,norm,pl" sem="r:abstr" sem2="r:abstr"/>Результаты</w> <w><ana lex="реакция" gr="S,f,gen,inan,norm,sg" sem="der:v r:abstr der:s0" sem2="t:changest t:physiol r:abstr"/>реакции</w> <w><ana lex="различный" gr="A,gen,norm,pl,plen" sem="r:qual"/>различных</w> <w><ana lex="ароматический" gr="A,gen,norm,pl,plen" sem="dt:stuff r:rel der:s"/>ароматических</w> <w><ana lex="альдегид" gr="S,gen,inan,m,norm,pl" sem="t:stuff r:concr"/>альдегидов</w> <w><ana lex="с" gr="PR,norm"/>с</w> <w><ana lex="ацетат" gr="S,inan,ins,m,norm,sg" sem="t:stuff r:concr hi:class"/>ацетатом</w> <w><ana lex="аммоний" gr="S,anim,gen,m,norm,persn,sg"/><ana lex="аммоний" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr"/>аммония</w> <w><ana lex="приводить" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="aux:caus ca:caus t:move d:pref"/>приведены</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="таблица" gr="S,f,inan,loc,norm,sg" sem="r:concr t:text"/>таблице</w> <w><ana lex="7" gr="NUM,ciph"/>7</w>.</se></p>

<p class="h2"><se><w><ana lex="3" gr="NUM,ciph"/>3</w>. <w><ana lex="получение" gr="S,inan,n,nom,norm,sg" sem="der:v r:abstr t:poss"/>Получение</w> <w><ana lex="тиурониев" gr="S,anim,bastard,famn,gen,m,pl"/>тиурониевых</w> <w><ana lex="соль" gr="S,f,gen,inan,norm,pl" sem="t:stuff r:concr hi:class" sem2="t:food ev:posit t:stuff hi:class r:concr r:abstr sc:hum pt:aggr pt:part pt:addit"/><ana lex="солея" gr="S,f,gen,inan,norm,pl"/>солей</w> <w><ana lex="на" gr="PR,norm"/>на</w> <w><ana lex="основа" gr="S,f,inan,loc,norm,sg" sem="r:concr pc:x pt:part" sem2="pc:word r:abstr pt:aggr pt:part r:concr t:fam"/>основе</w> <w><ana lex="производный" gr="A,gen,norm,pl,plen" sem="r:rel"/>производных</w> <w><ana lex="вицинальный" gr="A,bastard,gen,pl,plen" sem="r:rel"/>вицинальных</w> <w><ana lex="диамин" gr="S,gen,inan,m,norm,pl" sem="t:stuff r:concr"/>диаминов</w> <w><ana lex="и" gr="CONJ,norm"/>и</w> <w><ana lex="исследование" gr="S,inan,n,nom,norm,sg" sem="t:ment der:v r:abstr"/>исследование</w> <w><ana lex="их" gr="APRO,norm" sem="r:poss"/>их</w> <w><ana lex="биологический" gr="A,f,gen,norm,plen,sg" sem="r:rel"/>биологической</w> <w><ana lex="активность" gr="S,f,gen,inan,norm,sg" sem="r:abstr der:a"/>активности</w><sup><w><ana lex="1" gr="NUM,ciph"/>1</w></sup></se></p>

<p><se><sup><w><ana lex="1" gr="NUM,ciph"/>1</w></sup> <w><ana lex="работа" gr="S,f,inan,nom,norm,sg" sem="der:v r:abstr" sem2="sc:x t:text t:workdram t:workmus r:abstr t:workart der:v pt:aggr t:workcin r:concr"/>Работа</w> <w><ana lex="выполнять" gr="V,brev,f,norm,partcp,pass,pf,praet,sg" sem="d:pref der:a"/>выполнена</w> <w><ana lex="совместный" gr="A,brev,n,norm,sg"/>совместно</w> <w><ana lex="с" gr="PR,norm"/>с</w> <w>н</w>.<w>с</w>.</se><se> <w>Л</w>. <w>Н</w>. <w><ana lex="петрова" gr="S,anim,dat,f,famn,norm,sg" sem="t:hum r:propn t:famn"/>Петровой</w> <w><ana lex="и" gr="CONJ,norm"/>и</w> <w>д</w>.<w>х</w>.<w>н</w>.</se><se> <w>С</w>. <w>О</w>. <w><ana lex="бачурин" gr="S,anim,famn,ins,m,norm,sg" sem="t:hum r:propn t:famn"/>Бачуриным</w> (<w><ana lex="лаб" gr="S,bastard,inan,m,nom,sg"/>лаб</w>. <w><ana lex="нейрохимия" gr="S,bastard,f,gen,inan,sg"/>нейрохимии</w> <w><ana lex="ифав" gr="S,bastard,inan,m,nom,sg"/>ИФАВ</w> <w><ana lex="рана" gr="S,f,gen,inan,norm,pl" sem="pt:spotb pc:hum der:v r:concr"/><ana lex="ран" gr="S,0,f,inan,norm,sg"/>РАН</w>).</se></p>
