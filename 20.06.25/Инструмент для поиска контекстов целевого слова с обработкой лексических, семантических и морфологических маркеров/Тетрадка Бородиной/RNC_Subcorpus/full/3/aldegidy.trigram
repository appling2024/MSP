="зеленый" gr="A,gen,m,norm,plen,sg" sem="t:physq:color r:qual" sem2="t:humq t:physq:color dt:physq:color ev:neg der:shift t:time:age der:s r:qual dt:time:age r:rel"/>зеленого</w> <w><ana lex="комплекс" gr="S,gen,inan,m,norm,sg" sem="pt:set r:abstr" sem2="sc:org sc:x hi:class pt:set sc:constr:build r:concr"/>комплекса</w> <b/><w>VII</w><b/> <w><ana lex="быть" gr="V,act,f,indic,ipf,norm,praet,sg" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>была</w> <w><ana lex="исследовать" gr="V,brev,f,norm,partcp,pass,pf,praet,sg" sem="t:ment ca:noncaus d:pref" sem2="d:pref"/>исследована</w> <w><ana lex="метод" gr="S,inan,ins,m,norm,sg" sem="r:abstr" sem2="r:abstr"/>методом</w> <w><ana lex="рентгеноструктурный" gr="A,gen,m,norm,plen,sg" sem="der:comp r:rel"/>рентгеноструктурного</w> <w><ana lex="анализ" gr="S,gen,inan,m,norm,sg" sem="r:abstr" sem2="t:ment r:abstr"/>анализа</w> (<w><ana lex="рис" gr="S,inan,m,nom,norm,sg" sem="t:food pt:aggr r:concr sc:fruit t:fruit" sem2="t:plant sc:plant r:concr pt:aggr"/>рис</w>.</se><se> <w><ana lex="5" gr="NUM,ciph"/>5</w>).</se></p>
<p><se><w><ana lex="оказываться" gr="V,act,indic,n,norm,pf,praet,sg" sem="der:v ca:noncaus d:pref d:impf" sem2="der:v ca:noncaus d:pref d:impf"/>Оказалось</w>, <w><ana lex="что" gr="CONJ,norm"/>что</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="процесс" gr="S,inan,loc,m,norm,sg" sem="r:abstr" sem2="t:manif:disease r:abstr"/>процессе</w> <w><ana lex="образование" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0 t:be:appear" sem2="t:spot der:v r:concr r:abstr"/>образования</w> <w><ana lex="комплекс" gr="S,gen,inan,m,norm,sg" sem="pt:set r:abstr" sem2="sc:org sc:x hi:class pt:set sc:constr:build r:concr"/>комплекса</w> <w><ana lex="происходить" gr="V,act,f,indic,norm,pf,praet,sg" sem="t:be:exist ca:noncaus d:pref" sem2="t:be:exist ca:noncaus d:pref"/>произошла</w> <w><ana lex="симметризация" gr="S,bastard,f,inan,nom,sg"/>симметризация</w> <w><ana lex="исходный" gr="A,gen,m,norm,plen,sg" sem="der:v r:rel dt:move"/>исходного</w> <w><ana lex="лиганд" gr="S,gen,inan,m,norm,sg"/>лиганда</w> <w><ana lex="и" gr="CONJ,norm"/>и</w> <w><ana lex="комплекс" gr="S,inan,m,nom,norm,sg" sem="pt:set r:abstr" sem2="sc:org sc:x hi:class pt:set sc:constr:build r:concr"/>комплекс</w> <w><ana lex="образовываться" gr="V,act,indic,m,norm,pf,praet,sg" sem="der:v d:pref d:impf"/>образовался</w> <w><ana lex="с" gr="PR,norm"/>с</w> <w><ana lex="новый" gr="A,ins,m,norm,plen,sg" sem="t:time r:qual" sem2="t:time r:qual"/>новым</w> <w><ana lex="лиганд" gr="S,inan,ins,m,norm,sg"/>лигандом</w> <b/><w><ana lex="4" gr="NUM,ciph"/>4</w><b/><w>г</w><b/> (<w><ana lex="схема" gr="S,f,inan,nom,norm,sg" sem="pt:aggr r:abstr" sem2="t:ment t:pattern r:concr r:abstr t:text"/>схема</w> <w><ana lex="29" gr="NUM,ciph"/>29</w>).</se></p>
<p><se><w><ana lex="структура" gr="S,f,inan,nom,norm,pl" sem="r:abstr" sem2="r:concr t:org"/>Структуры</w> <w><ana lex="подобный" gr="A,gen,m,norm,plen,sg" sem="t:qual" sem2="der:s t:like r:qual"/>подобного</w> <w><ana lex="род" gr="S,gen,inan,m,norm,sg" sem="t:group pt:set r:concr sc:hum r:abstr" sem2="pt:set sc:hum r:concr r:abstr t:like"/><ana lex="род" gr="S,gen,inan,m,norm,sg" sem="t:group pt:set r:concr sc:hum r:abstr" sem2="pt:set sc:hum r:concr r:abstr t:like"/><ana lex="род" gr="S,gen,inan,m,norm,sg" sem="t:group pt:set r:concr sc:hum r:abstr" sem2="pt:set sc:hum r:concr r:abstr t:like"/>рода</w> <w><ana lex="ранее" gr="ADV,norm" sem="der:adv t:time"/>ранее</w> <w><ana lex="не" gr="PART,norm"/>не</w> <w><ana lex="быть" gr="V,act,indic,ipf,norm,pl,praet" sem="t:be:exist ca:noncaus d:root" sem2="ca:noncaus d:root"/>были</w> <w><ana lex="описывать" gr="V,brev,norm,partcp,pass,pf,pl,praet" sem="der:v d:pref d:impf"/>описаны</w>.</se><se> <w>Интересно</w>, <w><ana lex="что" gr="CONJ,norm"/>что</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="состав" gr="S,acc,inan,m,norm,sg" sem="sc:hum pt:aggr r:concr" sem2="der:v t:tool:transp t:stuff r:concr sc:tool:transp"/>состав</w> <w><ana lex="комплекс" gr="S,gen,inan,m,norm,sg" sem="pt:set r:abstr" sem2="sc:org sc:x hi:class pt:set sc:constr:build r:concr"/>комплекса</w> <w><ana lex="входить" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="ca:noncaus t:move d:pref"/>входит</w> <w><ana lex="тетракоординированный" gr="A,bastard,m,nom,plen,sg"/>тетракоординированный</w> <w><ana lex="ацетат" gr="S,inan,m,nom,norm,sg" sem="t:stuff r:concr hi:class"/>ацетат</w>-<w><ana lex="анион" gr="S,inan,m,nom,norm,sg"/>анион</w>.</se><se> <w><ana lex="соединение" gr="S,acc,inan,n,norm,sg" sem="pt:set der:v r:abstr der:s0" sem2="pt:set t:space hi:class t:org der:v t:stuff sc:hum pt:part r:concr"/>Соединение</w> <b/><w>VII</w><b/> <w><ana lex="относительно" gr="ADV,norm" sem="der:a"/>относительно</w> <w><ana lex="неустойчиво" gr="ADV,norm"/>неустойчиво</w> <w><ana lex="и" gr="CONJ,norm"/>и</w> <w><ana lex="на" gr="PR,norm"/>на</w> <w><ana lex="воздух" gr="S,inan,loc,m,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/><ana lex="воздух" gr="S,inan,loc,m,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/><ana lex="воздух" gr="S,inan,loc,m,norm,sg" sem="t:stuff r:concr" sem2="t:space t:stuff r:concr"/>воздухе</w> <w><ana lex="постепенно" gr="ADV,norm" sem="der:a"/>постепенно</w> <w><ana lex="разлагать" gr="V,3p,indic,ipf,norm,pass,praes,sg" sem="der:v d:pref t:impact:creat"/><ana lex="разлагаться" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="der:v ca:noncaus d:pref"/>разлагается</w> <w><ana lex="с" gr="PR,norm"/>с</w> <w><ana lex="образование" gr="S,inan,ins,n,norm,sg" sem="der:v r:abstr der:s0 t:be:appear" sem2="t:spot der:v r:concr r:abstr"/>образованием</w> <b/><w><ana lex="82" gr="NUM,ciph"/>82</w><b/>.</se><se> <w><ana lex="однако" gr="CONJ,norm"/><ana lex="однако" gr="CONJ,norm"/>Однако</w>, <w><ana lex="комплекс" gr="S,inan,m,nom,norm,sg" sem="pt:set r:abstr" sem2="sc:org sc:x hi:class pt:set sc:constr:build r:concr"/>комплекс</w> <b/><w>VII</w><b/> <w><ana lex="вполне" gr="ADV,norm" sem="dt:full t:degr:max der:a"/>вполне</w> <w><ana lex="стабильный" gr="A,brev,m,norm,sg"/>стабилен</w> <w><ana lex="при" gr="PR,norm"/>при</w> <w><ana lex="хранение" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr t:poss"/>хранении</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="безводный" gr="A,loc,m,norm,plen,sg" sem="dt:stuff d:carit r:rel der:s" sem2="dt:stuff d:carit r:rel der:s"/>безводном</w> <w><ana lex="этанол" gr="S,inan,loc,m,norm,sg" sem="t:stuff r:concr"/>этаноле</w> <w><ana lex="с" gr="PR,norm"/>с</w> <w><ana lex="примесь" gr="S,f,inan,ins,norm,sg" sem="r:abstr" sem2="r:concr pc:x"/>примесью</w> <w><ana lex="хлористый" gr="A,gen,m,norm,plen,sg" sem="dt:stuff r:rel der:s"/>хлористого</w> <w><ana lex="метилен" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr"/>метилена</w> <w><ana lex="и" gr="CONJ,norm"/>и</w> <w><ana lex="эфир" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr" sem2="t:space r:concr t:stuff"/>эфира</w> <w><ana lex="и" gr="CONJ,norm"/>и</w> <w><ana lex="нечувствительный" gr="A,brev,m,norm,sg" sem="d:neg t:humq der:a dt:humq r:qual"/>нечувствителен</w> <w><ana lex="к" gr="PR,norm"/>к</w> <w><ana lex="действие" gr="S,dat,inan,n,norm,sg" sem="r:abstr" sem2="t:text r:abstr der:v pt:part pc:text r:concr"/>действию</w> <w><ana lex="свет" gr="S,anim,gen,m,norm,persn,sg" sem2="t:hum ev:posit r:concr"/><ana lex="свет" gr="S,gen,inan,m,norm,sg" sem="t:space r:concr r:abstr t:light" sem2="t:tool t:pers t:light r:abstr t:weather sc:hum pt:aggr r:concr"/>света</w>.</se> </p>
