<p><se><w><ana lex="затем" gr="ADV,norm" sem="der:apro t:time r:dem"/>Затем</w> <w><ana lex="при" gr="PR,norm"/>при</w> <w><ana lex="взаимодействие" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr t:inter" sem2="der:v r:abstr t:inter"/>взаимодействии</w> <w><ana lex="соединение" gr="S,gen,inan,n,norm,sg" sem="pt:set der:v r:abstr der:s0" sem2="pt:set t:space hi:class t:org der:v t:stuff sc:hum pt:part r:concr"/>соединения</w> <b/><w><ana lex="7" gr="NUM,ciph"/>7</w><b/><w><ana lex="а" gr="CONJ,norm"/>а</w><b/> (<w><ana lex="амарина" gr="S,anim,bastard,f,gen,persn,pl" sem="t:hum r:propn t:famn"/>амарин</w>, <w><ana lex="где" gr="ADVPRO,norm" sem="t:place r:rel" sem2="t:place r:indet"/>где</w> <w><ana lex="ar" gr="bastard"/>Ar</w> = <w><ana lex="ph" gr="bastard"/>Ph</w>) <w><ana lex="под" gr="PR,norm"/>под</w> <w><ana lex="действие" gr="S,inan,ins,n,norm,sg" sem="r:abstr" sem2="t:text r:abstr der:v pt:part pc:text r:concr"/>действием</w> <w><ana lex="сильный" gr="A,gen,n,norm,plen,sg" sem="t:physq d:habit r:qual" sem2="ev:posit t:humq:char der:s t:degr:max r:qual r:rel"/>сильного</w> <w><ana lex="основание" gr="S,gen,inan,n,norm,sg" sem="der:v r:abstr der:s0 t:be:appear" sem2="t:stuff hi:class r:abstr pc:x pt:part r:concr pc:form:geom"/>основания</w> <w><ana lex="образовываться" gr="V,3p,act,fut,indic,norm,pf,sg" sem="der:v d:pref d:impf"/><ana lex="образовывать" gr="V,3p,indic,ipf,norm,pass,praes,sg" sem="der:v d:pref d:impf"/>образуется</w> <w><ana lex="более" gr="ADV,norm" sem="t:degr:max der:adv" sem2="t:degr:max"/>более</w> <w><ana lex="устойчивый" gr="A,f,nom,norm,plen,sg" sem="t:physq r:rel" sem2="r:qual"/>устойчивая</w> <i/><w><ana lex="транс" gr="S,inan,m,nom,norm,sg" sem="t:psych r:abstr"/>транс</w><i/>-<w><ana lex="форма" gr="S,f,inan,nom,norm,sg" sem="r:abstr" sem2="t:tool sc:partb t:form r:abstr sc:tool:cloth pt:aggr:aggrpl pt:aggr r:concr ev:posit"/>форма</w> <b/><w><ana lex="8" gr="NUM,ciph"/>8</w><b/><w>a</w><b/> (<w><ana lex="изоамарин" gr="S,bastard,ina