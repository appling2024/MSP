<p><se><b/><w><ana lex="iiа" gr="bastard"/>IIа</w><b/>: <w><ana lex="ar" gr="bastard"/>Ar</w> = <w><ana lex="c" gr="bastard"/>C</w><sub><w><ana lex="6" gr="NUM,ciph"/>6</w></sub><w><ana lex="h" gr="bastard"/>H</w><sub><w><ana lex="5" gr="NUM,ciph"/>5</w></sub>, <w><ana lex="r" gr="bastard"/>R</w> = <w><ana lex="c" gr="bastard"/>C</w><sub><w><ana lex="6" gr="NUM,ciph"/>6</w></sub><w><ana lex="h" gr="bastard"/>H</w><sub><w><ana lex="5" gr="NUM,ciph"/>5</w></sub>, <b/><w><ana lex="iiг" gr="bastard"/>IIг</w><b/>: <w><ana lex="ar" gr="bastard"/>Ar</w> = <w><ana lex="c" gr="bastard"/>C</w><sub><w><ana lex="6" gr="NUM,ciph"/>6</w></sub><w><ana lex="h" gr="bastard"/>H</w><sub><w><ana lex="5" gr="NUM,ciph"/>5</w></sub>, <w><ana lex="r" gr="bastard"/>R</w> = <w><ana lex="4" gr="NUM,ciph"/>4</w>-<w><ana lex="br" gr="bastard"/>Br</w>-<w><ana lex="c" gr="bastard"/>C</w><sub><w><ana lex="6" gr="NUM,ciph"/>6</w></sub><w><ana lex="h" gr="bastard"/>H</w><sub><w><ana lex="4" gr="NUM,ciph"/>4</w></sub>, <b/><w><ana lex="iiд" gr="bastard"/>IIд</w><b/>: <w><ana lex="ar" gr="bastard"/>Ar</w> = <w><ana lex="ph" gr="bastard"/>Ph</w>, <w><ana lex="r" gr="bastard"/>R</w> = <w><ana lex="4" gr="NUM,ciph"/>4</w>-<w><ana lex="meo" gr="bastard"/>MeO</w>- <w><ana lex="c" gr="bastard"/>C</w><sub><w><ana lex="6" gr="NUM,ciph"/>6</w></sub><w><ana lex="h" gr="bastard"/>H</w><sub><w><ana lex="4" gr="NUM,ciph"/>4</w></sub>, <b/><w><ana lex="iiе" gr="bastard"/>IIе</w><b/>: <w><ana lex="ar" gr="bastard"/>Ar</w> = <w><ana lex="c" gr="bastard"/>C</w><sub><w><ana lex="6" gr="NUM,ciph"/>6</w></sub><w><ana lex="h" gr="bastard"/>H</w><sub><w><ana lex="5" gr="NUM,ciph"/>5</w></sub>, <w><ana lex="r" gr="bastard"/>R</w> = <w><ana lex="2" gr="NUM,ciph"/>2</w>-<w><ana lex="oh" gr="bastard"/>OH</w>- <w><ana lex="c" gr="bastard"/>C</w><sub><w><ana lex="6" gr="NUM,ciph"/>6</w></sub><w><ana lex="h" gr="bastard"/>H</w><sub><w><ana lex="4" gr="NUM,ciph"/>4</w></sub>, <b/><w><ana lex="iiз" gr="bastard"/>IIз</w><b/>: <w><an