<p><se><w><ana lex="20" gr="NUM,ciph"/>20</w> <w><ana lex="мл" gr="S,0,inan,m,norm" sem="der:abbr t:unit r:abstr"/>мл</w> <w><ana lex="абсолютный" gr="A,gen,m,norm,plen,sg" sem="r:rel der:s" sem2="t:degr:max:magn der:s r:qual"/>абсолютного</w> <w><ana lex="спирт" gr="S,gen,inan,m,norm,sg" sem="t:food t:stuff r:concr t:liq" sem2="t:stuff r:concr hi:class"/>спирта</w> (<w><ana lex="метанол" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr"/>метанола</w>, <w><ana lex="этанол" gr="S,gen,inan,m,norm,sg" sem="t:stuff r:concr"/>этанола</w>, <w><ana lex="изопропанол" gr="S,bastard,gen,inan,m,sg" sem="t:stuff r:concr"/>изопропанола</w> <w><ana lex="или" gr="CONJ,norm"/>или</w> <w><ana lex="тереть" gr="V,3p,act,indic,ipf,norm,praes,sg" sem="t:impact ca:caus" sem2="t:impact ca:caus"/>трет</w>-<w><ana lex="бутанол" gr="S,gen,inan,m,norm,sg"/>бутанола</w>) <w><ana lex="насыщать" gr="V,act,indic,ipf,norm,pl,praet" sem="der:v d:pref"/>насыщали</w> <w><ana lex="в" gr="PR,norm"/>в</w> <w><ana lex="течение" gr="S,acc,inan,n,norm,sg" sem="der:v t:move r:abstr der:s0" sem2="qc:stuff der:v t:move r:concr r:abstr"/>течение</w> <w><ana lex="10" gr="NUM,ciph"/>10</w> <w><ana lex="мина" gr="S,f,gen,inan,norm,pl" sem="t:tool:shell t:manif:emot r:concr r:abstr t:pers" sem2="t:tool:shell t:tool r:concr"/><ana lex="мина" gr="S,anim,f,gen,norm,persn,pl"/>мин</w> <w><ana lex="при" gr="PR,norm"/>при</w> <w><ana lex="охлаждение" gr="S,inan,loc,n,norm,sg" sem="der:v r:abstr"/>охлаждении</w> <w><ana lex="сухой" gr="A,ins,m,norm,plen,sg" sem="t:physst r:qual" sem2="t:humq t:physq ev:neg dt:physst der:shift t:appearance r:qual t:sound dt:physq r:rel"/>сухим</w> <w><ana lex="газообразный" gr="A,ins,m,norm,plen,sg" sem="t:physq der:comp r:rel dt:stuff"/>газообразным</w> <w><ana lex="аммиак" gr="S,inan,ins,m,norm,sg" sem="t:stuff r:concr"/>аммиаком</w>, <w><ana lex="вносить" gr="V,act,indic,ipf,norm,pl,praet" sem="ca:caus t:move d:pref"/>вносили</w> <w><ana lex="1" gr="NUM,ciph"/>1</w> <w>г</w> <w><ana lex=