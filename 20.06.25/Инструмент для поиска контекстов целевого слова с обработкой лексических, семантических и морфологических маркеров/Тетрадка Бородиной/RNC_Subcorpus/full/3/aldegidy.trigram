<w><ana lex="ик" gr="S,inan,m,nom,norm,sg"/>ИК</w>: <w><ana lex="3400" gr="NUM,ciph"/>3400</w> <w><ana lex="см" gr="S,0,inan,m,norm" sem="der:abbr t:unit r:abstr"/>см</w><sup>-<w><ana lex="1" gr="NUM,ciph"/>1</w></sup> (<w><ana lex="nh" gr="bastard"/>NH</w>), <w><ana lex="2900-3100" gr="NUM,ciph"/>2900-3100</w> <w><ana lex="см" gr="S,0,inan,m,norm" sem="der:abbr t:unit r:abstr"/>см</w><sup>-<w><ana lex="1" gr="NUM,ciph"/>1</w></sup>, <w><ana lex="1640" gr="NUM,ciph"/>1640</w> <w><ana lex="см" gr="S,0,inan,m,norm" sem="der:abbr t:unit r:abstr"/>см</w><sup>-<w><ana lex="1" gr="NUM,ciph"/>1</w></sup>.</se></p>
